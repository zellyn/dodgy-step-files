{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zellyn/cad-step-defect-corpus/blob/main/schema/catalog.schema.json",
  "title": "STEP-Defect Catalog",
  "description": "Schema for STEP_PROBLEM_CATALOG.json: an array of catalog entries describing real-world STEP file defects collected for kernel grading.",
  "type": "array",
  "items": { "$ref": "#/$defs/CatalogEntry" },

  "$defs": {
    "CatalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "description",
        "section",
        "section_dir",
        "fixture_path",
        "expected_validation",
        "expected_kernel_behavior",
        "reproducer",
        "notes",
        "sender",
        "sources",
        "provenance_tier",
        "taxonomy",
        "byte_assertions",
        "tier3_assertions",
        "see_also",
        "occ_behavior_note",
        "cross_oracle_note"
      ],
      "properties": {
        "id": {
          "description": "Stable per-entry identifier; alphabetic prefix + numeric suffix (e.g. Pf001, Twi093, Pmi121).",
          "type": "string",
          "pattern": "^[A-Za-z]+\\d+$"
        },
        "title": {
          "description": "Short human-readable title (one line).",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "category": {
          "description": "Free-form sub-category label, typically derived from the markdown section header.",
          "type": "string",
          "minLength": 1
        },
        "description": {
          "description": "Multi-sentence problem description.",
          "type": "string",
          "minLength": 1
        },
        "section": {
          "description": "Catalog section label (matches §12.x markdown organisation).",
          "type": "string",
          "enum": [
            "12.1a", "12.1b", "12.1c",
            "12.2a", "12.2b", "12.2c",
            "12.3a", "12.3b", "12.3c",
            "12.4", "12.5", "12.6", "12.7", "12.8",
            "12.10", "12.11", "12.12", "12.13"
          ]
        },
        "section_dir": {
          "description": "Filesystem-friendly section directory under step-examples/.",
          "type": "string",
          "pattern": "^12-\\d+[a-z]?-[a-z-]+$",
          "enum": [
            "12-1a-encoding",
            "12-1b-header",
            "12-1c-syntax",
            "12-2a-pcurves",
            "12-2b-nurbs",
            "12-2c-surfaces",
            "12-3a-shells",
            "12-3b-wires",
            "12-3c-faces",
            "12-4-tolerance",
            "12-5-units",
            "12-6-assembly",
            "12-7-pmi",
            "12-8-mixed",
            "12-10-perf",
            "12-11-adversarial",
            "12-12-cross-product",
            "12-13-writer-pathology"
          ]
        },
        "fixture_path": {
          "description": "Path (relative to repo root) to the .stp fixture file.",
          "type": "string",
          "pattern": "^step-examples/12-[0-9]+[a-z]?-[a-z-]+/[A-Za-z0-9_.-]+\\.stp$"
        },
        "expected_validation": {
          "description": "Expected outcomes per oracle (occt=, gmsh=, ifc=). Empty string allowed for entries pre-dating the oracle harness.",
          "type": "string"
        },
        "expected_kernel_behavior": {
          "description": "Free-form narrative of what a correct kernel should do.",
          "type": "string",
          "minLength": 1
        },
        "reproducer": {
          "description": "Free-form description of how to reproduce / what the input shape is.",
          "type": "string"
        },
        "notes": {
          "description": "Free-form notes; may be empty.",
          "type": "string"
        },
        "sender": {
          "description": "Producer / authoring tool that emits this defect; may be empty when no specific sender is known.",
          "type": "string"
        },
        "sources": {
          "description": "Citations to evidence files, bug-trackers, vendor docs, etc.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "provenance_tier": {
          "description": "How much evidence pinpoints this defect to the bytes of the fixture.",
          "type": "string",
          "enum": [
            "bytes-sufficient",
            "runtime-only",
            "requires-sibling-pair",
            "cross-file-state",
            "writer-side",
            "misfiled"
          ]
        },
        "taxonomy": {
          "description": "Cross-cutting defect-class tags (1-3 tags from the canonical 15-tag vocabulary).",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "crash",
              "silent-loss",
              "round-trip",
              "spec-violation",
              "interop",
              "performance",
              "adversarial",
              "geometry",
              "topology",
              "pmi",
              "assembly",
              "encoding",
              "syntax",
              "units",
              "writer"
            ]
          }
        },
        "byte_assertions": {
          "description": "Tier-1 byte-level assertions (Python expressions evaluated against the file bytes).",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tier3_assertions": {
          "description": "Tier-3 OCCT/runtime assertions.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "see_also": {
          "description": "Cross-references to related entry IDs.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]+\\d+$"
          }
        },
        "occ_behavior_note": {
          "description": "Optional note on observed OCCT behaviour; null when absent.",
          "type": ["string", "null"]
        },
        "cross_oracle_note": {
          "description": "Optional note on cross-oracle disagreement; null when absent.",
          "type": ["string", "null"]
        },
        "severity": {
          "description": "P0/P1/P2/P3 severity rank derived from the OCC behavior + Model impact; null for entries lacking an OCC behavior line. P0 = receiver crash/hang/OOM; P1 = silent data loss; P2 = spec deviation without data loss; P3 = cosmetic/metadata-only.",
          "type": ["string", "null"],
          "enum": ["P0", "P1", "P2", "P3", null]
        }
      }
    }
  }
}
