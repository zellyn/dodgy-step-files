FILE_NAME('Tsh216.stp','2026-06-16T00:00:00',(''),(''),'wave-65B','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
