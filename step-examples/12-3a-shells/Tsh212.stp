ISO-10303-21;
/* Tsh212 - ShapeFix_ComposeShell.BreakWires mixed orientation repair
 * Defect: Internal wire (ori=INTERNAL) containing edge with EXTERNAL orientation.
 * BreakWires should detect and flip edge orientation + increment nbnew. */
HEADER;
FILE_DESCRIPTION(('Tsh212 - mixed wire/edge orientation conflict','2;1');
FILE_NAME('Tsh212.stp','2026-06-16T00:00:00',(''),(''),'wave-63a','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Face with outer loop + inner hole; inner edge has wrong orientation */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(4.0,0.0,0.0));
#102=CARTESIAN_POINT('',(4.0,4.0,0.0));
#103=CARTESIAN_POINT('',(0.0,4.0,0.0));

#104=CARTESIAN_POINT('',(1.0,1.0,0.0));
#105=CARTESIAN_POINT('',(3.0,1.0,0.0));
#106=CARTESIAN_POINT('',(3.0,3.0,0.0));
#107=CARTESIAN_POINT('',(1.0,3.0,0.0));

#110=VERTEX_POINT('',#100);
#111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102);
#113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104);
#115=VERTEX_POINT('',#105);
#116=VERTEX_POINT('',#106);
#117=VERTEX_POINT('',#107);

/* Plane z=0 */
#200=DIRECTION('',(0.0,0.0,1.0));
#201=DIRECTION('',(1.0,0.0,0.0));
#210=CARTESIAN_POINT('',(2.0,2.0,0.0));
#211=AXIS2_PLACEMENT_3D('',#210,#200,#201);
#212=PLANE('',#211);

/* Outer loop edges */
#300=DIRECTION('',(1.0,0.0,0.0));
#301=VECTOR('',#300,4.0);
#310=LINE('',#100,#301);
#311=EDGE_CURVE('',#110,#111,#310,.T.);

#302=DIRECTION('',(0.0,1.0,0.0));
#303=VECTOR('',#302,4.0);
#312=LINE('',#101,#303);
#313=EDGE_CURVE('',#111,#112,#312,.T.);

#314=DIRECTION('',(1.0,0.0,0.0));
#315=VECTOR('',#314,4.0);
#316=LINE('',#102,#315);
#317=EDGE_CURVE('',#112,#113,#316,.T.);

#318=DIRECTION('',(0.0,1.0,0.0));
#319=VECTOR('',#318,4.0);
#320=LINE('',#103,#319);
#321=EDGE_CURVE('',#113,#110,#320,.T.);

/* Inner hole edges (should be INTERNAL orientation) */
#322=DIRECTION('',(1.0,0.0,0.0));
#323=VECTOR('',#322,2.0);
#324=LINE('',#104,#323);
#325=EDGE_CURVE('',#114,#115,#324,.T.);

#326=DIRECTION('',(0.0,1.0,0.0));
#327=VECTOR('',#326,2.0);
#328=LINE('',#105,#327);
#329=EDGE_CURVE('',#115,#116,#328,.T.);

#330=DIRECTION('',(1.0,0.0,0.0));
#331=VECTOR('',#330,2.0);
#332=LINE('',#106,#331);
#333=EDGE_CURVE('',#116,#117,#332,.T.);

#334=DIRECTION('',(0.0,1.0,0.0));
#335=VECTOR('',#334,2.0);
#336=LINE('',#107,#335);
#337=EDGE_CURVE('',#117,#114,#336,.T.);

/* Outer loop */
#400=ORIENTED_EDGE('',*,*,#311,.T.);
#401=ORIENTED_EDGE('',*,*,#313,.T.);
#402=ORIENTED_EDGE('',*,*,#317,.T.);
#403=ORIENTED_EDGE('',*,*,#321,.T.);
#410=EDGE_LOOP('',(#400,#401,#402,#403));

/* Inner loop with EXTERNAL-oriented edge (conflict: should be INTERNAL) */
#411=ORIENTED_EDGE('',*,*,#325,.T.);
#412=ORIENTED_EDGE('',*,*,#329,.T.);
#413=ORIENTED_EDGE('',*,*,#333,.T.);
#414=ORIENTED_EDGE('',*,*,#337,.T.);
#415=EDGE_LOOP('',(#411,#412,#413,#414));

#420=FACE_OUTER_BOUND('',#410,.T.);
#421=FACE_BOUND('',#415,.T.);
#430=ADVANCED_FACE('',(#420,#421),#212,.T.);

/* Shell */
#500=CLOSED_SHELL('mixed_orientation_shell',(#430));

/* PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh212','Tsh212','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#500));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
