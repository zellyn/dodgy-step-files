ISO-10303-21;
/* Tsh035 - DEGENERATE_TOROIDAL_SURFACE orientation depends on revolve geometry
 * Defect: When the toroid is created by revolving a profile whose
 * curvature center sits to the left of the rotation axis and below the
 * upper edge, OCCT inverts the surface normal; mirror cases work.
 * Causes flipped face shading and hole-vs-stud mis-classification.
 *
 * This file: a DEGENERATE_TOROIDAL_SURFACE whose major_radius is
 * negative -- the profile circle's center sits inside the rotation
 * axis, so the swept surface degenerates (lemon/apple form). Combined
 * with a profile arc placed in the inverted half-plane, the kernel's
 * orientation heuristics from (major_radius, minor_radius) sign
 * disagree with the bounding wire's parametric direction. The
 * advised fix is to choose orientation from the bounding wire, not
 * the radius signs.
 * Sources: J010. */
HEADER;
FILE_DESCRIPTION(('Tsh035 test case','Degenerate toroid orientation ambiguity'),'2;1');
FILE_NAME('Tsh035.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh035','Tsh035','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#510));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
