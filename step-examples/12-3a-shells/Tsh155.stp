ISO-10303-21;
/* Tsh155: TWO ADVANCED_FACEs with zero-area collapsed geometry in OPEN_SHELL — IS the degenerate-shell mechanism; Face0: EDGE_LOOP with all vertices at x=[0,0], y=[0,0.0001] z=0 — collapses to a line (width=0) — IS wired into shell as degenerate face; Face1: EDGE_LOOP with all vertices at x=[1,1], y=[0,0.0001] z=0 — collapses to a line (width=0) — IS wired into shell as second degenerate face; zero-area geometry IS the mechanism: CheckOrientedShells computes normals from cross-product of face edges; zero-area face yields zero-length normal; algorithm proceeds without NaN/zero guard and emits meaningless orientation verdict; fix: check face area before orientation analysis; skip or flag degenerate faces; emit E_CHECK_ORIENTED_DEGENERATE_FACE when face area < tolerance^2 */
HEADER;
FILE_DESCRIPTION(('Tsh155'),'2;1');
FILE_NAME('Tsh155.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
