ISO-10303-21;
/* Tsh191: OPEN_SHELL with THREE ADVANCED_FACEs sharing ONE EDGE_CURVE IS the multi-connected edge defect trigger; e_shared IS EDGE_CURVE from v_origin to v_end — IS the multi-connected edge; face_a, face_b, face_c each reference e_shared via oriented_edge — IS the three-face share; face_a IS triangle (origin, end, apex_a) — IS first multi-connected face; face_b IS triangle (origin, end, apex_b) — IS second multi-connected face; face_c IS triangle (origin, end, apex_c) — IS third multi-connected face; FixFaceOrientation detects e_shared has count > 2 — IS the multi-connected trigger; isAccountMultiConex branch populates aMapMultiConnectEdges with all three faces — IS the defect path; traversal lacks iteration bound — IS the unbounded loop defect; fix: limit aMapMultiConnectEdges traversal to O(n) with early-exit guard; emit E_MULTICONNECT_UNBOUNDED when edge face-count exceeds threshold without bound */
HEADER;
FILE_DESCRIPTION(('Tsh191'),'2;1');
FILE_NAME('Tsh191.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
