ISO-10303-21;
/* Sw003 - Face whose wire collapses to a back-and-forth on one curve.
 * Defect: outer wire consists of two oriented edges along the same
 * underlying curve in opposite directions, enclosing zero area. */
HEADER;
FILE_DESCRIPTION(('Sw003 - degenerate face with back-and-forth wire','Pass C gap-fill'),'2;1');
FILE_NAME('Sw003.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(1.0,0.0,0.0));
#12=VERTEX_POINT('',#10);
#13=VERTEX_POINT('',#11);
#20=DIRECTION('',(1.0,0.0,0.0));
#21=VECTOR('',#20,1.0);
#22=LINE('',#10,#21);
#30=EDGE_CURVE('e',#12,#13,#22,.T.);
#31=ORIENTED_EDGE('forward',*,*,#30,.T.);
#32=ORIENTED_EDGE('reverse',*,*,#30,.F.);
#33=EDGE_LOOP('back_and_forth_zero_area',(#31,#32));
#34=FACE_OUTER_BOUND('',#33,.T.);
#40=DIRECTION('',(0.0,0.0,1.0));
#41=AXIS2_PLACEMENT_3D('',#10,#40,#20);
#42=PLANE('',#41);
#100=ADVANCED_FACE('zero_area_face',(#34),#42,.T.);
ENDSEC;
END-ISO-10303-21;
