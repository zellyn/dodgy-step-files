ISO-10303-21;
/* Tsh192 - ShapeFix_Shell.Perform closed-flag-sync-failure
 * Defect: Shell marked closed but FixFaceOrientation detects free edges
 * post-fix; Closed() flag not reset. */
HEADER;
FILE_DESCRIPTION(('Tsh192 - ShapeFix_Shell closed-flag sync'',''2;1'',''2;1'),'2;1');
FILE_NAME('Tsh192.stp','2026-06-16T00:00:00',(''),(''),'wave-55b','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Four vertices forming a square */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('',(1.0,1.0,0.0));
#103=CARTESIAN_POINT('',(0.0,1.0,0.0));
#110=VERTEX_POINT('',#100);
#111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102);
#113=VERTEX_POINT('',#103);

/* Four edges with slightly offset vertices (tolerance gap) */
#200=DIRECTION('',(1.0,0.0,0.0));
#201=VECTOR('',#200,1.0);
#210=LINE('',#100,#201);
#211=EDGE_CURVE('',#110,#111,#210,.T.);

#212=DIRECTION('',(0.0,1.0,0.0));
#213=VECTOR('',#212,1.0);
#214=LINE('',#101,#213);
#215=EDGE_CURVE('',#111,#112,#214,.T.);

#216=DIRECTION('',(-1.0,0.0,0.0));
#217=VECTOR('',#216,1.0);
#218=LINE('',#102,#217);
#219=EDGE_CURVE('',#112,#113,#218,.T.);

/* Offset closing edge: 103->(0.0,1.0001,0.0) instead of 110 */
#104=CARTESIAN_POINT('',(0.0,1.0001,0.0));
#114=VERTEX_POINT('',#104);
#220=DIRECTION('',(0.0,-1.0,0.0));
#221=VECTOR('',#220,1.0001);
#222=LINE('',#103,#221);
#223=EDGE_CURVE('',#113,#114,#222,.T.);

/* Plane z=0 */
#300=DIRECTION('',(0.0,0.0,1.0));
#301=DIRECTION('',(1.0,0.0,0.0));
#310=CARTESIAN_POINT('',(0.5,0.5,0.0));
#311=AXIS2_PLACEMENT_3D('',#310,#300,#301);
#312=PLANE('',#311);

/* Face with gap in closing edge */
#400=ORIENTED_EDGE('',*,*,#211,.T.);
#401=ORIENTED_EDGE('',*,*,#215,.T.);
#402=ORIENTED_EDGE('',*,*,#219,.T.);
#403=ORIENTED_EDGE('',*,*,#223,.T.);
#410=EDGE_LOOP('',(#400,#401,#402,#403));
#420=FACE_OUTER_BOUND('',#410,.T.);
#430=ADVANCED_FACE('',(#420),#312,.T.);

/* Shell declared closed despite gap */
#500=CLOSED_SHELL('shell_closed_with_gap',(#430));

/* PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh192','Tsh192','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#500));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
