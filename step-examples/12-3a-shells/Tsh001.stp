#454=EDGE_LOOP('',(#450,#451,#452,#453));
#455=FACE_OUTER_BOUND('',#454,.T.);
#456=ADVANCED_FACE('',(#455),#263,.T.);
/* Defect: OPEN_SHELL referenced as outer of MANIFOLD_SOLID_BREP.
   Schema requires CLOSED_SHELL here. Despite the 6 faces topologically
   closing the cube, the entity type lies. */
#500=OPEN_SHELL('cube_pretending_to_be_open',(#406,#416,#426,#436,#446,#456));
#600=MANIFOLD_SOLID_BREP('illegal_outer',#500);
/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh001','Tsh001','',(#9000));
