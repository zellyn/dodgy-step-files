ISO-10303-21;
/* Tsh001 - ManifoldSolidBrep.outer references OPEN_SHELL
 * Defect: MANIFOLD_SOLID_BREP requires its outer shell to be CLOSED_SHELL,
 * but this file emits OPEN_SHELL instead. OCCT bug 25169 attests this
 * pattern from real producers. The 6 faces of a unit cube would form a
 * closed shell, but the entity type lies and claims it is open.
 * Schema-strict readers must reject; healers may promote when topology
 * actually closes. */
HEADER;
FILE_DESCRIPTION(('Tsh001 - MANIFOLD_SOLID_BREP outer is OPEN_SHELL'',''2;1'',''2;1'),'2;1');
FILE_NAME('Tsh001.stp','2026-06-16T00:00:00',(''),(''),'wave-01','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
