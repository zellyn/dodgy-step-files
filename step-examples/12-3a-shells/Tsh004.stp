ISO-10303-21;
/* Tsh004 - Sheet bodies imported in place of solids (FEA pipeline)
 * Defect: STEP intended to carry a solid arrives as OPEN_SHELL/
 * SHELL_BASED_SURFACE_MODEL because either (a) writer never sewed faces
 * into a MANIFOLD_SOLID_BREP, or (b) edge tolerances exceeded receiver's
 * sewing tolerance. FEA/CFD pipelines reject the body for meshing.
 * Sources: Rhino, ICEM Surf, older CATIA workbenches.
 *
 * This example: 5 of 6 cube faces are emitted (top face is missing) AND
 * one boundary vertex is offset by 1e-2 from its neighbour to mimic a
 * sewing-tolerance failure. */
HEADER;
FILE_DESCRIPTION(('Tsh004 test case','Sheet body in place of solid'),'2;1');
FILE_NAME('Tsh004.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Cube vertices, but vertex 105 is offset by 1e-2 in z (sewing-tol failure) */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('',(1.0,1.0,0.0));
#103=CARTESIAN_POINT('',(0.0,1.0,0.0));
#104=CARTESIAN_POINT('',(0.0,0.0,1.0));
#105=CARTESIAN_POINT('',(1.0,0.0,1.01));
#106=CARTESIAN_POINT('',(1.0,1.0,1.0));
#107=CARTESIAN_POINT('',(0.0,1.0,1.0));
#110=VERTEX_POINT('',#100); #111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102); #113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104); #115=VERTEX_POINT('',#105);
#116=VERTEX_POINT('',#106); #117=VERTEX_POINT('',#107);
/* Plane surfaces for the 5 emitted faces (top z=1 face omitted) */
#200=DIRECTION('',(0.0,0.0,1.0)); #201=DIRECTION('',(1.0,0.0,0.0));
#211=AXIS2_PLACEMENT_3D('',#100,#200,#201); #212=PLANE('',#211);
#231=DIRECTION('',(0.0,1.0,0.0)); #232=AXIS2_PLACEMENT_3D('',#100,#231,#201); #233=PLANE('',#232);
#242=AXIS2_PLACEMENT_3D('',#103,#231,#201); #243=PLANE('',#242);
#252=DIRECTION('',(1.0,0.0,0.0)); #253=AXIS2_PLACEMENT_3D('',#100,#252,#231); #254=PLANE('',#253);
#262=AXIS2_PLACEMENT_3D('',#101,#252,#231); #263=PLANE('',#262);
/* Edges */
#300=DIRECTION('',(1.0,0.0,0.0)); #301=VECTOR('',#300,1.0);
#302=DIRECTION('',(0.0,1.0,0.0)); #303=VECTOR('',#302,1.0);
#304=DIRECTION('',(0.0,0.0,1.0)); #305=VECTOR('',#304,1.0);
#310=LINE('',#100,#301); #311=EDGE_CURVE('',#110,#111,#310,.T.);
#312=LINE('',#101,#303); #313=EDGE_CURVE('',#111,#112,#312,.T.);
#314=LINE('',#103,#301); #315=EDGE_CURVE('',#113,#112,#314,.T.);
#316=LINE('',#100,#303); #317=EDGE_CURVE('',#110,#113,#316,.T.);
#326=LINE('',#100,#305); #327=EDGE_CURVE('',#110,#114,#326,.T.);
#328=LINE('',#101,#305); #329=EDGE_CURVE('',#111,#115,#328,.T.);
#330=LINE('',#102,#305); #331=EDGE_CURVE('',#112,#116,#330,.T.);
#332=LINE('',#103,#305); #333=EDGE_CURVE('',#113,#117,#332,.T.);
/* Bottom face */
#400=ORIENTED_EDGE('',*,*,#311,.F.); #401=ORIENTED_EDGE('',*,*,#317,.T.);
#402=ORIENTED_EDGE('',*,*,#315,.F.); #403=ORIENTED_EDGE('',*,*,#313,.F.);
#404=EDGE_LOOP('',(#400,#401,#402,#403)); #405=FACE_OUTER_BOUND('',#404,.T.);
#406=ADVANCED_FACE('',(#405),#212,.F.);
/* Front, back, left, right faces (NO top face -- that is the defect) */
#420=ORIENTED_EDGE('',*,*,#311,.T.); #421=ORIENTED_EDGE('',*,*,#329,.T.);
/* (Top edge between #115 and #114 missing too -- truly open) */
#423=ORIENTED_EDGE('',*,*,#327,.F.);
#424=EDGE_LOOP('',(#420,#421,#423)); #425=FACE_OUTER_BOUND('',#424,.T.);
#426=ADVANCED_FACE('',(#425),#233,.F.);
#430=ORIENTED_EDGE('',*,*,#315,.T.); #431=ORIENTED_EDGE('',*,*,#331,.T.);
#433=ORIENTED_EDGE('',*,*,#333,.F.);
#434=EDGE_LOOP('',(#430,#431,#433)); #435=FACE_OUTER_BOUND('',#434,.T.);
#436=ADVANCED_FACE('',(#435),#243,.T.);
#440=ORIENTED_EDGE('',*,*,#317,.T.); #441=ORIENTED_EDGE('',*,*,#333,.T.);
#443=ORIENTED_EDGE('',*,*,#327,.F.);
#444=EDGE_LOOP('',(#440,#441,#443)); #445=FACE_OUTER_BOUND('',#444,.T.);
#446=ADVANCED_FACE('',(#445),#254,.F.);
#450=ORIENTED_EDGE('',*,*,#313,.T.); #451=ORIENTED_EDGE('',*,*,#331,.T.);
#453=ORIENTED_EDGE('',*,*,#329,.F.);
#454=EDGE_LOOP('',(#450,#451,#453)); #455=FACE_OUTER_BOUND('',#454,.T.);
#456=ADVANCED_FACE('',(#455),#263,.T.);
/* Defect: open shell because top face is missing and #105 is offset 1e-2;
   sheet body where a solid was intended */
#500=OPEN_SHELL('open_box_no_lid',(#406,#426,#436,#446,#456));
#510=SHELL_BASED_SURFACE_MODEL('sheet_body',(#500));
ENDSEC;
END-ISO-10303-21;
