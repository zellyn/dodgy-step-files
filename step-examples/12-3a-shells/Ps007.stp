#104=CARTESIAN_POINT('',(0.0,0.0,1.0));
#105=CARTESIAN_POINT('',(1.0,0.0,1.0));
#106=CARTESIAN_POINT('',(1.0,1.0,1.0));
#107=CARTESIAN_POINT('',(0.0,1.0,1.0));
#110=VERTEX_POINT('',#100); #111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102); #113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104); #115=VERTEX_POINT('',#105);
#116=VERTEX_POINT('',#106); #117=VERTEX_POINT('',#107);
#200=DIRECTION('',(0.0,0.0,1.0)); #201=DIRECTION('',(1.0,0.0,0.0));
#211=AXIS2_PLACEMENT_3D('',#100,#200,#201); #212=PLANE('',#211);
#221=AXIS2_PLACEMENT_3D('',#104,#200,#201); #222=PLANE('',#221);
#231=DIRECTION('',(0.0,1.0,0.0)); #232=AXIS2_PLACEMENT_3D('',#100,#231,#201); #233=PLANE('',#232);
#242=AXIS2_PLACEMENT_3D('',#103,#231,#201); #243=PLANE('',#242);
#252=DIRECTION('',(1.0,0.0,0.0)); #253=AXIS2_PLACEMENT_3D('',#100,#252,#231); #254=PLANE('',#253);
#262=AXIS2_PLACEMENT_3D('',#101,#252,#231); #263=PLANE('',#262);
#300=DIRECTION('',(1.0,0.0,0.0)); #301=VECTOR('',#300,1.0);
#302=DIRECTION('',(0.0,1.0,0.0)); #303=VECTOR('',#302,1.0);
#304=DIRECTION('',(0.0,0.0,1.0)); #305=VECTOR('',#304,1.0);
#310=LINE('',#100,#301); #311=EDGE_CURVE('',#110,#111,#310,.T.);
#312=LINE('',#101,#303); #313=EDGE_CURVE('',#111,#112,#312,.T.);
#314=LINE('',#103,#301); #315=EDGE_CURVE('',#113,#112,#314,.T.);
