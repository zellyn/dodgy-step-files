#446=ADVANCED_FACE('',(#445),#254,.F.);
#450=ORIENTED_EDGE('',*,*,#313,.T.); #451=ORIENTED_EDGE('',*,*,#331,.T.);
#452=ORIENTED_EDGE('',*,*,#321,.F.); #453=ORIENTED_EDGE('',*,*,#329,.F.);
#454=EDGE_LOOP('',(#450,#451,#452,#453)); #455=FACE_OUTER_BOUND('',#454,.T.);
#456=ADVANCED_FACE('',(#455),#263,.T.);
#500=CLOSED_SHELL('bolt_shell',(#406,#416,#426,#436,#446,#456));
#510=MANIFOLD_SOLID_BREP('bolt_solid',#500);
/* Bolt component placement (its own origin) */
#600=CARTESIAN_POINT('bolt_origin',(0.0,0.0,0.0));
#601=AXIS2_PLACEMENT_3D('bolt_axes',#600,#200,#201);
#602=SHAPE_REPRESENTATION('bolt_rep',(#601,#510),#54);
#603=SHAPE_DEFINITION_REPRESENTATION(#33,#602);
/* Assembly placement (its own origin) */
#700=CARTESIAN_POINT('assy_origin',(0.0,0.0,0.0));
#701=AXIS2_PLACEMENT_3D('assy_axes',#700,#200,#201);
/* DEFECT: the placement that maps the bolt INTO the assembly is
   identity. The bolt should appear at (50,50,0) per the NAUO label,
   but the ITEM_DEFINED_TRANSFORMATION uses the same origin point #700
   for source AND target, so the resolved transform is identity.
   Receivers see the bolt at (0,0,0), not at the intended assembly
   position. */
#702=AXIS2_PLACEMENT_3D('intended_offset_lost',#700,#200,#201);
#710=ITEM_DEFINED_TRANSFORMATION('bolt_to_assy','identity',#701,#702);
#720=(REPRESENTATION_RELATIONSHIP('','',#602,#711)
        REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#710)
        SHAPE_REPRESENTATION_RELATIONSHIP());
#711=SHAPE_REPRESENTATION('assy_rep',(#701),#54);
#712=SHAPE_DEFINITION_REPRESENTATION(#23,#711);
/* CONTEXT_DEPENDENT_SHAPE_REPRESENTATION binds the NAUO to the
   transform-laden representation_relationship. */
#730=PRODUCT_DEFINITION_SHAPE('','',#40);
#731=CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#720,#730);
ENDSEC;
END-ISO-10303-21;
