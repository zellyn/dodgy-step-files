#436=ADVANCED_FACE('',(#435),#243,.T.);
#440=ORIENTED_EDGE('',*,*,#317,.T.); #441=ORIENTED_EDGE('',*,*,#333,.T.);
#442=ORIENTED_EDGE('',*,*,#325,.F.); #443=ORIENTED_EDGE('',*,*,#327,.F.);
