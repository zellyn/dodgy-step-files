#330=LINE('',#102,#305); #331=EDGE_CURVE('',#112,#116,#330,.T.);
#332=LINE('',#103,#305); #333=EDGE_CURVE('',#113,#117,#332,.T.);
#400=ORIENTED_EDGE('',*,*,#311,.F.); #401=ORIENTED_EDGE('',*,*,#317,.T.);
#402=ORIENTED_EDGE('',*,*,#315,.F.); #403=ORIENTED_EDGE('',*,*,#313,.F.);
