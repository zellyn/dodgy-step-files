/* Ps007 - NAUO chain with ineffectual identity placement on child component - kernel accepts file silently; tier-3 introspection reveals child is at origin instead of its intended assembly position */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ps007 pathological-success','Identity placement on assembly child'),'2;1');
FILE_NAME('Ps007.stp','2026-04-26T00:00:00',(''),(''),'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=APPLICATION_CONTEXT('automotive design');
#12=PRODUCT_CONTEXT('',#1,'mechanical');
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
/* Assembly product */
#20=PRODUCT('Ps007_ASSY','Ps007 Assembly','',(#12));
#21=PRODUCT_DEFINITION_FORMATION('','',#20);
#22=PRODUCT_DEFINITION('design','',#21,#13);
#23=PRODUCT_DEFINITION_SHAPE('','',#22);
/* Child product (a single bolt-like cube) */
#30=PRODUCT('BOLT','M6 bolt','',(#12));
#31=PRODUCT_DEFINITION_FORMATION('','',#30);
#32=PRODUCT_DEFINITION('design','',#31,#13);
#33=PRODUCT_DEFINITION_SHAPE('','',#32);
/* NEXT_ASSEMBLY_USAGE_OCCURRENCE: bolt instance referenced into assembly */
#40=NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','BOLT_INSTANCE','should_be_at_(50,50,0)',#22,#32,$);
/* Units context */
#50=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#51=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#52=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#53=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#50,'distance_accuracy_value','');
#54=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#53))GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52))REPRESENTATION_CONTEXT('','3D'));
/* Bolt geometry: minimal cube at local origin */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('',(1.0,1.0,0.0));
