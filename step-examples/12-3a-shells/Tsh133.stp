ISO-10303-21;
/* Tsh133 - ShapeUpgrade_RemoveLocations.Remove top-down
 * Defect: RemoveLocations called on a compound containing transformed
 * sub-shapes. Top-level removal cascades down but child transformation
 * matrices don't update to reflect the removed parent transform.
 * Child geometry retains stale local transforms. */
HEADER;
FILE_DESCRIPTION(('Tsh133 - compound with transformed shells'),'2;1');
FILE_NAME('Tsh133.stp','2026-06-15T00:00:00',(''),(''),'wave-35','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Base unit square */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('',(1.0,1.0,0.0));
#13=CARTESIAN_POINT('',(0.0,1.0,0.0));
#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
#22=VERTEX_POINT('',#12);
#23=VERTEX_POINT('',#13);
#30=DIRECTION('',(1.0,0.0,0.0));
#31=VECTOR('',#30,1.0);
#32=DIRECTION('',(0.0,1.0,0.0));
#33=VECTOR('',#32,1.0);
#40=LINE('',#10,#31); #41=EDGE_CURVE('',#20,#21,#40,.T.);
#42=LINE('',#11,#33); #43=EDGE_CURVE('',#21,#22,#42,.T.);
#44=LINE('',#13,#31); #45=EDGE_CURVE('',#23,#22,#44,.T.);
#46=LINE('',#10,#33); #47=EDGE_CURVE('',#20,#23,#46,.T.);
#50=ORIENTED_EDGE('',*,*,#41,.T.);
#51=ORIENTED_EDGE('',*,*,#43,.T.);
#52=ORIENTED_EDGE('',*,*,#45,.F.);
#53=ORIENTED_EDGE('',*,*,#47,.F.);
#60=EDGE_LOOP('',(#50,#51,#52,#53));
#61=FACE_OUTER_BOUND('',#60,.T.);
#70=DIRECTION('',(0.0,0.0,1.0));
#71=DIRECTION('',(1.0,0.0,0.0));
#72=AXIS2_PLACEMENT_3D('',#10,#70,#71);
#73=PLANE('p',#72);
#100=ADVANCED_FACE('face',(#61),#73,.T.);
#200=CLOSED_SHELL('shell',(#100));
/* Placement 1: translated to (5, 0, 0) */
#310=CARTESIAN_POINT('',(5.0,0.0,0.0));
#311=DIRECTION('',(0,0,1));
#312=DIRECTION('',(1,0,0));
#313=AXIS2_PLACEMENT_3D('loc1',#310,#311,#312);
#320=CARTESIAN_POINT('',(-5.0,0.0,0.0));
#321=DIRECTION('',(0,0,1));
#322=DIRECTION('',(1,0,0));
#323=AXIS2_PLACEMENT_3D('ref1',#320,#321,#322);
#330=CARTESIAN_POINT('',(5.0,0.0,0.0));
#331=DIRECTION('',(0,0,1));
#332=DIRECTION('',(1,0,0));
#333=AXIS2_PLACEMENT_3D('orig1',#330,#331,#332);
#340=CARTESIAN_POINT('',(0,0,0));
#341=DIRECTION('',(0,0,1));
#342=DIRECTION('',(1,0,0));
#343=AXIS2_PLACEMENT_3D('local1',#340,#341,#342);
#350=MAPPED_ITEM('map1',#343,#313);
#360=SHAPE_DEFINITION_REPRESENTATION('',#350);
/* Placement 2: translated to (0, 5, 0) */
#410=CARTESIAN_POINT('',(0.0,5.0,0.0));
#411=DIRECTION('',(0,0,1));
#412=DIRECTION('',(1,0,0));
#413=AXIS2_PLACEMENT_3D('loc2',#410,#411,#412);
#420=CARTESIAN_POINT('',(-0.0,-5.0,0.0));
#421=DIRECTION('',(0,0,1));
#422=DIRECTION('',(1,0,0));
#423=AXIS2_PLACEMENT_3D('ref2',#420,#421,#422);
#430=CARTESIAN_POINT('',(0.0,5.0,0.0));
#431=DIRECTION('',(0,0,1));
#432=DIRECTION('',(1,0,0));
#433=AXIS2_PLACEMENT_3D('orig2',#430,#431,#432);
#440=CARTESIAN_POINT('',(0,0,0));
#441=DIRECTION('',(0,0,1));
#442=DIRECTION('',(1,0,0));
#443=AXIS2_PLACEMENT_3D('local2',#440,#441,#442);
#450=MAPPED_ITEM('map2',#443,#413);
#460=SHAPE_DEFINITION_REPRESENTATION('',#450);
/* Compound with two transformed instances - defect in cascade */
#500=COMPOUND('xform_compound',(#200));
/* PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh133','Tsh133','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#200));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
