ISO-10303-21;
/* Tsh261: OPEN_SHELL with THREE planar ADVANCED_FACEs. Face LONG (z=0) carries the reference edge x=1, y:[0,2]. Face UP (z=+0.4) has a vertex hanging over the reference edge's interior at y=0.9 and an edge spanning y:[0.9,2.0] parallel to it. Face DOWN (z=-0.4) has a vertex hanging under the reference edge at y=0.92 -- 0.02 from the first hanging vertex's projection, inside 10% of its own 0.4 projection distance. Both hanging vertices project onto the same interior stretch of one edge a hair's breadth apart; the second must be bound to the cut node the first created rather than adding a redundant second cut 0.02 away */
HEADER;
FILE_DESCRIPTION(('Tsh261'),'2;1');
FILE_NAME('Tsh261.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
