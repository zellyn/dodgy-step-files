#48=DIRECTION('',(1.0,0.0,0.0));
#49=AXIS2_PLACEMENT_3D('',#1,#47,#48);
#50=PLANE('',#49);
#51=FACE_OUTER_BOUND('',#46,.T.);
#52=ADVANCED_FACE('face_abd',(#51),#50,.T.);
/* face ACD: A->C->D->A = AC(fwd), CD(fwd), AD(rev) */
#53=ORIENTED_EDGE('',*,*,#16,.T.);
#54=ORIENTED_EDGE('',*,*,#32,.T.);
#55=ORIENTED_EDGE('',*,*,#20,.F.);
