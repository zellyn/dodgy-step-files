#30=VECTOR('',#29,1.0);
#31=LINE('',#3,#30);
#32=EDGE_CURVE('e_cd',#7,#8,#31,.T.);
/* face ABC: A->B->C->A = AB(fwd), BC(fwd), AC(rev) */
#33=ORIENTED_EDGE('',*,*,#12,.T.);
#34=ORIENTED_EDGE('',*,*,#24,.T.);
#35=ORIENTED_EDGE('',*,*,#16,.F.);
#36=EDGE_LOOP('',(#33,#34,#35));
