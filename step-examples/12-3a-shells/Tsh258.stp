ISO-10303-21;
/* Tsh258: genuinely closed tetrahedron with SHARED (not independently-duplicated per
   face, unlike Tsh003) EDGE_CURVE/VERTEX_POINT entities, emitted as OPEN_SHELL inside
   SHELL_BASED_SURFACE_MODEL, alongside a second unrelated planar-face item, both wrapped
   in one NON_MANIFOLD_SURFACE_SHAPE_REPRESENTATION; live-verified: with
   read.step.nonmanifold=1 the reader promotes the closed tetrahedron shell to a genuine
   TopoDS_SOLID (4-face) while the second item's open face stays a bare shell -- silent,
   type-substituting promotion of a wrong-container closed shell into a solid */
HEADER;
FILE_DESCRIPTION(('Tsh258'),'2;1');
FILE_NAME('Tsh258.stp','2026-07-13T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
