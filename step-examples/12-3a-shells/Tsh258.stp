/* six shared edges: each referenced by exactly 2 of the 4 faces below */
#9=DIRECTION('',(1.0,0.0,0.0));
#10=VECTOR('',#9,1.0);
#11=LINE('',#1,#10);
#12=EDGE_CURVE('e_ab',#5,#6,#11,.T.);
