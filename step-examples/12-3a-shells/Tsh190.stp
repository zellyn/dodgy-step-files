ISO-10303-21;
/* Tsh190: OPEN_SHELL with INCOMPLETE EDGE LOOP IS the FreeEdges uninitialized-compound defect trigger; unit square face has only THREE oriented edges in loop — IS the incomplete loop; v00, v10, v11 form the wired boundary; edge e_top from v11 to v01 IS omitted — IS the free edge; the open left edge from v01 back to v00 IS also implicitly free — IS the second free boundary; FreeEdges() IS the defect path: returns myFree before Perform() populates it; Extent() on uninitialized myFree compound yields undefined result — IS the defect; fix: FreeEdges() must guard against pre-Perform call with completion flag; emit E_FREE_EDGES_UNINITIALIZED when FreeEdges() called before analysis completion */
HEADER;
FILE_DESCRIPTION(('Tsh190'),'2;1');
FILE_NAME('Tsh190.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
