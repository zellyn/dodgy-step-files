ISO-10303-21;
/* Tsh178: ONE ADVANCED_FACE (triangle) IS wired into OPEN_SHELL — IS the valid face; THREE degenerate EDGE_CURVEs (zero-length self-loops) also wired into same shell — IS the defect trigger; e_degen_a IS EDGE_CURVE from va back to va, zero-length LINE — IS degenerate self-loop at vertex (0,0,0); e_degen_b IS EDGE_CURVE from vb back to vb, zero-length LINE — IS degenerate self-loop at vertex (1,0,0); e_degen_c IS EDGE_CURVE from vc back to vc, zero-length LINE — IS degenerate self-loop at vertex (0.5,1,0); FreeEdges analysis classifies degenerate self-loops as free edges — IS the defect; fix: FreeEdges must exclude zero-length self-loop edges from free-edge count; emit E_FREE_EDGES_DEGENERATE_EXCLUDED when degenerate edges are filtered */
HEADER;
FILE_DESCRIPTION(('Tsh178'),'2;1');
FILE_NAME('Tsh178.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
