ISO-10303-21;
/* Tsh098 - ShapeUpgrade_RemoveLocations.Remove location-after-traversal
 * Defect: During MakeNewShape traversal, shape's location is removed from each
 * sub-component. However, face/edge references downstream may still observe the
 * original location if not explicitly transformed. The shape becomes inconsistent:
 * top-level has no location, but contained faces retain stale location references. */
HEADER;
FILE_DESCRIPTION(('Tsh098 - shell with location transform inconsistency'',''2;1'',''2;1'),'2;1');
FILE_NAME('Tsh098.stp','2026-06-15T00:00:00',(''),(''),'wave-14','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Base points at origin */
#100=CARTESIAN_POINT('',(0,0,0));
#101=CARTESIAN_POINT('',(1,0,0));
#102=CARTESIAN_POINT('',(1,1,0));
#103=CARTESIAN_POINT('',(0,1,0));
#110=VERTEX_POINT('',#100);
#111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102);
#113=VERTEX_POINT('',#103);

/* Plane z=0 */
#300=DIRECTION('',(0,0,1));
#301=DIRECTION('',(1,0,0));
#120=AXIS2_PLACEMENT_3D('',#100,#300,#301);
#122=PLANE('',#120);

/* Face edges */
#320=DIRECTION('',(1.0,0.0,0.0));
#340=VECTOR('',#320,1.0);
#150=LINE('',#100,#340);
#151=EDGE_CURVE('e0',#110,#111,#150,.T.);

#321=DIRECTION('',(0.0,1.0,0.0));
#341=VECTOR('',#321,1.0);
#152=LINE('',#101,#341);
#153=EDGE_CURVE('e1',#111,#112,#152,.T.);

#322=DIRECTION('',(-1.0,0.0,0.0));
#342=VECTOR('',#322,1.0);
#154=LINE('',#102,#342);
#155=EDGE_CURVE('e2',#112,#113,#154,.T.);

#323=DIRECTION('',(0.0,-1.0,0.0));
#343=VECTOR('',#323,1.0);
#156=LINE('',#103,#343);
#157=EDGE_CURVE('e3',#113,#110,#156,.T.);

/* Edge loop */
#180=ORIENTED_EDGE('',*,*,#151,.T.);
#181=ORIENTED_EDGE('',*,*,#153,.T.);
#182=ORIENTED_EDGE('',*,*,#155,.T.);
#183=ORIENTED_EDGE('',*,*,#157,.T.);
#210=EDGE_LOOP('loop',(#180,#181,#182,#183));
#220=FACE_OUTER_BOUND('',#210,.T.);
#230=ADVANCED_FACE('face',(#220),#122,.T.);

/* Placement with translation (location to be removed) */
#400=CARTESIAN_POINT('',(10,10,0));
#401=DIRECTION('',(0,0,1));
#402=DIRECTION('',(1,0,0));
#410=AXIS2_PLACEMENT_3D('trans',#400,#401,#402);

/* Shell with placement: references faces that may retain stale locations */
#240=CLOSED_SHELL('loc_shell',(#230));
#241=(CLOSED_SHELL()REPRESENTATION_ITEM('')SHELL_BASED_TOPOLOGICAL_ITEM())BASED_ON_SURFACE_SHAPE_REPRESENTATION(#240,#410);

#950=MANIFOLD_SOLID_BREP('Tsh098_locstale',#240);

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh098','Tsh098','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#240));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
