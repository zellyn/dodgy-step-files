ISO-10303-21;
/* Tsh057 - Near-tangent adjacent ADVANCED_FACEs: PLANE normals differ ~1e-4 rad,
 * shared EDGE_CURVE with mismatched vertex z; merge produces self-overlapping face
 * Defect: Two ADVANCED_FACEs with PLANE normals differing by ~0.0001 rad sharing
 * an EDGE_CURVE. Single-edge same-surface check passes. Merged face has self-
 * overlapping boundary in some region.
 * Byte assertions: contains OPEN_SHELL, count ADVANCED_FACE == 2 */
HEADER;
FILE_DESCRIPTION(('Tsh057 - near-tangent faces merge to self-overlapping result','2;1'),'2;1');
FILE_NAME('Tsh057.stp','2026-06-16T00:00:00',(''),(''),'wave-regen','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Left face: plane normal exactly (0,0,1) */
#10=CARTESIAN_POINT('',(0.5,0.5,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('ax_left',#10,#11,#12);
#14=PLANE('plane_left',#13);

/* Right face: plane normal slightly tilted (0.0001, 0, ~1.0) normalised */
#15=CARTESIAN_POINT('',(1.5,0.5,0.0));
#16=DIRECTION('',(0.0001,0.0,0.99999999));
#17=DIRECTION('',(1.0,0.0,0.0));
#18=AXIS2_PLACEMENT_3D('ax_right',#15,#16,#17);
#19=PLANE('plane_right',#18);

/* Vertices for left face: z=0 exactly */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(1.0,0.0,0.0));
#22=CARTESIAN_POINT('',(1.0,1.0,0.0));
#23=CARTESIAN_POINT('',(0.0,1.0,0.0));

#24=VERTEX_POINT('',#20);
#25=VERTEX_POINT('',#21);
#26=VERTEX_POINT('',#22);
#27=VERTEX_POINT('',#23);

/* Right face extra vertices — shared edge has slightly mismatched z on right side */
#28=CARTESIAN_POINT('',(2.0,0.0,0.0));
#29=CARTESIAN_POINT('',(2.0,1.0,0.0));
/* Shared edge right-side vertices: z differs by ~1e-4 */
#30=CARTESIAN_POINT('',(1.0,0.0,9.999E-5));
#31=CARTESIAN_POINT('',(1.0,1.0,9.999E-5));

#32=VERTEX_POINT('',#28);
#33=VERTEX_POINT('',#29);
#34=VERTEX_POINT('',#30);
#35=VERTEX_POINT('',#31);

/* Left face edges */
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#20,#41);
#43=EDGE_CURVE('L_bot',#24,#25,#42,.T.);

#44=DIRECTION('',(0.0,1.0,0.0));
#45=VECTOR('',#44,1.0);
#46=LINE('',#21,#45);
#47=EDGE_CURVE('shared_L',#25,#26,#46,.T.);

#48=DIRECTION('',(-1.0,0.0,0.0));
#49=VECTOR('',#48,1.0);
#50=LINE('',#22,#49);
#51=EDGE_CURVE('L_top',#26,#27,#50,.T.);

#52=DIRECTION('',(0.0,-1.0,0.0));
#53=VECTOR('',#52,1.0);
#54=LINE('',#23,#53);
#55=EDGE_CURVE('L_left',#27,#24,#54,.T.);

/* Shared edge (right side vertices, slightly offset z) */
#56=DIRECTION('',(0.0,1.0,0.0));
#57=VECTOR('',#56,1.0);
#58=LINE('',#30,#57);
#59=EDGE_CURVE('shared_R',#34,#35,#58,.T.);

/* Right face other edges */
#60=DIRECTION('',(1.0,0.0,0.0));
#61=VECTOR('',#60,1.0);
#62=LINE('',#30,#61);
#63=EDGE_CURVE('R_bot',#34,#32,#62,.T.);

#64=DIRECTION('',(0.0,1.0,0.0));
#65=VECTOR('',#64,1.0);
#66=LINE('',#28,#65);
#67=EDGE_CURVE('R_right',#32,#33,#66,.T.);

#68=DIRECTION('',(-1.0,0.0,0.0));
#69=VECTOR('',#68,1.0);
#70=LINE('',#29,#69);
#71=EDGE_CURVE('R_top',#33,#35,#70,.T.);

/* Left face loop */
#80=ORIENTED_EDGE('',*,*,#43,.T.);
#81=ORIENTED_EDGE('',*,*,#47,.T.);
#82=ORIENTED_EDGE('',*,*,#51,.T.);
#83=ORIENTED_EDGE('',*,*,#55,.T.);
#84=EDGE_LOOP('',(#80,#81,#82,#83));
#85=FACE_OUTER_BOUND('',#84,.T.);
#86=ADVANCED_FACE('left_face',(#85),#14,.T.);

/* Right face loop */
#90=ORIENTED_EDGE('',*,*,#63,.T.);
#91=ORIENTED_EDGE('',*,*,#67,.T.);
#92=ORIENTED_EDGE('',*,*,#71,.F.);
#93=ORIENTED_EDGE('',*,*,#59,.F.);
#94=EDGE_LOOP('',(#90,#91,#92,#93));
#95=FACE_OUTER_BOUND('',#94,.T.);
#96=ADVANCED_FACE('right_face',(#95),#19,.T.);

/* OPEN_SHELL of two near-coplanar faces sharing a slightly-offset edge */
#500=OPEN_SHELL('near_tangent_faces',(#86,#96));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh057','Tsh057','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#500));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
