ISO-10303-21;
/* Sw006 - Face wire pcurve excursion smaller than surface natural bounds.
 * Defect: surface trimmed to u in [0.2,0.8] but the wire visits only
 * u in [0.3,0.7] - fast-sewing's "natural bounds" check fails. */
HEADER;
FILE_DESCRIPTION(('Sw006 - non-natural-bounds face','Pass C gap-fill'),'2;1');
FILE_NAME('Sw006.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
#15=RECTANGULAR_TRIMMED_SURFACE('trim_02_to_08',#14,0.2,0.2,0.8,0.8,.T.,.T.);
/* Wire visits only u in [0.3,0.7] */
#100=ADVANCED_FACE('non_natural_bounds_face',(),#15,.T.);
ENDSEC;
END-ISO-10303-21;
