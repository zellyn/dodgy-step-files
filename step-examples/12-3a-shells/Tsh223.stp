ISO-10303-21;
/* Tsh223 - ShapeFix_Shell.FixFaceOrientation shells_extraction_loss
 * Defect: GetShells() fails to partition all faces; remaining faces
 * discarded or create orphaned shells, leading to incomplete decomposition. */
HEADER;
FILE_DESCRIPTION(('Tsh223 - shells extraction loss','2;1');
FILE_NAME('Tsh223.stp','2026-06-16T00:00:00',(''),(''),'wave-68B','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Two disconnected face clusters */
/* Cluster 1: triangle 0-1-2 */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('',(0.5,1.0,0.0));

/* Cluster 2: triangle 3-4-5 (isolated) */
#103=CARTESIAN_POINT('',(5.0,0.0,0.0));
#104=CARTESIAN_POINT('',(6.0,0.0,0.0));
#105=CARTESIAN_POINT('',(5.5,1.0,0.0));

#110=VERTEX_POINT('',#100);
#111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102);
#113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104);
#115=VERTEX_POINT('',#105);

/* Plane Z=0 for cluster 1 */
#200=DIRECTION('',(0.0,0.0,1.0));
#201=DIRECTION('',(1.0,0.0,0.0));
#210=CARTESIAN_POINT('',(0.5,0.3,0.0));
#211=AXIS2_PLACEMENT_3D('',#210,#200,#201);
#212=PLANE('',#211);

/* Plane Z=0 for cluster 2 */
#220=DIRECTION('',(0.0,0.0,1.0));
#221=DIRECTION('',(1.0,0.0,0.0));
#230=CARTESIAN_POINT('',(5.5,0.3,0.0));
#231=AXIS2_PLACEMENT_3D('',#230,#220,#221);
#232=PLANE('',#231);

/* Cluster 1 edges: 0->1, 1->2, 2->0 */
#300=DIRECTION('',(1.0,0.0,0.0));
#301=VECTOR('',#300,1.0);
#310=LINE('',#100,#301);
#311=EDGE_CURVE('',#110,#111,#310,.T.);

#302=DIRECTION('',(-0.5,1.0,0.0));
#303=VECTOR('',#302,1.118);
#312=LINE('',#101,#303);
#313=EDGE_CURVE('',#111,#112,#312,.T.);

#304=DIRECTION('',(-0.5,-1.0,0.0));
#305=VECTOR('',#304,1.118);
#314=LINE('',#102,#305);
#315=EDGE_CURVE('',#112,#110,#314,.T.);

/* Cluster 2 edges: 3->4, 4->5, 5->3 (isolated) */
#320=DIRECTION('',(1.0,0.0,0.0));
#321=VECTOR('',#320,1.0);
#330=LINE('',#103,#321);
#331=EDGE_CURVE('',#113,#114,#330,.T.);

#322=DIRECTION('',(-0.5,1.0,0.0));
#323=VECTOR('',#322,1.118);
#332=LINE('',#104,#323);
#333=EDGE_CURVE('',#114,#115,#332,.T.);

#324=DIRECTION('',(-0.5,-1.0,0.0));
#325=VECTOR('',#324,1.118);
#334=LINE('',#105,#325);
#335=EDGE_CURVE('',#115,#113,#334,.T.);

/* Cluster 1 face */
#400=ORIENTED_EDGE('',*,*,#311,.T.);
#401=ORIENTED_EDGE('',*,*,#313,.T.);
#402=ORIENTED_EDGE('',*,*,#315,.T.);
#410=EDGE_LOOP('',(#400,#401,#402));
#420=FACE_OUTER_BOUND('',#410,.T.);
#430=ADVANCED_FACE('',(#420),#212,.T.);

/* Cluster 2 face (disconnected) */
#440=ORIENTED_EDGE('',*,*,#331,.T.);
#441=ORIENTED_EDGE('',*,*,#333,.T.);
#442=ORIENTED_EDGE('',*,*,#335,.T.);
#450=EDGE_LOOP('',(#440,#441,#442));
#460=FACE_OUTER_BOUND('',#450,.T.);
#470=ADVANCED_FACE('',(#460),#232,.T.);

/* Shell with disconnected face clusters - extraction loss */
#500=CLOSED_SHELL('extraction_loss_shell',(#430,#470));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh223','Tsh223','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#500));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
