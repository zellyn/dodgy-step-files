ISO-10303-21;
/* Tsh223: OPEN_SHELL with TWO DISCONNECTED ADVANCED_FACEs IS the shells_extraction_loss trigger; face A IS a unit-square at Z=0 — IS the first connected component; face B IS a unit-square at Z=10 (10 units away, no shared vertices or edges) — IS the second component; no topological connectivity between face A and face B — IS the disconnected shell topology; GetShells() traverses edge-connectivity from face A — IS the partitioning traversal; traversal reaches face A and its four edges but cannot reach face B — IS the partition gap; face B IS not included in any extracted shell — IS the orphaned/discarded face; incomplete decomposition breaks topology validation — IS the topology-validation failure; orientation analysis cannot process face B — IS the orientation-analysis failure; fix: GetShells() must iterate over ALL faces as seeds, not just one starting face; emit E_SHELLS_EXTRACTION_LOSS when faces remain after initial traversal */
HEADER;
FILE_DESCRIPTION(('Tsh223'),'2;1');
FILE_NAME('Tsh223.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
