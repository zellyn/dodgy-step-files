ISO-10303-21;
/* Tsh111 - ShapeAnalysis_Shell.CheckOrientedShells torus-shell
 * Defect: face on a complete torus wrapped as shell; CheckOrientedShells's
 * orientation logic assumes Euler-characteristic = 2, fails for torus (χ=0). */
HEADER;
FILE_DESCRIPTION(('Tsh111 - torus topology Euler char','wave 19'),'2;1');
FILE_NAME('Tsh111.stp','2026-06-15T00:00:00',(''),(''),'heal coverage','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
