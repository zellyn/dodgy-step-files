ISO-10303-21;
/* Tsh130 - ShapeAnalysis_Shell.CheckOrientedShells closed-shell-with-free-edges
 * Defect: CLOSED_SHELL marker claims closure but topology has free edges
 * (missing one face to close the cube). CheckOrientedShells doesn't validate
 * that the closed marker matches actual topology. */
HEADER;
FILE_DESCRIPTION(('Tsh130 - closed shell with free edges'),'2;1');
FILE_NAME('Tsh130.stp','2026-06-15T00:00:00',(''),(''),'wave-35','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
