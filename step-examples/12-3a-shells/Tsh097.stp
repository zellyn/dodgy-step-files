ISO-10303-21;
/* Tsh097 - ShapeFix_Shell.Perform context-state accumulation
 * Defect: Perform runs multiple sub-fixers (FixFaceOrientation, FixWireGaps, etc)
 * each updating myStatus. The cumulative status doesn't reflect the most recent
 * successful fix—instead, earlier failures may overwrite later successes, creating
 * ambiguous error state. Shell must be processable multiple times without
 * status divergence. */
HEADER;
FILE_DESCRIPTION(('Tsh097 - shell requiring multi-pass context state accumulation','2;1');
FILE_NAME('Tsh097.stp','2026-06-15T00:00:00',(''),(''),'wave-14','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Bottom face: 0..2 x 0..2 x 0, slightly misoriented */
#100=CARTESIAN_POINT('',(0,0,0));
#101=CARTESIAN_POINT('',(2,0,0));
#102=CARTESIAN_POINT('',(2,2,0));
#103=CARTESIAN_POINT('',(0,2,0));
#110=VERTEX_POINT('',#100);
#111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102);
#113=VERTEX_POINT('',#103);

/* Top face: 0..2 x 0..2 x 2 */
#104=CARTESIAN_POINT('',(0,0,2));
#105=CARTESIAN_POINT('',(2,0,2));
#106=CARTESIAN_POINT('',(2,2,2));
#107=CARTESIAN_POINT('',(0,2,2));
#114=VERTEX_POINT('',#104);
#115=VERTEX_POINT('',#105);
#116=VERTEX_POINT('',#106);
#117=VERTEX_POINT('',#117);

/* Bottom plane z=0, inward normal (defect) */
#300=DIRECTION('',(0,0,-1));
#301=DIRECTION('',(1,0,0));
#120=AXIS2_PLACEMENT_3D('',#100,#300,#301);
#122=PLANE('',#120);

/* Top plane z=2, outward normal */
#302=DIRECTION('',(0,0,1));
#303=DIRECTION('',(1,0,0));
#121=AXIS2_PLACEMENT_3D('',#104,#302,#303);
#123=PLANE('',#121);

/* Bottom face edges */
#320=DIRECTION('',(1.0,0.0,0.0));
#340=VECTOR('',#320,2.0);
#150=LINE('',#100,#340);
#151=EDGE_CURVE('b_e0',#110,#111,#150,.T.);

#321=DIRECTION('',(0.0,1.0,0.0));
#341=VECTOR('',#321,2.0);
#152=LINE('',#101,#341);
#153=EDGE_CURVE('b_e1',#111,#112,#152,.T.);

#322=DIRECTION('',(-1.0,0.0,0.0));
#342=VECTOR('',#322,2.0);
#154=LINE('',#102,#342);
#155=EDGE_CURVE('b_e2',#112,#113,#154,.T.);

#323=DIRECTION('',(0.0,-1.0,0.0));
#343=VECTOR('',#323,2.0);
#156=LINE('',#103,#343);
#157=EDGE_CURVE('b_e3',#113,#110,#156,.T.);

/* Bottom face loop (reversed) */
#180=ORIENTED_EDGE('',*,*,#151,.F.);
#181=ORIENTED_EDGE('',*,*,#153,.F.);
#182=ORIENTED_EDGE('',*,*,#155,.F.);
#183=ORIENTED_EDGE('',*,*,#157,.F.);
#210=EDGE_LOOP('bot_loop',(#180,#181,#182,#183));
#220=FACE_OUTER_BOUND('',#210,.T.);
#230=ADVANCED_FACE('bottom',(#220),#122,.T.);

/* Top face edges */
#324=DIRECTION('',(1.0,0.0,0.0));
#344=VECTOR('',#324,2.0);
#158=LINE('',#104,#344);
#159=EDGE_CURVE('t_e0',#114,#115,#158,.T.);

#325=DIRECTION('',(0.0,1.0,0.0));
#345=VECTOR('',#325,2.0);
#160=LINE('',#105,#345);
#161=EDGE_CURVE('t_e1',#115,#116,#160,.T.);

#326=DIRECTION('',(-1.0,0.0,0.0));
#346=VECTOR('',#326,2.0);
#162=LINE('',#106,#346);
#163=EDGE_CURVE('t_e2',#116,#117,#162,.T.);

#327=DIRECTION('',(0.0,-1.0,0.0));
#347=VECTOR('',#327,2.0);
#164=LINE('',#107,#347);
#165=EDGE_CURVE('t_e3',#117,#114,#164,.T.);

/* Top face loop */
#184=ORIENTED_EDGE('',*,*,#159,.T.);
#185=ORIENTED_EDGE('',*,*,#161,.T.);
#186=ORIENTED_EDGE('',*,*,#163,.T.);
#187=ORIENTED_EDGE('',*,*,#165,.T.);
#211=EDGE_LOOP('top_loop',(#184,#185,#186,#187));
#221=FACE_OUTER_BOUND('',#211,.T.);
#231=ADVANCED_FACE('top',(#221),#123,.T.);

/* Shell with mixed orientation requiring cumulative fixes */
#240=CLOSED_SHELL('accum_shell',(#230,#231));
#950=MANIFOLD_SOLID_BREP('Tsh097_accum',#240);

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh097','Tsh097','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#240));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
