ISO-10303-21;
/* Tsh032 - Inconsistent face orientation in mesh-derived BREP (Thingi10K cluster)
 * Defect: Adjacent faces with opposite outward normals -- flipping one
 * would heal, but the file ships inconsistent. The classic mesh-derived
 * BREP signature: one or more faces in an otherwise closed shell have
 * the wrong same_sense, breaking inside/outside classification along
 * shared edges. ~3% of Thingi10K (D013); aggregates to non-PWN/non-solid
 * ~50% (D016).
 *
 * This file: cube where the +y (BACK) face has its same_sense flipped.
 * The five other faces share consistent outward normals; the back face
 * normal points inward. orient_to_bound_a_volume / FixFaceOrientation
 * would propagate orientation from a known-correct seed and flip the
 * back face. Sources: D013, D016, H024, H025. */
HEADER;
FILE_DESCRIPTION(('Tsh032 test case','One mis-oriented face in otherwise closed shell'),'2;1');
FILE_NAME('Tsh032.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh032','Tsh032','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#500));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
