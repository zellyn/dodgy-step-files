ISO-10303-21;
/* Tsh103 - ShapeAnalysis_Shell.FreeEdges seam-edge classification
 * Defect: Shell with seam edges on closed surfaces; FreeEdges classifies
 * seam edges as free even though they're matched by their other half. */
HEADER;
FILE_DESCRIPTION(('Tsh103 - seam edge free classification error','2;1');
FILE_NAME('Tsh103.stp','2026-06-15T00:00:00',(''),(''),'wave-17','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Two faces with shared seam edges on periodic surface */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('',(1.0,1.0,0.0));
#103=CARTESIAN_POINT('',(0.0,1.0,0.0));
#104=CARTESIAN_POINT('',(0.0,0.0,1.0));
#105=CARTESIAN_POINT('',(1.0,0.0,1.0));
#106=CARTESIAN_POINT('',(1.0,1.0,1.0));
#107=CARTESIAN_POINT('',(0.0,1.0,1.0));
#110=VERTEX_POINT('',#100);
#111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102);
#113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104);
#115=VERTEX_POINT('',#105);
#116=VERTEX_POINT('',#106);
#117=VERTEX_POINT('',#107);

/* Two plane surfaces */
#200=DIRECTION('',(0.0,0.0,1.0));
#201=DIRECTION('',(1.0,0.0,0.0));
#210=CARTESIAN_POINT('',(0.5,0.5,0.0));
#211=AXIS2_PLACEMENT_3D('',#210,#200,#201);
#212=PLANE('',#211);

#220=CARTESIAN_POINT('',(0.5,0.5,1.0));
#221=AXIS2_PLACEMENT_3D('',#220,#200,#201);
#222=PLANE('',#221);

/* First face edges: z=0 plane */
#300=DIRECTION('',(1.0,0.0,0.0));
#301=VECTOR('',#300,1.0);
#310=LINE('',#100,#301);
#311=EDGE_CURVE('seam_e0',#110,#111,#310,.T.);

#302=DIRECTION('',(0.0,1.0,0.0));
#303=VECTOR('',#302,1.0);
#312=LINE('',#101,#303);
#313=EDGE_CURVE('',#111,#112,#312,.T.);

#314=LINE('',#102,#301);
#315=EDGE_CURVE('seam_e1',#112,#113,#314,.T.);

#316=LINE('',#103,#301);
#317=EDGE_CURVE('',#113,#110,#316,.T.);

/* Second face edges: z=1 plane (shares seam edges) */
#318=LINE('',#104,#301);
#319=EDGE_CURVE('seam_e0',#114,#115,#318,.T.);

#320=LINE('',#105,#303);
#321=EDGE_CURVE('',#115,#116,#320,.T.);

#322=LINE('',#106,#301);
#323=EDGE_CURVE('seam_e1',#116,#117,#322,.T.);

#324=LINE('',#107,#301);
#325=EDGE_CURVE('',#117,#114,#324,.T.);

/* Seam edges connecting both faces */
#326=LINE('',#100,#305);
#327=EDGE_CURVE('seam_conn0',#110,#114,#326,.T.);

#304=DIRECTION('',(0.0,0.0,1.0));
#305=VECTOR('',#304,1.0);
#328=LINE('',#101,#305);
#329=EDGE_CURVE('seam_conn0',#111,#115,#328,.T.);

#330=LINE('',#102,#305);
#331=EDGE_CURVE('seam_conn1',#112,#116,#330,.T.);

#332=LINE('',#103,#305);
#333=EDGE_CURVE('seam_conn1',#113,#117,#332,.T.);

/* First face loop */
#400=ORIENTED_EDGE('',*,*,#311,.T.);
#401=ORIENTED_EDGE('',*,*,#313,.T.);
#402=ORIENTED_EDGE('',*,*,#315,.T.);
#403=ORIENTED_EDGE('',*,*,#317,.T.);
#410=EDGE_LOOP('',(#400,#401,#402,#403));
#420=FACE_OUTER_BOUND('',#410,.T.);
#430=ADVANCED_FACE('',(#420),#212,.T.);

/* Second face loop */
#440=ORIENTED_EDGE('',*,*,#319,.T.);
#441=ORIENTED_EDGE('',*,*,#321,.T.);
#442=ORIENTED_EDGE('',*,*,#323,.T.);
#443=ORIENTED_EDGE('',*,*,#325,.T.);
#450=EDGE_LOOP('',(#440,#441,#442,#443));
#460=FACE_OUTER_BOUND('',#450,.T.);
#470=ADVANCED_FACE('',(#460),#222,.T.);

/* Shell with seam edges */
#500=CLOSED_SHELL('seam_edge_shell',(#430,#470));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh103','Tsh103','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#500));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
