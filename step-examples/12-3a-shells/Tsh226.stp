ISO-10303-21;
/* Tsh226 - ShapeFix_Shell.FixFaceOrientation.shells_extraction_loss
 * Defect: GetShells() fails to partition all faces; isolated cluster
 * unreachable, creates orphaned shell. */
HEADER;
FILE_DESCRIPTION(('Tsh226 - shells extraction loss','2;1');
FILE_NAME('Tsh226.stp','2026-06-16T00:00:00',(''),(''),'wave-71a','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Connected quad: 100,101,102,103 */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('',(1.0,1.0,0.0));
#103=CARTESIAN_POINT('',(0.0,1.0,0.0));

/* Isolated quad: 104,105,106,107 (no shared edges) */
#104=CARTESIAN_POINT('',(5.0,5.0,0.0));
#105=CARTESIAN_POINT('',(6.0,5.0,0.0));
#106=CARTESIAN_POINT('',(6.0,6.0,0.0));
#107=CARTESIAN_POINT('',(5.0,6.0,0.0));

#110=VERTEX_POINT('',#100);
#111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102);
#113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104);
#115=VERTEX_POINT('',#105);
#116=VERTEX_POINT('',#106);
#117=VERTEX_POINT('',#107);

/* Plane z=0 for first quad */
#200=DIRECTION('',(0.0,0.0,1.0));
#201=DIRECTION('',(1.0,0.0,0.0));
#210=CARTESIAN_POINT('',(0.5,0.5,0.0));
#211=AXIS2_PLACEMENT_3D('',#210,#200,#201);
#212=PLANE('',#211);

/* Plane z=0 for second quad */
#220=CARTESIAN_POINT('',(5.5,5.5,0.0));
#221=AXIS2_PLACEMENT_3D('',#220,#200,#201);
#222=PLANE('',#221);

/* First quad edges */
#300=DIRECTION('',(1.0,0.0,0.0));
#301=VECTOR('',#300,1.0);
#302=LINE('',#100,#301);
#303=EDGE_CURVE('',#110,#111,#302,.T.);
#304=DIRECTION('',(0.0,1.0,0.0));
#305=VECTOR('',#304,1.0);
#306=LINE('',#101,#305);
#307=EDGE_CURVE('',#111,#112,#306,.T.);
#308=DIRECTION('',(-1.0,0.0,0.0));
#309=VECTOR('',#308,1.0);
#310=LINE('',#102,#309);
#311=EDGE_CURVE('',#112,#113,#310,.T.);
#312=DIRECTION('',(0.0,-1.0,0.0));
#313=VECTOR('',#312,1.0);
#314=LINE('',#103,#313);
#315=EDGE_CURVE('',#113,#110,#314,.T.);

/* Second quad edges (isolated) */
#316=LINE('',#104,#301);
#317=EDGE_CURVE('',#114,#115,#316,.T.);
#318=LINE('',#105,#305);
#319=EDGE_CURVE('',#115,#116,#318,.T.);
#320=LINE('',#106,#309);
#321=EDGE_CURVE('',#116,#117,#320,.T.);
#322=LINE('',#107,#313);
#323=EDGE_CURVE('',#117,#114,#322,.T.);

/* First face loop */
#400=ORIENTED_EDGE('',*,*,#303,.T.);
#401=ORIENTED_EDGE('',*,*,#307,.T.);
#402=ORIENTED_EDGE('',*,*,#311,.T.);
#403=ORIENTED_EDGE('',*,*,#315,.T.);
#410=EDGE_LOOP('',(#400,#401,#402,#403));
#420=FACE_OUTER_BOUND('',#410,.T.);
#430=ADVANCED_FACE('',(#420),#212,.T.);

/* Isolated second face loop */
#440=ORIENTED_EDGE('',*,*,#317,.T.);
#441=ORIENTED_EDGE('',*,*,#319,.T.);
#442=ORIENTED_EDGE('',*,*,#321,.T.);
#443=ORIENTED_EDGE('',*,*,#323,.T.);
#450=EDGE_LOOP('',(#440,#441,#442,#443));
#460=FACE_OUTER_BOUND('',#450,.T.);
#470=ADVANCED_FACE('',(#460),#222,.T.);

/* Shell with disconnected face clusters */
#500=CLOSED_SHELL('disconnected_faces',(#430,#470));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh226','Tsh226','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
