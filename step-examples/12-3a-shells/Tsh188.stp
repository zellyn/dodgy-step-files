ISO-10303-21;
/* Tsh188: OPEN_SHELL with FOUR ADVANCED_FACEs (two inverted) IS the progress-abort defect trigger; face_ok_1 and face_ok_2 ARE correctly-oriented (same_sense=True) triangles — IS the valid set; face_inv_1 and face_inv_2 ARE inverted (same_sense=False) triangles — IS the defect set; Perform() iterates all four faces, setting myStatus=DONE1 after first correction; abort gate aPS.More() returns false mid-loop after face_ok_2 — IS the abort point; Perform() returns false (abort) but myStatus IS already DONE1 — IS the ambiguity; face_inv_1 and face_inv_2 remain uncorrected — IS the partial state; caller cannot distinguish abort from partial failure from complete failure — IS the defect; fix: Perform must save/restore status on early exit, or return distinct abort code; emit E_PERFORM_ABORT_INCONSISTENT_STATUS when abort occurs with partial DONE state */
HEADER;
FILE_DESCRIPTION(('Tsh188'),'2;1');
