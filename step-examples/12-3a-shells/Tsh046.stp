#110=ORIENTED_EDGE('',*,*,#93,.T.);
#111=ORIENTED_EDGE('',*,*,#53,.T.);#112=ORIENTED_EDGE('',*,*,#57,.T.);
#113=ORIENTED_EDGE('',*,*,#61,.T.);#114=ORIENTED_EDGE('',*,*,#65,.T.);
