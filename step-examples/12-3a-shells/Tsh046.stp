#138=DIRECTION('',(0.0,1.0,0.0));#139=VECTOR('',#138,1.0);#140=LINE('',#24,#139);#141=EDGE_CURVE('B_right',#25,#27,#140,.T.);
#142=DIRECTION('',(-1.0,0.0,0.0));#143=VECTOR('',#142,1.0);#144=LINE('',#26,#143);#145=EDGE_CURVE('B_top_seg',#23,#25,#144,.T.);
/* B's shared boundary uses the same EDGE_CURVEs in REVERSED orientation. */
#150=ORIENTED_EDGE('',*,*,#133,.T.);
#151=ORIENTED_EDGE('',*,*,#145,.T.);
#152=ORIENTED_EDGE('',*,*,#141,.T.);
