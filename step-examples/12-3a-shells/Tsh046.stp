ISO-10303-21;
/* Tsh046 - Adjacent same-domain faces fail to merge across linear-edge chain
 * Two coplanar rectangular faces. Their shared boundary is split into a chain
 * of 8 short LINE edges, each turning by 0.5 degrees from the previous (so
 * each per-edge angle is below the merge threshold but the cumulative
 * 4-degree deviation is above). The 8-edge chain is the right boundary of
 * face A and the left boundary of face B (with reversed orientation). */
HEADER;
FILE_DESCRIPTION(('Tsh046 test case','Two coplanar faces sharing an 8-edge chain (each ~0.5deg, cumulative 4deg)'),'2;1');
FILE_NAME('Tsh046.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
/* face A outer corners (V_A0..V_A3); face B outer corners (V_B1..V_B3 plus shared chain) */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));#21=VERTEX_POINT('V_A0',#20);
#22=CARTESIAN_POINT('',(0.0,8.0,0.0));#23=VERTEX_POINT('V_A1',#22);
#24=CARTESIAN_POINT('',(20.0,8.0,0.0));#25=VERTEX_POINT('V_B1',#24);
#26=CARTESIAN_POINT('',(20.0,0.0,0.0));#27=VERTEX_POINT('V_B0',#26);
/* 9 chain vertices V_C0..V_C8 along the right boundary of A.
 * Geometry: each segment has dx=1.0; dy curves slightly. */
#30=CARTESIAN_POINT('chain_C0',(8.0,0.0,0.0));#31=VERTEX_POINT('Vc0',#30);
#32=CARTESIAN_POINT('chain_C1',(9.0,0.07,0.0));#33=VERTEX_POINT('Vc1',#32);
#34=CARTESIAN_POINT('chain_C2',(10.0,0.21,0.0));#35=VERTEX_POINT('Vc2',#34);
#36=CARTESIAN_POINT('chain_C3',(11.0,0.42,0.0));#37=VERTEX_POINT('Vc3',#36);
#38=CARTESIAN_POINT('chain_C4',(12.0,0.71,0.0));#39=VERTEX_POINT('Vc4',#38);
#40=CARTESIAN_POINT('chain_C5',(13.0,1.07,0.0));#41=VERTEX_POINT('Vc5',#40);
#42=CARTESIAN_POINT('chain_C6',(14.0,1.50,0.0));#43=VERTEX_POINT('Vc6',#42);
#44=CARTESIAN_POINT('chain_C7',(15.0,2.00,0.0));#45=VERTEX_POINT('Vc7',#44);
#46=CARTESIAN_POINT('chain_C8',(16.0,2.57,0.0));#47=VERTEX_POINT('Vc8',#46);
/* 8 chain edges, each with progressively rotating direction (~0.5 deg/edge) */
#50=DIRECTION('',(1.0,0.07,0.0));#51=VECTOR('',#50,1.002);#52=LINE('',#30,#51);#53=EDGE_CURVE('chain_e1',#31,#33,#52,.T.);
#54=DIRECTION('',(1.0,0.14,0.0));#55=VECTOR('',#54,1.010);#56=LINE('',#32,#55);#57=EDGE_CURVE('chain_e2',#33,#35,#56,.T.);
#58=DIRECTION('',(0.9786534966019705,0.2055172342864138,0.0));#59=VECTOR('',#58,1.022);#60=LINE('',#34,#59);#61=EDGE_CURVE('chain_e3',#35,#37,#60,.T.);
#62=DIRECTION('',(0.9604291387787319,0.2785244502458322,0.0));#63=VECTOR('',#62,1.040);#64=LINE('',#36,#63);#65=EDGE_CURVE('chain_e4',#37,#39,#64,.T.);
#66=DIRECTION('',(0.9408874118687268,0.3387194682727416,0.0));#67=VECTOR('',#66,1.063);#68=LINE('',#38,#67);#69=EDGE_CURVE('chain_e5',#39,#41,#68,.T.);
#70=DIRECTION('',(0.9186691875800356,0.3950277506594153,0.0));#71=VECTOR('',#70,1.090);#72=LINE('',#40,#71);#73=EDGE_CURVE('chain_e6',#41,#43,#72,.T.);
#74=DIRECTION('',(0.8944271909999159,0.4472135954999579,0.0));#75=VECTOR('',#74,1.118);#76=LINE('',#42,#75);#77=EDGE_CURVE('chain_e7',#43,#45,#76,.T.);
#78=DIRECTION('',(0.8687772701926608,0.4952030440098166,0.0));#79=VECTOR('',#78,1.151);#80=LINE('',#44,#79);#81=EDGE_CURVE('chain_e8',#45,#47,#80,.T.);
/* face A outer ring: V_A0 -> Vc0 (bottom-A) -> [Vc0..Vc8 chain] -> V_A1 -> V_A0 */
#90=DIRECTION('',(1.0,0.0,0.0));#91=VECTOR('',#90,1.0);#92=LINE('',#20,#91);#93=EDGE_CURVE('A_bottom',#21,#31,#92,.T.);
#94=DIRECTION('',(-0.732271658149322,0.6810126420788696,0.0));#95=VECTOR('',#94,1.366);#96=LINE('',#46,#95);
#97=EDGE_CURVE('A_top_back_to_corner',#47,#23,#96,.T.);
