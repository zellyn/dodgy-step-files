#117=ORIENTED_EDGE('',*,*,#77,.T.);#118=ORIENTED_EDGE('',*,*,#81,.T.);
#119=ORIENTED_EDGE('',*,*,#97,.T.);#120=ORIENTED_EDGE('',*,*,#101,.T.);
#121=EDGE_LOOP('A_outer',(#110,#111,#112,#113,#114,#115,#116,#117,#118,#119,#120));
#122=FACE_OUTER_BOUND('',#121,.T.);
#123=ADVANCED_FACE('faceA_with_chain_right',(#122),#14,.T.);
/* face B outer ring: shared chain reversed + perimeter of B */
#130=DIRECTION('',(0.732271658149322,-0.6810126420788696,0.0));#131=VECTOR('',#130,1.366);#132=LINE('',#22,#131);
#133=EDGE_CURVE('B_top_from_corner',#23,#47,#132,.T.);
#134=DIRECTION('',(1.0,0.0,0.0));#135=VECTOR('',#134,1.0);#136=LINE('',#26,#135);
