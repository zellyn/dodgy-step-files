ISO-10303-21;
/* Tsh220 - ShapeFix_Shell.FixFaceOrientation multiconnect_edge_loop_unbounded
 * Defect: Non-manifold shell with edges connecting 3+ faces; unbounded
 * iteration without complexity guard causes potential O(n^2) behavior. */
HEADER;
FILE_DESCRIPTION(('Tsh220 - multi-connected edges unbounded','2;1');
FILE_NAME('Tsh220.stp','2026-06-16T00:00:00',(''),(''),'wave-68B','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Three vertices forming a multi-connected edge scenario */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('',(1.0,1.0,0.0));
#103=CARTESIAN_POINT('',(0.0,1.0,0.0));
#104=CARTESIAN_POINT('',(0.5,0.5,0.5));

#110=VERTEX_POINT('',#100);
#111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102);
#113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104);

/* Three planes meeting at central point */
#200=DIRECTION('',(0.0,0.0,1.0));
#201=DIRECTION('',(1.0,0.0,0.0));
#210=CARTESIAN_POINT('',(0.5,0.5,0.0));
#211=AXIS2_PLACEMENT_3D('',#210,#200,#201);
#212=PLANE('',#211);

#220=DIRECTION('',(0.0,0.0,1.0));
#221=DIRECTION('',(0.0,1.0,0.0));
#230=CARTESIAN_POINT('',(0.5,0.5,0.0));
#231=AXIS2_PLACEMENT_3D('',#230,#220,#221);
#232=PLANE('',#231);

#240=DIRECTION('',(1.0,0.0,0.0));
#241=DIRECTION('',(0.0,1.0,0.0));
#250=CARTESIAN_POINT('',(0.5,0.5,0.0));
#251=AXIS2_PLACEMENT_3D('',#250,#240,#241);
#252=PLANE('',#251);

/* Shared edge 0->1 (connects 3 faces: Face1, Face2, Face3) */
#300=DIRECTION('',(1.0,0.0,0.0));
#301=VECTOR('',#300,1.0);
#310=LINE('',#100,#301);
#311=EDGE_CURVE('',#110,#111,#310,.T.);

/* Face 1: triangle 0-1-4 */
#320=DIRECTION('',(0.0,1.0,0.0));
#321=VECTOR('',#320,1.0);
#322=LINE('',#111,#321);
#323=EDGE_CURVE('',#111,#114,#322,.T.);

#324=DIRECTION('',(-1.0,0.0,0.0));
#325=VECTOR('',#324,1.414);
#326=LINE('',#114,#325);
#327=EDGE_CURVE('',#114,#110,#326,.T.);

#330=ORIENTED_EDGE('',*,*,#311,.T.);
#331=ORIENTED_EDGE('',*,*,#323,.T.);
#332=ORIENTED_EDGE('',*,*,#327,.T.);
#340=EDGE_LOOP('',(#330,#331,#332));
#350=FACE_OUTER_BOUND('',#340,.T.);
#360=ADVANCED_FACE('',(#350),#212,.T.);

/* Face 2: triangle 0-1-4 (different orientation, shares edge 0-1) */
#370=ORIENTED_EDGE('',*,*,#311,.F.);
#371=ORIENTED_EDGE('',*,*,#327,.F.);
#372=ORIENTED_EDGE('',*,*,#323,.F.);
#380=EDGE_LOOP('',(#370,#371,#372));
#390=FACE_OUTER_BOUND('',#380,.T.);
#400=ADVANCED_FACE('',(#390),#232,.F.);

/* Face 3: triangle 0-1-4 (third orientation, shares edge 0-1) */
#410=ORIENTED_EDGE('',*,*,#311,.T.);
#411=ORIENTED_EDGE('',*,*,#327,.F.);
#412=ORIENTED_EDGE('',*,*,#323,.T.);
#420=EDGE_LOOP('',(#410,#411,#412));
#430=FACE_OUTER_BOUND('',#420,.T.);
#440=ADVANCED_FACE('',(#430),#252,.T.);

/* Non-manifold shell with multi-connected shared edge */
#500=CLOSED_SHELL('multiconnect_shell',(#360,#400,#440));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh220','Tsh220','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#500));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
