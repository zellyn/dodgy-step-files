ISO-10303-21;
/* Tsh164 - ShapeFix_Shell.Perform with-context-pollution
 * Defect: shell from previous fix pass that left context state behind;
 * Perform() inherits the stale context and skips needed fixes.
 * Tests: calling Perform() multiple times without Context().IsNull() check
 * reuses accumulated ShapeBuild_ReShape state, causing double-fixes. */
HEADER;
FILE_DESCRIPTION(('Tsh164 test case','ShapeFix_Shell context pollution'),'2;1');
FILE_NAME('Tsh164.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Simple rectangular shell: 2x2 flat faces */
#100=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('p1',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('p2',(1.0,1.0,0.0));
#103=CARTESIAN_POINT('p3',(0.0,1.0,0.0));
#104=CARTESIAN_POINT('p4',(2.0,0.0,0.0));
#105=CARTESIAN_POINT('p5',(2.0,1.0,0.0));
#110=VERTEX_POINT('',#100);
#111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102);
#113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104);
#115=VERTEX_POINT('',#105);
/* Plane surfaces for two adjacent faces */
#200=DIRECTION('z',(0.0,0.0,1.0));
#201=DIRECTION('x',(1.0,0.0,0.0));
#210=CARTESIAN_POINT('',(0.5,0.5,0.0));
#211=AXIS2_PLACEMENT_3D('',#210,#200,#201);
#212=PLANE('plane1',#211);
#220=CARTESIAN_POINT('',(1.5,0.5,0.0));
#221=AXIS2_PLACEMENT_3D('',#220,#200,#201);
#222=PLANE('plane2',#221);
/* Edges */
#300=DIRECTION('x',(1.0,0.0,0.0));
#301=VECTOR('',#300,1.0);
#302=DIRECTION('y',(0.0,1.0,0.0));
#303=VECTOR('',#302,1.0);
#310=LINE('',#100,#301); #311=EDGE_CURVE('',#110,#111,#310,.T.);
#312=LINE('',#101,#303); #313=EDGE_CURVE('',#111,#112,#312,.T.);
#314=LINE('',#103,#301); #315=EDGE_CURVE('',#113,#112,#314,.T.);
#316=LINE('',#100,#303); #317=EDGE_CURVE('',#110,#113,#316,.T.);
#320=LINE('',#101,#301); #321=EDGE_CURVE('',#111,#114,#320,.T.);
#322=LINE('',#104,#303); #323=EDGE_CURVE('',#114,#115,#322,.T.);
#324=LINE('',#102,#303); #325=EDGE_CURVE('',#112,#115,#324,.T.);
/* Face 1 */
#400=ORIENTED_EDGE('',*,*,#311,.T.);
#401=ORIENTED_EDGE('',*,*,#313,.T.);
#402=ORIENTED_EDGE('',*,*,#315,.F.);
#403=ORIENTED_EDGE('',*,*,#317,.F.);
#404=EDGE_LOOP('',(#400,#401,#402,#403));
#405=FACE_OUTER_BOUND('',#404,.T.);
#406=ADVANCED_FACE('',(#405),#212,.T.);
/* Face 2: shares edge #313 with Face 1, but reference creates context pollution */
#410=ORIENTED_EDGE('',*,*,#321,.T.);
#411=ORIENTED_EDGE('',*,*,#323,.T.);
#412=ORIENTED_EDGE('',*,*,#325,.F.);
#413=ORIENTED_EDGE('',*,*,#313,.F.);
#414=EDGE_LOOP('',(#410,#411,#412,#413));
#415=FACE_OUTER_BOUND('',#414,.T.);
#416=ADVANCED_FACE('',(#415),#222,.T.);
/* Open shell - tests context accumulation */
#500=OPEN_SHELL('context_polluted_shell',(#406,#416));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh164','Tsh164','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#500));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
