ISO-10303-21;
/* Tsh056 - Merging adjacent same-surface faces hangs on face whose wire forms a figure-eight
 * Defect: A single face whose FACE_OUTER_BOUND has 6 edges forming a figure-eight at
 * vertex B (which has 4 incident edges in the wire). Same-surface face merging walks
 * edges and never terminates because the visited-edge map records edges not
 * edge+direction, and the figure-eight makes the iterator revisit the same edge.
 * Byte assertions: count ADVANCED_FACE == 1 */
HEADER;
FILE_DESCRIPTION(('Tsh056 - figure-eight wire causes infinite loop in face merge edge walker','2;1'),'2;1');
FILE_NAME('Tsh056.stp','2026-06-16T00:00:00',(''),(''),'wave-regen','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Figure-eight wire on plane z=0:
 * Vertices: A=(0,0,0), B=(1,0,0) [pinch point], C=(2,0,0), D=(2,1,0), E=(1,1,0), F=(0,1,0)
 * Wire: A->B->E->F->A (left loop) and B->C->D->E->B (right loop)
 * At B: edges A->B, B->E (left loop) and B->C, E->B (right loop) = 4 incident
 * Encoded as 6 oriented edges forming the figure-eight boundary */

#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('',(2.0,0.0,0.0));
#13=CARTESIAN_POINT('',(2.0,1.0,0.0));
#14=CARTESIAN_POINT('',(1.0,1.0,0.0));
#15=CARTESIAN_POINT('',(0.0,1.0,0.0));

#20=VERTEX_POINT('A',#10);
#21=VERTEX_POINT('B',#11);
#22=VERTEX_POINT('C',#12);
#23=VERTEX_POINT('D',#13);
#24=VERTEX_POINT('E',#14);
#25=VERTEX_POINT('F',#15);

/* Plane z=0 */
#30=CARTESIAN_POINT('',(1.0,0.5,0.0));
#31=DIRECTION('',(0.0,0.0,1.0));
#32=DIRECTION('',(1.0,0.0,0.0));
#33=AXIS2_PLACEMENT_3D('',#30,#31,#32);
#34=PLANE('',#33);

/* Edges */
/* A->B */
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#10,#41);
#43=EDGE_CURVE('AB',#20,#21,#42,.T.);

/* B->C */
#44=LINE('',#11,#41);
#45=EDGE_CURVE('BC',#21,#22,#44,.T.);

/* C->D */
#46=DIRECTION('',(0.0,1.0,0.0));
#47=VECTOR('',#46,1.0);
#48=LINE('',#12,#47);
#49=EDGE_CURVE('CD',#22,#23,#48,.T.);

/* D->E */
#50=DIRECTION('',(-1.0,0.0,0.0));
#51=VECTOR('',#50,1.0);
#52=LINE('',#13,#51);
#53=EDGE_CURVE('DE',#23,#24,#52,.T.);

/* E->B (the cross-edge of the figure-eight) */
#54=DIRECTION('',(0.0,-1.0,0.0));
#55=VECTOR('',#54,1.0);
#56=LINE('',#14,#55);
#57=EDGE_CURVE('EB',#24,#21,#56,.T.);

/* E->F */
#58=LINE('',#14,#51);
#59=EDGE_CURVE('EF',#24,#25,#58,.T.);

/* F->A */
#60=DIRECTION('',(0.0,-1.0,0.0));
#61=VECTOR('',#60,1.0);
#62=LINE('',#15,#61);
#63=EDGE_CURVE('FA',#25,#20,#62,.T.);

/* Figure-eight wire: A->B, B->C, C->D, D->E, E->B, B->... loops back
 * We encode it as: A->B, B->E(reverse), E->F, F->A then B->C, C->D, D->E
 * (visiting B twice as the pinch point) */
#70=ORIENTED_EDGE('',*,*,#43,.T.);
#71=ORIENTED_EDGE('',*,*,#57,.F.);
#72=ORIENTED_EDGE('',*,*,#59,.F.);
#73=ORIENTED_EDGE('',*,*,#63,.T.);
/* Now back from A we've reached B via the cross — re-enter right loop */
/* Encode second half: at B again */
#74=ORIENTED_EDGE('',*,*,#45,.T.);
#75=ORIENTED_EDGE('',*,*,#49,.T.);
#76=ORIENTED_EDGE('',*,*,#53,.T.);
#77=ORIENTED_EDGE('',*,*,#57,.T.);
#78=EDGE_LOOP('',(#70,#71,#72,#73,#74,#75,#76,#77));
#79=FACE_OUTER_BOUND('',#78,.T.);
#80=ADVANCED_FACE('figure_eight_face',(#79),#34,.T.);

#500=OPEN_SHELL('figure_eight_shell',(#80));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh056','Tsh056','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#500));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
