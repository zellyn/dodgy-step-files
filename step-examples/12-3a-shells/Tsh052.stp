ISO-10303-21;
/* Tsh052 - Inversed normals on revolved-shape import
 * Defect: Profile half-circle in XZ plane revolved 360° about Z axis to form
 * a sphere. Face normals point inward after import because profile direction
 * and axis convention disagree.
 * Byte assertions: contains SURFACE_OF_REVOLUTION, contains CIRCLE */
HEADER;
FILE_DESCRIPTION(('Tsh052 - revolved sphere with inverted face normals','2;1'),'2;1');
FILE_NAME('Tsh052.stp','2026-06-16T00:00:00',(''),(''),'wave-regen','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Revolution axis: Z */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('rev_axis',#10,#11,#12);

/* Profile circle: radius 1 centred at origin in XZ plane.
 * This is a full CIRCLE which the revolution sweeps around Z. */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,1.0,0.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('circle_ax',#20,#21,#22);
#24=CIRCLE('profile_circle',#23,1.0);

/* SURFACE_OF_REVOLUTION: sweep profile around axis */
#30=SURFACE_OF_REVOLUTION('sphere_rev',#24,#13);

/* Bounding vertices — sphere poles */
#40=CARTESIAN_POINT('',(0.0,0.0,1.0));
#41=CARTESIAN_POINT('',(0.0,0.0,-1.0));
#42=VERTEX_POINT('north_pole',#40);
#43=VERTEX_POINT('south_pole',#41);

/* Degenerate seam edge at north pole (collapses to a point) */
#50=DIRECTION('',(0.0,0.0,1.0));
#51=VECTOR('',#50,0.0);
#52=LINE('',#40,#51);
#53=EDGE_CURVE('north_seam',#42,#42,#52,.T.);

/* Degenerate seam edge at south pole */
#54=LINE('',#41,#51);
#55=EDGE_CURVE('south_seam',#43,#43,#54,.T.);

/* Seam edge: full meridian from south pole to north pole at X=1 */
#56=DIRECTION('',(0.0,0.0,1.0));
#57=VECTOR('',#56,2.0);
#58=LINE('',#41,#57);
#59=EDGE_CURVE('meridian',#43,#42,#58,.T.);

/* Face loop: degenerate north, seam up, degenerate south, seam down
 * This forms a topological sphere using degenerate poles */
#60=ORIENTED_EDGE('',*,*,#53,.T.);
#61=ORIENTED_EDGE('',*,*,#59,.F.);
#62=ORIENTED_EDGE('',*,*,#55,.T.);
#63=ORIENTED_EDGE('',*,*,#59,.T.);
#64=EDGE_LOOP('',(#60,#61,#62,#63));
#65=FACE_OUTER_BOUND('',#64,.T.);

/* ADVANCED_FACE with .F. orientation = normals point inward (defect) */
#70=ADVANCED_FACE('sphere_face',(#65),#30,.F.);

#500=OPEN_SHELL('sphere_shell',(#70));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh052','Tsh052','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#500));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
