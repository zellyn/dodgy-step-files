ISO-10303-21;
/* Tsh119 - ShapeFix_Shell.Perform unused-vertex retention
 * Defect: shell where Perform removes a face; vertex used only by that face
 * is left orphaned in the shell topology */
HEADER;
FILE_DESCRIPTION(('Tsh119 - orphaned vertex after face removal','wave 25'),'2;1');
FILE_NAME('Tsh119.stp','2026-06-15T00:00:00',(''),(''),'heal coverage','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Two rectangular faces sharing one edge; third face uses orphan vertex */
/* Face 1: (0,0,0)-(10,0,0)-(10,10,0)-(0,10,0) [bottom] */
/* Face 2: (0,0,0)-(10,0,0)-(10,0,10)-(0,0,10) [front] */
/* Face 3: degenerate triangle at (20,20,0) using only orphan vertex */

/* Base vertices for faces 1-2 */
#10=CARTESIAN_POINT('',(0,0,0));
#11=CARTESIAN_POINT('',(10.0,0,0));
#12=CARTESIAN_POINT('',(10.0,10.0,0));
#13=CARTESIAN_POINT('',(0,10.0,0));
#14=CARTESIAN_POINT('',(10.0,0,10.0));
#15=CARTESIAN_POINT('',(0,0,10.0));

/* Orphan vertex (used only by degenerate face 3) */
#16=CARTESIAN_POINT('',(20.0,20.0,0));

/* Vertex references */
#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
#22=VERTEX_POINT('',#12);
#23=VERTEX_POINT('',#13);
#24=VERTEX_POINT('',#14);
#25=VERTEX_POINT('',#15);
#26=VERTEX_POINT('',#16);

/* Planes */
#30=AXIS2_PLACEMENT_3D('z0_plane',#10,DIRECTION('',(0,0,-1)),DIRECTION('',(1,0,0)));
#31=PLANE('',#30);
#32=AXIS2_PLACEMENT_3D('y0_plane',#10,DIRECTION('',(0,-1,0)),DIRECTION('',(1,0,0)));
#33=PLANE('',#32);
#34=AXIS2_PLACEMENT_3D('degenerate_plane',#16,DIRECTION('',(0,0,1)),DIRECTION('',(1,0,0)));
#35=PLANE('',#34);

/* Face 1 edges (bottom rectangle) */
#50=LINE('',#10,VECTOR('',(1,0,0),10.0));
#51=EDGE_CURVE('f1_e1',#20,#21,#50,.T.);
#52=LINE('',#11,VECTOR('',(0,1,0),10.0));
#53=EDGE_CURVE('f1_e2',#21,#22,#52,.T.);
#54=LINE('',#12,VECTOR('',(-1,0,0),10.0));
#55=EDGE_CURVE('f1_e3',#22,#23,#54,.T.);
#56=LINE('',#13,VECTOR('',(0,-1,0),10.0));
#57=EDGE_CURVE('f1_e4',#23,#20,#56,.T.);

/* Face 2 shared edge (shared with face 1) */
/* #51 reused as shared edge */

/* Face 2 vertical edges */
#58=LINE('',#11,VECTOR('',(0,0,1),10.0));
#59=EDGE_CURVE('f2_vert1',#21,#24,#58,.T.);
#60=LINE('',#14,VECTOR('',(-1,0,0),10.0));
#61=EDGE_CURVE('f2_e2',#24,#25,#60,.T.);
#62=LINE('',#15,VECTOR('',(0,0,-1),10.0));
#63=EDGE_CURVE('f2_e3',#25,#20,#62,.T.);

/* Face 3 edges (degenerate triangle, all from/to orphan vertex) */
#64=LINE('',#16,VECTOR('',(0,0,0),1.0));
#65=EDGE_CURVE('f3_e1',#26,#26,#64,.T.);
#66=EDGE_CURVE('f3_e2',#26,#26,#64,.T.);
#67=EDGE_CURVE('f3_e3',#26,#26,#64,.T.);

/* Face 1 edge loop (bottom) */
#80=ORIENTED_EDGE('',*,*,#51,.T.);
#81=ORIENTED_EDGE('',*,*,#53,.T.);
#82=ORIENTED_EDGE('',*,*,#55,.T.);
#83=ORIENTED_EDGE('',*,*,#57,.T.);
#84=EDGE_LOOP('f1_loop',(#80,#81,#82,#83));

/* Face 2 edge loop (front) */
#85=ORIENTED_EDGE('',*,*,#51,.F.);
#86=ORIENTED_EDGE('',*,*,#59,.T.);
#87=ORIENTED_EDGE('',*,*,#61,.T.);
#88=ORIENTED_EDGE('',*,*,#63,.T.);
#89=EDGE_LOOP('f2_loop',(#85,#86,#87,#88));

/* Face 3 edge loop (degenerate) */
#90=ORIENTED_EDGE('',*,*,#65,.T.);
#91=ORIENTED_EDGE('',*,*,#66,.T.);
#92=ORIENTED_EDGE('',*,*,#67,.T.);
#93=EDGE_LOOP('f3_loop',(#90,#91,#92));

/* Face bounds */
#100=FACE_OUTER_BOUND('',#84,.T.);
#101=FACE_OUTER_BOUND('',#89,.T.);
#102=FACE_OUTER_BOUND('',#93,.T.);

/* Faces */
#110=ADVANCED_FACE('f1',(#100),#31,.T.);
#111=ADVANCED_FACE('f2',(#101),#33,.T.);
#112=ADVANCED_FACE('f3_degenerate',(#102),#35,.T.);

/* Open shell with orphan vertex */
#130=OPEN_SHELL('orphan_shell',(#110,#111,#112));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh119','Tsh119','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#130));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
