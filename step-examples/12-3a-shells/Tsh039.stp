ISO-10303-21;
/* Tsh039 - Self-touching boundary cycle (figure-eight wire after triangulation)
 * Defect: A face whose boundary loop folds back on itself after
 * triangulation, or "4-manifold edge" (one shared edge has two pairs
 * of triangles). CGAL's stitch_boundary_cycles / Manifold's
 * DedupeEdges resolve by duplicating endpoints and adding edges to
 * separate the topology.
 *
 * This file demonstrates the figure-eight directly: a face whose
 * single outer wire visits a corner vertex twice -- the wire winds
 * around a left lobe, returns through the central vertex, then
 * winds around the right lobe before closing. Vertex #114 (centre)
 * is the pinch point shared by both lobes.
 *      _______        _______
 *     |       |      |       |
 *     |  L    |  X   |   R   |     X = pinch vertex (#114)
 *     |_______|______|_______|
 * Sources: H002, H011, H041, L013. */
HEADER;
FILE_DESCRIPTION(('Tsh039 test case','Figure-eight self-touching boundary'),'2;1');
