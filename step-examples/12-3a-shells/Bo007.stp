ISO-10303-21;
/* Bo007 - Same face referenced twice in a shell.
 * Defect: CLOSED_SHELL.cfs_faces contains the same ADVANCED_FACE
 * entity reference twice. The shell over-counts the same surface
 * region as belonging to the boundary twice. */
HEADER;
FILE_DESCRIPTION(('Bo007 - duplicate face in shell','Pass C gap-fill'),'2;1');
FILE_NAME('Bo007.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Four corner points of a unit square in the z=0 plane. */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('',(1.0,1.0,0.0));
#13=CARTESIAN_POINT('',(0.0,1.0,0.0));
#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
#22=VERTEX_POINT('',#12);
#23=VERTEX_POINT('',#13);
/* Edges */
#30=DIRECTION('',(1.0,0.0,0.0));
#31=VECTOR('',#30,1.0);
#32=DIRECTION('',(0.0,1.0,0.0));
#33=VECTOR('',#32,1.0);
#40=LINE('',#10,#31); #41=EDGE_CURVE('',#20,#21,#40,.T.);
#42=LINE('',#11,#33); #43=EDGE_CURVE('',#21,#22,#42,.T.);
#44=LINE('',#13,#31); #45=EDGE_CURVE('',#23,#22,#44,.T.);
#46=LINE('',#10,#33); #47=EDGE_CURVE('',#20,#23,#46,.T.);
#50=ORIENTED_EDGE('',*,*,#41,.T.);
#51=ORIENTED_EDGE('',*,*,#43,.T.);
#52=ORIENTED_EDGE('',*,*,#45,.F.);
#53=ORIENTED_EDGE('',*,*,#47,.F.);
#60=EDGE_LOOP('',(#50,#51,#52,#53));
#61=FACE_OUTER_BOUND('',#60,.T.);
#70=DIRECTION('',(0.0,0.0,1.0));
#71=DIRECTION('',(1.0,0.0,0.0));
#72=AXIS2_PLACEMENT_3D('',#10,#70,#71);
#73=PLANE('p',#72);
#100=ADVANCED_FACE('the_face',(#61),#73,.T.);
/* Defect: face #100 listed twice in the shell face list. */
#200=CLOSED_SHELL('shell_with_duplicate_face',(#100,#100));
/* PRODUCT chain so OCCT loads the shell. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Bo007','Bo007','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#200));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
