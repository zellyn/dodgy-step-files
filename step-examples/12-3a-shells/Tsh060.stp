ISO-10303-21;
/* Tsh060 - Same-surface face merge runs quadratically across disjoint shells
 * Compound of 8 small disjoint single-face shells (each a 1x1 plane patch),
 * spaced along the X axis. Catalog calls for 50; this fixture is a scaled
 * representative -- topology pattern (N independent shells in a compound) is
 * identical and exercises the same O(N^2) candidate-pair iteration. */
HEADER;
FILE_DESCRIPTION(('Tsh060 test case','Compound of 8 disjoint shells (scaled representative of 50)'),'2;1');
FILE_NAME('Tsh060.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
