ISO-10303-21;
/* Tsh064 - Same-surface face merge edge-removal history contract is undocumented
 * Two coplanar quads sharing edge E (V_S0 -> V_S1 along x=1) via the same
 * EDGE_CURVE (#47, with reversed orientation in face B). The edge is the
 * one whose post-merge fate in the modification history is the contract
 * being tested. STEP has no canonical "modification history" entity; the
 * fixture establishes the topology precondition. */
HEADER;
FILE_DESCRIPTION(('Tsh064 test case','Two coplanar faces sharing edge E -- modification history contract precondition'),'2;1');
