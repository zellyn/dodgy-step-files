#213=VERTEX_POINT('',#203);
/* Face 2 edges */
#220=DIRECTION('x',(1.0,0.0,0.0));
#221=VECTOR('',#220,1.0);
#222=LINE('',#201,#221);
#223=EDGE_CURVE('',#211,#212,#222,.T.);
#224=DIRECTION('y',(0.0,1.0,0.0));
#225=VECTOR('',#224,1.0);
#226=LINE('',#202,#225);
