#120=DIRECTION('x',(1.0,0.0,0.0));
#121=VECTOR('',#120,1.0);
#122=LINE('',#100,#121);
#123=EDGE_CURVE('',#110,#111,#122,.T.);
#124=DIRECTION('y',(0.0,1.0,0.0));
#125=VECTOR('',#124,1.0);
#126=LINE('',#101,#125);
#127=EDGE_CURVE('',#111,#112,#126,.T.);
#128=DIRECTION('x',(-1.0,0.0,0.0));
#129=VECTOR('',#128,1.0);
#130=LINE('',#102,#129);
#131=EDGE_CURVE('',#112,#103,#130,.T.);
