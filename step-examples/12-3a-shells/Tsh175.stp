#133=VECTOR('',#132,1.0);
#134=LINE('',#103,#133);
#135=EDGE_CURVE('',#113,#110,#134,.T.);
/* Face 1 loop */
#140=ORIENTED_EDGE('',*,*,#123,.T.);
#141=ORIENTED_EDGE('',*,*,#127,.T.);
#142=ORIENTED_EDGE('',*,*,#131,.T.);
#143=ORIENTED_EDGE('',*,*,#135,.T.);
#144=EDGE_LOOP('',(#140,#141,#142,#143));
#145=FACE_OUTER_BOUND('',#144,.T.);
#146=ADVANCED_FACE('',(#145),#14,.T.);
/* Face 2: [1,2]x[1,2] square touching Face 1 at corner (1,1) */
#200=CARTESIAN_POINT('f2p0',(1.0,1.0,0.0));
#201=CARTESIAN_POINT('f2p1',(2.0,1.0,0.0));
#202=CARTESIAN_POINT('f2p2',(2.0,2.0,0.0));
#203=CARTESIAN_POINT('f2p3',(1.0,2.0,0.0));
#210=VERTEX_POINT('',#200);
#211=VERTEX_POINT('',#201);
