#232=DIRECTION('y',(-1.0,0.0,0.0));
#233=VECTOR('',#232,1.0);
#234=LINE('',#200,#233);
#235=EDGE_CURVE('',#210,#211,#234,.T.);
/* Face 2 loop */
#240=ORIENTED_EDGE('',*,*,#235,.T.);
