ISO-10303-21;
/* Tsh175 - ShapeAnalysis_Shell.CheckOrientedShells with-self-touching-shell
 * Defect: shell where two faces touch at a single point (not edge);
 * CheckOrientedShells uses edge-only adjacency and misses the touch.
 * Tests: shell with two square faces meeting at one vertex corner. */
HEADER;
FILE_DESCRIPTION(('Tsh175 test case','ShapeAnalysis_Shell self-touching-point'),'2;1');
FILE_NAME('Tsh175.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Plane Z=0 */
#10=DIRECTION('z',(0.0,0.0,1.0));
#11=DIRECTION('x',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('',(0.5,0.5,0.0));
