ISO-10303-21;
/* Tsh049 - Internal edges lost during shell-level face merge
 * Two coplanar rectangular faces (face A: x in [0,2]; face B: x in [2,4]),
 * sharing the edge along x=2. Each face has one inner circular wire (a
 * hole). Each FACE_OUTER_BOUND wraps a 2x1 rectangular wire, and each
 * FACE_INNER_BOUND wraps a circular hole. Wrapped as OPEN_SHELL. */
HEADER;
FILE_DESCRIPTION(('Tsh049 test case','Two coplanar rectangles, each with one inner circular hole, sharing edge x=2'),'2;1');
FILE_NAME('Tsh049.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
/* Six perimeter vertices; faces A,B share x=2 edge */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));#21=VERTEX_POINT('V_A0',#20);
#22=CARTESIAN_POINT('',(2.0,0.0,0.0));#23=VERTEX_POINT('V_S0',#22);
#24=CARTESIAN_POINT('',(4.0,0.0,0.0));#25=VERTEX_POINT('V_B0',#24);
#26=CARTESIAN_POINT('',(4.0,1.0,0.0));#27=VERTEX_POINT('V_B1',#26);
#28=CARTESIAN_POINT('',(2.0,1.0,0.0));#29=VERTEX_POINT('V_S1',#28);
#30=CARTESIAN_POINT('',(0.0,1.0,0.0));#31=VERTEX_POINT('V_A1',#30);
/* Edges */
#40=DIRECTION('',(1.0,0.0,0.0));#41=VECTOR('',#40,1.0);#42=LINE('',#20,#41);#43=EDGE_CURVE('A_bottom',#21,#23,#42,.T.);
/* SHARED edge V_S0 -> V_S1 along x=2 */
#44=DIRECTION('',(0.0,1.0,0.0));#45=VECTOR('',#44,1.0);#46=LINE('',#22,#45);#47=EDGE_CURVE('shared_x2',#23,#29,#46,.T.);
#48=DIRECTION('',(-1.0,0.0,0.0));#49=VECTOR('',#48,1.0);#50=LINE('',#28,#49);#51=EDGE_CURVE('A_top',#29,#31,#50,.T.);
#52=DIRECTION('',(0.0,-1.0,0.0));#53=VECTOR('',#52,1.0);#54=LINE('',#30,#53);#55=EDGE_CURVE('A_left',#31,#21,#54,.T.);
#56=DIRECTION('',(1.0,0.0,0.0));#57=VECTOR('',#56,1.0);#58=LINE('',#22,#57);#59=EDGE_CURVE('B_bottom',#23,#25,#58,.T.);
#60=DIRECTION('',(0.0,1.0,0.0));#61=VECTOR('',#60,1.0);#62=LINE('',#24,#61);#63=EDGE_CURVE('B_right',#25,#27,#62,.T.);
#64=DIRECTION('',(-1.0,0.0,0.0));#65=VECTOR('',#64,1.0);#66=LINE('',#26,#65);#67=EDGE_CURVE('B_top',#27,#29,#66,.T.);
/* Face A outer wire: A_bottom, shared, A_top, A_left */
#70=ORIENTED_EDGE('',*,*,#43,.T.);#71=ORIENTED_EDGE('',*,*,#47,.T.);
#72=ORIENTED_EDGE('',*,*,#51,.T.);#73=ORIENTED_EDGE('',*,*,#55,.T.);
#74=EDGE_LOOP('A_outer',(#70,#71,#72,#73));#75=FACE_OUTER_BOUND('',#74,.T.);
/* Face A inner circle at (1.0, 0.5) radius 0.2 */
#80=CARTESIAN_POINT('hole_A_centre',(1.0,0.5,0.0));#81=DIRECTION('',(0.0,0.0,1.0));
#82=DIRECTION('',(1.0,0.0,0.0));#83=AXIS2_PLACEMENT_3D('',#80,#81,#82);
#84=CIRCLE('hole_A',#83,0.2);
#85=CARTESIAN_POINT('',(1.2,0.5,0.0));#86=VERTEX_POINT('V_holeA',#85);
#87=EDGE_CURVE('hole_A_edge',#86,#86,#84,.T.);
#88=ORIENTED_EDGE('',*,*,#87,.T.);#89=EDGE_LOOP('hole_A_loop',(#88));
#90=FACE_INNER_BOUND('inner_A',#89,.T.);
#100=ADVANCED_FACE('faceA_with_inner_hole',(#75,#90),#14,.T.);
/* Face B outer wire: B_bottom, B_right, B_top, shared(F) */
#110=ORIENTED_EDGE('',*,*,#59,.T.);#111=ORIENTED_EDGE('',*,*,#63,.T.);
#112=ORIENTED_EDGE('',*,*,#67,.T.);#113=ORIENTED_EDGE('',*,*,#47,.F.);
#114=EDGE_LOOP('B_outer',(#110,#111,#112,#113));#115=FACE_OUTER_BOUND('',#114,.T.);
/* Face B inner circle at (3.0, 0.5) radius 0.2 */
#120=CARTESIAN_POINT('hole_B_centre',(3.0,0.5,0.0));#121=DIRECTION('',(0.0,0.0,1.0));
#122=DIRECTION('',(1.0,0.0,0.0));#123=AXIS2_PLACEMENT_3D('',#120,#121,#122);
#124=CIRCLE('hole_B',#123,0.2);
#125=CARTESIAN_POINT('',(3.2,0.5,0.0));#126=VERTEX_POINT('V_holeB',#125);
#127=EDGE_CURVE('hole_B_edge',#126,#126,#124,.T.);
#128=ORIENTED_EDGE('',*,*,#127,.T.);#129=EDGE_LOOP('hole_B_loop',(#128));
#130=FACE_INNER_BOUND('inner_B',#129,.T.);
#140=ADVANCED_FACE('faceB_with_inner_hole',(#115,#130),#14,.T.);
#150=OPEN_SHELL('two_coplanar_faces_each_with_hole',(#100,#140));
ENDSEC;
END-ISO-10303-21;
