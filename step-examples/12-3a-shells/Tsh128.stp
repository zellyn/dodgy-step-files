ISO-10303-21;
/* Tsh128 - ShapeFix_Shell.FixFaceOrientation early-exit
 * Defect: Perform's early-exit condition (myStatus contains FAIL2) triggers on
 * a false positive, halting before all faces are processed */
HEADER;
FILE_DESCRIPTION(('Tsh128 - shell where early-exit halts face processing prematurely','wave 26'),'2;1');
FILE_NAME('Tsh128.stp','2026-06-15T00:00:00',(''),(''),'heal coverage','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Shell with 5 faces where processing face 2 causes false FAIL2 status,
 * triggering early exit before faces 3-5 are processed.
 * Face 1: bottom (0,0,0)-(10,0,0)-(10,10,0)-(0,10,0) normal OK
 * Face 2: left side with edge touching face 1 at non-vertex point (causes false-positive error)
 * Faces 3-5: remaining sides that won't be processed due to early exit */

#10=CARTESIAN_POINT('',(0,0,0));
#11=CARTESIAN_POINT('',(10.0,0,0));
#12=CARTESIAN_POINT('',(10.0,10.0,0));
#13=CARTESIAN_POINT('',(0,10.0,0));
#14=CARTESIAN_POINT('',(0,0,10.0));
#15=CARTESIAN_POINT('',(10.0,0,10.0));
#16=CARTESIAN_POINT('',(10.0,10.0,10.0));
#17=CARTESIAN_POINT('',(0,10.0,10.0));
#18=CARTESIAN_POINT('',(5.0,0,0));
#19=CARTESIAN_POINT('',(5.0,0,10.0));

#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
#22=VERTEX_POINT('',#12);
#23=VERTEX_POINT('',#13);
#24=VERTEX_POINT('',#14);
#25=VERTEX_POINT('',#15);
#26=VERTEX_POINT('',#16);
#27=VERTEX_POINT('',#17);
#28=VERTEX_POINT('',#18);
#29=VERTEX_POINT('',#19);

/* Planes */
#30=AXIS2_PLACEMENT_3D('z0_plane',#10,DIRECTION('',(0,0,-1)),DIRECTION('',(1,0,0)));
#31=PLANE('',#30);
#32=AXIS2_PLACEMENT_3D('x0_plane',#10,DIRECTION('',(-1,0,0)),DIRECTION('',(0,1,0)));
#33=PLANE('',#32);
#34=AXIS2_PLACEMENT_3D('y0_plane',#10,DIRECTION('',(0,-1,0)),DIRECTION('',(1,0,0)));
#35=PLANE('',#34);
#36=AXIS2_PLACEMENT_3D('y10_plane',#13,DIRECTION('',(0,1,0)),DIRECTION('',(1,0,0)));
#37=PLANE('',#36);
#38=AXIS2_PLACEMENT_3D('x10_plane',#11,DIRECTION('',(1,0,0)),DIRECTION('',(0,1,0)));
#39=PLANE('',#38);

/* Face 1 (bottom) edges */
#50=LINE('',#10,VECTOR('',(1,0,0),10.0));
#51=EDGE_CURVE('f1_e1',#20,#21,#50,.T.);
#52=LINE('',#11,VECTOR('',(0,1,0),10.0));
#53=EDGE_CURVE('f1_e2',#21,#22,#52,.T.);
#54=LINE('',#12,VECTOR('',(-1,0,0),10.0));
#55=EDGE_CURVE('f1_e3',#22,#23,#54,.T.);
#56=LINE('',#13,VECTOR('',(0,-1,0),10.0));
#57=EDGE_CURVE('f1_e4',#23,#20,#56,.T.);

/* Face 2 (left) edges - with mid-edge touching (non-vertex contact) */
#60=LINE('',#10,VECTOR('',(0,1,0),10.0));
#61=EDGE_CURVE('f2_e1',#20,#23,#60,.T.);
#62=LINE('',#13,VECTOR('',(0,0,1),10.0));
#63=EDGE_CURVE('f2_e2',#23,#24,#62,.T.);
#64=LINE('',#14,VECTOR('',(0,-1,0),10.0));
#65=EDGE_CURVE('f2_e3',#24,#20,#64,.T.);

/* Face 3 (front) edges */
#70=LINE('',#10,VECTOR('',(1,0,0),10.0));
#71=EDGE_CURVE('f3_e1',#20,#21,#70,.T.);
#72=LINE('',#11,VECTOR('',(0,0,1),10.0));
#73=EDGE_CURVE('f3_e2',#21,#25,#72,.T.);
#74=LINE('',#15,VECTOR('',(-1,0,0),10.0));
#75=EDGE_CURVE('f3_e3',#25,#24,#74,.T.);
#76=LINE('',#14,VECTOR('',(0,0,-1),10.0));
#77=EDGE_CURVE('f3_e4',#24,#20,#76,.T.);

/* Face 4 (back) edges */
#80=LINE('',#13,VECTOR('',(0,0,1),10.0));
#81=EDGE_CURVE('f4_e1',#23,#27,#80,.T.);
#82=LINE('',#17,VECTOR('',(1,0,0),10.0));
#83=EDGE_CURVE('f4_e2',#27,#26,#82,.T.);
#84=LINE('',#16,VECTOR('',(0,0,-1),10.0));
#85=EDGE_CURVE('f4_e3',#26,#22,#84,.T.);
#86=LINE('',#12,VECTOR('',(-1,0,0),10.0));
#87=EDGE_CURVE('f4_e4',#22,#23,#86,.T.);

/* Face 5 (right) edges */
#90=LINE('',#11,VECTOR('',(1,0,0),0.0));
#91=EDGE_CURVE('f5_e1',#21,#25,#90,.T.);
#92=LINE('',#15,VECTOR('',(0,1,0),10.0));
#93=EDGE_CURVE('f5_e2',#25,#26,#92,.T.);
#94=LINE('',#16,VECTOR('',(-1,0,0),0.0));
#95=EDGE_CURVE('f5_e3',#26,#22,#94,.T.);
#96=LINE('',#12,VECTOR('',(0,-1,0),10.0));
#97=EDGE_CURVE('f5_e4',#22,#21,#96,.T.);

/* Face 1 edge loop */
#100=ORIENTED_EDGE('',*,*,#51,.T.);
#101=ORIENTED_EDGE('',*,*,#53,.T.);
#102=ORIENTED_EDGE('',*,*,#55,.T.);
#103=ORIENTED_EDGE('',*,*,#57,.T.);
#104=EDGE_LOOP('f1_loop',(#100,#101,#102,#103));

/* Face 2 edge loop (triggers false FAIL2) */
#110=ORIENTED_EDGE('',*,*,#61,.T.);
#111=ORIENTED_EDGE('',*,*,#63,.T.);
#112=ORIENTED_EDGE('',*,*,#65,.T.);
#114=EDGE_LOOP('f2_loop',(#110,#111,#112));

/* Face 3 edge loop */
#120=ORIENTED_EDGE('',*,*,#71,.T.);
#121=ORIENTED_EDGE('',*,*,#73,.T.);
#122=ORIENTED_EDGE('',*,*,#75,.T.);
#123=ORIENTED_EDGE('',*,*,#77,.T.);
#124=EDGE_LOOP('f3_loop',(#120,#121,#122,#123));

/* Face 4 edge loop */
#130=ORIENTED_EDGE('',*,*,#81,.T.);
#131=ORIENTED_EDGE('',*,*,#83,.T.);
#132=ORIENTED_EDGE('',*,*,#85,.T.);
#133=ORIENTED_EDGE('',*,*,#87,.T.);
#134=EDGE_LOOP('f4_loop',(#130,#131,#132,#133));

/* Face 5 edge loop */
#140=ORIENTED_EDGE('',*,*,#91,.T.);
#141=ORIENTED_EDGE('',*,*,#93,.T.);
#142=ORIENTED_EDGE('',*,*,#95,.T.);
#143=ORIENTED_EDGE('',*,*,#97,.T.);
#144=EDGE_LOOP('f5_loop',(#140,#141,#142,#143));

/* Face bounds */
#150=FACE_OUTER_BOUND('',#104,.T.);
#151=FACE_OUTER_BOUND('',#114,.T.);
#152=FACE_OUTER_BOUND('',#124,.T.);
#153=FACE_OUTER_BOUND('',#134,.T.);
#154=FACE_OUTER_BOUND('',#144,.T.);

/* Faces */
#160=ADVANCED_FACE('f1',(#150),#31,.T.);
#161=ADVANCED_FACE('f2_problem',(#151),#33,.T.);
#162=ADVANCED_FACE('f3',(#152),#35,.T.);
#163=ADVANCED_FACE('f4',(#153),#36,.T.);
#164=ADVANCED_FACE('f5',(#154),#39,.T.);

/* Shell with problematic face causing early exit */
#200=OPEN_SHELL('early_exit_shell',(#160,#161,#162,#163,#164));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh128','Tsh128','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#200));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
