ISO-10303-21;
/* Tsh073 - Perform called twice on same shell leaves stale orientation state
 * This fixture demonstrates the context state reuse vulnerability in
 * ShapeFix_Shell.Perform at line 102. When Perform() is called a second time
 * on the same shell without resetting context, accumulated reshape operations
 * from the first call are applied again, causing double-fixes. */
HEADER;
FILE_DESCRIPTION(('Tsh073 - Perform context state reuse vulnerability','Shell demonstrating double-fix via stale context'),'2;1');
