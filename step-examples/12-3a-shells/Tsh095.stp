ISO-10303-21;
/* Tsh095 - ShapeUpgrade_ShellSewing.ApplySewing self-intersecting shell
 * Defect: Shell with two faces that intersect each other (T-intersection).
 * Face A spans (0..4 x 0..4 x 0), Face B spans (2..2.5 x -1..5 x 0).
 * Their edges cross geometrically; ApplySewing must detect and reject but proceeds. */
HEADER;
FILE_DESCRIPTION(('Tsh095 - self-intersecting shell with T-crossing'',''2;1'',''2;1'),'2;1');
FILE_NAME('Tsh095.stp','2026-06-15T00:00:00',(''),(''),'wave-14','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Face A: square 0..4 x 0..4 x 0 */
#100=CARTESIAN_POINT('',(0,0,0));
#101=CARTESIAN_POINT('',(4,0,0));
#102=CARTESIAN_POINT('',(4,4,0));
#103=CARTESIAN_POINT('',(0,4,0));
#110=VERTEX_POINT('',#100);
#111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102);
#113=VERTEX_POINT('',#103);

/* Face B: narrow strip 2..2.5 x -1..5 x 0 (T-intersection) */
#104=CARTESIAN_POINT('',(2.0,-1,0));
#105=CARTESIAN_POINT('',(2.5,-1,0));
#106=CARTESIAN_POINT('',(2.5,5,0));
#107=CARTESIAN_POINT('',(2.0,5,0));
#114=VERTEX_POINT('',#104);
#115=VERTEX_POINT('',#105);
#116=VERTEX_POINT('',#106);
#117=VERTEX_POINT('',#107);

/* Plane z=0 */
#300=DIRECTION('',(0,0,1));
#301=DIRECTION('',(1,0,0));
#120=AXIS2_PLACEMENT_3D('',#100,#300,#301);
#122=PLANE('',#120);

/* Face A edges: bottom, right, top, left */
#320=DIRECTION('',(1.0,0.0,0.0));
#340=VECTOR('',#320,4.0);
#150=LINE('',#100,#340);
#151=EDGE_CURVE('a_bot',#110,#111,#150,.T.);

#321=DIRECTION('',(0.0,1.0,0.0));
#341=VECTOR('',#321,4.0);
#152=LINE('',#101,#341);
#153=EDGE_CURVE('a_right',#111,#112,#152,.T.);

#322=DIRECTION('',(-1.0,0.0,0.0));
#342=VECTOR('',#322,4.0);
#154=LINE('',#102,#342);
#155=EDGE_CURVE('a_top',#112,#113,#154,.T.);

#323=DIRECTION('',(0.0,-1.0,0.0));
#343=VECTOR('',#323,4.0);
#156=LINE('',#103,#343);
#157=EDGE_CURVE('a_left',#113,#110,#156,.T.);

/* Face A loop */
#180=ORIENTED_EDGE('',*,*,#151,.T.);
#181=ORIENTED_EDGE('',*,*,#153,.T.);
#182=ORIENTED_EDGE('',*,*,#155,.T.);
#183=ORIENTED_EDGE('',*,*,#157,.T.);
#210=EDGE_LOOP('loopa',(#180,#181,#182,#183));
#220=FACE_OUTER_BOUND('',#210,.T.);
#230=ADVANCED_FACE('face_a',(#220),#122,.T.);

/* Face B edges (strip) */
#324=DIRECTION('',(1.0,0.0,0.0));
#344=VECTOR('',#324,0.5);
#158=LINE('',#104,#344);
#159=EDGE_CURVE('b_bot',#114,#115,#158,.T.);

#325=DIRECTION('',(0.0,1.0,0.0));
#345=VECTOR('',#325,6.0);
#160=LINE('',#105,#345);
#161=EDGE_CURVE('b_right',#115,#116,#160,.T.);

#326=DIRECTION('',(-1.0,0.0,0.0));
#346=VECTOR('',#326,0.5);
#162=LINE('',#106,#346);
#163=EDGE_CURVE('b_top',#116,#117,#162,.T.);

#327=DIRECTION('',(0.0,-1.0,0.0));
#347=VECTOR('',#327,6.0);
#164=LINE('',#107,#347);
#165=EDGE_CURVE('b_left',#117,#114,#164,.T.);

/* Face B loop */
#184=ORIENTED_EDGE('',*,*,#159,.T.);
#185=ORIENTED_EDGE('',*,*,#161,.T.);
#186=ORIENTED_EDGE('',*,*,#163,.T.);
#187=ORIENTED_EDGE('',*,*,#165,.T.);
#211=EDGE_LOOP('loopb',(#184,#185,#186,#187));
#221=FACE_OUTER_BOUND('',#211,.T.);
#231=ADVANCED_FACE('face_b',(#221),#122,.T.);

/* Shell with self-intersecting faces */
#240=CLOSED_SHELL('intersecting_shell',(#230,#231));
#950=MANIFOLD_SOLID_BREP('Tsh095_intersect',#240);

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh095','Tsh095','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#240));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
