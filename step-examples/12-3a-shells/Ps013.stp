ISO-10303-21;
/* Ps013 - Chiral part mirrored by silent X-coordinate negation.
 * Defect: the author's intent is a right-handed asymmetric body;
 * the receiver's CAD-to-CAD round-trip silently negates all X
 * coordinates, producing the left-handed mirror image. Detectable
 * via the sign of the determinant of any AXIS2_PLACEMENT_3D.
 * Here represented as a cube whose centroid has been moved into
 * the -X half-space (a content marker the kernel can check). */
HEADER;
FILE_DESCRIPTION(('Ps013 - silent X-coord negation (chiral mirror)'),'2;1');
FILE_NAME('Ps013.stp','2026-06-15T00:00:00',(''),(''),'catalog-regen','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

