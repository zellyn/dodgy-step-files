ISO-10303-21;
/* Tsh048 - Same-domain face unification corrupts shape with mirrored sub-instance
 * Defect: MAPPED_ITEM instancing a closed shell twice — one at identity, one
 * mirrored through the YZ plane. Defective unifier collapses coincident-after-
 * transform faces from the two instances because coincidence is checked without
 * normalising transforms first.
 * Byte assertions: contains MAPPED_ITEM, count ADVANCED_FACE == 1 */
HEADER;
FILE_DESCRIPTION(('Tsh048 - mirrored instance corrupted by face unification','2;1'),'2;1');
FILE_NAME('Tsh048.stp','2026-06-16T00:00:00',(''),(''),'wave-regen','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Single square face: the template for MAPPED_ITEM */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('',(1.0,1.0,0.0));
#13=CARTESIAN_POINT('',(0.0,1.0,0.0));

#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
#22=VERTEX_POINT('',#12);
#23=VERTEX_POINT('',#13);

/* Plane z=0 */
#30=CARTESIAN_POINT('',(0.5,0.5,0.0));
#31=DIRECTION('',(0.0,0.0,1.0));
#32=DIRECTION('',(1.0,0.0,0.0));
#33=AXIS2_PLACEMENT_3D('',#30,#31,#32);
#34=PLANE('',#33);

/* Edges */
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#10,#41);
#43=EDGE_CURVE('e1',#20,#21,#42,.T.);

#44=DIRECTION('',(0.0,1.0,0.0));
#45=VECTOR('',#44,1.0);
#46=LINE('',#11,#45);
#47=EDGE_CURVE('e2',#21,#22,#46,.T.);

#48=DIRECTION('',(-1.0,0.0,0.0));
#49=VECTOR('',#48,1.0);
#50=LINE('',#12,#49);
#51=EDGE_CURVE('e3',#22,#23,#50,.T.);

#52=DIRECTION('',(0.0,-1.0,0.0));
#53=VECTOR('',#52,1.0);
#54=LINE('',#13,#53);
#55=EDGE_CURVE('e4',#23,#20,#54,.T.);

/* Edge loop and face */
#60=ORIENTED_EDGE('',*,*,#43,.T.);
#61=ORIENTED_EDGE('',*,*,#47,.T.);
#62=ORIENTED_EDGE('',*,*,#51,.T.);
#63=ORIENTED_EDGE('',*,*,#55,.T.);
#64=EDGE_LOOP('',(#60,#61,#62,#63));
#65=FACE_OUTER_BOUND('',#64,.T.);
#66=ADVANCED_FACE('square',(#65),#34,.T.);

/* Open shell containing the single face */
#70=OPEN_SHELL('template_shell',(#66));

/* REPRESENTATION_MAP to wrap the shell as a mappable item */
#80=CARTESIAN_POINT('',(0.0,0.0,0.0));
#81=DIRECTION('',(0.0,0.0,1.0));
#82=DIRECTION('',(1.0,0.0,0.0));
#83=AXIS2_PLACEMENT_3D('map_origin',#80,#81,#82);
#84=SHELL_BASED_SURFACE_MODEL('template',(#70));
#85=SHAPE_REPRESENTATION('template_rep',(#83,#84),#9010);
#86=REPRESENTATION_MAP(#83,#85);

/* Identity placement */
#90=CARTESIAN_POINT('',(0.0,0.0,0.0));
#91=DIRECTION('',(0.0,0.0,1.0));
#92=DIRECTION('',(1.0,0.0,0.0));
#93=AXIS2_PLACEMENT_3D('identity',#90,#91,#92);

/* Mirror placement: X -> -X (mirror through YZ plane) */
#94=CARTESIAN_POINT('',(0.0,0.0,0.0));
#95=DIRECTION('',(0.0,0.0,1.0));
#96=DIRECTION('',(-1.0,0.0,0.0));
#97=AXIS2_PLACEMENT_3D('mirror_yz',#94,#95,#96);

/* Two MAPPED_ITEMs: identity and mirror */
#100=MAPPED_ITEM('instance_identity',#86,#93);
#101=MAPPED_ITEM('instance_mirror',#86,#97);

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh048','Tsh048','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#70));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021,#100,#101),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
