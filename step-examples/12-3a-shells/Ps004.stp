/* Ps004 - AXIS2_PLACEMENT_3D with left-handed basis on a child shape - kernel accepts file silently; tier-3 introspection reveals the placement is a reflection, not a rotation */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ps004 pathological-success','Left-handed AXIS2_PLACEMENT_3D'),'2;1');
FILE_NAME('Ps004.stp','2026-04-26T00:00:00',(''),(''),'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Single tetrahedral solid placed via AXIS2_PLACEMENT_3D whose
   axis = +Z and ref_direction = +X. The schema computes the third basis
   vector as axis x ref_direction = +Y (right-handed). But here the
   author intended a Y-axis pointing in -Y (a mirror about the XZ plane).
   Because AXIS2_PLACEMENT_3D only stores axis + ref_direction and the
   third is computed, no diagnostic fires; instead the producer encodes
   the mirror by giving ref_direction = (1,0,0) AND swapping the role of
   X and Y in the consumer's downstream chain (e.g. by feeding negated
   coordinates as if they were positive). Here we exhibit the simpler
   form: a placement where ref_direction is intentionally NOT
   perpendicular to axis -- it has a -1.0 component along the axis that,
   per spec, must be projected out, but if the kernel accepts the raw
   vector and Gram-Schmidt-corrects silently, the result depends on the
   correction and the producer's intent is lost. */
/* Tetrahedron vertices (in placement-local frame) */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('',(0.0,1.0,0.0));
#103=CARTESIAN_POINT('',(0.0,0.0,1.0));
#110=VERTEX_POINT('',#100); #111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102); #113=VERTEX_POINT('',#103);
/* Surfaces */
#200=DIRECTION('',(0.0,0.0,1.0)); /* placeholder face axes */
#201=DIRECTION('',(1.0,0.0,0.0));
/* Bottom (z=0): normal -Z */
#202=DIRECTION('',(0.0,0.0,-1.0));
#210=AXIS2_PLACEMENT_3D('',#100,#202,#201); #212=PLANE('',#210);
/* X=0 face: normal -X */
#203=DIRECTION('',(-1.0,0.0,0.0)); #204=DIRECTION('',(0.0,1.0,0.0));
#220=AXIS2_PLACEMENT_3D('',#100,#203,#204); #222=PLANE('',#220);
/* Y=0 face: normal -Y */
#205=DIRECTION('',(0.0,-1.0,0.0));
#230=AXIS2_PLACEMENT_3D('',#100,#205,#201); #232=PLANE('',#230);
/* Slant face through (1,0,0)(0,1,0)(0,0,1): normal = (1,1,1)/sqrt(3) */
#206=DIRECTION('',(0.5773502691896258,0.5773502691896258,0.5773502691896258));
#207=DIRECTION('',(0.7071067811865475,-0.7071067811865475,0.0));
#240=AXIS2_PLACEMENT_3D('',#101,#206,#207); #242=PLANE('',#240);
/* Edges */
#300=DIRECTION('',(1.0,0.0,0.0)); #301=VECTOR('',#300,1.0);
#302=DIRECTION('',(0.0,1.0,0.0)); #303=VECTOR('',#302,1.0);
#304=DIRECTION('',(0.0,0.0,1.0)); #305=VECTOR('',#304,1.0);
#306=DIRECTION('',(-0.7071067811865475,0.7071067811865475,0.0)); #307=VECTOR('',#306,1.4142135623730951);
#308=DIRECTION('',(-0.7071067811865475,0.0,0.7071067811865475)); #309=VECTOR('',#308,1.4142135623730951);
#310=DIRECTION('',(0.0,-0.7071067811865475,0.7071067811865475)); #341=VECTOR('',#310,1.4142135623730951);
#311=LINE('',#100,#301); #312=EDGE_CURVE('',#110,#111,#311,.T.);
#313=LINE('',#100,#303); #314=EDGE_CURVE('',#110,#112,#313,.T.);
#315=LINE('',#100,#305); #316=EDGE_CURVE('',#110,#113,#315,.T.);
#317=LINE('',#101,#307); #318=EDGE_CURVE('',#111,#112,#317,.T.);
#319=LINE('',#101,#309); #320=EDGE_CURVE('',#111,#113,#319,.T.);
#321=LINE('',#102,#341); #322=EDGE_CURVE('',#112,#113,#321,.T.);
/* Bottom face (z=0): vertices 110->112->111 going CCW seen from -z */
#400=ORIENTED_EDGE('',*,*,#314,.T.); #401=ORIENTED_EDGE('',*,*,#318,.F.); #402=ORIENTED_EDGE('',*,*,#312,.F.);
#403=EDGE_LOOP('',(#400,#401,#402)); #404=FACE_OUTER_BOUND('',#403,.T.);
#405=ADVANCED_FACE('bot',(#404),#212,.T.);
/* X=0 face (110->113->112) */
#410=ORIENTED_EDGE('',*,*,#316,.T.); #411=ORIENTED_EDGE('',*,*,#322,.F.); #412=ORIENTED_EDGE('',*,*,#314,.F.);
#413=EDGE_LOOP('',(#410,#411,#412)); #414=FACE_OUTER_BOUND('',#413,.T.);
#415=ADVANCED_FACE('xz',(#414),#222,.T.);
/* Y=0 face (110->111->113) */
#420=ORIENTED_EDGE('',*,*,#312,.T.); #421=ORIENTED_EDGE('',*,*,#320,.T.); #422=ORIENTED_EDGE('',*,*,#316,.F.);
#423=EDGE_LOOP('',(#420,#421,#422)); #424=FACE_OUTER_BOUND('',#423,.T.);
#425=ADVANCED_FACE('yz',(#424),#232,.T.);
/* Slant face (111->112->113) */
#430=ORIENTED_EDGE('',*,*,#318,.T.); #431=ORIENTED_EDGE('',*,*,#322,.T.); #432=ORIENTED_EDGE('',*,*,#320,.F.);
#433=EDGE_LOOP('',(#430,#431,#432)); #434=FACE_OUTER_BOUND('',#433,.T.);
#435=ADVANCED_FACE('slant',(#434),#242,.T.);
#500=CLOSED_SHELL('tetra',(#405,#415,#425,#435));
#510=MANIFOLD_SOLID_BREP('tet_solid',#500);
/* DEFECT: child placement that the kernel uses for the
   ITEM_DEFINED_TRANSFORMATION below. axis=(0,0,1), ref_direction=(0,1,0)
   yields computed Y_local = axis x ref = (0,0,1) x (0,1,0) = (-1,0,0).
   The producer then claims the global X axis is (-1,0,0), which is a
   reflection about the YZ plane masquerading as a rotation. The
   AXIS2_PLACEMENT_3D values themselves are individually unit and
   orthogonal; the left-handedness only emerges if the kernel checks
   the determinant of the resulting basis. */
#600=CARTESIAN_POINT('',(5.0,0.0,0.0));
#601=DIRECTION('',(0.0,0.0,1.0));
#602=DIRECTION('',(0.0,1.0,0.0));
#603=AXIS2_PLACEMENT_3D('LEFT_HANDED_PLACEMENT',#600,#601,#602);
/* Reference the placement via a CARTESIAN_TRANSFORMATION_OPERATOR_3D
   so it actually participates in the geometry graph. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Ps004','Ps004','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=ADVANCED_BREP_SHAPE_REPRESENTATION('',(#510,#603),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
