ISO-10303-21;
/* Tsh215: OPEN_SHELL with ONE ADVANCED_FACE IS the context-null-initialize defect trigger; unit square face IS at (0,0,0)-(1,1,0) with normal +Z — IS the face geometry; face has same_sense=False to trigger orientation repair — IS the repair-triggering condition; ShapeFix_Shell.Perform() IS the defect path: first Perform() call fixes face orientation; SetContext context IS NOT re-initialized between calls — IS the stale-context condition; stale BRep_Builder context accumulates reshape operations from first Perform() — IS the accumulation; second Perform() call reuses stale context — IS the double-apply path; second Perform() reapplies reshape operations to already-fixed shape — IS the double-fix defect; result: face orientation IS flipped twice, returning to wrong orientation — IS the defect outcome; fix: Perform() must null-initialize context (SetContext(nullptr)) before each call; emit E_CONTEXT_STALE_DOUBLE_FIX when reshape operations applied twice due to stale context */
HEADER;
FILE_DESCRIPTION(('Tsh215'),'2;1');
FILE_NAME('Tsh215.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
