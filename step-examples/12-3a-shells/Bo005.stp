ISO-10303-21;
/* Bo005 - Möbius-like shell: orientation flags admit no globally
 * consistent normal. Three rectangular faces in an OPEN_SHELL forming
 * a closed strip (face1->face2->face3->face1). Each adjacent pair
 * shares an EDGE_CURVE; the third face's same_sense flag is flipped
 * so traversing once around the strip flips orientation. */
HEADER;
FILE_DESCRIPTION(('Bo005 - non-orientable shell','Pass C gap-fill'),'2;1');
FILE_NAME('Bo005.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Three triangle-strip rectangles laid end to end (in the z=0 plane for
 * simplicity) and joined into a loop by sharing edges between
 * face1-face2, face2-face3, face3-face1. Topologically this is a
 * triangulated strip; the third face's same_sense=.F. produces the
 * Möbius-style orientation defect. */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('',(1.0,1.0,0.0));
#13=CARTESIAN_POINT('',(0.0,1.0,0.0));
#14=CARTESIAN_POINT('',(2.0,0.0,0.0));
#15=CARTESIAN_POINT('',(2.0,1.0,0.0));
#20=VERTEX_POINT('',#10); #21=VERTEX_POINT('',#11);
#22=VERTEX_POINT('',#12); #23=VERTEX_POINT('',#13);
#24=VERTEX_POINT('',#14); #25=VERTEX_POINT('',#15);
#30=DIRECTION('+x',(1.0,0.0,0.0)); #31=VECTOR('',#30,1.0);
#32=DIRECTION('+y',(0.0,1.0,0.0)); #33=VECTOR('',#32,1.0);
#34=DIRECTION('+z',(0.0,0.0,1.0));
#35=DIRECTION('-z',(0.0,0.0,-1.0));
/* Edges of three rectangles forming a closed strip. */
#40=LINE('',#10,#31); #41=EDGE_CURVE('e_bot1',#20,#21,#40,.T.);
#42=LINE('',#11,#33); #43=EDGE_CURVE('e_share_12',#21,#22,#42,.T.);
#44=LINE('',#13,#31); #45=EDGE_CURVE('e_top1',#23,#22,#44,.T.);
#46=LINE('',#10,#33); #47=EDGE_CURVE('e_share_31',#20,#23,#46,.T.);
#48=LINE('',#11,#31); #49=EDGE_CURVE('e_bot2',#21,#24,#48,.T.);
#50=LINE('',#14,#33); #51=EDGE_CURVE('e_share_23',#24,#25,#50,.T.);
#52=LINE('',#12,#31); #53=EDGE_CURVE('e_top2',#22,#25,#52,.T.);
/* Face 1: rectangle (#20,#21,#22,#23). Outer-bound CCW, normal +z. */
#60=ORIENTED_EDGE('',*,*,#41,.T.);
#61=ORIENTED_EDGE('',*,*,#43,.T.);
#62=ORIENTED_EDGE('',*,*,#45,.F.);
#63=ORIENTED_EDGE('',*,*,#47,.F.);
#64=EDGE_LOOP('',(#60,#61,#62,#63));
#65=FACE_OUTER_BOUND('',#64,.T.);
#66=AXIS2_PLACEMENT_3D('',#10,#34,#30);
#67=PLANE('p1',#66);
#100=ADVANCED_FACE('f1',(#65),#67,.T.);
/* Face 2: rectangle (#21,#24,#25,#22). Shares #43 with face 1. Normal +z. */
#70=ORIENTED_EDGE('',*,*,#49,.T.);
#71=ORIENTED_EDGE('',*,*,#51,.T.);
#72=ORIENTED_EDGE('',*,*,#53,.F.);
#73=ORIENTED_EDGE('',*,*,#43,.F.);
#74=EDGE_LOOP('',(#70,#71,#72,#73));
#75=FACE_OUTER_BOUND('',#74,.T.);
#76=AXIS2_PLACEMENT_3D('',#11,#34,#30);
#77=PLANE('p2',#76);
#101=ADVANCED_FACE('f2',(#75),#77,.T.);
/* Face 3: rectangle that closes the loop. It shares #51 with face 2 and
 * #47 with face 1. The defect: same_sense=.F. flips orientation when
 * the loop is closed, producing a Möbius-style shell. */
#80=ORIENTED_EDGE('',*,*,#51,.F.);
#81=ORIENTED_EDGE('',*,*,#47,.T.);
#82=ORIENTED_EDGE('',*,*,#45,.T.);
#83=ORIENTED_EDGE('',*,*,#53,.T.);
#84=EDGE_LOOP('',(#80,#81,#82,#83));
#85=FACE_OUTER_BOUND('',#84,.T.);
#86=AXIS2_PLACEMENT_3D('',#13,#35,#30);
#87=PLANE('p3_flipped',#86);
#102=ADVANCED_FACE('f3_flipped',(#85),#87,.F.);
#200=OPEN_SHELL('mobius_loop',(#100,#101,#102));
/* PRODUCT chain so OCCT loads the geometry. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Bo005','Bo005','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#200));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
