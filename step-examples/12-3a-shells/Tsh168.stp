ISO-10303-21;
/* Tsh168 - ShapeAnalysis_Shell.LoadShells skipping-non-shell
 * Defect: input compound has mixed entities (shells + solids + faces);
 * LoadShells filters to shells only and silently ignores the rest.
 * Tests: compound with non-shell children that are lost during loading. */
HEADER;
FILE_DESCRIPTION(('Tsh168 test case','ShapeAnalysis_Shell mixed-entity skipping'),'2;1');
FILE_NAME('Tsh168.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Geometry for shell */
#100=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('p1',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('p2',(1.0,1.0,0.0));
#103=CARTESIAN_POINT('p3',(0.0,1.0,0.0));
#110=VERTEX_POINT('',#100);
#111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102);
#113=VERTEX_POINT('',#103);
/* Geometry for separate face (not in shell) */
#120=CARTESIAN_POINT('f0',(0.0,0.0,2.0));
#121=CARTESIAN_POINT('f1',(1.0,0.0,2.0));
#122=CARTESIAN_POINT('f2',(1.0,1.0,2.0));
#123=CARTESIAN_POINT('f3',(0.0,1.0,2.0));
#130=VERTEX_POINT('',#120);
#131=VERTEX_POINT('',#121);
#132=VERTEX_POINT('',#122);
#133=VERTEX_POINT('',#123);
/* Plane surfaces */
#200=DIRECTION('z',(0.0,0.0,1.0));
#201=DIRECTION('x',(1.0,0.0,0.0));
#210=CARTESIAN_POINT('',(0.5,0.5,0.0));
#211=AXIS2_PLACEMENT_3D('',#210,#200,#201);
#212=PLANE('plane1',#211);
#220=CARTESIAN_POINT('',(0.5,0.5,2.0));
#221=AXIS2_PLACEMENT_3D('',#220,#200,#201);
#222=PLANE('plane2',#221);
/* Edges for shell face */
#300=DIRECTION('x',(1.0,0.0,0.0));
#301=VECTOR('',#300,1.0);
#302=DIRECTION('y',(0.0,1.0,0.0));
#303=VECTOR('',#302,1.0);
#310=LINE('',#100,#301); #311=EDGE_CURVE('',#110,#111,#310,.T.);
#312=LINE('',#101,#303); #313=EDGE_CURVE('',#111,#112,#312,.T.);
#314=LINE('',#103,#301); #315=EDGE_CURVE('',#113,#112,#314,.T.);
#316=LINE('',#100,#303); #317=EDGE_CURVE('',#110,#113,#316,.T.);
/* Edges for standalone face */
#320=LINE('',#120,#301); #321=EDGE_CURVE('',#130,#131,#320,.T.);
#322=LINE('',#121,#303); #323=EDGE_CURVE('',#131,#132,#322,.T.);
#324=LINE('',#123,#301); #325=EDGE_CURVE('',#133,#132,#324,.T.);
#326=LINE('',#120,#303); #327=EDGE_CURVE('',#130,#133,#326,.T.);
/* Shell face */
#400=ORIENTED_EDGE('',*,*,#311,.T.);
#401=ORIENTED_EDGE('',*,*,#313,.T.);
#402=ORIENTED_EDGE('',*,*,#315,.F.);
#403=ORIENTED_EDGE('',*,*,#317,.F.);
#404=EDGE_LOOP('',(#400,#401,#402,#403));
#405=FACE_OUTER_BOUND('',#404,.T.);
#406=ADVANCED_FACE('',(#405),#212,.T.);
/* Open shell */
#500=OPEN_SHELL('shell_in_compound',(#406));
/* Standalone face (not in shell, should be skipped by LoadShells) */
#510=ORIENTED_EDGE('',*,*,#321,.T.);
#511=ORIENTED_EDGE('',*,*,#323,.T.);
#512=ORIENTED_EDGE('',*,*,#325,.F.);
#513=ORIENTED_EDGE('',*,*,#327,.F.);
#514=EDGE_LOOP('',(#510,#511,#512,#513));
#515=FACE_OUTER_BOUND('',#514,.T.);
#516=ADVANCED_FACE('',(#515),#222,.T.);
/* Note: In real compound scenario, #516 would be a direct child.
 * For test purposes, it remains defined but tests silencing behavior. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh168','Tsh168','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
