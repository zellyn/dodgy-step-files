ISO-10303-21;
/* Ps009 - GD&T tolerance frame references near-but-wrong face - kernel accepts file silently; tier-3 introspection reveals tolerance attached to face adjacent to intended target */
HEADER;
FILE_DESCRIPTION(('Ps009 pathological-success','PMI tolerance on wrong adjacent face'),'2;1');
FILE_NAME('Ps009.stp','2026-04-26T00:00:00',(''),(''),'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','ap242_managed_model_based_3d_engineering',2020,#1);
#12=PRODUCT_CONTEXT('',#1,'mechanical');
#13=PRODUCT('Ps009','BlockWithNeighborFaces','',(#12));
#14=PRODUCT_DEFINITION_FORMATION('','',#13);
#15=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#16=PRODUCT_DEFINITION('','',#14,#15);
#17=PRODUCT_DEFINITION_SHAPE('','',#16);
#20=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#22=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#23=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#24=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,'distance_accuracy_value','');
#25=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))REPRESENTATION_CONTEXT('','3D'));
/* Two parallel faces 1mm apart on a thin block:
   - face A at y=0  (the FRONT face, intended PMI target -- a milled
                     reference face whose flatness is critical)
   - face B at y=1  (the BACK face, geometrically very close in space
                     but functionally a clearance face) */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(10.0,0.0,0.0));
#102=CARTESIAN_POINT('',(10.0,1.0,0.0));
#103=CARTESIAN_POINT('',(0.0,1.0,0.0));
#104=CARTESIAN_POINT('',(0.0,0.0,5.0));
#105=CARTESIAN_POINT('',(10.0,0.0,5.0));
#106=CARTESIAN_POINT('',(10.0,1.0,5.0));
#107=CARTESIAN_POINT('',(0.0,1.0,5.0));
#110=VERTEX_POINT('',#100); #111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102); #113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104); #115=VERTEX_POINT('',#105);
#116=VERTEX_POINT('',#106); #117=VERTEX_POINT('',#107);
#200=DIRECTION('',(0.0,0.0,1.0)); #201=DIRECTION('',(1.0,0.0,0.0));
#211=AXIS2_PLACEMENT_3D('',#100,#200,#201); #212=PLANE('z0',#211);
#221=AXIS2_PLACEMENT_3D('',#104,#200,#201); #222=PLANE('z5',#221);
/* face A: front face y=0 (intended PMI target) */
#231=DIRECTION('',(0.0,1.0,0.0)); #232=AXIS2_PLACEMENT_3D('',#100,#231,#201);
#233=PLANE('FACE_A_FRONT_INTENDED',#232);
/* face B: back face y=1 */
#242=AXIS2_PLACEMENT_3D('',#103,#231,#201);
#243=PLANE('FACE_B_BACK_NEIGHBOR',#242);
#252=DIRECTION('',(1.0,0.0,0.0)); #253=AXIS2_PLACEMENT_3D('',#100,#252,#231); #254=PLANE('left',#253);
#262=AXIS2_PLACEMENT_3D('',#101,#252,#231); #263=PLANE('right',#262);
#300=DIRECTION('',(1.0,0.0,0.0)); #301=VECTOR('',#300,10.0);
#302=DIRECTION('',(0.0,1.0,0.0)); #303=VECTOR('',#302,1.0);
#304=DIRECTION('',(0.0,0.0,1.0)); #305=VECTOR('',#304,5.0);
#310=LINE('',#100,#301); #311=EDGE_CURVE('',#110,#111,#310,.T.);
#312=LINE('',#101,#303); #313=EDGE_CURVE('',#111,#112,#312,.T.);
#314=LINE('',#103,#301); #315=EDGE_CURVE('',#113,#112,#314,.T.);
#316=LINE('',#100,#303); #317=EDGE_CURVE('',#110,#113,#316,.T.);
#318=LINE('',#104,#301); #319=EDGE_CURVE('',#114,#115,#318,.T.);
#320=LINE('',#105,#303); #321=EDGE_CURVE('',#115,#116,#320,.T.);
#322=LINE('',#107,#301); #323=EDGE_CURVE('',#117,#116,#322,.T.);
#324=LINE('',#104,#303); #325=EDGE_CURVE('',#114,#117,#324,.T.);
#326=LINE('',#100,#305); #327=EDGE_CURVE('',#110,#114,#326,.T.);
#328=LINE('',#101,#305); #329=EDGE_CURVE('',#111,#115,#328,.T.);
#330=LINE('',#102,#305); #331=EDGE_CURVE('',#112,#116,#330,.T.);
#332=LINE('',#103,#305); #333=EDGE_CURVE('',#113,#117,#332,.T.);
#400=ORIENTED_EDGE('',*,*,#311,.F.); #401=ORIENTED_EDGE('',*,*,#317,.T.);
#402=ORIENTED_EDGE('',*,*,#315,.F.); #403=ORIENTED_EDGE('',*,*,#313,.F.);
#404=EDGE_LOOP('',(#400,#401,#402,#403)); #405=FACE_OUTER_BOUND('',#404,.T.);
#406=ADVANCED_FACE('z0',(#405),#212,.F.);
#410=ORIENTED_EDGE('',*,*,#319,.T.); #411=ORIENTED_EDGE('',*,*,#321,.T.);
#412=ORIENTED_EDGE('',*,*,#323,.F.); #413=ORIENTED_EDGE('',*,*,#325,.F.);
#414=EDGE_LOOP('',(#410,#411,#412,#413)); #415=FACE_OUTER_BOUND('',#414,.T.);
#416=ADVANCED_FACE('z5',(#415),#222,.T.);
#420=ORIENTED_EDGE('',*,*,#311,.T.); #421=ORIENTED_EDGE('',*,*,#329,.T.);
#422=ORIENTED_EDGE('',*,*,#319,.F.); #423=ORIENTED_EDGE('',*,*,#327,.F.);
#424=EDGE_LOOP('',(#420,#421,#422,#423)); #425=FACE_OUTER_BOUND('',#424,.T.);
#426=ADVANCED_FACE('FACE_A_FRONT',(#425),#233,.F.);
#430=ORIENTED_EDGE('',*,*,#315,.T.); #431=ORIENTED_EDGE('',*,*,#331,.T.);
#432=ORIENTED_EDGE('',*,*,#323,.F.); #433=ORIENTED_EDGE('',*,*,#333,.F.);
#434=EDGE_LOOP('',(#430,#431,#432,#433)); #435=FACE_OUTER_BOUND('',#434,.T.);
#436=ADVANCED_FACE('FACE_B_BACK',(#435),#243,.T.);
#440=ORIENTED_EDGE('',*,*,#317,.T.); #441=ORIENTED_EDGE('',*,*,#333,.T.);
#442=ORIENTED_EDGE('',*,*,#325,.F.); #443=ORIENTED_EDGE('',*,*,#327,.F.);
#444=EDGE_LOOP('',(#440,#441,#442,#443)); #445=FACE_OUTER_BOUND('',#444,.T.);
#446=ADVANCED_FACE('left',(#445),#254,.F.);
#450=ORIENTED_EDGE('',*,*,#313,.T.); #451=ORIENTED_EDGE('',*,*,#331,.T.);
#452=ORIENTED_EDGE('',*,*,#321,.F.); #453=ORIENTED_EDGE('',*,*,#329,.F.);
#454=EDGE_LOOP('',(#450,#451,#452,#453)); #455=FACE_OUTER_BOUND('',#454,.T.);
#456=ADVANCED_FACE('right',(#455),#263,.T.);
#500=CLOSED_SHELL('thin_block',(#406,#416,#426,#436,#446,#456));
#510=MANIFOLD_SOLID_BREP('block_solid',#500);
#9022=ADVANCED_BREP_SHAPE_REPRESENTATION('',(#510),#25);
#9023=SHAPE_DEFINITION_REPRESENTATION(#17,#9022);
/* PMI: a flatness tolerance that the producer INTENDED to apply to
   FACE_A_FRONT (#426) but whose GISU references FACE_B_BACK (#436)
   instead -- a common PMI export bug where face indexing collides
   between adjacent faces on a thin part. */
#600=SHAPE_ASPECT('flatness_target','flat_face',#17,.T.);
#601=GEOMETRIC_ITEM_SPECIFIC_USAGE('flat_GISU',$,#600,#9022,#436);
/* DEFECT: GISU references #436 (back face) instead of #426 (front). */
#610=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#20);
#620=FLATNESS_TOLERANCE('flatness',$,#610,#600);
/* Datum and presentation skeleton */
#630=DATUM('A','primary datum',#17,.T.,'A');
#640=DRAUGHTING_MODEL('Default',(),#25);
#650=PLANE('annotation_plane',#211);
#660=ANNOTATION_PLANE('PMI',(),#650,(#620));
ENDSEC;
END-ISO-10303-21;
