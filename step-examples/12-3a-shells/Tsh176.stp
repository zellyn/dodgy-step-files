ISO-10303-21;
/* Tsh176 - ShapeUpgrade_ShellSewing.Apply with-coincident-but-different-orientation
 * Defect: two shells with coincident faces in opposite orientations;
 * Apply doesn't detect orientation conflict and produces overlapping output.
 * Tests: two identical square faces with opposite normal vectors. */
HEADER;
FILE_DESCRIPTION(('Tsh176 test case','ShapeUpgrade_ShellSewing orientation-conflict'),'2;1');
FILE_NAME('Tsh176.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
