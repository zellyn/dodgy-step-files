#200=CARTESIAN_POINT('s2p0',(0.0,0.0,0.0));
#201=CARTESIAN_POINT('s2p1',(1.0,0.0,0.0));
#202=CARTESIAN_POINT('s2p2',(1.0,1.0,0.0));
