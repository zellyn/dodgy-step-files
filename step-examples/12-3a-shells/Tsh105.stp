ISO-10303-21;
/* Tsh105 - ShapeAnalysis_Shell.CheckOrientedShells unconnected components
 * Defect: shell with two disjoint sub-shells (not topologically connected);
 * CheckOrientedShells reports a single verdict instead of per-component */
HEADER;
