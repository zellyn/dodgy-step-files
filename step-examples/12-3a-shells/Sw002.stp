ISO-10303-21;
/* Sw002 - Sliver face dropped silently by sewing.
 * Defect: a face with area below the sewing tolerance squared
 * disappears from the sewn shell with no diagnostic. */
HEADER;
FILE_DESCRIPTION(('Sw002 - sliver face silently dropped','Pass C gap-fill'),'2;1');
FILE_NAME('Sw002.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Tiny face: corners at (0,0,0)-(1.0e-6,1.0e-6,0) on plane z=0 */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(0.000001,0.0,0.0));
#12=CARTESIAN_POINT('',(0.000001,0.000001,0.0));
#13=CARTESIAN_POINT('',(0.0,0.000001,0.0));
#20=DIRECTION('',(0.0,0.0,1.0));
#21=DIRECTION('',(1.0,0.0,0.0));
#22=AXIS2_PLACEMENT_3D('',#10,#20,#21);
#23=PLANE('',#22);
#100=ADVANCED_FACE('sliver_face_below_tol',(),#23,.T.);
ENDSEC;
END-ISO-10303-21;
