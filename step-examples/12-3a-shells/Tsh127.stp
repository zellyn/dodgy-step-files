ISO-10303-21;
/* Tsh127 - ShapeUpgrade_ShellSewing.Apply different-shell-tolerances
 * Defect: Two shells in sewing input have different tolerance contexts;
 * Apply uses first shell's tolerance, ignoring second's */
HEADER;
FILE_DESCRIPTION(('Tsh127 - sewing two shells with different tolerance contexts','wave 26'),'2;1');
FILE_NAME('Tsh127.stp','2026-06-15T00:00:00',(''),(''),'heal coverage','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Two separate shells to be sewn together:
 * Shell 1: Single face (0,0,0)-(10,0,0)-(10,10,0)-(0,10,0), tolerance 1.0e-7
 * Shell 2: Single face (0,0,10)-(10,0,10)-(10,10,10)-(0,10,10), tolerance 1.0e-5
 * They are coplanar but separated; sewing should bridge them but tolerance
 * mismatch causes gaps or missed stitching. */

#10=CARTESIAN_POINT('',(0,0,0));
#11=CARTESIAN_POINT('',(10.0,0,0));
#12=CARTESIAN_POINT('',(10.0,10.0,0));
#13=CARTESIAN_POINT('',(0,10.0,0));

#14=CARTESIAN_POINT('',(0,0,10.0));
#15=CARTESIAN_POINT('',(10.0,0,10.0));
#16=CARTESIAN_POINT('',(10.0,10.0,10.0));
#17=CARTESIAN_POINT('',(0,10.0,10.0));

#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
#22=VERTEX_POINT('',#12);
#23=VERTEX_POINT('',#13);

#24=VERTEX_POINT('',#14);
#25=VERTEX_POINT('',#15);
#26=VERTEX_POINT('',#16);
#27=VERTEX_POINT('',#17);

/* Plane for shell 1 (z=0) */
#30=AXIS2_PLACEMENT_3D('plane_z0',#10,DIRECTION('',(0,0,-1)),DIRECTION('',(1,0,0)));
#31=PLANE('',#30);

/* Plane for shell 2 (z=10) */
#32=AXIS2_PLACEMENT_3D('plane_z10',#14,DIRECTION('',(0,0,1)),DIRECTION('',(1,0,0)));
#33=PLANE('',#32);

/* Shell 1 edges */
#50=LINE('',#10,VECTOR('',(1,0,0),10.0));
#51=EDGE_CURVE('s1_e1',#20,#21,#50,.T.);
#52=LINE('',#11,VECTOR('',(0,1,0),10.0));
#53=EDGE_CURVE('s1_e2',#21,#22,#52,.T.);
#54=LINE('',#12,VECTOR('',(-1,0,0),10.0));
#55=EDGE_CURVE('s1_e3',#22,#23,#54,.T.);
#56=LINE('',#13,VECTOR('',(0,-1,0),10.0));
#57=EDGE_CURVE('s1_e4',#23,#20,#56,.T.);

/* Shell 2 edges */
#60=LINE('',#14,VECTOR('',(1,0,0),10.0));
#61=EDGE_CURVE('s2_e1',#24,#25,#60,.T.);
#62=LINE('',#15,VECTOR('',(0,1,0),10.0));
#63=EDGE_CURVE('s2_e2',#25,#26,#62,.T.);
#64=LINE('',#16,VECTOR('',(-1,0,0),10.0));
#65=EDGE_CURVE('s2_e3',#26,#27,#64,.T.);
#66=LINE('',#17,VECTOR('',(0,-1,0),10.0));
#67=EDGE_CURVE('s2_e4',#27,#24,#66,.T.);

/* Shell 1 edge loop */
#80=ORIENTED_EDGE('',*,*,#51,.T.);
#81=ORIENTED_EDGE('',*,*,#53,.T.);
#82=ORIENTED_EDGE('',*,*,#55,.T.);
#83=ORIENTED_EDGE('',*,*,#57,.T.);
#84=EDGE_LOOP('s1_loop',(#80,#81,#82,#83));

/* Shell 2 edge loop */
#90=ORIENTED_EDGE('',*,*,#61,.T.);
#91=ORIENTED_EDGE('',*,*,#63,.T.);
#92=ORIENTED_EDGE('',*,*,#65,.T.);
#93=ORIENTED_EDGE('',*,*,#67,.T.);
#94=EDGE_LOOP('s2_loop',(#90,#91,#92,#93));

/* Face bounds */
#100=FACE_OUTER_BOUND('',#84,.T.);
#101=FACE_OUTER_BOUND('',#94,.T.);

/* Faces */
#110=ADVANCED_FACE('f1',(#100),#31,.T.);
#111=ADVANCED_FACE('f2',(#101),#33,.T.);

/* Shells */
#200=OPEN_SHELL('shell_1',(#110));
#201=OPEN_SHELL('shell_2',(#111));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh127','Tsh127','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#200,#201));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
