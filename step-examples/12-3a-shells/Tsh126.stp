ISO-10303-21;
/* Tsh126 - ShapeAnalysis_Shell.CheckOrientedShells coplanar-faces
 * Defect: Shell with two coplanar abutting faces; CheckOrientedShells treats
 * them as a flat surface and reports inconclusive result */
HEADER;
FILE_DESCRIPTION(('Tsh126 - coplanar abutting faces cause inconclusive orientation check','wave 26'),'2;1');
FILE_NAME('Tsh126.stp','2026-06-15T00:00:00',(''),(''),'heal coverage','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Two coplanar rectangular faces sharing an edge */
/* Face 1: left rectangle (0,0,0)-(5,0,0)-(5,10,0)-(0,10,0) */
/* Face 2: right rectangle (5,0,0)-(10,0,0)-(10,10,0)-(5,10,0) */
/* Both lie on same plane (z=0), share edge from (5,0,0) to (5,10,0) */

#10=CARTESIAN_POINT('',(0,0,0));
#11=CARTESIAN_POINT('',(5.0,0,0));
#12=CARTESIAN_POINT('',(5.0,10.0,0));
#13=CARTESIAN_POINT('',(0,10.0,0));
#14=CARTESIAN_POINT('',(10.0,0,0));
#15=CARTESIAN_POINT('',(10.0,10.0,0));

#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
#22=VERTEX_POINT('',#12);
#23=VERTEX_POINT('',#13);
#24=VERTEX_POINT('',#14);
#25=VERTEX_POINT('',#15);

/* Shared plane */
#30=AXIS2_PLACEMENT_3D('shared_plane',#10,DIRECTION('',(0,0,1)),DIRECTION('',(1,0,0)));
#31=PLANE('',#30);

/* Face 1 (left) edges */
#50=LINE('',#10,VECTOR('',(1,0,0),5.0));
#51=EDGE_CURVE('f1_e1_left',#20,#21,#50,.T.);
#52=LINE('',#11,VECTOR('',(0,1,0),10.0));
#53=EDGE_CURVE('f1_e2_shared',#21,#22,#52,.T.);
#54=LINE('',#12,VECTOR('',(-1,0,0),5.0));
#55=EDGE_CURVE('f1_e3_right',#22,#23,#54,.T.);
#56=LINE('',#13,VECTOR('',(0,-1,0),10.0));
#57=EDGE_CURVE('f1_e4_back',#23,#20,#56,.T.);

/* Face 2 (right) edges */
#60=LINE('',#11,VECTOR('',(1,0,0),5.0));
#61=EDGE_CURVE('f2_e1_left',#21,#24,#60,.T.);
#62=LINE('',#14,VECTOR('',(0,1,0),10.0));
#63=EDGE_CURVE('f2_e2_right',#24,#25,#62,.T.);
#64=LINE('',#15,VECTOR('',(-1,0,0),5.0));
#65=EDGE_CURVE('f2_e3_shared',#25,#22,#64,.T.);
#66=LINE('',#12,VECTOR('',(0,-1,0),10.0));
#67=EDGE_CURVE('f2_e4_back',#22,#21,#66,.T.);

/* Face 1 edge loop */
#80=ORIENTED_EDGE('',*,*,#51,.T.);
#81=ORIENTED_EDGE('',*,*,#53,.T.);
#82=ORIENTED_EDGE('',*,*,#55,.T.);
#83=ORIENTED_EDGE('',*,*,#57,.T.);
#84=EDGE_LOOP('f1_loop',(#80,#81,#82,#83));

/* Face 2 edge loop - opposite orientation for shared edge */
#90=ORIENTED_EDGE('',*,*,#61,.T.);
#91=ORIENTED_EDGE('',*,*,#63,.T.);
#92=ORIENTED_EDGE('',*,*,#65,.T.);
#93=ORIENTED_EDGE('',*,*,#67,.T.);
#94=EDGE_LOOP('f2_loop',(#90,#91,#92,#93));

/* Face bounds */
#100=FACE_OUTER_BOUND('',#84,.T.);
#101=FACE_OUTER_BOUND('',#94,.T.);

/* Faces */
#110=ADVANCED_FACE('f1_left',(#100),#31,.T.);
#111=ADVANCED_FACE('f2_right',(#101),#31,.T.);

/* Shell with coplanar abutting faces */
#200=OPEN_SHELL('coplanar_shell',(#110,#111));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh126','Tsh126','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#200));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
