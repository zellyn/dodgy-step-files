#55=VERTEX_POINT('',#31);

/* Plane */
#60=AXIS2_PLACEMENT_3D('plane_xy',#10,DIRECTION('',(0,0,1)),DIRECTION('',(1,0,0)));
#61=PLANE('',#60);

/* Outer boundary edges */
#70=LINE('',#10,VECTOR('',(1,0,0),100.0));
#71=EDGE_CURVE('outer_e1',#40,#41,#70,.T.);
