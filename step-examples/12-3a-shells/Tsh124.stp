ISO-10303-21;
/* Tsh124 - ShapeUpgrade_RemoveInternalWires multiple-internal-wires
 * Defect: Face with 3 internal wires; RemoveInternalWires iterates internal
 * wires but removes them in wrong order, leaving inconsistent face state */
HEADER;
FILE_DESCRIPTION(('Tsh124 - face with multiple internal wires removed in wrong order','wave 26'),'2;1');
FILE_NAME('Tsh124.stp','2026-06-15T00:00:00',(''),(''),'heal coverage','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Face with outer bound and 3 internal wires (holes) */
/* Outer boundary: (0,0,0)-(100,0,0)-(100,100,0)-(0,100,0) */
/* Internal wire 1 (hole): (10,10,0)-(20,10,0)-(20,20,0)-(10,20,0) */
/* Internal wire 2 (hole): (30,30,0)-(40,30,0)-(40,40,0)-(30,40,0) */
/* Internal wire 3 (hole): (60,60,0)-(70,60,0)-(70,70,0)-(60,70,0) */

