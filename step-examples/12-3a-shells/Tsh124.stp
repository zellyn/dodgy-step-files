#203=FACE_INNER_BOUND('',#184,.T.);

/* Face with 3 internal wires */
#210=ADVANCED_FACE('holey_face',(#200,#201,#202,#203),#61,.T.);

/* Shell containing the face */
#220=OPEN_SHELL('multi_wire_shell',(#210));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh124','Tsh124','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
