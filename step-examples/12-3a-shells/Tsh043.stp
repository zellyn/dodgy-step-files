ISO-10303-21;
/* Tsh043 - Shell-level healing pipeline applied to multi-face shell
 * Defect: open shell whose face-level defects (orientation flips, missing
 * pcurves, sub-tolerance edges) are individually fixable, but the shell
 * orientation cannot be resolved until the face fixes converge. */
HEADER;
FILE_DESCRIPTION(('Tsh043 test case','Shell-level healing pipeline applied to multi-face shell'),'2;1');
FILE_NAME('Tsh043.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
#15=CARTESIAN_POINT('',(0.0,0.0,0.0));
#16=VERTEX_POINT('',#15);
#17=CARTESIAN_POINT('',(10.0,0.0,0.0));
#18=VERTEX_POINT('',#17);
#19=CARTESIAN_POINT('',(10.0,10.0,0.0));
#20=VERTEX_POINT('',#19);
#21=CARTESIAN_POINT('',(0.0,10.0,0.0));
#22=VERTEX_POINT('',#21);
#23=DIRECTION('',(1.0,0.0,0.0));
#24=VECTOR('',#23,1.0);
#25=LINE('',#15,#24);
#26=EDGE_CURVE('',#16,#18,#25,.T.);
#27=ORIENTED_EDGE('',*,*,#26,.T.);
#28=DIRECTION('',(0.0,1.0,0.0));
#29=VECTOR('',#28,1.0);
#30=LINE('',#17,#29);
#31=EDGE_CURVE('',#18,#20,#30,.T.);
#32=ORIENTED_EDGE('',*,*,#31,.T.);
#33=DIRECTION('',(-1.0,0.0,0.0));
#34=VECTOR('',#33,1.0);
#35=LINE('',#19,#34);
#36=EDGE_CURVE('',#20,#22,#35,.T.);
#37=ORIENTED_EDGE('',*,*,#36,.T.);
#38=DIRECTION('',(0.0,-1.0,0.0));
#39=VECTOR('',#38,1.0);
#40=LINE('',#21,#39);
#41=EDGE_CURVE('',#22,#16,#40,.T.);
#42=ORIENTED_EDGE('',*,*,#41,.T.);
#43=EDGE_LOOP('',(#27,#32,#37,#42));
#44=FACE_OUTER_BOUND('',#43,.T.);
#45=ADVANCED_FACE('',(#44),#14,.T.);
#46=CARTESIAN_POINT('',(0.0,0.0,0.0));
#47=DIRECTION('',(0.0,0.0,1.0));
#48=DIRECTION('',(1.0,0.0,0.0));
#49=AXIS2_PLACEMENT_3D('',#46,#47,#48);
#50=PLANE('',#49);
/* Face B reuses #18 (V2 at x=10,y=0) and #20 (V3 at x=10,y=10) for the
 * shared boundary; only the far-side corners V_far_lo and V_far_hi are
 * new vertex points. */
#53=CARTESIAN_POINT('',(20.0,0.0,0.0));
#54=VERTEX_POINT('V_far_lo',#53);
#55=CARTESIAN_POINT('',(20.0,10.0,0.0));
#56=VERTEX_POINT('V_far_hi',#55);
#59=DIRECTION('',(1.0,0.0,0.0));
#60=VECTOR('',#59,1.0);
#61=LINE('',#17,#60);
/* Vertices V2 (#18) and V3 (#20) are RE-USED in face B's edges -- the two
 * faces actually share an edge along x=10 instead of being disjoint. */
#62=EDGE_CURVE('faceB_e1_along_shared_x10',#18,#54,#61,.T.);
#63=ORIENTED_EDGE('',*,*,#62,.T.);
#64=DIRECTION('',(0.0,1.0,0.0));
#65=VECTOR('',#64,1.0);
#66=LINE('',#53,#65);
#67=EDGE_CURVE('',#54,#56,#66,.T.);
#68=ORIENTED_EDGE('',*,*,#67,.T.);
#69=DIRECTION('',(-1.0,0.0,0.0));
#70=VECTOR('',#69,1.0);
#71=LINE('',#55,#70);
#72=EDGE_CURVE('faceB_e3_back_to_x10',#56,#20,#71,.T.);
#73=ORIENTED_EDGE('',*,*,#72,.T.);
/* SHARED edge: re-use #31 (face A's right edge from V2->V3) but in face B
 * with .F. orientation, so each side of the boundary references the same
 * edge from opposite directions. */
#78=ORIENTED_EDGE('shared_edge_reversed',*,*,#31,.F.);
#79=EDGE_LOOP('',(#63,#68,#73,#78));
#80=FACE_OUTER_BOUND('',#79,.T.);
/* Plane #50: SAME_SENSE flag of face B is .F. -- orientation flipped relative
 * to its underlying plane normal. */
#81=ADVANCED_FACE('faceB_flipped',(#80),#50,.F.);
/* Open shell of two faces -- face B's same_sense is .F., flipping it. */
#82=OPEN_SHELL('two_faces_one_flipped',(#45,#81));
ENDSEC;
END-ISO-10303-21;
