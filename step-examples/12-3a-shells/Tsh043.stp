ISO-10303-21;
/* Tsh043 - Shell-level healing pipeline applied to multi-face shell
 * Defect: open shell whose face-level defects (orientation flips, missing
 * pcurves, sub-tolerance edges) are individually fixable, but the shell
 * orientation cannot be resolved until the face fixes converge. */
HEADER;
