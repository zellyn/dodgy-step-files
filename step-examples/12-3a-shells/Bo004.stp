ISO-10303-21;
/* Bo004 - Closed shell encloses an unrepresented cavity (genus mismatch).
 * Defect: The MANIFOLD_SOLID_BREP outer shell topologically bounds a
 * cavity, but the model carries no BREP_WITH_VOIDS wrapper to declare
 * the void. A correct kernel detects the genus-1 outer shell and either
 * promotes to BREP_WITH_VOIDS or flags the topology inconsistency. */
HEADER;
FILE_DESCRIPTION(('Bo004 - genus mismatch (cavity not declared)'),'2;1');
FILE_NAME('Bo004.stp','2026-06-15T00:00:00',(''),(''),'catalog-regen','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
