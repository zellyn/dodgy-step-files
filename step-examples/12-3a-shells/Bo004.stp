ISO-10303-21;
/* Bo004 - Closed shell encloses an unrepresented cavity.
 * Defect: a MANIFOLD_SOLID_BREP outer shell describes a "cube with a
 * cube-shaped interior cavity" - both outer (1x1x1) and inner (small
 * inner cube) faces are listed in a single CLOSED_SHELL, but the file
 * uses MANIFOLD_SOLID_BREP rather than BREP_WITH_VOIDS, so the cavity
 * is not declared as a void. Point-in-solid classification disagrees
 * with the user's intent: regions inside the cavity look "solid". */
HEADER;
FILE_DESCRIPTION(('Bo004 - enclosed region missing void','Pass C gap-fill'),'2;1');
FILE_NAME('Bo004.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
