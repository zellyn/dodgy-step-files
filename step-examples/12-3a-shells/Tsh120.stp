ISO-10303-21;
/* Tsh120 - ShapeAnalysis_Shell.CheckOrientedShells uniform-orientation wrong direction
 * Defect: all faces have consistent orientation flag but their normals all
 * point inward; CheckOrientedShells's consistency test passes but solid is inside-out */
HEADER;
FILE_DESCRIPTION(('Tsh120 - inverted normals with consistent orientation','wave 25'),'2;1');
FILE_NAME('Tsh120.stp','2026-06-15T00:00:00',(''),(''),'heal coverage','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Two rectangular faces sharing edge; both with orientation=TRUE but normals inverted */
/* Face 1: (0,0,0)-(10,0,0)-(10,10,0)-(0,10,0) normal points DOWN instead of UP */
/* Face 2: (0,0,0)-(10,0,0)-(10,0,10)-(0,0,10) normal points INWARD instead of OUTWARD */

#10=CARTESIAN_POINT('',(0,0,0));
#11=CARTESIAN_POINT('',(10.0,0,0));
#12=CARTESIAN_POINT('',(10.0,10.0,0));
#13=CARTESIAN_POINT('',(0,10.0,0));
#14=CARTESIAN_POINT('',(10.0,0,10.0));
#15=CARTESIAN_POINT('',(0,0,10.0));

#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
#22=VERTEX_POINT('',#12);
#23=VERTEX_POINT('',#13);
#24=VERTEX_POINT('',#14);
#25=VERTEX_POINT('',#15);

/* Planes with INVERTED normal directions */
/* Face 1: should point UP (0,0,1) but defined with DOWN (0,0,-1) */
#30=AXIS2_PLACEMENT_3D('inverted_z_plane',#10,DIRECTION('',(0,0,1)),DIRECTION('',(1,0,0)));
#31=PLANE('',#30);
/* Face 2: should point -Y (0,-1,0) but defined with +Y (0,1,0) */
#32=AXIS2_PLACEMENT_3D('inverted_y_plane',#10,DIRECTION('',(0,1,0)),DIRECTION('',(1,0,0)));
#33=PLANE('',#32);

/* Face 1 edges */
#50=LINE('',#10,VECTOR('',(1,0,0),10.0));
#51=EDGE_CURVE('f1_e1',#20,#21,#50,.T.);
#52=LINE('',#11,VECTOR('',(0,1,0),10.0));
#53=EDGE_CURVE('f1_e2',#21,#22,#52,.T.);
#54=LINE('',#12,VECTOR('',(-1,0,0),10.0));
#55=EDGE_CURVE('f1_e3',#22,#23,#54,.T.);
#56=LINE('',#13,VECTOR('',(0,-1,0),10.0));
#57=EDGE_CURVE('f1_e4',#23,#20,#56,.T.);

/* Face 2 edges (shares #51 with Face 1) */
#58=LINE('',#11,VECTOR('',(0,0,1),10.0));
#59=EDGE_CURVE('f2_vert1',#21,#24,#58,.T.);
#60=LINE('',#14,VECTOR('',(-1,0,0),10.0));
#61=EDGE_CURVE('f2_e2',#24,#25,#60,.T.);
#62=LINE('',#15,VECTOR('',(0,0,-1),10.0));
#63=EDGE_CURVE('f2_e3',#25,#20,#62,.T.);

/* Face 1 edge loop */
#80=ORIENTED_EDGE('',*,*,#51,.T.);
#81=ORIENTED_EDGE('',*,*,#53,.T.);
#82=ORIENTED_EDGE('',*,*,#55,.T.);
#83=ORIENTED_EDGE('',*,*,#57,.T.);
#84=EDGE_LOOP('f1_loop',(#80,#81,#82,#83));

/* Face 2 edge loop */
#85=ORIENTED_EDGE('',*,*,#51,.F.);
#86=ORIENTED_EDGE('',*,*,#59,.T.);
#87=ORIENTED_EDGE('',*,*,#61,.T.);
#88=ORIENTED_EDGE('',*,*,#63,.T.);
#89=EDGE_LOOP('f2_loop',(#85,#86,#87,#88));

/* Face bounds */
#100=FACE_OUTER_BOUND('',#84,.T.);
#101=FACE_OUTER_BOUND('',#89,.T.);

/* Faces both with .T. orientation flag (consistent) but normals inverted */
#110=ADVANCED_FACE('f1_inverted_normal',(#100),#31,.T.);
#111=ADVANCED_FACE('f2_inverted_normal',(#101),#33,.T.);

/* Shell with consistently inverted normals */
#130=OPEN_SHELL('inverted_shell',(#110,#111));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh120','Tsh120','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#130));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
