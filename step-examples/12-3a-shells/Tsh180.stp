ISO-10303-21;
/* Tsh180: ONE ADVANCED_FACE with THREE COLLINEAR VERTICES (all on X-axis) IS the zero-area face; pa=(0,0,0), pb=(1,0,0), pc=(2,0,0) — collinear, zero cross-product — IS the defect trigger; CLOSED_SHELL with single zero-area face IS what CheckOrientedShells receives; normal computation yields zero vector — IS the NaN/inf source; CheckOrientedShells returns false instead of exception-free classification — IS the defect; fix: CheckOrientedShells must detect zero-area faces and skip normal test gracefully; emit E_CHECK_ORIENTED_ZERO_AREA when zero-area face detected in shell */
HEADER;
FILE_DESCRIPTION(('Tsh180'),'2;1');
FILE_NAME('Tsh180.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
