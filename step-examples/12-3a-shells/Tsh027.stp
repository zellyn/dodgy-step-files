ISO-10303-21;
/* Tsh027 - Coincident-but-not-shared faces between adjacent solids
 * Defect: A built-up assembly imports as N disconnected MANIFOLD_SOLID_BREPs;
 * faces shared between adjacent parts are coincident-but-not-shared
 * (each part has its own copy). FEA mesh has no node continuity across
 * the interface. Common from CATProduct, SLDASM-as-STEP, Inventor IAM
 * exported without "merge coincident faces". Tangential / zero-thickness
 * contact creates a non-manifold body that meshers refuse.
 *
 * This file: two unit cubes A=[0,1]^3 and B=[1,2]x[0,1]x[0,1] that
 * touch along the plane x=1. Each cube has its own VERTEX_POINTs,
 * EDGE_CURVEs, and ADVANCED_FACEs along the shared plane -- no
 * sharing of topology even though the two faces are geometrically
 * coincident. Sources: Y022, M022. */
HEADER;
FILE_DESCRIPTION(('Tsh027 test case','Coincident-but-not-shared faces between solids'),'2;1');
FILE_NAME('Tsh027.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
