ISO-10303-21;
/* Tsh217 - ShapeFix_Shell.Perform.closed_flag_sync_failure
 * Defect: Shell marked Closed but FixFaceOrientation may create free edges;
 * Closed() flag not reset causing downstream solid construction failure. */
HEADER;
FILE_DESCRIPTION(('Tsh217 - closed flag out-of-sync with free edges'',''2;1'',''2;1'),'2;1');
FILE_NAME('Tsh217.stp','2026-06-16T00:00:00',(''),(''),'wave-65B','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Tetrahedral shell: 4 triangular faces, all edges shared except one broken edge */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('',(0.0,1.0,0.0));
#103=CARTESIAN_POINT('',(0.0,0.0,1.0));
#110=VERTEX_POINT('',#100);
#111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102);
#113=VERTEX_POINT('',#103);

/* Base plane z=0 */
#200=DIRECTION('',(0.0,0.0,1.0));
#201=DIRECTION('',(1.0,0.0,0.0));
#210=CARTESIAN_POINT('',(0.33,0.33,0.0));
#211=AXIS2_PLACEMENT_3D('',#210,#200,#201);
#212=PLANE('',#211);

/* Face 1 (base): 0-1-2 */
#300=DIRECTION('',(1.0,0.0,0.0));
#301=VECTOR('',#300,1.0);
#310=LINE('',#100,#301);
#311=EDGE_CURVE('',#110,#111,#310,.T.);

#302=DIRECTION('',(-1.0,1.0,0.0));
#303=VECTOR('',#302,1.414);
#312=LINE('',#101,#303);
#313=EDGE_CURVE('',#111,#112,#312,.T.);

#304=DIRECTION('',(0.0,-1.0,0.0));
#305=VECTOR('',#304,1.0);
#314=LINE('',#102,#305);
#315=EDGE_CURVE('',#112,#110,#314,.T.);

#400=ORIENTED_EDGE('',*,*,#311,.T.);
#401=ORIENTED_EDGE('',*,*,#313,.T.);
#402=ORIENTED_EDGE('',*,*,#315,.T.);
#410=EDGE_LOOP('',(#400,#401,#402));
#420=FACE_OUTER_BOUND('',#410,.T.);
#430=ADVANCED_FACE('',(#420),#212,.T.);

/* Plane for face 2-4 */
#500=DIRECTION('',(0.0,-0.707,0.707));
#501=DIRECTION('',(1.0,0.0,0.0));
#510=CARTESIAN_POINT('',(0.33,0.33,0.33));
#511=AXIS2_PLACEMENT_3D('',#510,#500,#501);
#520=PLANE('',#511);

/* Edges for sloped faces */
#600=DIRECTION('',(0.0,0.0,1.0));
#601=VECTOR('',#600,1.0);
#610=LINE('',#100,#601);
#611=EDGE_CURVE('',#110,#113,#610,.T.);

#602=DIRECTION('',(0.5,-0.5,1.0));
#603=VECTOR('',#602,1.225);
#612=LINE('',#101,#603);
#613=EDGE_CURVE('',#111,#113,#612,.T.);

#604=DIRECTION('',(-0.5,0.0,1.0));
#605=VECTOR('',#604,1.118);
#614=LINE('',#102,#605);
#615=EDGE_CURVE('',#112,#113,#614,.T.);

/* Face 2: 0-1-3 */
#700=ORIENTED_EDGE('',*,*,#311,.T.);
#701=ORIENTED_EDGE('',*,*,#613,.F.);
#702=ORIENTED_EDGE('',*,*,#611,.F.);
#710=EDGE_LOOP('',(#700,#701,#702));
#720=FACE_OUTER_BOUND('',#710,.T.);
#730=ADVANCED_FACE('',(#720),#520,.T.);

/* Face 3: 1-2-3 */
#740=ORIENTED_EDGE('',*,*,#313,.T.);
#741=ORIENTED_EDGE('',*,*,#615,.F.);
#742=ORIENTED_EDGE('',*,*,#613,.F.);
#750=EDGE_LOOP('',(#740,#741,#742));
#760=FACE_OUTER_BOUND('',#750,.T.);
#770=ADVANCED_FACE('',(#760),#520,.T.);

/* Face 4: 2-0-3 (one edge BROKEN: uses duplicate of edge 611 with .F. that doesn't match orientation) */
#800=ORIENTED_EDGE('',*,*,#315,.T.);
#801=ORIENTED_EDGE('',*,*,#615,.T.);
#802=ORIENTED_EDGE('',*,*,#611,.T.);
#810=EDGE_LOOP('',(#800,#801,#802));
#820=FACE_OUTER_BOUND('',#810,.T.);
#830=ADVANCED_FACE('',(#820),#520,.T.);

/* CLOSED_SHELL marked but will have free edges after orientation fix */
#900=CLOSED_SHELL('sync_failure_shell',(#430,#730,#770,#830));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh217','Tsh217','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#900));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
