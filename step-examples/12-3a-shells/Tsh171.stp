ISO-10303-21;
/* Tsh171 - ShapeUpgrade_ShellSewing.Apply with-cross-shell-intersection
 * Defect: two shells intersecting each other; Apply doesn't detect the
 * intersection and produces a merged shell with self-intersection.
 * Tests: two separate shells that geometrically intersect. */
HEADER;
FILE_DESCRIPTION(('Tsh171 test case','ShapeUpgrade_ShellSewing cross-intersection'),'2;1');
FILE_NAME('Tsh171.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
