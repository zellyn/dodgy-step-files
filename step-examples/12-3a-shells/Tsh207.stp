ISO-10303-21;
/* Tsh207 - ShapeFix_Shell.Perform.progress_abort_inconsistency
 * Defect: User abort (aPS.More() == false) returns false but myStatus
 * already set; inconsistent error state leaves partial fixes applied. */
HEADER;
FILE_DESCRIPTION(('Tsh207 - progress abort inconsistent error state'',''2;1'',''2;1'),'2;1');
