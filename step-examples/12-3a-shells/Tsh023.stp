ISO-10303-21;
/* Tsh023 - Empty EDGE_LOOP / empty face list on shells
 * Defect: STEP file with empty EDGE_LOOP(...,()) crashes reader.
 * Similarly: EDGE_BASED_WIREFRAME_MODEL with empty boundary or empty
 * connected_edge_set; FACE_BASED_SURFACE_MODEL with empty face list.
 * Sources: R045 (bug33307), Q001, Q028, Q029.
 *
 * This file demonstrates several flavours together:
 *   - #410: EDGE_LOOP with empty edge_list ()
 *   - #420: ADVANCED_FACE referencing the empty loop (cascade failure)
 *   - #500: FACE_BASED_SURFACE_MODEL with empty face list
 *   - #510: OPEN_SHELL with empty cfs_faces
 * A robust reader should reject each malformed entity but never crash. */
HEADER;
FILE_DESCRIPTION(('Tsh023 test case','Empty EDGE_LOOP and empty shell lists'),'2;1');
FILE_NAME('Tsh023.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh023','Tsh023','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=EDGE_BASED_WIREFRAME_MODEL('wireframe',(#530));
#9022=EDGE_BASED_WIREFRAME_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
