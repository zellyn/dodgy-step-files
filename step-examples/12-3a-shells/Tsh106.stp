ISO-10303-21;
/* Tsh106 - ShapeUpgrade_RemoveInternalWires shell-level skip
 * Defect: shell-level RemoveInternalWires is called but it doesn't
 * propagate to face-level interior wires */
HEADER;
FILE_DESCRIPTION(('Tsh106 test case','RemoveInternalWires shell-level skip'),'2;1');
FILE_NAME('Tsh106.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Outer square face with inner square hole */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));#11=VERTEX_POINT('',#10);
#12=CARTESIAN_POINT('',(4.0,0.0,0.0));#13=VERTEX_POINT('',#12);
