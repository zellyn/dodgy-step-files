#62=DIRECTION('',(0.0,-1.0,0.0));#63=VECTOR('',#62,2.0);#64=LINE('',#26,#63);
#65=EDGE_CURVE('',#27,#21,#64,.T.);
/* Outer loop */
#70=ORIENTED_EDGE('',*,*,#33,.T.);#71=ORIENTED_EDGE('',*,*,#37,.T.);
#72=ORIENTED_EDGE('',*,*,#41,.T.);#73=ORIENTED_EDGE('',*,*,#45,.T.);
#74=EDGE_LOOP('',(#70,#71,#72,#73));
/* Inner loop (hole) */
#80=ORIENTED_EDGE('',*,*,#53,.F.);#81=ORIENTED_EDGE('',*,*,#57,.F.);
#82=ORIENTED_EDGE('',*,*,#61,.F.);#83=ORIENTED_EDGE('',*,*,#65,.F.);
#84=EDGE_LOOP('',(#80,#81,#82,#83));
#85=FACE_INNER_BOUND('',#84,.T.);
/* Face with outer and inner bounds */
#90=DIRECTION('',(0.0,0.0,1.0));#91=DIRECTION('',(1.0,0.0,0.0));
#92=AXIS2_PLACEMENT_3D('',#10,#90,#91);#93=PLANE('',#92);
#100=FACE_OUTER_BOUND('',#74,.T.);
#101=ADVANCED_FACE('face_with_hole',(#100,#85),#93,.T.);
/* OPEN_SHELL with single face; RemoveInternalWires should process the hole */
#200=OPEN_SHELL('shell_with_interior_wire',(#101));
#210=SHELL_BASED_SURFACE_MODEL('sbsm',(#200));
