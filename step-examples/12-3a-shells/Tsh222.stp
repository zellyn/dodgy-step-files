ISO-10303-21;
/* Tsh222 - ShapeFix_Shell.Perform closed_flag_sync_failure
 * Defect: Shell marked closed but contains free edges after face
 * orientation fix; Closed() flag not reset, breaking downstream solid construction. */
HEADER;
FILE_DESCRIPTION(('Tsh222 - closed flag sync failure'',''2;1'',''2;1'),'2;1');
FILE_NAME('Tsh222.stp','2026-06-16T00:00:00',(''),(''),'wave-68B','','');
