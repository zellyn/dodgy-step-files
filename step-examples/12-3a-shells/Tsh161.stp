ISO-10303-21;
/* Tsh161 - ShapeUpgrade_ShellSewing.Apply with-history-tracking
 * Defect: Sewing operation that should record geometry changes in a history map.
 * Apply produces correct shell but history doesn't reflect intermediate states. */
HEADER;
FILE_DESCRIPTION(('Tsh161 test case','Shell sewing without history tracking'),'2;1');
FILE_NAME('Tsh161.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
