ISO-10303-21;
/* Tsh132 - ShapeFix_Shell.FixFaceOrientation flat-shell
 * Defect: shell consisting entirely of coplanar faces (flat shell,
 * like a box with all faces coincident or nearly so).
 * FixFaceOrientation's normal-vector comparison becomes indeterminate
 * when all normals are parallel or anti-parallel. */
HEADER;
FILE_DESCRIPTION(('Tsh132 - flat coplanar shell'),'2;1');
FILE_NAME('Tsh132.stp','2026-06-15T00:00:00',(''),(''),'wave-35','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
