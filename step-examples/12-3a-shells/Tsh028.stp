ISO-10303-21;
/* Tsh028 - STYLED_ITEM lost / mis-bound after sliver-face removal or shell merge
 * Defect: Per-face STYLED_ITEM / PRESENTATION_STYLE_ASSIGNMENT references
 * break when the referenced face is dropped by sliver-face removal
 * (ShapeFix_Face::FixSmallAreaWire) or merged with neighbours during
 * orientation healing.
 *
 * This file: a square plate plus a tiny sliver-face (~1.0e-9 area) that
 * a healer would drop. A STYLED_ITEM (#900) is bound to the sliver
 * face #466 -- when the healer drops #466 the style binding becomes
 * a dangling reference. A second STYLED_ITEM (#910) targets the main
 * face #406 to demonstrate the surviving-binding contrast.
 * Sources: M032, Y004. */
HEADER;
FILE_DESCRIPTION(('Tsh028 test case','STYLED_ITEM bound to sliver face'),'2;1');
FILE_NAME('Tsh028.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh028','Tsh028','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#510));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
