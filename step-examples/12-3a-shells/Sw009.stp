ISO-10303-21;
/* Sw009 - Edge with same_parameter flag stuck true; pcurve and
 * 3D curve disagree; fast-sewing skips reconciliation pass. */
HEADER;
FILE_DESCRIPTION(('Sw009 - same_parameter flag-skip trap','Pass C gap-fill'),'2;1');
FILE_NAME('Sw009.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(1.0,0.0,0.0));
#12=VERTEX_POINT('',#10);
#13=VERTEX_POINT('',#11);
#20=DIRECTION('',(1.0,0.0,0.0));
#21=VECTOR('',#20,1.0);
#22=LINE('curve_param_0_to_1',#10,#21);
/* Pcurve in 2D parameterized differently (param 0 to 2) but flag says same. */
#30=DIRECTION_2D('',(2.0,0.0));
#31=VECTOR_2D('',#30,1.0);
#32=LINE_2D('',#30,#31);
#40=EDGE_CURVE('mismatched_param_same_flag',#12,#13,#22,.T.);
ENDSEC;
END-ISO-10303-21;
