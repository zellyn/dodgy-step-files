ISO-10303-21;
/* Tsh125 - ShapeFix_Shell.Perform recursive context
 * Defect: Perform calls FixFaceOrientation which calls Perform recursively;
 * recursion termination uses depth counter but doesn't reset for sibling-face processing */
HEADER;
FILE_DESCRIPTION(('Tsh125 - shell with faces triggering recursive Perform without depth reset','wave 26'),'2;1');
FILE_NAME('Tsh125.stp','2026-06-15T00:00:00',(''),(''),'heal coverage','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Shell with multiple faces that need orientation fixing */
/* Face 1: bottom rectangle (0,0,0)-(10,0,0)-(10,10,0)-(0,10,0) normal = (0,0,-1) INVERTED */
/* Face 2: right rectangle (10,0,0)-(10,10,0)-(10,10,10)-(10,0,10) normal = (1,0,0) INVERTED */
/* Face 3: front rectangle (0,0,0)-(10,0,0)-(10,0,10)-(0,0,10) normal = (0,-1,0) CORRECT */
/* Face 4: back rectangle (0,10,0)-(0,10,10)-(10,10,10)-(10,10,0) normal = (0,1,0) CORRECT */

#10=CARTESIAN_POINT('',(0,0,0));
#11=CARTESIAN_POINT('',(10.0,0,0));
#12=CARTESIAN_POINT('',(10.0,10.0,0));
#13=CARTESIAN_POINT('',(0,10.0,0));
#14=CARTESIAN_POINT('',(10.0,0,10.0));
#15=CARTESIAN_POINT('',(10.0,10.0,10.0));
#16=CARTESIAN_POINT('',(0,10.0,10.0));
#17=CARTESIAN_POINT('',(0,0,10.0));

#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
#22=VERTEX_POINT('',#12);
#23=VERTEX_POINT('',#13);
#24=VERTEX_POINT('',#14);
#25=VERTEX_POINT('',#15);
#26=VERTEX_POINT('',#16);
#27=VERTEX_POINT('',#17);

/* Planes */
#30=AXIS2_PLACEMENT_3D('z0_plane',#10,DIRECTION('',(0,0,-1)),DIRECTION('',(1,0,0)));
#31=PLANE('',#30);
#32=AXIS2_PLACEMENT_3D('x10_plane',#11,DIRECTION('',(1,0,0)),DIRECTION('',(0,0,1)));
#33=PLANE('',#32);
#34=AXIS2_PLACEMENT_3D('y0_plane',#10,DIRECTION('',(0,-1,0)),DIRECTION('',(1,0,0)));
#35=PLANE('',#34);
#36=AXIS2_PLACEMENT_3D('y10_plane',#13,DIRECTION('',(0,1,0)),DIRECTION('',(1,0,0)));
#37=PLANE('',#36);

/* Face 1 edges (bottom, inverted normal) */
#50=LINE('',#10,VECTOR('',(1,0,0),10.0));
#51=EDGE_CURVE('f1_e1',#20,#21,#50,.T.);
#52=LINE('',#11,VECTOR('',(0,1,0),10.0));
#53=EDGE_CURVE('f1_e2',#21,#22,#52,.T.);
#54=LINE('',#12,VECTOR('',(-1,0,0),10.0));
#55=EDGE_CURVE('f1_e3',#22,#23,#54,.T.);
#56=LINE('',#13,VECTOR('',(0,-1,0),10.0));
#57=EDGE_CURVE('f1_e4',#23,#20,#56,.T.);

/* Face 2 edges (right, inverted normal) */
#60=LINE('',#11,VECTOR('',(0,1,0),10.0));
#61=EDGE_CURVE('f2_e1',#21,#22,#60,.T.);
#62=LINE('',#12,VECTOR('',(0,0,1),10.0));
#63=EDGE_CURVE('f2_e2',#22,#25,#62,.T.);
#64=LINE('',#15,VECTOR('',(0,-1,0),10.0));
#65=EDGE_CURVE('f2_e3',#25,#24,#64,.T.);
#66=LINE('',#14,VECTOR('',(0,0,-1),10.0));
#67=EDGE_CURVE('f2_e4',#24,#21,#66,.T.);

/* Face 3 edges (front) */
#70=LINE('',#10,VECTOR('',(1,0,0),10.0));
#71=EDGE_CURVE('f3_e1',#20,#21,#70,.T.);
#72=LINE('',#11,VECTOR('',(0,0,1),10.0));
#73=EDGE_CURVE('f3_e2',#21,#24,#72,.T.);
#74=LINE('',#14,VECTOR('',(-1,0,0),10.0));
#75=EDGE_CURVE('f3_e3',#24,#27,#74,.T.);
#76=LINE('',#17,VECTOR('',(0,0,-1),10.0));
#77=EDGE_CURVE('f3_e4',#27,#20,#76,.T.);

/* Face 4 edges (back) */
#80=LINE('',#13,VECTOR('',(0,0,1),10.0));
#81=EDGE_CURVE('f4_e1',#23,#26,#80,.T.);
#82=LINE('',#16,VECTOR('',(1,0,0),10.0));
#83=EDGE_CURVE('f4_e2',#26,#25,#82,.T.);
#84=LINE('',#15,VECTOR('',(0,0,-1),10.0));
#85=EDGE_CURVE('f4_e3',#25,#22,#84,.T.);
#86=LINE('',#12,VECTOR('',(-1,0,0),10.0));
#87=EDGE_CURVE('f4_e4',#22,#23,#86,.T.);

/* Face 1 edge loop (inverted, counterclockwise when viewed from below) */
#100=ORIENTED_EDGE('',*,*,#51,.T.);
#101=ORIENTED_EDGE('',*,*,#53,.T.);
#102=ORIENTED_EDGE('',*,*,#55,.T.);
#103=ORIENTED_EDGE('',*,*,#57,.T.);
#104=EDGE_LOOP('f1_loop',(#100,#101,#102,#103));

/* Face 2 edge loop (inverted, wrong orientation) */
#110=ORIENTED_EDGE('',*,*,#61,.F.);
#111=ORIENTED_EDGE('',*,*,#63,.T.);
#112=ORIENTED_EDGE('',*,*,#65,.F.);
#113=ORIENTED_EDGE('',*,*,#67,.T.);
#114=EDGE_LOOP('f2_loop',(#110,#111,#112,#113));

/* Face 3 edge loop */
#120=ORIENTED_EDGE('',*,*,#71,.T.);
#121=ORIENTED_EDGE('',*,*,#73,.T.);
#122=ORIENTED_EDGE('',*,*,#75,.T.);
#123=ORIENTED_EDGE('',*,*,#77,.T.);
#124=EDGE_LOOP('f3_loop',(#120,#121,#122,#123));

/* Face 4 edge loop */
#130=ORIENTED_EDGE('',*,*,#81,.T.);
#131=ORIENTED_EDGE('',*,*,#83,.T.);
#132=ORIENTED_EDGE('',*,*,#85,.T.);
#133=ORIENTED_EDGE('',*,*,#87,.T.);
#134=EDGE_LOOP('f4_loop',(#130,#131,#132,#133));

/* Face bounds */
#150=FACE_OUTER_BOUND('',#104,.T.);
#151=FACE_OUTER_BOUND('',#114,.T.);
#152=FACE_OUTER_BOUND('',#124,.T.);
#153=FACE_OUTER_BOUND('',#134,.T.);

/* Faces */
#160=ADVANCED_FACE('f1_inverted',(#150),#31,.T.);
#161=ADVANCED_FACE('f2_inverted',(#151),#33,.T.);
#162=ADVANCED_FACE('f3',(#152),#35,.T.);
#163=ADVANCED_FACE('f4',(#153),#37,.T.);

/* Shell with multiple faces requiring orientation fixing */
#200=OPEN_SHELL('recursive_context_shell',(#160,#161,#162,#163));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh125','Tsh125','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#200));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
