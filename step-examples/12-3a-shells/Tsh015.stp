ISO-10303-21;
/* Tsh015 - Brep_with_voids: void shell oriented .T. instead of .F.
 *          (ProSTEP TR9)
 * Defect: Per AP214, voids in a BREP_WITH_VOIDS must be REVERSED
 * orientation relative to the outer shell; some files emit them with
 * .T. so the void is mis-classified as a positive volume. Sources:
 * Q027 (ProSTEP TR9, RWStepShape_RWBrepWithVoids).
 *
 * This file: an outer cube (1.0^3) with an inner cube void (0.4^3
 * centered at (0.5, 0.5, 0.5)). The void's ORIENTED_CLOSED_SHELL
 * orientation flag is .T. (defect) instead of .F. (correct). */
HEADER;
FILE_DESCRIPTION(('Tsh015 - BREP_WITH_VOIDS void shell .T.'',''2;1'',''2;1'),'2;1');
FILE_NAME('Tsh015.stp','2026-06-16T00:00:00',(''),(''),'wave-01','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
