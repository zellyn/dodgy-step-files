ISO-10303-21;
/* Tsh144: THREE ADVANCED_FACEs meeting at shared EDGE_CURVE at x=1 y=[0,1] — IS the T-junction mechanism; Face1 (x=[0,1] y=[0,1]) references shared EDGE_CURVE as right boundary — IS wired into EDGE_LOOP1; Face2 (x=[1,2] y=[0,1]) references same shared EDGE_CURVE as left boundary — IS wired into EDGE_LOOP2; Face3 (x=[0,1] y=[1,2]) references same shared EDGE_CURVE as bottom boundary — IS wired into EDGE_LOOP3; single EDGE_CURVE referenced by 3 EDGE_LOOPs IS the non-manifold topology; FixFaceOrientation propagates from Face1 consistently with Face2 but Face3 remains flipped; fix: detect non-manifold edges (3+ face references); apply branching orientation strategy; emit E_NON_MANIFOLD_ORIENTATION_AMBIGUOUS when T-junction edge found during propagation */
HEADER;
FILE_DESCRIPTION(('Tsh144'),'2;1');
