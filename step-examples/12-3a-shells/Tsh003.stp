ISO-10303-21;
/* Tsh003 - Closed solid round-trips as SHELL_BASED_SURFACE_MODEL/OPEN_SHELL
 * Defect: A topologically closed solid is emitted as
 *   SHELL_BASED_SURFACE_MODEL -> OPEN_SHELL inside
 *   ADVANCED_BREP_SHAPE_REPRESENTATION
 * instead of MANIFOLD_SOLID_BREP -> CLOSED_SHELL. Downstream tools that
 * require closed-solid classification (Bambu Studio, FEA pipelines)
 * refuse to import it as a solid. Source: SpaceClaim 2025R2 / HOOPS
 * Exchange 24.6-25.2 regression. */
HEADER;
FILE_DESCRIPTION(('Tsh003 - Closed solid emitted as SHELL_BASED_SURFACE_MODEL'',''2;1'',''2;1'),'2;1');
FILE_NAME('Tsh003.stp','2026-06-16T00:00:00',(''),(''),'wave-01','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Tetrahedron (4 vertices forming a closed shell of 4 triangular faces) */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('',(0.0,1.0,0.0));
#103=CARTESIAN_POINT('',(0.0,0.0,1.0));
#110=VERTEX_POINT('',#100); #111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102); #113=VERTEX_POINT('',#103);
/* Plane surfaces for the four triangle faces */
#120=DIRECTION('',(0.0,0.0,-1.0)); #121=DIRECTION('',(1.0,0.0,0.0));
#122=AXIS2_PLACEMENT_3D('',#100,#120,#121); #123=PLANE('',#122);
#130=DIRECTION('',(0.0,-1.0,0.0)); #131=DIRECTION('',(1.0,0.0,0.0));
#132=AXIS2_PLACEMENT_3D('',#100,#130,#131); #133=PLANE('',#132);
#140=DIRECTION('',(-1.0,0.0,0.0)); #141=DIRECTION('',(0.0,1.0,0.0));
#142=AXIS2_PLACEMENT_3D('',#100,#140,#141); #143=PLANE('',#142);
/* Slanted face normal proportional to (1,1,1)/sqrt(3) */
#150=DIRECTION('',(0.5773502691896258,0.5773502691896258,0.5773502691896258));
#151=DIRECTION('',(0.7071067811865476,-0.7071067811865476,0.0));
#152=AXIS2_PLACEMENT_3D('',#101,#150,#151); #153=PLANE('',#152);
/* Edges */
#200=DIRECTION('',(1.0,0.0,0.0)); #201=VECTOR('',#200,1.0);
#202=DIRECTION('',(0.0,1.0,0.0)); #203=VECTOR('',#202,1.0);
#204=DIRECTION('',(0.0,0.0,1.0)); #205=VECTOR('',#204,1.0);
#206=DIRECTION('',(-0.7071067811865476,0.7071067811865476,0.0)); #207=VECTOR('',#206,1.4142135623730951);
#208=DIRECTION('',(-0.7071067811865476,0.0,0.7071067811865476)); #209=VECTOR('',#208,1.4142135623730951);
#210=DIRECTION('',(0.0,-0.7071067811865476,0.7071067811865476)); #211=VECTOR('',#210,1.4142135623730951);
#220=LINE('',#100,#201); #221=EDGE_CURVE('',#110,#111,#220,.T.);
#222=LINE('',#100,#203); #223=EDGE_CURVE('',#110,#112,#222,.T.);
#224=LINE('',#100,#205); #225=EDGE_CURVE('',#110,#113,#224,.T.);
#226=LINE('',#101,#207); #227=EDGE_CURVE('',#111,#112,#226,.T.);
#228=LINE('',#101,#209); #229=EDGE_CURVE('',#111,#113,#228,.T.);
#230=LINE('',#102,#211); #231=EDGE_CURVE('',#112,#113,#230,.T.);
/* Four faces with consistent outward orientation */
#300=ORIENTED_EDGE('',*,*,#221,.T.); #301=ORIENTED_EDGE('',*,*,#227,.T.);
#302=ORIENTED_EDGE('',*,*,#223,.F.);
#303=EDGE_LOOP('',(#300,#301,#302)); #304=FACE_OUTER_BOUND('',#303,.T.);
#305=ADVANCED_FACE('',(#304),#123,.F.);
#310=ORIENTED_EDGE('',*,*,#221,.T.); #311=ORIENTED_EDGE('',*,*,#229,.T.);
#312=ORIENTED_EDGE('',*,*,#225,.F.);
#313=EDGE_LOOP('',(#310,#311,#312)); #314=FACE_OUTER_BOUND('',#313,.T.);
#315=ADVANCED_FACE('',(#314),#133,.F.);
#320=ORIENTED_EDGE('',*,*,#225,.T.); #321=ORIENTED_EDGE('',*,*,#231,.F.);
#322=ORIENTED_EDGE('',*,*,#223,.F.);
#323=EDGE_LOOP('',(#320,#321,#322)); #324=FACE_OUTER_BOUND('',#323,.T.);
#325=ADVANCED_FACE('',(#324),#143,.F.);
#330=ORIENTED_EDGE('',*,*,#227,.T.); #331=ORIENTED_EDGE('',*,*,#231,.T.);
#332=ORIENTED_EDGE('',*,*,#229,.F.);
#333=EDGE_LOOP('',(#330,#331,#332)); #334=FACE_OUTER_BOUND('',#333,.T.);
#335=ADVANCED_FACE('',(#334),#153,.T.);
/* Defect: topology closes (4 faces, every edge shared by 2 faces) but
   the producer wraps the face set in OPEN_SHELL + SHELL_BASED_SURFACE_MODEL
   instead of CLOSED_SHELL + MANIFOLD_SOLID_BREP. */
#400=OPEN_SHELL('actually_closed_tetrahedron',(#305,#315,#325,#335));
#410=SHELL_BASED_SURFACE_MODEL('regression',(#400));
/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh003','Tsh003','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#400));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
