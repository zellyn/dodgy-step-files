ISO-10303-21;
/* Tsh259: TEST - Face BIG (10x10, Tfa208's proven small-area-hole scale) has an internal
   hole wire (area~1e-8) built from 4 EDGE_CURVE entities; a SEPARATE small face
   (SMALL_NEIGHBOR) has its ENTIRE outer boundary built from those SAME 4 EDGE_CURVE
   entities (genuine shared topology, not coincidental duplicate geometry) -- so once
   ShapeUpgrade_RemoveInternalWires removes BIG's tiny hole wire, SMALL_NEIGHBOR's whole
   outer wire consists only of now-removed edges and cascades into being removed too. */
HEADER;
FILE_DESCRIPTION(('Tsh259'),'2;1');
FILE_NAME('Tsh259.stp','2026-07-13T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
