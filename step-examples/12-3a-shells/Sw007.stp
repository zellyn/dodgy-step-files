ISO-10303-21;
/* Sw007 - Fast-sewing vertex hash collision.
 * Defect: two wire endpoints have 3D coordinates that hash to
 * the same bucket but are spatially distant. The sewer cannot
 * decide whether to dedup. */
HEADER;
FILE_DESCRIPTION(('Sw007 - fast sewing vertex hash collision','Pass C gap-fill'),'2;1');
FILE_NAME('Sw007.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Two distant points whose float bit patterns happen to land in same hash bucket */
#10=CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p2_far_but_collide',(1.0e6,0.0,0.0));
#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
ENDSEC;
END-ISO-10303-21;
