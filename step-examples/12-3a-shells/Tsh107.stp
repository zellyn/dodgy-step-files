ISO-10303-21;
/* Tsh107 - ShapeFix_Shell.Perform double-orient oscillation
 * Defect: Perform's orientation pass runs FixFaceOrientation then re-checks;
 * the recheck flips orientation again when invariant is achieved (oscillation) */
HEADER;
FILE_DESCRIPTION(('Tsh107 test case','Perform double-orient oscillation'),'2;1');
FILE_NAME('Tsh107.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Three faces forming a corner: each pair shares an edge;
   face orientations are subtly inconsistent */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));#11=VERTEX_POINT('',#10);
#12=CARTESIAN_POINT('',(1.0,0.0,0.0));#13=VERTEX_POINT('',#12);
#14=CARTESIAN_POINT('',(1.0,1.0,0.0));#15=VERTEX_POINT('',#14);
#16=CARTESIAN_POINT('',(0.0,1.0,0.0));#17=VERTEX_POINT('',#16);
#18=CARTESIAN_POINT('',(1.0,1.0,1.0));#19=VERTEX_POINT('',#18);
#20=CARTESIAN_POINT('',(0.0,1.0,1.0));#21=VERTEX_POINT('',#20);
/* Base face (Z=0) edges */
#30=DIRECTION('',(1.0,0.0,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#10,#31);
#33=EDGE_CURVE('',#11,#13,#32,.T.);
#34=DIRECTION('',(0.0,1.0,0.0));#35=VECTOR('',#34,1.0);#36=LINE('',#12,#35);
#37=EDGE_CURVE('',#13,#15,#36,.T.);
#38=DIRECTION('',(-1.0,0.0,0.0));#39=VECTOR('',#38,1.0);#40=LINE('',#14,#39);
#41=EDGE_CURVE('',#15,#17,#40,.T.);
#42=DIRECTION('',(0.0,-1.0,0.0));#43=VECTOR('',#42,1.0);#44=LINE('',#16,#43);
#45=EDGE_CURVE('',#17,#11,#44,.T.);
/* Right face (X=1) edges - includes #37 shared with base */
#46=DIRECTION('',(0.0,0.0,1.0));#47=VECTOR('',#46,1.0);#48=LINE('',#12,#47);
#49=EDGE_CURVE('',#13,#19,#48,.T.);
#50=DIRECTION('',(-1.0,0.0,0.0));#51=VECTOR('',#50,1.0);#52=LINE('',#18,#51);
#53=EDGE_CURVE('',#19,#15,#52,.T.);
/* Back face (Y=1) edges - includes #37, #53 shared with other faces */
#54=DIRECTION('',(0.0,0.0,1.0));#55=VECTOR('',#54,1.0);#56=LINE('',#14,#55);
#57=EDGE_CURVE('',#15,#18,#56,.T.);
#58=DIRECTION('',(-1.0,0.0,0.0));#59=VECTOR('',#58,1.0);#60=LINE('',#20,#59);
#61=EDGE_CURVE('',#21,#17,#60,.T.);
#62=DIRECTION('',(0.0,0.0,1.0));#63=VECTOR('',#62,1.0);#64=LINE('',#16,#63);
#65=EDGE_CURVE('',#17,#21,#64,.T.);
/* Face 1: Base face (Z=0) */
#70=ORIENTED_EDGE('',*,*,#33,.T.);#71=ORIENTED_EDGE('',*,*,#37,.T.);
#72=ORIENTED_EDGE('',*,*,#41,.T.);#73=ORIENTED_EDGE('',*,*,#45,.T.);
#74=EDGE_LOOP('',(#70,#71,#72,#73));
#80=DIRECTION('',(0.0,0.0,-1.0));#81=DIRECTION('',(1.0,0.0,0.0));
#82=AXIS2_PLACEMENT_3D('',#10,#80,#81);#83=PLANE('',#82);
#84=FACE_OUTER_BOUND('',#74,.T.);
#85=ADVANCED_FACE('base',(#84),#83,.T.);
/* Face 2: Right face (X=1) */
#90=ORIENTED_EDGE('',*,*,#37,.F.);
#91=ORIENTED_EDGE('',*,*,#49,.T.);
#92=ORIENTED_EDGE('',*,*,#53,.F.);
#93=EDGE_LOOP('',(#90,#91,#92));
#100=DIRECTION('',(-1.0,0.0,0.0));#101=DIRECTION('',(0.0,1.0,0.0));
#102=AXIS2_PLACEMENT_3D('',#12,#100,#101);#103=PLANE('',#102);
#104=FACE_OUTER_BOUND('',#93,.T.);
#105=ADVANCED_FACE('right',(#104),#103,.T.);
/* Face 3: Back face (Y=1) - inconsistent orientation relative to neighbors */
#110=ORIENTED_EDGE('',*,*,#57,.T.);
#111=ORIENTED_EDGE('',*,*,#53,.T.);
#112=ORIENTED_EDGE('',*,*,#65,.F.);
#113=ORIENTED_EDGE('',*,*,#61,.T.);
#114=EDGE_LOOP('',(#110,#111,#112,#113));
#120=DIRECTION('',(0.0,-1.0,0.0));#121=DIRECTION('',(1.0,0.0,0.0));
#122=AXIS2_PLACEMENT_3D('',#16,#120,#121);#123=PLANE('',#122);
#124=FACE_OUTER_BOUND('',#114,.T.);
#125=ADVANCED_FACE('back',(#124),#123,.T.);
/* OPEN_SHELL with three faces; oscillation triggers on re-check */
#200=OPEN_SHELL('oscillation_shell',(#85,#105,#125));
#210=SHELL_BASED_SURFACE_MODEL('sbsm',(#200));
#220=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#221=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#222=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#223=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#220,'distance_accuracy_value','');
#224=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#223))GLOBAL_UNIT_ASSIGNED_CONTEXT((#220,#221,#222))REPRESENTATION_CONTEXT('','3D'));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh107','Tsh107','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#200));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
