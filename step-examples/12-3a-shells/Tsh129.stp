ISO-10303-21;
/* Tsh129 - ShapeFix_Shell.Perform compound-input
 * Defect: input shape is a COMPOUND containing multiple CLOSED_SHELLs;
 * Perform processes only the first shell and silently ignores the rest.
 * Expected: all shells should be processed or error raised. */
HEADER;
FILE_DESCRIPTION(('Tsh129 - compound with multiple shells'),'2;1');
FILE_NAME('Tsh129.stp','2026-06-15T00:00:00',(''),(''),'wave-35','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Shell 1: unit square in z=0 plane */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('',(1.0,1.0,0.0));
#13=CARTESIAN_POINT('',(0.0,1.0,0.0));
#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
#22=VERTEX_POINT('',#12);
#23=VERTEX_POINT('',#13);
#30=DIRECTION('',(1.0,0.0,0.0));
#31=VECTOR('',#30,1.0);
#32=DIRECTION('',(0.0,1.0,0.0));
#33=VECTOR('',#32,1.0);
#40=LINE('',#10,#31); #41=EDGE_CURVE('',#20,#21,#40,.T.);
#42=LINE('',#11,#33); #43=EDGE_CURVE('',#21,#22,#42,.T.);
#44=LINE('',#13,#31); #45=EDGE_CURVE('',#23,#22,#44,.T.);
#46=LINE('',#10,#33); #47=EDGE_CURVE('',#20,#23,#46,.T.);
#50=ORIENTED_EDGE('',*,*,#41,.T.);
#51=ORIENTED_EDGE('',*,*,#43,.T.);
#52=ORIENTED_EDGE('',*,*,#45,.F.);
#53=ORIENTED_EDGE('',*,*,#47,.F.);
#60=EDGE_LOOP('',(#50,#51,#52,#53));
#61=FACE_OUTER_BOUND('',#60,.T.);
#70=DIRECTION('',(0.0,0.0,1.0));
#71=DIRECTION('',(1.0,0.0,0.0));
#72=AXIS2_PLACEMENT_3D('',#10,#70,#71);
#73=PLANE('p1',#72);
#100=ADVANCED_FACE('face1',(#61),#73,.T.);
#200=CLOSED_SHELL('shell1',(#100));
/* Shell 2: unit square in z=2 plane (translated) */
#110=CARTESIAN_POINT('',(0.0,0.0,2.0));
#111=CARTESIAN_POINT('',(1.0,0.0,2.0));
#112=CARTESIAN_POINT('',(1.0,1.0,2.0));
#113=CARTESIAN_POINT('',(0.0,1.0,2.0));
#120=VERTEX_POINT('',#110);
#121=VERTEX_POINT('',#111);
#122=VERTEX_POINT('',#112);
#123=VERTEX_POINT('',#113);
#130=DIRECTION('',(1.0,0.0,0.0));
#131=VECTOR('',#130,1.0);
#132=DIRECTION('',(0.0,1.0,0.0));
#133=VECTOR('',#132,1.0);
#140=LINE('',#110,#131); #141=EDGE_CURVE('',#120,#121,#140,.T.);
#142=LINE('',#111,#133); #143=EDGE_CURVE('',#121,#122,#142,.T.);
#144=LINE('',#113,#131); #145=EDGE_CURVE('',#123,#122,#144,.T.);
#146=LINE('',#110,#133); #147=EDGE_CURVE('',#120,#123,#146,.T.);
#150=ORIENTED_EDGE('',*,*,#141,.T.);
#151=ORIENTED_EDGE('',*,*,#143,.T.);
#152=ORIENTED_EDGE('',*,*,#145,.F.);
#153=ORIENTED_EDGE('',*,*,#147,.F.);
#160=EDGE_LOOP('',(#150,#151,#152,#153));
#161=FACE_OUTER_BOUND('',#160,.T.);
#170=DIRECTION('',(0.0,0.0,1.0));
#171=DIRECTION('',(1.0,0.0,0.0));
#172=AXIS2_PLACEMENT_3D('',#110,#170,#171);
#173=PLANE('p2',#172);
#101=ADVANCED_FACE('face2',(#161),#173,.T.);
#201=CLOSED_SHELL('shell2',(#101));
/* Compound containing both shells - defect: only first will be processed */
#300=COMPOUND('compound_shells',(#200,#201));
/* PRODUCT chain for compound */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh129','Tsh129','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm_compound',(#200,#201));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
