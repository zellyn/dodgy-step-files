ISO-10303-21;
/* Tsh184 - duplicate faces in shell
 * Defect: Shell containing two identical faces; orientation fix processes both independently,
 * producing inconsistent orientation outcomes. */
HEADER;
FILE_DESCRIPTION(('Tsh184 - duplicate faces orientation','2;1');
FILE_NAME('Tsh184.stp','2026-06-15T00:00:00',(''),(''),'wave-53A','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Three coplanar square faces, two identical */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('',(1.0,1.0,0.0));
#103=CARTESIAN_POINT('',(0.0,1.0,0.0));
#104=CARTESIAN_POINT('',(2.0,0.0,0.0));
#105=CARTESIAN_POINT('',(2.0,1.0,0.0));
#106=CARTESIAN_POINT('',(3.0,0.0,0.0));
#107=CARTESIAN_POINT('',(3.0,1.0,0.0));
#110=VERTEX_POINT('',#100);
#111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102);
#113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104);
#115=VERTEX_POINT('',#105);
#116=VERTEX_POINT('',#106);
#117=VERTEX_POINT('',#107);

/* Plane z=0 (coplanar for all) */
#200=DIRECTION('',(0.0,0.0,1.0));
#201=DIRECTION('',(1.0,0.0,0.0));
#210=CARTESIAN_POINT('',(0.5,0.5,0.0));
#211=AXIS2_PLACEMENT_3D('',#210,#200,#201);
#212=PLANE('',#211);

#220=CARTESIAN_POINT('',(1.5,0.5,0.0));
#221=AXIS2_PLACEMENT_3D('',#220,#200,#201);
#222=PLANE('',#221);

#230=CARTESIAN_POINT('',(2.5,0.5,0.0));
#231=AXIS2_PLACEMENT_3D('',#230,#200,#201);
#232=PLANE('',#231);

/* First face edges: 100->101->102->103 */
#300=DIRECTION('',(1.0,0.0,0.0));
#301=VECTOR('',#300,1.0);
#310=LINE('',#100,#301);
#311=EDGE_CURVE('',#110,#111,#310,.T.);

#302=DIRECTION('',(0.0,1.0,0.0));
#303=VECTOR('',#302,1.0);
#312=LINE('',#101,#303);
#313=EDGE_CURVE('',#111,#112,#312,.T.);

#314=LINE('',#102,#301);
#315=EDGE_CURVE('',#112,#113,#314,.T.);

#316=LINE('',#103,#301);
#317=EDGE_CURVE('',#113,#110,#316,.T.);

/* Second face edges: 104->105->102->101 (identical square, shifted) */
#318=DIRECTION('',(1.0,0.0,0.0));
#319=VECTOR('',#318,1.0);
#320=LINE('',#104,#319);
#321=EDGE_CURVE('',#114,#115,#320,.T.);

#322=DIRECTION('',(0.0,1.0,0.0));
#323=VECTOR('',#322,1.0);
#324=LINE('',#105,#323);
#325=EDGE_CURVE('',#115,#112,#324,.T.);

#326=DIRECTION('',(-1.0,0.0,0.0));
#327=VECTOR('',#326,1.0);
#328=LINE('',#105,#327);
#329=EDGE_CURVE('',#115,#111,#328,.T.);

#330=LINE('',#104,#327);
#331=EDGE_CURVE('',#114,#111,#330,.T.);

/* Third face (duplicate of first): 106->107->102->101 */
#332=DIRECTION('',(1.0,0.0,0.0));
#333=VECTOR('',#332,1.0);
#334=LINE('',#106,#333);
#335=EDGE_CURVE('',#116,#117,#334,.T.);

#336=DIRECTION('',(0.0,1.0,0.0));
#337=VECTOR('',#336,1.0);
#338=LINE('',#107,#337);
#339=EDGE_CURVE('',#117,#112,#338,.T.);

#340=LINE('',#107,#333);
#341=EDGE_CURVE('',#117,#111,#340,.T.);

#342=LINE('',#106,#333);
#343=EDGE_CURVE('',#116,#111,#342,.T.);

/* First face loop */
#400=ORIENTED_EDGE('',*,*,#311,.T.);
#401=ORIENTED_EDGE('',*,*,#313,.T.);
#402=ORIENTED_EDGE('',*,*,#315,.T.);
#403=ORIENTED_EDGE('',*,*,#317,.T.);
#410=EDGE_LOOP('',(#400,#401,#402,#403));
#420=FACE_OUTER_BOUND('',#410,.T.);
#430=ADVANCED_FACE('',(#420),#212,.T.);

/* Second face loop */
#440=ORIENTED_EDGE('',*,*,#321,.T.);
#441=ORIENTED_EDGE('',*,*,#325,.T.);
#442=ORIENTED_EDGE('',*,*,#329,.T.);
#443=ORIENTED_EDGE('',*,*,#331,.T.);
#450=EDGE_LOOP('',(#440,#441,#442,#443));
#460=FACE_OUTER_BOUND('',#450,.T.);
#470=ADVANCED_FACE('',(#460),#222,.T.);

/* Third face loop (duplicate, different orientation) */
#480=ORIENTED_EDGE('',*,*,#335,.T.);
#481=ORIENTED_EDGE('',*,*,#339,.T.);
#482=ORIENTED_EDGE('',*,*,#341,.T.);
#483=ORIENTED_EDGE('',*,*,#343,.F.);
#490=EDGE_LOOP('',(#480,#481,#482,#483));
#500=FACE_OUTER_BOUND('',#490,.T.);
#510=ADVANCED_FACE('',(#500),#232,.T.);

/* Shell with three faces (two copies of identical face) */
#600=CLOSED_SHELL('duplicate_face_shell',(#430,#470,#510));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh184','Tsh184','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#600));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
