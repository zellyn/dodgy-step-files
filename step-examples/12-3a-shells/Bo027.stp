ISO-10303-21;
/* Bo027: Two COMPLEX_TRIANGULATED_FACEs sharing node at origin: faceA normal (0,0,1), faceB normal (0.7,0,0.7) at same node — inconsistent per-vertex normals IS wired into shell/face topology; OCCT silently drops (empty result); catalog asks for heal or reject */
HEADER;
FILE_DESCRIPTION(('Bo027'),'2;1');
FILE_NAME('Bo027.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=COORDINATES_LIST('faceA_coords',3,((0.,0.,0.),(1.,0.,0.),(0.,1.,0.)));
#2=COORDINATES_LIST('faceA_normals',3,((0.,0.,1.),(0.,0.,1.),(0.,0.,1.)));
#3=COMPLEX_TRIANGULATED_FACE('faceA',#1,((0,1,2)),.T.,#2);
#4=COORDINATES_LIST('faceB_coords',3,((0.,0.,0.),(1.,0.,0.),(0.,0.,1.)));
#5=COORDINATES_LIST('faceB_normals',3,((0.7071067811865476,0.,0.7071067811865476),(0.7071067811865476,0.,0.7071067811865476),(0.7071067811865476,0.,0.7071067811865476)));
#6=COMPLEX_TRIANGULATED_FACE('faceB',#4,((0,1,2)),.T.,#5);
#7=OPEN_SHELL('bo027_shell',(#3,#6));
#8=SHELL_BASED_SURFACE_MODEL('bo027',(#7));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Bo027','Bo027','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#8),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
