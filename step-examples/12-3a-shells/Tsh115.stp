ISO-10303-21;
/* Tsh115 - single PLANE face with same_sense=.F.
 * Defect: single PLANE face in CLOSED_SHELL with orientation flag reversed;
 * content normal naturally points outward, creating consistency-vs-flag mismatch. */
HEADER;
FILE_DESCRIPTION(('Tsh115 - orientation flag mismatch','wave 20'),'2;1');
FILE_NAME('Tsh115.stp','2026-06-15T00:00:00',(''),(''),'heal coverage','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Single planar quad face (degenerate "closed" shell) */

#10=CARTESIAN_POINT('',(0,0,0));
#11=CARTESIAN_POINT('',(10.0,0,0));
#12=CARTESIAN_POINT('',(10.0,10.0,0));
#13=CARTESIAN_POINT('',(0,10.0,0));

/* Vertices */
#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
#22=VERTEX_POINT('',#12);
#23=VERTEX_POINT('',#13);

/* Plane (normal points in +Z) */
#30=AXIS2_PLACEMENT_3D('plane',#10,DIRECTION('',(0,0,1)),DIRECTION('',(1,0,0)));
#31=PLANE('',#30);

/* Edges (counter-clockwise when viewed from +Z) */
#40=LINE('',#10,VECTOR('',(1,0,0),10.0));
#41=EDGE_CURVE('e1',#20,#21,#40,.T.);
#42=LINE('',#11,VECTOR('',(0,1,0),10.0));
#43=EDGE_CURVE('e2',#21,#22,#42,.T.);
#44=LINE('',#12,VECTOR('',(-1,0,0),10.0));
#45=EDGE_CURVE('e3',#22,#23,#44,.T.);
#46=LINE('',#13,VECTOR('',(0,-1,0),10.0));
#47=EDGE_CURVE('e4',#23,#20,#46,.T.);

/* Edge loop */
#50=ORIENTED_EDGE('',*,*,#41,.T.);
#51=ORIENTED_EDGE('',*,*,#43,.T.);
#52=ORIENTED_EDGE('',*,*,#45,.T.);
#53=ORIENTED_EDGE('',*,*,#47,.T.);
#54=EDGE_LOOP('outer_loop',(#50,#51,#52,#53));

/* Face bound - with same_sense=.F. to create mismatch */
#60=FACE_OUTER_BOUND('',#54,.F.);

/* Face - orientation flag contradicts geometric normal */
#70=ADVANCED_FACE('flagged_face',(#60),#31,.F.);

/* Closed shell with single face */
#80=CLOSED_SHELL('single_face_shell',(#70));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh115','Tsh115','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#80));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
