ISO-10303-21;
/* Ps006 - CLOSED_SHELL where one face double-covers a region of another - kernel accepts file silently; tier-3 introspection reveals two faces overlap on a 2D region */
HEADER;
FILE_DESCRIPTION(('Ps006 pathological-success','Self-overlapping shell with double-covered region'),'2;1');
FILE_NAME('Ps006.stp','2026-04-26T00:00:00',(''),(''),'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* A unit cube where the BOTTOM face is covered TWICE: once by a single
   face spanning the whole z=0 square, and once by a second face
   covering the (0..0.5, 0..0.5) quadrant at the same z=0 plane.
   Both faces share the same supporting PLANE; the second face's edge
   loop uses fresh edges (not shared with the first face). The shell
   is "closed" in the sense that every edge has even degree, but a
   ray through (0.25,0.25,0) crosses the bottom surface twice rather
   than once. T-vertices appear where the smaller face's edges meet
   the larger face's interior. */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('',(1.0,1.0,0.0));
#103=CARTESIAN_POINT('',(0.0,1.0,0.0));
#104=CARTESIAN_POINT('',(0.0,0.0,1.0));
#105=CARTESIAN_POINT('',(1.0,0.0,1.0));
#106=CARTESIAN_POINT('',(1.0,1.0,1.0));
#107=CARTESIAN_POINT('',(0.0,1.0,1.0));
/* Extra vertices for the double-covering quadrant (all on z=0) */
#108=CARTESIAN_POINT('',(0.5,0.0,0.0));
#109=CARTESIAN_POINT('',(0.5,0.5,0.0));
#120=CARTESIAN_POINT('',(0.0,0.5,0.0));
#110=VERTEX_POINT('',#100); #111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102); #113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104); #115=VERTEX_POINT('',#105);
#116=VERTEX_POINT('',#106); #117=VERTEX_POINT('',#107);
#118=VERTEX_POINT('',#108); #119=VERTEX_POINT('',#109);
#121=VERTEX_POINT('',#120);
#200=DIRECTION('',(0.0,0.0,1.0)); #201=DIRECTION('',(1.0,0.0,0.0));
#211=AXIS2_PLACEMENT_3D('',#100,#200,#201); #212=PLANE('z0_plane',#211);
#221=AXIS2_PLACEMENT_3D('',#104,#200,#201); #222=PLANE('',#221);
#231=DIRECTION('',(0.0,1.0,0.0)); #232=AXIS2_PLACEMENT_3D('',#100,#231,#201); #233=PLANE('',#232);
#242=AXIS2_PLACEMENT_3D('',#103,#231,#201); #243=PLANE('',#242);
#252=DIRECTION('',(1.0,0.0,0.0)); #253=AXIS2_PLACEMENT_3D('',#100,#252,#231); #254=PLANE('',#253);
#262=AXIS2_PLACEMENT_3D('',#101,#252,#231); #263=PLANE('',#262);
#300=DIRECTION('',(1.0,0.0,0.0)); #301=VECTOR('',#300,1.0);
#302=DIRECTION('',(0.0,1.0,0.0)); #303=VECTOR('',#302,1.0);
#304=DIRECTION('',(0.0,0.0,1.0)); #305=VECTOR('',#304,1.0);
#310=LINE('',#100,#301); #311=EDGE_CURVE('',#110,#111,#310,.T.);
#312=LINE('',#101,#303); #313=EDGE_CURVE('',#111,#112,#312,.T.);
#314=LINE('',#103,#301); #315=EDGE_CURVE('',#113,#112,#314,.T.);
#316=LINE('',#100,#303); #317=EDGE_CURVE('',#110,#113,#316,.T.);
#318=LINE('',#104,#301); #319=EDGE_CURVE('',#114,#115,#318,.T.);
#320=LINE('',#105,#303); #321=EDGE_CURVE('',#115,#116,#320,.T.);
#322=LINE('',#107,#301); #323=EDGE_CURVE('',#117,#116,#322,.T.);
#324=LINE('',#104,#303); #325=EDGE_CURVE('',#114,#117,#324,.T.);
#326=LINE('',#100,#305); #327=EDGE_CURVE('',#110,#114,#326,.T.);
#328=LINE('',#101,#305); #329=EDGE_CURVE('',#111,#115,#328,.T.);
#330=LINE('',#102,#305); #331=EDGE_CURVE('',#112,#116,#330,.T.);
#332=LINE('',#103,#305); #333=EDGE_CURVE('',#113,#117,#332,.T.);
/* Edges for the quadrant overlay face */
#340=LINE('',#100,#301); #341=EDGE_CURVE('overlay_a',#110,#118,#340,.T.);
#342=LINE('',#108,#303); #343=EDGE_CURVE('overlay_b',#118,#119,#342,.T.);
#344=LINE('',#120,#301); #345=EDGE_CURVE('overlay_c',#121,#119,#344,.T.);
#346=LINE('',#100,#303); #347=EDGE_CURVE('overlay_d',#110,#121,#346,.T.);
/* Bottom: full square */
#400=ORIENTED_EDGE('',*,*,#311,.F.); #401=ORIENTED_EDGE('',*,*,#317,.T.);
#402=ORIENTED_EDGE('',*,*,#315,.F.); #403=ORIENTED_EDGE('',*,*,#313,.F.);
#404=EDGE_LOOP('',(#400,#401,#402,#403)); #405=FACE_OUTER_BOUND('',#404,.T.);
#406=ADVANCED_FACE('bottom_full',(#405),#212,.F.);
/* OVERLAY face: smaller quadrant on the SAME plane #212. */
#407=ORIENTED_EDGE('',*,*,#341,.F.); #408=ORIENTED_EDGE('',*,*,#347,.T.);
#409=ORIENTED_EDGE('',*,*,#345,.F.); #420=ORIENTED_EDGE('',*,*,#343,.F.);
#421=EDGE_LOOP('',(#407,#408,#409,#420)); #422=FACE_OUTER_BOUND('',#421,.T.);
#423=ADVANCED_FACE('bottom_overlay',(#422),#212,.F.);
/* Other 5 cube faces unchanged */
#410=ORIENTED_EDGE('',*,*,#319,.T.); #411=ORIENTED_EDGE('',*,*,#321,.T.);
#412=ORIENTED_EDGE('',*,*,#323,.F.); #413=ORIENTED_EDGE('',*,*,#325,.F.);
#414=EDGE_LOOP('',(#410,#411,#412,#413)); #415=FACE_OUTER_BOUND('',#414,.T.);
#416=ADVANCED_FACE('top',(#415),#222,.T.);
#430=ORIENTED_EDGE('',*,*,#311,.T.); #431=ORIENTED_EDGE('',*,*,#329,.T.);
#432=ORIENTED_EDGE('',*,*,#319,.F.); #433=ORIENTED_EDGE('',*,*,#327,.F.);
#434=EDGE_LOOP('',(#430,#431,#432,#433)); #435=FACE_OUTER_BOUND('',#434,.T.);
#436=ADVANCED_FACE('front',(#435),#233,.F.);
#440=ORIENTED_EDGE('',*,*,#315,.T.); #441=ORIENTED_EDGE('',*,*,#331,.T.);
#442=ORIENTED_EDGE('',*,*,#323,.F.); #443=ORIENTED_EDGE('',*,*,#333,.F.);
#444=EDGE_LOOP('',(#440,#441,#442,#443)); #445=FACE_OUTER_BOUND('',#444,.T.);
#446=ADVANCED_FACE('back',(#445),#243,.T.);
#450=ORIENTED_EDGE('',*,*,#317,.T.); #451=ORIENTED_EDGE('',*,*,#333,.T.);
#452=ORIENTED_EDGE('',*,*,#325,.F.); #453=ORIENTED_EDGE('',*,*,#327,.F.);
#454=EDGE_LOOP('',(#450,#451,#452,#453)); #455=FACE_OUTER_BOUND('',#454,.T.);
#456=ADVANCED_FACE('left',(#455),#254,.F.);
#460=ORIENTED_EDGE('',*,*,#313,.T.); #461=ORIENTED_EDGE('',*,*,#331,.T.);
#462=ORIENTED_EDGE('',*,*,#321,.F.); #463=ORIENTED_EDGE('',*,*,#329,.F.);
#464=EDGE_LOOP('',(#460,#461,#462,#463)); #465=FACE_OUTER_BOUND('',#464,.T.);
#466=ADVANCED_FACE('right',(#465),#263,.T.);
/* Shell with 7 faces: standard 6 + an overlay covering bottom quadrant.
   The overlay's edges aren't shared with the rest of the shell, so each
   appears with degree 2 within the overlay's own loop only. The shell
   is technically a non-manifold but kernels often accept and yield a
   COMPOUND of two SHELLs internally. */
#500=OPEN_SHELL('overlapping_skin',(#406,#423,#416,#436,#446,#456,#466));
#510=SHELL_BASED_SURFACE_MODEL('cube_with_overlay',(#500));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Ps006','Ps006','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#510),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
