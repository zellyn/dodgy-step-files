ISO-10303-21;
/* Tsh221 - ShapeFix_Shell.Perform context_null_initialize
 * Defect: Multiple Perform() calls reuse stale context; accumulated
 * reshape operations apply twice, causing double-fixing of same geometry. */
HEADER;
FILE_DESCRIPTION(('Tsh221 - context null initialize','2;1');
FILE_NAME('Tsh221.stp','2026-06-16T00:00:00',(''),(''),'wave-68B','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);

/* Simple two-face shell with orientation issues */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('',(1.0,1.0,0.0));
#103=CARTESIAN_POINT('',(0.0,1.0,0.0));
#104=CARTESIAN_POINT('',(1.0,0.0,1.0));
#105=CARTESIAN_POINT('',(1.0,1.0,1.0));

#110=VERTEX_POINT('',#100);
#111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102);
#113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104);
#115=VERTEX_POINT('',#105);

/* Plane Z=0 */
#200=DIRECTION('',(0.0,0.0,1.0));
#201=DIRECTION('',(1.0,0.0,0.0));
#210=CARTESIAN_POINT('',(0.5,0.5,0.0));
#211=AXIS2_PLACEMENT_3D('',#210,#200,#201);
#212=PLANE('',#211);

/* Plane Y=1 */
#220=DIRECTION('',(0.0,1.0,0.0));
#221=DIRECTION('',(1.0,0.0,0.0));
#230=CARTESIAN_POINT('',(0.5,0.5,1.0));
#231=AXIS2_PLACEMENT_3D('',#230,#220,#221);
#232=PLANE('',#231);

/* Bottom face edges */
#300=DIRECTION('',(1.0,0.0,0.0));
#301=VECTOR('',#300,1.0);
#310=LINE('',#100,#301);
#311=EDGE_CURVE('',#110,#111,#310,.T.);

#302=DIRECTION('',(0.0,1.0,0.0));
#303=VECTOR('',#302,1.0);
#312=LINE('',#101,#303);
#313=EDGE_CURVE('',#111,#112,#312,.T.);

#304=DIRECTION('',(-1.0,0.0,0.0));
#305=VECTOR('',#304,1.0);
#314=LINE('',#102,#305);
#315=EDGE_CURVE('',#112,#113,#314,.T.);

#306=DIRECTION('',(0.0,-1.0,0.0));
#307=VECTOR('',#306,1.0);
#316=LINE('',#103,#307);
#317=EDGE_CURVE('',#113,#110,#316,.T.);

/* Right face edges: shares edge 1-2 with bottom */
#318=DIRECTION('',(0.0,0.0,1.0));
#319=VECTOR('',#318,1.0);
#320=LINE('',#111,#319);
#321=EDGE_CURVE('',#111,#114,#320,.T.);

#322=DIRECTION('',(0.0,1.0,0.0));
#323=VECTOR('',#322,1.0);
#324=LINE('',#104,#323);
#325=EDGE_CURVE('',#114,#115,#324,.T.);

#326=DIRECTION('',(0.0,0.0,-1.0));
#327=VECTOR('',#326,1.0);
#328=LINE('',#115,#327);
#329=EDGE_CURVE('',#115,#112,#328,.T.);

/* Bottom face (outward normal -Z, wrongly oriented) */
#400=ORIENTED_EDGE('',*,*,#311,.F.);
#401=ORIENTED_EDGE('',*,*,#317,.F.);
#402=ORIENTED_EDGE('',*,*,#315,.F.);
#403=ORIENTED_EDGE('',*,*,#313,.F.);
#410=EDGE_LOOP('',(#400,#401,#402,#403));
#420=FACE_OUTER_BOUND('',#410,.T.);
#430=ADVANCED_FACE('',(#420),#212,.F.);

/* Right face (outward normal +X, wrongly oriented) */
#440=ORIENTED_EDGE('',*,*,#313,.F.);
#441=ORIENTED_EDGE('',*,*,#321,.T.);
#442=ORIENTED_EDGE('',*,*,#325,.T.);
#443=ORIENTED_EDGE('',*,*,#329,.T.);
#450=EDGE_LOOP('',(#440,#441,#442,#443));
#460=FACE_OUTER_BOUND('',#450,.T.);
#470=ADVANCED_FACE('',(#460),#232,.F.);

/* Shell with orientation issues triggering context reuse */
#500=CLOSED_SHELL('context_reuse_shell',(#430,#470));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tsh221','Tsh221','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#500));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
