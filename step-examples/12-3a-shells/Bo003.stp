ISO-10303-21;
/* Bo003 - Two void shells of one solid are nested inside each other.
 * Defect: BREP_WITH_VOIDS lists two void shells where the second
 * (inner_void) is geometrically contained within the first (outer_void).
 * The void hierarchy is malformed - both voids cannot legally describe
 * disjoint cavities. The kernel cannot construct a clean
 * inside/outside classification. */
HEADER;
FILE_DESCRIPTION(('Bo003 - imbricated void shells'),'2;1');
FILE_NAME('Bo003.stp','2026-06-15T00:00:00',(''),(''),'catalog-regen','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
