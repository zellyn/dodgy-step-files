ISO-10303-21;
/* Bo003 - Two void shells of one solid are nested inside each other.
 * Defect: BREP_WITH_VOIDS lists two void shells where the second
 * (#710) is geometrically contained within the first (#510). The
 * void hierarchy is malformed - both voids cannot legally describe
 * disjoint cavities. The kernel cannot construct a clean
 * inside/outside classification. */
HEADER;
FILE_DESCRIPTION(('Bo003 - imbricated void shells','Pass C gap-fill'),'2;1');
FILE_NAME('Bo003.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
