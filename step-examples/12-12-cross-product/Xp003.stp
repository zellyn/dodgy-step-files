ISO-10303-21;
/* Xp003 - Cross-product: sliver face co-located with a 3-faces-share-one-edge
 *   non-manifold junction.
 * Builds on Tfa-sliver-class + Tsh-nonmanifold-class.
 * Defect 1: an edge #100 is referenced by three ADVANCED_FACEs in one
 *   OPEN_SHELL - non-manifold.
 * Defect 2: face C is a sliver - its outer wire has two near-coincident
 *   edges (start/end vertices differ by 1e-4 in y). */
HEADER;
FILE_DESCRIPTION(('Xp003 cross-product','sliver face x non-manifold edge'),'2;1');
FILE_NAME('Xp003.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Common planar surface */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
/* Common edge endpoints */
#20=CARTESIAN_POINT('S',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('E',(1.0,0.0,0.0));
#22=VERTEX_POINT('',#20);
#23=VERTEX_POINT('',#21);
#24=DIRECTION('',(1.0,0.0,0.0));
#25=VECTOR('',#24,1.0);
#26=LINE('',#20,#25);
/* Defect 1: ONE shared EDGE_CURVE referenced by three faces */
#100=EDGE_CURVE('',#22,#23,#26,.T.);
/* Auxiliary vertices and edges to close each face's wire */
#110=CARTESIAN_POINT('A',(0.0,1.0,0.0));
#111=CARTESIAN_POINT('B',(1.0,1.0,0.0));
#112=VERTEX_POINT('',#110);
#113=VERTEX_POINT('',#111);
#114=DIRECTION('',(0.0,1.0,0.0));
#115=VECTOR('',#114,1.0);
#116=LINE('',#20,#115);
#117=DIRECTION('',(-1.0,0.0,0.0));
#118=VECTOR('',#117,1.0);
#119=LINE('',#111,#118);
#120=DIRECTION('',(0.0,-1.0,0.0));
#121=VECTOR('',#120,1.0);
#122=LINE('',#21,#121);
/* Wait, the second face direction is from B back to A, then A back to S */
#130=EDGE_CURVE('',#22,#112,#116,.T.);  /* S -> A */
#131=EDGE_CURVE('',#112,#113,#26,.T.);  /* A -> B (use a parallel line) */
#132=EDGE_CURVE('',#113,#23,#122,.T.);  /* B -> E */
/* Face A (above the shared edge, going up) */
#140=ORIENTED_EDGE('',*,*,#100,.T.);
#141=ORIENTED_EDGE('',*,*,#132,.F.);
#142=ORIENTED_EDGE('',*,*,#131,.F.);
#143=ORIENTED_EDGE('',*,*,#130,.F.);
#150=EDGE_LOOP('A',(#140,#141,#142,#143));
#151=FACE_OUTER_BOUND('',#150,.T.);
#152=ADVANCED_FACE('faceA',(#151),#14,.T.);
/* Face B (below the shared edge, going down) */
#160=CARTESIAN_POINT('Cd',(0.0,-1.0,0.0));
#161=CARTESIAN_POINT('Dd',(1.0,-1.0,0.0));
#162=VERTEX_POINT('',#160);
#163=VERTEX_POINT('',#161);
#164=DIRECTION('',(0.0,-1.0,0.0));
#165=VECTOR('',#164,1.0);
#166=LINE('',#20,#165);
#167=DIRECTION('',(0.0,1.0,0.0));
#168=VECTOR('',#167,1.0);
#169=LINE('',#161,#168);
#170=EDGE_CURVE('',#22,#162,#166,.T.);
#171=EDGE_CURVE('',#162,#163,#26,.T.);
#172=EDGE_CURVE('',#163,#23,#169,.T.);
#180=ORIENTED_EDGE('',*,*,#100,.F.);
#181=ORIENTED_EDGE('',*,*,#170,.T.);
#182=ORIENTED_EDGE('',*,*,#171,.T.);
#183=ORIENTED_EDGE('',*,*,#172,.T.);
#190=EDGE_LOOP('B',(#180,#181,#182,#183));
#191=FACE_OUTER_BOUND('',#190,.T.);
#192=ADVANCED_FACE('faceB',(#191),#14,.T.);
/* Defect 2: Face C is a sliver - it shares edge #100 and has another edge
 *   whose endpoints are within 1e-4 of #100's endpoints. */
#200=CARTESIAN_POINT('Ss',(0.0,0.0001,0.0));
#201=CARTESIAN_POINT('Es',(1.0,0.0001,0.0));
#202=VERTEX_POINT('',#200);
#203=VERTEX_POINT('',#201);
#204=LINE('',#200,#25);
#205=EDGE_CURVE('',#202,#203,#204,.T.);
#206=DIRECTION('',(0.0,1.0,0.0));
#207=VECTOR('',#206,0.0001);
#208=LINE('',#20,#207);
#209=EDGE_CURVE('',#22,#202,#208,.T.);
#210=LINE('',#21,#207);
#211=EDGE_CURVE('',#23,#203,#210,.T.);
#220=ORIENTED_EDGE('',*,*,#100,.T.);
#221=ORIENTED_EDGE('',*,*,#211,.T.);
#222=ORIENTED_EDGE('',*,*,#205,.F.);
#223=ORIENTED_EDGE('',*,*,#209,.F.);
#230=EDGE_LOOP('C',(#220,#221,#222,#223));
#231=FACE_OUTER_BOUND('',#230,.T.);
#232=ADVANCED_FACE('faceC_sliver',(#231),#14,.T.);
/* Defect 1 final: shell with three faces all touching #100 */
#300=OPEN_SHELL('',(#152,#192,#232));
ENDSEC;
END-ISO-10303-21;
