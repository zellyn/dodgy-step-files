ISO-10303-21;
/* Xp027 - Cross-product: Inventor STEP import "stuck at 95%" - long
 *   filename / network path embedded in FILE_NAME header overruns the
 *   importer's path buffer.
 * Source: Autodesk KB "A STEP file that gets stuck at 95 percent when
 *   attempting to import into Inventor"; Inventor forum 10165651 "STEP
 *   File import stuck at 95%".
 * Defect: FILE_NAME first arg holds a 350-char path. Receivers that
 *   pre-allocate MAX_PATH (260 on Windows) for header parsing either hang
 *   re-walking the buffer or allocate excessive memory; Autodesk's
 *   workaround is to copy the file to C:\Temp first.  Note: the path is
 *   metadata, not a file-system access - the importer should not
 *   resolve it. */
HEADER;
FILE_DESCRIPTION(('Xp027 cross-product','Inventor stuck-at-95% long filename'),'2;1');
FILE_NAME('Xp027.stp','2026-05-02T00:00:00',('\\\\corp.example.com\\engineering\\projects\\very-long-project-name-that-overflows-MAX_PATH\\subassembly-revision-2026-04-30\\generated\\step\\export\\final-iteration-with-suffix-12345-and-padding\\Xp027.stp\\\\corp.example.com\\engineering\\projects\\padding'),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,'tol','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))REPRESENTATION_CONTEXT('','3D'));
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=PLANE('',#23);
#25=ADVANCED_FACE('',(),#24,.T.);
ENDSEC;
END-ISO-10303-21;
