ISO-10303-21;
/* Xp008 - Cross-product: solid with one empty EDGE_LOOP and one face whose
 *   face_geometry is NULL, embedded in an otherwise-valid 6-face cube.
 * Builds on Twi001 (empty EDGE_LOOP) + Tfa001 (NULL face_geometry). */
HEADER;
FILE_DESCRIPTION(('Xp008 cross-product','empty EDGE_LOOP x null face_geometry'),'2;1');
FILE_NAME('Xp008.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Cube vertices */
#10=CARTESIAN_POINT('v0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('v1',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('v2',(1.0,1.0,0.0));
#13=CARTESIAN_POINT('v3',(0.0,1.0,0.0));
#14=CARTESIAN_POINT('v4',(0.0,0.0,1.0));
#15=CARTESIAN_POINT('v5',(1.0,0.0,1.0));
#16=CARTESIAN_POINT('v6',(1.0,1.0,1.0));
#17=CARTESIAN_POINT('v7',(0.0,1.0,1.0));
#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
#22=VERTEX_POINT('',#12);
#23=VERTEX_POINT('',#13);
#24=VERTEX_POINT('',#14);
#25=VERTEX_POINT('',#15);
#26=VERTEX_POINT('',#16);
#27=VERTEX_POINT('',#17);
/* Bottom face: valid */
#30=DIRECTION('',(0.0,0.0,1.0));
#31=DIRECTION('',(1.0,0.0,0.0));
#32=AXIS2_PLACEMENT_3D('',#10,#30,#31);
#33=PLANE('',#32);
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#10,#41);
#43=EDGE_CURVE('',#20,#21,#42,.T.);
#44=DIRECTION('',(0.0,1.0,0.0));
#45=VECTOR('',#44,1.0);
#46=LINE('',#11,#45);
#47=EDGE_CURVE('',#21,#22,#46,.T.);
#48=LINE('',#13,#41);
#49=EDGE_CURVE('',#23,#22,#48,.T.);
#50=LINE('',#10,#45);
#51=EDGE_CURVE('',#20,#23,#50,.T.);
#60=ORIENTED_EDGE('',*,*,#43,.T.);
#61=ORIENTED_EDGE('',*,*,#47,.T.);
#62=ORIENTED_EDGE('',*,*,#49,.F.);
#63=ORIENTED_EDGE('',*,*,#51,.F.);
#70=EDGE_LOOP('bottom',(#60,#61,#62,#63));
#71=FACE_OUTER_BOUND('',#70,.T.);
#72=ADVANCED_FACE('bottom',(#71),#33,.T.);
/* Defect 1: face with empty EDGE_LOOP */
#80=EDGE_LOOP('empty',());
#81=FACE_OUTER_BOUND('',#80,.T.);
#82=ADVANCED_FACE('empty_loop_face',(#81),#33,.T.);
/* Defect 2: face with face_geometry = $ (null) */
#90=ORIENTED_EDGE('',*,*,#43,.T.);
#91=EDGE_LOOP('valid',(#90));
#92=FACE_OUTER_BOUND('',#91,.T.);
#93=ADVANCED_FACE('null_geom_face',(#92),$,.T.);
/* Three further valid faces (top, two sides) - omitted for brevity, just
 *   one more to keep the shell non-trivial */
#100=CARTESIAN_POINT('top_origin',(0.0,0.0,1.0));
#101=AXIS2_PLACEMENT_3D('',#100,#30,#31);
#102=PLANE('',#101);
#103=LINE('',#14,#41);
#104=EDGE_CURVE('',#24,#25,#103,.T.);
#105=ORIENTED_EDGE('',*,*,#104,.T.);
#106=EDGE_LOOP('top',(#105));
#107=FACE_OUTER_BOUND('',#106,.T.);
#108=ADVANCED_FACE('top',(#107),#102,.T.);
#200=OPEN_SHELL('',(#72,#82,#93,#108));
ENDSEC;
END-ISO-10303-21;
