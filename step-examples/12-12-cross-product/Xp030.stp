ISO-10303-21;
/* Xp030 - Cross-product: Inventor's STEP exporter writes Asian (Chinese,
 *   Korean, Japanese) characters as raw GBK / Shift_JIS bytes instead of
 *   ISO 10303-21 \X2\ escapes; receivers that assume ISO-8859-1 or UTF-8
 *   show mojibake.
 * Source: Autodesk KB "STEP files converted in Inventor, do not display
 *   Asian characters as expected such as Korean and Chinese"; Inventor
 *   forum 6686585 "How can I get Inventor to correctly translate Chinese
 *   Character".
 * Defect: PRODUCT.name carries the bytes 0xC3 0xBF 0xC2 0xB7 0xC3 0xA9
 *   (which is what GBK 0xD6 0xD0 "ZH" looks like after a Latin-1 ->
 *   UTF-8 mis-recoding). The intent was Chinese "中文" via \X2\4E2D 6587\X0\
 *   but Inventor wrote raw legacy-codepage bytes without escapes. */
HEADER;
FILE_DESCRIPTION(('Xp030 cross-product','Inventor Asian chars not escaped'),'2;1');
FILE_NAME('Xp030.stp','2026-05-02T00:00:00',(''),(''),'Inventor;2024','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
/* PRODUCT.name has raw legacy-codepage bytes (mojibake on receive) */
#3=PRODUCT('part-Ã¿Â·Ã©','desc-without-X2-escape','',(#4));
#4=PRODUCT_CONTEXT('',#1,'mechanical');
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,'tol','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))REPRESENTATION_CONTEXT('','3D'));
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=PLANE('',#23);
#25=ADVANCED_FACE('',(),#24,.T.);
ENDSEC;
END-ISO-10303-21;
