ISO-10303-21;
/* Xp032 - Cross-product: CATIA V5 R25 STEP export imported into
 *   Inventor / Creo loses the solid - import yields empty PartBody plus
 *   geometric_set entries for every face that failed to recreate.
 * Source: IBM APAR HC90888 "STEP : when importing a STEP file coming
 *   from CATIA V5, the solid is not created"; APAR HD91714 "STEP IMPORT:
 *   STEP FILE IS NOT CORRECTLY IMPORTED IN CATIA V5".
 * Defect: an ADVANCED_FACE references a degenerate B_SPLINE_SURFACE_WITH_KNOTS
 *   whose control-point grid contains a coincident-row degeneracy (row 0
 *   collapses to a single point). CATIA accepts and ignores the
 *   degenerate face; downstream Inventor refuses the face, refuses the
 *   shell, refuses the solid; the result is geometric_set debris. */
HEADER;
FILE_DESCRIPTION(('Xp032 cross-product','CATIA degenerate spline -> Inventor empty solid'),'2;1');
FILE_NAME('Xp032.stp','2026-05-02T00:00:00',(''),(''),'CATIA;V5R25','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,'tol','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))REPRESENTATION_CONTEXT('','3D'));
/* Degenerate B-spline surface: row 0 has all four CPs at the same point. */
#20=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('p0_dup1',(0.0,0.0,0.0));
#22=CARTESIAN_POINT('p0_dup2',(0.0,0.0,0.0));
#23=CARTESIAN_POINT('p0_dup3',(0.0,0.0,0.0));
#30=CARTESIAN_POINT('p1',(1.0,0.0,1.0));
#31=CARTESIAN_POINT('p2',(1.0,1.0,1.0));
#32=CARTESIAN_POINT('p3',(0.0,1.0,1.0));
#33=CARTESIAN_POINT('p4',(0.5,0.5,0.5));
#40=B_SPLINE_SURFACE_WITH_KNOTS('degenerate_row_zero',
  3,3,
  ((#20,#21,#22,#23),(#30,#31,#32,#33)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (4,4),(4,4),
  (0.0,1.0),(0.0,1.0),
  .UNSPECIFIED.);
#50=ADVANCED_FACE('degenerate_face',(),#40,.T.);
ENDSEC;
END-ISO-10303-21;
