ISO-10303-21;
/* Xp033 - Cross-product: NX-emitted STEP file represents a cylindrical
 *   face as multiple ADVANCED_FACE entries split along the seam; CATIA
 *   and SolidWorks complain that the face has been "split" and require
 *   manual "Optimize Face" / heal to merge.
 * Source: PTC Community 977634 "Import STEP created by NX 11"; Engineers
 *   Rule "Import Diagnostic Tool" guide; Eng-Tips 440625 "Problem
 *   importing STEPs from CATIA".
 * Defect: a single 360-degree cylinder is split into two 180-degree
 *   ADVANCED_FACE halves sharing a seam edge. The two halves each have
 *   independent CYLINDRICAL_SURFACE entities with the same axis but
 *   different parameter ranges. Receivers expecting a single periodic
 *   face emit "non-merged cylinder" diagnostics or generate downstream
 *   feature recognition failures (the cylinder no longer reads as a
 *   "hole"). */
HEADER;
FILE_DESCRIPTION(('Xp033 cross-product','NX split-cylinder split-face seam'),'2;1');
FILE_NAME('Xp033.stp','2026-05-02T00:00:00',(''),(''),'NX;1980-EXPORT','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,'tol','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))REPRESENTATION_CONTEXT('','3D'));
/* Same axis used twice */
#20=CARTESIAN_POINT('axis_origin',(0.0,0.0,0.0));
#21=DIRECTION('z',(0.0,0.0,1.0));
#22=DIRECTION('x',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
/* Two cylindrical surfaces, identical axes and radii. NX writes them as
   two distinct entities even though they describe the same surface. */
#30=CYLINDRICAL_SURFACE('cyl_half_A',#23,5.0);
#31=CYLINDRICAL_SURFACE('cyl_half_B_split',#23,5.0);
/* Two ADVANCED_FACE halves split along U=0/PI seam; receiver must heal */
#40=ADVANCED_FACE('cyl_+u_half',(),#30,.T.);
#41=ADVANCED_FACE('cyl_-u_half_split_face',(),#31,.T.);
#50=CLOSED_SHELL('split_cyl_should_be_one_face',(#40,#41));
ENDSEC;
END-ISO-10303-21;
