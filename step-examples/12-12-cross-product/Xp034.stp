ISO-10303-21;
/* Xp034 - Cross-product: CadQuery's STEP exporter pushes assembly
 *   COLOUR_RGB values through an sRGB->linear conversion that the
 *   receiver doesn't reverse, so a (0.5, 0.5, 0.5) middle-gray ends up
 *   as (0.735, 0.735, 0.735) after round-trip.
 * Source: github.com/CadQuery/cadquery issue #794 "Assembly Color
 *   Component Values in Exported STEP File Are Shifted".
 * Defect: COLOUR_RGB carries a value of 0.7353569 for each channel; the
 *   user's intent was a 0.5/0.5/0.5 gray. ISO 10303-46 states colour
 *   values are nominally in the device colour space (typically linear);
 *   a writer doing an sRGB-companding step on export produces this
 *   exact off-by-gamma error. */
HEADER;
FILE_DESCRIPTION(('Xp034 cross-product','CadQuery RGB sRGB-linear shift'),'2;1');
FILE_NAME('Xp034.stp','2026-05-02T00:00:00',(''),(''),'CadQuery;2.4','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,'tol','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))REPRESENTATION_CONTEXT('','3D'));
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=PLANE('',#23);
#25=ADVANCED_FACE('',(),#24,.T.);
/* User asked for middle-gray (0.5, 0.5, 0.5); writer applied sRGB linearisation -> 0.7353569 */
#30=COLOUR_RGB('grey_should_be_0p5_but_was_pushed_through_sRGB',0.7353569830523,0.7353569830523,0.7353569830523);
#31=FILL_AREA_STYLE_COLOUR('',#30);
#32=FILL_AREA_STYLE('',(#31));
#33=SURFACE_STYLE_FILL_AREA(#32);
#34=SURFACE_SIDE_STYLE('',(#33));
#35=SURFACE_STYLE_USAGE(.BOTH.,#34);
#36=PRESENTATION_STYLE_ASSIGNMENT((#35));
#37=STYLED_ITEM('',(#36),#25);
ENDSEC;
END-ISO-10303-21;
