ISO-10303-21;
/* Xp042 - Cross-product: NX-emitted STEP file imported into Onshape
 *   yields "translation errors" because the file uses BOUNDED_CURVE-only
 *   edges rather than the EDGE_CURVE/CURVE pattern that Parasolid expects.
 *   Onshape's translator surfaces a generic translation error rather
 *   than identifying the unsupported curve type.
 * Source: forum.onshape.com discussion 9482 "STEP file translation
 *   errors"; discussion 762 "importing files siemens nx"; discussion
 *   25988 "Step Files Not Translating".
 * Defect: an EDGE uses a TRIMMED_CURVE wrapping a B_SPLINE_CURVE_WITH_KNOTS
 *   whose knot vector contains a multiplicity equal to (degree+1)+1 at
 *   an interior knot (super-multiplicity). NX accepts this; Parasolid
 *   classifies it as a discontinuity and bails. */
HEADER;
FILE_DESCRIPTION(('Xp042 cross-product','NX -> Onshape translation error super-multiplicity'),'2;1');
FILE_NAME('Xp042.stp','2026-05-02T00:00:00',(''),(''),'NX;EXPORT','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,'tol','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))REPRESENTATION_CONTEXT('','3D'));
/* B-spline degree 3 with super-multiplicity on interior knot 0.5 */
#20=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('p1',(1.0,0.0,0.0));
#22=CARTESIAN_POINT('p2',(2.0,1.0,0.0));
#23=CARTESIAN_POINT('p3',(3.0,1.0,0.0));
#24=CARTESIAN_POINT('p4',(4.0,2.0,0.0));
#25=CARTESIAN_POINT('p5',(5.0,2.0,0.0));
#26=CARTESIAN_POINT('p6',(6.0,3.0,0.0));
#27=CARTESIAN_POINT('p7',(7.0,3.0,0.0));
/* Multiplicity 5 (degree+1+1) on interior knot - illegal */
#30=B_SPLINE_CURVE_WITH_KNOTS('super_mult_at_0p5',
  3,
  (#20,#21,#22,#23,#24,#25,#26,#27),
  .UNSPECIFIED.,.F.,.F.,
  (4,5,4),
  (0.0,0.5,1.0),
  .UNSPECIFIED.);
#40=VERTEX_POINT('',#20);
#41=VERTEX_POINT('',#27);
#42=EDGE_CURVE('translation_error',#40,#41,#30,.T.);
ENDSEC;
END-ISO-10303-21;
