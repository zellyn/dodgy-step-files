ISO-10303-21;
/* Xp044 - Cross-product: PCB-CAD export from KiCad/Altium - some 3D
 *   models go missing entirely from the exported STEP, others render
 *   with "donut" artefacts (extra revolute surfaces fused to the pin).
 * Source: forum.kicad.info t/30144 "Exporting step file some parts
 *   broken"; t/12588 "Why some 3D components are missing from Step file
 *   export?"; t/27615 "Exporting step files fails for some components".
 * Defect: a child PRODUCT_DEFINITION has its SDR pointing at a
 *   SHAPE_REPRESENTATION whose items list is empty (zero geometry).
 *   The MAPPED_ITEM that should reproduce the component instead points
 *   to an unrelated mapping_target, so the component renders the wrong
 *   geometry (a different package's pin model). */
HEADER;
FILE_DESCRIPTION(('Xp044 cross-product','KiCad PCB STEP missing/swapped components'),'2;1');
FILE_NAME('Xp044.stp','2026-05-02T00:00:00',(''),(''),'KiCad;PcbNew','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,'tol','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))REPRESENTATION_CONTEXT('','3D'));
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
/* Component A: empty geometry - "missing" on receive */
#30=PRODUCT('R0805','R0805','',(#21));
#31=PRODUCT_CONTEXT('',#1,'mechanical');
#32=PRODUCT_DEFINITION_FORMATION('','',#30);
#33=PRODUCT_DEFINITION('','',#32,#34);
#34=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#35=PRODUCT_DEFINITION_SHAPE('','',#33);
#36=SHAPE_REPRESENTATION('R0805_empty_items',(),#14);
#37=SHAPE_DEFINITION_REPRESENTATION(#35,#36);
/* Component B: "TO-220" but MAPPED_ITEM points to TO-252 mapping */
#40=PRODUCT('TO-220','TO-220','',(#21));
#41=PRODUCT_DEFINITION_FORMATION('','',#40);
#42=PRODUCT_DEFINITION('','',#41,#34);
#43=PRODUCT_DEFINITION_SHAPE('','',#42);
#50=PLANE('',#23);
#51=ADVANCED_FACE('TO-252_pin_geometry',(),#50,.T.);
#52=REPRESENTATION_MAP(#23,#53);
#53=SHAPE_REPRESENTATION('TO-252_pin_should_be_TO-220',(#51),#14);
#54=MAPPED_ITEM('wrong_mapping_target_swap',#52,#23);
#55=SHAPE_REPRESENTATION('TO-220_uses_TO-252_pin',(#54),#14);
#56=SHAPE_DEFINITION_REPRESENTATION(#43,#55);
ENDSEC;
END-ISO-10303-21;
