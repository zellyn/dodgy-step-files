ISO-10303-21;
/* Xp002 - Cross-product: periodic-surface seam gap + missing pcurve +
 *   unit-context magnitude disagreement.
 * Builds on Twi-XX (UV seam shift) + Gp001 (missing pcurve) + U001
 *   (unit-vs-magnitude mismatch).
 * Defect 1: face on a closed CYLINDRICAL_SURFACE; the wire's 3D endpoints
 *   meet, but UV pcurves (if they existed) would differ by 2pi - the
 *   wire is open in UV.
 * Defect 2: SURFACE_CURVE.associated_geometry is empty (no PCURVE).
 * Defect 3: GEOMETRIC_REPRESENTATION_CONTEXT declares mm but coordinates
 *   are sized for inch authorship (radius emitted as 25.4). */
HEADER;
FILE_DESCRIPTION(('Xp002 cross-product','periodic seam x missing pcurve x unit mismatch'),'2;1');
FILE_NAME('Xp002.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Defect 3: declared mm */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-6),#10,'distance_accuracy_value','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
     REPRESENTATION_CONTEXT('part','3D'));
/* Defect 3 continued: radius 25.4 = 1 inch but tagged as mm */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=CYLINDRICAL_SURFACE('',#23,25.4);
/* Two vertices on the cylinder at angles 0 and 0 (same 3D point but two ends) */
#30=CARTESIAN_POINT('',(25.4,0.0,0.0));
#31=CARTESIAN_POINT('',(25.4,0.0,10.0));
#32=VERTEX_POINT('',#30);
#33=VERTEX_POINT('',#31);
/* 3D curves: vertical line at u=0 and u=2pi (same 3D ray) */
#40=DIRECTION('',(0.0,0.0,1.0));
#41=VECTOR('',#40,10.0);
#42=LINE('',#30,#41);
#43=LINE('',#31,#41);
/* SURFACE_CURVEs with EMPTY associated_geometry - Defect 2 */
#50=SURFACE_CURVE('',#42,(),.PCURVE_S1.);
#51=SURFACE_CURVE('',#43,(),.PCURVE_S1.);
#60=EDGE_CURVE('',#32,#33,#50,.T.);
#61=EDGE_CURVE('',#33,#32,#51,.T.);
/* Defect 1: 3D wire is closed (V-Z-V'-V back to start), but UV pcurves
 *   would run at u=0 forward then u=2pi backward - open in UV. */
#70=ORIENTED_EDGE('',*,*,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#61,.T.);
#80=EDGE_LOOP('',(#70,#71));
#81=FACE_OUTER_BOUND('',#80,.T.);
#82=ADVANCED_FACE('cyl_face',(#81),#24,.T.);
#90=SHAPE_REPRESENTATION('',(#82),#14);
ENDSEC;
END-ISO-10303-21;
