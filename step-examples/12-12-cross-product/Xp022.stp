ISO-10303-21;
/* Xp022 - Cross-product: torus with negative major_radius, seam edge whose
 *   3D length is exactly 1e-7 (kernel-precision boundary), seam edge
 *   appearing twice in the wire (cycle).
 * Builds on N001 (tolerance hierarchy/boundary) + Gs001 (negative torus
 *   radius) + Twi-seam-cycle-class. */
HEADER;
FILE_DESCRIPTION(('Xp022 cross-product','tolerance boundary x negative-torus x cyclic seam'),'2;1');
FILE_NAME('Xp022.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Defect 1: negative major_radius */
#14=TOROIDAL_SURFACE('',#13,-10.0,1.0);
/* Defect 2: seam edge endpoints differ by exactly 1e-7 - tolerance boundary */
#20=CARTESIAN_POINT('s_a',(11.0,0.0,0.0));
#21=CARTESIAN_POINT('s_b',(11.0,1.0E-7,0.0));
#22=VERTEX_POINT('',#20);
#23=VERTEX_POINT('',#21);
#24=DIRECTION('',(0.0,1.0,0.0));
#25=VECTOR('',#24,1.0E-7);
#26=LINE('',#20,#25);
#27=EDGE_CURVE('seam',#22,#23,#26,.T.);
/* Other edge (longer path back to close the loop) */
#30=CARTESIAN_POINT('o_a',(11.0,1.0E-7,0.0));
#31=CARTESIAN_POINT('o_b',(11.0,0.0,0.0));
#32=DIRECTION('',(0.0,-1.0,0.0));
#33=VECTOR('',#32,1.0E-7);
#34=LINE('',#30,#33);
#35=EDGE_CURVE('other',#23,#22,#34,.T.);
/* Defect 3: seam edge appears twice (forward and reverse) in the same loop */
#40=ORIENTED_EDGE('',*,*,#27,.T.);
#41=ORIENTED_EDGE('',*,*,#35,.T.);
#42=ORIENTED_EDGE('',*,*,#27,.F.);
#43=ORIENTED_EDGE('',*,*,#35,.F.);
#50=EDGE_LOOP('seam_cycle',(#40,#41,#42,#43));
#51=FACE_OUTER_BOUND('',#50,.T.);
#52=ADVANCED_FACE('torus_face',(#51),#14,.T.);
ENDSEC;
END-ISO-10303-21;
