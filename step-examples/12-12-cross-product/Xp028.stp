ISO-10303-21;
/* Xp028 - Cross-product: Onshape "imported as one Surface" - source
 *   STEP carries an OPEN_SHELL with a missing face such that the body
 *   can never close to a solid. Onshape (Parasolid) imports it as a
 *   surface body and refuses to insert it into an assembly because
 *   surfaces aren't valid assembly children.
 * Source: forum.onshape.com discussion 11228 "Importing .stp/.step
 *   file appears only as one Surface"; forum.onshape.com discussion
 *   6478 "Imported STEP shape is just surfaces". Autodesk Fusion KB
 *   "Stitch groups surface bodies but no solid is created in Fusion 360".
 * Defect: a 6-face cube has only 5 ADVANCED_FACE entries (the +Z lid
 *   face is missing). The shell wraps the existing five into an
 *   OPEN_SHELL; receivers either silently load it as a surface body or
 *   reject because no MANIFOLD_SOLID_BREP can be derived. */
HEADER;
FILE_DESCRIPTION(('Xp028 cross-product','imports as surface body 5/6 faces'),'2;1');
FILE_NAME('Xp028.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,'tol','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))REPRESENTATION_CONTEXT('','3D'));
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=PLANE('',#23);
/* Five ADVANCED_FACE entries - top lid (+Z) is missing! */
#30=ADVANCED_FACE('cube_-z_bottom',(),#24,.T.);
#31=ADVANCED_FACE('cube_+x',(),#24,.T.);
#32=ADVANCED_FACE('cube_-x',(),#24,.T.);
#33=ADVANCED_FACE('cube_+y',(),#24,.T.);
#34=ADVANCED_FACE('cube_-y',(),#24,.T.);
/* MISSING_LID_FACE - body cannot close: forced into OPEN_SHELL */
#40=OPEN_SHELL('cube_missing_top_face',(#30,#31,#32,#33,#34));
#50=SHELL_BASED_SURFACE_MODEL('imports_as_surface_body',(#40));
ENDSEC;
END-ISO-10303-21;
