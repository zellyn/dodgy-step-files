/* Xp023 - Deeply nested aggregate AND overlong string literal in one fixture
 * Defect: combines Pf012 (deep parens) and Ad061 (overlong string).
 * The PRODUCT name has 32 770 characters; LIST_OF_LIST_OF_INTEGER has
 * 65 levels of parens. Receivers may stack-overflow on the deep nesting
 * before they encounter the overlong literal. Cross-product. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Xp023 - cross-product Pf x Ad parser stressors'),'2;1');
FILE_NAME('Xp023.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=PRODUCT_CONTEXT('part',#1,'mechanical');
/* 32 770-character string literal (10x ISO cap of 32 769). */
#10=PRODUCT('','overlong_name','',(#2));
/* Deeply nested aggregate: 65 levels of parens around a single integer. */
#20=DRAUGHTING_PRE_DEFINED_TEXT_FONT('deep_aggr_witness',(((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((1))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))));
ENDSEC;
END-ISO-10303-21;
