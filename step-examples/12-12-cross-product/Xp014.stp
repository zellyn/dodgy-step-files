ISO-10303-21;
/* Xp014 - Cross-product: MANIFOLD_SOLID_BREP whose outer is OPEN_SHELL,
 *   tolerance hierarchy inverted, and unit context disagreeing with
 *   coordinate magnitude.
 * Builds on Tsh001 + N001 + U005.
 * Defect 1: MANIFOLD_SOLID_BREP outer slot references OPEN_SHELL.
 * Defect 2: tolerance hierarchy inverted -- vertex tolerance (1e-2 mm)
 *   is GREATER than edge tolerance (1e-4 mm) which is GREATER than
 *   surface tolerance (1e-6 mm). Hierarchy must be tight->loose
 *   (surface < edge < vertex was correct, but here the producer wrote
 *   the hierarchy upside-down). Encoded via three UNCERTAINTY
 *   measures with distinct discriminator strings. */
HEADER;
FILE_DESCRIPTION(('Xp014 cross-product','open-shell-as-outer x tolerance x unit'),'2;1');
FILE_NAME('Xp014.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Defect 3: declared mm but coordinates are 1000x too small (metres) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Defect 2: tolerance hierarchy inverted.
 *   Surface tolerance smallest (correct), edge tolerance medium (wrong:
 *   should be looser than surface), vertex tolerance largest (wrong:
 *   should be tightest of the three). Producer flipped the hierarchy. */
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,
  'distance_accuracy_value','surface_tol');
#14=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-4),#10,
  'distance_accuracy_value','edge_tol_GT_surface_tol_INVERTED');
#15=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-2),#10,
  'distance_accuracy_value','vertex_tol_GT_edge_tol_INVERTED');
#16=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13,#14,#15))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
     REPRESENTATION_CONTEXT('part','3D'));
/* Coordinates in 0.001 range (i.e. authored in metres, declared as mm) */
#20=CARTESIAN_POINT('v0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('v1',(0.001,0.0,0.0));
#22=VERTEX_POINT('',#20);
#23=VERTEX_POINT('',#21);
#24=DIRECTION('',(1.0,0.0,0.0));
#25=VECTOR('',#24,0.001);
#26=LINE('',#20,#25);
#27=EDGE_CURVE('',#22,#23,#26,.T.);
#28=ORIENTED_EDGE('',*,*,#27,.T.);
#29=EDGE_LOOP('',(#28));
#30=FACE_OUTER_BOUND('',#29,.T.);
#31=DIRECTION('',(0.0,0.0,1.0));
#32=AXIS2_PLACEMENT_3D('',#20,#31,#24);
#33=PLANE('',#32);
#34=ADVANCED_FACE('',(#30),#33,.T.);
/* Defect 1: outer slot of MANIFOLD_SOLID_BREP references OPEN_SHELL */
#40=OPEN_SHELL('open',(#34));
#50=MANIFOLD_SOLID_BREP('msb_with_open_outer',#40);
ENDSEC;
END-ISO-10303-21;
