ISO-10303-21;
/* Gp002 - Wrong pcurve that does not match vertices (FixRemovePCurve)
 * Defect: pcurve evaluated at endpoints lifts to UV (0, 0) and (pi/2, 5),
 * but vertex 3D coordinates correspond to UV (0, 0) and (0, 5) on the
 * cylindrical surface. Pcurve and vertex positions are inconsistent. */
HEADER;
FILE_DESCRIPTION(('Gp002 test case','Wrong pcurve that does not match vertices'),'2;1');
FILE_NAME('Gp002.stp','2026-04-27T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=CYLINDRICAL_SURFACE('',#13,10.0);
/* 3D curve: line from (10,0,0) to (10,0,5) - cylinder generator at U=0 */
#30=CARTESIAN_POINT('',(10.0,0.0,0.0));
#31=DIRECTION('',(0.0,0.0,1.0));
#32=VECTOR('',#31,1.0);
#33=LINE('',#30,#32);
/* Vertices are at U=0 on the cylinder */
#40=CARTESIAN_POINT('',(10.0,0.0,0.0));
#41=VERTEX_POINT('',#40);
#42=CARTESIAN_POINT('',(10.0,0.0,5.0));
#43=VERTEX_POINT('',#42);
/* Defect: pcurve runs from (U=0,V=0) to (U=pi/2, V=5)
 * but vertices are at U=0 - end of pcurve maps to (0,10,5), not (10,0,5) */
#70=DEFINITIONAL_REPRESENTATION('',(#74),#75);
#71=CARTESIAN_POINT('',(0.0,0.0));
#72=DIRECTION('',(0.31415926535,1.0));
#73=VECTOR('',#72,1.0);
#74=LINE('',#71,#73);
#75=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#76=PCURVE('',#20,#70);
#50=SURFACE_CURVE('',#33,(#76),.PCURVE_S1.);
#60=EDGE_CURVE('',#41,#43,#50,.T.);
#61=ORIENTED_EDGE('',*,*,#60,.T.);
#62=EDGE_LOOP('',(#61));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#20,.T.);
ENDSEC;
