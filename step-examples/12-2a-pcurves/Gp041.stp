ISO-10303-21;
/* Gp041 - ShapeAnalysis_Edge.CheckCurve3dWithPCurve sample-point divergence
 * Defect: edge has both 3D curve and PCURVE but their midspan points diverge
 * by > tolerance. The 3D curve is a LINE from (0,0,0) to (10,0,0) with
 * midpoint at (5,0,0). The PCURVE is a B-spline on a PLANE that maps to
 * (5.1,0,0) at parameter 0.5 — a 0.1 mm divergence that exceeds typical
 * edge tolerance. CheckCurve3dWithPCurve compares sample points and should
 * flag this mismatch as a healing candidate. */
HEADER;
FILE_DESCRIPTION(('Gp041 test case','CheckCurve3dWithPCurve sample-point divergence'),'2;1');
FILE_NAME('Gp041.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#4=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#5=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#6=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#3,'distance_accuracy_value','edge tolerance');
#7=( GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#6))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#3,#4,#5))
     REPRESENTATION_CONTEXT('','3D') );
/* Host plane */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
/* 3D curve: straight line from (0,0,0) to (10,0,0) */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(1.0,0.0,0.0));
#22=VECTOR('',#21,1.0);
#23=LINE('line_3d',#20,#22);
/* Vertices */
#30=VERTEX_POINT('',(0.0,0.0,0.0));
#31=CARTESIAN_POINT('',(10.0,0.0,0.0));
#32=VERTEX_POINT('',#31);
/* Defective PCURVE: B-spline that deviates 0.1 mm at midspan (u=5 -> v=0.1) */
#40=CARTESIAN_POINT('',(0.0,0.0));
#41=CARTESIAN_POINT('',(2.5,0.02));
#42=CARTESIAN_POINT('',(5.1,0.0));
#43=CARTESIAN_POINT('',(7.5,-0.02));
#44=CARTESIAN_POINT('',(10.0,0.0));
#50=B_SPLINE_CURVE_WITH_KNOTS('',2,(#40,#41,#42,#43,#44),
  .UNSPECIFIED.,.F.,.F.,
  (3,1,1,3),(0.0,0.333,0.667,1.0),.UNSPECIFIED.);
#51=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#52=DEFINITIONAL_REPRESENTATION('',(#50),#51);
#53=PCURVE('pcurve_diverge',#14,#52);
/* SURFACE_CURVE with both 3D curve and mismatched PCURVE */
#60=SURFACE_CURVE('edge_with_divergence',#23,(#53),.PCURVE_S1.);
#70=EDGE_CURVE('edge_gp041',#30,#32,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#70,.T.);
#72=EDGE_LOOP('',(#71));
#73=FACE_OUTER_BOUND('',#72,.T.);
#74=ADVANCED_FACE('',(#73),#14,.T.);
#90=SHAPE_REPRESENTATION('Gp041',(#13,#74),#7);
/* Wrap: PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gp041','Gp041','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#74));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
