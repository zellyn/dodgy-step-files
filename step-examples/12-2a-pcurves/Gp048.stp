ISO-10303-21;
/* Gp048: CONICAL_SURFACE (apex at origin, axis Z, half-angle 30 deg); edge from apex (0,0,0) to (0,0,5) runs up the cone generator at u=0; pcurve degenerates to line u=0, v in [0,5] on the cone — the cone's surface map is singular at v=0 (apex); FixAddPCurve must produce a valid degenerate pcurve rather than skipping or crashing */
HEADER;
FILE_DESCRIPTION(('Gp048'),'2;1');
