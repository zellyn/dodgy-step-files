ISO-10303-21;
/* Gp023 - ValueOfUV returns UV outside trimmed face range
 * Defect: a face on a CYLINDRICAL_SURFACE (full periodic) is trimmed
 * to U in [pi, 2pi] only. A 3D point above the face has two valid
 * pre-images (one near U=0, one near U=2pi); naive projection returns
 * U=0.001 - outside the trimmed range, even though U=2*pi-0.001 is in.
 *
 * Fix vs prior: pcurve LINE direction-vector magnitude was 1.0 which
 * only covered [pi, pi+1]. We now wrap the pcurve LINE in a
 * TRIMMED_CURVE with explicit trim parameters [0.0, pi] so the U-band
 * the edge sweeps in 2D is exactly [pi, 2pi]. */
HEADER;
FILE_DESCRIPTION(('Gp023 test case','ValueOfUV returns UV outside trimmed range'),'2;1');
FILE_NAME('Gp023.stp','2026-04-27T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=CYLINDRICAL_SURFACE('',#13,10.0);
/* Outer wire vertices: two on the bottom (V=0), two on the top (V=5) */
#40=CARTESIAN_POINT('',(-10.0,0.0,0.0));
#41=VERTEX_POINT('',#40);
#42=CARTESIAN_POINT('',(10.0,0.0,0.0));
#43=VERTEX_POINT('',#42);
#44=CARTESIAN_POINT('',(-10.0,0.0,5.0));
#45=VERTEX_POINT('',#44);
#46=CARTESIAN_POINT('',(10.0,0.0,5.0));
#47=VERTEX_POINT('',#46);
/* 3D circle for the bottom edge, used as the SURFACE_CURVE 3D-curve */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=DIRECTION('',(0.0,0.0,1.0));
#32=DIRECTION('',(-1.0,0.0,0.0));
#33=AXIS2_PLACEMENT_3D('',#30,#31,#32);
#34=CIRCLE('',#33,10.0);
/* 2D pcurve: a LINE through (pi, 0) along +U.
 * Direction vector magnitude was 1.0 (defect) — corrected to PI so
 * the LINE's natural parametric extent over [0,1] would still be 1
 * unit; we therefore additionally wrap in a TRIMMED_CURVE with
 * trim parameters [0.0, PI] giving an explicit 2D-domain U sweep
 * of length PI starting at U=PI (i.e. covering [pi, 2pi]). */
#71=CARTESIAN_POINT('',(3.14159265358979,0.0));
#72=DIRECTION('',(1.0,0.0));
#73=VECTOR('',#72,3.14159265358979);
#74=LINE('',#71,#73);
#78=PARAMETER_VALUE(0.0);
#79=PARAMETER_VALUE(3.14159265358979);
#84=TRIMMED_CURVE('',#74,(#78),(#79),.T.,.PARAMETER.);
#75=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#76=DEFINITIONAL_REPRESENTATION('',(#84),#75);
#77=PCURVE('',#20,#76);
#50=SURFACE_CURVE('',#34,(#77),.PCURVE_S1.);
#60=EDGE_CURVE('',#41,#43,#50,.T.);
/* For brevity only the bottom edge is fully built. The face's UV
 * range is pinned by the pcurve TRIMMED_CURVE domain [pi, 2pi].
 * ValueOfUV must respect this when projecting 3D points. */
#61=ORIENTED_EDGE('',*,*,#60,.T.);
#62=EDGE_LOOP('',(#61));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#20,.T.);
ENDSEC;
END-ISO-10303-21;
