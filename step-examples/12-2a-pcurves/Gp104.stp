     GLOBAL_UNIT_ASSIGNED_CONTEXT((#3,#4,#5))
     REPRESENTATION_CONTEXT('','3D') );
/* Plane surface */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('plane',#13);
/* Base 3D curve: B-spline */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(1.0,0.0,0.0));
#22=DIRECTION('',(0.0,1.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#22,#21);
#24=B_SPLINE_CURVE_WITH_KNOTS('base_curve',.UNSPECIFIED.,.F.,.F.,
  ((#30,#31,#32,#33)),#23,
  2,
  (0.0,0.33,0.67,1.0),
  (0.0,0.33,0.67,1.0),
  .UNSPECIFIED.);
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=CARTESIAN_POINT('',(1.0,0.5,0.0));
#32=CARTESIAN_POINT('',(2.0,1.0,0.0));
#33=CARTESIAN_POINT('',(3.0,0.5,0.0));
/* OFFSET_CURVE: offset by 0.2 from base curve */
#40=OFFSET_CURVE_3D('offset_curve',#24,0.2,1.0,.APPROXIMATE.);
/* Vertices */
#50=VERTEX_POINT('',(0.0,0.0,0.0));
#51=CARTESIAN_POINT('',(3.0,0.5,0.0));
#52=VERTEX_POINT('',#51);
/* PCURVE: B-spline in 2D corresponding to base curve, not offset */
#60=CARTESIAN_POINT('',(0.0,0.0));
#61=DIRECTION('',(1.0,0.0));
#62=DIRECTION('',(0.0,1.0));
#63=AXIS2_PLACEMENT_2D('',#60,#61);
#64=B_SPLINE_CURVE_WITH_KNOTS('pcurve_offset',.UNSPECIFIED.,.F.,.F.,
  ((#70,#71,#72,#73)),#63,
  2,
  (0.0,0.33,0.67,1.0),
  (0.0,0.33,0.67,1.0),
  .UNSPECIFIED.);
#70=CARTESIAN_POINT('',(0.0,0.0));
#71=CARTESIAN_POINT('',(1.0,0.5));
#72=CARTESIAN_POINT('',(2.0,1.0));
#73=CARTESIAN_POINT('',(3.0,0.5));
/* PCURVE definition */
#75=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#76=DEFINITIONAL_REPRESENTATION('',(#64),#75);
#77=PCURVE('pcurve_base_not_offset',#14,#76);
/* SURFACE_CURVE with OFFSET_CURVE 3D geometry */
#80=SURFACE_CURVE('edge_gp104',#40,(#77),.PCURVE_S1.);
#81=EDGE_CURVE('edge',#50,#52,#80,.T.);
#82=ORIENTED_EDGE('',*,*,#81,.T.);
#83=EDGE_LOOP('',(#82));
#84=FACE_OUTER_BOUND('',#83,.T.);
#85=ADVANCED_FACE('',(#84),#14,.T.);
