ISO-10303-21;
/* Gp175: Bottom edge of an otherwise-healthy closed 4-edge rectangular wire on a PLANE references a bare 3D LINE (no SURFACE_CURVE wrapper, no PCURVE) as its edge_geometry. Isolated from Gp001/Gp042's crash confounder: an empty-list SURFACE_CURVE(...,(),.PCURVE_S1.) wrapper segfaults OCCT regardless of wire topology; omitting the wrapper entirely lets FixAddPCurve reconstruct the pcurve by projection. */
HEADER;
FILE_DESCRIPTION(('Gp175'),'2;1');
FILE_NAME('Gp175.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
