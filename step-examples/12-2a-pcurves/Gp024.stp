ISO-10303-21;
/* Gp024 - Pcurve refit after non-uniform scale produces large errors
 * Defect: model was scaled x1000 from a small original. The pcurve
 * was recomputed but its precision-of-fit (deviation from the 3D curve)
 * also scaled by 1000. Edge shows pcurve-vs-3D deviation 0.05 against
 * declared edge tolerance 0.0001.
 *
 * Fix vs prior: previously the fixture used a B_SPLINE_CURVE_WITH_KNOTS
 * directly as the pcurve (knot domain [0,1] explicit) but emitted no
 * UNCERTAINTY entity declaring the edge tolerance — receivers had no
 * in-file tolerance to compare against. We now (1) wrap the pcurve
 * spline in a TRIMMED_CURVE pinning its 2D-domain to [0.0, 1.0], and
 * (2) declare a 0.0001 mm UNCERTAINTY_MEASURE_WITH_UNIT bound to the
 * geometric-representation context so the 0.05 mm pcurve deviation is
 * explicitly outside the declared tolerance budget. */
HEADER;
FILE_DESCRIPTION(('Gp024 test case','Pcurve refit after non-uniform scale'),'2;1');
FILE_NAME('Gp024.stp','2026-04-27T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Units + uncertainty: 0.0001 mm tolerance bound to the 3D geometric
 * representation context — the declared edge-tolerance budget. */
#3=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#4=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#5=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#6=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.0001),#3,
  'distance_accuracy_value','edge tolerance budget');
#7=( GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#6))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#3,#4,#5))
     REPRESENTATION_CONTEXT('scaled_x1000','3D') );
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Plane (scaled coordinate system) */
#20=PLANE('',#13);
/* 3D curve: linear from (0,0,0) to (1000,0,0) - scaled */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=DIRECTION('',(1.0,0.0,0.0));
#32=VECTOR('',#31,1.0);
#33=LINE('',#30,#32);
#40=VERTEX_POINT('',#30);
#41=CARTESIAN_POINT('',(1000.0,0.0,0.0));
#42=VERTEX_POINT('',#41);
/* Defect: pcurve B-spline approximation of straight line with
 * 0.05 mm deviation - originally 0.00005 before x1000 scaling.
 * Knots (0,0.333,0.667,1.0) make the natural 2D-domain explicit. */
#71=CARTESIAN_POINT('',(0.0,0.0));
#72=CARTESIAN_POINT('',(250.0,0.05));
#73=CARTESIAN_POINT('',(500.0,-0.05));
#74=CARTESIAN_POINT('',(750.0,0.05));
#75=CARTESIAN_POINT('',(1000.0,0.0));
#80=B_SPLINE_CURVE_WITH_KNOTS('',2,(#71,#72,#73,#74,#75),
  .UNSPECIFIED.,.F.,.F.,
  (3,1,1,3),(0.0,0.333,0.667,1.0),.UNSPECIFIED.);
/* Pin the pcurve's 2D-domain explicitly to [0.0, 1.0] via TRIMMED_CURVE
 * so receivers can compare actual deviation against the declared
 * tolerance over a known parametric range. */
#84=PARAMETER_VALUE(0.0);
#85=PARAMETER_VALUE(1.0);
#86=TRIMMED_CURVE('',#80,(#84),(#85),.T.,.PARAMETER.);
#81=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#82=DEFINITIONAL_REPRESENTATION('',(#86),#81);
#83=PCURVE('',#20,#82);
#50=SURFACE_CURVE('',#33,(#83),.PCURVE_S1.);
#60=EDGE_CURVE('',#40,#42,#50,.T.);
#61=ORIENTED_EDGE('',*,*,#60,.T.);
#62=EDGE_LOOP('',(#61));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#20,.T.);
/* Bind the face into a SHAPE_REPRESENTATION carrying the 0.0001
 * UNCERTAINTY-tagged context, so the declared tolerance is reachable
 * from the EDGE_CURVE via the representation graph. */
#90=SHAPE_REPRESENTATION('Gp024',(#13,#64),#7);
ENDSEC;
END-ISO-10303-21;
