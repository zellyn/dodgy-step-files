ISO-10303-21;
/* Gp189: Left seam EDGE_CURVE on CYLINDRICAL_SURFACE: SURFACE_CURVE wraps a correct 3D LINE plus a real (non-null) PCURVE in associated_geometry, but that PCURVE's DEFINITIONAL_REPRESENTATION items list references a LINE built from 3-coordinate (3D) point/direction entities -- wrong dimensionality for a 2D pcurve item -- so OCCT's pcurve-specific conversion fails and drops it while the 3D LINE stays intact; verified live that OCCT then supplies a projected pcurve instead (u=0 constant, v: 0->1) -- 'listed pcurve fails to translate' mode (contrast Gp012's null $ slot and Gp035's fully absent pcurve) */
HEADER;
FILE_DESCRIPTION(('Gp189'),'2;1');
FILE_NAME('Gp189.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
