ISO-10303-21;
/* Gp035 - 3D curve missing pcurve: project onto host surface
 * Defect: edge's 3D curve must be projected onto the host face's
 * surface to synthesize a pcurve; the projection must remain
 * same-parameter and may produce a special analytic 2D line where
 * applicable. */
HEADER;
FILE_DESCRIPTION(('Gp035 test case','3D curve missing pcurve: project onto host surface'),'2;1');
FILE_NAME('Gp035.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Helix-on-cylinder edge with no pcurve provided */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=CYLINDRICAL_SURFACE('',#13,5.0);
#20=CARTESIAN_POINT('',(5.0,0.0,0.0));
#21=VERTEX_POINT('',#20);
#22=CARTESIAN_POINT('',(5.0,0.0,10.0));
#23=VERTEX_POINT('',#22);
#24=DIRECTION('',(0.0,0.0,1.0));
#25=VECTOR('',#24,1.0);
#26=LINE('',#20,#25);
#50=EDGE_CURVE('',#21,#23,#26,.T.);
#60=ORIENTED_EDGE('',*,*,#50,.T.);
#70=EDGE_LOOP('',(#60));
#71=FACE_OUTER_BOUND('',#70,.T.);
#72=ADVANCED_FACE('',(#71),#14,.T.);
ENDSEC;
END-ISO-10303-21;
