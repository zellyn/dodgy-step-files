ISO-10303-21;
/* Gp184: Bottom edge 3D curve: degree-2 B_SPLINE_CURVE_WITH_KNOTS, 5 control points, knot vector (0,0,0,0.5,0.5,1,1,1) i.e. multiplicities (3,2,3) -- interior multiplicity = degree (2) gives genuine C0 continuity (position continuous, tangent discontinuous); poles either side of the shared knot point are non-collinear so the kink is geometrically real; wired through a live EDGE_CURVE/PCURVE into a reachable ADVANCED_FACE (not Gp033's unconstructible mult=degree+1 interior knot, which OCCT's Geom_BSplineCurve constructor rejects outright, yielding shape_null) */
HEADER;
FILE_DESCRIPTION(('Gp184'),'2;1');
FILE_NAME('Gp184.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
