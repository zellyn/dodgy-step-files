FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=APPLICATION_PROTOCOL_DEFINITION('international standard','ifc',2000,#2);
#2=APPLICATION_CONTEXT('3D structural analysis and design');
