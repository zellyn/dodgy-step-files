ISO-10303-21;
/* Gp195: GEOMETRIC_CURVE_SET (the shape representation's own item, a real translation root) whose sole element is 'composite_curve_scrambled_order', a COMPOSITE_CURVE of FOUR COMPOSITE_CURVE_SEGMENTs tracing the unit square (seg_a_bottom, seg_b_right, seg_c_top, seg_d_left, each a degree-1 B_SPLINE_CURVE_WITH_KNOTS with a finite [0,1] domain so every segment yields a real bounded edge) but LISTED in the order A, C, B, D -- successive entries in the list do not follow on from one another, and the permutation is neither the identity nor a cyclic rotation. The segment-reordering pass that runs over the collected segments before the wire is assembled IS the mechanism under test; the COMPOSITE_CURVE is an element of the root GEOMETRIC_CURVE_SET, the one call site that reaches that pass, never orphaned */
HEADER;
FILE_DESCRIPTION(('Gp195'),'2;1');
FILE_NAME('Gp195.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=CARTESIAN_POINT('',(1.0,0.0,0.0));
#3=B_SPLINE_CURVE_WITH_KNOTS('seg_a_bottom',1,(#1,#2),.UNSPECIFIED.,.F.,.F.,(2,2),(0.0,1.0),.UNSPECIFIED.);
#4=CARTESIAN_POINT('',(1.0,0.0,0.0));
#5=CARTESIAN_POINT('',(1.0,1.0,0.0));
#6=B_SPLINE_CURVE_WITH_KNOTS('seg_b_right',1,(#4,#5),.UNSPECIFIED.,.F.,.F.,(2,2),(0.0,1.0),.UNSPECIFIED.);
#7=CARTESIAN_POINT('',(1.0,1.0,0.0));
#8=CARTESIAN_POINT('',(0.0,1.0,0.0));
#9=B_SPLINE_CURVE_WITH_KNOTS('seg_c_top',1,(#7,#8),.UNSPECIFIED.,.F.,.F.,(2,2),(0.0,1.0),.UNSPECIFIED.);
#10=CARTESIAN_POINT('',(0.0,1.0,0.0));
#11=CARTESIAN_POINT('',(0.0,0.0,0.0));
#12=B_SPLINE_CURVE_WITH_KNOTS('seg_d_left',1,(#10,#11),.UNSPECIFIED.,.F.,.F.,(2,2),(0.0,1.0),.UNSPECIFIED.);
#13=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#3);
#14=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#6);
#15=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#9);
#16=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#12);
#17=COMPOSITE_CURVE('composite_curve_scrambled_order',(#13,#15,#14,#16),.F.);
#18=GEOMETRIC_CURVE_SET('gp195_composite_set',(#17));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Gp195','Gp195','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#18),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
END-ISO-10303-21;
