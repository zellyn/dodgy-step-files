ISO-10303-21;
/* Gp050: Degree-3 B-spline 3D curve with 10 CPs (knot domain [0,9]) paired with degree-2 pcurve B-spline with only 3 CPs (knot domain [0,1]); domain ratio 9:1 triggers FixSameParameter recursive SameRange refinement that consumes stack depth before convergence; defect IS in pcurve wired through PCURVE→SURFACE_CURVE→EDGE_CURVE */
HEADER;
FILE_DESCRIPTION(('Gp050'),'2;1');
FILE_NAME('Gp050.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
