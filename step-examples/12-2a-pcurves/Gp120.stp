ISO-10303-21;
/* Gp120 - Composite pcurve tangent discontinuity
 * Defect: ShapeAnalysis_Edge.GetEndTangent2d — pcurve is COMPOSITE_CURVE with
 * two segments. GetEndTangent2d uses first/last segment tangent but segments
 * have different continuity (G0 instead of C1), causing tangent jump. */
HEADER;
FILE_DESCRIPTION(('Gp120 test case','Composite pcurve tangent discontinuity'),'2;1');
FILE_NAME('Gp120.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Plane surface */
#20=PLANE('',#13);
/* 3D curve: polyline with two segments */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=CARTESIAN_POINT('',(2.0,1.0,0.0));
#32=CARTESIAN_POINT('',(4.0,0.5,0.0));
#33=POLYLINE('',(#30,#31,#32));
#40=CARTESIAN_POINT('',(0.0,0.0,0.0));
#41=VERTEX_POINT('',#40);
#42=CARTESIAN_POINT('',(4.0,0.5,0.0));
#43=VERTEX_POINT('',#42);
/* PCURVE: composite of two segments with tangent discontinuity at u=2 */
#50=CARTESIAN_POINT('',(0.0,0.0));
#51=DIRECTION('',(1.0,0.5));
#52=VECTOR('',#51,2.0);
#53=LINE('',#50,#52);
/* First segment: normalized direction (1, 0.5) */
#60=CARTESIAN_POINT('',(2.0,1.0));
#61=DIRECTION('',(1.0,-0.25));
#62=VECTOR('',#61,2.0);
#63=LINE('',#60,#62);
/* Composite curve with G0 continuity (tangent jump at join) */
#64=COMPOSITE_CURVE('',(#53,#63),.F.);
#65=PCURVE('',#20,#64);
#70=SURFACE_CURVE('',#33,(#65),.PCURVE_S1.);
#71=EDGE_CURVE('',#41,#43,#70,.T.);
#72=ORIENTED_EDGE('',*,*,#71,.T.);
#73=EDGE_LOOP('',(#72));
#74=FACE_OUTER_BOUND('',#73,.T.);
#75=ADVANCED_FACE('',(#74),#20,.T.);
/* Product context and definition */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gp120','Gp120','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9025));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
