ISO-10303-21;
/* Gp033 - Curve splitting at C0 knots / large parameter span
 * Defect: a B-spline curve has a C0 internal knot where downstream
 * meshing needs at least C1; the curve must be split at the C0 break. */
HEADER;
FILE_DESCRIPTION(('Gp033 test case','Curve splitting at C0 knots / large parameter span'),'2;1');
FILE_NAME('Gp033.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* B-spline curve with internal C0 knot at u=0.5 */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=VERTEX_POINT('',#20);
#22=CARTESIAN_POINT('',(10.0,0.0,0.0));
#23=VERTEX_POINT('',#22);
#24=CARTESIAN_POINT('',(2.5,0.5,0.0));
#25=CARTESIAN_POINT('',(5.0,1.0,0.0));
#26=CARTESIAN_POINT('',(5.0,0.5,0.0));
#27=CARTESIAN_POINT('',(7.5,0.5,0.0));
/* Mult 3 at interior knot u=0.5 (= degree+1 for degree-2 curve, but
 * note that mult=degree=2 yields C0; mult=degree+1=3 here makes the
 * curve discontinuous in position at u=0.5 since both poles on either
 * side coincide, an extreme C-1 break). 6 control points satisfies
 * n_cps = sum(mults) - degree - 1 = 9 - 2 - 1 = 6. */
#30=B_SPLINE_CURVE_WITH_KNOTS('',2,(#20,#24,#25,#26,#27,#22),.UNSPECIFIED.,
  .F.,.F.,(3,3,3),(0.0,0.5,1.0),.UNSPECIFIED.);
#50=EDGE_CURVE('',#21,#23,#30,.T.);
#60=ORIENTED_EDGE('',*,*,#50,.T.);
#70=EDGE_LOOP('',(#60));
#71=FACE_OUTER_BOUND('',#70,.T.);
#72=ADVANCED_FACE('',(#71),#14,.T.);
ENDSEC;
END-ISO-10303-21;
