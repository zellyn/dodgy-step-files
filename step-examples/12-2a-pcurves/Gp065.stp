ISO-10303-21;
/* Gp065 - ShapeAnalysis_Edge.GetEndTangent2d (POLYLINE variant)
 * Defect: pcurve as POLYLINE with 5+ points; GetEndTangent2d uses last two points
 * for first endpoint, but should use first two points. Returns wrong tangent. */
HEADER;
FILE_DESCRIPTION(('Gp065 test case','GetEndTangent2d POLYLINE variant'),'2;1');
FILE_NAME('Gp065.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Plane surface */
#20=PLANE('',#13);
/* 3D edge curve - arbitrary line from (0,0,0) to (5,0,0) */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=DIRECTION('',(1.0,0.0,0.0));
#32=VECTOR('',#31,5.0);
#33=LINE('',#30,#32);
/* Vertices */
#40=VERTEX_POINT('',(0.0,0.0,0.0));
#41=VERTEX_POINT('',(5.0,0.0,0.0));
/* PCurve as POLYLINE with 5 points forming a path with non-obvious tangent.
 * Points: (0,0), (0.5,0), (1,1), (2,0.5), (5,0)
 * First tangent direction: (0.5,0) - (0,0) = (0.5,0) → direction (1,0)
 * Last two points before end: (2,0.5), (5,0) → direction (3,-0.5)
 * If algorithm uses wrong endpoint pair, tangent will be backwards. */
#50=CARTESIAN_POINT('',(0.0,0.0));
#51=CARTESIAN_POINT('',(0.5,0.0));
#52=CARTESIAN_POINT('',(1.0,1.0));
#53=CARTESIAN_POINT('',(2.0,0.5));
#54=CARTESIAN_POINT('',(5.0,0.0));
#55=POLYLINE('',(#50,#51,#52,#53,#54));
#56=PCURVE('',#20,#55);
#60=SURFACE_CURVE('',#33,(#56),.PCURVE_S1.);
#70=EDGE_CURVE('',#40,#41,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#70,.T.);
#72=EDGE_LOOP('',(#71));
#73=FACE_OUTER_BOUND('',#72,.T.);
#74=ADVANCED_FACE('',(#73),#20,.T.);
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gp065','Gp065','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#72));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
