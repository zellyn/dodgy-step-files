ISO-10303-21;
/* Gp109 - ShapeFix_Edge.FixReversed2d composite-pcurve
 * Defect: pcurve is COMPOSITE_CURVE with two segments; FixReversed2d's
 * reversal flips the whole composite but doesn't reverse the order of
 * segments. */
HEADER;
FILE_DESCRIPTION(('Gp109 test case','FixReversed2d composite-pcurve'),'2;1');
FILE_NAME('Gp109.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
