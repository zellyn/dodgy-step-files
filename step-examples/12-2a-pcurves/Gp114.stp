ISO-10303-21;
/* Gp114 - ShapeFix_Edge.FixSameParameter periodic-curve-with-non-periodic-pcurve
 * Defect: closed 3D curve (circle) but pcurve is non-periodic line on plane.
 * FixSameParameter forces periodicity mismatch. */
HEADER;
FILE_DESCRIPTION(('Gp114 test case','Periodic 3D circle vs non-periodic pcurve line'),'2;1');
FILE_NAME('Gp114.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
