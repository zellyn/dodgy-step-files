ISO-10303-21;
/* Gp016 - Transformed pcurves from IGES BRep mode
 * Defect: pcurve coordinate frame is offset/rotated from the host
 * surface's natural UV. After IGES BRep round-trip, the pcurve evaluates
 * to wrong UV positions; vertex tolerances inflate to compensate. */
HEADER;
FILE_DESCRIPTION(('Gp016 test case','Transformed pcurves from IGES BRep mode'),'2;1');
FILE_NAME('Gp016.stp','2026-04-27T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* 3D curve from (0,0,0) to (1,0,0) */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=DIRECTION('',(1.0,0.0,0.0));
#32=VECTOR('',#31,1.0);
#33=LINE('',#30,#32);
#40=VERTEX_POINT('',#30);
#41=CARTESIAN_POINT('',(1.0,0.0,0.0));
#42=VERTEX_POINT('',#41);
/* Defect: the pcurve runs from (10, 5) to (11, 5) - offset by (10, 5)
 * from the host surface's UV origin, as if expressed in an IGES-style
 * transformed frame. Lifting yields wrong 3D positions vs vertices. */
#71=CARTESIAN_POINT('',(10.0,5.0));
#72=DIRECTION('',(1.0,0.0));
#73=VECTOR('',#72,1.0);
#74=LINE('',#71,#73);
#75=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#76=DEFINITIONAL_REPRESENTATION('',(#74),#75);
#77=PCURVE('',#20,#76);
#50=SURFACE_CURVE('',#33,(#77),.PCURVE_S1.);
#60=EDGE_CURVE('',#40,#42,#50,.T.);
#61=ORIENTED_EDGE('',*,*,#60,.T.);
#62=EDGE_LOOP('',(#61));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#20,.T.);
ENDSEC;
END-ISO-10303-21;
