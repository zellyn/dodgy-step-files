#52=DIRECTION('',(0.0,1.0));
#53=AXIS2_PLACEMENT_2D('',#50,#51);
#54=CIRCLE('',#53,3.0);
#55=PCURVE('',#20,#54);
/* SURFACE_CURVE with closed PCURVE but open 3D curve */
#60=SURFACE_CURVE('',#33,(#55),.PCURVE_S1.);
#61=EDGE_CURVE('',#41,#43,#60,.T.);
#62=ORIENTED_EDGE('',*,*,#61,.T.);
