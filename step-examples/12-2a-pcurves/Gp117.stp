ISO-10303-21;
/* Gp117 - Closed pcurve, open 3D curve mismatch
 * Defect: ShapeFix_Edge.FixAddCurve3d — PCURVE is a closed circle but EDGE_CURVE
 * expects an open 3D curve. FixAddCurve3d constructs a 3D circle but closure
 * doesn't match edge vertices due to parameterization difference. */
HEADER;
FILE_DESCRIPTION(('Gp117 test case','Closed pcurve open 3D curve mismatch'),'2;1');
FILE_NAME('Gp117.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
