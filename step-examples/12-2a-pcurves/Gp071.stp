ISO-10303-21;
/* Gp071 - ShapeAnalysis_Edge.CheckCurve3dWithPCurve scaled-host-surface
 * Defect: host surface has scale factor in AXIS2_PLACEMENT_3D (non-unit basis);
 * CheckCurve3dWithPCurve compares 3D positions but pcurve eval doesn't apply the scale */
HEADER;
FILE_DESCRIPTION(('Gp071 test case','CheckCurve3dWithPCurve scaled-host-surface'),'2;1');
FILE_NAME('Gp071.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
