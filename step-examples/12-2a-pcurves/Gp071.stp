#51=DIRECTION('',(1.0,0.0));
#52=VECTOR('',#51,5.0);
#53=LINE('',#50,#52);
#55=PCURVE('',#20,#53);
#60=SURFACE_CURVE('',#33,(#55),.PCURVE_S1.);
#70=EDGE_CURVE('',#40,#41,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#70,.T.);
/* Closing edge for manifold */
