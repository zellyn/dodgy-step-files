#87=LINE('',#41,#84);
#88=SURFACE_CURVE('',#87,(#86),.PCURVE_S1.);
#89=EDGE_CURVE('',#41,#81,#88,.T.);
#90=ORIENTED_EDGE('',*,*,#89,.T.);
#100=EDGE_LOOP('',(#71,#90));
#101=FACE_OUTER_BOUND('',(#100),.T.);
#102=ADVANCED_FACE('',(#101),#20,.T.);
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gp071','Gp071','',(#9000));
