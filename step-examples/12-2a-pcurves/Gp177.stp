ISO-10303-21;
/* Gp177: SPHERICAL_SURFACE edge whose 3D curve (a great-circle CIRCLE) climbs from equator vertex A=(1,0,0) through the NORTH POLE (0,0,1) -- strictly interior to the edge's parameter range, not an endpoint -- down to equator vertex B=(-1,0,0). Its pcurve is a single straight UV line v=0 constant (u:0->pi), naively treating the edge as if it stayed on the equator; the true path needs u to jump 0->pi exactly at v=pi/2 (the pole), which one pcurve cannot represent -- correct healing requires splitting into two sub-edges at the pole, not patching one apex-adjacent pcurve. */
HEADER;
FILE_DESCRIPTION(('Gp177'),'2;1');
FILE_NAME('Gp177.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
