ISO-10303-21;
/* Gp068 - ShapeFix_Edge.FixReversed2d circular-curve range
 * Defect: pcurve is CIRCLE entity; reversing requires angle remapping but FixReversed2d
 * treats it as simple parameter-range swap. Circular arc loses proper parametrization. */
HEADER;
FILE_DESCRIPTION(('Gp068 test case','FixReversed2d circular-curve range remapping'),'2;1');
FILE_NAME('Gp068.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Plane surface */
#20=PLANE('',#13);
/* 3D circular arc in 3D space, radius 2.0, center at (2,0,0) */
#30=CARTESIAN_POINT('',(2.0,0.0,0.0));
#31=DIRECTION('',(0.0,0.0,1.0));
#32=DIRECTION('',(1.0,0.0,0.0));
#33=AXIS2_PLACEMENT_3D('',#30,#31,#32);
#34=CIRCLE('',#33,2.0);
/* Trim to arc from angle 0 to pi/2 */
#35=TRIM_CURVE('',(#34),0.0,1.5707963267949,.T.,(PARAMETER_VALUE(0.0)));
/* Vertices: start (4,0,0), end (2,2,0) */
#40=VERTEX_POINT('',(4.0,0.0,0.0));
#41=VERTEX_POINT('',(2.0,2.0,0.0));
/* PCurve: circle on plane, same center and radius projections */
#50=CARTESIAN_POINT('',(0.0,0.0));
#51=DIRECTION('',(0.0,0.0));
#52=AXIS2_PLACEMENT_2D('',#50);
#53=CIRCLE('',#52,2.0);
#54=TRIM_CURVE('',(#53),0.0,1.5707963267949,.T.,(PARAMETER_VALUE(0.0)));
#55=PCURVE('',#20,#54);
/* 3D surface curve */
#60=SURFACE_CURVE('',#35,(#55),.PCURVE_S1.);
/* Edge with circular pcurve; FixReversed2d will swap start/end incorrectly */
#70=EDGE_CURVE('',#40,#41,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#70,.T.);
#72=EDGE_LOOP('',(#71));
#73=FACE_OUTER_BOUND('',#72,.T.);
#74=ADVANCED_FACE('',(#73),#20,.T.);
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gp068','Gp068','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
