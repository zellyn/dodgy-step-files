ISO-10303-21;
/* Gp173: EDGE_CURVE whose 3D geometry is a general (non-iso, non-analytic) cubic B_SPLINE_CURVE_WITH_KNOTS lying approximately on a SPHERICAL_SURFACE (radius 5). No closed-form analytic projection of a general B-spline onto a sphere exists, so ShapeConstruct_ProjectCurveOnSurface must fall back to its sampled path: it evaluates ~23 sample points, approximates a B-spline pcurve through them, then runs correctExtremity to nudge the projected 2D endpoints onto the vertex parameters. The supplied pcurve is a crude straight 2D LINE placeholder that does not match the true projection, and the end VERTEX_POINT is offset ~0.02mm from the 3D curve end, so a residual endpoint gap must be corrected. Input pattern: 3D curve not analytically projectable onto host surface + missing/placeholder pcurve + endpoint residual — exercises the sampled-fallback + correctExtremity repair path. B4 wave-12 repair-code mining (ShapeConstruct_ProjectCurveOnSurface). SHELL_BASED_SURFACE_MODEL is model entity */
HEADER;
FILE_DESCRIPTION(('Gp173'),'2;1');
FILE_NAME('Gp173.stp','2026-07-06T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('sphere_center',(0.0,0.0,0.0));
#2=DIRECTION('',(0.0,0.0,1.0));
#3=DIRECTION('',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('',#1,#2,#3);
#5=SPHERICAL_SURFACE('sph',#4,5.0);
#6=CARTESIAN_POINT('bsp_p0',(5.0,0.0,0.0));
#7=CARTESIAN_POINT('bsp_p1',(4.0,2.0,1.5));
#8=CARTESIAN_POINT('bsp_p2',(2.5,2.5,3.0));
#9=CARTESIAN_POINT('bsp_p3',(1.0,2.0,4.3));
#10=CARTESIAN_POINT('bsp_p4',(0.0,0.5,4.98));
#11=B_SPLINE_CURVE_WITH_KNOTS('crv3d',3,(#6,#7,#8,#9,#10),.UNSPECIFIED.,.F.,.F.,(4,1,4),(0.0,0.5,1.0),.UNSPECIFIED.);
#12=CARTESIAN_POINT('v_start',(5.0,0.0,0.0));
#13=CARTESIAN_POINT('v_end_offset',(0.02,0.48,4.98));
#14=VERTEX_POINT('',#12);
#15=VERTEX_POINT('',#13);
#16=CARTESIAN_POINT('pc_placeholder_p0',(0.0,0.0));
#17=DIRECTION('',(0.7071067811865476,0.7071067811865476));
#18=VECTOR('',#17,2.221441469079183);
#19=LINE('pc_crude',#16,#18);
#20=(GEOMETRIC_REPRESENTATION_CONTEXT(2)PARAMETRIC_REPRESENTATION_CONTEXT()REPRESENTATION_CONTEXT('','2D'));
#21=DEFINITIONAL_REPRESENTATION('',(#19),#20);
#22=PCURVE('pc_on_sphere',#5,#21);
#23=SURFACE_CURVE('sc_bsp',#11,(#22),.PCURVE_S1.);
#24=EDGE_CURVE('ec_bsp',#14,#15,#23,.T.);
#25=ORIENTED_EDGE('',$,$,#24,.T.);
#26=EDGE_LOOP('',(#25));
#27=FACE_OUTER_BOUND('',#26,.T.);
#28=ADVANCED_FACE('',(#27),#5,.T.);
#29=OPEN_SHELL('',(#28));
#30=SHELL_BASED_SURFACE_MODEL('',(#29));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Gp173','Gp173','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#30),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
END-ISO-10303-21;
