ISO-10303-21;
/* Gp136 - ShapeFix_Edge.FixRemovePCurve.orphan_pcurves
 * Defect: RemoveCurve3d may leave orphaned PCurves on faces without cleanup.
 * Multi-face edge with inconsistent PCurves; remove 3D curve w/o updating face-edge relations. */
HEADER;
FILE_DESCRIPTION(('Gp136 test case','orphan pcurve after 3D removal'),'2;1');
FILE_NAME('Gp136.stp','2026-06-16T00:00:00',(''),(''),'auto-generated','','');
