/* SURFACE_CURVE binding both pcurves */
#60=SURFACE_CURVE('seam_edge',#24,(#47,#56),.PCURVE_S1.);
#61=EDGE_CURVE('multi_face_edge',#30,#32,#60,.T.);
#62=ORIENTED_EDGE('',*,*,#61,.T.);
#63=EDGE_LOOP('',(#62));
