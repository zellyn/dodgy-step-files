#65=ADVANCED_FACE('',(#64),#14,.T.);
#66=ORIENTED_EDGE('',*,*,#61,.T.);
#67=EDGE_LOOP('',(#66));
#68=FACE_OUTER_BOUND('',#67,.T.);
#69=ADVANCED_FACE('',(#68),#18,.T.);
#90=SHAPE_REPRESENTATION('Gp136',(#13,#17,#65,#69),#7);
/* PRODUCT chain */
