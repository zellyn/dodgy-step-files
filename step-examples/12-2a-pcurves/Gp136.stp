#46=DEFINITIONAL_REPRESENTATION('',(#44),#45);
#47=PCURVE('pcurve_face1',#14,#46);
/* Face 2 PCURVE: divergent (0,0) to (2.5,1.5) - inconsistent */
#50=CARTESIAN_POINT('',(0.0,0.0));
