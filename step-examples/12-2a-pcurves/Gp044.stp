ISO-10303-21;
/* Gp044 - ShapeAnalysis_Curve.Project endpoint-bias projection error
 * Defect: Project returns endpoint distance even when an interior local-min
 * is the true projection result. The edge 3D curve is a circular arc with
 * curvature inflection such that both endpoints AND an interior point are
 * equidistant from a probe point. Project's endpoint-bias picks the wrong
 * one, causing the PCURVE to map to stale parameter bounds. */
HEADER;
FILE_DESCRIPTION(('Gp044 test case','Project endpoint-bias projection error'),'2;1');
FILE_NAME('Gp044.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#4=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#5=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#6=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#3,'distance_accuracy_value','');
#7=( GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#6))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#3,#4,#5))
     REPRESENTATION_CONTEXT('','3D') );
/* Host plane */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('host_plane',#13);
/* 3D curve: composite that has equidistant endpoints and interior point
 * from a probe. B-spline arc with inflection at midspan. */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(2.5,3.0));
#22=CARTESIAN_POINT('',(5.0,0.0));
#23=CARTESIAN_POINT('',(7.5,3.0));
#24=CARTESIAN_POINT('',(10.0,0.0));
#30=B_SPLINE_CURVE_WITH_KNOTS('arc_curve',2,(#20,#21,#22,#23,#24),
  .UNSPECIFIED.,.F.,.F.,
  (3,1,1,3),(0.0,0.333,0.667,1.0),.UNSPECIFIED.);
/* Vertices */
#40=VERTEX_POINT('',(0.0,0.0,0.0));
#41=CARTESIAN_POINT('',(10.0,0.0,0.0));
#42=VERTEX_POINT('',#41);
/* Defective PCURVE: B-spline where Project selected endpoint instead of
 * interior local-min as the true projection candidate */
#50=CARTESIAN_POINT('',(0.0,0.0));
#51=CARTESIAN_POINT('',(2.5,1.5));
#52=CARTESIAN_POINT('',(5.0,3.0));
#53=CARTESIAN_POINT('',(7.5,1.5));
#54=CARTESIAN_POINT('',(10.0,0.0));
#55=B_SPLINE_CURVE_WITH_KNOTS('pcurve_biased',2,(#50,#51,#52,#53,#54),
  .UNSPECIFIED.,.F.,.F.,
  (3,1,1,3),(0.0,0.333,0.667,1.0),.UNSPECIFIED.);
#56=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#57=DEFINITIONAL_REPRESENTATION('',(#55),#56);
#58=PCURVE('pcurve_project_biased',#14,#57);
/* SURFACE_CURVE with Project-biased PCURVE */
#60=SURFACE_CURVE('edge_project_bias',#30,(#58),.PCURVE_S1.);
#70=EDGE_CURVE('edge_gp044',#40,#42,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#70,.T.);
#72=EDGE_LOOP('',(#71));
#73=FACE_OUTER_BOUND('',#72,.T.);
#74=ADVANCED_FACE('',(#73),#14,.T.);
#90=SHAPE_REPRESENTATION('Gp044',(#13,#74),#7);
/* Wrap: PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gp044','Gp044','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#74));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
