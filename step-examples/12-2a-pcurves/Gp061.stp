ISO-10303-21;
/* Gp061 - ShapeAnalysis_Edge.CheckCurve3dWithPCurve sample-count threshold
 * Defect: very short edge has sample count that drops to 2, skipping midspan check.
 * CheckCurve3dWithPCurve scales sample count with curve length; on short edge,
 * count becomes 2 and the midspan verification between 3D curve and pcurve is skipped. */
HEADER;
FILE_DESCRIPTION(('Gp061 test case','CheckCurve3dWithPCurve sample-count threshold'),'2;1');
FILE_NAME('Gp061.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Cylindrical surface, radius 5 */
#20=CYLINDRICAL_SURFACE('',#13,5.0);
/* Very short 3D curve - line 0.001 units long, causing sample count to drop to 2 */
#30=CARTESIAN_POINT('',(5.0,0.0,0.0));
#31=DIRECTION('',(0.0,0.0,1.0));
#32=VECTOR('',#31,0.001);
#33=LINE('',#30,#32);
/* Vertex points for very short edge */
#40=VERTEX_POINT('',(5.0,0.0,0.0));
#41=VERTEX_POINT('',(5.0,0.0,0.001));
/* PCurve - line in (u,v) space along u=0 from v=0 to v=0.001 */
#50=CARTESIAN_POINT('',(0.0,0.0));
#51=DIRECTION('',(0.0,1.0));
#52=VECTOR('',#51,0.001);
#53=LINE('',#50,#52);
#54=PCURVE('',#20,#53);
#60=SURFACE_CURVE('',#33,(#54),.PCURVE_S1.);
#70=EDGE_CURVE('',#40,#41,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#70,.T.);
#72=EDGE_LOOP('',(#71));
#73=FACE_OUTER_BOUND('',#72,.T.);
#74=ADVANCED_FACE('',(#73),#20,.T.);
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gp061','Gp061','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#72));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
