ISO-10303-21;
/* Gp049 - ShapeAnalysis_Edge.CheckOverlapping arc-length vs parameter-space
 * Defect: two edges that overlap in 3D space but parameter-space tests don't
 * detect overlap because curves have different param-to-arc mappings. Edge1
 * is a slow LINE (large parameter span, small 3D distance), Edge2 is a fast
 * CIRCLE arc (small parameter span, large 3D distance). Both map to same
 * 3D endpoints but parameter ranges don't overlap geometrically. */
HEADER;
FILE_DESCRIPTION(('Gp049 test case','CheckOverlapping arc-length vs parameter-space'),'2;1');
FILE_NAME('Gp049.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#4=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#5=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#6=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#3,'distance_accuracy_value','');
#7=( GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#6))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#3,#4,#5))
     REPRESENTATION_CONTEXT('','3D') );
/* Host plane */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('host_plane',#13);
/* Edge 1: slow LINE from (0,0,0) to (10,0,0) with parameter [0, 100] */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.1,0.0,0.0));
#22=LINE('slow_line',#20,#21);
/* Edge 2: fast CIRCLE arc from (0,0,0) to (10,0,0) - small angle span */
#30=CARTESIAN_POINT('',(5.0,0.0,0.0));
#31=DIRECTION('',(0.0,0.0,1.0));
#32=DIRECTION('',(1.0,0.0,0.0));
#33=AXIS2_PLACEMENT_3D('',#30,#31,#32);
#34=CIRCLE('fast_circle',#33,5.0);
/* Vertices shared by both edges */
#40=CARTESIAN_POINT('',(0.0,0.0,0.0));
#41=VERTEX_POINT('',#40);
#42=CARTESIAN_POINT('',(10.0,0.0,0.0));
#43=VERTEX_POINT('',#42);
/* PCURVE for slow line on plane [0, 100] */
#50=CARTESIAN_POINT('',(0.0,0.0));
#51=DIRECTION('',(0.1,0.0));
#52=LINE('pcurve_slow',#50,#51);
#53=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#54=DEFINITIONAL_REPRESENTATION('',(#52),#53);
#55=PCURVE('pcurve_slow_line',#14,#54);
/* PCURVE for fast circle [pi, 0] (small arc) */
#56=CARTESIAN_POINT('',(0.0,0.0));
#57=DIRECTION('',(0.0,1.0));
#58=LINE('pcurve_fast',#56,#57);
#59=DEFINITIONAL_REPRESENTATION('',(#58),#53);
#60=PCURVE('pcurve_fast_arc',#14,#59);
/* SURFACE_CURVEs */
#61=SURFACE_CURVE('edge_slow_line',#22,(#55),.PCURVE_S1.);
#62=SURFACE_CURVE('edge_fast_arc',#34,(#60),.PCURVE_S1.);
/* EDGE_CURVEs with same endpoints */
#70=EDGE_CURVE('edge_gp049_slow',#41,#43,#61,.T.);
#80=EDGE_CURVE('edge_gp049_fast',#41,#43,#62,.T.);
/* Two faces using the two edges in loop - demonstrates overlap detection failure */
#71=ORIENTED_EDGE('',*,*,#70,.T.);
#72=EDGE_LOOP('',(#71));
#73=FACE_OUTER_BOUND('',#72,.T.);
#74=ADVANCED_FACE('',(#73),#14,.T.);
#81=ORIENTED_EDGE('',*,*,#80,.T.);
#82=EDGE_LOOP('',(#81));
#83=FACE_OUTER_BOUND('',#82,.T.);
#84=ADVANCED_FACE('',(#83),#14,.T.);
#90=SHAPE_REPRESENTATION('Gp049',(#13,#14,#74,#84),#7);
/* Wrap: PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gp049','Gp049','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#74,#84));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
