ISO-10303-21;
/* Gp014 - Shared pcurve across multiple edges (SYRKO)
 * Defect: a single PCURVE instance (#77) is referenced by two different
 * EDGE_CURVE instances (#60 and #160) via their SURFACE_CURVE
 * associated_geometry lists. Trim ops applied to one edge corrupt the
 * other because they share the same pcurve handle. */
HEADER;
FILE_DESCRIPTION(('Gp014 test case','Shared pcurve across multiple edges'),'2;1');
FILE_NAME('Gp014.stp','2026-04-27T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Two distinct 3D curves, both lying along Y=0 line on the plane */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=DIRECTION('',(1.0,0.0,0.0));
#32=VECTOR('',#31,1.0);
#33=LINE('',#30,#32);
#34=CARTESIAN_POINT('',(1.0,0.0,0.0));
#35=LINE('',#34,#32);
#40=VERTEX_POINT('',#30);
#41=VERTEX_POINT('',#34);
#42=CARTESIAN_POINT('',(2.0,0.0,0.0));
#43=VERTEX_POINT('',#42);
/* Single shared pcurve in 2D parameter space */
#71=CARTESIAN_POINT('',(0.0,0.0));
#72=DIRECTION('',(1.0,0.0));
#73=VECTOR('',#72,1.0);
#74=LINE('',#71,#73);
#75=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#76=DEFINITIONAL_REPRESENTATION('',(#74),#75);
#77=PCURVE('',#20,#76);
/* Defect: both surface curves share the SAME pcurve handle #77 */
#50=SURFACE_CURVE('',#33,(#77),.PCURVE_S1.);
#150=SURFACE_CURVE('',#35,(#77),.PCURVE_S1.);
#60=EDGE_CURVE('',#40,#41,#50,.T.);
#160=EDGE_CURVE('',#41,#43,#150,.T.);
#61=ORIENTED_EDGE('',*,*,#60,.T.);
#161=ORIENTED_EDGE('',*,*,#160,.T.);
#62=EDGE_LOOP('',(#61,#161));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#20,.T.);
ENDSEC;
END-ISO-10303-21;
