      REPRESENTATION_CONTEXT('parametric','2D') );
#56=DEFINITIONAL_REPRESENTATION('',(#53),#55);
#57=PCURVE('pcurve1',#14,#56);
/* PCURVE 2: identical line in 2D from (0,0) to (5,0) */
#60=CARTESIAN_POINT('',(0.0,0.0));
