#66=DEFINITIONAL_REPRESENTATION('',(#63),#65);
#67=PCURVE('pcurve2',#14,#66);
/* SURFACE_CURVE 1: base curve with pcurve 1 */
#70=SURFACE_CURVE('edge1_coincident',#23,(#57),.PCURVE_S1.);
#71=EDGE_CURVE('edge1',#40,#42,#70,.T.);
