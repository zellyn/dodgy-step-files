#43=VERTEX_POINT('',(0.0,0.0,0.0));
#44=CARTESIAN_POINT('',(5.0,0.0,0.0));
#45=VERTEX_POINT('',#44);
/* PCURVE 1: line in 2D from (0,0) to (5,0) */
#50=CARTESIAN_POINT('',(0.0,0.0));
#51=DIRECTION('',(1.0,0.0));
#52=VECTOR('',#51,1.0);
#53=LINE('pcurve_line1',#50,#52);
