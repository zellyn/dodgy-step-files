ISO-10303-21;
/* Gp105 - ShapeAnalysis_Edge.CheckOverlapping zero-tolerance-overlap
 * Defect: two edges with literally coincident 3D geometry; CheckOverlapping
 * with zero tolerance reports them as non-overlapping due to FP comparison. */
HEADER;
FILE_DESCRIPTION(('Gp105 test case','CheckOverlapping zero-tolerance-overlap'),'2;1');
FILE_NAME('Gp105.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
