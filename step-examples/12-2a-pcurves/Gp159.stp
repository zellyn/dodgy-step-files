#47=DEFINITIONAL_REPRESENTATION('',(#45),#46);
#48=PCURVE('pcurve_partial_collapse',#16,#47);
/* SURFACE_CURVE */
#50=SURFACE_CURVE('edge_partial_collapse',#23,(#48),.PCURVE_S1.);
