ISO-10303-21;
/* Gp191: OPEN_SHELL with one ADVANCED_FACE on a PLANE (z=0, normal +Z); FACE_OUTER_BOUND references an EDGE_LOOP with one EDGE_CURVE 'collapsed_pcurve_edge': v_start(0,0,0) -> v_end(1,0,0), 3D curve is a real 1-unit LINE 'edge_positive_length_3d', wrapped in a SURFACE_CURVE whose SOLE PCURVE has a zero-magnitude 2D UV VECTOR -- the pcurve's own trim domain collapses to a single point (w1==w2) regardless of the real 3D traversal; CheckPCurves' w1==w2 -> RemoveSinglePCurve branch IS the mechanism; EDGE_LOOP IS wired into FACE_OUTER_BOUND, ADVANCED_FACE, OPEN_SHELL; never orphaned */
HEADER;
FILE_DESCRIPTION(('Gp191'),'2;1');
FILE_NAME('Gp191.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
