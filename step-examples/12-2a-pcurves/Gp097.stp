ISO-10303-21;
/* Gp097 - ShapeFix_Edge.FixAddPCurve composite-curve-on-surface
 * Defect: edge with COMPOSITE_CURVE as its 3D curve. FixAddPCurve constructs
 * the pcurve from the first segment only, ignoring subsequent segments. */
HEADER;
FILE_DESCRIPTION(('Gp097 test case','FixAddPCurve composite-curve-on-surface'),'2;1');
FILE_NAME('Gp097.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
