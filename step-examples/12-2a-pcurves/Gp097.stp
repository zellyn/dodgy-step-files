#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(5.0,5.0,0.0));
#22=LINE('segment_1',#20,#21);
/* Second segment: arc from (5,5,0) to (10,0,0) */
#23=CARTESIAN_POINT('',(7.5,7.5,0.0));
#24=CIRCLE('segment_2_circle',#13,5.0);
#25=TRIMMED_CURVE('segment_2',#24,(5.0,5.0),(10.0,0.0),.T.,.PARAMETER.);
/* Composite curve: two segments */
#30=COMPOSITE_CURVE('composite_3d',(#22,#25),.F.);
/* Vertices */
#40=VERTEX_POINT('',(0.0,0.0,0.0));
#41=CARTESIAN_POINT('',(10.0,0.0,0.0));
#42=VERTEX_POINT('',#41);
/* PCURVE: matches only first segment, not second */
#50=CARTESIAN_POINT('',(0.0,0.0));
#51=CARTESIAN_POINT('',(5.0,5.0));
#52=LINE('pcurve_partial',#50,#51);
#53=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#54=DEFINITIONAL_REPRESENTATION('',(#52),#53);
#55=PCURVE('pcurve_first_segment',#14,#54);
/* SURFACE_CURVE with composite 3D curve */
#60=SURFACE_CURVE('edge_composite',#30,(#55),.PCURVE_S1.);
#70=EDGE_CURVE('edge_gp097',#40,#42,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#70,.T.);
#72=EDGE_LOOP('',(#71));
#73=FACE_OUTER_BOUND('',#72,.T.);
#74=ADVANCED_FACE('',(#73),#14,.T.);
#90=SHAPE_REPRESENTATION('Gp097',(#13,#74),#7);
