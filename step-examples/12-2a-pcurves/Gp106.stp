ISO-10303-21;
/* Gp106 - ShapeAnalysis_Edge.CheckSameParameter spline-vs-spline-shifted
 * Defect: edge with B-spline 3D and B-spline pcurve where the second has its
 * parameter range shifted by 1.0; CheckSameParameter compares as-is and
 * reports false mismatch (should detect they represent same geometry). */
HEADER;
FILE_DESCRIPTION(('Gp106 test case','CheckSameParameter spline-vs-spline-shifted'),'2;1');
FILE_NAME('Gp106.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#4=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#5=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#6=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#3,'distance_accuracy_value','');
#7=( GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#6))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#3,#4,#5))
     REPRESENTATION_CONTEXT('','3D') );
/* Plane surface for parametric surface */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('plane',#13);
/* 3D B-spline curve: degree 2, 3 control points, param [0,1] */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(2.5,1.0,0.0));
#22=CARTESIAN_POINT('',(5.0,0.0,0.0));
#23=B_SPLINE_CURVE_WITH_KNOTS('bspline_3d',2,(#20,#21,#22),.UNSPECIFIED.,.F.,.F.,(3,1,3),(0.0,0.5,1.0),.UNSPECIFIED.);
/* Vertices: start (0,0,0), end (5,0,0) */
#30=VERTEX_POINT('',(0.0,0.0,0.0));
#31=CARTESIAN_POINT('',(5.0,0.0,0.0));
#32=VERTEX_POINT('',#31);
/* 2D B-spline pcurve (degree 2, same 3 control points, shifted param [1,2]) */
#40=CARTESIAN_POINT('',(0.0,0.0));
#41=CARTESIAN_POINT('',(2.5,0.5));
#42=CARTESIAN_POINT('',(5.0,0.0));
#43=B_SPLINE_CURVE_WITH_KNOTS('bspline_2d_shifted',2,(#40,#41,#42),.UNSPECIFIED.,.F.,.F.,(3,1,3),(1.0,1.5,2.0),.UNSPECIFIED.);
#45=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#46=DEFINITIONAL_REPRESENTATION('',(#43),#45);
#47=PCURVE('pcurve_2d_shifted',#14,#46);
/* SURFACE_CURVE: 3D with pcurve (parameter domains differ) */
#50=SURFACE_CURVE('edge_bspline_shifted',#23,(#47),.PCURVE_S1.);
#51=EDGE_CURVE('edge1',#30,#32,#50,.T.);
#52=ORIENTED_EDGE('',*,*,#51,.T.);
/* Edge loop */
#60=EDGE_LOOP('',(#52));
#61=FACE_OUTER_BOUND('',#60,.T.);
#62=ADVANCED_FACE('',(#61),#14,.T.);
#90=SHAPE_REPRESENTATION('Gp106',(#13,#62),#7);
/* PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gp106','Gp106','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#62));
