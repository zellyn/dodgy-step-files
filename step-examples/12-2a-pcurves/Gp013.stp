ISO-10303-21;
/* Gp013 - CATIA "like-seam": two pcurves on near-closed BSpline surface
 * Defect: a B_SPLINE_SURFACE_WITH_KNOTS whose U=0 and U=1 boundaries
 * coincide within Precision::Confusion() but the surface is NOT declared
 * periodic (u_closed/v_closed = .F.). The shared edge has two pcurves
 * mimicking a seam, but generic seam handling misfires on the
 * non-periodic surface. */
HEADER;
FILE_DESCRIPTION(('Gp013 test case','CATIA like-seam on near-closed BSpline'),'2;1');
FILE_NAME('Gp013.stp','2026-04-27T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* 4-by-2 control net forming an almost-closed surface in U direction */
#100=CARTESIAN_POINT('',(10.0, 0.0,0.0));
#101=CARTESIAN_POINT('',(0.0,10.0,0.0));
#102=CARTESIAN_POINT('',(-10.0,0.0,0.0));
#103=CARTESIAN_POINT('',(10.0, 0.000001,0.0));
#110=CARTESIAN_POINT('',(10.0, 0.0,5.0));
#111=CARTESIAN_POINT('',(0.0,10.0,5.0));
#112=CARTESIAN_POINT('',(-10.0,0.0,5.0));
#113=CARTESIAN_POINT('',(10.0, 0.000001,5.0));
/* u_closed=.F., v_closed=.F. - critical: not declared periodic */
#20=B_SPLINE_SURFACE_WITH_KNOTS('',2,1,
  ((#100,#110),(#101,#111),(#102,#112),(#103,#113)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (3,1,3),(2,2),(0.0,0.5,1.0),(0.0,1.0),.UNSPECIFIED.);
/* 3D curve - line at the like-seam (U=0/U=1 join) */
#30=CARTESIAN_POINT('',(10.0,0.0,0.0));
#31=DIRECTION('',(0.0,0.0,1.0));
#32=VECTOR('',#31,1.0);
#33=LINE('',#30,#32);
#40=VERTEX_POINT('',#30);
#41=CARTESIAN_POINT('',(10.0,0.0,5.0));
#42=VERTEX_POINT('',#41);
/* First pcurve at U=0 */
#71=CARTESIAN_POINT('',(0.0,0.0));
#72=DIRECTION('',(0.0,1.0));
#73=VECTOR('',#72,1.0);
#74=LINE('',#71,#73);
#75=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#76=DEFINITIONAL_REPRESENTATION('',(#74),#75);
#77=PCURVE('',#20,#76);
/* Second pcurve at U=1 (the other side of the like-seam) */
#81=CARTESIAN_POINT('',(1.0,0.0));
#82=DIRECTION('',(0.0,1.0));
#83=VECTOR('',#82,1.0);
#84=LINE('',#81,#83);
#86=DEFINITIONAL_REPRESENTATION('',(#84),#75);
#87=PCURVE('',#20,#86);
/* Defect: two pcurves like a seam but #20 is non-periodic. */
#50=SURFACE_CURVE('',#33,(#77,#87),.PCURVE_S1.);
#60=EDGE_CURVE('',#40,#42,#50,.T.);
#61=ORIENTED_EDGE('',*,*,#60,.T.);
#62=EDGE_LOOP('',(#61));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#20,.T.);
ENDSEC;
END-ISO-10303-21;
