ISO-10303-21;
/* Gp139 - BRepBuilderAPI_Sewing.SameParameterEdge.seam-dual-pcurve-extraction
 * Defect: Seam edge on closed surface missing reversed PCurve.
 * Torus seam edge requires dual PCurve (forward + reversed) but only one supplied. */
HEADER;
FILE_DESCRIPTION(('Gp139 test case','seam dual pcurve extraction'),'2;1');
FILE_NAME('Gp139.stp','2026-06-16T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#4=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#5=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#6=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#3,'distance_accuracy_value','');
#7=( GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#6))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#3,#4,#5))
     REPRESENTATION_CONTEXT('','3D') );
/* Toroidal surface: major radius 50, minor radius 10 */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=TOROIDAL_SURFACE('torus_surf',#13,50.0,10.0);
/* 3D seam curve: minor circle at u=0 (closed along v) */
#20=CARTESIAN_POINT('',(60.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(0.0,1.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=CIRCLE('minor_circle',#23,10.0);
#25=TRIMMED_CURVE('seam_3d',#24,0.0,6.283185);
/* Vertices: start of minor circle */
#30=VERTEX_POINT('',(60.0,0.0,0.0));
#31=CARTESIAN_POINT('',(60.0,0.0,0.1));
#32=VERTEX_POINT('',#31);
/* Single PCurve only (u=0, v=0..2π): missing reversed variant */
#40=CARTESIAN_POINT('',(0.0,0.0));
#41=CARTESIAN_POINT('',(0.0,6.283185));
#42=DIRECTION('',(0.0,1.0));
#43=VECTOR('',#42,6.283185);
#44=LINE('pcurve_forward_only',#40,#43);
#45=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#46=DEFINITIONAL_REPRESENTATION('',(#44),#45);
#47=PCURVE('seam_pcurve_forward',#14,#46);
/* SEAM_CURVE with single pcurve (defect: should have dual) */
#50=SEAM_CURVE('seam_edge_incomplete',#25,(#47),.PCURVE_S1.);
#60=EDGE_CURVE('seam_minor',#30,#32,#50,.T.);
#61=ORIENTED_EDGE('',*,*,#60,.T.);
#62=EDGE_LOOP('',(#61));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#14,.T.);
#90=SHAPE_REPRESENTATION('Gp139',(#13,#64),#7);
/* PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gp139','Gp139','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#64));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
