ISO-10303-21;
/* Gp005 - Pcurve with single-pole apex on sphere/cone (singularity)
 * Defect: Outer loop on a CONICAL_SURFACE touches the cone apex
 * (semi-angle 30 deg). The vertex at the apex is a true UV singularity:
 * the apex point corresponds to V=0 with all U values, so projection
 * of the bordering pcurve through the apex is indeterminate. There is
 * no explicit degenerate edge marking the singularity. */
HEADER;
FILE_DESCRIPTION(('Gp005 test case','Pcurve with single-pole apex (singularity)'),'2;1');
FILE_NAME('Gp005.stp','2026-04-27T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Conical surface: apex at origin, semi-angle 30 deg = 0.5235987756 rad */
#20=CONICAL_SURFACE('',#13,0.0,0.5235987756);
/* Apex vertex at (0,0,0) - the singularity */
#40=CARTESIAN_POINT('',(0.0,0.0,0.0));
#41=VERTEX_POINT('',#40);
/* Off-apex vertex at half-angle slope: r=5 sin(30)=2.5, z=5 cos(30)=4.33 */
#42=CARTESIAN_POINT('',(2.5,0.0,4.330127));
#43=VERTEX_POINT('',#42);
/* 3D curve: line from apex along the U=0 generator */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=DIRECTION('',(0.5,0.0,0.866025));
#32=VECTOR('',#31,1.0);
#33=LINE('',#30,#32);
/* Pcurve in (U,V): from (U=0, V=0) to (U=0, V=5)
 * Defect: V=0 is the apex pole - all U map to the same 3D point.
 * Generic pcurves passing through the singular row corrupt projection. */
#71=CARTESIAN_POINT('',(0.0,0.0));
#72=DIRECTION('',(0.0,1.0));
#73=VECTOR('',#72,1.0);
#74=LINE('',#71,#73);
#75=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#70=DEFINITIONAL_REPRESENTATION('',(#74),#75);
#76=PCURVE('',#20,#70);
#50=SURFACE_CURVE('',#33,(#76),.PCURVE_S1.);
#60=EDGE_CURVE('',#41,#43,#50,.T.);
/* No DEGENERATE_EDGE provided at the apex; loop touches singularity. */
#61=ORIENTED_EDGE('',*,*,#60,.T.);
#62=EDGE_LOOP('',(#61));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#20,.T.);
ENDSEC;
END-ISO-10303-21;
