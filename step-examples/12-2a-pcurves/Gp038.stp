ISO-10303-21;
/* Gp038 - Vertex point and pcurve disagree beyond tolerance
 * Defect: an edge has start VERTEX at (1.0,0.0,0.0); its 3D LINE
 * agrees; but the bound PCURVE 2D LINE, when evaluated at parameter 0
 * on the host plane, places the start at (1.05,0.0). The 0.05 mismatch
 * exceeds typical 1.0e-6 vertex tolerance. */
HEADER;
FILE_DESCRIPTION(('Gp038 test case','Vertex point and pcurve disagree beyond tolerance'),'2;1');
FILE_NAME('Gp038.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Host plane */
#100=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#101=DIRECTION('z',(0.0,0.0,1.0));
#102=DIRECTION('x',(1.0,0.0,0.0));
#103=AXIS2_PLACEMENT_3D('',#100,#101,#102);
#104=PLANE('host',#103);
/* Vertices: V0 at (1,0,0), V1 at (2,0,0) */
#110=CARTESIAN_POINT('vertex_3d',(1.0,0.0,0.0));
#111=VERTEX_POINT('v0_at_1',#110);
#112=CARTESIAN_POINT('end_3d',(2.0,0.0,0.0));
#113=VERTEX_POINT('v1_at_2',#112);
/* 3D curve: LINE from V0 along +x */
#120=DIRECTION('+x',(1.0,0.0,0.0));
#121=VECTOR('vx',#120,1.0);
#122=LINE('e_3d',#110,#121);
/* PCURVE: 2D LINE whose param=0 image is (1.05, 0). 0.05 mismatch */
#130=CARTESIAN_POINT('vertex_pcurve_eval',(1.05,0.0));
#131=DIRECTION('puv_dir',(1.0,0.0));
#132=VECTOR('puv_vec',#131,1.0);
#133=LINE('e_pc',#130,#132);
#134=DEFINITIONAL_REPRESENTATION('e_pc_def',(#133),#103);
#135=PCURVE('e_pc',#104,#134);
/* SURFACE_CURVE wiring 3D and 2D parameterisations together */
#140=SURFACE_CURVE('e_sc',#122,(#135),.PCURVE_S1.);
/* EDGE_CURVE explicitly using V0 and V1 — the disagreement between
 * V0's 3D position (1,0,0) and the pcurve's parameter-0 image (1.05,0)
 * is the cited tolerance breach. */
#141=EDGE_CURVE('vertex_pcurve_disagree',#111,#113,#140,.T.);
ENDSEC;
END-ISO-10303-21;
