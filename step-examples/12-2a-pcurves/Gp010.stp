ISO-10303-21;
/* Gp010 - SURFACE_CURVE.associated_geometry contains 3D curve in lieu of pcurve
 * Defect: instead of a PCURVE in (u,v), the associated_geometry list holds
 * a 3D LINE that lies in the host PLANE. Mathematically valid for flat
 * surfaces but breaks importers that hardcode 2D parameter form. */
HEADER;
FILE_DESCRIPTION(('Gp010 test case','associated_geometry holds 3D curve not pcurve'),'2;1');
FILE_NAME('Gp010.stp','2026-04-27T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Host plane (z=0) */
#20=PLANE('',#13);
/* 3D curve - line on the plane from (0,0,0) to (1,0,0) */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=DIRECTION('',(1.0,0.0,0.0));
#32=VECTOR('',#31,1.0);
#33=LINE('',#30,#32);
#40=VERTEX_POINT('',#30);
#41=CARTESIAN_POINT('',(1.0,0.0,0.0));
#42=VERTEX_POINT('',#41);
/* Defect: associated_geometry below uses a 3D LINE (#43) instead of a PCURVE.
 * Parasolid-style emit; receivers expecting PCURVE here mis-handle. */
#43=LINE('',#30,#32);
#50=SURFACE_CURVE('',#33,(#43),.PCURVE_S1.);
#60=EDGE_CURVE('',#40,#42,#50,.T.);
#61=ORIENTED_EDGE('',*,*,#60,.T.);
#62=EDGE_LOOP('',(#61));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#20,.T.);
ENDSEC;
END-ISO-10303-21;
