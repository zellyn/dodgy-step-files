/* Toroidal surface with singularities at meridian endpoints */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=TOROIDAL_SURFACE('torus_singular',#13,3.0,1.0);
/* 3D curve traversing torus meridian */
