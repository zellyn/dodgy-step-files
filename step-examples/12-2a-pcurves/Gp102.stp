ISO-10303-21;
/* Gp102 - ShapeFix_Edge.FixAddPCurve toroidal projection
 * Defect: edge on torus near minor radius singularity; FixAddPCurve's projection
 * diverges and the resulting pcurve is mathematically wrong. */
HEADER;
FILE_DESCRIPTION(('Gp102 test case','FixAddPCurve toroidal projection'),'2;1');
FILE_NAME('Gp102.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#4=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#5=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#6=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#3,'distance_accuracy_value','');
#7=( GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#6))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#3,#4,#5))
     REPRESENTATION_CONTEXT('','3D') );
/* Torus: major radius 10, minor radius 2 */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=TOROIDAL_SURFACE('torus',#13,10.0,2.0);
/* 3D curve near minor singularity: spiral on torus at v close to 0 */
#20=CARTESIAN_POINT('',(12.0,0.0,0.0));
#21=DIRECTION('',(0.0,1.0,0.0));
#22=DIRECTION('',(0.0,0.0,1.0));
#23=AXIS2_PLACEMENT_3D('',#20,#22,#21);
#24=B_SPLINE_CURVE_WITH_KNOTS('spiral_torus',.UNSPECIFIED.,.F.,.F.,
  ((#40,#41,#42,#43)),#23,
  2,
  (0.0,0.33,0.67,1.0),
  (0.0,0.33,0.67,1.0),
  .UNSPECIFIED.);
#40=CARTESIAN_POINT('',(12.0,0.0,0.0));
#41=CARTESIAN_POINT('',(11.8,0.3,0.1));
#42=CARTESIAN_POINT('',(12.2,0.6,0.2));
#43=CARTESIAN_POINT('',(12.0,1.0,0.3));
/* Vertices */
#50=VERTEX_POINT('',(12.0,0.0,0.0));
#51=CARTESIAN_POINT('',(12.0,1.0,0.3));
#52=VERTEX_POINT('',#51);
/* PCURVE: B-spline on torus surface (u,v) with singularity effect */
#60=CARTESIAN_POINT('',(0.0,0.1));
#61=DIRECTION('',(1.0,0.0));
#62=DIRECTION('',(0.0,1.0));
#63=AXIS2_PLACEMENT_2D('',#60,#61);
#64=B_SPLINE_CURVE_WITH_KNOTS('pcurve_torus',.UNSPECIFIED.,.F.,.F.,
  ((#70,#71,#72,#73)),#63,
  2,
  (0.0,0.33,0.67,1.0),
  (0.0,0.33,0.67,1.0),
  .UNSPECIFIED.);
#70=CARTESIAN_POINT('',(0.0,0.1));
#71=CARTESIAN_POINT('',(1.5,0.05));
#72=CARTESIAN_POINT('',(3.0,0.15));
#73=CARTESIAN_POINT('',(4.5,0.2));
/* PCURVE wrapped with divergence issue */
#75=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#76=DEFINITIONAL_REPRESENTATION('',(#64),#75);
#77=PCURVE('pcurve_diverge',#14,#76);
/* SURFACE_CURVE without pcurve initially (FixAddPCurve will fail) */
#80=SURFACE_CURVE('edge_gp102',#24,(),.PCURVE_S1.);
#81=EDGE_CURVE('edge',#50,#52,#80,.T.);
#82=ORIENTED_EDGE('',*,*,#81,.T.);
#83=EDGE_LOOP('',(#82));
#84=FACE_OUTER_BOUND('',#83,.T.);
#85=ADVANCED_FACE('',(#84),#14,.T.);
#90=SHAPE_REPRESENTATION('Gp102',(#13,#85),#7);
/* PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gp102','Gp102','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#85));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
