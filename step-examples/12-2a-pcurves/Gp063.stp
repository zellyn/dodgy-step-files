ISO-10303-21;
/* Gp063 - ShapeAnalysis_Edge.CheckOverlapping bounded-curve trim
 * Defect: two edges share same 3D curve but with non-overlapping trim ranges.
 * CheckOverlapping doesn't intersect trims properly and reports false overlap. */
HEADER;
FILE_DESCRIPTION(('Gp063 test case','CheckOverlapping bounded-curve trim'),'2;1');
FILE_NAME('Gp063.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
