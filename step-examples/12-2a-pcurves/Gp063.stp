#31=DIRECTION('',(0.0,0.0,1.0));
#32=VECTOR('',#31,20.0);
#33=LINE('',#30,#32);
/* Edge 1: uses 3D curve trimmed from 0 to 5, vertex points at 0.0 and 5.0 */
#40=VERTEX_POINT('',(10.0,0.0,0.0));
#41=VERTEX_POINT('',(10.0,0.0,5.0));
/* PCurve 1 - line in (u,v) space from v=0 to v=5 */
#50=CARTESIAN_POINT('',(0.0,0.0));
#51=DIRECTION('',(0.0,1.0));
#52=VECTOR('',#51,5.0);
#53=LINE('',#50,#52);
#54=PCURVE('',#20,#53);
#60=SURFACE_CURVE('',#33,(#54),.PCURVE_S1.);
#70=EDGE_CURVE('',#40,#41,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#70,.T.);
#72=EDGE_LOOP('',(#71));
#73=FACE_OUTER_BOUND('',#72,.T.);
#74=ADVANCED_FACE('',(#73),#20,.T.);
/* Edge 2: SAME 3D curve #33 but trimmed from 10 to 15, no overlap with edge 1
 * This simulates non-overlapping trim ranges on shared curve */
#80=VERTEX_POINT('',(10.0,0.0,10.0));
#81=VERTEX_POINT('',(10.0,0.0,15.0));
/* PCurve 2 - line in (u,v) space from v=10 to v=15 */
#90=CARTESIAN_POINT('',(0.0,10.0));
#91=DIRECTION('',(0.0,1.0));
#92=VECTOR('',#91,5.0);
#93=LINE('',#90,#92);
#94=PCURVE('',#20,#93);
#100=SURFACE_CURVE('',#33,(#94),.PCURVE_S1.);
#110=EDGE_CURVE('',#80,#81,#100,.T.);
#111=ORIENTED_EDGE('',*,*,#110,.T.);
#112=EDGE_LOOP('',(#111));
#113=FACE_OUTER_BOUND('',#112,.T.);
#114=ADVANCED_FACE('',(#113),#20,.T.);
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
