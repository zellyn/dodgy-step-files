ISO-10303-21;
/* Gp141 - ShapeAnalysis_Edge.GetEndTangent2d B001
 * Defect: missing pcurve extraction fails tangent calculation.
 * Edge without pcurve on given surface; GetEndTangent2d returns zero vector
 * instead of signaling missing data.
 */
HEADER;
FILE_DESCRIPTION(('Gp141 test case','GetEndTangent2d missing pcurve'),'2;1');
