ISO-10303-21;
/* Gp142 - ShapeAnalysis_Edge.GetEndTangent2d B002
 * Defect: negligible parameter delta (< Precision::PConfusion) skips
 * tangent difference computation; finite difference becomes epsilon.
 */
HEADER;
FILE_DESCRIPTION(('Gp142 test case','GetEndTangent2d negligible delta'),'2;1');
FILE_NAME('Gp142.stp','2026-06-16T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
