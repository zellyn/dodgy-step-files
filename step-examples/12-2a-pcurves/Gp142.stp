#45=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#46=DEFINITIONAL_REPRESENTATION('',(#43),#45);
#47=PCURVE('pcurve_tiny_range',#14,#46);
/* SURFACE_CURVE */
#50=SURFACE_CURVE('edge_tiny_range',#23,(#47),.PCURVE_S1.);
#60=EDGE_CURVE('edge_gp142',#30,#32,#50,.T.);
#61=ORIENTED_EDGE('',*,*,#60,.T.);
#62=EDGE_LOOP('',(#61));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#14,.T.);
#90=SHAPE_REPRESENTATION('Gp142',(#13,#64),#7);
/* PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
