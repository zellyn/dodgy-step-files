ISO-10303-21;
/* Gp113 - ShapeAnalysis_Edge.CheckOverlapping different-curves-same-geometry
 * Defect: two edges where one is LINE and the other is BSpline approximation
 * of the same line. CheckOverlapping's curve-type-aware comparison reports them
 * not overlapping despite equivalent geometry. */
HEADER;
FILE_DESCRIPTION(('Gp113 test case','LINE and BSpline approximation - CheckOverlapping mismatch'),'2;1');
FILE_NAME('Gp113.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* First 3D curve: LINE from (0,0,0) to (10,0,0) */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=DIRECTION('',(1.0,0.0,0.0));
#32=VECTOR('',#31,1.0);
#33=LINE('',#30,#32);
#40=CARTESIAN_POINT('',(0.0,0.0,0.0));
#41=VERTEX_POINT('',#40);
#42=CARTESIAN_POINT('',(10.0,0.0,0.0));
#43=VERTEX_POINT('',#42);
/* Vertices for second edge */
#44=VERTEX_POINT('',#40);
#45=VERTEX_POINT('',#42);
/* Second 3D curve: B-spline approximation of same line */
#80=CARTESIAN_POINT('',(0.0,0.0,0.0));
#81=CARTESIAN_POINT('',(5.0,0.0,0.0));
#82=CARTESIAN_POINT('',(10.0,0.0,0.0));
#83=B_SPLINE_CURVE_WITH_KNOTS('',3,(#80,#81,#82),.UNSPECIFIED.,.F.,.F.,(2,2),(0.0,1.0),.UNSPECIFIED.);
/* First edge with LINE */
#50=SURFACE_CURVE('',#33,(),.PCURVE_S1.);
#60=EDGE_CURVE('',#41,#43,#50,.T.);
/* Second edge with BSpline */
#84=SURFACE_CURVE('',#83,(),.PCURVE_S1.);
#85=EDGE_CURVE('',#44,#45,#84,.T.);
/* Bundle both into a single loop to expose overlap check */
#61=ORIENTED_EDGE('',*,*,#60,.T.);
#86=ORIENTED_EDGE('',*,*,#85,.T.);
#62=EDGE_LOOP('',(#61,#86));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#20,.T.);
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gp113','Gp113','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9020=CLOSED_SHELL('',(#9011));
