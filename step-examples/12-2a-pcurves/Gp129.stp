ISO-10303-21;
/* Gp129 - ShapeAnalysis_Curve.Project degenerate-curve NaN handling
 * Defect: ShapeAnalysis_Curve::Project returns NaN when projecting degenerate
 * curves. Comparison NaN < f evaluates false, causing return false via
 * dist > tol path, silently masking degenerate projection failure. */
HEADER;
FILE_DESCRIPTION(('Gp129 test case','ShapeAnalysis_Curve.Project degenerate NaN'),'2;1');
FILE_NAME('Gp129.stp','2026-06-16T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#4=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#5=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#6=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#3,'distance_accuracy_value','');
#7=( GEOMETRIC_REPRESENTATION_CONTEXT(3)
