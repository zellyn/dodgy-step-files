ISO-10303-21;
/* Gp179: Bottom edge of a standard 4-edge rectangular PLANE face: 3D LINE is shifted +0.5 in Y (start=(0,0.5,0)) so NEITHER endpoint of the curve is within tolerance of its VERTEX_POINT (A=(0,0,0), B=(10,0,0) -- both 0.5 units off). PCURVE is the correct, trustworthy straight line (0,0)->(10,0) in UV. Mirror-image of Gp064's pcurve-side FixRemovePCurve case: here FixRemoveCurve3d should discard the 3D curve and rebuild it from the pcurve. */
HEADER;
FILE_DESCRIPTION(('Gp179'),'2;1');
FILE_NAME('Gp179.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
