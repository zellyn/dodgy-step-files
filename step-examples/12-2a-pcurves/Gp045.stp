ISO-10303-21;
/* Gp045 - ShapeFix_Edge.FixSameParameter BSpline range-trap corruption
 * Defect: recomputing SameParameter copies the edge into a new TEdge but
 * the range-trap means the new edge has stale parameter range when curve
 * is BSpline. The 3D curve is a B-spline with knot domain [0.0, 1.0].
 * When FixSameParameter copies the edge, it preserves the old range bounds
 * but the new BSpline's actual knot domain is different, causing parameter
 * mismatch between the 3D curve and PCURVE on recomputation. */
HEADER;
FILE_DESCRIPTION(('Gp045 test case','FixSameParameter BSpline range-trap corruption'),'2;1');
FILE_NAME('Gp045.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#4=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#5=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#6=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#3,'distance_accuracy_value','');
#7=( GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#6))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#3,#4,#5))
     REPRESENTATION_CONTEXT('','3D') );
/* Host plane */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('host_plane',#13);
/* 3D curve: B-spline with explicit knot domain [0.0, 1.0] */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(2.5,1.0));
#22=CARTESIAN_POINT('',(5.0,2.0));
#23=CARTESIAN_POINT('',(7.5,1.5));
#24=CARTESIAN_POINT('',(10.0,0.0));
#25=B_SPLINE_CURVE_WITH_KNOTS('bspline_3d',2,(#20,#21,#22,#23,#24),
  .UNSPECIFIED.,.F.,.F.,
  (3,1,1,3),(0.0,0.333,0.667,1.0),.UNSPECIFIED.);
/* Vertices with parameter bounds that will become stale */
#30=VERTEX_POINT('',(0.0,0.0,0.0));
#31=CARTESIAN_POINT('',(10.0,0.0,0.0));
#32=VERTEX_POINT('',#31);
/* PCURVE B-spline matching the 3D curve's parametric structure */
#40=CARTESIAN_POINT('',(0.0,0.0));
#41=CARTESIAN_POINT('',(2.5,0.5));
#42=CARTESIAN_POINT('',(5.0,1.0));
#43=CARTESIAN_POINT('',(7.5,0.75));
#44=CARTESIAN_POINT('',(10.0,0.0));
#45=B_SPLINE_CURVE_WITH_KNOTS('bspline_pcurve',2,(#40,#41,#42,#43,#44),
  .UNSPECIFIED.,.F.,.F.,
  (3,1,1,3),(0.0,0.333,0.667,1.0),.UNSPECIFIED.);
#46=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#47=DEFINITIONAL_REPRESENTATION('',(#45),#46);
#48=PCURVE('pcurve_range_trap',#14,#47);
/* SURFACE_CURVE with BSpline that will have range corruption on copy */
#50=SURFACE_CURVE('edge_range_trap',#25,(#48),.PCURVE_S1.);
#60=EDGE_CURVE('edge_gp045',#30,#32,#50,.T.);
#61=ORIENTED_EDGE('',*,*,#60,.T.);
#62=EDGE_LOOP('',(#61));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#14,.T.);
#90=SHAPE_REPRESENTATION('Gp045',(#13,#64),#7);
/* Wrap: PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gp045','Gp045','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#64));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
