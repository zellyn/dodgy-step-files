ISO-10303-21;
/* Gp029 - FixShifted on revolved face leaves wire in inconsistent UV band
 * Defect: face on a SURFACE_OF_REVOLUTION whose pcurves were shifted
 * by 2pi - some endpoints land in [0, 2pi] and some in [2pi, 4pi].
 * After FixShifted attempts a global shift, the loop is not in a
 * single self-consistent band. BRepMesh refuses to mesh. */
HEADER;
FILE_DESCRIPTION(('Gp029 test case','FixShifted leaves inconsistent UV band'),'2;1');
FILE_NAME('Gp029.stp','2026-04-27T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=AXIS1_PLACEMENT('',#10,#11);
/* Revolution profile: line segment from (5,0,0) to (5,0,5) */
#13=CARTESIAN_POINT('',(5.0,0.0,0.0));
#14=DIRECTION('',(0.0,0.0,1.0));
#15=VECTOR('',#14,1.0);
#16=LINE('',#13,#15);
/* Surface of revolution */
#20=SURFACE_OF_REVOLUTION('',#16,#12);
/* Vertices on the revolved surface */
#40=CARTESIAN_POINT('',(5.0,0.0,0.0));
#41=VERTEX_POINT('',#40);
#42=CARTESIAN_POINT('',(5.0,0.0,5.0));
#43=VERTEX_POINT('',#42);
#44=CARTESIAN_POINT('',(-5.0,0.0,5.0));
#45=VERTEX_POINT('',#44);
#46=CARTESIAN_POINT('',(-5.0,0.0,0.0));
#47=VERTEX_POINT('',#46);
/* 3D edges: (V0->V1) U=0 generator; (V1->V2) top-circle half-arc;
 *           (V2->V3) U=pi generator;     (V3->V0) bottom-circle half-arc */
#33=DIRECTION('',(0.0,0.0,1.0));
#34=VECTOR('',#33,1.0);
#35=LINE('',#40,#34);
#36=LINE('',#46,#34);
#50=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Defect: pcurves with INCONSISTENT band - bottom edge runs U=0, top edge runs U=2pi
 * (a 2pi shift of the same V), so wire endpoints span [0, 2pi+pi] */
#71=CARTESIAN_POINT('',(0.0,0.0));      /* edge1 start (V0) */
#72=DIRECTION('',(0.0,1.0));
#73=VECTOR('',#72,1.0);
#74=LINE('',#71,#73);
#75=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#76=DEFINITIONAL_REPRESENTATION('',(#74),#75);
#77=PCURVE('',#20,#76);
/* Top edge - SHIFTED into [2pi, 3pi] band */
#81=CARTESIAN_POINT('',(6.28318,5.0));
#82=DIRECTION('',(1.0,0.0));
#83=VECTOR('',#82,3.14159);
#84=LINE('',#81,#83);
#85=DEFINITIONAL_REPRESENTATION('',(#84),#75);
#86=PCURVE('',#20,#85);
/* Left edge V at U=pi NOT shifted */
#91=CARTESIAN_POINT('',(3.14159,5.0));
#92=DIRECTION('',(0.0,-1.0));
#93=VECTOR('',#92,1.0);
#94=LINE('',#91,#93);
#95=DEFINITIONAL_REPRESENTATION('',(#94),#75);
#96=PCURVE('',#20,#95);
/* Bottom arc back to V0 */
#101=CARTESIAN_POINT('',(3.14159,0.0));
#102=DIRECTION('',(-1.0,0.0));
#103=VECTOR('',#102,3.14159);
#104=LINE('',#101,#103);
#105=DEFINITIONAL_REPRESENTATION('',(#104),#75);
#106=PCURVE('',#20,#105);
/* 4 surface curves, 4 edges */
#110=SURFACE_CURVE('',#35,(#77),.PCURVE_S1.);
#111=SURFACE_CURVE('',#16,(#86),.PCURVE_S1.);
#112=SURFACE_CURVE('',#36,(#96),.PCURVE_S1.);
#113=SURFACE_CURVE('',#16,(#106),.PCURVE_S1.);
#120=EDGE_CURVE('',#41,#43,#110,.T.);
#121=EDGE_CURVE('',#43,#45,#111,.T.);
#122=EDGE_CURVE('',#45,#47,#112,.T.);
#123=EDGE_CURVE('',#47,#41,#113,.T.);
#130=ORIENTED_EDGE('',*,*,#120,.T.);
#131=ORIENTED_EDGE('',*,*,#121,.T.);
#132=ORIENTED_EDGE('',*,*,#122,.T.);
#133=ORIENTED_EDGE('',*,*,#123,.T.);
#62=EDGE_LOOP('',(#130,#131,#132,#133));
