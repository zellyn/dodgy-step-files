ISO-10303-21;
/* Gp098 - ShapeAnalysis_Edge.CheckOverlapping arc-tangent-to-line
 * Defect: two edges where an arc is tangent to a line at a single point.
 * CheckOverlapping reports "they overlap at one point" which is technically
 * true but misleading—tangency is not the same as overlap. */
HEADER;
FILE_DESCRIPTION(('Gp098 test case','CheckOverlapping arc-tangent-to-line'),'2;1');
FILE_NAME('Gp098.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#4=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#5=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#6=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#3,'distance_accuracy_value','');
#7=( GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#6))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#3,#4,#5))
     REPRESENTATION_CONTEXT('','3D') );
/* Host plane */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('host_plane',#13);
/* Horizontal line from (-2,0,0) to (2,0,0) */
#20=CARTESIAN_POINT('',(-2.0,0.0,0.0));
#21=CARTESIAN_POINT('',(2.0,0.0,0.0));
#22=LINE('line_horizontal',#20,#21);
/* Circle centered at (0,1,0) with radius 1, tangent to line at (0,0,0) */
#23=CARTESIAN_POINT('',(0.0,1.0,0.0));
#24=AXIS2_PLACEMENT_3D('',#23,#11,#12);
#25=CIRCLE('circle_tangent',#24,1.0);
/* Trimmed arc from tangent point to beyond */
#26=TRIMMED_CURVE('arc_tangent',#25,(0.0,3.14159265358979323846),.T.,.PARAMETER.);
/* Vertices for line edge */
#30=VERTEX_POINT('',#20);
#31=VERTEX_POINT('',#21);
/* Vertices for arc edge */
#32=VERTEX_POINT('',(0.0,0.0,0.0));
#33=CARTESIAN_POINT('',(0.0,2.0,0.0));
#34=VERTEX_POINT('',#33);
/* PCURVE for line */
#40=CARTESIAN_POINT('',(-2.0,0.0));
#41=CARTESIAN_POINT('',(2.0,0.0));
#42=LINE('pcurve_line',#40,#41);
#43=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#44=DEFINITIONAL_REPRESENTATION('',(#42),#43);
#45=PCURVE('pcurve_line_2d',#14,#44);
#50=SURFACE_CURVE('edge_line_surf',#22,(#45),.PCURVE_S1.);
#60=EDGE_CURVE('edge_line',#30,#31,#50,.T.);
/* PCURVE for arc */
#70=CARTESIAN_POINT('',(0.0,1.0));
#71=CIRCLE('pcurve_arc_circle',#70,1.0);
#72=TRIMMED_CURVE('pcurve_arc',#71,(0.0,3.14159265358979323846),.T.,.PARAMETER.);
#73=DEFINITIONAL_REPRESENTATION('',(#72),#43);
#74=PCURVE('pcurve_arc_2d',#14,#73);
#75=SURFACE_CURVE('edge_arc_surf',#26,(#74),.PCURVE_S1.);
#76=EDGE_CURVE('edge_arc',#32,#34,#75,.T.);
/* Wire with both edges - they touch at tangent point */
#80=ORIENTED_EDGE('',*,*,#60,.T.);
#81=ORIENTED_EDGE('',*,*,#76,.T.);
#82=EDGE_LOOP('',(#80,#81));
#83=FACE_OUTER_BOUND('',#82,.T.);
#84=ADVANCED_FACE('',(#83),#14,.T.);
#90=SHAPE_REPRESENTATION('Gp098',(#13,#84),#7);
/* PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gp098','Gp098','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#84));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
