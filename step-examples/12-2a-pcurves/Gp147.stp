ISO-10303-21;
/* Gp147 - ShapeAnalysis_Edge.GetEndTangent2d D2 zero fallback to D3
 * Defect: pcurve at symmetric point where D2 derivative vanishes.
 * GetEndTangent2d cascades to D3 without intermediate validation. */
HEADER;
FILE_DESCRIPTION(('Gp147 test case','GetEndTangent2d D2 zero fallback'),'2;1');
FILE_NAME('Gp147.stp','2026-06-16T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
