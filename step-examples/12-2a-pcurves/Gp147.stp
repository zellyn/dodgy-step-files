#48=DEFINITIONAL_REPRESENTATION('',(#46),#47);
#49=PCURVE('pcurve_quartic_d2zero',#14,#48);
/* SURFACE_CURVE */
#50=SURFACE_CURVE('edge_quartic',#25,(#49),.PCURVE_S1.);
#60=EDGE_CURVE('edge_gp147',#30,#32,#50,.T.);
