ISO-10303-21;
/* Ad031 - Use-after-free on header-mode-handle reuse
   ----------------------------------------------------------------------
   Catalog section : §12.11 adversarial / parser robustness (sub-class: UAF)
   Sources         : 12-adversarial.md A031; ZDI-24-268 / CVE-2024-1847
                     (eDrawings UAF on file reading)
   See also        : Ad084
   Severity        : H
   ----------------------------------------------------------------------
   WARNING: This file is INTENTIONALLY MALFORMED. It is a test input for
   parser-robustness checks, NOT a valid STEP exchange document.
   ----------------------------------------------------------------------
   Defect
     Parser opens a header-parsing context, frees its transient allocator
     on ENDSEC;, but a deferred diagnostic emitter still holds a pointer
     into header strings. The attack vector is a malformed
     FILE_DESCRIPTION whose diagnostic is queued (not flushed) until well
     after the header arena is destroyed; the eventual flush dereferences
     freed memory.
   Reproducer recipe
     Header with malformed FILE_DESCRIPTION (missing implementation_level
     argument so a deferred diagnostic is queued) followed by a valid
     DATA section whose translation triggers the diagnostic flush.
   Expected kernel behavior
     Own all diagnostic-bound strings via a long-lived diagnostic arena,
     never alias parser-temp memory. Emit E_HEADER_MALFORMED at the time
     of the parse error; do not defer past arena destruction.
   ----------------------------------------------------------------------
*/
HEADER;
/* Defect: FILE_DESCRIPTION missing the implementation_level argument
   (only one positional arg). Diagnostic captures pointer into the
   description string and queues for later emission. */
FILE_DESCRIPTION(('Ad031 - malformed header triggers deferred diagnostic'));
FILE_NAME('Ad031.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#20=DIRECTION('z',(0.0,0.0,1.0));
#30=DIRECTION('x',(1.0,0.0,0.0));
#40=AXIS2_PLACEMENT_3D('placement',#10,#20,#30);
ENDSEC;
END-ISO-10303-21;
