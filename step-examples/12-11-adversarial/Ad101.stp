ISO-10303-21;
/* Ad101 - FixEdgeCurves throws Standard_OutOfRange
 * Defect: open wire of 3 edges. The first FixEdgeCurves step
 * removes the last edge (because it fails some check). Subsequent
 * iteration code accesses edges[3] (the now-removed slot), throwing
 * Standard_OutOfRange. */
HEADER;
FILE_DESCRIPTION(('Ad101 test case','FixEdgeCurves throws Standard_OutOfRange'),'2;1');
FILE_NAME('Ad101.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));#101=VERTEX_POINT('',#100);
#102=CARTESIAN_POINT('',(1.0,0.0,0.0));#103=VERTEX_POINT('',#102);
#104=CARTESIAN_POINT('',(2.0,0.0,0.0));#105=VERTEX_POINT('',#104);
#106=CARTESIAN_POINT('',(3.0,0.0,0.0));#107=VERTEX_POINT('',#106);
#110=DIRECTION('+x',(1.0,0.0,0.0));
#111=VECTOR('vx',#110,1.0);
#120=LINE('e0',#100,#111);
#121=LINE('e1',#102,#111);
#122=LINE('e2',#104,#111);
/* Three EDGE_CURVEs forming an open wire v0->v1->v2->v3 */
#130=EDGE_CURVE('edge_0_kept',#101,#103,#120,.T.);
#131=EDGE_CURVE('edge_1_kept',#103,#105,#121,.T.);
#132=EDGE_CURVE('edge_2_to_be_removed',#105,#107,#122,.T.);
#140=ORIENTED_EDGE('',*,*,#130,.T.);
#141=ORIENTED_EDGE('',*,*,#131,.T.);
#142=ORIENTED_EDGE('',*,*,#132,.T.);
/* Open EDGE_LOOP referencing all three edges */
#150=EDGE_LOOP('open_3edge_wire',(#140,#141,#142));
ENDSEC;
END-ISO-10303-21;
