ISO-10303-21;
/* Symlink-following attack payload (CWE-59 / CWE-22):
   Attack scenario: fixture path Ad114.stp is a symlink
   pointing to /etc/passwd (or ~/.ssh/id_rsa, /proc/self/environ).

   ln -s /etc/passwd /path/to/research/step-examples/12-11-adversarial/Ad114.stp

   A receiver that opens the fixture path without O_NOFOLLOW
   will read ~3 KB of 'root:x:0:0:..' bytes into its Part-21 tokeniser.
   The load fails (non-Part-21 content) but the privileged bytes have
   already been read into the process address space and may appear in:
     - error messages logged to disk or transmitted over the network
     - crash dumps captured by the OS or monitoring systems
     - telemetry payloads sent to the vendor

   Required mitigations:
     1. Open with O_NOFOLLOW (POSIX) or CreateFile with
        FILE_FLAG_OPEN_REPARSE_POINT (Windows) to refuse symlink targets.
     2. Resolve the real path and verify it is within the configured root
        before reading any bytes (Path.resolve() + is_relative_to()).
     3. Never include raw file bytes from a failed parse in error messages.

   Static fixture is document-only: no real symlink is created in the repo
   (cross-platform-unfriendly). See also: Ad106 (TOCTOU on EXTERNAL_FILE),
   Ad113 (sibling-pair race), Ad115 (directory-entry race).
   Target path: /etc/passwd, /proc/self/environ, ~/.ssh/id_rsa
*/
/* Ad114: STEP fixture path is a symlink to /etc/passwd or other privileged file; receiver that opens path without O_NOFOLLOW reads privileged bytes into Part-21 tokeniser; bytes may appear in error messages or telemetry; receiver must refuse to open paths whose resolved location is outside a configured root; refuse to follow symlinks unless explicitly enabled; check O_NOFOLLOW-style flags on open; CWE-59 (symlink following); CWE-22 (path traversal); provenance tier: cross-file-state — static fixture is document-only: no real symlink created in repo; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Ad114'),'2;1');
FILE_NAME('Ad114.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
ENDSEC;
END-ISO-10303-21;
