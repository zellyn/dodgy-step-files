/* Ad047 - Negative or invalid face area after fixshape
   ----------------------------------------------------------------------
   Catalog section : §12.11 adversarial (sub-class: schema-validation)
   Sources         : 03-occt-tests.md R075 (bug28523)
   See also        : Ad043
   ----------------------------------------------------------------------
   WARNING: This file is INTENTIONALLY MALFORMED for parser-robustness
   testing. Do NOT use as exchange data.
   ----------------------------------------------------------------------
   Defect
     fixshape reverses face orientation, producing a negative computed
     area downstream. Trigger: input file has one face whose outer-bound
     orientation flag (.T./.F.) disagrees with the underlying surface
     normal direction; ShapeFix flips orientation idempotently-incorrectly
     and the area integral comes out negative.
   Reproducer recipe
     ADVANCED_FACE whose orientation flag is .F. while its
     FACE_OUTER_BOUND.orientation is .T. and the surface normal points
     +Z; ShapeFix flips and the recomputed area is negative.
   Expected kernel behavior
     Post-fix invariant check: area must be > 0. If negative, flip
     once more or emit E_FIXSHAPE_NEGATIVE_AREA. Idempotency is required.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ad047 - face orientation flag inverse of surface normal'),
  '2;1');
FILE_NAME('Ad047.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
