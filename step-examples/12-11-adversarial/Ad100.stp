ISO-10303-21;
/* Ad100 - Memory leak during STEP read into XCAF
 * Defect: entity-graph table holds strong refs to entities not in final shape; doc destruction doesnt walk graph */
HEADER;
FILE_DESCRIPTION(('Ad100 test case','Memory leak during STEP read into XCAF'),'2;1');
FILE_NAME('Ad100.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('part1','part1','part1',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
/* Memory leak defect - manifests across many sequential reads. */

ENDSEC;
END-ISO-10303-21;
