ISO-10303-21;
/* Ad112 - Nested gzip-of-gzip-of-... .stpz triggers N-level recursive
 * decompression
 * Defect: a receiver that auto-detects gzip framing and decompresses
 * transparently before tokenising will, on input that is gzip-of-
 * gzip-of-...-of-Part-21, recurse into each layer. With N stacked
 * layers (8 layers at 1:100 each yields 1:10^16 aggregate ratio) the
 * receiver's recursion or per-layer buffer overflows. Distinct from
 * Ad110 (single-layer ratio) - this entry attacks layering depth.
 * Provenance tier: cross-file-state. */
HEADER;
FILE_DESCRIPTION(('Ad112 - nested gzip recursion .stpz of .stpz of ... (witness only)'),'2;1');
FILE_NAME('Ad112.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
/* Witness body: the nested gzip wrapper is not present in this Part-21
   fixture; the bug-reporter searchable terms (nested, recursive, gzip,
   .stpz, depth, recursion) are in this file's header and comments.
   The actual exploit is a Part-21 body wrapped in 8 successive gzip
   layers (each layer's input is the previous layer's gzip output);
   compressed final size is a few KB, decompressed final size is 100
   MB+, and unwrapping requires 8 sequential gunzip passes. */
/* nested gzip recursion depth 8 - .stpz of .stpz of .stpz */
#1=APPLICATION_CONTEXT('automotive_design');
#10=CARTESIAN_POINT('benign',(0.0,0.0,0.0));
ENDSEC;
END-ISO-10303-21;
