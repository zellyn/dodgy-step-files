ISO-10303-21;
/* Ad049: malformed REAL literals: '1.0D5' (Fortran D-exponent), '1_000.0' (underscore separator), '1.5e+02' (lowercase e), '(1,0,0)' (INTEGER coordinates without decimal point); Stepcode silently coerces INTEGER→REAL hiding unit-corruption bugs; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Ad049'),'2;1');
FILE_NAME('Ad049.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#3=DIRECTION('integer_coords',(1,0,0));
#4=DIRECTION('fortran_d_exp',(1.0D5,0.,0.));
#5=DIRECTION('underscore_sep',(1_000.0,0.0,0.0));
#6=DIRECTION('lowercase_e_exp',(1.5e+02,0.0,0.0));
#7=CARTESIAN_POINT('int_point',(0,0,0));
ENDSEC;
END-ISO-10303-21;
