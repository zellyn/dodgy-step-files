ISO-10303-21;
/* Ad137: ADVANCED_FACE on a PLANE (z=0); its sole boundary is a self-loop EDGE_CURVE whose 3D geometry is a SURFACE_CURVE wrapping a COMPOSITE_CURVE ('mixed_segment_composite_curve') of TWO COMPOSITE_CURVE_SEGMENTs: good_composite_segment_line (an ordinary LINE, genuinely constructible) and degenerate_composite_segment_bspline (a B_SPLINE_CURVE_WITH_KNOTS whose knot vector (1.0,0.5,2.0) is NOT monotonically non-decreasing -- schema-legal bytes, numerically invalid geometry that throws Standard_ConstructionError when Geom_BSplineCurve actually tries to construct it); StepToTopoDS_TranslateCompositeCurve::Init's per-segment try/catch IS the mechanism under test -- the bad segment should be dropped, not the whole composite curve/edge/face aborted; EDGE_CURVE IS wired into FACE_OUTER_BOUND, ADVANCED_FACE, OPEN_SHELL; never orphaned */
HEADER;
FILE_DESCRIPTION(('Ad137'),'2;1');
FILE_NAME('Ad137.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=DIRECTION('',(0.0,0.0,1.0));
#3=DIRECTION('',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('',#1,#2,#3);
#5=PLANE('',#4);
#6=(GEOMETRIC_REPRESENTATION_CONTEXT(2)PARAMETRIC_REPRESENTATION_CONTEXT()REPRESENTATION_CONTEXT('UV','2D'));
#7=CARTESIAN_POINT('',(0.0,0.0,0.0));
#8=VERTEX_POINT('',#7);
#9=DIRECTION('',(1.0,0.0,0.0));
#10=VECTOR('',#9,1.0);
#11=LINE('good_composite_segment_line',#7,#10);
#12=CARTESIAN_POINT('',(1.0,0.0,0.0));
#13=CARTESIAN_POINT('',(1.5,0.3,0.0));
#14=CARTESIAN_POINT('',(2.0,0.0,0.0));
#15=B_SPLINE_CURVE_WITH_KNOTS('degenerate_composite_segment_bspline',2,(#12,#13,#14),.UNSPECIFIED.,.F.,.F.,(3,3),(1.0,0.5,2.0),.UNSPECIFIED.);
#16=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#11);
#17=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#15);
#18=COMPOSITE_CURVE('mixed_segment_composite_curve',(#16,#17),.F.);
#19=CARTESIAN_POINT('',(0.0,0.0));
#20=DIRECTION('',(1.0,0.0));
#21=VECTOR('',#20,2.0);
#22=LINE('',#19,#21);
#23=DEFINITIONAL_REPRESENTATION('',(#22),#6);
#24=PCURVE('',#5,#23);
#25=SURFACE_CURVE('',#18,(#24),.PCURVE_S1.);
#26=EDGE_CURVE('',#8,#8,#25,.T.);
#27=ORIENTED_EDGE('',$,$,#26,.T.);
#28=EDGE_LOOP('',(#27));
#29=FACE_OUTER_BOUND('',#28,.T.);
#30=ADVANCED_FACE('',(#29),#5,.T.);
#31=OPEN_SHELL('',(#30));
#32=SHELL_BASED_SURFACE_MODEL('',(#31));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Ad137','Ad137','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#32),#9060);
