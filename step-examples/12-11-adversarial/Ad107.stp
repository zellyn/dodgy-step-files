       <!ENTITY lol "lol">
       <!ENTITY lol1 "&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;">
       <!ENTITY lol2 "&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;">
       ...
       <!ENTITY lol9 "&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;">
     ]>
     <step><name>&lol9;</name></step>
   The DTD declarations are not legal inside Part-21; they are shown here
   inside a comment so receivers can grep for the marker even though the
   actual exploit lives in the XML wrapper. */
/* <!DOCTYPE step [<!ENTITY lol "lol"><!ENTITY lol9 "&lol8;...">]> */
/* &lol9; expands to 10^9 copies of "lol" - a billion laughs */
