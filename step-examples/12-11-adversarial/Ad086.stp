ISO-10303-21;
/* Ad086: translator silently masks segfault-class faults as 'transfer failed'; AXIS2_PLACEMENT_3D.location → PRODUCT_DEFINITION (type confusion); CARTESIAN_POINT with 2-coord arity mismatch; CARTESIAN_POINT with coordinate 1.0E+999 (overflow); LINE direction VECTOR references CARTESIAN_POINT where DIRECTION required; Q078; R073; See also Ad043; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Ad086'),'2;1');
FILE_NAME('Ad086.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#3=CARTESIAN_POINT('arity_mismatch',(1.0,2.0));
#4=CARTESIAN_POINT('overflow_coord',(1.0E+999,0.0,0.0));
#5=AXIS2_PLACEMENT_3D('type_confused_loc',#9054,$,$);
#6=CARTESIAN_POINT('wrong_type_for_dir',(1.0,0.0,0.0));
#7=VECTOR('bad_dir_ref',#6,1.0);
#8=LINE('type_confused_line',#1,#7);
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Ad086','Ad086','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#2),#9060);
