ISO-10303-21;
/* Ad080 - token-boundary attack: ENDSEC;DATA; concatenated twice
   Source: STEP_PROBLEM_CATALOG.md §12.11 Ad080;
           mining 12-adversarial.md A025.
   Pattern: two `ENDSEC;DATA;` framing markers concatenated into a single
           file. Greedy regex parsers may match across boundaries and
           merge the two DATA sections, or skip the first ENDSEC and
           treat the second DATA as a continuation.
   Reproducer recipe (per catalog):
           ...ENDSEC;DATA;...ENDSEC;DATA;...ENDSEC;
   Expected kernel behavior: per ISO-10303-21 Ed.2, exactly one DATA
           section per file - reject any subsequent DATA. Ed.3 admits
           multi-section but each section must declare its schema.
   This fixture supplies two DATA sections in an Ed.2-mode file
   (FILE_DESCRIPTION '2;1') so a strict reader MUST reject the second
   DATA. License-clean: hand-synthesized. */
HEADER;
FILE_DESCRIPTION(
  ('Ad080 - duplicate DATA sections, Ed.2 mode'),
  '2;1');
FILE_NAME('Ad080.stp','2026-04-26T00:00:00',
  ('auto-generated'),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('SECTION-A','first DATA','',(#3));
#5=PRODUCT_DEFINITION_FORMATION('','',#4);
#6=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
ENDSEC;
DATA;
/* second DATA section - illegal in Ed.2.
   the ID space silently collides: a permissive parser may either
   overwrite #1..#7 or merge both sections into one symbol table. */
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('SECTION-B','second DATA','',(#3));
#5=PRODUCT_DEFINITION_FORMATION('','',#4);
#6=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
#10=PROPERTY_DEFINITION('marker','this entity proves merge',#7);
ENDSEC;
END-ISO-10303-21;
