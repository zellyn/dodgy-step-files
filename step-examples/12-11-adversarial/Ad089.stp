ISO-10303-21;
/* Ad089 - Trailing comma in parameter list
 * Defect: CARTESIAN_POINT record ends with trailing comma; parser reads next entity as missing parameter */
HEADER;
FILE_DESCRIPTION(('Ad089 test case','Trailing comma in parameter list'),'2;1');
FILE_NAME('Ad089.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#100=CARTESIAN_POINT('trailing_comma',(1.0,2.0,3.0,));
#101=CARTESIAN_POINT('next',(0.0,0.0,0.0));
ENDSEC;
END-ISO-10303-21;
