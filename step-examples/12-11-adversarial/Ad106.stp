ISO-10303-21;
/* Ad106: EXTERNAL_FILE URI resolves through a symlink; receiver performs stat then open — TOCTOU race; symlink target may change between check and open, causing receiver to read a different file than it validated; receiver must open path once and stat the resulting fd; must not re-resolve path between check and open; must refuse to follow symlinks unless explicitly enabled; must reject EXTERNAL_FILE paths resolving outside configured root; CWE-367; ISO 10303-21 Ed.3 §8 REFERENCE/EXTERNAL_FILE; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Ad106'),'2;1');
FILE_NAME('Ad106.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#3=EXTERNAL_FILE('companion_widget',('/tmp/parts/widget.stp'),'application/step',$);
#4=/* TOCTOU race payload:
   EXTERNAL_FILE path: /tmp/parts/widget.stp
   Receiver checks access('/tmp/parts/widget.stp') then
   open('/tmp/parts/widget.stp') — two separate syscalls.
   Between the stat and the open, an attacker swaps the symlink:
     /tmp/parts/widget.stp -> /tmp/parts/safe.stp  (at stat time)
     /tmp/parts/widget.stp -> /etc/shadow          (at open time)
   Receiver reads /etc/shadow despite validating /tmp/parts/safe.stp.
   Fix: open-then-fstat; never re-resolve path after initial open. */
CARTESIAN_POINT('toctou_note',(0.0,0.0,0.0));
ENDSEC;
REFERENCE;
/* EXTERNAL_FILE /tmp/parts/widget.stp resolves through a symlink;
   TOCTOU race: symlink target can be swapped between stat and open.
   companion file: widget.stp */
ENDSEC;
END-ISO-10303-21;
