ISO-10303-21;
/* Ad083 - duplicate-name children defeat label-keyed flat-load
   Source: STEP_PROBLEM_CATALOG.md §12.11 Ad083;
           mining 18-other-issues.md I021 (CadQuery #1962, KiCad), I077;
           03-occt-tests.md R057.
   Pattern: KiCad reuses one PRODUCT for many NEXT_ASSEMBLY_USAGE_OCCURRENCE
           instances (e.g., the same resistor footprint placed 50 times).
           Each NAUO is unique by entity ID, but they all carry the same
           PRODUCT name 'R0402'. CadQuery's flat-load uses a label-keyed
           dict and raises ValueError on the first collision.
   Reproducer recipe (per catalog): cq.Assembly.load("mobo-3D.step") on
           any KiCad-emitted STEP with repeat footprints.
   Expected kernel behavior: treat IDs (entity #) as primary keys;
           disambiguate names (e.g., 'R0402#1', 'R0402#2'); never fail
           on duplicate names.
   This fixture: one parent assembly, three NAUO children that all
   share the same PRODUCT name. License-clean: hand-synthesized. */
HEADER;
FILE_DESCRIPTION(
  ('Ad083 - duplicate child names defeat label-keyed assembly loader'),
  '2;1');
FILE_NAME('Ad083.stp','2026-04-26T00:00:00',
  ('auto-generated'),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
/* parent. */
#4=PRODUCT('PCB','main board','',(#3));
#5=PRODUCT_DEFINITION_FORMATION('','',#4);
#6=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
/* three children that share PRODUCT name 'R0402' - the duplicate-key
   trigger. Each child has its own PRODUCT/PDF/PD chain (distinct
   entity IDs) but identical name string. */
#10=PRODUCT('R0402','R0402 SMT resistor footprint','',(#3));
#11=PRODUCT_DEFINITION_FORMATION('','',#10);
#12=PRODUCT_DEFINITION('design','',#11,#6);
#20=PRODUCT('R0402','R0402 SMT resistor footprint','',(#3));
#21=PRODUCT_DEFINITION_FORMATION('','',#20);
#22=PRODUCT_DEFINITION('design','',#21,#6);
#30=PRODUCT('R0402','R0402 SMT resistor footprint','',(#3));
#31=PRODUCT_DEFINITION_FORMATION('','',#30);
#32=PRODUCT_DEFINITION('design','',#31,#6);
/* NAUOs. Reference designators encoded in the NAUO id slot ('R1','R2','R3')
   are the only place the loader could disambiguate, but most label-keyed
   assemblers ignore the NAUO id and key on the child PRODUCT name. */
#40=NEXT_ASSEMBLY_USAGE_OCCURRENCE('R1','','',#7,#12,$);
#41=NEXT_ASSEMBLY_USAGE_OCCURRENCE('R2','','',#7,#22,$);
#42=NEXT_ASSEMBLY_USAGE_OCCURRENCE('R3','','',#7,#32,$);
ENDSEC;
END-ISO-10303-21;
