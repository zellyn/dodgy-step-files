/* ============================================================
   WARNING: THIS FILE IS INTENTIONALLY MALFORMED.
   It exists ONLY for parser-robustness / fuzz-class testing.
   DO NOT feed to a production translator without sandboxing.

   Entry  : Ad027
   Title  : STEP "zip bomb" — many tiny instances exhaust
            memory through O(N) instance tables and O(N x K)
            reverse-reference maps.
   Defect : This catalogued fixture declares a relatively
            modest run of CARTESIAN_POINT instances. A real
            fuzz fixture would include 10^6 - 10^7 such
            instances; even a 50 MB file with 5M tiny entity
            declarations holding 100 references each can
            expand to ~40 GB resident in many readers.
            Pattern documented in CAD Exchanger floating-
            crash class (#A027/A040).
   Expected: streaming-friendly architecture; configurable
             max_instances; abort with E_INSTANCE_LIMIT.
   See also: Ad032, Ad057.
   ============================================================ */
HEADER;
FILE_DESCRIPTION(('Ad027 instance-count zip bomb'),'2;1');
FILE_NAME('Ad027.stp','2026-04-26T00:00:00',('synthetic'),('cad-research'),
  'none','none','none');
