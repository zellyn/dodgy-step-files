ISO-10303-21;
/* Ad052: self-referential external file assignment: APPLIED_EXTERNAL_IDENTIFICATION_ASSIGNMENT whose target path resolves to the main file under translation; reader loops forever on self-ref; Mantis 0031711; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Ad052'),'2;1');
FILE_NAME('Ad052.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#3=EXTERNAL_SOURCE(('Ad052.step'));
#4=EXTERNAL_IDENTIFICATION_ASSIGNMENT('self','self-referential file',#3);
#5=APPLIED_EXTERNAL_IDENTIFICATION_ASSIGNMENT(#4,(#1));
#6=EXTERNAL_SOURCE(('./Ad052.step'));
#7=EXTERNAL_IDENTIFICATION_ASSIGNMENT('self2','relative self-ref',#6);
#8=APPLIED_EXTERNAL_IDENTIFICATION_ASSIGNMENT(#7,(#1));
ENDSEC;
END-ISO-10303-21;
