/* Ad035 - IGES-style 80-column padding sensitivity (shared translator paths)
   ----------------------------------------------------------------------
   Catalog section : §12.11 adversarial (sub-class: framing / OOB-read)
   Sources         : 12-adversarial.md A039
   Severity        : Medium
   ----------------------------------------------------------------------
   WARNING: This file is INTENTIONALLY MALFORMED for parser-robustness
   testing. It mixes IGES-style fixed-column padding and an off-by-one
   record count to exercise the shared IGES/STEP translator code path.
   Do NOT use as exchange data.
   ----------------------------------------------------------------------
   Defect
     IGES Directory-Entry uses fixed 80-column records; a record with
     non-space padding or off-by-one record count crashes parsers that
     index columns 73..80 unconditionally. This matters in STEP because
     translators (e.g. ASMIMPORT, IfcOpenShell IGES path) commonly share
     code paths between IGES and STEP framing. STEP files placed in
     pipelines that try IGES first can trigger the IGES OOB path.
   Reproducer recipe
     STEP file whose first non-comment line is shorter than 80 columns
     yet declares an IGES-style record count one greater than the
     physical line count. Below: a comment block masquerading as IGES
     directory padding that mis-reports its terminator count.
   Expected kernel behavior
     Bound all column indexes against actual line length. Do not blindly
     read 80 columns. Detect ISO-10303-21 magic before any IGES probe.
   ----------------------------------------------------------------------
*/
/*S0000001                                                                S0000001*/
/*G0000002                                                                G0000002*/
/*D0000003                                                                D0000004*/
/*P0000005                                                                P0000005*/
/*T0000099S0000001G0000001D0000002P0000001                                T0000001*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ad035 - IGES 80-col padding fronting STEP body'),'2;1');
FILE_NAME('Ad035.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#20=DIRECTION('z',(0.0,0.0,1.0));
#30=DIRECTION('x',(1.0,0.0,0.0));
#40=AXIS2_PLACEMENT_3D('placement',#10,#20,#30);
ENDSEC;
END-ISO-10303-21;
