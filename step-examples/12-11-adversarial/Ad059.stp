ISO-10303-21;
/* Ad059: mismatched weight/pole count in RATIONAL_B_SPLINE_CURVE: weights (1.,1.,1.) has 3 entries but poles list has 4 entries; reader walks past end of weights vector → OOB-read; writer-emitted bug: Mantis 0030921 (G024); See also Gn002; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Ad059'),'2;1');
FILE_NAME('Ad059.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#3=CARTESIAN_POINT('p0',(0.,0.,0.));
#4=CARTESIAN_POINT('p1',(1.,1.,0.));
#5=CARTESIAN_POINT('p2',(2.,0.,0.));
#6=CARTESIAN_POINT('p3',(3.,1.,0.));
#7=(B_SPLINE_CURVE_WITH_KNOTS('mismatch',3,(#3,#4,#5,#6),.UNSPECIFIED.,.F.,.F.,(4,4),(0.,1.),.PIECEWISE_BEZIER_KNOTS.)RATIONAL_B_SPLINE_CURVE((1.,1.,1.)));
#8=RATIONAL_B_SPLINE_CURVE((1.,1.,1.));
ENDSEC;
END-ISO-10303-21;
