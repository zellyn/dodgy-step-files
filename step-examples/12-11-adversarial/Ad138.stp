ISO-10303-21;
/* Ad138: GEOMETRIC_CURVE_SET (the shape representation's own item, a real translation root) with TWO B_SPLINE_CURVE_WITH_KNOTS elements of identical structure differing only in their knot vector: 'good_bspline_element' with monotonically increasing knots (0.0,1.0) and 'throwing_bspline_element' with DECREASING knots (1.0,0.5) which Geom_BSplineCurve's constructor rejects by raising Standard_ConstructionError; the per-element try/catch around the geometric-set element's own curve construction IS the mechanism under test -- the throwing element must be logged and skipped while the good element still produces its edge in the output compound; both curves ARE elements of the root GEOMETRIC_CURVE_SET, never orphaned */
HEADER;
FILE_DESCRIPTION(('Ad138'),'2;1');
FILE_NAME('Ad138.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=CARTESIAN_POINT('',(1.0,0.0,0.0));
#3=B_SPLINE_CURVE_WITH_KNOTS('good_bspline_element',1,(#1,#2),.UNSPECIFIED.,.F.,.F.,(2,2),(0.0,1.0),.UNSPECIFIED.);
#4=CARTESIAN_POINT('',(0.0,1.0,0.0));
#5=CARTESIAN_POINT('',(1.0,1.0,0.0));
#6=B_SPLINE_CURVE_WITH_KNOTS('throwing_bspline_element',1,(#4,#5),.UNSPECIFIED.,.F.,.F.,(2,2),(1.0,0.5),.UNSPECIFIED.);
#7=GEOMETRIC_CURVE_SET('ad138_element_catch_set',(#3,#6));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Ad138','Ad138','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#7),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
END-ISO-10303-21;
