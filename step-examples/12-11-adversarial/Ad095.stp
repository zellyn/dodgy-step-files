ISO-10303-21;
/* Ad095: Pro/Engineer legacy STEP files combine entities in patterns reader did not anticipate; STYLED_ITEM with positional arguments swapped from spec order; MAPPED_ITEM referencing itself transitively; vendor-conditional handling must tolerate known legacy patterns; OCCT MANTIS#0026461, #0025699; See also Ad081; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Ad095'),'2;1');
FILE_NAME('Ad095.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#3=STYLED_ITEM('Pro/E_swapped_styled',(#2),());
#4=/* Pro/E v2001 vendor string: Pro/Engineer 2001 legacy output */
CARTESIAN_POINT('Pro/E_probe',(1.0,0.0,0.0));
#5=MAPPED_ITEM('Pro_self_ref_mapped',#2,#5);
ENDSEC;
END-ISO-10303-21;
