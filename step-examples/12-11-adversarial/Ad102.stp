ISO-10303-21;
/* Ad102: bare-edge HLR shape: EDGE_CURVEs with no incident face; STEP writer expects every edge to belong to a face; segfaults on bare-edge / bare-vertex HLR result; writer must handle bare shapes via WIRE_SHELL representation with no face references; must not crash on bare shapes; OCCT MANTIS#0027070; See also Tsh037; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Ad102'),'2;1');
FILE_NAME('Ad102.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
