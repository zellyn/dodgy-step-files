ISO-10303-21;
/* Ad051: negative entity references (#-1, #-2) and out-of-range IDs; legacy negative numbers yield NULL via lookup; ADVANCED_FACE and SHAPE_REPRESENTATION referencing #-1; out-of-range #9999999 reference; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Ad051'),'2;1');
FILE_NAME('Ad051.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#3=ADVANCED_FACE('neg_ref',(#-1),#-2,.T.);
#4=SHAPE_REPRESENTATION('neg_sr',(#-1),#-2);
#5=MANIFOLD_SOLID_BREP('out_of_range',#9999999);
#6=VERTEX_POINT('neg_vertex',#-3);
ENDSEC;
END-ISO-10303-21;
