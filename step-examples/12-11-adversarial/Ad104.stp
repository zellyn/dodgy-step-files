ISO-10303-21;
/* Ad104 - STEP-XML wrapper with DTD external-entity reference (XXE)
 * Defect: a STEP-XML (.stpx) file with an internal DTD declaring an
 * external entity. XML parsers with XXE enabled fetch the resource and
 * inline it. This fixture is shown in .stp form for cataloguing; the
 * actual attack surface is .stpx. Provenance tier: cross-file-state. */
HEADER;
FILE_DESCRIPTION(('Ad104 - STEP-XML wrapper carries DTD with XXE entity'),'2;1');
FILE_NAME('Ad104.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
/* Witness fixture: the .stp body is benign. The defect lives in the
   .stpx XML prologue:
     <?xml version="1.0"?>
     <!DOCTYPE step [<!ENTITY xxe SYSTEM "file:///etc/passwd">]>
     <step>...&xxe;...</step>
   The DTD declaration is not legal inside Part-21; it is shown here
   inside a comment so receivers can grep for the marker even though
   the actual exploit lives in the XML wrapper. */
/* <!DOCTYPE step [<!ENTITY xxe SYSTEM "file:///etc/passwd">]> */
#1=APPLICATION_CONTEXT('automotive_design');
#10=CARTESIAN_POINT('benign',(0.0,0.0,0.0));
ENDSEC;
END-ISO-10303-21;
