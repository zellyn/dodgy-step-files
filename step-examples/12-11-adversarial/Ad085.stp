/* Ad085 - composite-curve-segment self-cyclic reference
   Source: STEP_PROBLEM_CATALOG.md §12.11 Ad085;
           mining 04-occt-translation.md Q023.
   Pattern: a COMPOSITE_CURVE owns a list of COMPOSITE_CURVE_SEGMENTs;
           each segment's `parent_curve` slot points at a curve. Cycle
           is constructed by having a segment's parent_curve be the
           composite curve that owns the segment, creating an A->B->A
           reference loop.
   Reproducer recipe (per catalog):
           #1 = COMPOSITE_CURVE('',(#2),.T.);
           #2 = COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#1);
   Expected kernel behavior: cycle-detect during composite-curve
           assembly (Tarjan SCC during reference-graph bind);
           reject with E_CURVE_CYCLE or equivalent recoverable
           diagnostic, never recurse to stack exhaustion.
   This fixture also contains a longer A->B->C->A cycle so a fuzzer
   can verify cycle detection survives non-trivial loop length.
   License-clean: hand-synthesized. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(
  ('Ad085 - cyclic composite curve reference'),
  '2;1');
FILE_NAME('Ad085.stp','2026-04-26T00:00:00',
  ('auto-generated'),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('Ad085','cycle probe','',(#3));
#5=PRODUCT_DEFINITION_FORMATION('','',#4);
#6=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
/* trivial 2-cycle: #100 owns segment #101 whose parent is #100. */
#100=COMPOSITE_CURVE('selfCycle',(#101),.T.);
#101=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#100);
/* 3-cycle through an intermediate: #200 owns #201 whose parent is
   #210; #210 owns #211 whose parent is #200. Tarjan must see this. */
#200=COMPOSITE_CURVE('A',(#201),.T.);
#201=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#210);
#210=COMPOSITE_CURVE('B',(#211),.T.);
#211=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#200);
/* a *non*-cyclic composite curve so any robust loader can still
   succeed on the well-formed parts of the file after rejecting
   the cyclic ones. */
#300=CARTESIAN_POINT('',(0.0,0.0,0.0));
#301=CARTESIAN_POINT('',(1.0,0.0,0.0));
#302=VERTEX_POINT('',#300);
#303=VERTEX_POINT('',#301);
#304=DIRECTION('',(1.0,0.0,0.0));
#305=VECTOR('',#304,1.0);
#306=LINE('',#300,#305);
#307=EDGE_CURVE('',#302,#303,#306,.T.);
#308=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#306);
#309=COMPOSITE_CURVE('clean',(#308),.T.);
ENDSEC;
END-ISO-10303-21;
