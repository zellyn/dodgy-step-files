ISO-10303-21;
/* Ad085: COMPOSITE_CURVE whose segment list references COMPOSITE_CURVE_SEGMENT that references back the parent curve (self-cycle); cycle-detect must reject with E_CURVE_CYCLE; OCC silently accepts with empty result; Q023; See also Ad004, Gs035, Pf010; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Ad085'),'2;1');
FILE_NAME('Ad085.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#3=COMPOSITE_CURVE('',( #4),.T.);
#4=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#3);
#5=COMPOSITE_CURVE('a',(#7),.T.);
#6=COMPOSITE_CURVE('b',(#8),.T.);
#7=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#6);
#8=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#5);
ENDSEC;
END-ISO-10303-21;
