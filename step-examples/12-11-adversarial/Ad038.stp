ISO-10303-21;
/* Ad038 - File concatenation produces conflicting IDs and dual end-markers
   ----------------------------------------------------------------------
   Catalog section : §12.11 adversarial (sub-class: framing / schema-validation)
   Sources         : 07-stepcode-ifcopenshell.md T015, T027, T028;
                     16-iso-spec.md N034
   See also        : Lh002, Lh022
   ----------------------------------------------------------------------
   WARNING: This file is INTENTIONALLY MALFORMED for parser-robustness
   testing. It is the textual result of `cat a.stp b.stp > merged.stp`.
   Do NOT use as exchange data.
   ----------------------------------------------------------------------
   Defect
     Naive `cat a.stp b.stp` yields two ISO-10303-21; openers, two
     END-ISO-10303-21; closers, and overlapping #NNN entity IDs.
     Stepcode STEPfile::AppendExchangeFile ID-renumbering misses
     references inside multi-dimensional aggregates inside complex
     records, leaving dangling references after merge.
   Reproducer recipe
     `cat file1.stp file2.stp > merged.stp` (verbatim concatenation,
     no renumbering, no merge of HEADER/DATA sections).
   Expected kernel behavior
     Reject second ISO-10303-21; open marker; require ID-rewrite that
     visits every '#' token recursively through nested aggregates and
     complex-record components. Emit E_DUPLICATE_FRAMING.
   ----------------------------------------------------------------------
*/
HEADER;
FILE_DESCRIPTION(('Ad038 part A - first half of cat-merge'),'2;1');
FILE_NAME('Ad038.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#10=CARTESIAN_POINT('A_origin',(0.0,0.0,0.0));
#20=DIRECTION('A_z',(0.0,0.0,1.0));
#30=DIRECTION('A_x',(1.0,0.0,0.0));
#40=AXIS2_PLACEMENT_3D('A_placement',#10,#20,#30);
ENDSEC;
END-ISO-10303-21;
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ad038 part B - second half of cat-merge'),'2;1');
FILE_NAME('Ad038_b.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Defect: ID #10 and #20 collide with part A. */
#10=CARTESIAN_POINT('B_origin',(5.0,5.0,5.0));
#20=DIRECTION('B_z',(0.0,1.0,0.0));
#30=DIRECTION('B_x',(0.0,0.0,1.0));
#40=AXIS2_PLACEMENT_3D('B_placement',#10,#20,#30);
ENDSEC;
END-ISO-10303-21;
