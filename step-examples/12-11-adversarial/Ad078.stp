ISO-10303-21;
/* Ad078 - NEXT_ASSEMBLY_USAGE_OCCURRENCE child as PRODUCT_DEFINITION_SHAPE
   Source: STEP_PROBLEM_CATALOG.md §12.11 Ad078;
           mining 08-occt-gitlog.md G016 (Mantis 0025167);
           03-occt-tests.md R049.
   Pattern: in AP214/AP203, NAUO's relating/related slots are typed as a
           SELECT that admits both PRODUCT_DEFINITION and
           PRODUCT_DEFINITION_SHAPE. A schema-strict reader rejects PDS
           (treating only PD as legal); a permissive reader cast across
           vtables and produced silently corrupt assembly trees.
   Reproducer recipe: NAUO whose `related_product_definition` slot
           references PDS (#9) instead of PD (#7).
   Expected kernel behavior: accept PDS child; resolve PDS->PD silently
           with a warning; emit hard error if neither type matches.
   This file mixes one valid NAUO (PD->PD) with one adversarial NAUO
   (PD->PDS) so a fuzzer can test both paths in a single fixture.
   License-clean: synthesized minimal assembly. */
HEADER;
FILE_DESCRIPTION(
  ('Ad078 - NAUO child mistyped as PRODUCT_DEFINITION_SHAPE'),
  '2;1');
FILE_NAME('Ad078.stp','2026-04-26T00:00:00',
  ('auto-generated'),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('PARENT','parent assembly','',(#3));
#5=PRODUCT_DEFINITION_FORMATION('','',#4);
#6=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=PRODUCT('CHILD-A','child A','',(#3));
#11=PRODUCT_DEFINITION_FORMATION('','',#10);
#12=PRODUCT_DEFINITION('design','',#11,#6);
#13=PRODUCT_DEFINITION_SHAPE('','',#12);
#20=PRODUCT('CHILD-B','child B','',(#3));
#21=PRODUCT_DEFINITION_FORMATION('','',#20);
#22=PRODUCT_DEFINITION('design','',#21,#6);
#23=PRODUCT_DEFINITION_SHAPE('','',#22);
/* well-typed NAUO: PD parent (#7) -> PD child (#12). */
#30=NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','wellTyped','',#7,#12,$);
/* ADVERSARIAL NAUO: PD parent (#7) -> PDS child (#23) instead of PD.
   Schema-strict readers raise; permissive readers vtable-cast and
   may corrupt the assembly tree. Robust readers should resolve
   PDS->PD via the represented_product_definition link with a warn. */
#31=NEXT_ASSEMBLY_USAGE_OCCURRENCE('2','misTyped','',#7,#23,$);
/* triple-mistype: parent and child both PDS (some legacy emitters). */
#32=NEXT_ASSEMBLY_USAGE_OCCURRENCE('3','bothMisTyped','',#8,#13,$);
ENDSEC;
END-ISO-10303-21;
