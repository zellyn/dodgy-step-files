ISO-10303-21;
/* Ad099 - Self-intersection-fix infinite loop
 * Defect: a wire whose pcurves describe a small self-tangent loop
 *   (a teardrop/cusp at the apex). The fix-self-intersections pass
 *   keys its visited-segment map on segment ID only, so it
 *   re-visits the same segment forever. */
HEADER;
FILE_DESCRIPTION(('Ad099 test case','Self-intersection-fix infinite loop'),'2;1');
FILE_NAME('Ad099.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Host plane */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('+z',(0.0,0.0,1.0));
#12=DIRECTION('+x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('axes',#10,#11,#12);
#14=PLANE('host',#13);
/* Single vertex at the cusp */
#20=CARTESIAN_POINT('cusp_pt',(0.0,0.0,0.0));
#21=VERTEX_POINT('cusp',#20);
/* 3D curve: closed teardrop traced as a degree-2 B-spline whose
 * control polygon visits the apex twice with self-tangency. */
#30=CARTESIAN_POINT('lobe_a',(1.0,0.5,0.0));
#31=CARTESIAN_POINT('lobe_b',(1.0,-0.5,0.0));
#32=B_SPLINE_CURVE_WITH_KNOTS('teardrop_3d',2,
  (#20,#30,#31,#20),
  .UNSPECIFIED.,.F.,.T.,
  (3,1,3),(0.0,0.5,1.0),.UNSPECIFIED.);
/* Pcurve: 2D B-spline with the SAME control structure on the host
 * plane, so its self-tangency is a pure pcurve self-intersection. */
#40=CARTESIAN_POINT('pc_cusp',(0.0,0.0));
#41=CARTESIAN_POINT('pc_lobe_a',(1.0,0.5));
#42=CARTESIAN_POINT('pc_lobe_b',(1.0,-0.5));
#43=B_SPLINE_CURVE_2D('teardrop_pc',2,
  (#40,#41,#42,#40),
  .UNSPECIFIED.,.F.,.T.,
  (3,1,3),(0.0,0.5,1.0),.UNSPECIFIED.);
#44=DEFINITIONAL_REPRESENTATION('pc_def',(#43),#13);
#45=PCURVE('teardrop_pc',#14,#44);
#50=SURFACE_CURVE('teardrop_sc',#32,(#45),.PCURVE_S1.);
#60=EDGE_CURVE('teardrop_self_tangent',#21,#21,#50,.T.);
#61=ORIENTED_EDGE('',*,*,#60,.T.);
#62=EDGE_LOOP('teardrop_loop',(#61));
ENDSEC;
END-ISO-10303-21;
