ISO-10303-21;
/* Ad077 - signed-integer attribute used as unsigned causes 4 GB loop walk
   Source: STEP_PROBLEM_CATALOG.md §12.11 Ad077; CVE-2024-23133
           (Autodesk ASMDATAX228A.dll on .stp).
   Pattern: the consumer reads a count attribute and computes
           `for(i = 0; i < n - 1; i++)` over an aggregate. When the
           aggregate is empty (n == 0) and `n` is unsigned (or treated
           as unsigned), `n - 1` underflows to 0xFFFFFFFF and the loop
           walks 4 GB of memory before wrapping. CWE-191 (integer
           underflow) confirmed in the CVE.
   Reproducer recipe (per catalog): zero-length aggregate where
           downstream code expects >= 1.
   Expected kernel behavior: pre-validate count > 0 before any
           `count - 1` arithmetic; treat empty aggregates as a no-op
           rather than a wrap-around walk.
   The trigger here is COMPOSITE_CURVE with an empty segment list and
   B_SPLINE_CURVE_WITH_KNOTS with an empty knot multiplicity vector;
   either path tickles the off-by-one downstream of the count read.
   File is INTENTIONALLY adversarial. License-clean: hand-synthesized. */
HEADER;
FILE_DESCRIPTION(
  ('Ad077 - empty aggregate triggers count-1 underflow'),
  '2;1');
FILE_NAME('Ad077.stp','2026-04-26T00:00:00',
  ('auto-generated'),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('Ad077','underflow probe','',(#3));
#5=PRODUCT_DEFINITION_FORMATION('','',#4);
#6=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
/* zero-length aggregate #1: empty composite curve segment list.
   downstream loop computes seg_count - 1 -> wraps to UINT32_MAX. */
#10=COMPOSITE_CURVE('Ad077-empty-segs',(),.T.);
/* zero-length aggregate #2: B-spline knots/multiplicities/control
   points all empty. downstream loop computes knots-1 -> wraps. */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=B_SPLINE_CURVE_WITH_KNOTS('Ad077-empty-knots',
  3,(#20),.UNSPECIFIED.,.F.,.F.,(),(),.UNSPECIFIED.);
/* zero-length aggregate #3: face_bound list empty on advanced face.
   downstream loop computes bounds-1 -> wraps. */
#30=DIRECTION('',(0.0,0.0,1.0));
#31=DIRECTION('',(1.0,0.0,0.0));
#32=AXIS2_PLACEMENT_3D('',#20,#30,#31);
#33=PLANE('',#32);
#34=ADVANCED_FACE('Ad077-empty-bounds',(),#33,.T.);
/* zero-length aggregate #4: closed shell with no faces. */
#40=CLOSED_SHELL('Ad077-empty-shell',());
#41=MANIFOLD_SOLID_BREP('Ad077-empty-brep',#40);
ENDSEC;
END-ISO-10303-21;
