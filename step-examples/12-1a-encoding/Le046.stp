ISO-10303-21;
/* Le046: String literal containing every legal printable ASCII character (0x20..0x7E); ISO 10303-21 Ed.3 §6.4.4: all printable ASCII bytes are legal inside string literals; embedded apostrophe must be doubled (''); embedded backslash is a literal in Ed.2 but begins a directive in Ed.3; token-boundary characters '=' '#' ';' are legal inside string context but mishandled by parsers that do not track string state; defect: kernel that does not handle every printable-ASCII byte correctly will mis-parse one of: '' apostrophe, backslash, '=' '#' ';'; round-trip every printable ASCII byte through encode/decode/storage byte-for-byte; heal and accept; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Le046'),'2;1');
FILE_NAME('Le046.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
