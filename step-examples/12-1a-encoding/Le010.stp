/* Le010 — \F\ font-shift directive consumed wrongly
   Defect: \F\ is a single-character alternate-font selector, exactly one
   letter follows. This file emits an HTML-style multi-letter tag
   ('mix\F\katakana hello') as written by tools that mistake \F\ for an
   open/close tag. A greedy parser may consume the wrong number of bytes. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Le010 - F font-shift directive consumed wrongly'),'2;1');
FILE_NAME('Le010.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* multi-letter tag after \F\ — only the first letter is the operand */
#10=PERSON('p1','mix\F\katakana hello','given',$,$,$,$,$);
/* paired \F\..\F\ as if HTML-style tag */
#11=PERSON('p2','start\F\bold middle\F\bold end','given',$,$,$,$,$);
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
ENDSEC;
END-ISO-10303-21;
