/* Le057 - Records terminated with ;\n plus extra blank lines between records
 * Defect: ISO 10303-21 6.2 allows arbitrary whitespace between records;
 * the record terminator is `;`. This fixture emits a non-canonical
 * mix of EOR formatting: some records end with `;\n` and the next
 * begins immediately, others end with `;\n\n` (blank line between),
 * and one record runs `;` followed by another record on the same
 * line. All three are spec-conformant; the inconsistency is the
 * defect that stresses streaming tokenisers. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Le057 - mixed EOR formatting with blank lines and inline records'),'2;1');
FILE_NAME('Le057.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));

#11=CARTESIAN_POINT('',(1.0,0.0,0.0));


#12=CARTESIAN_POINT('',(2.0,0.0,0.0));
#13=VERTEX_POINT('',#10);#14=VERTEX_POINT('',#11);
#15=VERTEX_POINT('',#12);

#16=DIRECTION('',(1.0,0.0,0.0));
#17=VECTOR('',#16,1.0);


#18=LINE('',#10,#17);
#19=EDGE_CURVE('',#13,#14,#18,.T.);
ENDSEC;
END-ISO-10303-21;
