/* Le025 — Empty / blank / single-space NAME silently emptied
   Defect: a PRODUCT(' ',...) with a NAME consisting only of a single space
   becomes an empty XCAF attribute name after over-eager trim, losing the
   sender's literal value. This file emits three contrasting forms:
     - PRODUCT('',...)        -- truly empty
     - PRODUCT(' ',...)       -- single space (must be preserved)
     - PRODUCT('   ',...)     -- three spaces (must be preserved)
   A correct kernel distinguishes these and applies trim only after explicit
   user opt-in. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Le025 - empty/blank/single-space NAME silently emptied'),'2;1');
FILE_NAME('Le025.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* truly empty NAME */
#10=PRODUCT('','id-empty','description',(#100));
/* single-space NAME (must NOT be trimmed to empty) */
#11=PRODUCT(' ','id-single-space','description',(#100));
/* three-space NAME */
#12=PRODUCT('   ','id-three-spaces','description',(#100));
/* tab-only NAME */
#13=PRODUCT('\X\09','id-tab-name','description',(#100));
#100=PRODUCT_CONTEXT('part definition',#101,'mechanical');
#101=APPLICATION_CONTEXT('automotive_design');
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
ENDSEC;
END-ISO-10303-21;
