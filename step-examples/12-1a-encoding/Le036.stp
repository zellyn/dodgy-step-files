/* Le036 — Round-trip loss of \X2\ content through XML / DB layer
   Defect: a toolchain that decodes \X2\..\X0\ into UTF-8 internally and
   re-encodes for export must round-trip the original Unicode characters
   exactly. Several vendors lost backslashes (OCCT 7.5 regression) or
   replaced rare codepoints with '?' when the storage layer (XML, SQL
   VARCHAR(...)) silently truncated. This file embeds:
     - PRODUCT.name with literal Windows backslashes ('C:\\path\\file')
     - PRODUCT.name with rare CJK codepoint U+20BB7 (a CJK Extension B
       character requiring \X4\ since it is above the BMP)
     - mixed Greek + Latin via \X2\
   A round-trip test exports and re-imports this file and asserts byte
   equality of the decoded names. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Le036 - round-trip loss of X2 content through XML/DB layer'),'2;1');
FILE_NAME('Le036.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* literal backslashes in PRODUCT.name (must be preserved) */
#10=PRODUCT('C:\\path\\file','windows path','description',(#100));
/* rare CJK codepoint U+20BB7 via \X4\ (above BMP) */
#11=PRODUCT('rare=\X4\00020BB7\X0\','rare cjk','description',(#100));
/* mixed Greek + Latin via \X2\ (must round-trip exactly) */
#12=PRODUCT('mix=\X2\03B103B203B3\X0\-abc','greek-latin','description',(#100));
#100=PRODUCT_CONTEXT('part definition',#101,'mechanical');
#101=APPLICATION_CONTEXT('automotive_design');
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
ENDSEC;
END-ISO-10303-21;
