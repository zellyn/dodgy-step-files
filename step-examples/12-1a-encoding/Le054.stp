ISO-10303-21;
/* Le054: High-bit byte ambiguous between Windows-1252 and ISO-8859-1; ISO 10303-21 Ed.2 §6.4.3.5: default 8-bit page is ISO-8859-1; bytes 0x80-0x9F are C1 control characters in ISO-8859-1 (no glyphs); in Windows-1252 the same bytes carry printable glyphs (0x80=Euro, 0x91-0x92=smart single quotes, 0x93-0x94=smart double quotes, 0x97=em-dash, 0x99=trademark); Windows-hosted writers emit raw 0x80-0x9F bytes in string literals without converting to ISO-8859-1 or \X2\ escapes; strict Ed.2 readers see C1 control bytes in string body and reject or corrupt; defect strings contain \X\91, \X\92, \X\80, \X\97 (the \X\ escape form of the ambiguous bytes); receiver must surface the ambiguity: name the byte and the page-selection policy; silent reinterpretation across vendor policies hides the disagreement; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Le054'),'2;1');
FILE_NAME('Le054.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#8996=PERSON('it\X\92s a \X\91note\X\92','smart-quotes-cp1252-ambiguous','');
#8997=PERSON('price \X\80 100','euro-sign-cp1252-ambiguous','');
#8998=PERSON('word\X\97word','em-dash-cp1252-ambiguous','');
#8999=PERSON('brand\X\99','trademark-cp1252-ambiguous','');

ENDSEC;
END-ISO-10303-21;
