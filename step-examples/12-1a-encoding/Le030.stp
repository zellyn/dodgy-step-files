/* Le030 — \PE\ selector and \Q\x directive support
   Defect: ISO 10303-21 also defines \PE\ (UCS extended) and \Q\x
   (alternate-quote) directives that few parsers implement. This file
   emits both forms. A tolerant reader should consume the documented
   number of operands and not desynchronise the lexer; warn if decoding
   is not fully implemented. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Le030 - PE selector and Q-directive support'),'2;1');
FILE_NAME('Le030.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* \PE\ selector (UCS extended, persistent for remainder of string) */
#10=PERSON('p1','\PE\foo','given',$,$,$,$,$);
/* \Q\x — alternate quote directive; here \Q\' allows literal ' inside string */
#11=PERSON('p2','\Q\'foo\Q\'','given',$,$,$,$,$);
/* combined */
#12=PERSON('p3','\PE\bar\Q\\','given',$,$,$,$,$);
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
ENDSEC;
END-ISO-10303-21;
