ISO-10303-21;
/* Le005: \X2\ UCS-2 escape with 3-hex-digit group (not multiple of four); \X2\HHHH…\X0\ requires hex digit count divisible by four (4 digits per UCS-2 code unit); \X2\03B\X0\ has only 3 digits — the group is malformed; receiver must validate group count; emit E_BAD_X2_DIRECTIVE on malformed input; warn-and-best-effort decode without crashing; crash potential when out-of-range value fed to downstream UTF-8 encoder; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Le005'),'2;1');
FILE_NAME('Le005.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#8999=PERSON('\X2\03B\X0\','three-digit-ucs2-group','');

ENDSEC;
END-ISO-10303-21;
