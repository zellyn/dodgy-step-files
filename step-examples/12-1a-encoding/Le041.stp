ISO-10303-21;
/* Le041 - \Q\ numeric-character-reference encoding code point in
 * the UTF-16 surrogate range (U+D800..U+DFFF)
 * Defect: ISO 10303-21 \Q\NNN\Q\ accepts decimal Unicode scalars,
 * but values 55296..57343 (the UTF-16 surrogate halves) are not
 * legal Unicode scalars - they exist only as paired surrogates in
 * the UTF-16 transformation. A kernel that decodes \Q\55296\Q\ into
 * a UTF-8 stream will produce an ill-formed sequence (CESU-8 or
 * WTF-8 territory) that downstream tooling may reject. The producer
 * may have meant a non-BMP character but failed to emit the surrogate
 * pair, or may be re-encoding a Java/JavaScript string that allowed
 * lone surrogates internally. */
HEADER;
FILE_DESCRIPTION(('Le041 - \Q\ encoding lone surrogate 55296 (U+D800)'),'2;1');
FILE_NAME('Le041.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=PRODUCT_CONTEXT('part',#1,'mechanical');
/* Defect: 55296 is U+D800, a high-surrogate half - not a legal
 * Unicode scalar */
#10=PRODUCT('lone=\Q\55296\Q\','lone-surrogate','',(#2));
ENDSEC;
END-ISO-10303-21;
