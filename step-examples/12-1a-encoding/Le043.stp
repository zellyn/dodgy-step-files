ISO-10303-21;
/* Le043: \X4\ with a valid supplementary-plane code point followed by a short trailing hex run; ISO 10303-21 Ed.3 §6.4.3: \X4\HHHHHHHH...\X0\ requires exactly 8 hex digits per 32-bit UCS-4 code point; a total hex run not divisible by 8 is malformed; defect string: 'mix=\X4\0001F60000041\X0\' — the 12-digit hex run contains a valid 8-digit group (0001F600 = U+1F600, Grinning Face emoji) immediately followed by a short 4-digit group (0041 = 'A') that does not form a full 8-digit UCS-4 unit; distinct from Le006: Le043 has a valid leading group so a tolerant parser may decode the first character and silently drop the second, hiding the malformation; receiver must reject the whole \X4\...\X0\ block as malformed, or reject only the trailing short group with a diagnostic; never silently truncate the trailing hex digits; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Le043'),'2;1');
FILE_NAME('Le043.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
