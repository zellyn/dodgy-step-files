ISO-10303-21;
/* Le059 - German umlauts in PRODUCT.name mis-decoded by reader (Latin-1/UTF-8 confusion)
 * Defect: producer emits Ed.2-style STEP with raw byte 0xE4 for 'a-umlaut' inside a string
 * literal; reader assumes Ed.3 UTF-8, mis-decodes the isolated continuation byte. */
HEADER;
FILE_DESCRIPTION(('Le059 - umlaut bytes in PRODUCT.name (Ed.2 ISO-8859-1 default)'),'2;1');
FILE_NAME('Le059.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
/* Defect: PRODUCT.name contains raw 0xE4 (a-umlaut), 0xF6 (o-umlaut), 0xFC (u-umlaut)
   per Ed.2 ISO-8859-1 default. UTF-8-only readers misinterpret as isolated continuation bytes. */
#100=PRODUCT('Schrägverzahnt_Kühlkörper','german umlauts','',(#3));
#101=PRODUCT_DEFINITION_FORMATION('','',#100);
#102=PRODUCT_DEFINITION('design','',#101,#103);
#103=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
ENDSEC;
END-ISO-10303-21;
