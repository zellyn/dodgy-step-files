ISO-10303-21;
/* Le048: REAL literal exceeding double range: overflow → +Inf / underflow → 0; ISO 10303-21 Ed.3 §6.4.5: REAL has no infinity form (no +Inf, -Inf, NaN); producers internally holding IEEE-754 doubles and serialising via printf %g may emit 1.0E+999 (overflows to +Inf on parse) or 1.0E-999 (underflows to 0 on parse); receiver must detect overflow during literal-to-binary conversion and reject; must not let +Inf or -Inf enter the geometric pipeline; defect 1: CARTESIAN_POINT with X=1.0E+999 (overflows to IEEE-754 +Inf); defect 2: CARTESIAN_POINT with X=1.0E-999 (underflows to 0); GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Le048'),'2;1');
FILE_NAME('Le048.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#8998=CARTESIAN_POINT('overflow',(1.0E+999,0.0,0.0));
#8999=CARTESIAN_POINT('underflow',(1.0E-999,0.0,0.0));

ENDSEC;
END-ISO-10303-21;
