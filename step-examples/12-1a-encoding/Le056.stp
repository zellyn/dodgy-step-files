/* Le056 - Mixed .T. and .TRUE. boolean lexemes within one file
 * Defect: one EDGE_CURVE uses canonical .T., a second uses .TRUE.
 * inside the same DATA section. Receivers that accept only the
 * canonical form parse some attributes and reject others; the
 * inconsistency is harder to diagnose than uniform long-form. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Le056 - mixed .T. and .TRUE. in same file'),'2;1');
FILE_NAME('Le056.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('',(2.0,0.0,0.0));
#13=VERTEX_POINT('',#10);
#14=VERTEX_POINT('',#11);
#15=VERTEX_POINT('',#12);
#16=DIRECTION('',(1.0,0.0,0.0));
#17=VECTOR('',#16,1.0);
#18=LINE('',#10,#17);
#19=LINE('',#11,#17);
/* Canonical short form */
#20=EDGE_CURVE('canonical',#13,#14,#18,.T.);
/* Long form within same file */
#21=EDGE_CURVE('long_form',#14,#15,#19,.TRUE.);
#22=ORIENTED_EDGE('',*,*,#20,.T.);
#23=ORIENTED_EDGE('',*,*,#21,.FALSE.);
#24=EDGE_LOOP('',(#22,#23));
ENDSEC;
END-ISO-10303-21;
