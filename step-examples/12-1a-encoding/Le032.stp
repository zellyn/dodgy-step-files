/* Le032 - \X2\..\X0\ or \N\ escape spanning a physical line break
   Defect: a hex run is split across a CR LF boundary inside an \X2\ block.
   Per Part-21 5.2 those bytes are ignored; a tolerant lexer must accept
   the split, but many implementations consume the directive byte-greedily
   and fail at the line-end. The PERSON below has a \X2\..\X0\ run with a
   raw CR LF inserted between the two 4-digit groups. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Le032 - X2 escape split across physical line break'),'2;1');
FILE_NAME('Le032.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#10=PERSON('p1','foo\X2\30A2
30A4\X0\bar','given',$,$,$,$,$);
#11=PERSON('p2','head\N\
tail','given',$,$,$,$,$);
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
ENDSEC;
END-ISO-10303-21;
