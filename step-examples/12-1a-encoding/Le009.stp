/* Le009 — \P{X}\ page-shift directive: bad selector / state-machine omission
   Defect: \PA\ through \PI\ select ISO-8859-1 through ISO-8859-9. This file
   emits multiple malformed selectors:
     - lowercase letter (\Pg\)
     - digit selector   (\P1\)
     - non-letter       (\P!\)
     - missing selector (\P\)
     - selector outside [A-I] — out-of-bounds page-table index
   Also includes a legitimate \PB\Krak\X\F3w (Polish "Krakow" via Latin-2) to
   exercise correct page-state machinery. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Le009 - bad P{X} page-shift selectors'),'2;1');
FILE_NAME('Le009.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* lowercase selector */
#10=PERSON('p1','\Pg\\S\a','given',$,$,$,$,$);
/* digit selector */
#11=PERSON('p2','\P1\stuff','given',$,$,$,$,$);
/* non-letter selector */
#12=PERSON('p3','\P!\X\41','given',$,$,$,$,$);
/* missing selector */
#13=PERSON('p4','\P\stuff','given',$,$,$,$,$);
/* legitimate Latin-2 Polish "Krakow" with valid \PB\ */
#14=PERSON('p5','\PB\Krak\X\F3w','given',$,$,$,$,$);
/* selector outside A..I (J is out of range Table 4) */
#15=PERSON('p6','\PJ\stuff','given',$,$,$,$,$);
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
ENDSEC;
END-ISO-10303-21;
