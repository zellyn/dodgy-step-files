/* Le018 — Inline newline inside a string silently concatenated
   Defect: per Part-21 5.2, LF and CR are ignored characters even inside
   string literals. So a literal 'first line<LF>second line' parses to
   'first linesecond line' (silently concatenated). This produces
   surprising round-trip mismatch when descriptions are written across
   physical lines. The FILE_DESCRIPTION below contains a raw LF mid-string
   that a conformant lexer must drop, yielding a single concatenated value. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('first line
second line'),'2;1');
FILE_NAME('Le018.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#10=PERSON('p1','para1
para2','given',$,$,$,$,$);
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
ENDSEC;
END-ISO-10303-21;
