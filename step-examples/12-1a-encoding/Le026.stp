/* Le026 — \X0\ end-marker missing — remainder treated as encoded content
   Defect: when \X0\ is omitted from an \X2\ block, OCCT (pre-fix) treated
   the remainder of the string as encoded hex content, garbling the trailing
   ASCII portion. This file emits PRODUCT.name = '\X2\00B0' where the closing
   apostrophe arrives without an \X0\ terminator. A correct reader must
   warn and best-effort decode the codepoint that IS present, then revert to
   literal-ASCII mode at the closing apostrophe. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Le026 - missing X0 terminator in X2 block'),'2;1');
FILE_NAME('Le026.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* missing X0 — closing apostrophe immediately follows hex run */
#10=PRODUCT('\X2\00B0','degree','description',(#100));
/* missing X0 with trailing ASCII — should decode degree-sign then "C" */
#11=PRODUCT('\X2\00B0C','degree-C','description',(#100));
/* missing X0 with two valid 4-digit groups */
#12=PRODUCT('\X2\30423044','ai','description',(#100));
#100=PRODUCT_CONTEXT('part definition',#101,'mechanical');
#101=APPLICATION_CONTEXT('automotive_design');
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
ENDSEC;
END-ISO-10303-21;
