ISO-10303-21;
/* Le045 - String literal at the Edition-3 length limit (32768 chars)
 * Defect: ISO 10303-21 Edition 3 raises the maximum string-literal
 * length to 32768 characters (Edition 1 was 256). A reader that
 * statically allocates a 256-char buffer truncates silently or
 * faults; a reader that allocates dynamically but checks against
 * an off-by-one threshold may reject one too many or one too few.
 * The PRODUCT.name below contains exactly 32768 characters of 'A'. */
HEADER;
FILE_DESCRIPTION(('Le045 - 32768-char string literal at Ed.3 boundary'),'2;1');
FILE_NAME('Le045.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=PRODUCT_CONTEXT('part',#1,'mechanical');
#10=PRODUCT('','at-32768-boundary','',(#2));
ENDSEC;
END-ISO-10303-21;
