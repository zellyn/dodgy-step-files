ISO-10303-21;
/* Le047 - Numeric literal at the IEEE-754 double subnormal boundary
 * Defect: ISO 10303-21 specifies REAL as a decimal floating-point
 * representation but most implementations parse into IEEE-754
 * binary64. Inputs at the subnormal boundary (smallest positive
 * subnormal ~4.9406564584124654E-324; smallest positive normal
 * ~2.2250738585072014E-308) test for two failure modes:
 *  - readers that round to zero and silently drop the value
 *  - readers that flag underflow and reject the file
 * A coordinate emitted at this magnitude often arises in BSpline
 * weight values from buggy producers normalising weights through
 * very small denominators. */
HEADER;
FILE_DESCRIPTION(('Le047 - IEEE-754 subnormal boundary REAL literal'),'2;1');
FILE_NAME('Le047.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=PRODUCT_CONTEXT('part',#1,'mechanical');
/* Defect: subnormal value 4.9E-324 in coordinate */
#10=CARTESIAN_POINT('subnormal',(4.9406564584124654E-324,0.0,0.0));
/* And the smallest positive *normal* double, just above subnormal */
#11=CARTESIAN_POINT('min_normal',(2.2250738585072014E-308,0.0,0.0));
/* And the largest finite double */
#12=CARTESIAN_POINT('max_finite',(1.7976931348623157E+308,0.0,0.0));
/* And negative zero, which IEEE-754 distinguishes from positive
 * zero but most STEP comparators treat as equal. */
#13=CARTESIAN_POINT('neg_zero',(-0.0,0.0,0.0));
#20=DIRECTION('z',(0.0,0.0,1.0));
#21=DIRECTION('x',(1.0,0.0,0.0));
#22=AXIS2_PLACEMENT_3D('placement',#10,#20,#21);
ENDSEC;
END-ISO-10303-21;
