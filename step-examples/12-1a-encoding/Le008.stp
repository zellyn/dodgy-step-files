ISO-10303-21;
/* Le008: \S\ 8-bit shift directive misuse: apostrophe-after-\S\ and illegal chaining; \S\x adds 0x80 to the next single ASCII byte to address upper ISO-8859 page; defect 1: 'abc\S\'def' — apostrophe after \S\ is the shift operand, not string end; a parser that closes the string on the apostrophe produces a 3-char string 'abc' instead of the correct 7-char string; defect 2: 'caf\S\\S\e' — chaining two \S\ directives is illegal; \S\ is a one-character operator; spec does not permit \S\\S\ as a compound; receiver must consume exactly one byte after \S\ and reject or warn on chaining; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Le008'),'2;1');
FILE_NAME('Le008.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#8998=PERSON('abc\S\''def','apostrophe-after-S-shift','');
#8999=PERSON('caf\S\\S\e','chained-S-shift-directives','');

ENDSEC;
END-ISO-10303-21;
