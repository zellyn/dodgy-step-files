ISO-10303-21;
/* Le008: \S\ 8-bit shift directive misuse: apostrophe-after-\S\ and illegal chaining; \S\x adds 0x80 to the next single ASCII byte to address upper ISO-8859 page; defect 1: 'abc\S\'def' — apostrophe after \S\ is the shift operand, not string end; a parser that closes the string on the apostrophe produces a 3-char string 'abc' instead of the correct 7-char string; defect 2: 'caf\S\\S\e' — chaining two \S\ directives is illegal; \S\ is a one-character operator; spec does not permit \S\\S\ as a compound; receiver must consume exactly one byte after \S\ and reject or warn on chaining; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Le008'),'2;1');
FILE_NAME('Le008.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Le008','Le008','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#2),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
#8998=PERSON('abc\S\''def','apostrophe-after-S-shift','');
#8999=PERSON('caf\S\\S\e','chained-S-shift-directives','');

ENDSEC;
END-ISO-10303-21;
