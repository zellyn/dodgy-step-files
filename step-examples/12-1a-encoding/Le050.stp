ISO-10303-21;
/* Le050 - Unicode characters dropped on STEP export
 * Defect: document name with Cyrillic Тест; writer emits raw UTF-8 bytes in Ed.2-declared file */
HEADER;
FILE_DESCRIPTION(('Le050 test case','Unicode characters dropped on STEP export'),'2;1');
FILE_NAME('Le050.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#100=PRODUCT('Тест','Test','',(#10));
#10=PRODUCT_CONTEXT('',#1,'mechanical');
ENDSEC;
END-ISO-10303-21;
