ISO-10303-21;
/* Le013: Apostrophe-doubling escape '' confused with string terminator; ISO 10303-21 §6.4.3.1: a literal apostrophe inside a string is escaped by doubling it — 'It''s' decodes to the 4-char string It's; defect 1: 'O''Brien' — parser must NOT split at the doubled quote; defect 2: '''' — four consecutive apostrophes encode two literal apostrophes; defect 3: 'a''b' — doubled apostrophe mid-string; a parser that treats '' as end-of-string + start-of-next desynchronizes the token stream; subsequent attributes shift by one position; downstream entity construction fails type-check or builds wrong sub-tree; receiver must track parity of consecutive apostrophes; only an odd count terminates the string; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Le013'),'2;1');
FILE_NAME('Le013.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
