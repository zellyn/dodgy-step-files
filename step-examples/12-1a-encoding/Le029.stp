/* Le029 — Header FILE_DESCRIPTION strings containing commas or parentheses
   Defect: header parsers implemented as regex-split-on-comma fail when a
   description string contains literal commas or balanced parentheses. The
   FILE_DESCRIPTION below carries 'a, b (c)' which a robust tokeniser must
   treat opaquely; only the actual STRING delimiters separate parameters. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('a, b (c)','d, with comma and (paren) inside'),'2;1');
FILE_NAME('Le029.stp','2026-04-26T00:00:00',('auto, generated'),('org, with comma'),
  'auto-generated','tool, with comma and (paren)','step (auto)');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
ENDSEC;
END-ISO-10303-21;
