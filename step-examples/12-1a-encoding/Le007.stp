ISO-10303-21;
/* Le007: \X2\ UCS-2 endianness confusion and lone-surrogate handling; \X2\ 4-digit groups are big-endian by spec; \X2\D800\X0\ encodes lone high surrogate U+D800 — illegal in UCS-2; parsers with little-endian assumption interpret 0xD800 as 0x00D8 producing wrong code points; downstream UTF-8 encoder fed lone surrogate emits invalid UTF-8; subsequent consumers reject invalid UTF-8 or abort (SIGABRT); receiver must validate surrogate pairing; reject lone surrogates; always interpret hex groups as big-endian; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Le007'),'2;1');
FILE_NAME('Le007.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#8999=PERSON('\X2\D800\X0\','lone-high-surrogate-ucs2','');

ENDSEC;
END-ISO-10303-21;
