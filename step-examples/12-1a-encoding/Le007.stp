/* Le007 — \X2\ endianness confusion / lone-surrogate handling
   Defect: \X2\ groups are 4 hex digits big-endian. A little-endian-leaning
   parser may swap halves and produce invalid surrogate sequences. This file
   embeds a lone high surrogate (U+D800) which is illegal as a UCS-2 code
   point and must be rejected by a validating decoder. A downstream UTF-8
   encoder fed this lone surrogate will emit invalid UTF-8. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Le007 - X2 endianness / lone surrogate'),'2;1');
FILE_NAME('Le007.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* lone high surrogate U+D800 inside an X2 block */
#10=PERSON('p1','\X2\D800\X0\','given',$,$,$,$,$);
/* a follow-up valid character to confirm scanner re-syncs */
#11=PERSON('p2','plain','given',$,$,$,$,$);
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
ENDSEC;
END-ISO-10303-21;
