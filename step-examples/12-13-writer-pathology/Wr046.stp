/* Wr046 - Body Placement (rotation/translation) not applied during export.
 * Defect (FreeCAD #25150): a Body with non-identity Placement is emitted
 * with body-local coordinates and identity AXIS2_PLACEMENT_3D, dropping
 * the document's intended orientation. Workaround: wrap in Compound. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Wr046 - body Placement dropped on STEP export'),'2;1');
FILE_NAME('Wr046.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('Wr046_unplaced','no placement applied','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
/* Defect: identity AXIS2_PLACEMENT_3D, even though the source Body had a
   45-degree rotation about Z and a 100mm X translation. The rotation /
   translation that the document intended is silently dropped. */
#20=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#21=DIRECTION('z',(0.0,0.0,1.0));
#22=DIRECTION('x',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('identity_dropped_rotation',#20,#21,#22);
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=CARTESIAN_POINT('',(10.0,0.0,0.0));
#32=CARTESIAN_POINT('',(10.0,10.0,0.0));
#33=CARTESIAN_POINT('',(0.0,10.0,0.0));
#40=VERTEX_POINT('',#30);
#41=VERTEX_POINT('',#31);
#42=VERTEX_POINT('',#32);
#43=VERTEX_POINT('',#33);
#50=DIRECTION('',(1.0,0.0,0.0));
#51=VECTOR('',#50,10.0);
#52=LINE('',#30,#51);
#53=EDGE_CURVE('',#40,#41,#52,.T.);
#60=PLANE('',#23);
#61=ADVANCED_FACE('floor',(),#60,.T.);
#70=CLOSED_SHELL('',(#61));
#71=MANIFOLD_SOLID_BREP('Wr046_body',#70);
#72=SHAPE_REPRESENTATION('Wr046_root',(#23,#71),#14);
#73=SHAPE_DEFINITION_REPRESENTATION(#8,#72);
ENDSEC;
END-ISO-10303-21;
