ISO-10303-21;
/* Wr035: coordinate scale-factor applied twice (model 1000x too large) */
/* Input was a 1.0-metre cube; writer applied m-to-mm (x1000) to coordinates */
/* AND declared LENGTH_UNIT as MILLI METRE — receiver applies factor a second time */
/* Result: receiver sees a cube 1000x larger than the producer intended */
HEADER;
FILE_DESCRIPTION(('Wr035: double unit-conversion scale defect'),'2;1');
FILE_NAME('Wr035.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* DEFECT: coordinates are 1000.0 (already mm-scaled), but unit says MILLI METRE */
/* A 1.0-metre cube should have corners at (1000.0,...) in mm — but unit declaration */
/* already tells receiver these are mm values; receiver multiplies again => 1e6 mm */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-xxx',(1000.0,0.,0.));
#3=CARTESIAN_POINT('corner-xxy',(1000.0,1000.0,0.));
#4=CARTESIAN_POINT('corner-xyy',(0.,1000.0,0.));
#5=CARTESIAN_POINT('corner-xxz',(1000.0,0.,1000.0));
#6=CARTESIAN_POINT('corner-xyz',(1000.0,1000.0,1000.0));
#7=DIRECTION('xdir',(1.,0.,0.));
#8=DIRECTION('zdir',(0.,0.,1.));
/* DEFECT: unit declared as MILLI METRE while coordinates already reflect mm-scaling */
#9=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#10=GEOMETRIC_CURVE_SET('double-scaled-1m-cube',(#1,#2,#3,#4,#5,#6));
ENDSEC;
END-ISO-10303-21;
