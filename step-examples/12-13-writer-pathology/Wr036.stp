/* Wr036 - Re-export inverts solid orientation - inside becomes outside */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Wr036 - solid orientation inverted on re-export'),'2;1');
FILE_NAME('Wr036.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('mechanical design');
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);
#14=PLANE('plane',#13);
/* Wr036: writer's internal half-space convention is inverted relative
   to STEP. Every face is emitted with same_sense = .F. and outer-bound
   orientation flipped. Topologically the cube is intact but materially
   the inside has become outside */
#15=ADVANCED_FACE('face',(),#14,.F.);
#16=CLOSED_SHELL('shell',(#15));
#17=MANIFOLD_SOLID_BREP('inverted_solid',#16);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
ENDSEC;
END-ISO-10303-21;
