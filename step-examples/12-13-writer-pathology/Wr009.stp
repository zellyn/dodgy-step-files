ISO-10303-21;
/* Wr009 - Spurious $ for required parameter - writer emits $ where the schema mandates a value */
HEADER;
FILE_DESCRIPTION(('Wr009 - dollar-sign for required attribute'),'2;1');
FILE_NAME('Wr009.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('mechanical design');
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
/* Wr009: AXIS2_PLACEMENT_3D should carry both axis and ref_direction
   when used in non-trivial geometric contexts; the writer omitted both */
#13=AXIS2_PLACEMENT_3D('placement',#10,$,$);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#21=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#22=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#23=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#20,
  'distance_accuracy_value','');
#24=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#23))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#21,#22))
  REPRESENTATION_CONTEXT('Wr009','3D'));
#30=SHAPE_REPRESENTATION('main',(#13),#24);
ENDSEC;
END-ISO-10303-21;
