ISO-10303-21;
/* Wr031 - Schema downgrade on export - AP242 input emitted as AP203, entities lost */
HEADER;
FILE_DESCRIPTION(('Wr031 - schema downgrade AP242 -> AP203'),'2;1');
FILE_NAME('Wr031.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
/* Wr031: input declared AP242 and contained GEOMETRIC_TOLERANCE,
   DRAUGHTING_ANNOTATION_OCCURRENCE, KINEMATIC_LINK entities. Writer
   was configured to emit AP203 because a downstream tool doesn't speak
   AP242. All AP242-specific entities silently dropped */
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('mechanical design');
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);
#14=PLANE('plane',#13);
#15=ADVANCED_FACE('face',(),#14,.T.);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
ENDSEC;
END-ISO-10303-21;
