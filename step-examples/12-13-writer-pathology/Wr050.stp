/* Wr050 - Geometry coordinate values doubled on export (writer applies
 * scale and unit-conversion both).
 * Defect (FreeCAD #17729): a 20mm OD / 13mm ID part round-trips as a
 * 40mm OD / 26mm ID part. Coordinates are 2x what they should be while
 * the LENGTH_UNIT context still claims SI MILLI METRE. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Wr050 - coordinates doubled on export'),'2;1');
FILE_NAME('Wr050.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('Wr050_doubled','coordinates 2x','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
/* Defect: SI MILLI METRE context, but a part the user authored as 20mm
   on a side has 40mm-scale coordinates. Re-import yields a doubled-size
   solid. */
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(40.0,0.0,0.0));
#22=CARTESIAN_POINT('',(40.0,40.0,0.0));
#23=CARTESIAN_POINT('',(0.0,40.0,0.0));
#24=CARTESIAN_POINT('',(0.0,0.0,40.0));
#25=CARTESIAN_POINT('',(40.0,0.0,40.0));
#26=CARTESIAN_POINT('',(40.0,40.0,40.0));
#27=CARTESIAN_POINT('',(0.0,40.0,40.0));
#30=DIRECTION('',(0.0,0.0,1.0));
#31=DIRECTION('',(1.0,0.0,0.0));
#32=AXIS2_PLACEMENT_3D('',#20,#30,#31);
#33=SHAPE_REPRESENTATION('Wr050_doubled_cube',(#32),#14);
#34=SHAPE_DEFINITION_REPRESENTATION(#8,#33);
ENDSEC;
END-ISO-10303-21;
