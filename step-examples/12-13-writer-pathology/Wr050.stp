ISO-10303-21;
/* Wr050: geometry coordinate values doubled on export */
/* FreeCAD #17729: writer applied both document scale (1.0) and unit conversion */
/* factor in series — two-pass pipeline doubles every coordinate value */
/* 20 mm cube → coordinates 40.0 in a context still claiming MILLI METRE */
/* Receivers load a 40 mm cube (2× the producer's 20 mm intent) */
HEADER;
FILE_DESCRIPTION(('Wr050: coordinate values doubled by scale+unit-conversion both'),'2;1');
FILE_NAME('Wr050.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* DEFECT: coordinates are 40.0 — double the 20 mm original — but unit is MILLI METRE */
/* Source was a 20 mm cube; correct coordinates would be (20.0, 20.0, 20.0) in mm */
/* Writer composed document-scale (1.0) into unit-conversion, applying the factor twice */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(40.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,40.0,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,40.0));
#5=CARTESIAN_POINT('corner-xyz',(40.0,40.0,40.0));
#6=DIRECTION('xdir',(1.,0.,0.));
#7=DIRECTION('zdir',(0.,0.,1.));
/* DEFECT: MILLI METRE declared; 40.0 values should be 20.0 for a 20 mm cube */
#8=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#9=GEOMETRIC_CURVE_SET('doubled-coords-20mm-cube',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
