ISO-10303-21;
/* Wr010 - Re-emitted * (overridden) where schema does not allow it - asterisk in non-subtype context */
HEADER;
FILE_DESCRIPTION(('Wr010 - asterisk in non-subtype attribute'),'2;1');
FILE_NAME('Wr010.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('mechanical design');
/* Wr010: writer mis-applied the supertype-override marker '*' to a
   plain CARTESIAN_POINT coordinate slot, where '*' has no defined meaning */
#10=CARTESIAN_POINT('bad',(*,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
ENDSEC;
END-ISO-10303-21;
