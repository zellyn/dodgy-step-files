ISO-10303-21;
/* Wr010: asterisk used as override-marker in non-subtype CARTESIAN_POINT */
HEADER;
FILE_DESCRIPTION(('Wr010 - asterisk in simple entity coordinates'),'2;1');
FILE_NAME('Wr010.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Defect: * used as a coord value in a plain CARTESIAN_POINT (not a subtype stack) */
/* Valid context for * is inside complex entity records only, e.g.: */
/* #N=(POINT()CARTESIAN_POINT((*,0.,0.))...) */
/* Here it appears in a simple entity: schema violation */
#1=CARTESIAN_POINT('defect-point',(*,0.,0.));
#2=CARTESIAN_POINT('ok-point',(1.,0.,0.));
#3=CARTESIAN_POINT('ok-point2',(1.,1.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=DIRECTION('xdir',(1.,0.,0.));
#6=GEOMETRIC_CURVE_SET('asterisk-defect',(#2,#3));
ENDSEC;
END-ISO-10303-21;
