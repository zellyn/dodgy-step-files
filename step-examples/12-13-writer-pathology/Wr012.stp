ISO-10303-21;
/* Wr012 - Random #N numbering with no monotonic structure - instance numbers jump around */
HEADER;
FILE_DESCRIPTION(('Wr012 - non-monotonic instance numbers'),'2;1');
FILE_NAME('Wr012.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('mechanical design');
#1000=PRODUCT_CONTEXT('part',#1,'mechanical');
#5=PRODUCT('Wr012-part','Wr012 demo','',(#1000));
#1003=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#7=DIRECTION('z',(0.0,0.0,1.0));
#1006=DIRECTION('x',(1.0,0.0,0.0));
#9=AXIS2_PLACEMENT_3D('p',#1003,#7,#1006);
#1009=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
ENDSEC;
END-ISO-10303-21;
