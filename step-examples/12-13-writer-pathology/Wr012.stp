ISO-10303-21;
/* Wr012: non-monotonic instance numbering in DATA section */
HEADER;
FILE_DESCRIPTION(('Wr012 - random instance numbering with no monotonic structure'),'2;1');
FILE_NAME('Wr012.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Defect: instance numbers jump: #1, #1000, #5, #1003, #7, #1006 — not monotonic */
/* The spec permits any positive integer; a conforming kernel must accept these */
#1=DIRECTION('zdir',(0.,0.,1.));
#1000=DIRECTION('xdir',(1.,0.,0.));
#5=CARTESIAN_POINT('origin',(0.,0.,0.));
#1003=CARTESIAN_POINT('p1',(1.,0.,0.));
#7=CARTESIAN_POINT('p2',(1.,1.,0.));
#1006=GEOMETRIC_CURVE_SET('random-ids',(#5,#1003,#7));
ENDSEC;
END-ISO-10303-21;
