ISO-10303-21;
/* Wr018: complete product scaffold with no geometry in SHAPE_REPRESENTATION */
/* Writer initialised product structure before geometry was computed */
/* SHAPE_REPRESENTATION.items contains only an AXIS2_PLACEMENT_3D */
HEADER;
FILE_DESCRIPTION(('Wr018 - empty shape representation chain'),'2;1');
FILE_NAME('Wr018.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Product structure scaffold */
#1=APPLICATION_CONTEXT('mechanical design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2003,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('Wr018','Wr018','',(#3));
#5=PRODUCT_DEFINITION_FORMATION('','',#4);
#6=PRODUCT_DEFINITION_CONTEXT(#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
/* Placement axis — this is the ONLY item in SHAPE_REPRESENTATION */
#9=CARTESIAN_POINT('origin',(0.,0.,0.));
#10=DIRECTION('z-axis',(0.,0.,1.));
#11=DIRECTION('x-axis',(1.,0.,0.));
#12=AXIS2_PLACEMENT_3D('placement',#9,#10,#11);
/* Unit context */
#13=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#14=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#15=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#16=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#13,
  'distance_accuracy_value','');
#17=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#16))GLOBAL_UNIT_ASSIGNED_CONTEXT((#13,#14,#15))REPRESENTATION_CONTEXT('','3D'));
/* SHAPE_REPRESENTATION with only a placement — no geometry shape */
#18=SHAPE_REPRESENTATION('main',(#12),#17);
#19=SHAPE_DEFINITION_REPRESENTATION(#8,#18);
ENDSEC;
END-ISO-10303-21;
