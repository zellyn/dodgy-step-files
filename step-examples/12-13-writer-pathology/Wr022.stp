/* Wr022 - Saved-view / camera metadata lost on re-export */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Wr022 - saved views dropped on re-export'),'2;1');
FILE_NAME('Wr022.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('mechanical design');
#2=PRODUCT_CONTEXT('part',#1,'mechanical');
#3=PRODUCT('Wr022-part','Wr022 demo','',(#2));
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);
#14=PLANE('plane',#13);
#15=ADVANCED_FACE('face',(),#14,.T.);
/* Wr022: input had three CAMERA_MODEL_D3 entities (named 'front_view',
   'top_view', 'iso_view') and corresponding PRESENTATION_VIEW records.
   Writer's internal model has no concept of saved views; all dropped */
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
ENDSEC;
END-ISO-10303-21;
