ISO-10303-21;
/* Wr028: FILE_NAME.author and originating_system fields blank */
/* All provenance fields are empty strings: author, organization, */
/* originating_system, and authorisation are all '' */
/* Produced by writers that do not capture user identity or origin */
HEADER;
FILE_DESCRIPTION(('Wr028'),'2;1');
/* DEFECT: author=(''), organization=(''), originating_system='', authorisation='' */
FILE_NAME('Wr028.stp','2026-06-17T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: minimal GEOMETRIC_CURVE_SET — defect is in HEADER only */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('pt',(1.,0.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('no-provenance-shape',());
ENDSEC;
END-ISO-10303-21;
