/* Wr028 - FILE_NAME author and originating_system fields blank or auto-filled with placeholder */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Wr028 - blank provenance fields'),'2;1');
/* Wr028: writer never captures user identity; emits empty strings for
   author, organization, originating_system, authorisation */
FILE_NAME('Wr028.stp','2026-04-30T00:00:00',(''),(''),
  '','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('mechanical design');
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
ENDSEC;
END-ISO-10303-21;
