ISO-10303-21;
/* Wr029: FILE_DESCRIPTION with embedded literal newline (0x0A) in string */
/* Writers that paste user text into FILE_DESCRIPTION without escaping LF */
/* Crude line-based parsers terminate the string at the embedded newline */
/* Spec violation: ISO 10303-21 §6.4 forbids control characters in strings */
HEADER;
/* DEFECT: the FILE_DESCRIPTION string contains a real 0x0A byte mid-string */
FILE_DESCRIPTION(('first line
second line'),'2;1');
FILE_NAME('Wr029.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('pt',(1.,0.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('newline-header-shape',());
ENDSEC;
END-ISO-10303-21;
