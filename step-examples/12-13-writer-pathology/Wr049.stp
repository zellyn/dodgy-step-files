/* Wr049 - Subtractive pipe at right-angle joints emits hidden sphere of
 * material in joint.
 * Defect (FreeCAD #26161): the sphere that the producer used to fill the
 * inside of a 90-degree pipe corner is left in the file as a closed
 * sub-shell that should have been Boolean-subtracted before emission. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Wr049 - construction-residual sphere at pipe joint'),'2;1');
FILE_NAME('Wr049.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('Wr049_pipe','pipe with residual sphere','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
/* Cylindrical pipe-segment shell A (along X axis) */
#20=CARTESIAN_POINT('a_origin',(0.0,0.0,0.0));
#21=DIRECTION('a_axis',(1.0,0.0,0.0));
#22=DIRECTION('a_ref',(0.0,0.0,1.0));
#23=AXIS2_PLACEMENT_3D('a_frame',#20,#21,#22);
#24=CYLINDRICAL_SURFACE('pipe_a',#23,5.0);
#25=ADVANCED_FACE('pipe_a_face',(),#24,.T.);
#26=CLOSED_SHELL('pipe_a_shell',(#25));
/* Cylindrical pipe-segment shell B (along Y axis -- 90 degree joint) */
#30=CARTESIAN_POINT('b_origin',(0.0,0.0,0.0));
#31=DIRECTION('b_axis',(0.0,1.0,0.0));
#32=DIRECTION('b_ref',(0.0,0.0,1.0));
#33=AXIS2_PLACEMENT_3D('b_frame',#30,#31,#32);
#34=CYLINDRICAL_SURFACE('pipe_b',#33,5.0);
#35=ADVANCED_FACE('pipe_b_face',(),#34,.T.);
#36=CLOSED_SHELL('pipe_b_shell',(#35));
/* Defect: a separate closed sub-shell containing only a SPHERICAL_SURFACE
   sized to the pipe radius, centered at the joint pivot. This is the
   construction residual that should have been Boolean-subtracted before
   the producer wrote out the file -- on receivers it appears as a solid
   ball inside the joint. */
#40=CARTESIAN_POINT('sphere_origin',(0.0,0.0,0.0));
#41=DIRECTION('sphere_axis',(0.0,0.0,1.0));
#42=DIRECTION('sphere_ref',(1.0,0.0,0.0));
#43=AXIS2_PLACEMENT_3D('sphere_frame',#40,#41,#42);
#44=SPHERICAL_SURFACE('residual_corner_sphere',#43,5.0);
#45=ADVANCED_FACE('residual_sphere_face',(),#44,.T.);
#46=CLOSED_SHELL('residual_sphere_shell',(#45));
#50=SHELL_BASED_SURFACE_MODEL('Wr049_root',(#26,#36,#46));
#51=SHAPE_REPRESENTATION('Wr049_repr',(#23,#33,#43,#50),#14);
#52=SHAPE_DEFINITION_REPRESENTATION(#8,#51);
ENDSEC;
END-ISO-10303-21;
