ISO-10303-21;
/* Wr041 - Writer emits .TRUE. / .FALSE. instead of canonical .T. / .F.
 * Defect: every boolean attribute uses the long-form .TRUE. / .FALSE.
 * spelling. Producer-side root cause for the receiver-side defect Le055. */
HEADER;
FILE_DESCRIPTION(('Wr041 - writer emits long-form boolean lexemes'),'2;1');
FILE_NAME('Wr041.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('',(2.0,0.0,0.0));
#13=VERTEX_POINT('',#10);
#14=VERTEX_POINT('',#11);
#15=VERTEX_POINT('',#12);
#16=DIRECTION('',(1.0,0.0,0.0));
#17=VECTOR('',#16,1.0);
#18=LINE('',#10,#17);
#19=LINE('',#11,#17);
/* Defect: every boolean lexeme is long-form. */
#20=EDGE_CURVE('',#13,#14,#18,.TRUE.);
#21=EDGE_CURVE('',#14,#15,#19,.FALSE.);
#22=ORIENTED_EDGE('',*,*,#20,.TRUE.);
#23=ORIENTED_EDGE('',*,*,#21,.FALSE.);
#24=EDGE_LOOP('',(#22,#23));
ENDSEC;
END-ISO-10303-21;
