ISO-10303-21;
/* Wr026: vendor-specific FILE_DESCRIPTION that downstream readers special-case */
/* Receiver has heuristic: if description contains 'CAD-System-X', apply fix-up */
/* A rename to 'CAD-System X' (space instead of hyphen) silently breaks the fix-up */
HEADER;
/* DEFECT: vendor string 'CAD-System-X v12.4.1' triggers receiver heuristics */
FILE_DESCRIPTION(('CAD-System-X v12.4.1'),'2;1');
FILE_NAME('Wr026.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: minimal GEOMETRIC_CURVE_SET (no product chain needed) */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('vendor-sniff-target',());
ENDSEC;
END-ISO-10303-21;
