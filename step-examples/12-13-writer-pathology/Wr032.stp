ISO-10303-21;
/* Wr032 - Schema upgrade on export - AP203 input emitted as AP242 with synthesised stubs */
HEADER;
FILE_DESCRIPTION(('Wr032 - schema upgrade AP203 -> AP242 with empty stubs'),'2;1');
FILE_NAME('Wr032.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('mechanical design');
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);
#14=PLANE('plane',#13);
#15=ADVANCED_FACE('face',(),#14,.T.);
/* Wr032: input was AP203 with no PMI. Writer always emits AP242 and
   synthesised these empty PMI containers. Receivers that scan for PMI
   find empty containers and may report misleading 'no annotations to
   validate' */
#50=DRAUGHTING_PRE_DEFINED_COLOUR('white');
#51=GEOMETRIC_TOLERANCE_RELATIONSHIP('','',$,$);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
ENDSEC;
END-ISO-10303-21;
