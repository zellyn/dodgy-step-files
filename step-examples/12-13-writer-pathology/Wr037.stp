ISO-10303-21;
/* Wr037 - Loss of seam-edge marking on closed surfaces - cylinder seam emitted as ordinary edge with duplicate vertex */
HEADER;
FILE_DESCRIPTION(('Wr037 - cylinder seam lost on re-export'),'2;1');
FILE_NAME('Wr037.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('mechanical design');
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);
#14=CYLINDRICAL_SURFACE('cyl',#13,1.0);
/* Wr037: original had seam-marked edge at U=0 / U=2pi identification.
   Writer linearised it to two ordinary edges sharing duplicate
   coincident VERTEX_POINTs. Receiver sees two vertices at the same
   3D location and reports a non-watertight shell */
#20=CARTESIAN_POINT('seamA_top',(1.0,0.0,1.0));
#21=CARTESIAN_POINT('seamA_bot',(1.0,0.0,0.0));
#22=CARTESIAN_POINT('seamB_top',(1.0,0.0,1.0));
#23=CARTESIAN_POINT('seamB_bot',(1.0,0.0,0.0));
#30=VERTEX_POINT('vA_top',#20);
#31=VERTEX_POINT('vA_bot',#21);
#32=VERTEX_POINT('vB_top',#22);
#33=VERTEX_POINT('vB_bot',#23);
#40=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
ENDSEC;
END-ISO-10303-21;
