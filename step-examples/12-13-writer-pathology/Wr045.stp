/* Wr045 - Unit name in LENGTH_UNIT changed without rescaling coordinates.
 * Defect (FreeCAD #20546): user changes the export-unit drop-down; writer
 * flips the LENGTH_UNIT label (mm to METRE) but emits the same numeric
 * values. A 10mm cube re-imports as a 10-metre cube. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Wr045 - METRE unit declared but mm-scale coordinate values'),'2;1');
FILE_NAME('Wr045.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('Wr045_metre_label','metre label, mm values','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
/* Defect: LENGTH_UNIT declared as plain SI METRE; coordinate values
   are still on the millimetre scale (10.0 means 10 metres in this context,
   not 10 mm). */
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(10.0,0.0,0.0));
#22=CARTESIAN_POINT('',(10.0,10.0,0.0));
#23=CARTESIAN_POINT('',(0.0,10.0,0.0));
#24=CARTESIAN_POINT('',(0.0,0.0,10.0));
#25=CARTESIAN_POINT('',(10.0,0.0,10.0));
#26=CARTESIAN_POINT('',(10.0,10.0,10.0));
#27=CARTESIAN_POINT('',(0.0,10.0,10.0));
#30=DIRECTION('',(0.0,0.0,1.0));
#31=DIRECTION('',(1.0,0.0,0.0));
#32=AXIS2_PLACEMENT_3D('',#20,#30,#31);
#33=SHAPE_REPRESENTATION('Wr045_cube',(#32),#14);
#34=SHAPE_DEFINITION_REPRESENTATION(#8,#33);
ENDSEC;
END-ISO-10303-21;
