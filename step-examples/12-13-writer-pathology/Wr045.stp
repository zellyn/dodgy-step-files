ISO-10303-21;
/* Wr045: unit name in LENGTH_UNIT changed without rescaling coordinate values */
/* FreeCAD #20546: user changes export unit mm → m; writer updates the unit label */
/* but does NOT divide coordinates by 1000 — values stay as-is (mm numbers) */
/* A 10 mm cube is emitted with coordinates (10.0,10.0,10.0) under SI METRE */
/* Receivers that honour the metre unit load a 10-metre cube instead */
HEADER;
FILE_DESCRIPTION(('Wr045: LENGTH_UNIT says metre but coordinates are in mm'),'2;1');
FILE_NAME('Wr045.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* DEFECT: SI_UNIT($,.METRE.) — no MILLI prefix — declares metre as the length unit */
/* DEFECT: coordinates are 10.0 (millimetre values); correct metre values would be 0.01 */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(10.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,10.0,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,10.0));
#5=CARTESIAN_POINT('corner-xyz',(10.0,10.0,10.0));
#6=DIRECTION('xdir',(1.,0.,0.));
#7=DIRECTION('zdir',(0.,0.,1.));
/* DEFECT: $=no prefix means base unit METRE; coordinates 10.0 are mm values not metres */
#8=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.));
#9=GEOMETRIC_CURVE_SET('metre-unit-mm-values-shape',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
