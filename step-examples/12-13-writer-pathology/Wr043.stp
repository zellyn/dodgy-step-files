ISO-10303-21;
/* Wr043 - Writer emits raw UTF-8 bytes in string literal where Ed.2
 * mandates \X\ / \X2\ escape.
 * Defect: FILE_DESCRIPTION declares Edition 2 ('2;1'); a PRODUCT name
 * carries raw UTF-8 bytes for non-ASCII characters. Edition-2 readers
 * see ISO-8859-1 nonsense; only Edition-3 readers (UTF-8 default)
 * decode by accident. */
HEADER;
FILE_DESCRIPTION(('Wr043 - raw UTF-8 in Ed.2 string literal'),'2;1');
FILE_NAME('Wr043.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=PRODUCT_CONTEXT('part',#1,'mechanical');
#3=PRODUCT('café','raw UTF-8 in Ed.2','',(#2));
#4=PRODUCT('Tokyo 東京','raw multi-byte UTF-8','',(#2));
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
ENDSEC;
END-ISO-10303-21;
