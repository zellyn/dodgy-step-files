ISO-10303-21;
/* Wr005: mixed floating-point formats in one DATA section */
HEADER;
FILE_DESCRIPTION(('Wr005 - floating-point format inconsistency'),'2;1');
FILE_NAME('Wr005.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Defect: coords use four different REAL formats in same file */
/* Format 1: uppercase E with negative exponent: 1.0E-7 */
/* Format 2: lowercase e with two-digit exponent: 1e-07 */
/* Format 3: decimal expansion: 0.0000001 */
#1=CARTESIAN_POINT('pt-a',(1.0E-7,1e-07,0.0000001));
/* Format 4: extra exponent digit: 1.0e-007 */
/* Format 5: plain decimal: 1.0 */
/* Format 6: trailing-dot form: 1. */
#2=CARTESIAN_POINT('pt-b',(1.0e-007,1.0,1.));
#3=GEOMETRIC_CURVE_SET('fp-formats',(#1,#2));
ENDSEC;
END-ISO-10303-21;
