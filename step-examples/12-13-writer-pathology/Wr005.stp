ISO-10303-21;
/* Wr005 - Floating-point format inconsistency within one file - same magnitude expressed three different ways */
HEADER;
FILE_DESCRIPTION(('Wr005 - inconsistent float formatting'),'2;1');
FILE_NAME('Wr005.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('mechanical design');
#10=CARTESIAN_POINT('a',(1.0E-7,1e-07,0.0000001));
#11=CARTESIAN_POINT('b',(1.0e-007,1.0,1.));
#12=CARTESIAN_POINT('c',(2.500000000E+02,2.5e2,250.0));
#13=DIRECTION('z',(0.0,0.0,1.0));
#14=DIRECTION('x',(1.0,0.0,0.0));
#15=AXIS2_PLACEMENT_3D('p',#10,#13,#14);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#21=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#22=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
ENDSEC;
END-ISO-10303-21;
