ISO-10303-21;
/* Wr007 - Locale-sensitive decimal separator emitted (comma instead of period) - German-locale workstation produced this file */
HEADER;
FILE_DESCRIPTION(('Wr007 - comma-decimal numbers'),'2;1');
FILE_NAME('Wr007.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('mechanical design');
/* the writer used a German locale: the intended coordinates were
   (1.5, 2.5, 3.5) but the writer emitted commas as decimal separators,
   so the parser sees six integer arguments instead of three reals */
#10=CARTESIAN_POINT('p1',(1,5,2,5,3,5));
#11=DIRECTION('z',(0,0,0,0,1,0));
#12=DIRECTION('x',(1,0,0,0,0,0));
#13=AXIS2_PLACEMENT_3D('p',#10,#11,#12);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
ENDSEC;
END-ISO-10303-21;
