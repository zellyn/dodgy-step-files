ISO-10303-21;
/* Wr007: comma decimal separator (locale bug) */
HEADER;
FILE_DESCRIPTION(('Wr007 - locale-sensitive comma decimal separator'),'2;1');
FILE_NAME('Wr007.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Defect: comma used as decimal separator (intended 1.5, 2.5, 3.5) */
/* Lexer sees (1,5,2,5,3,5) — 6 separate integer tokens, not 3 reals */
#1=CARTESIAN_POINT('comma-decimal',(1,5,2,5,3,5));
#2=GEOMETRIC_CURVE_SET('locale-bug',(#1));
ENDSEC;
END-ISO-10303-21;
