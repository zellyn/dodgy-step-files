ISO-10303-21;
/* Wr033: FILE_SCHEMA declares schema version that does not exist */
/* Schema name AUTOMOTIVE_DESIGN is known; version tuple { 1 0 10303 214 99 1 1 } */
/* uses year 99 — a future/fictional edition number no receiver will recognise */
/* Writers with hard-coded schema-id strings emit implausible version tuples */
HEADER;
FILE_DESCRIPTION(('Wr033'),'2;1');
FILE_NAME('Wr033.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
/* DEFECT: version tuple '{ 1 0 10303 214 99 1 1 }' does not correspond to any edition */
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 99 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('unknown-schema-version-shape',());
ENDSEC;
END-ISO-10303-21;
