ISO-10303-21;
/* Wr030: FILE_SCHEMA over-declares schemas the DATA section does not use */
/* Three schemas declared; DATA section contains only AP203-compatible entities */
/* Writer hard-coded schema list instead of computing minimal referenced set */
HEADER;
FILE_DESCRIPTION(('Wr030'),'2;1');
FILE_NAME('Wr030.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
/* DEFECT: three schemas declared; only AP203 entities appear in DATA section */
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }','CONFIG_CONTROL_DESIGN','AP242_MANAGED_MODEL_BASED_3D_ENGINEERING'));
ENDSEC;
DATA;
/* Only AP203-compatible entities: GEOMETRIC_CURVE_SET, CARTESIAN_POINT, DIRECTION */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('ap203-only-body',());
ENDSEC;
END-ISO-10303-21;
