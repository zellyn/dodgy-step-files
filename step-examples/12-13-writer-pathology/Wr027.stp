ISO-10303-21;
/* Wr027: unit context emitted twice with different units (HEADER vs DATA mismatch) */
/* HEADER description prose claims 'part in mm'; DATA-section LENGTH_UNIT is INCH */
/* Geometry is correct at DATA-section (INCH) scale; the HEADER string is decorative */
/* Produced by writers with separate HEADER-templating and geometry-serialisation subsystems */
HEADER;
/* DEFECT: FILE_DESCRIPTION says 'part in mm' but DATA section uses INCH */
FILE_DESCRIPTION(('part in mm'),'2;1');
FILE_NAME('Wr027.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: a 1-inch unit cube edge expressed in INCH-scale coordinates */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('inch-geometry',());
/* DEFECT: LENGTH_UNIT resolves to INCH, contradicting the HEADER 'part in mm' claim */
#10=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#20);
#20=(LENGTH_UNIT()NAMED_UNIT(*)CONVERSION_BASED_UNIT('INCH',#21));
#21=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#22=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#23=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
ENDSEC;
END-ISO-10303-21;
