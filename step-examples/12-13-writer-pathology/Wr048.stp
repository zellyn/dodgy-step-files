/* Wr048 - Boolean-result body crashes STEP writer in libTKXDESTEP color
 * attribution pass.
 * Defect (FreeCAD #20641): writer dereferences sub-shape map for a fresh
 * Boolean result. On-disk artefact when the writer survives is a
 * STYLED_ITEM that references an entity number that has no definition. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Wr048 - STYLED_ITEM dangling reference from boolean export'),'2;1');
FILE_NAME('Wr048.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('Wr048_bool','boolean result with dangling style ref','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=PLANE('boolean_face',#23);
#25=ADVANCED_FACE('boolean_face',(),#24,.T.);
#26=CLOSED_SHELL('',(#25));
#27=MANIFOLD_SOLID_BREP('boolean_result',#26);
/* Defect: STYLED_ITEM points at #999 -- which is never defined in this
   file. The producer's color-attribution pass walked off the end of its
   sub-shape table for the freshly-fused boolean result. */
#30=COLOUR_RGB('red',1.0,0.0,0.0);
#31=FILL_AREA_STYLE_COLOUR('',#30);
#32=FILL_AREA_STYLE('',(#31));
#33=SURFACE_STYLE_FILL_AREA(#32);
#34=SURFACE_SIDE_STYLE('',(#33));
#35=SURFACE_STYLE_USAGE(.BOTH.,#34);
#36=PRESENTATION_STYLE_ASSIGNMENT((#35));
#37=STYLED_ITEM('dangling_style',(#36),#999);
#40=SHAPE_REPRESENTATION('Wr048_root',(#23,#27),#14);
#41=SHAPE_DEFINITION_REPRESENTATION(#8,#40);
ENDSEC;
END-ISO-10303-21;
