ISO-10303-21;
/* Wr008: excessive trailing zeros — 17 decimal digits on every coordinate */
HEADER;
FILE_DESCRIPTION(('Wr008 - excessive trailing zeros in numeric output'),'2;1');
FILE_NAME('Wr008.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Defect: printf("%.17g") pads every coord with trailing zeros */
#1=CARTESIAN_POINT('origin',(0.00000000000000000,0.00000000000000000,0.00000000000000000));
#2=CARTESIAN_POINT('unit-corner',(1.00000000000000000,2.50000000000000000,0.50000000000000000));
#3=CARTESIAN_POINT('half',(0.50000000000000000,0.25000000000000000,0.12500000000000000));
#4=DIRECTION('z-axis',(0.00000000000000000,0.00000000000000000,1.00000000000000000));
#5=GEOMETRIC_CURVE_SET('trailing-zeros',(#1,#2,#3));
ENDSEC;
