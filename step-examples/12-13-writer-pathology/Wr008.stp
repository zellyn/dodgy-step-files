ISO-10303-21;
/* Wr008 - Excessive trailing zeros in numeric output - every value padded to 17 decimal digits */
HEADER;
FILE_DESCRIPTION(('Wr008 - excessive trailing zeros'),'2;1');
FILE_NAME('Wr008.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('mechanical design');
#10=CARTESIAN_POINT('p1',(1.00000000000000000,2.50000000000000000,0.00000000000000000));
#11=CARTESIAN_POINT('p2',(0.00000000000000000,0.00000000000000000,0.00000000000000000));
#12=CARTESIAN_POINT('p3',(10.00000000000000000,20.00000000000000000,30.00000000000000000));
#13=DIRECTION('z',(0.00000000000000000,0.00000000000000000,1.00000000000000000));
#14=DIRECTION('x',(1.00000000000000000,0.00000000000000000,0.00000000000000000));
#15=AXIS2_PLACEMENT_3D('p',#10,#13,#14);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
ENDSEC;
END-ISO-10303-21;
