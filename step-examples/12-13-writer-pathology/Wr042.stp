ISO-10303-21;
/* Wr042: inconsistent line terminators: ;LF and ;CRLF mixed in DATA section */
/* Alternate records use LF and CRLF terminators (two-pass writer bug) */
/* Parser accepts both; byte-hash tools and editors see inconsistency */
HEADER;
FILE_DESCRIPTION(('Wr042: mixed line endings per record'),'2;1');
FILE_NAME('Wr042.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* DEFECT: alternating ;LF and ;CRLF terminators within the DATA section */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('px',(1.,0.,0.));
#3=CARTESIAN_POINT('py',(0.,1.,0.));
#4=CARTESIAN_POINT('pz',(0.,0.,1.));
#5=DIRECTION('xdir',(1.,0.,0.));
#6=DIRECTION('zdir',(0.,0.,1.));
#7=GEOMETRIC_CURVE_SET('mixed-eol-shape',(#1,#2,#3,#4));
ENDSEC;
END-ISO-10303-21;
