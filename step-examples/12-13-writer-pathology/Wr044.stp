ISO-10303-21;
/* Wr044: inch unit declared in LENGTH_UNIT but coordinates are in millimetres */
/* FreeCAD #18078: user picks inch export unit; writer labels file as inch but */
/* emits mm coordinates unchanged (skips the divide-by-25.4 conversion pass) */
/* A 25.4 mm cube round-trips as a 25.4 inch (645 mm) cube — 25.4x too large */
HEADER;
FILE_DESCRIPTION(('Wr044: inch unit declared but coordinates are in mm'),'2;1');
FILE_NAME('Wr044.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* DEFECT: LENGTH_UNIT declares INCH but all coordinates are millimetre values */
/* Correct inch file would have corner at (1.0, 1.0, 1.0) — 25.4mm / 25.4 */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(25.4,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,25.4,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,25.4));
#5=CARTESIAN_POINT('corner-xyz',(25.4,25.4,25.4));
#6=DIRECTION('xdir',(1.,0.,0.));
#7=DIRECTION('zdir',(0.,0.,1.));
/* DEFECT: unit declared as INCH; coordinates are mm values (25.4 should be 1.0) */
#8=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#9);
#9=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#10=(CONVERSION_BASED_UNIT('INCH',#8) LENGTH_UNIT() NAMED_UNIT(*));
#11=GEOMETRIC_CURVE_SET('inch-unit-mm-coords-shape',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
