ISO-10303-21;
/* Wr044 - Inch unit declared in LENGTH_UNIT context but coordinates emitted
 * in millimetres (no conversion).
 * Defect (FreeCAD #18078): user picks "inch" in the export dialog; writer
 * flips the LENGTH_UNIT label but does not divide coordinate values by 25.4.
 * A 25.4 mm cube round-trips as a 25.4 inch (645 mm) cube. */
HEADER;
FILE_DESCRIPTION(('Wr044 - inch unit declared but mm-scale coordinates'),'2;1');
FILE_NAME('Wr044.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('Wr044_inchcube','inch unit decl with mm values','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
/* Defect: inch unit declared, but the eight corners below carry mm-scale
   values (25.4 mm = 1 inch). After unit interpretation the cube becomes
   25.4 inch on a side -- 25.4x larger than authored. */
#10=( LENGTH_UNIT() NAMED_UNIT(*) CONVERSION_BASED_UNIT('INCH',#11) );
#11=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#12);
#12=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#13=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#14=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#15=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#16=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#15)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#13,#14)) REPRESENTATION_CONTEXT('','3D') );
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(25.4,0.0,0.0));
#22=CARTESIAN_POINT('',(25.4,25.4,0.0));
#23=CARTESIAN_POINT('',(0.0,25.4,0.0));
#24=CARTESIAN_POINT('',(0.0,0.0,25.4));
#25=CARTESIAN_POINT('',(25.4,0.0,25.4));
#26=CARTESIAN_POINT('',(25.4,25.4,25.4));
#27=CARTESIAN_POINT('',(0.0,25.4,25.4));
#30=DIRECTION('',(0.0,0.0,1.0));
#31=DIRECTION('',(1.0,0.0,0.0));
#32=AXIS2_PLACEMENT_3D('',#20,#30,#31);
#33=SHAPE_REPRESENTATION('Wr044_cube',(#32),#16);
#34=SHAPE_DEFINITION_REPRESENTATION(#8,#33);
ENDSEC;
END-ISO-10303-21;
