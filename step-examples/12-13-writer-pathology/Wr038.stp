ISO-10303-21;
/* Wr038: non-canonical entity numbering breaks round-trip equivalence */
/* Entity numbers (#42, #17, #99, #1) are in non-sequential, non-canonical order */
/* Writer assigned numbers in internal-representation visit order (unordered set) */
/* Every export run produces different numbering — file hashes change with each write */
/* A no-op round-trip (read then write) produces a byte-different file */
HEADER;
FILE_DESCRIPTION(('Wr038: non-canonical entity numbering'),'2;1');
FILE_NAME('Wr038.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* DEFECT: entity numbers skip and reorder: #42, #17, #99, #1 — non-canonical */
/* Canonical form would assign #1, #2, #3, #4 sequentially */
#42=APPLICATION_CONTEXT('automotive_design');
#17=CARTESIAN_POINT('origin',(0.,0.,0.));
#99=CARTESIAN_POINT('corner',(1.,1.,1.));
#1=GEOMETRIC_CURVE_SET('non-canonical-numbering-shape',(#17,#99));
ENDSEC;
END-ISO-10303-21;
