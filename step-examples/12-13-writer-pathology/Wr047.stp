ISO-10303-21;
/* Wr047 - STEP import regressed by BOPAlog_AlertBadPositioning warnings.
 * Defect (FreeCAD #29723): two solids share a co-incident face (zero gap,
 * zero overlap). On import the receiver's BOP fuse pass alerts on every
 * such pair, which surfaces in some builds as Unknown C++ exception. */
HEADER;
FILE_DESCRIPTION(('Wr047 - co-incident face pair triggers BOP alert on receiver'),'2;1');
FILE_NAME('Wr047.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('Wr047_pair','co-incident face pair','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
/* Solid A: 10x10x10 cube at origin */
#20=CARTESIAN_POINT('a_origin',(0.0,0.0,0.0));
#21=DIRECTION('a_z',(0.0,0.0,1.0));
#22=DIRECTION('a_x',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('a_frame',#20,#21,#22);
#24=PLANE('a_plane',#23);
#25=ADVANCED_FACE('a_face',(),#24,.T.);
#26=CLOSED_SHELL('a_shell',(#25));
#27=MANIFOLD_SOLID_BREP('cube_a',#26);
/* Solid B: 10x10x10 cube positioned exactly flush against A at x=10
   (no gap, no overlap volume) -- triggers BOPAlog_AlertBadPositioning
   on receivers that fuse. */
#30=CARTESIAN_POINT('b_origin',(10.0,0.0,0.0));
#31=DIRECTION('b_z',(0.0,0.0,1.0));
#32=DIRECTION('b_x',(1.0,0.0,0.0));
#33=AXIS2_PLACEMENT_3D('b_frame_flush_with_a',#30,#31,#32);
#34=PLANE('b_plane',#33);
#35=ADVANCED_FACE('b_face',(),#34,.T.);
#36=CLOSED_SHELL('b_shell',(#35));
#37=MANIFOLD_SOLID_BREP('cube_b',#36);
#40=SHAPE_REPRESENTATION('Wr047_pair',(#23,#33,#27,#37),#14);
#41=SHAPE_DEFINITION_REPRESENTATION(#8,#40);
ENDSEC;
END-ISO-10303-21;
