/* Wr019 - Re-export drops XCAF colour assignments - colours present in input file are absent here */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Wr019 - colours dropped on re-export'),'2;1');
FILE_NAME('Wr019.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('mechanical design');
#2=PRODUCT_CONTEXT('part',#1,'mechanical');
#3=PRODUCT('Wr019-part','Wr019 demo','',(#2));
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);
#14=PLANE('plane',#13);
#15=ADVANCED_FACE('face',(),#14,.T.);
#16=OPEN_SHELL('shell',(#15));
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
/* Wr019: input had STYLED_ITEM/PRESENTATION_STYLE_ASSIGNMENT/COLOUR_RGB
   chains assigning each face a distinct colour. Writer dropped them all;
   the re-emitted file has no colour data. Receivers display the model
   in default grey */
ENDSEC;
END-ISO-10303-21;
