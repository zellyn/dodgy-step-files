ISO-10303-21;
/* Wr023 - Validation properties dropped on re-export - volume/area/centroid checksums lost */
HEADER;
FILE_DESCRIPTION(('Wr023 - validation properties dropped on re-export'),'2;1');
FILE_NAME('Wr023.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('mechanical design');
#2=PRODUCT_CONTEXT('part',#1,'mechanical');
#3=PRODUCT('Wr023-part','Wr023 demo','',(#2));
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);
#14=PLANE('plane',#13);
#15=ADVANCED_FACE('face',(),#14,.T.);
/* Wr023: input had GEOMETRIC_VALIDATION_PROPERTY entries declaring
   producer-computed volume = 1.0, area = 6.0, centroid = (0.5,0.5,0.5)
   for each solid. Writer dropped all validation properties; receiver
   has no checksum to verify the round-trip */
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
ENDSEC;
END-ISO-10303-21;
