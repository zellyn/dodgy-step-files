ISO-10303-21;
/* Wr039 - Re-export re-orders attributes within complex (subtype-stack) records */
HEADER;
FILE_DESCRIPTION(('Wr039 - subtype-stack reordering on re-export'),'2;1');
FILE_NAME('Wr039.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('mechanical design');
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);
/* Wr039: canonical ordering of LENGTH_UNIT/NAMED_UNIT/SI_UNIT in
   complex records varies by writer. Receivers building canonical hash
   strings see this as a different file than the input */
#20=(SI_UNIT(.MILLI.,.METRE.) NAMED_UNIT(*) LENGTH_UNIT());
#21=(SI_UNIT($,.RADIAN.) PLANE_ANGLE_UNIT() NAMED_UNIT(*));
#22=(SOLID_ANGLE_UNIT() SI_UNIT($,.STERADIAN.) NAMED_UNIT(*));
ENDSEC;
END-ISO-10303-21;
