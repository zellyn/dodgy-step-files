ISO-10303-21;
/* Wr039: re-export re-orders attributes within complex (subtype-stack) records */
/* Canonical: (LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.)) */
/* DEFECT:    (SI_UNIT(.MILLI.,.METRE.) NAMED_UNIT(*) LENGTH_UNIT()) */
/* Writer iterated an unordered set of supertype names; SI_UNIT happened first */
/* Parsers accept both orders; byte-hash comparators report the file as changed */
HEADER;
FILE_DESCRIPTION(('Wr039: non-canonical complex-entity supertype ordering'),'2;1');
FILE_NAME('Wr039.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
/* DEFECT: supertype order is SI_UNIT first, then NAMED_UNIT, then LENGTH_UNIT */
/* Canonical schema-declaration order is: LENGTH_UNIT NAMED_UNIT SI_UNIT */
#20=(SI_UNIT(.MILLI.,.METRE.) NAMED_UNIT(*) LENGTH_UNIT());
#21=GEOMETRIC_CURVE_SET('reordered-complex-entity-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
