/* Wr034 - Coordinate-system axis swap without notification - Y-up source emitted as if Z-up */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Wr034 - Y-up coordinates emitted without rotation'),'2;1');
FILE_NAME('Wr034.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('mechanical design');
/* Wr034: input was a column 1m wide, 1m deep, 10m tall in a Y-up system.
   Writer emitted coords directly without applying the 90-degree rotation
   to convert to Z-up. The vertical extent is now along Y; the model
   imports lying on its side */
#10=CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p2',(1.0,10.0,0.0));
#12=CARTESIAN_POINT('p3',(1.0,10.0,1.0));
#13=CARTESIAN_POINT('p4',(0.0,10.0,1.0));
#14=CARTESIAN_POINT('p5',(0.0,0.0,1.0));
#15=CARTESIAN_POINT('p6',(1.0,0.0,1.0));
#16=DIRECTION('z',(0.0,0.0,1.0));
#17=DIRECTION('x',(1.0,0.0,0.0));
#18=AXIS2_PLACEMENT_3D('placement',#10,#16,#17);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
ENDSEC;
END-ISO-10303-21;
