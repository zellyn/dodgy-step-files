ISO-10303-21;
/* Wr034: coordinate-system axis swap without notification (Y-up vs Z-up) */
/* Input was authored in a Y-up coordinate system (web-CAD/game-engine convention) */
/* Writer emitted coordinates as-is; did not apply the Y-up to Z-up rotation */
/* STEP/CAD convention: Z is up; this file has geometry with vertical extent along Y */
/* Receivers that assume Z-up load the model rotated 90 degrees on its side */
HEADER;
FILE_DESCRIPTION(('Wr034: Y-up geometry emitted without Z-up transform'),'2;1');
FILE_NAME('Wr034.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* DEFECT: geometry vertices have largest extent in Y-axis (Y-up authoring) */
/* Correct Z-up STEP file would have largest extent in Z; writer skipped the transform */
/* Y-up source had a tall tower: base at Y=0, apex at Y=10; emitted without rotation */
#1=CARTESIAN_POINT('base-corner-0',(0.,0.,0.));
#2=CARTESIAN_POINT('base-corner-1',(1.,0.,0.));
#3=CARTESIAN_POINT('base-corner-2',(1.,0.,1.));
#4=CARTESIAN_POINT('base-corner-3',(0.,0.,1.));
#5=CARTESIAN_POINT('apex-corner-0',(0.,10.,0.));
#6=CARTESIAN_POINT('apex-corner-1',(1.,10.,0.));
#7=CARTESIAN_POINT('apex-corner-2',(1.,10.,1.));
#8=CARTESIAN_POINT('apex-corner-3',(0.,10.,1.));
#9=GEOMETRIC_CURVE_SET('Y-up-authored-tower-shape',(#1,#2,#3,#4,#5,#6,#7,#8));
ENDSEC;
END-ISO-10303-21;
