ISO-10303-21;
/* Pf002: dense VERTEX_POINT/EDGE_CURVE/ADVANCED_FACE web; forward-reference pattern causes O(N²) writer reference-resolution; the defect entity is emitted but sits unreachable from the shape-rep root (product chain roots a GEOMETRIC_CURVE_SET stub), so OCC loads only a 1-vertex stub (shape(1)); byte-present but oracle-invisible to the load-time shape-count oracles */
HEADER;
FILE_DESCRIPTION(('Pf002'),'2;1');
FILE_NAME('Pf002.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
