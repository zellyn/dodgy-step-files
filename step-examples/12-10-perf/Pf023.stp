/* Pf023 - Iterative ShapeFix exposes new defect every pass (unbounded)
   Pattern: ShapeFix_Wire and friends iterate until modification flags
   settle; each fix introduces a new defect that needs another pass
   (e.g. reordering exposes self-intersection; closing a gap exposes a
   tolerance violation). Vendors document "running healing twice converts
   splines to analytics" - admission that single-pass coverage is
   insufficient (Mantis 0021317; CADfix multi-pass; W015).
   Scaling-up: this fixture has a single wire that simultaneously needs:
   - reordering (edges declared out of head-tail order)
   - 3D/2D mismatch (one edge has incompatible vertex coords)
   - self-intersection (a micro-loop crossing earlier edge)
   Run ShapeFix_Wire with default settings to observe many passes. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pf023 - multi-pass healing: reorder + mismatch + self-int'),'2;1');
FILE_NAME('Pf023.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=DIRECTION('',(0.0,0.0,1.0));
#3=DIRECTION('',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('',#1,#2,#3);
#5=PLANE('',#4);
/* vertices of a square with a near-but-not-exact closure (gap) */
#10=CARTESIAN_POINT('A',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('B',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('C',(1.0,1.0,0.0));
#13=CARTESIAN_POINT('D',(0.0,1.0,0.0));
/* near-closing point not exactly equal to A - causes gap; once gap
   closes via tolerance, the wire becomes self-intersecting via #14 */
#14=CARTESIAN_POINT('A-near',(0.001,0.001,0.0));
/* micro-loop point that lies inside the square - self-intersection */
#15=CARTESIAN_POINT('loop',(0.5,-0.1,0.0));
#20=VERTEX_POINT('vA',#10);
#21=VERTEX_POINT('vB',#11);
#22=VERTEX_POINT('vC',#12);
#23=VERTEX_POINT('vD',#13);
#24=VERTEX_POINT('vAnear',#14);
#25=VERTEX_POINT('vloop',#15);
#30=VECTOR('',#3,1.0);
#31=LINE('',#10,#30);
/* edges declared in non-head-to-tail order (reorder needed):
   declared sequence: BC, AB, CD, DA-near, micro-loop */
#40=EDGE_CURVE('BC',#21,#22,#31,.T.);
#41=EDGE_CURVE('AB',#20,#21,#31,.T.);
#42=EDGE_CURVE('CD',#22,#23,#31,.T.);
#43=EDGE_CURVE('D-Anear',#23,#24,#31,.T.);
#44=EDGE_CURVE('micro-loop',#24,#25,#31,.T.);
#45=EDGE_CURVE('loop-back',#25,#20,#31,.T.);
#50=ORIENTED_EDGE('',*,*,#40,.T.);
#51=ORIENTED_EDGE('',*,*,#41,.T.);
#52=ORIENTED_EDGE('',*,*,#42,.T.);
#53=ORIENTED_EDGE('',*,*,#43,.T.);
#54=ORIENTED_EDGE('',*,*,#44,.T.);
#55=ORIENTED_EDGE('',*,*,#45,.T.);
/* edge loop in declared (wrong) order - exposes reorder need */
#60=EDGE_LOOP('multipass-target',(#50,#51,#52,#53,#54,#55));
#70=FACE_OUTER_BOUND('',#60,.T.);
#100=ADVANCED_FACE('healing-target',(#70),#5,.T.);
ENDSEC;
END-ISO-10303-21;
