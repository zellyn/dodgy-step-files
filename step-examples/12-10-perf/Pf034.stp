ISO-10303-21;
/* Pf034 - NoMoreObject on large shape divide.
 * Pattern: compound of ~200 cubes (1,200 faces) - shape-divide hits an
 * internal hard-coded collection limit.
 * Notes: scaled-down representative - this fixture has 5 minimal
 * MANIFOLD_SOLID_BREPs (30 ADVANCED_FACEs) inside a compound
 * SHAPE_REPRESENTATION to make the many-solid pattern recognisable.
 * Replicate the brep block to 200 to reproduce the production
 * shape-divide overflow. */
HEADER;
FILE_DESCRIPTION(('Pf034 test case','NoMoreObject on large shape divide'),'2;1');
FILE_NAME('Pf034.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('p',#13);
#15=EDGE_LOOP('',());
#16=FACE_OUTER_BOUND('',#15,.T.);
/* Cube 1: six faces + shell + brep */
#20=ADVANCED_FACE('c1f1',(#16),#14,.T.);#21=ADVANCED_FACE('c1f2',(#16),#14,.T.);
#22=ADVANCED_FACE('c1f3',(#16),#14,.T.);#23=ADVANCED_FACE('c1f4',(#16),#14,.T.);
#24=ADVANCED_FACE('c1f5',(#16),#14,.T.);#25=ADVANCED_FACE('c1f6',(#16),#14,.T.);
#26=CLOSED_SHELL('cs1',(#20,#21,#22,#23,#24,#25));
#27=MANIFOLD_SOLID_BREP('cube1',#26);
/* Cube 2 */
#30=ADVANCED_FACE('c2f1',(#16),#14,.T.);#31=ADVANCED_FACE('c2f2',(#16),#14,.T.);
#32=ADVANCED_FACE('c2f3',(#16),#14,.T.);#33=ADVANCED_FACE('c2f4',(#16),#14,.T.);
#34=ADVANCED_FACE('c2f5',(#16),#14,.T.);#35=ADVANCED_FACE('c2f6',(#16),#14,.T.);
#36=CLOSED_SHELL('cs2',(#30,#31,#32,#33,#34,#35));
#37=MANIFOLD_SOLID_BREP('cube2',#36);
/* Cube 3 */
#40=ADVANCED_FACE('c3f1',(#16),#14,.T.);#41=ADVANCED_FACE('c3f2',(#16),#14,.T.);
#42=ADVANCED_FACE('c3f3',(#16),#14,.T.);#43=ADVANCED_FACE('c3f4',(#16),#14,.T.);
#44=ADVANCED_FACE('c3f5',(#16),#14,.T.);#45=ADVANCED_FACE('c3f6',(#16),#14,.T.);
#46=CLOSED_SHELL('cs3',(#40,#41,#42,#43,#44,#45));
#47=MANIFOLD_SOLID_BREP('cube3',#46);
/* Cube 4 */
#50=ADVANCED_FACE('c4f1',(#16),#14,.T.);#51=ADVANCED_FACE('c4f2',(#16),#14,.T.);
#52=ADVANCED_FACE('c4f3',(#16),#14,.T.);#53=ADVANCED_FACE('c4f4',(#16),#14,.T.);
#54=ADVANCED_FACE('c4f5',(#16),#14,.T.);#55=ADVANCED_FACE('c4f6',(#16),#14,.T.);
#56=CLOSED_SHELL('cs4',(#50,#51,#52,#53,#54,#55));
#57=MANIFOLD_SOLID_BREP('cube4',#56);
/* Cube 5 */
#60=ADVANCED_FACE('c5f1',(#16),#14,.T.);#61=ADVANCED_FACE('c5f2',(#16),#14,.T.);
#62=ADVANCED_FACE('c5f3',(#16),#14,.T.);#63=ADVANCED_FACE('c5f4',(#16),#14,.T.);
#64=ADVANCED_FACE('c5f5',(#16),#14,.T.);#65=ADVANCED_FACE('c5f6',(#16),#14,.T.);
#66=CLOSED_SHELL('cs5',(#60,#61,#62,#63,#64,#65));
#67=MANIFOLD_SOLID_BREP('cube5',#66);
/* Compound shape representation containing all 5 breps */
#70=SHAPE_REPRESENTATION('compound_of_cubes',(#27,#37,#47,#57,#67),#1);
ENDSEC;
END-ISO-10303-21;
