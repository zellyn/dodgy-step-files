/* Pf003 - 50-second read on a 20 MB STEP, single-threaded
   Pattern: a moderate-sized file (20 MB) with many independent entities
   and forward refs forces the C++ reader's serial parser + serial reference
   resolver to dominate runtime. Language-level threading does not help
   because OCCT does not use OSD_Parallel for this code path.
   Scaling-up: this stub demonstrates the forward-reference and dense-edge
   pattern; replicate the EDGE_CURVE/ADVANCED_FACE block to ~30000 entries
   plus a similar count of CARTESIAN_POINTs to reach ~20 MB and reproduce
   the ~50 s parse time documented in pythonocc-core #1244. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pf003 - 20 MB single-threaded reader scalability stub'),'2;1');
FILE_NAME('Pf003.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=DIRECTION('',(0.0,0.0,1.0));
#3=DIRECTION('',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('',#1,#2,#3);
/* heavy forward-reference chain — every face references a later edge loop,
   which references later edges, which reference later vertices+lines.
   This forces the reader to do many forward-resolve passes. */
#10=ADVANCED_FACE('',(#100),#200,.T.);
#11=ADVANCED_FACE('',(#101),#201,.T.);
#12=ADVANCED_FACE('',(#102),#202,.T.);
#13=ADVANCED_FACE('',(#103),#203,.T.);
#14=ADVANCED_FACE('',(#104),#204,.T.);
#15=ADVANCED_FACE('',(#105),#205,.T.);
#16=ADVANCED_FACE('',(#106),#206,.T.);
#17=ADVANCED_FACE('',(#107),#207,.T.);
/* face outer bounds */
#100=FACE_OUTER_BOUND('',#300,.T.);
#101=FACE_OUTER_BOUND('',#301,.T.);
#102=FACE_OUTER_BOUND('',#302,.T.);
#103=FACE_OUTER_BOUND('',#303,.T.);
#104=FACE_OUTER_BOUND('',#304,.T.);
#105=FACE_OUTER_BOUND('',#305,.T.);
#106=FACE_OUTER_BOUND('',#306,.T.);
#107=FACE_OUTER_BOUND('',#307,.T.);
/* surfaces */
#200=PLANE('',#4);
#201=PLANE('',#4);
#202=PLANE('',#4);
#203=PLANE('',#4);
#204=PLANE('',#4);
#205=PLANE('',#4);
#206=PLANE('',#4);
#207=PLANE('',#4);
/* edge loops */
#300=EDGE_LOOP('',(#400));
#301=EDGE_LOOP('',(#401));
#302=EDGE_LOOP('',(#402));
#303=EDGE_LOOP('',(#403));
#304=EDGE_LOOP('',(#404));
#305=EDGE_LOOP('',(#405));
#306=EDGE_LOOP('',(#406));
#307=EDGE_LOOP('',(#407));
/* oriented edges */
#400=ORIENTED_EDGE('',*,*,#500,.T.);
#401=ORIENTED_EDGE('',*,*,#501,.T.);
#402=ORIENTED_EDGE('',*,*,#502,.T.);
#403=ORIENTED_EDGE('',*,*,#503,.T.);
#404=ORIENTED_EDGE('',*,*,#504,.T.);
#405=ORIENTED_EDGE('',*,*,#505,.T.);
#406=ORIENTED_EDGE('',*,*,#506,.T.);
#407=ORIENTED_EDGE('',*,*,#507,.T.);
/* edge curves */
#500=EDGE_CURVE('',#600,#601,#700,.T.);
#501=EDGE_CURVE('',#601,#602,#701,.T.);
#502=EDGE_CURVE('',#602,#603,#702,.T.);
#503=EDGE_CURVE('',#603,#604,#703,.T.);
#504=EDGE_CURVE('',#604,#605,#704,.T.);
#505=EDGE_CURVE('',#605,#606,#705,.T.);
#506=EDGE_CURVE('',#606,#607,#706,.T.);
#507=EDGE_CURVE('',#607,#600,#707,.T.);
/* vertices */
#600=VERTEX_POINT('',#1);
#601=VERTEX_POINT('',#1);
#602=VERTEX_POINT('',#1);
#603=VERTEX_POINT('',#1);
#604=VERTEX_POINT('',#1);
#605=VERTEX_POINT('',#1);
#606=VERTEX_POINT('',#1);
#607=VERTEX_POINT('',#1);
/* lines / vectors */
#700=LINE('',#1,#800);
#701=LINE('',#1,#800);
#702=LINE('',#1,#800);
#703=LINE('',#1,#800);
#704=LINE('',#1,#800);
#705=LINE('',#1,#800);
#706=LINE('',#1,#800);
#707=LINE('',#1,#800);
#800=VECTOR('',#3,1.0);
ENDSEC;
END-ISO-10303-21;
