ISO-10303-21;
/* Pf036 - STEPCAFControl_Reader hangs on cyclic MAPPED_ITEM reference
 * Defect: REPRESENTATION_MAP #100 owns SHAPE_REPRESENTATION #110,
 * which contains MAPPED_ITEM #120 that references back to #100. */
HEADER;
FILE_DESCRIPTION(('Pf036 - cyclic MAPPED_ITEM/REPRESENTATION_MAP reference'),'2;1');
FILE_NAME('Pf036.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('origin',#10,#11,#12);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#21=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#22=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#23=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-7),#20,'','');
#24=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#23)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#21,#22)) REPRESENTATION_CONTEXT('Context','3D'));
/* Cyclic chain: REPRESENTATION_MAP #100 owns SHAPE_REPRESENTATION #110;
 * #110 contains MAPPED_ITEM #120; MAPPED_ITEM #120 references REPRESENTATION_MAP #100. */
#100=REPRESENTATION_MAP(#13,#110);
#110=SHAPE_REPRESENTATION('cyclic_rep',(#13,#120),#24);
#120=MAPPED_ITEM('cycle_target',#100,#13);
ENDSEC;
END-ISO-10303-21;
