ISO-10303-21;
/* Pf029 - TDocStd_Document creation aborts process under VSCode server
   runtime (pythonocc-core #1428). `doc = TDocStd_Document(...)` triggers
   process abort under code-server / extension-host runtimes when reading
   a multi-level assembly STEP. Symptom of resource / signal-handling
   assumptions that fail at scale.
   Pattern: a multi-level assembly that exercises STEPCAFControl_Reader
   document creation (the abort path is in OCCT, not the file - any
   multi-level assembly under code-server reproduces).
   Scaling-up: this fixture has assembly depth ~6 with multiple shape
   reps. Replicate to deeper / wider assemblies as needed. The trigger
   is the runtime environment (code-server) more than the file content. */
HEADER;
FILE_DESCRIPTION(('Pf029 - multi-level assembly that aborts under code-server'),'2;1');
FILE_NAME('Pf029.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
