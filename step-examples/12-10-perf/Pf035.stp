/* Pf035 - Large assembly STEP loads at 100% CPU with unbounded memory
 * growth until OOM.
 * Defect (FreeCAD #14565): the producer's MAPPED_ITEM resolver computes
 * the closure of the REPRESENTATION_MAP graph eagerly. A single
 * REPRESENTATION_MAP referenced by many MAPPED_ITEMs in deeply nested
 * NEXT_ASSEMBLY_USAGE_OCCURRENCE chains explodes the closure size. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pf035 - deeply nested NAUO + many MAPPED_ITEMs sharing one REPRESENTATION_MAP'),'2;1');
FILE_NAME('Pf035.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('Pf035_assy','deep nesting','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
/* Single shared REPRESENTATION_MAP carrying a minimal solid. */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('master_frame',#20,#21,#22);
#24=PLANE('',#23);
#25=ADVANCED_FACE('',(),#24,.T.);
#26=CLOSED_SHELL('',(#25));
#27=MANIFOLD_SOLID_BREP('master',#26);
#28=SHAPE_REPRESENTATION('master',(#23,#27),#14);
#29=REPRESENTATION_MAP(#23,#28);
/* Many MAPPED_ITEMs sharing #29. Receivers that materialise eagerly
   would close over each instance fully. */
#100=AXIS2_PLACEMENT_3D('inst_a',#20,#21,#22); #101=MAPPED_ITEM('a',#29,#100);
#102=AXIS2_PLACEMENT_3D('inst_b',#20,#21,#22); #103=MAPPED_ITEM('b',#29,#102);
#104=AXIS2_PLACEMENT_3D('inst_c',#20,#21,#22); #105=MAPPED_ITEM('c',#29,#104);
#106=AXIS2_PLACEMENT_3D('inst_d',#20,#21,#22); #107=MAPPED_ITEM('d',#29,#106);
#108=AXIS2_PLACEMENT_3D('inst_e',#20,#21,#22); #109=MAPPED_ITEM('e',#29,#108);
/* Deeply nested NEXT_ASSEMBLY_USAGE_OCCURRENCE chain. */
#200=NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','lvl1','',#7,#7,$);
#201=NEXT_ASSEMBLY_USAGE_OCCURRENCE('2','lvl2','',#7,#7,$);
#202=NEXT_ASSEMBLY_USAGE_OCCURRENCE('3','lvl3','',#7,#7,$);
#203=NEXT_ASSEMBLY_USAGE_OCCURRENCE('4','lvl4','',#7,#7,$);
#204=NEXT_ASSEMBLY_USAGE_OCCURRENCE('5','lvl5','',#7,#7,$);
#205=NEXT_ASSEMBLY_USAGE_OCCURRENCE('6','lvl6','',#7,#7,$);
ENDSEC;
END-ISO-10303-21;
