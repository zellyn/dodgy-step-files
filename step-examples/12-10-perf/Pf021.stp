ISO-10303-21;
/* Pf021 - Floating / non-deterministic crash in shape healing
   Pattern: healing pipeline crashes intermittently on the same input;
   symptoms are uninitialized memory, threading races, or floating-point
   exceptions in projection routines. Whole class, not a single defect -
   every vendor fixes it repeatedly (CAD Exchanger CHANGES v3.24.8).
   The file pattern below stresses the projection / healing path with
   geometry that produces near-singular Jacobians: a face whose surface
   degenerates near a wire vertex (cone apex or sphere pole), and an
   edge curve that approaches a self-intersection at a parameter that
   is not exactly representable.
   Scaling-up: same file, run 1000 times under repeated reads of
   the same input - observe non-deterministic crash / divergent output. */
HEADER;
FILE_DESCRIPTION(('Pf021 - non-deterministic healing crash pattern'),'2;1');
FILE_NAME('Pf021.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=DIRECTION('',(0.0,0.0,1.0));
#3=DIRECTION('',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('',#1,#2,#3);
/* cone apex - projection here is singular */
#5=CONICAL_SURFACE('singular-cone',#4,1.0,0.785398163397448);
/* edge that touches the apex - projection produces FP exception
   non-deterministically depending on uninitialised scratch state */
#10=CARTESIAN_POINT('apex',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('off-apex',(1e-12,1e-12,1e-12));
#12=CARTESIAN_POINT('away',(1.0,0.0,1.0));
#20=VERTEX_POINT('apex-v',#10);
#21=VERTEX_POINT('off-apex-v',#11);
#22=VERTEX_POINT('away-v',#12);
#30=VECTOR('',#3,1.0);
#31=LINE('',#10,#30);
/* edge from apex to off-apex - the ~zero-length but non-zero edge that
   triggers floating-point ambiguity in projection */
#40=EDGE_CURVE('zero-len-near-apex',#20,#21,#31,.T.);
#41=EDGE_CURVE('apex-to-away',#21,#22,#31,.T.);
#42=ORIENTED_EDGE('',*,*,#40,.T.);
#43=ORIENTED_EDGE('',*,*,#41,.T.);
#50=EDGE_LOOP('',(#42,#43));
#51=FACE_OUTER_BOUND('',#50,.T.);
#60=ADVANCED_FACE('apex-touch',(#51),#5,.T.);
#100=OPEN_SHELL('healing-trigger',(#60));
ENDSEC;
END-ISO-10303-21;
