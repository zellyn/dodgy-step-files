ISO-10303-21;
/* Pf020 - OCAF modification-delta leak on long-running healing test
   suites (quaoar B013).  OCAF's modification-delta mechanism for
   array-style attributes (Active Data Mesh Attribute) skips a destructor
   on the previous state; long-running suites that perform thousands of
   modify/commit cycles accumulate memory.  Hides as "test-suite OOM".
   The trigger is repeated modify/commit, not the file content. We
   provide a small mesh-attribute-bearing file with multiple array
   targets so a regression suite can open / mutate / commit it many
   times under varying mutation patterns.
   Scaling-up: have a test driver run thousands of modify/commit cycles
   on this file's attributes; observe RSS growth proportional to
   iteration count. The fixture only needs to look like representative
   in-memory state — the leak is in the OCAF Backup/Delta path. */
HEADER;
FILE_DESCRIPTION(('Pf020 - OCAF mod-delta leak: multi-attribute mesh file'),'2;1');
FILE_NAME('Pf020.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('LEAK-TARGET','','',(#3));
#5=PRODUCT_DEFINITION_FORMATION('','',#4);
#6=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
#8=( NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) LENGTH_UNIT() );
#9=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#8,'','');
#10=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT
  ((#9)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#8)) REPRESENTATION_CONTEXT('','3D') );
/* basic placement (always present so ShapeFix has somewhere to start) */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
/* multiple array-style geometric_representation_items the OCAF
   array-attribute mechanism would track separately - each becomes
   one Backup/Delta target. */
#24=CARTESIAN_POINT('',(1.0,0.0,0.0));
#25=CARTESIAN_POINT('',(2.0,0.0,0.0));
#26=CARTESIAN_POINT('',(3.0,0.0,0.0));
#27=CARTESIAN_POINT('',(4.0,0.0,0.0));
#28=CARTESIAN_POINT('',(0.0,1.0,0.0));
#29=CARTESIAN_POINT('',(1.0,1.0,0.0));
#30=CARTESIAN_POINT('',(2.0,1.0,0.0));
#31=CARTESIAN_POINT('',(3.0,1.0,0.0));
#32=CARTESIAN_POINT('',(0.0,2.0,0.0));
#33=CARTESIAN_POINT('',(1.0,2.0,0.0));
#34=CARTESIAN_POINT('',(2.0,2.0,0.0));
#35=CARTESIAN_POINT('',(3.0,2.0,0.0));
/* multiple geometric sets of varying sizes - each is one array attribute
   the OCAF Backup/Delta mechanism backs up separately on commit. */
#40=GEOMETRIC_SET('arr-1',(#20,#24,#25,#26));
#41=GEOMETRIC_SET('arr-2',(#27,#28,#29,#30));
#42=GEOMETRIC_SET('arr-3',(#31,#32,#33,#34));
#43=GEOMETRIC_SET('arr-4',(#20,#24,#28,#32));
#44=GEOMETRIC_SET('arr-5',(#25,#29,#33,#35));
#45=GEOMETRIC_SET('arr-6',(#20,#21,#22,#23));
/* polylines as additional mesh-style array attributes */
#50=POLYLINE('mesh-edge-1',(#20,#24,#25,#26,#27));
#51=POLYLINE('mesh-edge-2',(#28,#29,#30,#31));
#52=POLYLINE('mesh-edge-3',(#32,#33,#34,#35));
/* wrapping curve set + shape rep - what OCAF binds to each TDF_Label */
#60=GEOMETRIC_CURVE_SET('mesh-edges',(#50,#51,#52));
#70=SHAPE_REPRESENTATION('mod-target',
  (#23,#40,#41,#42,#43,#44,#45,#60),#10);
#71=PRODUCT_DEFINITION_SHAPE('','',#7);
#72=SHAPE_DEFINITION_REPRESENTATION(#71,#70);
ENDSEC;
END-ISO-10303-21;
