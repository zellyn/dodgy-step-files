ISO-10303-21;
/* Pf022 - Non-deterministic empty-export from in-memory state leakage
   (gmsh #3332; quaoar B011).
   Pattern A (gmsh): import a STEP, gmsh.model.remove() some entities,
   then gmsh.write("out.step") - writer emits "No suitable CAD data
   found" non-deterministically depending on past actions, not on
   current document content.
   Pattern B (OCCT Draw): `stepread file.stp sh *` populates a transient
   model that the next `stepwrite` re-uses, doubling the output and
   producing a file twice the expected size.
   The fixture is a benign valid STEP that drives the round-trip. We
   include several distinct shapes so that selective `gmsh.model.remove`
   calls leave varying mixes of populated / cleared state across runs.
   Scaling-up: run import-then-clear cycle in a loop and observe that
   the writer's output depends on prior calls, not on current state. */
HEADER;
FILE_DESCRIPTION(('Pf022 - non-deterministic empty-export round-trip target'),'2;1');
FILE_NAME('Pf022.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('ROUNDTRIP','','',(#3));
#5=PRODUCT_DEFINITION_FORMATION('','',#4);
#6=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
#8=( NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) LENGTH_UNIT() );
#9=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#8,'','');
#10=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT
  ((#9)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#8)) REPRESENTATION_CONTEXT('','3D') );
/* placements for several distinct shapes - each becomes a "removable"
   entity in a gmsh.model context, so partial-clear scenarios produce
   varying writer output. */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=CARTESIAN_POINT('',(10.0,0.0,0.0));
#25=AXIS2_PLACEMENT_3D('',#24,#21,#22);
#26=CARTESIAN_POINT('',(20.0,0.0,0.0));
#27=AXIS2_PLACEMENT_3D('',#26,#21,#22);
#28=CARTESIAN_POINT('',(30.0,0.0,0.0));
#29=AXIS2_PLACEMENT_3D('',#28,#21,#22);
/* shape representations, each a candidate for selective clear */
#30=SHAPE_REPRESENTATION('shape-1',(#23),#10);
#31=SHAPE_REPRESENTATION('shape-2',(#25),#10);
#32=SHAPE_REPRESENTATION('shape-3',(#27),#10);
#33=SHAPE_REPRESENTATION('shape-4',(#29),#10);
/* wire to populate one rep with data so .clear() vs .remove() differ */
#40=POLYLINE('',(#20,#24));
#41=GEOMETRIC_CURVE_SET('curves',(#40));
#42=SHAPE_REPRESENTATION('curves-rep',(#41),#10);
/* product-definition-shape and shape-definition-representation links
   exercise OCCT Draw's stepread session-state retention. */
#50=PRODUCT_DEFINITION_SHAPE('','',#7);
#51=SHAPE_DEFINITION_REPRESENTATION(#50,#30);
#52=SHAPE_DEFINITION_REPRESENTATION(#50,#31);
#53=SHAPE_DEFINITION_REPRESENTATION(#50,#32);
#54=SHAPE_DEFINITION_REPRESENTATION(#50,#33);
#55=SHAPE_DEFINITION_REPRESENTATION(#50,#42);
ENDSEC;
END-ISO-10303-21;
