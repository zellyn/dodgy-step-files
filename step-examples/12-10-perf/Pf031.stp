ISO-10303-21;
/* Pf031 - STEP read parsing slow due to single-pass tokenisation.
 * Pattern: 100 MB STEP files with millions of small entities; the parser
 * issues one read syscall per character. Production scale: ~10^7
 * CARTESIAN_POINTs.
 * Notes: scaled-down representative - this fixture has ~30
 * CARTESIAN_POINTs to make the small-entity-density pattern recognisable
 * to a static scanner; replicate the block to ~10^6 to reproduce the
 * production-scale 100 MB I/O-dominated parse. */
HEADER;
FILE_DESCRIPTION(('Pf031 test case','Slow STEP read due to single-byte tokenisation'),'2;1');
FILE_NAME('Pf031.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* ~30 small CARTESIAN_POINTs - the scaled representative of the
 * "millions of small entities" pattern. */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(1.0,0.0,0.0));
