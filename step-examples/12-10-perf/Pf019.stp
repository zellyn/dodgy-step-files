/* Pf019 - Memory leaks in STEPControl_Controller::Init() enum tables
   Pattern: not file-driven. LeakSanitizer flags allocations from
   Interface_Static::Init -> AddEnum triggered by the controller
   constructor; same pattern for IGES.  Static singletons retained on
   shutdown (OCCT #1024).
   The trigger is `STEPControl_Controller::Init();` followed by exit -
   any STEP file (or none) reproduces. We provide a representative
   small-but-complete file so the leak path is exercised through actual
   reader usage, ensuring the controller is initialised. The leak is in
   the kernel, not in the file. We exercise multiple enum-bound static
   tables (units, length, plane-angle, solid-angle, time, mass, error
   tolerance, surface-tolerance) so every Init/AddEnum site fires. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pf019 - controller enum-table leak; minimal trigger file'),'2;1');
FILE_NAME('Pf019.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('TINY','tiny','',(#3));
#5=PRODUCT_DEFINITION_FORMATION('','',#4);
#6=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
/* unit definitions - each kind lives in a separate static enum table */
#8=( NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) LENGTH_UNIT() );
#9=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#10=( NAMED_UNIT(*) SOLID_ANGLE_UNIT() SI_UNIT($,.STERADIAN.) );
#11=( NAMED_UNIT(*) MASS_UNIT() SI_UNIT(.KILO.,.GRAM.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.SECOND.) TIME_UNIT() );
/* uncertainty measures - each type triggers separate AddEnum lookup */
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#8,'distance',
   'distance accuracy');
#14=UNCERTAINTY_MEASURE_WITH_UNIT(PLANE_ANGLE_MEASURE(1.0E-6),#9,'angle',
   'angle accuracy');
/* representation context aggregates the unit set */
#15=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT
  ((#13,#14)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#8,#9,#10,#11,#12))
  REPRESENTATION_CONTEXT('','3D') );
/* basic placement geometry */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
/* shape representation web */
#30=SHAPE_REPRESENTATION('',(#23),#15);
#31=PRODUCT_DEFINITION_SHAPE('','',#7);
#32=SHAPE_DEFINITION_REPRESENTATION(#31,#30);
/* extra entities that exercise more enum-bound static lookups */
#40=PROPERTY_DEFINITION('density','material density',#7);
#41=PROPERTY_DEFINITION('mass','part mass',#7);
#42=PROPERTY_DEFINITION('cog','centre of gravity',#7);
#43=PROPERTY_DEFINITION('inertia','principal inertia',#7);
#50=DESCRIPTIVE_REPRESENTATION_ITEM('material','steel');
#51=DESCRIPTIVE_REPRESENTATION_ITEM('finish','machined');
#52=DESCRIPTIVE_REPRESENTATION_ITEM('treatment','none');
#53=DESCRIPTIVE_REPRESENTATION_ITEM('class','primary');
#60=REPRESENTATION('properties',(#50,#51,#52,#53),#15);
#61=PROPERTY_DEFINITION_REPRESENTATION(#40,#60);
#62=PROPERTY_DEFINITION_REPRESENTATION(#41,#60);
#63=PROPERTY_DEFINITION_REPRESENTATION(#42,#60);
#64=PROPERTY_DEFINITION_REPRESENTATION(#43,#60);
ENDSEC;
END-ISO-10303-21;
