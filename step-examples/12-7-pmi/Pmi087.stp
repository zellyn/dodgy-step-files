#260=CARTESIAN_POINT('',(10.0,5.0,5.0));
#261=AXIS2_PLACEMENT_3D('',#260,#206,#204); #262=PLANE('',#261);
#300=DIRECTION('',(1.0,0.0,0.0)); #301=VECTOR('',#300,10.0);
#302=DIRECTION('',(0.0,1.0,0.0)); #303=VECTOR('',#302,10.0);
#304=DIRECTION('',(0.0,0.0,1.0)); #305=VECTOR('',#304,10.0);
#310=LINE('',#100,#301); #311=EDGE_CURVE('',#110,#111,#310,.T.);
#312=LINE('',#101,#303); #313=EDGE_CURVE('',#111,#112,#312,.T.);
