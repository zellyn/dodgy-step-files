#444=EDGE_LOOP('',(#440,#441,#442,#443));
#445=FACE_OUTER_BOUND('',#444,.T.);
#446=ADVANCED_FACE('left',(#445),#252,.T.);
#450=ORIENTED_EDGE('',*,*,#313,.T.); #451=ORIENTED_EDGE('',*,*,#331,.T.);
#452=ORIENTED_EDGE('',*,*,#321,.F.); #453=ORIENTED_EDGE('',*,*,#329,.F.);
#454=EDGE_LOOP('',(#450,#451,#452,#453));
#455=FACE_OUTER_BOUND('',#454,.T.);
#456=ADVANCED_FACE('right',(#455),#262,.T.);
#500=CLOSED_SHELL('cube_skin',(#406,#416,#426,#436,#446,#456));
#501=MANIFOLD_SOLID_BREP('cube_body',#500);
#502=AXIS2_PLACEMENT_3D('',#100,#200,#201);
#503=ADVANCED_BREP_SHAPE_REPRESENTATION('shape',(#501,#502),#14);
#504=SHAPE_DEFINITION_REPRESENTATION(#7,#503);
/* Defect: claimed volume 500 mm^3, actual cube volume 1000 mm^3. */
#600=PROPERTY_DEFINITION('geometric_validation','volume_validation',#7);
#601=MEASURE_REPRESENTATION_ITEM('volume',VOLUME_MEASURE(500.0),#10);
#602=REPRESENTATION('claimed_volume',(#601),#14);
#603=PROPERTY_DEFINITION_REPRESENTATION(#600,#602);
/* Anchor a SHAPE_ASPECT to the solid so the fixture is recognised
   as carrying PMI metadata. */
#610=SHAPE_ASPECT('whole_body','validation property scope',#7,.T.);
#611=GEOMETRIC_ITEM_SPECIFIC_USAGE('GISU',$,#610,#503,#501);
#612=DIMENSIONAL_SIZE(#610,'reference_volume');
ENDSEC;
END-ISO-10303-21;
