ISO-10303-21;
/* Pmi087 - GEOMETRIC_VALIDATION_PROPERTY claimed volume disagrees with geometry
 * Defect: a 10x10x10 mm cube has actual volume 1000 mm^3. The fixture
 * emits a validation property claiming VOLUME_MEASURE(500.0) -- half the
 * computed value. The validation property exists exactly to detect this
 * round-trip drift; receivers must surface the disagreement. */
HEADER;
FILE_DESCRIPTION(('Pmi087 - validation property volume mismatch'),'2;1');
FILE_NAME('Pmi087.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=PRODUCT_CONTEXT('part',#1,'mechanical');
#3=PRODUCT('Pmi087','cube_with_wrong_volume','',(#2));
#4=PRODUCT_DEFINITION_FORMATION('','',#3);
#5=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#6=PRODUCT_DEFINITION('','',#4,#5);
#7=PRODUCT_DEFINITION_SHAPE('','',#6);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,'tol','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D'));
/* Real 10x10x10 mm cube: 8 vertices, 12 edges, 6 planar faces. */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(10.0,0.0,0.0));
#102=CARTESIAN_POINT('',(10.0,10.0,0.0));
#103=CARTESIAN_POINT('',(0.0,10.0,0.0));
#104=CARTESIAN_POINT('',(0.0,0.0,10.0));
#105=CARTESIAN_POINT('',(10.0,0.0,10.0));
#106=CARTESIAN_POINT('',(10.0,10.0,10.0));
#107=CARTESIAN_POINT('',(0.0,10.0,10.0));
#110=VERTEX_POINT('',#100); #111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102); #113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104); #115=VERTEX_POINT('',#105);
#116=VERTEX_POINT('',#106); #117=VERTEX_POINT('',#107);
#200=DIRECTION('',(0.0,0.0,1.0)); #201=DIRECTION('',(1.0,0.0,0.0));
#202=DIRECTION('',(0.0,0.0,-1.0));
#203=DIRECTION('',(0.0,-1.0,0.0)); #204=DIRECTION('',(0.0,1.0,0.0));
#205=DIRECTION('',(-1.0,0.0,0.0)); #206=DIRECTION('',(1.0,0.0,0.0));
#210=CARTESIAN_POINT('',(5.0,5.0,0.0));
#211=AXIS2_PLACEMENT_3D('',#210,#202,#201); #212=PLANE('',#211);
#220=CARTESIAN_POINT('',(5.0,5.0,10.0));
#221=AXIS2_PLACEMENT_3D('',#220,#200,#201); #222=PLANE('',#221);
#230=CARTESIAN_POINT('',(5.0,0.0,5.0));
#231=AXIS2_PLACEMENT_3D('',#230,#203,#201); #232=PLANE('',#231);
#240=CARTESIAN_POINT('',(5.0,10.0,5.0));
