ISO-10303-21;
/* Pmi001 - Hole emitted as two half-cylinders breaks PMI feature association.
 * Defect: a 50x50x20 mm plate with a 10 mm-diameter through-hole. The hole
 * wall is emitted as TWO ADVANCED_FACEs that share ONE CYLINDRICAL_SURFACE
 * - the first face spans theta=0..pi, the second spans theta=pi..2*pi. The
 * seam edges are shared between them. PMI feature association needs to
 * traverse both halves: a SHAPE_ASPECT 'hole_feature' references both
 * halves through two GEOMETRIC_ITEM_SPECIFIC_USAGE entries (instead of a
 * single feature face). Receivers that expect one face per cylindrical
 * feature drop or duplicate the PMI link. */
HEADER;
FILE_DESCRIPTION(('Pmi001 - half-cylinders break PMI association'),'2;1');
FILE_NAME('Pmi001.stp','2026-05-02T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi001','BlockWithHole','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
/* Plate corners: 50x50x20 with a 10mm-dia hole centered at (25,25). */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(50.0,0.0,0.0));
#102=CARTESIAN_POINT('',(50.0,50.0,0.0));
#103=CARTESIAN_POINT('',(0.0,50.0,0.0));
#104=CARTESIAN_POINT('',(0.0,0.0,20.0));
#105=CARTESIAN_POINT('',(50.0,0.0,20.0));
#106=CARTESIAN_POINT('',(50.0,50.0,20.0));
#107=CARTESIAN_POINT('',(0.0,50.0,20.0));
#110=VERTEX_POINT('',#100); #111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102); #113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104); #115=VERTEX_POINT('',#105);
#116=VERTEX_POINT('',#106); #117=VERTEX_POINT('',#107);
/* Hole: cylindrical_surface, axis along +Z at (25,25,0), radius 5. */
#120=CARTESIAN_POINT('hole_center',(25.0,25.0,0.0));
#121=DIRECTION('hole_axis',(0.0,0.0,1.0));
#122=DIRECTION('hole_ref',(1.0,0.0,0.0));
#123=AXIS2_PLACEMENT_3D('hole_origin',#120,#121,#122);
#124=CYLINDRICAL_SURFACE('hole_surface',#123,5.0);
/* Hole seam vertices on bottom (z=0) and top (z=20). */
#130=CARTESIAN_POINT('',(30.0,25.0,0.0));   /* theta=0  bot */
#131=CARTESIAN_POINT('',(20.0,25.0,0.0));   /* theta=pi bot */
#132=CARTESIAN_POINT('',(30.0,25.0,20.0));  /* theta=0  top */
#133=CARTESIAN_POINT('',(20.0,25.0,20.0));  /* theta=pi top */
#140=VERTEX_POINT('',#130); #141=VERTEX_POINT('',#131);
#142=VERTEX_POINT('',#132); #143=VERTEX_POINT('',#133);
/* Top circle (z=20) and bottom circle (z=0) supporting curves. */
#150=CARTESIAN_POINT('hole_top_center',(25.0,25.0,20.0));
#151=AXIS2_PLACEMENT_3D('top_circle_axis',#150,#121,#122);
#152=CIRCLE('hole_top_circle',#151,5.0);
#153=AXIS2_PLACEMENT_3D('bot_circle_axis',#120,#121,#122);
#154=CIRCLE('hole_bot_circle',#153,5.0);
/* Half-circle edges. Bottom: A from theta=0..pi; B from theta=pi..2pi. */
#160=EDGE_CURVE('',#140,#141,#154,.T.);  /* bot half A */
#161=EDGE_CURVE('',#141,#140,#154,.T.);  /* bot half B */
#162=EDGE_CURVE('',#142,#143,#152,.T.);  /* top half A */
#163=EDGE_CURVE('',#143,#142,#152,.T.);  /* top half B */
/* Vertical seam edges shared by the two half-cylinders. */
#170=DIRECTION('',(0.0,0.0,1.0)); #171=VECTOR('',#170,20.0);
#172=LINE('',#130,#171); #173=EDGE_CURVE('seam0',#140,#142,#172,.T.);
#174=LINE('',#131,#171); #175=EDGE_CURVE('seam_pi',#141,#143,#174,.T.);
/* Outer plate edge curves (perimeter & verticals). */
#200=DIRECTION('',(1.0,0.0,0.0)); #201=VECTOR('',#200,50.0);
#202=DIRECTION('',(0.0,1.0,0.0)); #203=VECTOR('',#202,50.0);
#204=VECTOR('',#170,20.0);
#210=LINE('',#100,#201); #211=EDGE_CURVE('',#110,#111,#210,.T.);
#212=LINE('',#101,#203); #213=EDGE_CURVE('',#111,#112,#212,.T.);
#214=LINE('',#103,#201); #215=EDGE_CURVE('',#113,#112,#214,.T.);
#216=LINE('',#100,#203); #217=EDGE_CURVE('',#110,#113,#216,.T.);
#218=LINE('',#104,#201); #219=EDGE_CURVE('',#114,#115,#218,.T.);
#220=LINE('',#105,#203); #221=EDGE_CURVE('',#115,#116,#220,.T.);
#222=LINE('',#107,#201); #223=EDGE_CURVE('',#117,#116,#222,.T.);
#224=LINE('',#104,#203); #225=EDGE_CURVE('',#114,#117,#224,.T.);
#226=LINE('',#100,#204); #227=EDGE_CURVE('',#110,#114,#226,.T.);
#228=LINE('',#101,#204); #229=EDGE_CURVE('',#111,#115,#228,.T.);
#230=LINE('',#102,#204); #231=EDGE_CURVE('',#112,#116,#230,.T.);
#232=LINE('',#103,#204); #233=EDGE_CURVE('',#113,#117,#232,.T.);
/* Plate face planes. */
#250=CARTESIAN_POINT('',(25.0,25.0,0.0));
#251=DIRECTION('',(0.0,0.0,-1.0));
#252=AXIS2_PLACEMENT_3D('',#250,#251,#200); #253=PLANE('',#252);
#254=CARTESIAN_POINT('',(25.0,25.0,20.0));
#255=AXIS2_PLACEMENT_3D('',#254,#170,#200); #256=PLANE('',#255);
#260=CARTESIAN_POINT('',(25.0,0.0,10.0));
#261=DIRECTION('',(0.0,-1.0,0.0));
#262=AXIS2_PLACEMENT_3D('',#260,#261,#200); #263=PLANE('',#262);
#264=CARTESIAN_POINT('',(25.0,50.0,10.0));
#265=AXIS2_PLACEMENT_3D('',#264,#202,#200); #266=PLANE('',#265);
#270=CARTESIAN_POINT('',(0.0,25.0,10.0));
#271=DIRECTION('',(-1.0,0.0,0.0));
#272=AXIS2_PLACEMENT_3D('',#270,#271,#202); #273=PLANE('',#272);
#274=CARTESIAN_POINT('',(50.0,25.0,10.0));
#275=AXIS2_PLACEMENT_3D('',#274,#200,#202); #276=PLANE('',#275);
/* Bottom face (z=0): outer wire + inner hole wire (both halves). */
#300=ORIENTED_EDGE('',*,*,#211,.T.); #301=ORIENTED_EDGE('',*,*,#213,.T.);
#302=ORIENTED_EDGE('',*,*,#215,.F.); #303=ORIENTED_EDGE('',*,*,#217,.F.);
#304=EDGE_LOOP('bot_outer',(#300,#301,#302,#303));
#305=FACE_OUTER_BOUND('',#304,.T.);
/* Bottom hole loop: bot half A then bot half B (CW so it's a hole when
   bottom face normal is -Z). */
#306=ORIENTED_EDGE('',*,*,#160,.T.);
#307=ORIENTED_EDGE('',*,*,#161,.T.);
#308=EDGE_LOOP('bot_hole',(#306,#307));
#309=FACE_BOUND('',#308,.T.);
#310=ADVANCED_FACE('plate_bot',(#305,#309),#253,.T.);
/* Top face (z=20): outer wire + inner hole wire. */
#320=ORIENTED_EDGE('',*,*,#219,.T.); #321=ORIENTED_EDGE('',*,*,#221,.T.);
#322=ORIENTED_EDGE('',*,*,#223,.F.); #323=ORIENTED_EDGE('',*,*,#225,.F.);
#324=EDGE_LOOP('top_outer',(#320,#321,#322,#323));
#325=FACE_OUTER_BOUND('',#324,.T.);
/* Top hole loop: traverse the hole edges in opposite order so it's CW
   when viewed from +Z (the top face's normal). */
#326=ORIENTED_EDGE('',*,*,#163,.F.);
#327=ORIENTED_EDGE('',*,*,#162,.F.);
#328=EDGE_LOOP('top_hole',(#326,#327));
#329=FACE_BOUND('',#328,.T.);
#330=ADVANCED_FACE('plate_top',(#325,#329),#256,.T.);
/* Plate side faces. */
#340=ORIENTED_EDGE('',*,*,#211,.T.); #341=ORIENTED_EDGE('',*,*,#229,.T.);
#342=ORIENTED_EDGE('',*,*,#219,.F.); #343=ORIENTED_EDGE('',*,*,#227,.F.);
#344=EDGE_LOOP('',(#340,#341,#342,#343));
#345=FACE_OUTER_BOUND('',#344,.T.);
#346=ADVANCED_FACE('plate_front',(#345),#263,.T.);
#350=ORIENTED_EDGE('',*,*,#215,.T.); #351=ORIENTED_EDGE('',*,*,#231,.T.);
#352=ORIENTED_EDGE('',*,*,#223,.F.); #353=ORIENTED_EDGE('',*,*,#233,.F.);
#354=EDGE_LOOP('',(#350,#351,#352,#353));
#355=FACE_OUTER_BOUND('',#354,.T.);
#356=ADVANCED_FACE('plate_back',(#355),#266,.T.);
#360=ORIENTED_EDGE('',*,*,#217,.T.); #361=ORIENTED_EDGE('',*,*,#233,.T.);
#362=ORIENTED_EDGE('',*,*,#225,.F.); #363=ORIENTED_EDGE('',*,*,#227,.F.);
#364=EDGE_LOOP('',(#360,#361,#362,#363));
#365=FACE_OUTER_BOUND('',#364,.T.);
#366=ADVANCED_FACE('plate_left',(#365),#273,.T.);
#370=ORIENTED_EDGE('',*,*,#213,.T.); #371=ORIENTED_EDGE('',*,*,#231,.T.);
#372=ORIENTED_EDGE('',*,*,#221,.F.); #373=ORIENTED_EDGE('',*,*,#229,.F.);
#374=EDGE_LOOP('',(#370,#371,#372,#373));
#375=FACE_OUTER_BOUND('',#374,.T.);
#376=ADVANCED_FACE('plate_right',(#375),#276,.T.);
/* Half-cylinder hole walls A and B. Both share #124 cylindrical_surface. */
#380=ORIENTED_EDGE('',*,*,#160,.F.);   /* bot half A reversed */
#381=ORIENTED_EDGE('',*,*,#173,.T.);   /* seam0 up */
#382=ORIENTED_EDGE('',*,*,#162,.T.);   /* top half A */
#383=ORIENTED_EDGE('',*,*,#175,.F.);   /* seam_pi down */
#384=EDGE_LOOP('hole_wall_A',(#380,#381,#382,#383));
#385=FACE_OUTER_BOUND('',#384,.T.);
#386=ADVANCED_FACE('hole_half_A',(#385),#124,.T.);
#390=ORIENTED_EDGE('',*,*,#161,.F.);   /* bot half B reversed */
#391=ORIENTED_EDGE('',*,*,#175,.T.);   /* seam_pi up */
#392=ORIENTED_EDGE('',*,*,#163,.T.);   /* top half B */
#393=ORIENTED_EDGE('',*,*,#173,.F.);   /* seam0 down */
#394=EDGE_LOOP('hole_wall_B',(#390,#391,#392,#393));
#395=FACE_OUTER_BOUND('',#394,.T.);
#396=ADVANCED_FACE('hole_half_B',(#395),#124,.T.);
/* Closed shell + solid for the plate-with-hole. */
#400=CLOSED_SHELL('plate_shell',(#310,#330,#346,#356,#366,#376,#386,#396));
#401=MANIFOLD_SOLID_BREP('plate_body',#400);
#402=AXIS2_PLACEMENT_3D('',#100,#121,#122);
#410=ADVANCED_BREP_SHAPE_REPRESENTATION('shape',(#401,#402),#25);
#411=SHAPE_DEFINITION_REPRESENTATION(#17,#410);
/* SHAPE_ASPECT 'hole' linked to BOTH half-faces via two GISUs. */
#500=SHAPE_ASPECT('hole_feature','through hole (two-half feature)',#17,.T.);
#501=GEOMETRIC_ITEM_SPECIFIC_USAGE('GISU_A',$,#500,#410,#386);
#502=GEOMETRIC_ITEM_SPECIFIC_USAGE('GISU_B',$,#500,#410,#396);
/* Diameter PMI on the shape_aspect. */
#510=DIMENSIONAL_SIZE(#500,'diameter');
#511=MEASURE_REPRESENTATION_ITEM('nominal',LENGTH_MEASURE(10.0),#20);
#512=SHAPE_DIMENSION_REPRESENTATION('',(#511),#25);
ENDSEC;
END-ISO-10303-21;
