ISO-10303-21;
/* Pmi046 - characterized_object with non-PMI draughting subtypes for graphic PMI
   Defect: Producer used a complex (CHARACTERIZED_OBJECT)(DRAUGHTING_CALLOUT)
   construct or DRAUGHTING_ANNOTATION_OCCURRENCE forms instead of the
   AP242 RP-prescribed ANNOTATION_CURVE_OCCURRENCE. NIST SFA S029 flags
   this. Readers should accept and warn for non-conformance, never
   reject. */
HEADER;
FILE_DESCRIPTION(('Pmi046 - non-RP draughting subtype for graphic PMI',
  'CAx-IF Rec.Pracs.---PMI Rep & Pres---v4.1'),'2;1');
FILE_NAME('Pmi046.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi046','BadDraughtingSubtypePart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#31 = DIRECTION('',(0.0,0.0,1.0));
#32 = DIRECTION('',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('',#30,#31,#32);
#40 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#41 = CARTESIAN_POINT('',(10.0,0.0,0.0));
#42 = POLYLINE('p',(#40,#41));
#43 = CURVE_STYLE('',#44,POSITIVE_LENGTH_MEASURE(0.18),#45);
#44 = DRAUGHTING_PRE_DEFINED_CURVE_FONT('continuous');
#45 = COLOUR_RGB('',0.0,0.0,0.0);
#46 = PRESENTATION_STYLE_ASSIGNMENT((#43));
/* Defect: complex (CHARACTERIZED_OBJECT)(DRAUGHTING_CALLOUT) used as
   the wrapper for graphic PMI instead of an ANNOTATION_CURVE_OCCURRENCE. */
#50 = ( CHARACTERIZED_OBJECT('bad_callout','non-conforming') DRAUGHTING_CALLOUT((#42)) );
/* Also a DRAUGHTING_ANNOTATION_OCCURRENCE (legacy) instead of
   ANNOTATION_CURVE_OCCURRENCE (RP). */
#51 = DRAUGHTING_ANNOTATION_OCCURRENCE('legacy_form',(#46),#42);
#60 = DRAUGHTING_MODEL('Default',(#51),#25);
#61 = PLANE('ann_plane',#33);
#62 = ANNOTATION_PLANE('PMI',(#51),#61,());
#90 = SHAPE_REPRESENTATION('',(#33),#25);
#91 = SHAPE_DEFINITION_REPRESENTATION(#17,#90);
ENDSEC;
END-ISO-10303-21;
