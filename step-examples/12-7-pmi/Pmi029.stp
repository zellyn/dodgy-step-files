ISO-10303-21;
/* Pmi029 - Datum system carries mixed Datum_System / Datum_Reference SELECT array
   Defect: AP242 DATUM_SYSTEM_AP242.constituents is a SELECT array that may
   contain both DATUM_SYSTEM and DATUM_REFERENCE items. Decoders that assume
   a homogeneous array (all-DRC or all-DR) crash on multi-body files.
   This file emits a DATUM_SYSTEM_AP242 whose constituents list mixes
   DATUM_REFERENCE_COMPARTMENT (modern) and DATUM_REFERENCE (legacy). */
HEADER;
FILE_DESCRIPTION(('Pmi029 - mixed Datum_System / Datum_Reference SELECT'),'2;1');
FILE_NAME('Pmi029.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi029','MixedDRFPart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#31 = DIRECTION('',(0.0,0.0,1.0));
#32 = DIRECTION('',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('',#30,#31,#32);
#40 = DATUM('A','',#17,.T.,'A');
#41 = DATUM('B','',#17,.T.,'B');
/* Modern compartment */
#50 = DATUM_REFERENCE_COMPARTMENT('mod_compartment',$,#51);
#51 = DATUM_REFERENCE_ELEMENT('',$,#40);
/* Legacy datum_reference */
#60 = DATUM_REFERENCE(2,#41);
/* Defect: mixed SELECT array — DATUM_REFERENCE_COMPARTMENT and
   DATUM_REFERENCE in the same constituents list of DATUM_SYSTEM_AP242.
   Naive readers that assume one type crash on the other. */
#70 = DATUM_SYSTEM_AP242('mixed_DRF','',#17,.T.,(#50,#60));
#80 = SHAPE_ASPECT('feature','',#17,.T.);
#81 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#20);
#82 = POSITION_TOLERANCE('pos',$,#81,#80,#70);
#90 = DRAUGHTING_MODEL('Default',(),#25);
#100 = SHAPE_REPRESENTATION('',(#33),#25);
#101 = SHAPE_DEFINITION_REPRESENTATION(#17,#100);
ENDSEC;
END-ISO-10303-21;
