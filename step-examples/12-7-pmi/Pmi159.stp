ISO-10303-21;
/* Pmi159: GEOMETRIC_TOLERANCE_WITH_MODIFIERS carrying material-condition modifiers: position at MAXIMUM_MATERIAL_REQUIREMENT + TANGENT_PLANE on one hole, and LEAST_MATERIAL_REQUIREMENT + FREE_STATE on a boss; dropping the modifier silently coerces to RFS and loses bonus tolerance; GEOMETRIC_CURVE_SET IS model entity — OCC loads the point as one vertex */
HEADER;
FILE_DESCRIPTION(('Pmi159'),'2;1');
FILE_NAME('Pmi159.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Pmi159','Pmi159','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#2),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
#9063=SHAPE_ASPECT('hole_axis','toleranced hole',#9055,.T.);
#9064=SHAPE_ASPECT('boss_axis','toleranced boss',#9055,.T.);
#9065=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#9056);
#9066=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.08),#9056);
#9067=GEOMETRIC_TOLERANCE_WITH_MODIFIERS('pos_mmc','position 0.05 at MMC',#9065,#9063,(.MAXIMUM_MATERIAL_REQUIREMENT.,.TANGENT_PLANE.));
#9068=GEOMETRIC_TOLERANCE_WITH_MODIFIERS('pos_lmc','position 0.08 at LMC free-state',#9066,#9064,(.LEAST_MATERIAL_REQUIREMENT.,.FREE_STATE.));
ENDSEC;
END-ISO-10303-21;
