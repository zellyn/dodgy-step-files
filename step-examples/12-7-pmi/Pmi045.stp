ISO-10303-21;
/* Pmi045 - Graphic-only PMI with no semantic backing
   Defect: PMI is exported only as a DRAUGHTING_CALLOUT containing
   ANNOTATION_CURVE_OCCURRENCEs (graphic presentation) with no parallel
   semantic representation - no DIMENSIONAL_SIZE, no GEOMETRIC_TOLERANCE.
   Looks correct visually but cannot be machine-consumed for
   inspection / CMM / machining downstream. AP203/AP214 producers and
   pre-Creo-9 exports show this pattern. SolidWorks AP242 import drops
   PMI silently (Pmi045/M009/S029/V013). */
HEADER;
FILE_DESCRIPTION(('Pmi045 - graphic-only PMI no semantic counterpart',
  'CAx-IF Rec.Pracs.---PMI Rep & Pres---v4.1'),'2;1');
FILE_NAME('Pmi045.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi045','GraphicOnlyPMIPart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#31 = DIRECTION('',(0.0,0.0,1.0));
#32 = DIRECTION('',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('',#30,#31,#32);
/* Polyline points for a leader and dimension text presentation only */
#40 = CARTESIAN_POINT('',(10.0,10.0,0.0));
#41 = CARTESIAN_POINT('',(20.0,10.0,0.0));
#42 = CARTESIAN_POINT('',(20.0,15.0,0.0));
#43 = CARTESIAN_POINT('',(30.0,15.0,0.0));
#44 = POLYLINE('leader',(#40,#41,#42,#43));
#50 = CURVE_STYLE('',#51,POSITIVE_LENGTH_MEASURE(0.18),#52);
#51 = DRAUGHTING_PRE_DEFINED_CURVE_FONT('continuous');
#52 = COLOUR_RGB('',0.0,0.0,0.0);
#53 = PRESENTATION_STYLE_ASSIGNMENT((#50));
#54 = STYLED_ITEM('',(#53),#44);
#60 = ANNOTATION_CURVE_OCCURRENCE('dimension_graphic',(#53),#44);
#70 = DRAUGHTING_CALLOUT('graphic_only_callout',(#60));
/* Defect: NO DIMENSIONAL_SIZE, NO GEOMETRIC_TOLERANCE referencing this
   callout. Inspection pipelines will not see the dimension. */
#80 = DRAUGHTING_MODEL('Default',(#60),#25);
#81 = PLANE('ann_plane',#33);
#82 = ANNOTATION_PLANE('PMI',(#60),#81,());
#90 = SHAPE_REPRESENTATION('',(#33),#25);
#91 = SHAPE_DEFINITION_REPRESENTATION(#17,#90);
ENDSEC;
END-ISO-10303-21;
