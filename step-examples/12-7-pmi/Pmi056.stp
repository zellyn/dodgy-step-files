ISO-10303-21;
/* Pmi056: DRAUGHTING_CALLOUT references both a TESSELLATED_ANNOTATION_OCCURRENCE and an ANNOTATION_CURVE_OCCURRENCE for the same callout; AP242 ed.2 forbids mixing tessellated and curve annotation styles for the same PMI item; this duplication breaks annotation counting and association; receivers must normalize one form as canonical and warn; silently accepting the duplicate is forbidden; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Pmi056'),'2;1');
FILE_NAME('Pmi056.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Pmi056','Pmi056','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#2),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
#9063=COLOUR_RGB('anno_colour',0.0,0.0,0.0);
#9064=CURVE_STYLE('',FONT_SELECT($),LENGTH_MEASURE(0.25),#9063);
#9065=PRESENTATION_STYLE_ASSIGNMENT((#9064));
#9066=CARTESIAN_POINT('',(0.0,0.0,0.0));
#9067=CARTESIAN_POINT('',(10.0,0.0,0.0));
#9068=POLYLINE('',(#9066,#9067));
#9069=ANNOTATION_CURVE_OCCURRENCE('fcf_curve',(#9068),#9065);
#9070=COORDINATES_LIST('tess_coords',3,((0.0,5.0,0.0),(5.0,5.0,0.0),(2.5,8.0,0.0)));
#9071=COMPLEX_TRIANGULATED_SURFACE_SET('fcf_tess',#9070,((0,1,2)),.F.,$);
#9072=TESSELLATED_ANNOTATION_OCCURRENCE('fcf_tess_occ',(#9065),#9071);
#9073=DRAUGHTING_CALLOUT('fcf_callout',(#9069,#9072));
ENDSEC;
