/* Pmi044 - DimensionalSize/GeometricTolerance attached only via PropertyDefinition (legacy AP203+G&DT)
   Defect: Older AP242 / AP203+G&DT files attach the toleranced item
   indirectly through a PROPERTY_DEFINITION + SHAPE_ASPECT chain rather
   than the modern direct GEOMETRIC_TOLERANCE.toleranced_shape_aspect
   association. OCCT STEPCAFControl_Reader.cxx:3577-3601 handles this
   path; modern translators may miss it. This file places a position
   tolerance whose link to the face is reachable only via
   PROPERTY_DEFINITION_REPRESENTATION and SHAPE_ASPECT_RELATIONSHIP. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pmi044 - PMI via property_definition chain only',
  'CAx-IF Rec.Pracs.---PMI Rep & Pres---v4.1'),'2;1');
FILE_NAME('Pmi044.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi044','LegacyPropertyChainPart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#31 = DIRECTION('',(0.0,0.0,1.0));
#32 = DIRECTION('',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('',#30,#31,#32);
#34 = PLANE('toleranced_face',#33);
#35 = ADVANCED_FACE('top_face',(),#34,.T.);
/* Modern path would attach the tolerance directly via toleranced_shape_aspect.
   Defect: only the indirect property_definition path is provided. */
#40 = SHAPE_ASPECT('face_sa','top face aspect',#17,.T.);
#41 = PROPERTY_DEFINITION('legacy_pmi_link','indirect chain',#40);
#42 = REPRESENTATION('legacy_rep',(#35),#25);
#43 = PROPERTY_DEFINITION_REPRESENTATION(#41,#42);
/* Tolerance whose toleranced_shape_aspect points at the SHAPE_ASPECT,
   not at the ADVANCED_FACE; reader must follow PROPERTY_DEFINITION
   chain to recover the actual face. */
#50 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#20);
#51 = DATUM('A','primary',#17,.T.,'A');
#52 = DATUM_REFERENCE_ELEMENT('',$,#51);
#53 = DATUM_REFERENCE_COMPARTMENT('',$,#52);
#54 = DATUM_SYSTEM('A','',#17,.T.,(#53));
#55 = POSITION_TOLERANCE('pos_legacy',$,#50,#40,#54);
#60 = DIMENSIONAL_SIZE(#40,'distance');
#61 = MEASURE_REPRESENTATION_ITEM('nom',LENGTH_MEASURE(15.0),#20);
#62 = SHAPE_DIMENSION_REPRESENTATION('',(#61),#25);
#70 = PLUS_MINUS_TOLERANCE(#71,#60);
#71 = TOLERANCE_VALUE(#72,#73);
#72 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(-0.10),#20);
#73 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.10),#20);
#80 = DRAUGHTING_MODEL('Default',(#35),#25);
#81 = PLANE('ann_plane',#33);
#82 = ANNOTATION_PLANE('PMI',(),#81,(#55));
#90 = SHAPE_REPRESENTATION('',(#33,#35),#25);
#91 = SHAPE_DEFINITION_REPRESENTATION(#17,#90);
ENDSEC;
END-ISO-10303-21;
