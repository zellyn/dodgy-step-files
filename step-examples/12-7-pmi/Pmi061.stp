ISO-10303-21;
/* Pmi061 - DATUM->ADVANCED_FACE chain not resolved for some link patterns
   Defect: Four chain patterns are unresolved by
   XCAFDoc_DimTolTool::GetRefShapeLabel (OCCT issue #1138). This file
   exercises pattern (1):
     DATUM -> SAR -> DATUM_FEATURE -> ITEM_IDENTIFIED_REPRESENTATION_USAGE
            -> SHAPE_REPRESENTATION_ITEM -> ADVANCED_FACE
   so the DATUM is reached only via an IIRU + SRI hop. Translators that
   resolve the simpler GISU path miss this one. NIST CTC/STC test
   exercise this combination. */
HEADER;
FILE_DESCRIPTION(('Pmi061 - DATUM-SAR-DF-IIRU-SRI-AF chain unresolved',
  'CAx-IF Rec.Pracs.---PMI Rep & Pres---v4.1'),'2;1');
FILE_NAME('Pmi061.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi061','UnresolvedDatumChainPart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#31 = DIRECTION('',(0.0,0.0,1.0));
#32 = DIRECTION('',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('',#30,#31,#32);
#34 = PLANE('datum_face_geom',#33);
#35 = ADVANCED_FACE('datum_face',(),#34,.T.);
#40 = DATUM('A','primary datum',#17,.T.,'A');
#41 = DATUM_FEATURE('A_feature','',#17,.T.);
/* SAR: shape_aspect_relationship between datum and datum_feature */
#42 = SHAPE_ASPECT_RELATIONSHIP('df_sar','',#40,#41);
/* Pattern (1): DATUM_FEATURE -> IIRU -> SRI -> ADVANCED_FACE */
#50 = SHAPE_REPRESENTATION('',(#33,#35),#25);
#51 = SHAPE_DEFINITION_REPRESENTATION(#17,#50);
#52 = ITEM_IDENTIFIED_REPRESENTATION_USAGE('IIRU','datum-face linkage',
  #41,#50,(#35));
#60 = DATUM_REFERENCE_ELEMENT('',$,#40);
#61 = DATUM_REFERENCE_COMPARTMENT('',$,#60);
#62 = DATUM_SYSTEM('A','',#17,.T.,(#61));
#70 = SHAPE_ASPECT('feature','toleranced feature',#17,.T.);
#71 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#20);
#72 = POSITION_TOLERANCE('pos','',#71,#70,#62);
#80 = DRAUGHTING_MODEL('Default',(#35),#25);
#81 = PLANE('ann_plane',#33);
#82 = ANNOTATION_PLANE('PMI',(),#81,(#72));
ENDSEC;
END-ISO-10303-21;
