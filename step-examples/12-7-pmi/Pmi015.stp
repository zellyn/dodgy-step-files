/* Pmi015 - Annotation geometry must be in plane PARALLEL to annotation_plane
   (small offset)
   Defect: CAD systems offset annotation geometry slightly above the
   underlying ANNOTATION_PLANE for visibility. The RP says elements must
   lie in a plane PARALLEL to the annotation_plane, NOT necessarily on it.
   Strict on-plane checks reject valid files. This file places its
   annotation_plane at z=0 and its polyline points at z=0.05 (parallel
   plane offset) — receivers with strict-coincidence checks reject. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pmi015 - small parallel offset rejected by strict checker'),'2;1');
FILE_NAME('Pmi015.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi015','OffsetAnnotationPart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
/* annotation_plane at z=0 */
#30 = CARTESIAN_POINT('plane_o',(0.0,0.0,0.0));
#31 = DIRECTION('z',(0.0,0.0,1.0));
#32 = DIRECTION('x',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('plane_axis',#30,#31,#32);
#34 = PLANE('plane_at_z0',#33);
#35 = ANNOTATION_PLANE('PMI',(),#34,());
/* Polyline points at z=0.05 — in a plane parallel to the annotation plane
   but not coincident. Strict checkers fail to associate geometry. */
#40 = CARTESIAN_POINT('q1',(0.0,0.0,0.05));
#41 = CARTESIAN_POINT('q2',(10.0,0.0,0.05));
#42 = CARTESIAN_POINT('q3',(10.0,5.0,0.05));
#43 = POLYLINE('annot_curve',(#40,#41,#42));
#44 = NULL_STYLE(.NULL.);
#45 = ANNOTATION_CURVE_OCCURRENCE('annot_occ',(#44),#43);
#50 = DRAUGHTING_MODEL('Default',(#45),#25);
#60 = SHAPE_REPRESENTATION('',(#33),#25);
#61 = SHAPE_DEFINITION_REPRESENTATION(#17,#60);
ENDSEC;
END-ISO-10303-21;
