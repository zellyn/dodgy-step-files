ISO-10303-21;
/* Pmi077 - PMI text values wrong with metres but PMI in inches
 * Defect: document declares metres; PMI dimension emitted as inches without conversion */
HEADER;
FILE_DESCRIPTION(('Pmi077 test case','PMI text values wrong with metres but PMI in inches'),'2;1');
FILE_NAME('Pmi077.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=APPLICATION_CONTEXT('automotive_design');
#100=LENGTH_UNIT(METRE);
#101=DIMENSIONAL_VALUE('hole_diameter',1.0,'mm');
/* PMI anchor: minimal ANNOTATION_PLANE so this PMI fixture cites at least one canonical PMI entity. */
#9100=CARTESIAN_POINT('pmi_o',(0.0,0.0,0.0));
#9101=DIRECTION('pmi_z',(0.0,0.0,1.0));
#9102=DIRECTION('pmi_x',(1.0,0.0,0.0));
#9103=AXIS2_PLACEMENT_3D('pmi_a',#9100,#9101,#9102);
#9104=PLANE('pmi_anchor_plane',#9103);
#9105=ANNOTATION_PLANE('pmi_annotation',(),#9104,());
ENDSEC;
END-ISO-10303-21;
