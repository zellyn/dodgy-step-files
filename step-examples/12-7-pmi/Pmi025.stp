ISO-10303-21;
/* Pmi025 - Datum reference frame contains identical datums
   Defect: A DATUM_SYSTEM lists the same datum letter in primary and
   secondary slots. Either A appears twice (A,A,B) or A and B appear with
   A in two slots (A,B,A). Semantically a DRF cannot reference the same
   datum twice; receivers should warn or repair by deduplication. */
HEADER;
FILE_DESCRIPTION(('Pmi025 - datum system has identical datums'),'2;1');
FILE_NAME('Pmi025.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi025','DupDatumDRFPart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#31 = DIRECTION('',(0.0,0.0,1.0));
#32 = DIRECTION('',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('',#30,#31,#32);
#40 = DATUM('A','primary datum',#17,.T.,'A');
#41 = DATUM('B','secondary datum',#17,.T.,'B');
#42 = DATUM_REFERENCE_COMPARTMENT('primary',$,#43);
#43 = DATUM_REFERENCE_ELEMENT('',$,#40);
#44 = DATUM_REFERENCE_COMPARTMENT('secondary',$,#45);
#45 = DATUM_REFERENCE_ELEMENT('',$,#40); /* Defect: same datum #40 again */
#46 = DATUM_REFERENCE_COMPARTMENT('tertiary',$,#47);
#47 = DATUM_REFERENCE_ELEMENT('',$,#41);
/* Defect: DRF (A,A,B) — A appears in both primary and secondary slots. */
#50 = DATUM_SYSTEM('A_A_B','duplicated datum',#17,.T.,(#42,#44,#46));
/* Tolerance using the bad DRF */
#60 = SHAPE_ASPECT('feature','',#17,.T.);
#61 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#20);
#62 = POSITION_TOLERANCE('pos',$,#61,#60,#50);
#70 = DRAUGHTING_MODEL('Default',(),#25);
#80 = SHAPE_REPRESENTATION('',(#33),#25);
#81 = SHAPE_DEFINITION_REPRESENTATION(#17,#80);
ENDSEC;
END-ISO-10303-21;
