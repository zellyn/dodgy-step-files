/* Pmi122 - PROFILE_FEATURE with conflicting profile + draft angles
 * Defect: a profile_feature emits a closed profile and a NEGATIVE draft
 * angle (the sweep tapers inward). For an extrude where the profile
 * is the top of the swept solid, a negative draft means the sweep
 * grows outward as it descends; a positive draft means it shrinks.
 * A producer that emits a closed profile + a negative draft angle
 * whose magnitude exceeds the half-angle subtended by any edge from
 * the centroid creates a self-intersecting taper. Receivers either
 * reject (geometric inconsistency), clamp the draft angle (silent),
 * or accept and produce a self-intersecting solid. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pmi122 - profile_feature negative draft angle inconsistent with closed profile'),'2;1');
FILE_NAME('Pmi122.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=PRODUCT_CONTEXT('part',#1,'mechanical');
#3=PRODUCT('Pmi122','profile_draft_conflict','',(#2));
#4=PRODUCT_DEFINITION_FORMATION('','',#3);
#5=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#6=PRODUCT_DEFINITION('','',#4,#5);
#7=PRODUCT_DEFINITION_SHAPE('','',#6);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,'tol','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D'));
/* 50x50 mm planar host face. */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(50.0,0.0,0.0));
#102=CARTESIAN_POINT('',(50.0,50.0,0.0));
#103=CARTESIAN_POINT('',(0.0,50.0,0.0));
#110=VERTEX_POINT('',#100); #111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102); #113=VERTEX_POINT('',#103);
#200=DIRECTION('',(0.0,0.0,1.0));
#201=DIRECTION('',(1.0,0.0,0.0));
#202=DIRECTION('',(0.0,1.0,0.0));
#210=AXIS2_PLACEMENT_3D('host_origin',#100,#200,#201);
#211=PLANE('host_xy',#210);
#300=VECTOR('',#201,50.0);
#301=VECTOR('',#202,50.0);
#310=LINE('',#100,#300); #311=EDGE_CURVE('',#110,#111,#310,.T.);
#312=LINE('',#101,#301); #313=EDGE_CURVE('',#111,#112,#312,.T.);
#314=LINE('',#103,#300); #315=EDGE_CURVE('',#113,#112,#314,.T.);
#316=LINE('',#100,#301); #317=EDGE_CURVE('',#110,#113,#316,.T.);
#400=ORIENTED_EDGE('',*,*,#311,.T.); #401=ORIENTED_EDGE('',*,*,#313,.T.);
#402=ORIENTED_EDGE('',*,*,#315,.F.); #403=ORIENTED_EDGE('',*,*,#317,.F.);
#404=EDGE_LOOP('',(#400,#401,#402,#403));
#405=FACE_OUTER_BOUND('',#404,.T.);
#406=ADVANCED_FACE('host_face',(#405),#211,.T.);
#500=OPEN_SHELL('host_shell',(#406));
#501=SHELL_BASED_SURFACE_MODEL('host_model',(#500));
#502=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('shape',(#501,#210),#14);
#503=SHAPE_DEFINITION_REPRESENTATION(#7,#502);
/* Profile feature with sweep depth=10 mm and negative draft -45 deg
 * on a small (5x5) closed profile -- the inward taper would collapse
 * the cross-section to a point well before the depth is reached. */
#600=SHAPE_ASPECT('profile_feature','closed profile + excessive negative draft',#7,.T.);
#601=GEOMETRIC_ITEM_SPECIFIC_USAGE('GISU',$,#600,#502,#406);
#610=DIMENSIONAL_SIZE(#600,'sweep_depth');
#611=MEASURE_REPRESENTATION_ITEM('depth_mm',LENGTH_MEASURE(10.0),#10);
#612=SHAPE_DIMENSION_REPRESENTATION('',(#611),#14);
#620=DIMENSIONAL_SIZE(#600,'profile_half_extent');
#621=MEASURE_REPRESENTATION_ITEM('half_extent_mm',LENGTH_MEASURE(2.5),#10);
#622=SHAPE_DIMENSION_REPRESENTATION('',(#621),#14);
#630=DIMENSIONAL_SIZE(#600,'draft_angle');
#631=MEASURE_REPRESENTATION_ITEM('draft_angle_radians',PLANE_ANGLE_MEASURE(-0.7854),#11);
#632=SHAPE_DIMENSION_REPRESENTATION('',(#631),#14);
ENDSEC;
END-ISO-10303-21;
