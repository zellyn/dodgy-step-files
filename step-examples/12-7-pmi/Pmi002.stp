ISO-10303-21;
/* Pmi002: blank dimension emitted as DIMENSIONAL_SIZE; two DIMENSIONAL_SIZE + two SHAPE_DIMENSION_REPRESENTATION instances; one is real, one is blank (blanked-width) — inflates semantic-PMI count; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Pmi002'),'2;1');
FILE_NAME('Pmi002.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Pmi002','Pmi002','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#2),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
#9063=SHAPE_ASPECT('width','external width',#9055,.T.);
#9064=DIMENSIONAL_SIZE(#9063,'width');
#9065=MEASURE_REPRESENTATION_ITEM('nominal',LENGTH_MEASURE(50.0),#9056);
#9066=SHAPE_DIMENSION_REPRESENTATION('width_rep',(#9065),#9060);
#9067=DIMENSIONAL_SIZE(#9063,'blanked-width');
#9068=MEASURE_REPRESENTATION_ITEM('nominal',LENGTH_MEASURE(50.0),#9056);
#9069=SHAPE_DIMENSION_REPRESENTATION('blank_rep',(#9068),#9060);
ENDSEC;
END-ISO-10303-21;
