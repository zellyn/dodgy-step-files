/* Pmi049 - Tessellated geometry with no styled_item / color
   Defect: A TESSELLATED_SOLID has no STYLED_ITEM referencing it, so no
   color/style is set. Viewers default to neutral grey. NIST SFA S025. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pmi049 - tessellated solid missing styled_item',
  'CAx-IF Rec.Pracs.---PMI Rep & Pres---v4.1'),'2;1');
FILE_NAME('Pmi049.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi049','UnstyledTessellatedPart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#31 = CARTESIAN_POINT('p1',(10.0,0.0,0.0));
#32 = CARTESIAN_POINT('p2',(10.0,10.0,0.0));
#33 = CARTESIAN_POINT('p3',(0.0,10.0,0.0));
#34 = COORDINATES_LIST('coords',4,((0.0,0.0,0.0),(10.0,0.0,0.0),
  (10.0,10.0,0.0),(0.0,10.0,0.0)));
#35 = TRIANGULATED_FACE('tri',#34,$,$,((1,2,3),(1,3,4)));
#36 = TESSELLATED_SHELL('shell',(#35),$);
/* Defect: TESSELLATED_SOLID with no STYLED_ITEM, no color */
#40 = TESSELLATED_SOLID('unstyled_solid',(#35),$);
/* No COLOUR_RGB anywhere - receivers default to neutral. */
#50 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#51 = DIRECTION('',(0.0,0.0,1.0));
#52 = DIRECTION('',(1.0,0.0,0.0));
#53 = AXIS2_PLACEMENT_3D('',#50,#51,#52);
#60 = DRAUGHTING_MODEL('Default',(#40),#25);
#61 = PLANE('ann_plane',#53);
#62 = ANNOTATION_PLANE('PMI',(),#61,());
#90 = SHAPE_REPRESENTATION('',(#53,#40),#25);
#91 = SHAPE_DEFINITION_REPRESENTATION(#17,#90);
ENDSEC;
END-ISO-10303-21;
