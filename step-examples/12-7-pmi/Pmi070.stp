ISO-10303-21;
/* Pmi070 - GEOMETRIC_TOLERANCE_RELATIONSHIP cycle (A relates to B
 * which relates to C which relates back to A)
 * Defect: AP242 GEOMETRIC_TOLERANCE_RELATIONSHIP allows one
 * tolerance to be derived/refined from another (e.g. a position
 * tolerance refined under MMC by a separate form tolerance). The
 * spec does not explicitly forbid cycles; producers that compose
 * tolerance frames programmatically can emit a cycle by linking
 * three GEOMETRIC_TOLERANCE_RELATIONSHIP records A->B, B->C, C->A
 * at different abstraction levels. A receiver that walks the
 * relationship graph to evaluate a tolerance will recurse
 * infinitely or hit a stack guard. */
HEADER;
FILE_DESCRIPTION(('Pmi070 - GEOMETRIC_TOLERANCE_RELATIONSHIP cycle'),'2;1');
FILE_NAME('Pmi070.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=PRODUCT_CONTEXT('',#1,'mechanical');
#3=PRODUCT('Pmi070','TolCyclePart','',(#2));
#4=PRODUCT_DEFINITION_FORMATION('','',#3);
#5=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#6=PRODUCT_DEFINITION('','',#4,#5);
#7=PRODUCT_DEFINITION_SHAPE('','',#6);
#20=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25=( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#40=SHAPE_ASPECT('faceA','',#7,.T.);
#41=SHAPE_ASPECT('faceB','',#7,.T.);
#42=SHAPE_ASPECT('faceC','',#7,.T.);
#50=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#20);
#60=GEOMETRIC_TOLERANCE('A','tolA',#50,#40);
#61=GEOMETRIC_TOLERANCE('B','tolB',#50,#41);
#62=GEOMETRIC_TOLERANCE('C','tolC',#50,#42);
/* Defect: cycle A -> B -> C -> A */
#70=GEOMETRIC_TOLERANCE_RELATIONSHIP('refines','A refined by B',#60,#61);
#71=GEOMETRIC_TOLERANCE_RELATIONSHIP('refines','B refined by C',#61,#62);
#72=GEOMETRIC_TOLERANCE_RELATIONSHIP('refines','C refined by A',#62,#60);
#90=SHAPE_REPRESENTATION('',(),#25);
#91=SHAPE_DEFINITION_REPRESENTATION(#7,#90);
ENDSEC;
END-ISO-10303-21;
