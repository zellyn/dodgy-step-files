ISO-10303-21;
/* Pmi068 - Annotation_plane orientation flipped on import (mirror determinant)
   Defect: An annotation_plane's underlying frame should be a true
   reflection of the right-handed reference (det = -1). AXIS2_PLACEMENT_3D
   alone cannot encode a reflection -- ref_direction sign does not flip
   handedness because the implementation always recomputes the third
   axis as axis x ref so the resulting triad is right-handed regardless.
   To produce a real left-handed (mirror) frame we use
   CARTESIAN_TRANSFORMATION_OPERATOR_3D with scale = -1.0, attached via
   a REPRESENTATION_RELATIONSHIP between the annotation's representation
   and the parent draughting_model.
   On round-trip many translators silently right-handize such frames,
   flipping the normal direction; annotations then read back facing the
   wrong way. Sources: W039 SDHE-22078; A024. */
HEADER;
FILE_DESCRIPTION(('Pmi068 - mirror-determinant annotation_plane frame',
  'CAx-IF Rec.Pracs.---PMI Rep & Pres---v4.1'),'2;1');
FILE_NAME('Pmi068.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi068','MirrorAnnPlanePart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('origin',(0.0,0.0,0.0));
/* Right-handed reference frame for comparison */
#31 = DIRECTION('rh_axis',(0.0,0.0,1.0));
#32 = DIRECTION('rh_ref',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('rh_frame',#30,#31,#32);
#34 = PLANE('rh_plane',#33);
/* The annotation_plane is anchored on this proper right-handed
   AXIS2_PLACEMENT_3D... */
#40 = AXIS2_PLACEMENT_3D('anno_frame',#30,#31,#32);
#41 = PLANE('anno_plane',#40);
/* ...but a CARTESIAN_TRANSFORMATION_OPERATOR_3D with scale = -1.0
   applied through ITEM_DEFINED_TRANSFORMATION reflects the annotation
   into a mirrored coordinate system. This is a true negative-determinant
   transform (det = -1) -- the kind of frame that gets silently right-
   handized on round-trip. */
#42 = DIRECTION('mx_x',(1.0,0.0,0.0));
#43 = DIRECTION('mx_y',(0.0,1.0,0.0));
#44 = DIRECTION('mx_z',(0.0,0.0,1.0));
#45 = CARTESIAN_TRANSFORMATION_OPERATOR_3D('mirror_xform',#42,#43,#30,-1.0,#44);
/* Annotation content placed in the mirrored plane */
#50 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#51 = CARTESIAN_POINT('',(10.0,0.0,0.0));
#52 = POLYLINE('p',(#50,#51));
#53 = COLOUR_RGB('',0.0,0.0,0.0);
#54 = DRAUGHTING_PRE_DEFINED_CURVE_FONT('continuous');
#55 = CURVE_STYLE('',#54,POSITIVE_LENGTH_MEASURE(0.18),#53);
#56 = PRESENTATION_STYLE_ASSIGNMENT((#55));
#57 = ANNOTATION_CURVE_OCCURRENCE('mirror_anno',(#56),#52);
/* The annotation_plane references the proper plane #41; the mirror
   transform #45 is what the consumer is expected to apply when
   resolving the annotation's world-space frame. */
#60 = ANNOTATION_PLANE('mirror_PMI',(#57),#41,());
#70 = DRAUGHTING_MODEL('Default',(#57),#25);
#80 = ITEM_DEFINED_TRANSFORMATION('mirror_attach','reflect_to_world',#40,#45);
#90 = SHAPE_REPRESENTATION('',(#33,#40),#25);
#91 = SHAPE_DEFINITION_REPRESENTATION(#17,#90);
ENDSEC;
END-ISO-10303-21;
