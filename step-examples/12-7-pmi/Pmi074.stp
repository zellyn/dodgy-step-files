ISO-10303-21;
/* Pmi074 - ROUND_HOLE feature with through_depth attribute exceeding
 * the host part's bounding-box thickness in that direction
 * Defect: AP242 ROUND_HOLE carries a 'depth' or 'through_depth'
 * attribute. A producer that copies a hole feature from a thicker
 * design without updating the depth emits a hole deeper than the
 * material thickness - geometrically the hole exits the back face
 * but is encoded as a blind hole. Receivers that simulate hole
 * removal compute either a non-watertight result or an error. */
HEADER;
FILE_DESCRIPTION(('Pmi074 - ROUND_HOLE depth exceeds host thickness'),'2;1');
FILE_NAME('Pmi074.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=PRODUCT_CONTEXT('',#1,'mechanical');
#3=PRODUCT('Pmi074','HoleDepthPart','',(#2));
#4=PRODUCT_DEFINITION_FORMATION('','',#3);
#5=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#6=PRODUCT_DEFINITION('','',#4,#5);
#7=PRODUCT_DEFINITION_SHAPE('','',#6);
#20=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25=( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
/* The host part is 5mm thick (z=0 to z=5) */
#30=CARTESIAN_POINT('host_pt',(0.0,0.0,2.5));
#31=DIRECTION('host_axis',(0.0,0.0,1.0));
#32=DIRECTION('host_ref',(1.0,0.0,0.0));
#33=AXIS2_PLACEMENT_3D('',#30,#31,#32);
/* Defect: ROUND_HOLE depth = 50.0mm in a 5mm-thick host */
#40=SHAPE_ASPECT('round_hole','through hole',#7,.T.);
#50=DIMENSIONAL_SIZE(#40,'diameter');
#51=MEASURE_REPRESENTATION_ITEM('hole_dia',LENGTH_MEASURE(3.0),#20);
#52=SHAPE_DIMENSION_REPRESENTATION('',(#51),#25);
#53=DIMENSIONAL_SIZE(#40,'distance');
#54=MEASURE_REPRESENTATION_ITEM('hole_depth',LENGTH_MEASURE(50.0),#20);
#55=SHAPE_DIMENSION_REPRESENTATION('',(#54),#25);
#90=SHAPE_REPRESENTATION('',(#33),#25);
#91=SHAPE_DEFINITION_REPRESENTATION(#7,#90);
ENDSEC;
END-ISO-10303-21;
