ISO-10303-21;
/* Pmi156: CIRCULAR_RUNOUT_TOLERANCE + TOTAL_RUNOUT_TOLERANCE on a cylinder feature, each referencing a DATUM_SYSTEM built on datum axis A; semantic runout tolerance family absent from corpus; GEOMETRIC_CURVE_SET IS model entity — OCC loads the point as one vertex */
HEADER;
FILE_DESCRIPTION(('Pmi156'),'2;1');
