ISO-10303-21;
/* Pmi039 - Multiple plus_minus_tolerance on a single dimension
   Defect: More than one PLUS_MINUS_TOLERANCE references the same
   DIMENSIONAL_SIZE. The S037 pattern from NIST SFA reports producers
   that emit a per-feature tolerance plus a global default tolerance
   and never deduplicate. Receivers must warn and pick one
   deterministically (here we expect first wins). This file shows two
   plus_minus_tolerance entities pointing at one dimensional_size. */
HEADER;
FILE_DESCRIPTION(('Pmi039 - duplicate plus-minus on one dimension',
  'CAx-IF Rec.Pracs.---PMI Rep & Pres---v4.1'),'2;1');
FILE_NAME('Pmi039.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi039','DupePlusMinusPart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#31 = DIRECTION('',(0.0,0.0,1.0));
#32 = DIRECTION('',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('',#30,#31,#32);
#40 = SHAPE_ASPECT('hole','through hole',#17,.T.);
#50 = DIMENSIONAL_SIZE(#40,'diameter');
#51 = MEASURE_REPRESENTATION_ITEM('nominal',LENGTH_MEASURE(12.0),#20);
#52 = SHAPE_DIMENSION_REPRESENTATION('',(#51),#25);
/* Defect: two PLUS_MINUS_TOLERANCE both reference #50.
   Receiver should warn and use the first deterministically. */
#60 = PLUS_MINUS_TOLERANCE(#61,#50);
#61 = TOLERANCE_VALUE(#62,#63);
#62 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(-0.05),#20);
#63 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#20);
/* Second, conflicting plus-minus on the same dimension */
#70 = PLUS_MINUS_TOLERANCE(#71,#50);
#71 = TOLERANCE_VALUE(#72,#73);
#72 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(-0.10),#20);
#73 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.10),#20);
#80 = DRAUGHTING_MODEL('Default',(),#25);
#81 = PLANE('annotation_plane',#33);
#82 = ANNOTATION_PLANE('PMI',(),#81,());
#90 = SHAPE_REPRESENTATION('',(#33),#25);
#91 = SHAPE_DEFINITION_REPRESENTATION(#17,#90);
ENDSEC;
END-ISO-10303-21;
