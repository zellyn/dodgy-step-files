/* Pmi054 - basis_curve for leader/annotation not on allowed list
   Defect: An annotation polyline / trimmed_curve references a basis
   curve not on the allowed list (lines, circles, polylines). Here a
   B_SPLINE_CURVE_WITH_KNOTS is used as the underlying graphic
   geometry inside the annotation, which RP §8 of PMI v4.1 forbids.
   NIST SFA S066. Receivers should warn and render best-effort. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pmi054 - bspline basis curve in annotation',
  'CAx-IF Rec.Pracs.---PMI Rep & Pres---v4.1'),'2;1');
FILE_NAME('Pmi054.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi054','BadAnnotationBasisPart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#31 = DIRECTION('',(0.0,0.0,1.0));
#32 = DIRECTION('',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('',#30,#31,#32);
/* Defect: a B-spline curve used as the basis curve of an annotation
   - RP allows only lines, circles, polylines. */
#40 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#41 = CARTESIAN_POINT('',(5.0,2.0,0.0));
#42 = CARTESIAN_POINT('',(10.0,2.0,0.0));
#43 = CARTESIAN_POINT('',(15.0,0.0,0.0));
#44 = B_SPLINE_CURVE_WITH_KNOTS('curvy_leader',3,(#40,#41,#42,#43),
  .UNSPECIFIED.,.F.,.F.,(4,4),(0.0,1.0),.UNSPECIFIED.);
#50 = COLOUR_RGB('',0.0,0.0,0.0);
#51 = CURVE_STYLE('',#52,POSITIVE_LENGTH_MEASURE(0.18),#50);
#52 = DRAUGHTING_PRE_DEFINED_CURVE_FONT('continuous');
#53 = PRESENTATION_STYLE_ASSIGNMENT((#51));
#60 = ANNOTATION_CURVE_OCCURRENCE('bspline_leader',(#53),#44);
#70 = DRAUGHTING_MODEL('Default',(#60),#25);
#71 = PLANE('ann_plane',#33);
#72 = ANNOTATION_PLANE('PMI',(#60),#71,());
#90 = SHAPE_REPRESENTATION('',(#33),#25);
#91 = SHAPE_DEFINITION_REPRESENTATION(#17,#90);
ENDSEC;
END-ISO-10303-21;
