ISO-10303-21;
/* Pmi054: ANNOTATION_CURVE_OCCURRENCE references a B_SPLINE_CURVE_WITH_KNOTS as its basis curve; the AP242 RP restricts annotation leader/basis curves to the allowed set {line, circle, polyline}; using an unsupported basis curve type is non-conformant; receivers must warn and coerce to best-effort render; must not crash on the rendering path; the defect is a presentation/PMI property the shape-count oracles cannot observe, and here it also sits unreachable from the shape-rep root (product chain roots a GEOMETRIC_CURVE_SET stub), so OCC loads only a 1-vertex stub (shape(1)); byte-present but oracle-invisible to the load-time shape-count oracles */
HEADER;
FILE_DESCRIPTION(('Pmi054'),'2;1');
FILE_NAME('Pmi054.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Pmi054','Pmi054','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#2),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
#9063=CARTESIAN_POINT('',(0.0,0.0,0.0));
#9064=CARTESIAN_POINT('',(5.0,5.0,0.0));
#9065=CARTESIAN_POINT('',(10.0,0.0,0.0));
#9066=B_SPLINE_CURVE_WITH_KNOTS('leader_basis',2,(#9063,#9064,#9065),.UNSPECIFIED.,.F.,.F.,(3,3),(0.0,1.0),.PIECEWISE_BEZIER_KNOTS.);
#9067=COLOUR_RGB('anno_colour',0.0,0.0,0.0);
#9068=CURVE_STYLE('',FONT_SELECT($),LENGTH_MEASURE(0.25),#9067);
#9069=PRESENTATION_STYLE_ASSIGNMENT((#9068));
#9070=ANNOTATION_CURVE_OCCURRENCE('leader',(#9066),#9069);
ENDSEC;
END-ISO-10303-21;
