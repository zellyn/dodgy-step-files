ISO-10303-21;
/* Pmi162: Six additional AP242 tolerance subtypes each on its own entity name: CYLINDRICITY_TOLERANCE, ROUNDNESS_TOLERANCE (circularity), STRAIGHTNESS_TOLERANCE (form; no datum), plus datum-referenced ANGULARITY_TOLERANCE, CONCENTRICITY_TOLERANCE, SYMMETRY_TOLERANCE; generic-tolerance mapping loses the symbol semantics; GEOMETRIC_CURVE_SET IS model entity — OCC loads the point as one vertex */
HEADER;
FILE_DESCRIPTION(('Pmi162'),'2;1');
FILE_NAME('Pmi162.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
