/* Pmi006 - Saved-view name location ambiguous (camera_model_d3 vs model_geometric_view)
   Defect: Older guidance put the Saved-View name on CAMERA_MODEL_D3.name.
   AP242 Ed.2+ recommends MODEL_GEOMETRIC_VIEW.name. This file has two
   CAMERA_MODEL_D3 instances both named "Front" (with two DRAUGHTING_MODELs)
   but no MODEL_GEOMETRIC_VIEW carrying the canonical name. Ed.2-only
   readers see anonymous saved views and fall back to camera names with
   ambiguity. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pmi006 - saved view name only on camera_model_d3'),'2;1');
FILE_NAME('Pmi006.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi006','SavedViewNamePart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('cam_loc',(0.0,0.0,100.0));
#31 = DIRECTION('cam_axis',(0.0,0.0,-1.0));
#32 = DIRECTION('cam_up',(0.0,1.0,0.0));
#33 = AXIS2_PLACEMENT_3D('cam_axis_placement',#30,#31,#32);
#34 = VIEW_VOLUME(.PARALLEL.,#30,100.0,100.0,.T.,1.0,1000.0,#33);
/* Defect: name 'Front' carried only by camera_model_d3, not by
   model_geometric_view; and there are TWO cameras both named 'Front'. */
#40 = CAMERA_MODEL_D3('Front',#33,#34);
#41 = CARTESIAN_POINT('cam_loc2',(100.0,0.0,0.0));
#42 = DIRECTION('cam_axis2',(-1.0,0.0,0.0));
#43 = DIRECTION('cam_up2',(0.0,0.0,1.0));
#44 = AXIS2_PLACEMENT_3D('cam_axis2_placement',#41,#42,#43);
#45 = VIEW_VOLUME(.PARALLEL.,#41,100.0,100.0,.T.,1.0,1000.0,#44);
#46 = CAMERA_MODEL_D3('Front',#44,#45);
/* Two draughting models, one per saved view */
#50 = DRAUGHTING_MODEL('SavedView1',(),#25);
#51 = DRAUGHTING_MODEL('SavedView2',(),#25);
/* No model_geometric_view carrying the canonical name 'Front'.
   Ed.2 readers find no name to read; both saved views appear anonymous. */
#60 = SHAPE_REPRESENTATION('',(#33,#44),#25);
#61 = SHAPE_DEFINITION_REPRESENTATION(#17,#60);
/* PMI anchor: minimal ANNOTATION_PLANE so this PMI fixture cites at least one canonical PMI entity. */
#9100=PLANE('pmi_anchor_plane',#33);
#9101=ANNOTATION_PLANE('pmi_annotation',(),#9100,());
ENDSEC;
END-ISO-10303-21;
