ISO-10303-21;
/* Pmi085 - Dimension names dropped on round-trip.
 * Defect: PMI DIMENSIONAL_LOCATION carries name 'OD_critical' (used by
 * downstream design-of-experiments tools). Round-trip readers/writers
 * preserve the value but emit empty name on output. */
HEADER;
FILE_DESCRIPTION(('Pmi085 test case','Dimension names dropped on round-trip'),'2;1');
FILE_NAME('Pmi085.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('Pmi085','Pmi085','',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
/* Two SHAPE_ASPECT instances - DIMENSIONAL_LOCATION binds them as a
 * located feature pair. */
#50=SHAPE_ASPECT('OD_face','',#15,.T.);
#51=SHAPE_ASPECT('ref_face','',#15,.T.);
/* DIMENSIONAL_LOCATION: name 'OD_critical' is the producer-set identifier
 * that round-trip writers drop. 3rd/4th args are SHAPE_ASPECT pair. */
#100=DIMENSIONAL_LOCATION('OD_critical','',#50,#51);
ENDSEC;
END-ISO-10303-21;
