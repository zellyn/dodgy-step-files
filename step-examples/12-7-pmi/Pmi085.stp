ISO-10303-21;
/* Pmi085: DIMENSIONAL_LOCATION named 'OD_critical' connects two SHAPE_ASPECTs representing the measured feature endpoints; the dimension name 'OD_critical' is used by downstream design-of-experiments tools to identify specific tolerances; a writer that routes attribute emission only for shapes with non-trivial geometry silently drops the name attribute on round-trip, producing an anonymous dimension; receivers must preserve the name attribute of every named DIMENSIONAL_LOCATION and DIMENSIONAL_SIZE regardless of the associated geometry; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Pmi085'),'2;1');
FILE_NAME('Pmi085.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Pmi085','Pmi085','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#2),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
#9063=SHAPE_ASPECT('OD_from','outer diameter start',#9055,.T.);
#9064=SHAPE_ASPECT('OD_to','outer diameter end',#9055,.T.);
#9065=DIMENSIONAL_LOCATION('OD_critical','named outer diameter dimension',#9063,#9064);
ENDSEC;
END-ISO-10303-21;
