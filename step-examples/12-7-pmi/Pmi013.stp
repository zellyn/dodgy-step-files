/* Pmi013 - Counterbore/countersink emitted as separate dimensions with no compound link
   Defect: AP242 Ed.1 lacks compound-feature semantics. Workaround: emit
   counterbore as two unrelated DIMENSIONAL_SIZE instances (drill diameter
   plus counterbore diameter and depth) with no SHAPE_ASPECT_RELATIONSHIP
   tying them as one feature. SolidWorks Hole Wizard / Onshape thread
   features become plain holes on round-trip. This file shows three
   independent dimensions with NO compound-hole relationship. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pmi013 - counterbore separate dimensions with no link'),'2;1');
FILE_NAME('Pmi013.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi013','CounterborePart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#31 = DIRECTION('',(0.0,0.0,1.0));
#32 = DIRECTION('',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('',#30,#31,#32);
/* Three INDEPENDENT shape_aspects: drill, cbore_diameter, cbore_depth */
#40 = SHAPE_ASPECT('drill','through hole',#17,.T.);
#41 = SHAPE_ASPECT('cbore_dia','counterbore diameter',#17,.T.);
#42 = SHAPE_ASPECT('cbore_depth','counterbore depth',#17,.T.);
/* Three independent dimensions */
#50 = DIMENSIONAL_SIZE(#40,'diameter');
#51 = MEASURE_REPRESENTATION_ITEM('drill_dia',LENGTH_MEASURE(5.0),#20);
#52 = SHAPE_DIMENSION_REPRESENTATION('',(#51),#25);
#53 = DIMENSIONAL_SIZE(#41,'diameter');
#54 = MEASURE_REPRESENTATION_ITEM('cbore_dia',LENGTH_MEASURE(10.0),#20);
#55 = SHAPE_DIMENSION_REPRESENTATION('',(#54),#25);
#56 = DIMENSIONAL_SIZE(#42,'curved_distance');
#57 = MEASURE_REPRESENTATION_ITEM('cbore_depth',LENGTH_MEASURE(3.0),#20);
#58 = SHAPE_DIMENSION_REPRESENTATION('',(#57),#25);
/* Defect: NO shape_aspect_relationship and NO compound_hole entity ties
   #40, #41, #42 together as one counterbored hole feature. */
#60 = PLUS_MINUS_TOLERANCE(#61,#50);
#61 = TOLERANCE_VALUE(#62,#63);
#62 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(-0.05),#20);
#63 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#20);
#70 = DRAUGHTING_MODEL('Default',(),#25);
#80 = SHAPE_REPRESENTATION('',(#33),#25);
#81 = SHAPE_DEFINITION_REPRESENTATION(#17,#80);
ENDSEC;
END-ISO-10303-21;
