ISO-10303-21;
/* Pmi163: ANGULAR_SIZE (30 degrees, angle_relator .EQUAL.) and ANGULAR_LOCATION between two wedge faces, tied via DIMENSIONAL_CHARACTERISTIC_REPRESENTATION to a plane-angle MEASURE_REPRESENTATION_ITEM in RADIAN units (#9057); coercing to a linear size or dropping the plane-angle unit mis-carries it; GEOMETRIC_CURVE_SET IS model entity — OCC loads the point as one vertex */
HEADER;
FILE_DESCRIPTION(('Pmi163'),'2;1');
FILE_NAME('Pmi163.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Pmi163','Pmi163','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#2),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
#9063=SHAPE_ASPECT('wedge_face_1','',#9055,.T.);
#9064=SHAPE_ASPECT('wedge_face_2','',#9055,.T.);
#9065=ANGULAR_SIZE(#9063,'wedge_angle',.EQUAL.);
#9066=ANGULAR_LOCATION('face_angle','angle between wedge faces',#9063,#9064,.EQUAL.);
#9067=(MEASURE_REPRESENTATION_ITEM()MEASURE_WITH_UNIT(PLANE_ANGLE_MEASURE(0.5235987756),#9057)REPRESENTATION_ITEM('wedge_angle'));
#9068=SHAPE_DIMENSION_REPRESENTATION('30deg',(#9067),#9060);
#9069=DIMENSIONAL_CHARACTERISTIC_REPRESENTATION(#9065,#9068);
#9070=DIMENSIONAL_CHARACTERISTIC_REPRESENTATION(#9066,#9068);
ENDSEC;
END-ISO-10303-21;
