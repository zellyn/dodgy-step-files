/* Pmi033 - placed_datum_target_feature shape mismatch
   Defect: The PLACED_DATUM_TARGET_FEATURE is typed 'circle' but its
   bounded geometric_item references a square face. The shape category
   declared and the bounding face/edges in the geometry are inconsistent.
   Receivers should warn and attempt recovery from the geometric data. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pmi033 - placed_datum_target shape mismatch'),'2;1');
FILE_NAME('Pmi033.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi033','ShapeMismatchTargetPart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
/* Square face geometry */
#30 = CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#31 = CARTESIAN_POINT('p1',(10.0,0.0,0.0));
#32 = CARTESIAN_POINT('p2',(10.0,10.0,0.0));
#33 = CARTESIAN_POINT('p3',(0.0,10.0,0.0));
#34 = DIRECTION('',(0.0,0.0,1.0));
#35 = DIRECTION('',(1.0,0.0,0.0));
#36 = AXIS2_PLACEMENT_3D('',#30,#34,#35);
#37 = PLANE('square_plane',#36);
#38 = ADVANCED_FACE('square_face',(),#37,.T.);
/* Defect: target type is 'circle' but the bounded face is a square */
#40 = DATUM('A','',#17,.T.,'A');
#41 = PLACED_DATUM_TARGET_FEATURE('A1','circle',#17,.T.,'A1');
#42 = SHAPE_ASPECT_RELATIONSHIP('','',#40,#41);
#43 = GEOMETRIC_ITEM_SPECIFIC_USAGE('GISU',$,#41,$,#38);
#50 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(5.0),#20);
#51 = MEASURE_REPRESENTATION_ITEM('target_diameter',LENGTH_MEASURE(5.0),#20);
#52 = SHAPE_DIMENSION_REPRESENTATION('',(#51),#25);
#60 = DRAUGHTING_MODEL('Default',(),#25);
#70 = SHAPE_REPRESENTATION('',(#36,#38),#25);
#71 = SHAPE_DEFINITION_REPRESENTATION(#17,#70);
ENDSEC;
END-ISO-10303-21;
