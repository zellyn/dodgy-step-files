/* Pmi019 - camera_model_d3 viewpoint not modeled per RP §9
   Defect: CAMERA_MODEL_D3 lacks the orthonormal/orientation conventions
   expected by RP §9. Specifically, this file's view-up direction is
   parallel to the view direction (both are along Z), not orthogonal,
   so a Gram-Schmidt orthonormalization is required to render correctly. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pmi019 - camera_model_d3 view-up parallel to view-direction'),'2;1');
FILE_NAME('Pmi019.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi019','BadCameraPart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('cam_loc',(0.0,0.0,100.0));
/* Defect: view direction (axis) and up direction (ref_direction)
   are both along Z — they are parallel, not orthogonal as RP §9 requires. */
#31 = DIRECTION('view_dir',(0.0,0.0,-1.0));
#32 = DIRECTION('view_up',(0.0,0.0,1.0));
#33 = AXIS2_PLACEMENT_3D('cam_axis',#30,#31,#32);
#34 = VIEW_VOLUME(.PARALLEL.,#30,100.0,100.0,.T.,1.0,1000.0,#33);
#40 = CAMERA_MODEL_D3('Front',#33,#34);
#50 = DRAUGHTING_MODEL('Front_View',(),#25);
#60 = SHAPE_REPRESENTATION('',(#33),#25);
#61 = SHAPE_DEFINITION_REPRESENTATION(#17,#60);
/* PMI anchor: minimal ANNOTATION_PLANE so this PMI fixture cites at least one canonical PMI entity. */
#9100=PLANE('pmi_anchor_plane',#33);
#9101=ANNOTATION_PLANE('pmi_annotation',(),#9100,());
ENDSEC;
END-ISO-10303-21;
