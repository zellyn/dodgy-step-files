ISO-10303-21;
/* Pmi090.input - Pre-roundtrip source for Pmi090.stp
 * Producer's in-memory state assigns the persistent UUID
 * '4ce0acf8-1a2b-4c3d-9e8f-7a6b5c4d3e2f' to face #35. After a
 * receiver-side import / re-export cycle, that UUID must survive
 * unchanged. Pmi090.stp shows the original; the defect is the
 * differential between this file and the receiver's re-export. */
HEADER;
FILE_DESCRIPTION(('Pmi090.input - persistent UUID assignment pre-roundtrip'),'2;1');
FILE_NAME('Pmi090.input.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=PRODUCT_CONTEXT('part',#1,'mechanical');
#3=PRODUCT('Pmi090','witness_uuid','',(#2));
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
