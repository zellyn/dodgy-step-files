ISO-10303-21;
/* Pmi106 - SLOT/GROOVE/BOSS reference dangling host face (does not exist)
 * Defect: SHAPE_ASPECT and GEOMETRIC_ITEM_SPECIFIC_USAGE link three feature
 * definitions (SLOT, GROOVE, BOSS) to a host face that is referenced by
 * #999 -- never declared in the file. Receivers must validate cross-refs
 * during the PMI link pass; silently dropping the linkage is a defect class
 * because the feature definitions become orphaned but still appear in the
 * file's PMI section. */
HEADER;
FILE_DESCRIPTION(('Pmi106 - SLOT/GROOVE/BOSS reference non-existent host face'),'2;1');
FILE_NAME('Pmi106.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=PRODUCT_CONTEXT('part',#1,'mechanical');
#3=PRODUCT('Pmi106','features_dangling_host_face','',(#2));
#4=PRODUCT_DEFINITION_FORMATION('','',#3);
#5=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#6=PRODUCT_DEFINITION('','',#4,#5);
#7=PRODUCT_DEFINITION_SHAPE('','',#6);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,'tol','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D'));
/* 50x50 mm host face -- declared at #406. */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(50.0,0.0,0.0));
#102=CARTESIAN_POINT('',(50.0,50.0,0.0));
#103=CARTESIAN_POINT('',(0.0,50.0,0.0));
#110=VERTEX_POINT('',#100); #111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102); #113=VERTEX_POINT('',#103);
#200=DIRECTION('',(0.0,0.0,1.0));
#201=DIRECTION('',(1.0,0.0,0.0));
#202=DIRECTION('',(0.0,1.0,0.0));
#210=AXIS2_PLACEMENT_3D('plate_origin',#100,#200,#201);
#211=PLANE('host_face_50x50',#210);
#300=VECTOR('',#201,50.0);
#301=VECTOR('',#202,50.0);
#310=LINE('',#100,#300); #311=EDGE_CURVE('',#110,#111,#310,.T.);
#312=LINE('',#101,#301); #313=EDGE_CURVE('',#111,#112,#312,.T.);
#314=LINE('',#103,#300); #315=EDGE_CURVE('',#113,#112,#314,.T.);
#316=LINE('',#100,#301); #317=EDGE_CURVE('',#110,#113,#316,.T.);
#400=ORIENTED_EDGE('',*,*,#311,.T.); #401=ORIENTED_EDGE('',*,*,#313,.T.);
#402=ORIENTED_EDGE('',*,*,#315,.F.); #403=ORIENTED_EDGE('',*,*,#317,.F.);
#404=EDGE_LOOP('',(#400,#401,#402,#403));
#405=FACE_OUTER_BOUND('',#404,.T.);
#406=ADVANCED_FACE('host_face',(#405),#211,.T.);
#500=OPEN_SHELL('host_shell',(#406));
#501=SHELL_BASED_SURFACE_MODEL('host_model',(#500));
#502=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('shape',(#501,#210),#14);
#503=SHAPE_DEFINITION_REPRESENTATION(#7,#502);
/* SLOT, GROOVE, BOSS feature definitions that point at a non-existent face #9999. */
#600=SHAPE_ASPECT('SLOT','slot referencing dangling host #9999',#7,.T.);
#601=GEOMETRIC_ITEM_SPECIFIC_USAGE('GISU_SLOT_DANGLING',$,#600,#502,#9999);
#610=DIMENSIONAL_SIZE(#600,'slot_length');
#611=MEASURE_REPRESENTATION_ITEM('length',LENGTH_MEASURE(20.0),#10);
#612=SHAPE_DIMENSION_REPRESENTATION('',(#611),#14);
#700=SHAPE_ASPECT('GROOVE','groove referencing dangling host #9999',#7,.T.);
#701=GEOMETRIC_ITEM_SPECIFIC_USAGE('GISU_GROOVE_DANGLING',$,#700,#502,#9999);
#710=DIMENSIONAL_SIZE(#700,'groove_width');
#711=MEASURE_REPRESENTATION_ITEM('width',LENGTH_MEASURE(2.0),#10);
#712=SHAPE_DIMENSION_REPRESENTATION('',(#711),#14);
#800=SHAPE_ASPECT('BOSS','boss referencing dangling host #9999',#7,.T.);
#801=GEOMETRIC_ITEM_SPECIFIC_USAGE('GISU_BOSS_DANGLING',$,#800,#502,#9999);
#810=DIMENSIONAL_SIZE(#800,'boss_diameter');
#811=MEASURE_REPRESENTATION_ITEM('diameter',LENGTH_MEASURE(8.0),#10);
#812=SHAPE_DIMENSION_REPRESENTATION('',(#811),#14);
ENDSEC;
END-ISO-10303-21;
