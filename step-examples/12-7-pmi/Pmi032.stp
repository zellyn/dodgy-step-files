/* Pmi032 - Datum target dimension equals zero
   Defect: A point/line/circle/rectangular PLACED_DATUM_TARGET_FEATURE
   carries target diameter / target length of 0. A circle with diameter 0
   is a point; receivers should warn and refuse to emit a degenerate
   target. This file shows target_diameter = 0.0 on a 'circle' target. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pmi032 - datum target dimension is zero'),'2;1');
FILE_NAME('Pmi032.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi032','ZeroTargetDimPart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('target_loc',(10.0,10.0,0.0));
#31 = DIRECTION('',(0.0,0.0,1.0));
#32 = DIRECTION('',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('target_axis',#30,#31,#32);
#40 = DATUM('A','',#17,.T.,'A');
/* Defect: a circle datum target with diameter 0 is degenerate */
#50 = PLACED_DATUM_TARGET_FEATURE('A1','circle',#17,.T.,'A1');
#51 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.0),#20);
#52 = SHAPE_ASPECT_RELATIONSHIP('target_of','',#40,#50);
/* The "target_diameter" property on the placed datum target feature */
#53 = MEASURE_REPRESENTATION_ITEM('target_diameter',LENGTH_MEASURE(0.0),#20);
#54 = SHAPE_DIMENSION_REPRESENTATION('target_dim_rep',(#53),#25);
#60 = DRAUGHTING_MODEL('Default',(),#25);
#70 = SHAPE_REPRESENTATION('',(#33),#25);
#71 = SHAPE_DEFINITION_REPRESENTATION(#17,#70);
ENDSEC;
END-ISO-10303-21;
