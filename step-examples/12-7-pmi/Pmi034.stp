/* Pmi034 - placed_datum_target_feature shared DatumTargetType_Area null deref
   Defect: Two PLACED_DATUM_TARGET_FEATURE entities incorrectly share a
   single DATUM_TARGET_TYPE_AREA instance. Some translators (notably
   OCCT pre-fix per Mantis 0031685) NULL-deref when iterating the second
   reference because they assume independent ownership. Each placed datum
   target should own its own type-area. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pmi034 - shared DatumTargetType_Area null deref'),'2;1');
FILE_NAME('Pmi034.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi034','SharedAreaTargetPart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#31 = CARTESIAN_POINT('p2',(20.0,0.0,0.0));
#32 = DIRECTION('',(0.0,0.0,1.0));
#33 = DIRECTION('',(1.0,0.0,0.0));
#34 = AXIS2_PLACEMENT_3D('',#30,#32,#33);
#35 = AXIS2_PLACEMENT_3D('',#31,#32,#33);
#40 = DATUM('A','',#17,.T.,'A');
/* Single DatumTargetType_Area instance #50 shared by both placed targets */
#50 = DESCRIPTIVE_REPRESENTATION_ITEM('DatumTargetType_Area','area');
/* Two placed datum target features both type 'rectangle' both
   referencing the SAME #50 area-type item — defect. */
#60 = PLACED_DATUM_TARGET_FEATURE('A1','rectangle',#17,.T.,'A1');
#61 = PLACED_DATUM_TARGET_FEATURE('A2','rectangle',#17,.T.,'A2');
#62 = PROPERTY_DEFINITION('shared area type','',#60);
#63 = PROPERTY_DEFINITION('shared area type','',#61);
#64 = REPRESENTATION('',(#50),#25);
#65 = PROPERTY_DEFINITION_REPRESENTATION(#62,#64);
#66 = PROPERTY_DEFINITION_REPRESENTATION(#63,#64);
#70 = SHAPE_ASPECT_RELATIONSHIP('','',#40,#60);
#71 = SHAPE_ASPECT_RELATIONSHIP('','',#40,#61);
#80 = DRAUGHTING_MODEL('Default',(),#25);
#90 = SHAPE_REPRESENTATION('',(#34,#35),#25);
#91 = SHAPE_DEFINITION_REPRESENTATION(#17,#90);
ENDSEC;
END-ISO-10303-21;
