/* Pmi090 - Persistent UUID lost on round-trip (PMI association breaks)
 * Defect: a face #35 carries a persistent UUID via
 *   APPLIED_IDENTIFICATION_ASSIGNMENT('4ce0acf8-...','uuid',(#35)).
 * A receiver that regenerates UUIDs on import / re-export silently
 * breaks PMI links from external files (DDP-style cross-file refs
 * resolve via UUID). The fixture establishes the pre-round-trip
 * state. The defect lives in the differential between this file and
 * the receiver's re-export.
 * Provenance tier: requires-sibling-pair. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pmi090 - persistent UUID round-trip stability witness'),'2;1');
FILE_NAME('Pmi090.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=PRODUCT_CONTEXT('part',#1,'mechanical');
#3=PRODUCT('Pmi090','witness_uuid','',(#2));
#4=PRODUCT_DEFINITION_FORMATION('','',#3);
#5=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#6=PRODUCT_DEFINITION('','',#4,#5);
#7=PRODUCT_DEFINITION_SHAPE('','',#6);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,'tol','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D'));
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=PLANE('',#23);
#35=ADVANCED_FACE('uuid_bearing_face',(),#24,.T.);
/* Persistent UUID -- must survive any round-trip. */
#80=IDENTIFICATION_ROLE('uuid','persistent feature identifier');
#81=APPLIED_IDENTIFICATION_ASSIGNMENT('4ce0acf8-1a2b-4c3d-9e8f-7a6b5c4d3e2f',#80,(#35));
/* PMI link that depends on the persistent UUID surviving round-trip. */
#90=DATUM('A','primary datum on uuid-bearing face',#7,.T.,'A');
#91=DATUM_FEATURE('feature_A','feature linked via UUID',#7,.T.);
#92=SHAPE_ASPECT_RELATIONSHIP('','',#90,#91);
ENDSEC;
END-ISO-10303-21;
