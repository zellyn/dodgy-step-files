ISO-10303-21;
/* Pmi079 - Dimension lost on export round-trip.
 * Defect: two PMI dimensions in the document. One DIMENSIONAL_LOCATION
 * is attached to a face directly; the other is attached via a SHAPE_ASPECT.
 * The writer's GD&T emitter only walks face-attached PMIs and drops the
 * SHAPE_ASPECT-attached one. Both face and shape-aspect must exist. */
HEADER;
FILE_DESCRIPTION(('Pmi079 test case','Dimension lost on export round-trip'),'2;1');
FILE_NAME('Pmi079.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('part1','part1','part1',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
/* Two ADVANCED_FACEs - one for direct attachment, one for shape-aspect attachment */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#30=PLANE('face_a_plane',#23);
#31=ADVANCED_FACE('face_a_direct',(),#30,.T.);
#32=PLANE('face_b_plane',#23);
#33=ADVANCED_FACE('face_b_for_aspect',(),#32,.T.);
/* SHAPE_ASPECT-attached dimension: indirect attachment via the aspect */
#40=SHAPE_ASPECT('hole_feature','hole feature aspect',#15,.T.);
#41=DIMENSIONAL_LOCATION('via_shape_aspect','indirect',#40,#40);
/* Direct face-attached dimension: attached straight to the face's product
 * definition shape (a representation_item-grade attachment) */
#50=DIMENSIONAL_LOCATION('direct_on_face','direct',#15,#15);
/* Add SDR linking PRODUCT to existing geometry. */
#9000=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9001=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9002=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9003=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9000,'distance_accuracy_value','');
#9004=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9003))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9000,#9001,#9002))REPRESENTATION_CONTEXT('','3D'));
#9010=OPEN_SHELL('wrap_shell',(#31,#33));
#9011=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9010));
#9020=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9011),#9004);
#9021=SHAPE_DEFINITION_REPRESENTATION(#15,#9020);
ENDSEC;
END-ISO-10303-21;
