ISO-10303-21;
/* Pmi005 - Mixing Polyline and Tessellated PMI presentation in one file
   Defect: AP242 schema permits both polyline ANNOTATION_CURVE_OCCURRENCE
   and TESSELLATED_ANNOTATION_OCCURRENCE, but most viewers pick one and
   silently drop the other. This DRAUGHTING_MODEL contains both forms for
   different callouts: the diameter dimension is realized as polyline curves
   while the parallelism FCF is realized as tessellated triangles.
   Interoperability-hostile mix. */
HEADER;
FILE_DESCRIPTION(('Pmi005 - polyline and tessellated PMI mixed'),'2;1');
FILE_NAME('Pmi005.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi005','MixedPMIPart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#31 = DIRECTION('',(0.0,0.0,1.0));
#32 = DIRECTION('',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('',#30,#31,#32);
#34 = PLANE('',#33);
#35 = NULL_STYLE(.NULL.);
/* Polyline annotation: a diameter callout */
#40 = CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#41 = CARTESIAN_POINT('p2',(10.0,0.0,0.0));
#42 = CARTESIAN_POINT('p3',(10.0,10.0,0.0));
#43 = POLYLINE('diam_callout',(#40,#41,#42));
#44 = ANNOTATION_CURVE_OCCURRENCE('diam_polyline_occ',(#35),#43);
/* Tessellated annotation: a parallelism FCF rendered as triangles */
#50 = COORDINATES_LIST('tess_coords',4,
  ((20.0,0.0,0.0),(30.0,0.0,0.0),(30.0,10.0,0.0),(20.0,10.0,0.0)));
#51 = TRIANGULATED_FACE('tess_face',#50,$,$,
  ((1,2,3),(1,3,4)),$);
#52 = TESSELLATED_ANNOTATION_OCCURRENCE('par_tess_occ',(#35),#51);
/* Both occurrences listed under the same draughting_model — defect */
#60 = DRAUGHTING_MODEL('Mixed_PMI_Model',(#44,#52),#25);
#61 = ANNOTATION_PLANE('annotation_plane',(),#34,(#44,#52));
/* Backing semantic */
#70 = SHAPE_ASPECT('feature1','',#17,.T.);
#71 = DIMENSIONAL_SIZE(#70,'diameter');
#72 = MEASURE_REPRESENTATION_ITEM('nom',LENGTH_MEASURE(10.0),#20);
#73 = SHAPE_DIMENSION_REPRESENTATION('',(#72),#25);
#74 = SHAPE_ASPECT('feature2','',#17,.T.);
#75 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#20);
#76 = DATUM('A','',#17,.T.,'A');
#77 = DATUM_REFERENCE_COMPARTMENT('',$,#78);
#78 = DATUM_REFERENCE_ELEMENT('',$,#76);
#79 = DATUM_SYSTEM('A','',#17,.T.,(#77));
#80 = PARALLELISM_TOLERANCE('par',$,#75,#74,#79);
#90 = SHAPE_REPRESENTATION('',(#33),#25);
#91 = SHAPE_DEFINITION_REPRESENTATION(#17,#90);
ENDSEC;
END-ISO-10303-21;
