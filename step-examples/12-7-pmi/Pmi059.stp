ISO-10303-21;
/* Pmi059 - Surface status (cosmetic / construction / blanked) preservation lost
   Defect: A face tagged in source CAD with status=construction loses
   its status flag after STEP round-trip. The source-side
   PROPERTY_DEFINITION carrying the status is missing here, leaving the
   ADVANCED_FACE indistinguishable from a real face. (W029 SDHE-21748).
   Receivers should preserve such properties even if they cannot use
   the value semantically. */
HEADER;
FILE_DESCRIPTION(('Pmi059 - construction-status flag dropped',
  'CAx-IF Rec.Pracs.---PMI Rep & Pres---v4.1'),'2;1');
FILE_NAME('Pmi059.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi059','LostConstructionFlagPart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#31 = DIRECTION('',(0.0,0.0,1.0));
#32 = DIRECTION('',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('',#30,#31,#32);
#34 = PLANE('cosmetic_face_geom',#33);
#35 = ADVANCED_FACE('cosmetic_face',(),#34,.T.);
/* Defect: this SHAPE_ASPECT carries a status name 'cosmetic' but the
   round-tripping translator stripped the surface_condition and only
   left an empty descriptive_representation_item. Round-trip readers
   cannot tell if the face is cosmetic, construction or production. */
#40 = SHAPE_ASPECT('cosmetic_face_sa','cosmetic_face',#17,.T.);
#41 = PROPERTY_DEFINITION('surface_condition','status flag stripped',#40);
#42 = DESCRIPTIVE_REPRESENTATION_ITEM('status','');
#43 = REPRESENTATION('status_rep',(#42),#25);
#44 = PROPERTY_DEFINITION_REPRESENTATION(#41,#43);
/* In a healthy file the value would be e.g. 'cosmetic' or 'construction' */
#50 = DRAUGHTING_MODEL('Default',(#35),#25);
#51 = PLANE('ann_plane',#33);
#52 = ANNOTATION_PLANE('PMI',(),#51,());
#90 = SHAPE_REPRESENTATION('',(#33,#35),#25);
#91 = SHAPE_DEFINITION_REPRESENTATION(#17,#90);
ENDSEC;
END-ISO-10303-21;
