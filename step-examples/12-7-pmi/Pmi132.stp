/* Pmi132 - INTERNAL_THREAD declared on a feature whose host shape is external
 * Defect: a SHAPE_ASPECT typed 'internal_thread' (a hole's threading) is
 * attached to a host face that represents an external cylindrical surface
 * (i.e. boss / shaft, not bore). The thread gender contradicts the host
 * geometry. Receivers either trust the gender label and machine wrong,
 * trust the host and re-tag, or reject. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Pmi132 - INTERNAL_THREAD on EXTERNAL host (gender mismatch)'),'2;1');
FILE_NAME('Pmi132.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=PRODUCT_CONTEXT('part',#1,'mechanical');
#3=PRODUCT('Pmi132','thread_gender_mismatch','',(#2));
#4=PRODUCT_DEFINITION_FORMATION('','',#3);
#5=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#6=PRODUCT_DEFINITION('','',#4,#5);
#7=PRODUCT_DEFINITION_SHAPE('','',#6);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,'tol','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D'));
/* 30x30 mm planar host face -- representing a flat surrounding the threaded boss. */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(30.0,0.0,0.0));
#102=CARTESIAN_POINT('',(30.0,30.0,0.0));
#103=CARTESIAN_POINT('',(0.0,30.0,0.0));
#110=VERTEX_POINT('',#100); #111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102); #113=VERTEX_POINT('',#103);
#200=DIRECTION('',(0.0,0.0,1.0));
#201=DIRECTION('',(1.0,0.0,0.0));
#202=DIRECTION('',(0.0,1.0,0.0));
#210=AXIS2_PLACEMENT_3D('plate_origin',#100,#200,#201);
#211=PLANE('host_face_30x30',#210);
#300=VECTOR('',#201,30.0);
#301=VECTOR('',#202,30.0);
#310=LINE('',#100,#300); #311=EDGE_CURVE('',#110,#111,#310,.T.);
#312=LINE('',#101,#301); #313=EDGE_CURVE('',#111,#112,#312,.T.);
#314=LINE('',#103,#300); #315=EDGE_CURVE('',#113,#112,#314,.T.);
#316=LINE('',#100,#301); #317=EDGE_CURVE('',#110,#113,#316,.T.);
#400=ORIENTED_EDGE('',*,*,#311,.T.); #401=ORIENTED_EDGE('',*,*,#313,.T.);
#402=ORIENTED_EDGE('',*,*,#315,.F.); #403=ORIENTED_EDGE('',*,*,#317,.F.);
#404=EDGE_LOOP('',(#400,#401,#402,#403));
#405=FACE_OUTER_BOUND('',#404,.T.);
#406=ADVANCED_FACE('external_boss_face',(#405),#211,.T.);
#500=OPEN_SHELL('boss_shell',(#406));
#501=SHELL_BASED_SURFACE_MODEL('boss_model',(#500));
#502=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('shape',(#501,#210),#14);
#503=SHAPE_DEFINITION_REPRESENTATION(#7,#502);
/* Thread feature: declared internal_thread on an external_boss_face. Gender mismatch. */
#600=SHAPE_ASPECT('internal_thread','internal_thread mis-attached to external boss face',#7,.T.);
#601=GEOMETRIC_ITEM_SPECIFIC_USAGE('GISU',$,#600,#502,#406);
#610=DIMENSIONAL_SIZE(#600,'nominal_diameter');
#611=MEASURE_REPRESENTATION_ITEM('nominal_diameter',LENGTH_MEASURE(12.0),#10);
#612=SHAPE_DIMENSION_REPRESENTATION('',(#611),#14);
#620=DIMENSIONAL_SIZE(#600,'pitch');
#621=MEASURE_REPRESENTATION_ITEM('pitch',LENGTH_MEASURE(1.75),#10);
#622=SHAPE_DIMENSION_REPRESENTATION('',(#621),#14);
#630=DESCRIPTIVE_REPRESENTATION_ITEM('host_kind','external_cylindrical_face');
#631=PROPERTY_DEFINITION('host_kind','host face is external cylindrical -- wrong gender',#600);
#632=PROPERTY_DEFINITION_REPRESENTATION(#631,#633);
#633=REPRESENTATION('host_kind_rep',(#630),#14);
ENDSEC;
END-ISO-10303-21;
