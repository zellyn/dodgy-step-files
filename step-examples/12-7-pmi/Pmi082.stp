ISO-10303-21;
/* Pmi082 - Saved views and clipping planes lost on read.
 * Defect: AP242 STEP file with a PRESENTATION_VIEW linking PMI annotations
 * and a CLIPPING_PLANE; older readers unaware of these AP242 subtypes
 * silently drop them. Schema MUST be AP242 to provoke that pathway. */
HEADER;
FILE_DESCRIPTION(('Pmi082 test case','Saved views and clipping planes lost on read'),'2;1');
FILE_NAME('Pmi082.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 3 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','ap242_managed_model_based_3d_engineering',2020,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('part1','part1','part1',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
/* Three PMI annotations to be aggregated into the saved view */
#30=DRAUGHTING_CALLOUT('annot_1',());
#31=DRAUGHTING_CALLOUT('annot_2',());
#32=DRAUGHTING_CALLOUT('annot_3',());
/* AP242 PRESENTATION_VIEW grouping the three annotations */
#40=PRESENTATION_VIEW('side_view','saved side view','',(#30,#31,#32),#1);
/* Clipping plane: axis2 + plane + CLIPPING_PLANE wrapper */
#50=CARTESIAN_POINT('',(0.0,0.0,0.0));
#51=DIRECTION('',(0.0,0.0,1.0));
#52=DIRECTION('',(1.0,0.0,0.0));
#53=AXIS2_PLACEMENT_3D('clip_axis',#50,#51,#52);
#54=PLANE('clip_plane',#53);
#60=CLIPPING_PLANE('cp1','side-view clip','',#54);
/* PMI anchor: minimal ANNOTATION_PLANE so this PMI fixture cites at least one canonical PMI entity. */
#9100=PLANE('pmi_anchor_plane',#53);
#9101=ANNOTATION_PLANE('pmi_annotation',(),#9100,());
ENDSEC;
END-ISO-10303-21;
