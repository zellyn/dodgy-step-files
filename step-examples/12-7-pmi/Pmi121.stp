ISO-10303-21;
/* Pmi121 - PROFILE_FEATURE depth direction not perpendicular to profile plane
 * Defect: an extruded profile_feature has a profile plane (where the
 * 2-D profile lies) and a sweep direction. For a straight extrude
 * the sweep direction must be perpendicular (or the producer must
 * declare an explicit "tilt extrude" mode). A producer that emits a
 * profile on the XY-plane but sweeps along (1,0,0) -- a direction
 * lying IN the plane, not perpendicular -- creates a degenerate sweep
 * that produces zero volume. Receivers either reject (degenerate
 * extrude), project the direction onto the normal (silent), or
 * accept and produce empty geometry. */
HEADER;
FILE_DESCRIPTION(('Pmi121 - profile_feature depth direction not perpendicular'),'2;1');
FILE_NAME('Pmi121.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=PRODUCT_CONTEXT('part',#1,'mechanical');
#3=PRODUCT('Pmi121','profile_bad_depth_direction','',(#2));
#4=PRODUCT_DEFINITION_FORMATION('','',#3);
#5=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#6=PRODUCT_DEFINITION('','',#4,#5);
#7=PRODUCT_DEFINITION_SHAPE('','',#6);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,'tol','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D'));
/* 50x50 mm planar host face on XY plane. */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(50.0,0.0,0.0));
#102=CARTESIAN_POINT('',(50.0,50.0,0.0));
#103=CARTESIAN_POINT('',(0.0,50.0,0.0));
#110=VERTEX_POINT('',#100); #111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102); #113=VERTEX_POINT('',#103);
#200=DIRECTION('z_up',(0.0,0.0,1.0));
#201=DIRECTION('x_axis',(1.0,0.0,0.0));
#202=DIRECTION('y_axis',(0.0,1.0,0.0));
#210=AXIS2_PLACEMENT_3D('host_origin',#100,#200,#201);
#211=PLANE('host_xy_plane',#210);
#300=VECTOR('',#201,50.0);
#301=VECTOR('',#202,50.0);
#310=LINE('',#100,#300); #311=EDGE_CURVE('',#110,#111,#310,.T.);
#312=LINE('',#101,#301); #313=EDGE_CURVE('',#111,#112,#312,.T.);
#314=LINE('',#103,#300); #315=EDGE_CURVE('',#113,#112,#314,.T.);
#316=LINE('',#100,#301); #317=EDGE_CURVE('',#110,#113,#316,.T.);
#400=ORIENTED_EDGE('',*,*,#311,.T.); #401=ORIENTED_EDGE('',*,*,#313,.T.);
#402=ORIENTED_EDGE('',*,*,#315,.F.); #403=ORIENTED_EDGE('',*,*,#317,.F.);
#404=EDGE_LOOP('',(#400,#401,#402,#403));
#405=FACE_OUTER_BOUND('',#404,.T.);
#406=ADVANCED_FACE('host_face',(#405),#211,.T.);
#500=OPEN_SHELL('host_shell',(#406));
#501=SHELL_BASED_SURFACE_MODEL('host_model',(#500));
#502=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('shape',(#501,#210),#14);
#503=SHAPE_DEFINITION_REPRESENTATION(#7,#502);
/* Profile_feature: profile lies on XY plane (normal = +Z). Defect: sweep
 * direction emitted as (1,0,0) -- IN the plane, not perpendicular. */
#600=SHAPE_ASPECT('profile_feature','extrude profile with bad depth direction',#7,.T.);
#601=GEOMETRIC_ITEM_SPECIFIC_USAGE('GISU',$,#600,#502,#406);
/* Profile plane normal = +Z (#200). Sweep direction declared = +X (#201). */
#610=DIRECTION('sweep_direction',(1.0,0.0,0.0));
#611=VECTOR('sweep_vector',#610,10.0);
#620=DIMENSIONAL_SIZE(#600,'sweep_depth');
#621=MEASURE_REPRESENTATION_ITEM('depth_mm',LENGTH_MEASURE(10.0),#10);
#622=SHAPE_DIMENSION_REPRESENTATION('',(#621),#14);
#630=DESCRIPTIVE_REPRESENTATION_ITEM('depth_dir_vs_normal','sweep along +X but profile normal is +Z (parallel to plane)');
#631=PROPERTY_DEFINITION('depth_orthogonality','sweep direction perpendicular to profile plane?',#600);
#632=PROPERTY_DEFINITION_REPRESENTATION(#631,#633);
#633=REPRESENTATION('orthogonality',(#630),#14);
ENDSEC;
END-ISO-10303-21;
