ISO-10303-21;
/* Pmi069 - DIMENSIONAL_LOCATION_WITH_PATH whose path does not
 * traverse the model
 * Defect: AP242 DIMENSIONAL_LOCATION_WITH_PATH carries an extra
 * 'path' attribute (a SHAPE_ASPECT_RELATIONSHIP chain) describing
 * the route through the model along which a dimension is to be
 * measured. The spec assumes the path is a connected sequence of
 * shape_aspects. A producer that emits a path whose endpoints
 * are unrelated shape_aspects on disconnected components leaves
 * the dimension's interpretation ambiguous. Here the path
 * connects #40 (a feature on solid A) to #41 (a feature on
 * solid B) but neither is reachable from the other through the
 * model's topology. */
HEADER;
FILE_DESCRIPTION(('Pmi069 - DIMENSIONAL_LOCATION_WITH_PATH disconnected'),'2;1');
FILE_NAME('Pmi069.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=PRODUCT_CONTEXT('',#1,'mechanical');
#3=PRODUCT('Pmi069','PathDisconnectPart','',(#2));
#4=PRODUCT_DEFINITION_FORMATION('','',#3);
#5=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#6=PRODUCT_DEFINITION('','',#4,#5);
#7=PRODUCT_DEFINITION_SHAPE('','',#6);
#20=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25=( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
/* Two SHAPE_ASPECT entities representing features on disjoint
 * topological components */
#40=SHAPE_ASPECT('feature_on_A','planar face A',#7,.T.);
#41=SHAPE_ASPECT('feature_on_B','planar face B',#7,.T.);
/* Defect: the dimensional location's "path" connects the two
 * shape aspects through a single SHAPE_ASPECT_RELATIONSHIP, but
 * the relationship's intent is unclear since the two features
 * are not connected through any topology in the model. */
#50=SHAPE_ASPECT_RELATIONSHIP('disconnected_path','no path',#40,#41);
#51=DIMENSIONAL_LOCATION_WITH_PATH('width across',$,#40,#41,#50);
#52=MEASURE_REPRESENTATION_ITEM('width',LENGTH_MEASURE(50.0),#20);
#53=SHAPE_DIMENSION_REPRESENTATION('',(#52),#25);
#90=SHAPE_REPRESENTATION('',(),#25);
#91=SHAPE_DEFINITION_REPRESENTATION(#7,#90);
ENDSEC;
END-ISO-10303-21;
