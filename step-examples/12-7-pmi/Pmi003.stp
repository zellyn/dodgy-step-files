ISO-10303-21;
/* Pmi003 - Stacked vs composite tolerance frames mis-tagged
   Defect: Two parallelism tolerances drawn one above the other in the same
   FCF are merely "stacked" (semantically independent), but the writer emits
   a GEOMETRIC_TOLERANCE_RELATIONSHIP with name='composite'. True composite
   tolerances must use the 'composite' relationship; stacked tolerances must
   not. Receivers that count composite frames will inflate their count, and
   downstream tools may treat the two rows as a single coupled tolerance. */
HEADER;
FILE_DESCRIPTION(('Pmi003 - stacked tolerances mis-tagged as composite'),'2;1');
FILE_NAME('Pmi003.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('managed model based 3d engineering');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('Pmi003','StackedTolPart','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
#30 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#31 = DIRECTION('',(0.0,0.0,1.0));
#32 = DIRECTION('',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('',#30,#31,#32);
#40 = SHAPE_REPRESENTATION('',(#33),#25);
#41 = SHAPE_DEFINITION_REPRESENTATION(#17,#40);
/* Two faces under tolerance */
#50 = SHAPE_ASPECT('top_face','',#17,.T.);
#51 = SHAPE_ASPECT('side_face','',#17,.T.);
/* Datum A */
#60 = DATUM('A','primary',#17,.T.,'A');
#61 = DATUM_REFERENCE_COMPARTMENT('',$,#62);
#62 = DATUM_REFERENCE_ELEMENT('',$,#60);
#63 = DATUM_SYSTEM('A','',#17,.T.,(#61));
/* Two parallelism tolerances, semantically independent */
#70 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#20);
#71 = PARALLELISM_TOLERANCE('par1',$,#70,#50,#63);
#72 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.10),#20);
#73 = PARALLELISM_TOLERANCE('par2',$,#72,#51,#63);
/* Defect: stacked tolerances mis-tagged as 'composite' */
#80 = GEOMETRIC_TOLERANCE_RELATIONSHIP('composite',
  'stacked frames mis-tagged as composite',#71,#73);
#90 = DRAUGHTING_MODEL('Default',(),#25);
#91 = PLANE('',#33);
#92 = ANNOTATION_PLANE('PMI',(),#91,(#71,#73));
ENDSEC;
END-ISO-10303-21;
