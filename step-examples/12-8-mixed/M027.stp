ISO-10303-21;
/* M027 - Surface-sampling-point validation property failure.
 * Defect: a finer-grained validation than volume/area: a set of
 * (u,v,XYZ) sample points is embedded; on retrieval the receiver
 * evaluates the surface at the same (u,v) and verifies XYZ. Catches
 * NURBS reparametrization issues invisible to a volume checksum.
 * In this fixture, the recorded XYZ at (u,v)=(0.5,0.5) is
 * (5.0001, 5.0001, 0.0) but the underlying surface is a plane through
 * the origin with x and y in [0,10], so the truth is (5.0, 5.0, 0.0).
 * The surface was re-fit during translation. */
HEADER;
FILE_DESCRIPTION(('M027 test case','surface sampling point GVP failure'),'2;1');
FILE_NAME('M027.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-7),#10,'distance_accuracy_value','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
     REPRESENTATION_CONTEXT('part','3D'));
/* Plane in z=0. */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=DIRECTION('',(0.0,0.0,1.0));
#102=DIRECTION('',(1.0,0.0,0.0));
#103=AXIS2_PLACEMENT_3D('',#100,#101,#102);
#104=PLANE('test_plane',#103);
/* Product/PD/PDS */
#300=PRODUCT('plane','plane','',(#310));
#310=MECHANICAL_CONTEXT('',#1,'mechanical');
#320=PRODUCT_DEFINITION_FORMATION('','',#300);
#330=PRODUCT_DEFINITION('design','',#320,#340);
#340=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#350=PRODUCT_DEFINITION_SHAPE('','',#330);
/* Shape_aspect on the plane surface for the GVP attachment point. */
#400=SHAPE_ASPECT('plane_surface_aspect','',#350,.T.);
/* Validation property: surface sampling point.
 * Recorded triplet (u, v, XYZ) for a single sample. */
#500=PROPERTY_DEFINITION('geometric validation property',
       'surface sampling point',#400);
#510=COMPOUND_REPRESENTATION_ITEM('uv',
       (REPRESENTATION_ITEM('u_value'), REPRESENTATION_ITEM('v_value')));
/* Use a parameter_value pair and a cartesian point that disagree with
 * the truth. */
#511=REPRESENTATION_ITEM('u'); /* parameter u = 0.5 (recorded) */
#512=REPRESENTATION_ITEM('v'); /* parameter v = 0.5 (recorded) */
/* Defect: recorded XYZ at (0.5,0.5) is offset by 100 microns. */
#520=CARTESIAN_POINT('xyz_at_uv',(5.0001,5.0001,0.0));
#530=REPRESENTATION('sample',(#520),#14);
#540=PROPERTY_DEFINITION_REPRESENTATION(#500,#530);
ENDSEC;
END-ISO-10303-21;
