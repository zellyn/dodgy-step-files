ISO-10303-21;
/* M084: AP209 composite laminate has empty ply stack */
/* DEFECT: LAMINATE_TABLE('skin', (), coord_sys) — empty plies list */
/* Empty ply stack: zero bending stiffness; FEM elements have no material */
/* Byte assertion: contains(b'STRUCTURAL_ANALYSIS_DESIGN') */
/* Byte assertion: contains(b'LAMINATE_TABLE') */
HEADER;
FILE_DESCRIPTION(('M084: AP209 composite laminate with empty ply stack'),'2;1');
FILE_NAME('M084.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'STRUCTURAL_ANALYSIS_DESIGN') */
FILE_SCHEMA(('STRUCTURAL_ANALYSIS_DESIGN { 1 0 10303 209 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('structural_analysis_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'structural_analysis_design',2001,#1);
/* Standard unit context */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('composite','3D'));
/* Placeholder material reference for context */
#100=PROPERTY_DEFINITION('cfrp','carbon-epoxy ply',$);
/* Laminate coordinate system */
#110=LAYERED_2D_ELEMENT_COORDINATE_SYSTEM($);
/* Byte assertion: contains(b'LAMINATE_TABLE') */
/* DEFECT: LAMINATE_TABLE with empty plies list — no plies in the stack */
/* plies=() means zero stiffness; any shell element using 'skin' has no material */
#120=LAMINATE_TABLE('skin',(),#110);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#300=GEOMETRIC_CURVE_SET('ap209-composite-laminate-empty-ply-stack',
  (#100,#110,#120));
/* Product chain */
#400=APPLICATION_CONTEXT('mechanical design');
#401=PRODUCT_CONTEXT('',#400,'mechanical');
#402=PRODUCT('M084','M084','M084',(#401));
#403=PRODUCT_DEFINITION_FORMATION('','',#402);
#404=PRODUCT_DEFINITION_CONTEXT(#400,'design');
#405=PRODUCT_DEFINITION('','',#403,#404);
#406=PRODUCT_DEFINITION_SHAPE('','',#405);
#407=SHAPE_REPRESENTATION('',(#300),#14);
#408=SHAPE_DEFINITION_REPRESENTATION(#406,#407);
ENDSEC;
END-ISO-10303-21;
