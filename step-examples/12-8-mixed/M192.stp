ISO-10303-21;
/* M192: GEOMETRIC_SET of eight bare CARTESIAN_POINTs (cube corners) with NO curves, surfaces, or topology — a pure point cloud delivered where bounded geometry was expected (geometry-completeness defect); every item is a valid geometric_select POINT so OCC transfers cleanly to a COMPOUND of 8 loose vertices — edge==face==solid==0; distinct from M191 (wireframe/curves) and M051 (non-geometric children, crashes); GEOMETRIC_SET IS the model entity — OCC yields a vertex compound, never a solid root */
HEADER;
FILE_DESCRIPTION(('M192'),'2;1');
FILE_NAME('M192.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=CARTESIAN_POINT('',(10.0,0.0,0.0));
#3=CARTESIAN_POINT('',(10.0,10.0,0.0));
#4=CARTESIAN_POINT('',(0.0,10.0,0.0));
#5=CARTESIAN_POINT('',(0.0,0.0,10.0));
#6=CARTESIAN_POINT('',(10.0,0.0,10.0));
#7=CARTESIAN_POINT('',(10.0,10.0,10.0));
#8=CARTESIAN_POINT('',(0.0,10.0,10.0));
#9=GEOMETRIC_SET('cube-corners-point-cloud',(#1,#2,#3,#4,#5,#6,#7,#8));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('M192','M192','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
END-ISO-10303-21;
