ISO-10303-21;
/* M012: AP242 Ed.2 with TESSELLATED_CONSTRUCTIVE_GEOMETRY_REPRESENTATION */
/* DEFECT: TCGR is an AP242 Ed.4 entity; schema declares Ed.2 (442 2 1 4) */
/* Writer scoped to Ed.1-Ed.3 must not emit TCGR; reader must reject */
HEADER;
FILE_DESCRIPTION(('M012: AP242 Ed.2 file with TESSELLATED_CONSTRUCTIVE_GEOMETRY_REPRESENTATION'),'2;1');
FILE_NAME('M012.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 2 1 4 }'));
ENDSEC;
DATA;
/* Standard mm unit context */
#1=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#2=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#3=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#4=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#1,'distance_accuracy_value','');
#5=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#4))GLOBAL_UNIT_ASSIGNED_CONTEXT((#1,#2,#3))REPRESENTATION_CONTEXT('','3D'));
/* Tessellated geometry: two triangles forming a flat quad */
#6=COORDINATES_LIST('tcgr_coords',3,((0.,0.,0.),(10.,0.,0.),(10.,10.,0.),(0.,10.,0.)));
#7=TRIANGULATED_FACE('tcgr_face',#6,$,((.FALSE.,.FALSE.,.FALSE.,.FALSE.)),((0,1,2),(0,2,3)));
#8=TESSELLATED_SOLID('tcgr_solid',(#7));
/* DEFECT ENTITY: TCGR is valid only in AP242 Ed.4+; schema above is Ed.2 */
#9=TESSELLATED_CONSTRUCTIVE_GEOMETRY_REPRESENTATION('tcgr_supplemental',(#8),#5);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#10=GEOMETRIC_CURVE_SET('tcgr-ap242-ed2-schema-violation',(#8,#9));
#9000=APPLICATION_CONTEXT('mechanical design');
#9001=PRODUCT_CONTEXT(#9000,'mechanical','');
#9002=PRODUCT('M012','M012','',(#9001));
#9003=PRODUCT_DEFINITION_FORMATION('','',#9002);
#9004=PRODUCT_DEFINITION_CONTEXT(#9000,'design','part definition');
#9005=PRODUCT_DEFINITION('','',#9003,#9004);
#9006=PRODUCT_DEFINITION_SHAPE('','',#9005);
#9007=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#10),#5);
#9008=SHAPE_DEFINITION_REPRESENTATION(#9006,#9007);
ENDSEC;
END-ISO-10303-21;
