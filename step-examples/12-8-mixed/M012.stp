ISO-10303-21;
/* M012 - tessellated_constructive_geometry_representation requires
 * AP242 Ed.4 but this file declares AP242 Ed.2 schema.
 * Defect: TESSELLATED_CONSTRUCTIVE_GEOMETRY_REPRESENTATION (TCGR) was
 * added in AP242 Ed.4. Files using it under earlier AP242 schemas fail
 * validation. The header here advertises Ed.2 ("ap242 second edition")
 * but the data section instantiates a TCGR. Writers scoped to Ed.1-Ed.3
 * must not emit TCGR; readers must reject under those editions. */
HEADER;
FILE_DESCRIPTION(('M012 test case','TCGR under AP242 Ed.2 schema'),'2;1');
FILE_NAME('M012.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 2 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-6),#10,'distance_accuracy_value','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
     REPRESENTATION_CONTEXT('part','3D'));
/* Tessellated supplemental geometry - a thin reference plane mesh */
#100=COORDINATES_LIST('',4,((0.0,0.0,0.0),(10.0,0.0,0.0),
                            (10.0,10.0,0.0),(0.0,10.0,0.0)));
#110=TRIANGULATED_FACE('reference_plane_mesh',#100,$,$,(),
       ((1,2,3),(1,3,4)));
/* Defect: TCGR is an AP242 Ed.4 entity, but FILE_SCHEMA is Ed.2. */
#200=TESSELLATED_CONSTRUCTIVE_GEOMETRY_REPRESENTATION(
       'supplemental_tessellated',(#110),#14);
ENDSEC;
END-ISO-10303-21;
