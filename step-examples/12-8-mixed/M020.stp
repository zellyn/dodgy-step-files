ISO-10303-21;
/* M020: GEOMETRIC_CURVE_SET containing TESSELLATED_FACE with STYLED_ITEM and COLOUR_RGB referencing it; input: AP242 STEP file where TESSELLATED_FACE (TRIANGULATED_FACE) has an associated STYLED_ITEM with COLOUR_RGB but the style binding is not propagated to a shape binder; OCCT 9d93d9b (Mantis 0033638): no TransferBRep_ShapeBinder created for tessellated face style; color silently lost on import; kernel must heal: bind STYLED_ITEM color to tessellated shape; preserve color; must not silently lose color; OCC silently accepts (no diagnostic, empty result); GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty; synonyms: tessellated face style binding lost, TransferBRep_ShapeBinder not created, complex triangulated face has no style, tessellated face color not bound */
HEADER;
FILE_DESCRIPTION(('M020'),'2;1');
FILE_NAME('M020.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=COORDINATES_LIST('tface_verts',3,((0.,0.,0.),(8.,0.,0.),(8.,8.,0.),(0.,8.,0.)));
#2=TRIANGULATED_FACE('tface_quad',#1,$,((.FALSE.,.FALSE.,.FALSE.,.FALSE.)),((0,1,2),(0,2,3)));
#3=COLOUR_RGB('face_colour',0.2,0.6,0.9);
#4=FILL_AREA_STYLE_COLOUR('',#3);
#5=FILL_AREA_STYLE('face_fill',(#4));
#6=SURFACE_STYLE_FILL_AREA(#5);
#7=SURFACE_SIDE_STYLE('face_side_style',(#6));
#8=SURFACE_STYLE_USAGE(.BOTH.,#7);
#9=PRESENTATION_STYLE_ASSIGNMENT((#8));
#10=STYLED_ITEM('tface_styled',(#9),#2);
#11=GEOMETRIC_CURVE_SET('tessellated-face-style-binding-lost',(#2,#10));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('M020','M020','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#11),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
END-ISO-10303-21;
