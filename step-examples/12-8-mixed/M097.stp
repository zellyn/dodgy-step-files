ISO-10303-21;
/* M097: AP238 workingstep references a feature not on the workpiece */
/* DEFECT: MACHINING_WORKINGSTEP its_feature belongs to WORKPIECE B, not WORKPIECE A */
/* Setup mounts workpiece A; feature 'slot_on_b' lives on workpiece B */
/* Controller executes toolpath against wrong workpiece coordinate frame — tool crash */
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
/* Byte assertion: contains(b'MACHINING_WORKINGSTEP') */
/* Byte assertion: count_entity_def(b'WORKPIECE') >= 2 */
HEADER;
FILE_DESCRIPTION(('M097: AP238 WORKINGSTEP feature on wrong workpiece'),'2;1');
FILE_NAME('M097.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('step_nc_mim');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap238_step_nc_mim',2007,#1);
/* Standard unit context — mm */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('nc','3D'));
/* Byte assertion: count_entity_def(b'WORKPIECE') >= 2 */
/* WORKPIECE A: the part mounted in the fixture — setup machines this one */
#20=WORKPIECE('workpiece_A',(#14),$,$,$,$,$);
/* WORKPIECE B: a different part from the shared feature library */
#21=WORKPIECE('workpiece_B',(#14),$,$,$,$,$);
/* MACHINED_FEATURE on workpiece B — the feature the publisher accidentally linked */
#50=MACHINED_FEATURE('slot_on_b',$,$,$,$,$);
/* MACHINED_FEATURE on workpiece A — the correct feature for this setup */
#55=MACHINED_FEATURE('slot_on_a',$,$,$,$,$);
/* Setup placement and SETUP mounting workpiece A */
#60=AXIS2_PLACEMENT_3D('fixture_origin',CARTESIAN_POINT('',(0.,0.,0.)),
  DIRECTION('',(0.,0.,1.)),$);
#61=SETUP('fixture_a',#60,(#20),$);
/* Machining tool */
#70=MACHINING_TOOL('endmill_6mm',$,$,$);
/* Machining operation targeting slot_on_b (workpiece B's feature) */
#75=MACHINING_OPERATION('mill_slot_a',#70,$,$,$,$,$,$,#50,$,$);
/* Byte assertion: contains(b'MACHINING_WORKINGSTEP') */
/* DEFECT: MACHINING_WORKINGSTEP its_feature = #50 ('slot_on_b') from WORKPIECE B */
/* Setup #61 mounts WORKPIECE A; the feature must be on WORKPIECE A (e.g. #55) */
/* Referencing #50 from WORKPIECE B causes toolpath to target wrong coordinate frame */
#80=MACHINING_WORKINGSTEP('step_a',#50,#75,$);
#90=WORKPLAN('main',(#80),$,$,$);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#300=GEOMETRIC_CURVE_SET('ap238-workingstep-feature-on-wrong-workpiece',
  (#20,#21,#50,#55,#61,#70,#75,#80,#90));
/* Product chain */
#400=APPLICATION_CONTEXT('mechanical design');
#401=PRODUCT_CONTEXT('',#400,'mechanical');
#402=PRODUCT('M097','M097','M097',(#401));
#403=PRODUCT_DEFINITION_FORMATION('','',#402);
#404=PRODUCT_DEFINITION_CONTEXT(#400,'design');
#405=PRODUCT_DEFINITION('','',#403,#404);
#406=PRODUCT_DEFINITION_SHAPE('','',#405);
#407=SHAPE_REPRESENTATION('',(#300),#14);
#408=SHAPE_DEFINITION_REPRESENTATION(#406,#407);
ENDSEC;
END-ISO-10303-21;
