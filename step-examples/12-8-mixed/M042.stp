ISO-10303-21;
/* M042: GEOMETRIC_CURVE_SET containing assembly with STYLED_ITEM color override on root product label, plus NEXT_ASSEMBLY_USAGE_OCCURRENCE sub-shape; input: AP242 STEP file where a color is attached to the root product via STYLED_ITEM on the top-level shape; OCCT d7d89ac (Mantis 0032977): OCCT 7.5/7.6 regression — color on root label was dropped during traversal, losing the override for all instances; kernel must honor root-level color overrides and propagate through assembly/part/instance hierarchy; OCC silently accepts (no diagnostic, empty result); GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty; synonyms: root color override lost, color regression OCCT 7.5, STEP color at root not applied, label color override dropped */
HEADER;
FILE_DESCRIPTION(('M042'),'2;1');
FILE_NAME('M042.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=COLOUR_RGB('root_override_color',0.8,0.2,0.1);
#2=FILL_AREA_STYLE('root_fill',(#1));
#3=SURFACE_STYLE_FILL_AREA(#2);
#4=SURFACE_SIDE_STYLE('root_side',(#3));
#5=SURFACE_STYLE_USAGE(.BOTH.,#4);
#6=PRESENTATION_STYLE_ASSIGNMENT((#5));
#7=CARTESIAN_POINT('root_origin',(0.,0.,0.));
#8=DIRECTION('root_z',(0.,0.,1.));
#9=DIRECTION('root_x',(1.,0.,0.));
#10=AXIS2_PLACEMENT_3D('root_placement',#7,#8,#9);
#11=STYLED_ITEM('root_label_color_override',(#6),$);
#12=PRODUCT_DEFINITION('root_assembly','root product definition',$,$);
#13=PRODUCT_DEFINITION('child_part','child part definition',$,$);
#14=NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','child instance in root','',#12,#13,$);
#15=CARTESIAN_POINT('child_origin',(5.,0.,0.));
#16=DIRECTION('child_z',(0.,0.,1.));
#17=DIRECTION('child_x',(1.,0.,0.));
#18=AXIS2_PLACEMENT_3D('child_placement',#15,#16,#17);
#19=GEOMETRIC_CURVE_SET('root-label-color-override-lost',(#11,#14,#1,#10,#18));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('M042','M042','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#19),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
END-ISO-10303-21;
