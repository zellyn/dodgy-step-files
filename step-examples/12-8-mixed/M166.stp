ISO-10303-21;
/* M166 - Heatsink-style fin array crashes export pipeline at faceted
 * sub-shape boundary.
 * Defect (FreeCAD #18524): fin pairs are emitted with FACE_OUTER_BOUND
 * orientation .F. while the surface normal direction is also flipped --
 * double-flip cancels visually but produces wrong sign on volume
 * integral. */
HEADER;
FILE_DESCRIPTION(('M166 - fin array with double-flipped face orientation'),'2;1');
FILE_NAME('M166.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('M166_heatsink','fin array','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('frame_a',#20,#21,#22);
#24=CARTESIAN_POINT('',(0.0,1.0,0.0));
#25=AXIS2_PLACEMENT_3D('frame_b',#24,#21,#22);
#26=CARTESIAN_POINT('',(0.0,2.0,0.0));
#27=AXIS2_PLACEMENT_3D('frame_c',#26,#21,#22);
#30=PLANE('fin_a_face',#23);
#31=PLANE('fin_b_face',#25);
#32=PLANE('fin_c_face',#27);
#33=FACE_OUTER_BOUND('fin_a_outer',#34,.T.);
/* Defect: FACE_OUTER_BOUND orientation .F. on fin B, paired with the
   surface normal flipped (encoded by the .F. on the ADVANCED_FACE
   below). Double-flip leaves the rendered face looking correct but
   makes volume integration fail. */
#34=EDGE_LOOP('',());
#35=FACE_OUTER_BOUND('fin_b_outer_FALSE',#34,.F.);
#36=FACE_OUTER_BOUND('fin_c_outer',#34,.T.);
#40=ADVANCED_FACE('fin_a',(#33),#30,.T.);
#41=ADVANCED_FACE('fin_b_double_flip',(#35),#31,.F.);
#42=ADVANCED_FACE('fin_c',(#36),#32,.T.);
#50=CLOSED_SHELL('a_shell',(#40)); #51=MANIFOLD_SOLID_BREP('fin_a',#50);
#52=CLOSED_SHELL('b_shell',(#41)); #53=MANIFOLD_SOLID_BREP('fin_b',#52);
#54=CLOSED_SHELL('c_shell',(#42)); #55=MANIFOLD_SOLID_BREP('fin_c',#54);
#60=SHAPE_REPRESENTATION('M166_repr',(#23,#25,#27,#51,#53,#55),#14);
#61=SHAPE_DEFINITION_REPRESENTATION(#8,#60);
ENDSEC;
END-ISO-10303-21;
