ISO-10303-21;
/* M189 - AP238 BORING with tool diameter declared as zero or negative.
 * Defect: a BORING_TOOL's diameter MEASURE_WITH_UNIT carries a
 * negative value (-12.0 mm). The controller either rejects the file
 * or computes a negative-radius offset toolpath, sending the boring
 * bar in the wrong direction. */
HEADER;
FILE_DESCRIPTION(('M189 test case','AP238 boring tool diameter negative'),'2;1');
FILE_NAME('M189.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 1 0 0 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('numerical_control_machining');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'numerical_control_machining',2007,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10))
     REPRESENTATION_CONTEXT('nc','3D'));
/* Defect: BORING_TOOL diameter = -12.0 mm (negative length). */
#80=MEASURE_WITH_UNIT(LENGTH_MEASURE(-12.0),#10);
#90=BORING_TOOL('bad_bar',$,$,$,#80);
#100=BORING_OPERATION('bore_op',$,$,$,$,$,#90);
#200=WORKPLAN('main',(#100),$,$,$);
ENDSEC;
END-ISO-10303-21;
