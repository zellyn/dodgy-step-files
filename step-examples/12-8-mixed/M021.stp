#6=TESSELLATED_ANNOTATION_OCCURRENCE('diameter_tolerance',(#5),$);
#7=GEOMETRIC_CURVE_SET('tessellated-annotation-occurrence-unrecognized',(#6,#5));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('M021','M021','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
