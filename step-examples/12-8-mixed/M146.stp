ISO-10303-21;
/* M146: AP210 drill diameter exceeds pad diameter (annular ring inverted) */
/* DEFECT: VIA_DEFINITION drill_diameter=0.5 mm > pad_diameter=0.3 mm */
/* The drilled hole is wider than the copper pad — no annular ring exists */
/* The via cannot be electrically connected; IPC-2222 annular ring rule violated */
/* Per ISO 10303-210 §6 drill_diameter must be < pad_diameter */
/* Byte assertion: contains(b'ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN') */
/* Byte assertion: contains(b'VIA_DEFINITION') */
/* Byte assertion: contains(b'pad_diameter') */
HEADER;
FILE_DESCRIPTION(('M146: AP210 drill diameter exceeds pad diameter'),'2;1');
FILE_NAME('M146.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN') */
FILE_SCHEMA(('ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN { 1 0 10303 210 3 1 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('electronic_assembly_interconnect_and_packaging_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'electronic_assembly_interconnect_and_packaging_design',2014,#1);
/* Standard unit context (mm) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('pcb','3D'));
/* Via drill axis at board position (10.0, 10.0, 0.0) */
#100=CARTESIAN_POINT('via_loc',(10.0,10.0,0.0));
#101=AXIS2_PLACEMENT_3D('via_axis',#100,$,$);
/* Byte assertion: contains(b'VIA_DEFINITION') */
/* DEFECT: drill_diameter=0.5 mm is larger than pad_diameter=0.3 mm */
/* Annular ring = (0.3 - 0.5) / 2 = -0.1 mm — negative, no copper ring */
#110=VIA_DEFINITION('inverted_via',$,#101,LENGTH_MEASURE(0.5));
/* Byte assertion: contains(b'pad_diameter') */
/* PROPERTY_DEFINITION declares pad_diameter = 0.3 mm for this via */
#120=PROPERTY_DEFINITION('pad_diameter','Pad outer diameter for via_a',#110);
#121=MEASURE_REPRESENTATION_ITEM('pad_diameter',LENGTH_MEASURE(0.3),#10);
#122=REPRESENTATION('pad_dims',(#121),#14);
#123=PROPERTY_DEFINITION_REPRESENTATION(#120,#122);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#300=GEOMETRIC_CURVE_SET('ap210-drill-diameter-exceeds-pad-diameter-annular-ring-inverted',
  (#100,#101,#110,#120,#121,#122,#123));
/* Product chain */
#400=APPLICATION_CONTEXT('mechanical design');
#401=PRODUCT_CONTEXT('',#400,'mechanical');
#402=PRODUCT('M146','M146','M146',(#401));
#403=PRODUCT_DEFINITION_FORMATION('','',#402);
#404=PRODUCT_DEFINITION_CONTEXT(#400,'design');
#405=PRODUCT_DEFINITION('','',#403,#404);
#406=PRODUCT_DEFINITION_SHAPE('','',#405);
#407=SHAPE_REPRESENTATION('',(#300),#14);
#408=SHAPE_DEFINITION_REPRESENTATION(#406,#407);
ENDSEC;
END-ISO-10303-21;
