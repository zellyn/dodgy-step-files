ISO-10303-21;
/* M162 - Fillet faces re-import as rounded edge (Onshape/Rhino) but as
 * fillet in producer.
 * Defect (FreeCAD #20889): writer emits the fillet as a B_SPLINE_SURFACE
 * cubic patch instead of an analytical TOROIDAL_SURFACE. Receivers that
 * use surface-type as a feature-classification cue (Onshape, Rhino)
 * lose the fillet category. */
HEADER;
FILE_DESCRIPTION(('M162 - fillet emitted as B-spline instead of torus'),'2;1');
FILE_NAME('M162.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('M162_fillet','fillet as bspline','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
/* Placeholder edge_loop used for outer bounds (geometry intentionally
   minimal; the defect is the surface-type choice for the fillet, not
   the loop content). */
#24=EDGE_LOOP('placeholder',());
#25=FACE_OUTER_BOUND('placeholder',#24,.T.);
/* Plane (the box top) -- present so the test still recognises both
   PLANE and CYLINDRICAL_SURFACE plus the B-spline fillet patch. */
#30=PLANE('box_top',#23);
#31=ADVANCED_FACE('box_top',(#25),#30,.T.);
/* Cylindrical surface (the cylinder side) */
#40=CYLINDRICAL_SURFACE('cyl_side',#23,5.0);
#41=ADVANCED_FACE('cyl_side',(#25),#40,.T.);
/* Defect: the fillet between #30 and #40 is encoded as a cubic
   B_SPLINE_SURFACE_WITH_KNOTS instead of TOROIDAL_SURFACE. */
#50=CARTESIAN_POINT('cp00',(0.0,0.0,0.0));
#51=CARTESIAN_POINT('cp01',(1.0,0.0,0.0));
#52=CARTESIAN_POINT('cp02',(2.0,0.0,0.0));
#53=CARTESIAN_POINT('cp10',(0.0,1.0,0.5));
#54=CARTESIAN_POINT('cp11',(1.0,1.0,0.5));
#55=CARTESIAN_POINT('cp12',(2.0,1.0,0.5));
#56=CARTESIAN_POINT('cp20',(0.0,2.0,1.0));
#57=CARTESIAN_POINT('cp21',(1.0,2.0,1.0));
#58=CARTESIAN_POINT('cp22',(2.0,2.0,1.0));
#60=B_SPLINE_SURFACE_WITH_KNOTS('fillet_as_bspline',2,2,
        ((#50,#51,#52),(#53,#54,#55),(#56,#57,#58)),
        .UNSPECIFIED.,.F.,.F.,.F.,
        (3,3),(3,3),(0.0,1.0),(0.0,1.0),.UNSPECIFIED.);
#61=ADVANCED_FACE('fillet_face',(#25),#60,.T.);
#70=CLOSED_SHELL('shell',(#31,#41,#61));
#71=MANIFOLD_SOLID_BREP('M162_body',#70);
#80=SHAPE_REPRESENTATION('M162_repr',(#23,#71),#14);
#81=SHAPE_DEFINITION_REPRESENTATION(#8,#80);
ENDSEC;
END-ISO-10303-21;
