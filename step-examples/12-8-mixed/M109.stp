ISO-10303-21;
/* M109 - AP209 linear_hexahedron with only 4 nodes (should be 8).
 * Defect: a VOLUME_3D_ELEMENT_DESCRIPTOR declares linear_hexahedron
 * topology (8 corner nodes mandated) but lists only 4. The element
 * cannot be evaluated as a hex; consumers either drop it or treat
 * as a degenerate tet. */
HEADER;
FILE_DESCRIPTION(('M109 test case','AP209 linear_hexahedron with 4 nodes'),'2;1');
FILE_NAME('M109.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('STRUCTURAL_ANALYSIS_DESIGN { 1 0 10303 209 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('structural_analysis_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'structural_analysis_design',2001,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-6),#10,'distance_accuracy_value','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11))
     REPRESENTATION_CONTEXT('fea','3D'));
#100=CARTESIAN_POINT('n1',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('n2',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('n3',(1.0,1.0,0.0));
#103=CARTESIAN_POINT('n4',(0.0,1.0,0.0));
#110=NODE('n1',(#100),$);
#111=NODE('n2',(#101),$);
#112=NODE('n3',(#102),$);
#113=NODE('n4',(#103),$);
/* Defect: declares linear_hexahedron but lists only 4 nodes. */
#200=VOLUME_3D_ELEMENT_DESCRIPTOR('lin_hex','linear_hexahedron',
       (#110,#111,#112,#113));
ENDSEC;
END-ISO-10303-21;
