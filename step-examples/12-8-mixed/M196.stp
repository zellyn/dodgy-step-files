ISO-10303-21;
/* M196: GEOMETRIC_CURVE_SET mixing a supported item (CIRCLE, a StepGeom_Curve) with a generic GeometricRepresentationItem (AXIS2_PLACEMENT_3D, none of curve/point/surface) in one items list; input: AP242/AP214 file whose bare GEOMETRIC_SET aggregates heterogeneous geometric_set_select members -- StepToTopoDS_Builder::Init(GeometricSet) dispatches each item by type: the CIRCLE hits the StepGeom_Curve branch and is translated to a live edge; the AXIS2_PLACEMENT_3D matches none of curve/point/surface, falls through to the generic GeometricRepresentationItem fallback (routed through STEPControl_ActorRead::TransferShape), which has no recognized translation for a bare placement entity and produces no shape, silently skipped with only a warning; the mixed set therefore yields exactly the circle's edge, nothing from the placement; mirrors M051 (which used an unbounded LINE for the supported item) fixed per design note: M051's crash (occt=signal(11)) is independently reproducible with ANY bare, untrimmed LINE inside a GEOMETRIC_CURVE_SET regardless of what else shares the set (isolated live: LINE-only set crashes identically to the LINE+AXIS2_PLACEMENT_3D mix; CIRCLE-only and CIRCLE+AXIS2_PLACEMENT_3D both load cleanly) -- the crash trigger is StepToGeom::MakeCurve on an infinite Geom_Line reaching BRepBuilderAPI_MakeEdge with unbounded parameters in this pinned build, an unrelated bug, not the mixed-item dispatch mechanism this fixture targets; using a bounded/periodic CIRCLE isolates the dispatch-skip behavior cleanly; covers stp-geomset-gri-fallback; synonyms: geometric set mixed item type dispatch, unsupported representation item silently skipped in geometric set, AXIS2_PLACEMENT_3D routed to generic actor fallback, bare placement entity in geometric curve set produces no shape */
HEADER;
FILE_DESCRIPTION(('M196'),'2;1');
FILE_NAME('M196.stp','2026-07-12T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('circ_center',(0.,0.,0.));
#2=DIRECTION('circ_z',(0.,0.,1.));
#3=DIRECTION('circ_x',(1.,0.,0.));
#4=AXIS2_PLACEMENT_3D('circ_ax',#1,#2,#3);
#5=CIRCLE('supported_curve_item',#4,5.);
#6=CARTESIAN_POINT('placement_origin',(10.,0.,0.));
#7=DIRECTION('placement_z',(0.,0.,1.));
#8=DIRECTION('placement_x',(1.,0.,0.));
#9=AXIS2_PLACEMENT_3D('unsupported_gri_fallback_item',#6,#7,#8);
#10=GEOMETRIC_CURVE_SET('mixed-supported-curve-and-generic-gri',(#5,#9));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('M196','M196','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#10),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
END-ISO-10303-21;
