ISO-10303-21;
/* M128 - AP203 design approved AFTER its effectivity start date.
 * Defect: an APPROVAL_DATE_TIME on a PRODUCT_DEFINITION_FORMATION is
 * 2024-09-15 but the EFFECTIVITY for that revision starts 2024-06-01.
 * The configuration was effective in the field for ~3 months before
 * its design was formally approved - a process violation. */
HEADER;
FILE_DESCRIPTION(('M128 test case','AP203 approval after effectivity start'),'2;1');
FILE_NAME('M128.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('configuration controlled 3D design of mechanical parts and assemblies');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','config_control_design',1994,#1);
#10=PRODUCT('clamp_assembly','clamp_assembly','rev B',(#1));
#11=PRODUCT_DEFINITION_FORMATION('rev_B','released revision',#10);
#20=APPROVAL_STATUS('approved');
#21=APPROVAL('approval_B',#20);
/* Defect: approval timestamp 2024-09-15 is AFTER effectivity start 2024-06-01. */
#30=DATE_AND_TIME(CALENDAR_DATE(2024,9,15),LOCAL_TIME(10,30,0.0,$));
#31=DATE_AND_TIME(CALENDAR_DATE(2024,6,1),LOCAL_TIME(0,0,0.0,$));
#32=DATE_AND_TIME(CALENDAR_DATE(2025,6,1),LOCAL_TIME(0,0,0.0,$));
#100=APPROVAL_DATE_TIME(#30,'approval_logged',#21);
#101=TIME_INTERVAL_BASED_EFFECTIVITY('rev_B_in_field',#11,#31,#32);
ENDSEC;
END-ISO-10303-21;
