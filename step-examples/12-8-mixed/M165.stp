#25=DIRECTION('',(1.0,0.0,0.0));
#26=AXIS2_PLACEMENT_3D('',#23,#24,#25);
#27=PLANE('',#26);
#28=FACE_OUTER_BOUND('',#22,.T.);
#29=ADVANCED_FACE('sliver_face_1',(#28),#27,.T.);
#30=ADVANCED_FACE('sliver_face_2',(#28),#27,.T.);
#31=ADVANCED_FACE('sliver_face_3',(#28),#27,.T.);
#32=ADVANCED_FACE('outer_bound_face',(#28),#27,.T.);
#33=CLOSED_SHELL('knurl_shell',(#29,#30,#31,#32));
#34=MANIFOLD_SOLID_BREP('M165_knurl_body',#33);
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('M165','M165','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
