#14=VECTOR('',#13,1.0);
#15=LINE('',#1,#14);
#16=EDGE_CURVE('',#7,#8,#15,.T.);
#17=EDGE_CURVE('',#8,#9,#15,.T.);
#18=EDGE_CURVE('',#9,#7,#15,.T.);
#19=ORIENTED_EDGE('',$,$,#16,.T.);
#20=ORIENTED_EDGE('',$,$,#17,.T.);
#21=ORIENTED_EDGE('',$,$,#18,.T.);
#22=EDGE_LOOP('',(#19,#20,#21));
#23=CARTESIAN_POINT('',(0.0,0.0,0.0));
