ISO-10303-21;
/* M165 - Knurled body exports STEP with holes (slicer reports
 * non-manifold).
 * Defect (FreeCAD #16320): dense small triangular faces on a knurled
 * cylinder are below the receiver's prune threshold; the rendered
 * surface has visible holes where they were dropped. */
HEADER;
FILE_DESCRIPTION(('M165 - dense sub-tolerance triangular faces (knurl pattern)'),'2;1');
FILE_NAME('M165.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('M165_knurl','dense slivers','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
#20=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('p1',(0.0005,0.0,0.0));
#22=CARTESIAN_POINT('p2',(0.0003,0.0005,0.0));
#23=CARTESIAN_POINT('p3',(0.001,0.0,0.0));
#24=CARTESIAN_POINT('p4',(0.0008,0.0005,0.0));
#25=CARTESIAN_POINT('p5',(0.0015,0.0,0.0));
#26=VERTEX_POINT('',#20); #27=VERTEX_POINT('',#21); #28=VERTEX_POINT('',#22);
#29=VERTEX_POINT('',#23); #30=VERTEX_POINT('',#24); #31=VERTEX_POINT('',#25);
#32=DIRECTION('',(1.0,0.0,0.0));
#33=VECTOR('',#32,1.0);
#34=LINE('',#20,#33);
/* Three sub-tolerance triangular faces (each well below 1.0e-3 mm side) --
   dense sliver cluster typical of a knurl pattern at low tessellation. */
#40=EDGE_CURVE('',#26,#27,#34,.T.);
#41=EDGE_CURVE('',#27,#28,#34,.T.);
#42=EDGE_CURVE('',#28,#26,#34,.T.);
#43=ORIENTED_EDGE('',*,*,#40,.T.);
#44=ORIENTED_EDGE('',*,*,#41,.T.);
#45=ORIENTED_EDGE('',*,*,#42,.T.);
#46=EDGE_LOOP('sliver1',(#43,#44,#45));
#50=CARTESIAN_POINT('',(0.0,0.0,0.0));
#51=DIRECTION('',(0.0,0.0,1.0));
#52=DIRECTION('',(1.0,0.0,0.0));
#53=AXIS2_PLACEMENT_3D('',#50,#51,#52);
#54=PLANE('',#53);
#55=FACE_OUTER_BOUND('',#46,.T.);
#56=ADVANCED_FACE('sliver_face_1',(#55),#54,.T.);
#57=ADVANCED_FACE('sliver_face_2',(#55),#54,.T.);
#58=ADVANCED_FACE('sliver_face_3',(#55),#54,.T.);
#59=ADVANCED_FACE('outer_bound_face',(#55),#54,.T.);
#60=CLOSED_SHELL('knurl_shell',(#56,#57,#58,#59));
#61=MANIFOLD_SOLID_BREP('M165_knurl_body',#60);
#70=SHAPE_REPRESENTATION('M165_repr',(#53,#61),#14);
#71=SHAPE_DEFINITION_REPRESENTATION(#8,#70);
ENDSEC;
END-ISO-10303-21;
