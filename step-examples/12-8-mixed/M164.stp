ISO-10303-21;
/* M164 - Linear pattern of arc-shaped feature emits twisted/corrupted
 * faces in STEP.
 * Defect (FreeCAD #12176): the 4th instance of a 4-count LinearPattern
 * has its axis direction inverted (DIRECTION (0,0,-1) instead of
 * (0,0,1)) -- sign-bit overflow in the pattern transform table. */
HEADER;
FILE_DESCRIPTION(('M164 - 4-count LinearPattern with inverted 4th instance'),'2;1');
FILE_NAME('M164.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('M164_pattern','linear pattern bug','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
/* Master arc-shaped Pad: planar face under a placement. */
#20=CARTESIAN_POINT('m_origin',(0.0,0.0,0.0));
#21=DIRECTION('m_z',(0.0,0.0,1.0));
#22=DIRECTION('m_x',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('master_frame',#20,#21,#22);
#90=EDGE_LOOP('placeholder',());
#91=FACE_OUTER_BOUND('placeholder',#90,.T.);
#24=PLANE('master_face',#23);
#25=ADVANCED_FACE('master',(#91),#24,.T.);
#26=CLOSED_SHELL('master_shell',(#25));
#27=MANIFOLD_SOLID_BREP('master_arc',#26);
#28=REPRESENTATION_MAP(#23,#29);
#29=SHAPE_REPRESENTATION('master',(#23,#27),#14);
/* 4 LinearPattern instances. Instances 1-3 use DIRECTION (0,0,1);
   instance 4 deliberately uses DIRECTION (0,0,-1) -- inverted axis. */
#30=CARTESIAN_POINT('inst1_o',(10.0,0.0,0.0));
#31=DIRECTION('z_pos',(0.0,0.0,1.0));
#32=DIRECTION('x_ref',(1.0,0.0,0.0));
#33=AXIS2_PLACEMENT_3D('inst1_frame',#30,#31,#32);
#34=MAPPED_ITEM('inst1',#28,#33);
#40=CARTESIAN_POINT('inst2_o',(20.0,0.0,0.0));
#41=AXIS2_PLACEMENT_3D('inst2_frame',#40,#31,#32);
#42=MAPPED_ITEM('inst2',#28,#41);
#50=CARTESIAN_POINT('inst3_o',(30.0,0.0,0.0));
#51=AXIS2_PLACEMENT_3D('inst3_frame',#50,#31,#32);
#52=MAPPED_ITEM('inst3',#28,#51);
#60=CARTESIAN_POINT('inst4_o',(40.0,0.0,0.0));
#61=DIRECTION('z_neg',(0.0,0.0,-1.0));
#62=AXIS2_PLACEMENT_3D('inst4_frame_INVERTED',#60,#61,#32);
#63=MAPPED_ITEM('inst4_inverted',#28,#62);
#70=SHAPE_REPRESENTATION('M164_pattern_repr',(#33,#41,#51,#62,#34,#42,#52,#63),#14);
#71=SHAPE_DEFINITION_REPRESENTATION(#8,#70);
ENDSEC;
END-ISO-10303-21;
