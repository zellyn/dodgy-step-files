ISO-10303-21;
/* M108: AP238 freeform_milling_operation without surface-tolerance attribute */
/* DEFECT: FREEFORM_MILLING_OPERATION has all tolerance attributes set to $ */
/* No chord-tolerance or scallop-height — surface finish quality unspecified */
/* Violates ISO 10303-238 §5.8 freeform_milling_operation surface-tolerance requirement */
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
/* Byte assertion: contains(b'FREEFORM_MILLING_OPERATION') */
HEADER;
FILE_DESCRIPTION(('M108: AP238 freeform milling operation missing surface tolerance'),'2;1');
FILE_NAME('M108.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('step_nc_mim');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap238_step_nc_mim',2007,#1);
/* Standard unit context — mm */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('nc','3D'));
/* Target machined feature — a freeform (sculptured) surface area */
#50=MACHINED_FEATURE('freeform_surface_a',$,$,$,$,$);
/* 6mm ball-end mill for freeform 5-axis milling — requires a tolerance to drive step-over */
#60=MACHINING_TOOL('ballmill_6mm',$,$,$);
/* Byte assertion: contains(b'FREEFORM_MILLING_OPERATION') */
/* DEFECT: all tolerance / quality attributes are $ (absent) */
/* chord_tolerance=$, scallop_height=$, surface_deviation=$, quality_standard=$ */
/* Without any tolerance the CAM consumer cannot compute correct step-over distance *)  */
#70=FREEFORM_MILLING_OPERATION('op_freeform',#60,$,$,$,$,$,$,#50,$,$);
#80=MACHINING_WORKINGSTEP('step_freeform',#50,#70,$);
#90=WORKPLAN('main',(#80),$,$,$);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#300=GEOMETRIC_CURVE_SET('ap238-freeform-milling-no-surface-tolerance',
  (#50,#60,#70,#80,#90));
/* Product chain */
#400=APPLICATION_CONTEXT('mechanical design');
#401=PRODUCT_CONTEXT('',#400,'mechanical');
#402=PRODUCT('M108','M108','M108',(#401));
#403=PRODUCT_DEFINITION_FORMATION('','',#402);
#404=PRODUCT_DEFINITION_CONTEXT(#400,'design');
#405=PRODUCT_DEFINITION('','',#403,#404);
#406=PRODUCT_DEFINITION_SHAPE('','',#405);
#407=SHAPE_REPRESENTATION('',(#300),#14);
#408=SHAPE_DEFINITION_REPRESENTATION(#406,#407);
ENDSEC;
END-ISO-10303-21;
