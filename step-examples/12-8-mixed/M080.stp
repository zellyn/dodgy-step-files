ISO-10303-21;
/* M080 - AP209 material property unit mismatch.
 * Defect: an ELASTICITY (Young's modulus) is stated with a unit whose
 * dimensional_exponents are (length, mass, time) = (-1, 1, -2) (pressure)
 * but the numeric value 200000.0 is the canonical mm-MPa value. The
 * file's representation_context declares SI base units (Pa = N/m^2);
 * imported as Pa, the modulus is 200 kPa instead of 200 GPa, and the
 * resulting analysis is 1e6x too soft. */
HEADER;
FILE_DESCRIPTION(('M080 test case','AP209 material property unit mismatch'),'2;1');
FILE_NAME('M080.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('STRUCTURAL_ANALYSIS_DESIGN { 1 0 10303 209 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('structural_analysis_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'structural_analysis_design',2001,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT($,.METRE.));
#11=(MASS_UNIT()NAMED_UNIT(*)SI_UNIT(.KILO.,.GRAM.));
#12=(NAMED_UNIT(*)SI_UNIT($,.SECOND.)TIME_UNIT());
#13=DIMENSIONAL_EXPONENTS(-1.0,1.0,-2.0,0.0,0.0,0.0,0.0);
#14=DERIVED_UNIT_ELEMENT(#10,-1.0);
#15=DERIVED_UNIT_ELEMENT(#11,1.0);
#16=DERIVED_UNIT_ELEMENT(#12,-2.0);
#17=DERIVED_UNIT((#14,#15,#16));
#20=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
     REPRESENTATION_CONTEXT('analysis','3D'));
/* Defect: Steel modulus declared as 200000.0 in unit-context that is
 * Pascals. Steel modulus is 200 GPa = 2e11 Pa. This is 1e6 too small. */
#100=MEASURE_WITH_UNIT(POSITIVE_RATIO_MEASURE(200000.0),#17);
#110=GENERAL_PROPERTY('Youngs_Modulus','Youngs_Modulus','steel');
#120=PROPERTY_DEFINITION('Youngs_Modulus_def','',#110);
ENDSEC;
END-ISO-10303-21;
