ISO-10303-21;
/* Os023 - Thicken passes through a self-intersection.
 * Defect: small cylindrical hole radius 5 mm in a plate; inward
 * thickening of 10 mm causes inner offset surfaces to collide. */
HEADER;
FILE_DESCRIPTION(('Os023 - thicken self-intersects','Pass C gap-fill'),'2;1');
FILE_NAME('Os023.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('hole_axis',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=CYLINDRICAL_SURFACE('hole_r5',#13,5.0);
/* Thickening request: inward by 10mm - hole_diameter is 10mm so collision.
 * Operation parameter encoded as MEASURE_WITH_UNIT in DATA. */
#20=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#21=MEASURE_WITH_UNIT(LENGTH_MEASURE(-10.0),#20);
ENDSEC;
END-ISO-10303-21;
