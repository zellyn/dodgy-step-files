ISO-10303-21;
/* M195: TESSELLATED_SOLID whose geometric_link references a real MANIFOLD_SOLID_BREP entity (#39, own CLOSED_SHELL/ADVANCED_FACE geometry) that is never itself wired into a shape representation reachable from the model; input: AP242 file where a tessellated solid declares an exact-BRep counterpart the reader transfer graph never visits, so the geometric_link entity is syntactically present but never bound in the transient-process map; wired as a direct shape_representation item (own COORDINATES_LIST, no GEOMETRIC_CURVE_SET wrapper) per the M193 finding that the GEOMETRIC_SET GRI-fallback path crashes OCCT independent of link content; StepToTopoDS_TranslateSolid.cxx:67-82 checks theTSo->HasGeometricLink() && theTP->IsBound(theTSo->GeometricLink()) before looking up the binder, finds the link unbound, and falls back to a fresh TopoDS_Shell + TopoDS_Solid built from the solid own tessellated items with theHasGeom cleared; covers stp-tess-dangling-brep-link (solid subvariant); mirrors Tsh065 (whose TESSELLATED_SHELL_REPRESENTATION is a dead scaffold never reached from the file's actual SHELL_BASED_SURFACE_MODEL shape representation) fixed by making the tessellated construct itself the live, reachable shape and giving it a genuinely unresolvable geometric_link; synonyms: tessellated solid dangling geometric_link, unresolved exact-BRep solid counterpart, fresh shell plus solid on unbound link, TESSELLATED_SOLID geometric_link unbound */
HEADER;
FILE_DESCRIPTION(('M195'),'2;1');
FILE_NAME('M195.stp','2026-07-12T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
