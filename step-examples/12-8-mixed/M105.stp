ISO-10303-21;
/* M105 - AP238 ISO 8601 timestamps on operations going backwards.
 * Defect: two MACHINING_OPERATIONs in workplan order carry timestamps
 * '2026-04-30T10:00:00' (op A) and '2026-04-30T09:00:00' (op B),
 * monotonically DECREASING along the executable order. */
HEADER;
FILE_DESCRIPTION(('M105 test case','AP238 operation timestamps go backwards'),'2;1');
FILE_NAME('M105.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 1 0 0 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('numerical_control_machining');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'numerical_control_machining',2007,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10))
     REPRESENTATION_CONTEXT('nc','3D'));
/* Defect: workplan order op_A then op_B; timestamps go backwards. */
#100=MACHINING_OPERATION('op_A_at_2026-04-30T10:00:00',$,$,$,$,$);
#101=MACHINING_OPERATION('op_B_at_2026-04-30T09:00:00',$,$,$,$,$);
#200=WORKPLAN('main',(#100,#101),$,$,$);
ENDSEC;
END-ISO-10303-21;
