ISO-10303-21;
/* M133: AP203 inconsistent ISO 8601 date formats — mixed naive/aware timestamps */
/* DEFECT: one DATE_AND_TIME is timezone-naive (offset=$); another has explicit UTC offset */
/* Comparing or ordering these timestamps requires assuming a timezone for the naive one */
/* Per AP203 §5.7 consistent timezone handling is required for reliable PDM audit trails */
/* Byte assertion: contains(b'CONFIG_CONTROL_DESIGN') */
/* Byte assertion: count_entity_def(b'DATE_AND_TIME') >= 2 */
/* Byte assertion: contains(b'COORDINATED_UNIVERSAL_TIME_OFFSET') */
HEADER;
FILE_DESCRIPTION(('M133: AP203 mixed timezone-naive and timezone-aware DATE_AND_TIME'),'2;1');
FILE_NAME('M133.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'CONFIG_CONTROL_DESIGN') */
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN { 1 0 10303 203 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('configuration controlled 3D designs of mechanical parts and assemblies');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'config_control_design',1994,#1);
/* Standard unit context (mm) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('ctx','3D'));
/* Calendar dates for creation and modification events */
#20=CALENDAR_DATE(2024,3,15);
#21=CALENDAR_DATE(2024,7,22);
/* Byte assertion: count_entity_def(b'DATE_AND_TIME') >= 2 */
/* DEFECT: LOCAL_TIME with null offset — timezone-naive, cannot determine UTC equivalent */
/* This was written by a legacy PDM system that did not record timezone information */
#22=LOCAL_TIME(14,30,0.0,$);
/* Byte assertion: contains(b'COORDINATED_UNIVERSAL_TIME_OFFSET') */
/* UTC+0 offset used by the newer system for the modification timestamp */
#23=COORDINATED_UNIVERSAL_TIME_OFFSET(0,0,.AHEAD.);
/* Timezone-aware LOCAL_TIME with explicit UTC+0 offset */
#24=LOCAL_TIME(9,15,0.0,#23);
/* First DATE_AND_TIME: creation date 2024-03-15T14:30:00 — NAIVE (no tz) */
/* DEFECT contributor: this timestamp cannot be compared with #26 without tz assumption */
#25=DATE_AND_TIME(#20,#22);
/* Second DATE_AND_TIME: modification date 2024-07-22T09:15:00+00:00 — AWARE */
/* This is timezone-aware; comparing #25 vs #26 requires guessing tz for #25 */
#26=DATE_AND_TIME(#21,#24);
/* Product that has both timestamps attached */
#30=PRODUCT('PART-055','Control Housing','Main housing for control unit',(#1));
#31=PRODUCT_DEFINITION_FORMATION('rev_A','Initial release',#30);
#32=PRODUCT_DEFINITION('design','',#31,PRODUCT_DEFINITION_CONTEXT(#1,'design'));
/* DATE role assignments: 'creation_date' (naive) and 'last_modified' (aware) */
#40=APPLIED_DATE_AND_TIME_ASSIGNMENT(#25,DATE_TIME_ROLE('creation_date'),(#32));
#41=APPLIED_DATE_AND_TIME_ASSIGNMENT(#26,DATE_TIME_ROLE('last_modified'),(#32));
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#500=GEOMETRIC_CURVE_SET('ap203-mixed-timezone-naive-aware-dates',
  (#22,#23,#24,#25,#26,#30,#32,#40,#41));
/* Product chain */
#600=APPLICATION_CONTEXT('mechanical design');
#601=PRODUCT_CONTEXT('',#600,'mechanical');
#602=PRODUCT('M133','M133','M133',(#601));
#603=PRODUCT_DEFINITION_FORMATION('','',#602);
#604=PRODUCT_DEFINITION_CONTEXT(#600,'design');
#605=PRODUCT_DEFINITION('','',#603,#604);
#606=PRODUCT_DEFINITION_SHAPE('','',#605);
#607=SHAPE_REPRESENTATION('',(#500),#14);
#608=SHAPE_DEFINITION_REPRESENTATION(#606,#607);
ENDSEC;
END-ISO-10303-21;
