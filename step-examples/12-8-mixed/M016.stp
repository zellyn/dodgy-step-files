     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
     REPRESENTATION_CONTEXT('part','3D'));
/* Empty COORDINATES_LIST */
#100=COORDINATES_LIST('empty_coords',0,());
/* Defect: TESSELLATED_CURVE_SET with empty line_strips and an empty
