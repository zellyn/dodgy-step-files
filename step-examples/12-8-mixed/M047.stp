ISO-10303-21;
/* M047: GEOMETRIC_CURVE_SET containing IMAGE_TEXTURE with TEXTURE_MAPPING on a face — UV texture reference lost on STEP translation; input: AP242 STEP file where a face carries a TEXTURE_MAPPING referencing an IMAGE_TEXTURE with embedded bitmap path and UV coordinate list; HOOPS Exchange 2025.1.0 SDHE-21230 (W025): image textures and UV mappings are silently dropped when exporting to tessellated formats that claim support; kernel must preserve UV coordinates and image reference (or warn on unsupported texture types) rather than silently drop; OCC silently accepts (no diagnostic, empty result); GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty; synonyms: texture lost on translation, IMAGE_TEXTURE not preserved, UV mapping dropped, bitmap material lost */
HEADER;
FILE_DESCRIPTION(('M047'),'2;1');
FILE_NAME('M047.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=IMAGE_TEXTURE('diffuse_map','./textures/surface_diffuse.png');
#2=CARTESIAN_POINT('uv0',(0.,0.,0.));
#3=CARTESIAN_POINT('uv1',(1.,0.,0.));
#4=CARTESIAN_POINT('uv2',(1.,1.,0.));
#5=CARTESIAN_POINT('uv3',(0.,1.,0.));
#6=CARTESIAN_POINT('face_origin',(0.,0.,0.));
#7=DIRECTION('face_normal',(0.,0.,1.));
#8=DIRECTION('face_ref_dir',(1.,0.,0.));
#9=AXIS2_PLACEMENT_3D('face_placement',#6,#7,#8);
#10=TEXTURE_MAPPING(#1,#9,(#2,#3,#4,#5));
#11=GEOMETRIC_CURVE_SET('texture-bitmap-lost-on-translation',(#1,#10,#9,#2,#3,#4,#5));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('M047','M047','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#11),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
END-ISO-10303-21;
