ISO-10303-21;
/* Os003 - Inward offset > cylinder radius: face inverts.
 * Defect: cylinder r=5, offset distance -6 inward. Offset face
 * appears on the wrong side of the axis. */
HEADER;
FILE_DESCRIPTION(('Os003 - reversed offset','Pass C gap-fill'),'2;1');
FILE_NAME('Os003.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=CYLINDRICAL_SURFACE('cyl_r5',#13,5.0);
/* Inward offset 6 - reverses the surface. */
ENDSEC;
END-ISO-10303-21;
