ISO-10303-21;
/* M186: AP238 coolant type WATER incompatible with MAGNESIUM workpiece material */
/* DEFECT: COOLANT_OPERATION declares mode .WATER. on AZ31 magnesium workpiece */
/* Water on burning magnesium liberates hydrogen gas — explosion/fire risk */
/* OSHA/NFPA shop-safety guidance prohibits water coolant on magnesium */
/* Per ISO 10303-238 §5.8 coolant_operation material-compatibility safety rule */
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
/* Byte assertion: contains(b'COOLANT_OPERATION') */
/* Byte assertion: contains(b'magnesium') */
HEADER;
FILE_DESCRIPTION(('M186: AP238 COOLANT_OPERATION WATER mode on AZ31 magnesium workpiece'),'2;1');
FILE_NAME('M186.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 3 1 1 1 }'));
ENDSEC;
DATA;
/* Standard unit context (mm) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('ctx','3D'));
/* mm length unit reference for MEASURE_WITH_UNIT */
#15=SI_UNIT(.MILLI.,.METRE.);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#20=GEOMETRIC_CURVE_SET('ap238-coolant-water-on-magnesium-workpiece',
  (#30,#40,#50,#60));
/* MATERIAL 'AZ31_magnesium': magnesium alloy — reacts violently with water when ignited */
/* Byte assertion: contains(b'magnesium') */
#30=MATERIAL('AZ31_magnesium','AZ31B magnesium alloy workpiece material',$);
/* WORKPIECE 'magnesium_block': made of AZ31 magnesium alloy */
#40=WORKPIECE('magnesium_block','AZ31 magnesium alloy block',$,#30,$,$,$);
/* Byte assertion: contains(b'COOLANT_OPERATION') */
/* DEFECT: COOLANT_OPERATION 'water_coolant_op' uses .WATER. mode on Mg workpiece */
/* Water on burning magnesium: hydrogen liberation + fire acceleration */
#50=COOLANT_OPERATION('water_coolant_op',.WATER.,$,#40,$);
/* MACHINING_WORKINGSTEP 'coolant_step' */
#60=MACHINING_WORKINGSTEP('coolant_step','Water coolant on magnesium step',#50,#40,$);
/* WORKPLAN: unsafe coolant operation on magnesium workpiece */
#70=WORKPLAN('unsafe_coolant_program','Unsafe water coolant on Mg workplan',(),$,(#60));
/* Product chain */
#100=APPLICATION_CONTEXT('mechanical design');
#101=PRODUCT_CONTEXT('',#100,'mechanical');
#102=PRODUCT('M186','M186','M186',(#101));
#103=PRODUCT_DEFINITION_FORMATION('','',#102);
#104=PRODUCT_DEFINITION_CONTEXT(#100,'design');
#105=PRODUCT_DEFINITION('','',#103,#104);
#106=PRODUCT_DEFINITION_SHAPE('','',#105);
#107=SHAPE_REPRESENTATION('',(#20),#14);
#108=SHAPE_DEFINITION_REPRESENTATION(#106,#107);
ENDSEC;
END-ISO-10303-21;
