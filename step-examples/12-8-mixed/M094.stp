ISO-10303-21;
/* M094: AP238 setup placement inconsistent with workpiece coordinate system */
/* DEFECT: SETUP placement origin (100,0,0) != WORKPIECE geometry origin (0,0,0) */
/* 100 mm offset between setup-implied workpiece location and actual workpiece */
/* Toolpath executes at wrong location — part machined 100 mm from intended position */
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
/* Byte assertion: contains(b'SETUP') */
/* Byte assertion: contains(b'AXIS2_PLACEMENT_3D') */
HEADER;
FILE_DESCRIPTION(('M094: AP238 setup placement inconsistent with workpiece CS'),'2;1');
FILE_NAME('M094.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('step_nc_mim');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap238_step_nc_mim',2007,#1);
/* Standard unit context — mm */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('nc','3D'));
/* Workpiece geometry placement at (0,0,0) — the actual part coordinate origin */
#20=CARTESIAN_POINT('workpiece_origin',(0.,0.,0.));
#21=DIRECTION('wp_z',(0.,0.,1.));
#22=DIRECTION('wp_x',(1.,0.,0.));
/* AXIS2_PLACEMENT_3D at (0,0,0): this is where the workpiece geometry lives */
#23=AXIS2_PLACEMENT_3D('workpiece_placement',#20,#21,#22);
/* Setup placement at (100,0,0) — machine-space position of workpiece origin */
/* DEFECT: setup says workpiece sits at x=100 in machine space */
/* But workpiece geometry placement (#23) says its origin is at (0,0,0) */
#30=CARTESIAN_POINT('setup_machine_origin',(100.,0.,0.));
#31=DIRECTION('setup_z',(0.,0.,1.));
#32=DIRECTION('setup_x',(1.,0.,0.));
/* Byte assertion: contains(b'AXIS2_PLACEMENT_3D') */
/* DEFECT AXIS2_PLACEMENT_3D: setup claims workpiece origin is at (100,0,0) */
/* This contradicts the workpiece entity's own placement at (0,0,0) */
#33=AXIS2_PLACEMENT_3D('setup_placement',#30,#31,#32);
/* WORKPIECE: the physical part being machined — geometry at (0,0,0) */
#50=WORKPIECE('part_a',(#14),$,#23,$,$,$);
/* Byte assertion: contains(b'SETUP') */
/* SETUP: declares fixture mounting — claims workpiece origin at (100,0,0) */
/* DEFECT: setup placement #33 at (100,0,0) disagrees with workpiece placement #23 at (0,0,0) */
/* No relating entity reconciles the 100 mm offset */
#60=SETUP('fixture_a',#33,(#50),$);
/* Machining workingstep and workplan over the misplaced setup */
#70=MACHINING_WORKINGSTEP('locate_step',$,$,$);
#90=WORKPLAN('main',(#70),$,$,$);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#300=GEOMETRIC_CURVE_SET('ap238-setup-placement-inconsistent-with-workpiece-cs',
  (#23,#33,#50,#60,#70,#90));
/* Product chain */
#400=APPLICATION_CONTEXT('mechanical design');
#401=PRODUCT_CONTEXT('',#400,'mechanical');
#402=PRODUCT('M094','M094','M094',(#401));
#403=PRODUCT_DEFINITION_FORMATION('','',#402);
#404=PRODUCT_DEFINITION_CONTEXT(#400,'design');
#405=PRODUCT_DEFINITION('','',#403,#404);
#406=PRODUCT_DEFINITION_SHAPE('','',#405);
#407=SHAPE_REPRESENTATION('',(#300),#14);
#408=SHAPE_DEFINITION_REPRESENTATION(#406,#407);
ENDSEC;
END-ISO-10303-21;
