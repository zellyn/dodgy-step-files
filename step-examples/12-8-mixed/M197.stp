ISO-10303-21;
/* M197: FACETED_BREP POLY_LOOP listing the same CARTESIAN_POINT entity (#7) twice in immediate succession inside an otherwise clean planar unit-square boundary; input: AP214 file where a POLY_LOOP's flat point list repeats one point reference at two consecutive positions, which would otherwise produce a zero-length edge; StepToTopoDS_TranslatePolyLoop.cxx:117-119 compares consecutive point HANDLES (P1==P2, entity identity not coordinate equality) and skips building an edge for the repeated pair via a bare continue, leaving the point-pair index unmoved so the following real point closes the gap cleanly -- the resulting wire is the honest quadrilateral P0-P1-P2-P3-P0 with the degenerate segment silently omitted, not a zero-length stub edge; mirrors M055 (four distinct points, on a deliberately non-planar CYLINDRICAL_SURFACE to test a different problem, the schema-illegal-non-planar-face check) fixed by duplicating one point reference and keeping the surface planar so this fixture isolates the degenerate-segment skip cleanly from the non-planar-face mechanism; covers stp-polyloop-dup-point; synonyms: poly loop repeated consecutive point, degenerate polygon segment skipped, same cartesian point twice in poly loop, faceted brep zero-length edge avoided, polyloop consecutive duplicate vertex reference */
HEADER;
FILE_DESCRIPTION(('M197'),'2;1');
FILE_NAME('M197.stp','2026-07-12T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.,0.,0.));
#2=DIRECTION('',(0.,0.,1.));
#3=DIRECTION('',(1.,0.,0.));
#4=AXIS2_PLACEMENT_3D('',#1,#2,#3);
#5=PLANE('base_plane',#4);
#6=CARTESIAN_POINT('p0',(0.,0.,0.));
#7=CARTESIAN_POINT('p1',(1.,0.,0.));
#8=CARTESIAN_POINT('p2',(1.,1.,0.));
#9=CARTESIAN_POINT('p3',(0.,1.,0.));
#10=POLY_LOOP('dup_point_loop',(#6,#7,#7,#8,#9));
#11=FACE_OUTER_BOUND('',#10,.T.);
#12=ADVANCED_FACE('faceted_face_dup_point',(#11),#5,.T.);
#13=CLOSED_SHELL('dup_point_shell',(#12));
#14=FACETED_BREP('faceted_brep_dup_point',#13);
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('M197','M197','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=ADVANCED_BREP_SHAPE_REPRESENTATION('',(#14),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
END-ISO-10303-21;
