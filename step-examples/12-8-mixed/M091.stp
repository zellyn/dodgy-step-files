ISO-10303-21;
/* M091 - AP210 conductor segment crosses board edge.
 * Defect: a copper conductor (CONDUCTOR_TRACK_PROFILE) is described as
 * a line segment from (15.0, 5.0) to (40.0, 5.0) on an outline that
 * is bounded by (0..30, 0..30). The track exits the board at x=30
 * and continues in mid-air to x=40 - a fabrication-impossible trace. */
HEADER;
FILE_DESCRIPTION(('M091 test case','AP210 trace exits board outline'),'2;1');
FILE_NAME('M091.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN { 1 0 10303 210 3 1 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('electronic_assembly_interconnect_and_packaging_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'electronic_assembly_interconnect_and_packaging_design',2014,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10))
     REPRESENTATION_CONTEXT('pcb','3D'));
/* PCB outline: 30 x 30 mm */
#20=CARTESIAN_POINT('bl',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('br',(30.0,0.0,0.0));
#22=CARTESIAN_POINT('tr',(30.0,30.0,0.0));
#23=CARTESIAN_POINT('tl',(0.0,30.0,0.0));
#24=POLYLINE('outline',(#20,#21,#22,#23,#20));
#100=LAMINATE_OR_PLY_DEFINITION('core',$,$,$,LENGTH_MEASURE(0.2));
#101=PLY_BOUNDARY_REPRESENTATION('outline_rep',(#24),#14);
/* Defect: trace from (15,5) to (40,5), exits board at x=30. */
#200=CARTESIAN_POINT('trace_a',(15.0,5.0,0.0));
#201=CARTESIAN_POINT('trace_b',(40.0,5.0,0.0));
#202=POLYLINE('trace_path',(#200,#201));
#210=CONDUCTOR_TRACK_PROFILE('clk_trace',$,#202,LENGTH_MEASURE(0.2));
ENDSEC;
END-ISO-10303-21;
