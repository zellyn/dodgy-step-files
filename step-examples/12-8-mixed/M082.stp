ISO-10303-21;
/* M082 - AP209 element node order winds the wrong way.
 * Defect: a SURFACE_3D_ELEMENT_DESCRIPTOR for a linear_quadrilateral
 * lists corner nodes in clockwise order when viewed from the surface
 * normal, but AP209 (and most FEA conventions) require counter-clockwise
 * winding. The element's Jacobian determinant is negative; volume /
 * area integrals come out with the wrong sign. */
HEADER;
FILE_DESCRIPTION(('M082 test case','AP209 element node order reversed'),'2;1');
FILE_NAME('M082.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('STRUCTURAL_ANALYSIS_DESIGN { 1 0 10303 209 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('structural_analysis_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'structural_analysis_design',2001,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10))
     REPRESENTATION_CONTEXT('fea','3D'));
/* Quad nodes: CCW order would be n1,n2,n3,n4 with positive Z normal.
 * Here we list them CW: n1,n4,n3,n2. */
#100=CARTESIAN_POINT('n1',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('n2',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('n3',(1.0,1.0,0.0));
#103=CARTESIAN_POINT('n4',(0.0,1.0,0.0));
#110=NODE('n1',(#100),$);#111=NODE('n2',(#101),$);
#112=NODE('n3',(#102),$);#113=NODE('n4',(#103),$);
/* Defect: clockwise winding order, negative Jacobian. */
#200=SURFACE_3D_ELEMENT_DESCRIPTOR('quad','linear_quadrilateral',
       (#110,#113,#112,#111));
ENDSEC;
END-ISO-10303-21;
