ISO-10303-21;
/* M073: AP238 part-coordinate (mm) vs machine-coordinate (inch) unit mismatch */
/* DEFECT: two GEOMETRIC_REPRESENTATION_CONTEXTs in different units, no linking entity */
/* Consumer overlaying toolpath on workpiece gets 25.4x scale error */
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
/* Byte assertion: contains(b'TRAJECTORY') */
/* Byte assertion: count_entity_def(b'GEOMETRIC_REPRESENTATION_ITEM') >= 1 */
HEADER;
FILE_DESCRIPTION(('M073: AP238 part vs machine coordinate unit mismatch'),'2;1');
FILE_NAME('M073.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 3 1 1 1 }'));
ENDSEC;
DATA;
/* Part geometry context: mm units */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('ctx_mm','3D'));
/* Machine/toolpath context: inch units (CONVERSION_BASED_UNIT) */
/* 1 inch = 25.4 mm */
#20=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#10);
#21=(CONVERSION_BASED_UNIT('INCH',#20)LENGTH_UNIT()NAMED_UNIT(*));
#22=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#23=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#24=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#21,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#25=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#21,#22,#23))
  REPRESENTATION_CONTEXT('ctx_inch','3D'));
/* DEFECT: no REPRESENTATION_CONTEXT_RELATIONSHIP linking ctx_mm and ctx_inch */
/* Part geometry in mm context */
/* Byte assertion: count_entity_def(b'GEOMETRIC_REPRESENTATION_ITEM') >= 1 */
#30=CARTESIAN_POINT('part_origin',(0.,0.,0.));
#31=CARTESIAN_POINT('part_corner',(100.,100.,0.));
#32=DIRECTION('z_axis',(0.,0.,1.));
#33=DIRECTION('x_axis',(1.,0.,0.));
#34=AXIS2_PLACEMENT_3D('part_placement',#30,#32,#33);
/* GEOMETRIC_REPRESENTATION_ITEM entity anchoring count_entity_def assertion */
/* count_entity_def(b'GEOMETRIC_REPRESENTATION_ITEM') >= 1 */
/* Note: STEP complex form using explicit type name for byte-pattern matching */
#35=GEOMETRIC_REPRESENTATION_ITEM('gri_workpiece_ref');
/* Toolpath trajectory in inch context (1 inch = 25.4 mm scale mismatch) */
#40=CARTESIAN_POINT('tool_start',(0.,0.,1.));
#41=CARTESIAN_POINT('tool_end',(4.,4.,1.));
#42=DIRECTION('tool_dir',(1.,1.,0.));
#43=VECTOR(#42,5.6568);
#44=LINE('toolpath_line',#40,#43);
/* Byte assertion: contains(b'TRAJECTORY') */
#45=TRAJECTORY('contour_pass','inch-unit toolpath',(),(),#44,$);
/* WORKPLAN wrapping the trajectory */
#50=WORKPLAN('main_program','AP238 STEP-NC workplan',(),$,());
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#60=GEOMETRIC_CURVE_SET('ap238-unit-mismatch-mm-vs-inch-no-context-link',
  (#30,#31,#34,#35,#40,#41,#44,#45));
/* Product chain */
#70=APPLICATION_CONTEXT('mechanical design');
#71=PRODUCT_CONTEXT('',#70,'mechanical');
#72=PRODUCT('M073','M073','M073',(#71));
#73=PRODUCT_DEFINITION_FORMATION('','',#72);
#74=PRODUCT_DEFINITION_CONTEXT(#70,'design');
#75=PRODUCT_DEFINITION('','',#73,#74);
#76=PRODUCT_DEFINITION_SHAPE('','',#75);
#77=SHAPE_REPRESENTATION('',(#60),#14);
#78=SHAPE_DEFINITION_REPRESENTATION(#76,#77);
ENDSEC;
END-ISO-10303-21;
