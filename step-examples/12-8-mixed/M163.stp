/* M163 - Imported STEP per-face colours scramble after any unrelated
 * edit operation.
 * Defect (FreeCAD #13363): receiver binds STYLED_ITEM by document-walk
 * order rather than by entity number; adding any unrelated body shifts
 * the binding and every coloured face references the wrong sub-shape. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('M163 - styled-items with deliberately interleaved entity numbering'),'2;1');
FILE_NAME('M163.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('M163_colored','styled-item interleave','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=EDGE_LOOP('placeholder',());
#25=FACE_OUTER_BOUND('placeholder',#24,.T.);
/* Six advanced faces. Note the deliberately interleaved ID-vs-document-
   order: face_a is at #501, face_b at #401 (numerically *earlier*), face_c
   at #601, face_d at #301 (the lowest numbered), etc. A binder that uses
   document-walk order will mis-attribute every colour after any edit. */
#601=PLANE('plane_c',#23); #602=ADVANCED_FACE('face_c',(#25),#601,.T.);
#501=PLANE('plane_a',#23); #502=ADVANCED_FACE('face_a',(#25),#501,.T.);
#401=PLANE('plane_b',#23); #402=ADVANCED_FACE('face_b',(#25),#401,.T.);
#301=PLANE('plane_d',#23); #302=ADVANCED_FACE('face_d',(#25),#301,.T.);
#201=PLANE('plane_e',#23); #202=ADVANCED_FACE('face_e',(#25),#201,.T.);
#101=PLANE('plane_f',#23); #102=ADVANCED_FACE('face_f',(#25),#101,.T.);
/* Per-face colours, bound by entity number. */
#110=COLOUR_RGB('red',1.0,0.0,0.0);
#111=COLOUR_RGB('green',0.0,1.0,0.0);
#112=COLOUR_RGB('blue',0.0,0.0,1.0);
#113=COLOUR_RGB('yellow',1.0,1.0,0.0);
#114=COLOUR_RGB('cyan',0.0,1.0,1.0);
#115=COLOUR_RGB('magenta',1.0,0.0,1.0);
#120=FILL_AREA_STYLE_COLOUR('',#110); #121=FILL_AREA_STYLE('',(#120));
#122=SURFACE_STYLE_FILL_AREA(#121); #123=SURFACE_SIDE_STYLE('',(#122));
#124=SURFACE_STYLE_USAGE(.BOTH.,#123); #125=PRESENTATION_STYLE_ASSIGNMENT((#124));
#130=STYLED_ITEM('a_red',(#125),#502);
#131=STYLED_ITEM('b_green',(#125),#402);
#132=STYLED_ITEM('c_blue',(#125),#602);
#133=STYLED_ITEM('d_yellow',(#125),#302);
#134=STYLED_ITEM('e_cyan',(#125),#202);
#135=STYLED_ITEM('f_magenta',(#125),#102);
#700=CLOSED_SHELL('shell',(#502,#402,#602,#302,#202,#102));
#701=MANIFOLD_SOLID_BREP('M163_body',#700);
#710=SHAPE_REPRESENTATION('M163_repr',(#23,#701),#14);
#711=SHAPE_DEFINITION_REPRESENTATION(#8,#710);
ENDSEC;
END-ISO-10303-21;
