ISO-10303-21;
/* M176: AP238 boring tool diameter exceeds start-hole diameter */
/* DEFECT: BORING_TOOL diameter 15.0 mm > ROUND_HOLE diameter 10.0 mm */
/* Boring bar physically cannot enter the pre-drilled start hole */
/* Controller crashes tool against workpiece face or refuses to plunge */
/* Per ISO 10303-238 §5.8 boring tool diameter must be less than start-hole diameter */
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
/* Byte assertion: contains(b'BORING_OPERATION') */
/* Byte assertion: contains(b'BORING_TOOL') */
/* Byte assertion: contains(b'15.0') */
HEADER;
FILE_DESCRIPTION(('M176: AP238 boring_tool diameter 15mm exceeds start-hole diameter 10mm'),'2;1');
FILE_NAME('M176.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 3 1 1 1 }'));
ENDSEC;
DATA;
/* Standard unit context (mm) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('ctx','3D'));
/* mm length unit reference for MEASURE_WITH_UNIT */
#15=SI_UNIT(.MILLI.,.METRE.);
/* Start hole locator geometry */
#30=CARTESIAN_POINT('hole_origin',(50.0,50.0,10.0));
#31=DIRECTION('hole_axis',(0.0,0.0,1.0));
#32=AXIS2_PLACEMENT_3D('hole_locator',#30,#31,$);
/* ROUND_HOLE 'start_hole': diameter 10.0 mm (smaller than boring tool) */
#41=MEASURE_WITH_UNIT(POSITIVE_LENGTH_MEASURE(10.0),#15);
#40=ROUND_HOLE('start_hole',$,#41,#32,$);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#20=GEOMETRIC_CURVE_SET('ap238-boring-tool-diameter-exceeds-start-hole-diameter',
  (#40,#52,#60));
/* Byte assertion: contains(b'BORING_TOOL') */
/* DEFECT: BORING_TOOL 'boring_bar_15mm' with diameter 15.0 mm — exceeds 10.0 mm hole */
#54=MEASURE_WITH_UNIT(POSITIVE_LENGTH_MEASURE(15.0),#15);
#53=BORING_TOOL('boring_bar_15mm',$,#54,$,$,$,$,$,$);
/* Byte assertion: contains(b'BORING_OPERATION') */
/* DEFECT: BORING_OPERATION references oversized tool: bar cannot enter start hole */
#52=BORING_OPERATION('bore_oversized',$,$,$,$,$,#53,$,$,$,$,$,$);
/* WORKPIECE 'bore_workpiece' */
#60=WORKPIECE('bore_workpiece','Boring workpiece for oversized-tool test',$,$,$,$,$);
/* MACHINING_WORKINGSTEP 'bore_step' links boring op to workpiece */
#51=MACHINING_WORKINGSTEP('bore_step','Oversized boring workingstep',#52,#60,$);
/* WORKPLAN: single boring step with oversized tool */
#50=WORKPLAN('boring_oversize_program','Boring oversized tool workplan',(),$,(#51));
/* Product chain */
#100=APPLICATION_CONTEXT('mechanical design');
#101=PRODUCT_CONTEXT('',#100,'mechanical');
#102=PRODUCT('M176','M176','M176',(#101));
#103=PRODUCT_DEFINITION_FORMATION('','',#102);
#104=PRODUCT_DEFINITION_CONTEXT(#100,'design');
#105=PRODUCT_DEFINITION('','',#103,#104);
#106=PRODUCT_DEFINITION_SHAPE('','',#105);
#107=SHAPE_REPRESENTATION('',(#20),#14);
#108=SHAPE_DEFINITION_REPRESENTATION(#106,#107);
ENDSEC;
END-ISO-10303-21;
