ISO-10303-21;
/* M086 - AP210 via_drill_definition lies outside conductor extents.
 * Defect: a VIA_DEFINITION's drill location places the via center at
 * (50.0, 50.0) mm, but the LAMINATE_OR_PLY_DEFINITION's outline (a
 * rectangular bounded_curve) covers only (0..30, 0..30) mm. The via
 * drills through air; downstream impedance / continuity checks fail
 * because the via doesn't actually pierce any copper layer. */
HEADER;
FILE_DESCRIPTION(('M086 test case','AP210 via outside conductor extents'),'2;1');
FILE_NAME('M086.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN { 1 0 10303 210 3 1 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('electronic_assembly_interconnect_and_packaging_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'electronic_assembly_interconnect_and_packaging_design',2014,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10))
     REPRESENTATION_CONTEXT('pcb','3D'));
/* PCB outline: 30 mm x 30 mm */
#20=CARTESIAN_POINT('bl',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('br',(30.0,0.0,0.0));
#22=CARTESIAN_POINT('tr',(30.0,30.0,0.0));
#23=CARTESIAN_POINT('tl',(0.0,30.0,0.0));
#24=POLYLINE('outline',(#20,#21,#22,#23,#20));
#100=LAMINATE_OR_PLY_DEFINITION('core',$,$,$,LENGTH_MEASURE(0.2));
#101=PLY_BOUNDARY_REPRESENTATION('core_outline',(#24),#14);
/* Defect: via center at (50,50,0) - outside the (0..30, 0..30) ply. */
#200=CARTESIAN_POINT('via_loc',(50.0,50.0,0.0));
#201=AXIS2_PLACEMENT_3D('via_axis',#200,$,$);
#210=VIA_DEFINITION('via_a',$,#201,LENGTH_MEASURE(0.3));
ENDSEC;
END-ISO-10303-21;
