ISO-10303-21;
/* M086: AP210 via drilled outside the conductor / board outline */
/* DEFECT: VIA_DEFINITION drill at (50,50,0) but board outline is (0..30, 0..30) mm */
/* Via drills through air — doesn't pierce any copper layer */
/* Byte assertion: contains(b'ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN') */
/* Byte assertion: contains(b'VIA_DEFINITION') */
/* Byte assertion: contains(b'LAMINATE_OR_PLY_DEFINITION') */
HEADER;
FILE_DESCRIPTION(('M086: AP210 via outside board outline'),'2;1');
FILE_NAME('M086.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN') */
FILE_SCHEMA(('ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN { 1 0 10303 210 3 1 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('electronic_assembly_interconnect_and_packaging_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'electronic_assembly_interconnect_and_packaging_design',2014,#1);
/* Standard unit context */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('pcb','3D'));
/* PCB board outline: 30 mm x 30 mm rectangle */
#20=CARTESIAN_POINT('bl',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('br',(30.0,0.0,0.0));
#22=CARTESIAN_POINT('tr',(30.0,30.0,0.0));
#23=CARTESIAN_POINT('tl',(0.0,30.0,0.0));
/* Closed POLYLINE outline (30x30 mm board) */
#25=POLYLINE('outline',(#20,#21,#22,#23,#20));
/* Byte assertion: contains(b'LAMINATE_OR_PLY_DEFINITION') */
/* Board core ply definition */
#100=LAMINATE_OR_PLY_DEFINITION('core',$,$,$,LENGTH_MEASURE(0.2));
/* PLY_BOUNDARY_REPRESENTATION links the outline to the ply */
#101=PLY_BOUNDARY_REPRESENTATION('core_outline',(#25),#14);
/* Byte assertion: contains(b'VIA_DEFINITION') */
/* DEFECT: via center at (50,50,0) is outside (0..30, 0..30) board outline */
/* The via drill physically misses the substrate — drills into air */
#200=CARTESIAN_POINT('via_loc',(50.0,50.0,0.0));
#201=AXIS2_PLACEMENT_3D('via_axis',#200,$,$);
#210=VIA_DEFINITION('via_a',$,#201,LENGTH_MEASURE(0.3));
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#300=GEOMETRIC_CURVE_SET('ap210-via-drilled-outside-board-outline',
  (#25,#100,#101,#200,#201,#210));
/* Product chain */
#400=APPLICATION_CONTEXT('mechanical design');
#401=PRODUCT_CONTEXT('',#400,'mechanical');
#402=PRODUCT('M086','M086','M086',(#401));
#403=PRODUCT_DEFINITION_FORMATION('','',#402);
#404=PRODUCT_DEFINITION_CONTEXT(#400,'design');
#405=PRODUCT_DEFINITION('','',#403,#404);
#406=PRODUCT_DEFINITION_SHAPE('','',#405);
#407=SHAPE_REPRESENTATION('',(#300),#14);
#408=SHAPE_DEFINITION_REPRESENTATION(#406,#407);
ENDSEC;
END-ISO-10303-21;
