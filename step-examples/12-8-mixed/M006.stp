ISO-10303-21;
/* M006 - INTEGER_REPRESENTATION_ITEM serialized without trailing
 * decimal point.
 * Defect: per Part 21, the_value of INTEGER_REPRESENTATION_ITEM is
 * declared by redeclaration from NUMBER, so it must be written as a
 * REAL with a trailing dot ('4.', not '4'). Many writers emit a bare
 * INTEGER token. Strict-as-REAL parsers reject; tolerant parsers
 * accept either, and conformant writers emit the dotted form.
 * This file contains BOTH variants side-by-side: #410 is conformant,
 * #411 lacks the trailing dot. */
HEADER;
FILE_DESCRIPTION(('M006 test case','integer_representation_item without trailing dot'),'2;1');
FILE_NAME('M006.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2014,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-6),#10,'distance_accuracy_value','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
     REPRESENTATION_CONTEXT('part','3D'));
#300=PRODUCT('part1','part1','',(#310));
#310=MECHANICAL_CONTEXT('',#1,'mechanical');
#320=PRODUCT_DEFINITION_FORMATION('','',#300);
#330=PRODUCT_DEFINITION('design','',#320,#340);
#340=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#350=PRODUCT_DEFINITION_SHAPE('','',#330);
#400=PROPERTY_DEFINITION('geometric validation property',
       'topology counts',#350);
/* Conformant: trailing dot makes it a REAL token. */
#410=INTEGER_REPRESENTATION_ITEM('number of children',4.);
/* Defect: NO trailing dot - bare INTEGER token, non-conformant. */
#411=INTEGER_REPRESENTATION_ITEM('number of faces',6);
/* Conformant integer with explicit decimal. */
#412=INTEGER_REPRESENTATION_ITEM('number of edges',12.);
/* Defect: bare integer for vertex count too. */
#413=INTEGER_REPRESENTATION_ITEM('number of vertices',8);
#420=REPRESENTATION('topology_counts',(#410,#411,#412,#413),#14);
#430=PROPERTY_DEFINITION_REPRESENTATION(#400,#420);
ENDSEC;
END-ISO-10303-21;
