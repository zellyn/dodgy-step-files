ISO-10303-21;
/* M057 - File declaring AP203 schema but using a Boolean expression
 * that strict AP203 readers reject (AP242-only attribute on a base
 * entity)
 * Defect: ISO 10303-21 declares the active EXPRESS schema in
 * FILE_SCHEMA. AP203 is a stable, narrow schema; AP242 extends
 * many AP203 entities with extra optional attributes. A producer
 * configured for AP242 but mistakenly emitting an AP203 schema
 * tag may emit entities at AP242 arity (extra attributes) that
 * a strict AP203 reader rejects ("attribute count mismatch") even
 * though every individual attribute is well-formed. */
HEADER;
FILE_DESCRIPTION(('M057 - AP203 schema tag with AP242 entity arity'),'2;1');
FILE_NAME('M057.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
/* Defect: declares AP203_CONFIG_CONTROL_DESIGN but instances use
 * AP242 attribute counts */
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('config_control_design');
#2=PRODUCT_CONTEXT('part',#1,'mechanical');
/* AP242 PRODUCT carries 4 attributes (id, name, description,
 * frame_of_reference). AP203 PRODUCT also has 4 - but if the
 * producer mistakenly emits a 5th (an AP242-only "id_owner"
 * concept), a strict AP203 parser rejects. */
#10=PRODUCT('Pmi-001','partA','description',(#2),'extra_unknown');
#11=PRODUCT('Pmi-002','partB','description',(#2));
#20=CARTESIAN_POINT('o',(0.0,0.0,0.0));
#21=DIRECTION('z',(0.0,0.0,1.0));
#22=DIRECTION('x',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
ENDSEC;
END-ISO-10303-21;
