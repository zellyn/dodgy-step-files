ISO-10303-21;
/* M130 - AP203 assembly cleared at lower security classification than
 * its components.
 * Defect: a parent PRODUCT carries SECURITY_CLASSIFICATION 'unclassified'
 * yet a child component used in NEXT_ASSEMBLY_USAGE_OCCURRENCE carries
 * SECURITY_CLASSIFICATION 'confidential'. Aggregating a confidential
 * child into an unclassified parent inverts the security clearance
 * hierarchy. */
HEADER;
FILE_DESCRIPTION(('M130 test case','AP203 security classification inversion'),'2;1');
FILE_NAME('M130.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('configuration controlled 3D design of mechanical parts and assemblies');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','config_control_design',1994,#1);
#10=PRODUCT('parent_assy','parent_assy','top assembly',(#1));
#11=PRODUCT('classified_child','classified_child','restricted part',(#1));
#20=PRODUCT_DEFINITION_FORMATION('rev_A','released',#10);
#21=PRODUCT_DEFINITION_FORMATION('rev_A','released',#11);
#30=PRODUCT_DEFINITION('design','',#20,#1);
#31=PRODUCT_DEFINITION('design','',#21,#1);
#40=NEXT_ASSEMBLY_USAGE_OCCURRENCE('use_1','child usage','',#30,#31,$);
/* Defect: parent unclassified, child confidential. */
#100=SECURITY_CLASSIFICATION_LEVEL('unclassified');
#101=SECURITY_CLASSIFICATION_LEVEL('confidential');
#110=SECURITY_CLASSIFICATION('','parent open',#100);
#111=SECURITY_CLASSIFICATION('','child restricted',#101);
#120=CC_DESIGN_SECURITY_CLASSIFICATION(#110,(#30));
#121=CC_DESIGN_SECURITY_CLASSIFICATION(#111,(#31));
ENDSEC;
END-ISO-10303-21;
