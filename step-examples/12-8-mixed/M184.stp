ISO-10303-21;
/* M184: AP238 executable_relationship forms a cycle (A precedes B, B precedes A) */
/* DEFECT: EXECUTABLE_RELATIONSHIP A->B and B->A create a dependency cycle */
/* Workplan has no valid topological order — no valid starting operation exists */
/* Consumer scheduler either deadlocks or picks arbitrary order breaking dependencies */
/* Per ISO 10303-238 §6.4 executable-relationship graph must be acyclic */
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
/* Byte assertion: count_entity_def(b'EXECUTABLE_RELATIONSHIP') >= 2 */
HEADER;
FILE_DESCRIPTION(('M184: AP238 executable_relationship cycle A precedes B precedes A'),'2;1');
FILE_NAME('M184.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 3 1 1 1 }'));
ENDSEC;
DATA;
/* Standard unit context (mm) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('ctx','3D'));
/* mm length unit reference for MEASURE_WITH_UNIT */
#15=SI_UNIT(.MILLI.,.METRE.);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#20=GEOMETRIC_CURVE_SET('ap238-executable-relationship-dependency-cycle',
  (#210,#211,#60));
/* WORKPIECE 'drill_workpiece' for both drilling operations */
#60=WORKPIECE('drill_workpiece','Workpiece for cyclic dependency test',$,$,$,$,$);
/* Operation A: drill_op_A — first drilling operation */
#200=DRILLING_OPERATION('drill_op_A',$,$,$,$,$,$,$,$,$,$,$,$);
/* Operation B: drill_op_B — second drilling operation */
#201=DRILLING_OPERATION('drill_op_B',$,$,$,$,$,$,$,$,$,$,$,$);
/* Byte assertion: count_entity_def(b'EXECUTABLE_RELATIONSHIP') >= 2 */
/* EXECUTABLE_RELATIONSHIP 'A_precedes_B': A (#200) must execute before B (#201) */
#210=EXECUTABLE_RELATIONSHIP('A_precedes_B','A must precede B',#200,#201);
/* DEFECT: 'B_precedes_A': B (#201) must execute before A (#200) — CYCLE! */
#211=EXECUTABLE_RELATIONSHIP('B_precedes_A','B must precede A',#201,#200);
/* MACHINING_WORKINGSTEP links each op to the shared workpiece */
#51=MACHINING_WORKINGSTEP('drill_step_A','Drill step A',#200,#60,$);
#52=MACHINING_WORKINGSTEP('drill_step_B','Drill step B',#201,#60,$);
/* WORKPLAN: both steps with circular dependency — no valid schedule */
#50=WORKPLAN('cyclic_dependency_program','Cyclic dependency workplan',(),$,(#51,#52));
/* Product chain */
#100=APPLICATION_CONTEXT('mechanical design');
#101=PRODUCT_CONTEXT('',#100,'mechanical');
#102=PRODUCT('M184','M184','M184',(#101));
#103=PRODUCT_DEFINITION_FORMATION('','',#102);
#104=PRODUCT_DEFINITION_CONTEXT(#100,'design');
#105=PRODUCT_DEFINITION('','',#103,#104);
#106=PRODUCT_DEFINITION_SHAPE('','',#105);
#107=SHAPE_REPRESENTATION('',(#20),#14);
#108=SHAPE_DEFINITION_REPRESENTATION(#106,#107);
ENDSEC;
END-ISO-10303-21;
