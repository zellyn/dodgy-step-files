ISO-10303-21;
/* M184 - AP238 EXECUTABLE_RELATIONSHIP forms a cycle.
 * Defect: two EXECUTABLE_RELATIONSHIP entities form a cycle where
 * operation A precedes operation B and operation B precedes operation
 * A. The workplan has no valid topological order; consumers either
 * deadlock during scheduling or pick an arbitrary order that breaks
 * the dependency. */
HEADER;
FILE_DESCRIPTION(('M184 test case','AP238 executable_relationship cycle'),'2;1');
FILE_NAME('M184.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 1 0 0 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('numerical_control_machining');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'numerical_control_machining',2007,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10))
     REPRESENTATION_CONTEXT('nc','3D'));
#100=MACHINING_OPERATION('op_A',$,$,$,$,$);
#101=MACHINING_OPERATION('op_B',$,$,$,$,$);
/* Defect: A precedes B and B precedes A. */
#110=EXECUTABLE_RELATIONSHIP('A_before_B',$,#100,#101);
#111=EXECUTABLE_RELATIONSHIP('B_before_A',$,#101,#100);
#200=WORKPLAN('main',(#100,#101),$,$,$);
ENDSEC;
END-ISO-10303-21;
