ISO-10303-21;
/* M134: AP203 two distinct PERSON entities share the same id 'jdoe' */
/* DEFECT: two PERSON instances both have id='jdoe' but different last names */
/* APPROVAL_PERSON_ORGANIZATION cannot determine which individual approved */
/* Per ISO 10303-41 PERSON.id must be unique within the design pool */
/* Byte assertion: contains(b'CONFIG_CONTROL_DESIGN') */
/* Byte assertion: count_entity_def(b'PERSON') >= 2 */
/* Byte assertion: contains(b"PERSON('jdoe',") */
HEADER;
FILE_DESCRIPTION(('M134: AP203 PERSON id collision — two people share id jdoe'),'2;1');
FILE_NAME('M134.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'CONFIG_CONTROL_DESIGN') */
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN { 1 0 10303 203 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('configuration controlled 3D designs of mechanical parts and assemblies');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'config_control_design',1994,#1);
/* Standard unit context (mm) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('ctx','3D'));
/* Byte assertion: count_entity_def(b'PERSON') >= 2 */
/* First PERSON with id 'jdoe' — imported from design-team database */
/* Byte assertion: contains(b"PERSON('jdoe',") */
#20=PERSON('jdoe','Doe','John',$,$,$);
/* DEFECT: second PERSON also has id 'jdoe' — imported from approval database */
/* Different last name 'Doppelganger' proves these are distinct individuals */
/* A valid file would use distinct ids such as 'jdoe' and 'jdopple' */   
#21=PERSON('jdoe','Doppelganger','Jane',$,$,$);
/* Shared organization for both persons */
#22=ORGANIZATION('ORG-001','Acme Engineering','Mechanical design division');
#23=PERSON_AND_ORGANIZATION(#20,#22);
#24=PERSON_AND_ORGANIZATION(#21,#22);
/* Product under review */
#30=PRODUCT('PART-088','Gear Housing','Precision gear enclosure',(#1));
#31=PRODUCT_DEFINITION_FORMATION('rev_B','Engineering change rev B',#30);
#32=PRODUCT_DEFINITION('design','',#31,PRODUCT_DEFINITION_CONTEXT(#1,'design'));
/* APPROVAL entity for the rev_B design review */
#40=APPROVAL(APPROVAL_STATUS('approved'),'Rev B design approval');
#42=APPLIED_APPROVAL_ASSIGNMENT(#40,(#32));
/* DEFECT: APPROVAL_PERSON_ORGANIZATION refers to #23 (person 'jdoe' = John Doe) */
/* but #24 also exists with the same id 'jdoe' (Jane Doppelganger) */
/* The approval record is ambiguous: which 'jdoe' signed off on rev_B? */
#41=APPROVAL_PERSON_ORGANIZATION(#23,#40,APPROVAL_ROLE('approver'));
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#500=GEOMETRIC_CURVE_SET('ap203-person-id-collision-jdoe',
  (#20,#21,#22,#23,#24,#30,#31,#32,#40,#41,#42));
/* Product chain */
#600=APPLICATION_CONTEXT('mechanical design');
#601=PRODUCT_CONTEXT('',#600,'mechanical');
#602=PRODUCT('M134','M134','M134',(#601));
#603=PRODUCT_DEFINITION_FORMATION('','',#602);
#604=PRODUCT_DEFINITION_CONTEXT(#600,'design');
#605=PRODUCT_DEFINITION('','',#603,#604);
#606=PRODUCT_DEFINITION_SHAPE('','',#605);
#607=SHAPE_REPRESENTATION('',(#500),#14);
#608=SHAPE_DEFINITION_REPRESENTATION(#606,#607);
ENDSEC;
END-ISO-10303-21;
