ISO-10303-21;
/* M072: AP238 TRAJECTORY references open COMPOSITE_CURVE as closed contour */
/* DEFECT: L-shaped chain (p1->p2->p3) does not close; p3 != p1 */
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
/* Byte assertion: contains(b'COMPOSITE_CURVE') */
/* Byte assertion: contains(b'TRAJECTORY') */
HEADER;
FILE_DESCRIPTION(('M072: AP238 toolpath_curve open chain claimed as closed contour'),'2;1');
FILE_NAME('M072.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 3 1 1 1 }'));
ENDSEC;
DATA;
/* Standard unit context */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('ctx','3D'));
/* L-shaped open chain: p1(0,0,0) -> p2(10,0,0) -> p3(10,10,0) */
/* The chain does NOT close: p3(10,10,0) != p1(0,0,0) */
#20=CARTESIAN_POINT('p1',(0.,0.,0.));
#21=CARTESIAN_POINT('p2',(10.,0.,0.));
#22=CARTESIAN_POINT('p3',(10.,10.,0.));
/* Line seg 1: p1 -> p2 (along X axis) */
#23=DIRECTION('dir_x',(1.,0.,0.));
#24=VECTOR(#23,10.);
#25=LINE('seg1_line',#20,#24);
/* Line seg 2: p2 -> p3 (along Y axis) */
#26=DIRECTION('dir_y',(0.,1.,0.));
#27=VECTOR(#26,10.);
#28=LINE('seg2_line',#21,#27);
/* COMPOSITE_CURVE_SEGMENTs forming the L shape */
#30=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,#25);
#31=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,#28);
/* Byte assertion: contains(b'COMPOSITE_CURVE') */
/* COMPOSITE_CURVE: self_intersect=.F., open chain claimed as closed by TRAJECTORY */
#32=COMPOSITE_CURVE('l_shaped_toolpath',(#30,#31),.F.);
/* Byte assertion: contains(b'TRAJECTORY') */
/* TRAJECTORY references the open composite curve as a closed contour */
#40=TRAJECTORY('contour_pass','closed contouring trajectory',(),(),#32,$);
/* WORKPLAN wrapping the trajectory */
#50=WORKPLAN('main_program','AP238 STEP-NC workplan',(),$,());
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#60=GEOMETRIC_CURVE_SET('ap238-toolpath-open-chain-claimed-closed',
  (#32,#40,#20,#21,#22,#25,#28));
/* Product chain */
#70=APPLICATION_CONTEXT('mechanical design');
#71=PRODUCT_CONTEXT('',#70,'mechanical');
#72=PRODUCT('M072','M072','M072',(#71));
#73=PRODUCT_DEFINITION_FORMATION('','',#72);
#74=PRODUCT_DEFINITION_CONTEXT(#70,'design');
#75=PRODUCT_DEFINITION('','',#73,#74);
#76=PRODUCT_DEFINITION_SHAPE('','',#75);
#77=SHAPE_REPRESENTATION('',(#60),#14);
#78=SHAPE_DEFINITION_REPRESENTATION(#76,#77);
ENDSEC;
END-ISO-10303-21;
