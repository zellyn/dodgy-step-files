ISO-10303-21;
/* M138: AP203 APPROVAL_PERSON_ORGANIZATION with empty PERSON identity fields */
/* DEFECT: PERSON('','',$,$,$) — id and last_name both empty, no first_name */
/* The APPROVAL_PERSON_ORGANIZATION links an approval to a person-less record */
/* Audit trail is incomplete; approval cannot be attributed to any individual */
/* Per ISO 10303-41 §4.4.3 PERSON.last_name is required and must be non-empty */
/* Byte assertion: contains(b'CONFIG_CONTROL_DESIGN') */
/* Byte assertion: contains(b'APPROVAL_PERSON_ORGANIZATION') */
/* Byte assertion: contains(b"PERSON('','',") */
HEADER;
FILE_DESCRIPTION(('M138: AP203 APPROVAL_PERSON_ORGANIZATION empty PERSON no audit trail'),'2;1');
FILE_NAME('M138.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'CONFIG_CONTROL_DESIGN') */
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN { 1 0 10303 203 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('configuration controlled 3D designs of mechanical parts and assemblies');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'config_control_design',1994,#1);
/* Standard unit context (mm) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('ctx','3D'));
/* Byte assertion: contains(b"PERSON('','',") */
/* DEFECT: PERSON with empty id and empty last_name — violates ISO 10303-41 §4.4.3 */
/* A PDM exporter identified the approver only by organizational role, omitting personal data */
/* Any downstream APPROVAL_PERSON_ORGANIZATION referencing this PERSON is unattributable */
#20=PERSON('','',$,$,$);
/* Organization provides a stamp (Acme Engineering) but no named individual */
#21=ORGANIZATION('ORG-007','Acme Engineering','Design approval authority');
/* PERSON_AND_ORGANIZATION bundles the empty-identity PERSON with the real org */
#22=PERSON_AND_ORGANIZATION(#20,#21);
/* Product definition under approval */
#30=PRODUCT('PART-202','Turbine Disc','High-speed rotating disc assembly',(#1));
#31=PRODUCT_DEFINITION_FORMATION('rev_D','Release candidate D',#30);
#32=PRODUCT_DEFINITION('design','',#31,PRODUCT_DEFINITION_CONTEXT(#1,'design'));
/* APPROVAL entity marking the design as approved */
#40=APPROVAL(APPROVAL_STATUS('approved'),'Rev D design gate approval');
/* Byte assertion: contains(b'APPROVAL_PERSON_ORGANIZATION') */
/* DEFECT: APPROVAL_PERSON_ORGANIZATION references #22 which contains empty PERSON #20 */
/* The approval role 'approver' requires a named individual; none is present */
/* A receiving system cannot record 'who approved rev_D' — audit trail is broken */
#41=APPROVAL_PERSON_ORGANIZATION(#22,#40,APPROVAL_ROLE('approver'));
#42=APPLIED_APPROVAL_ASSIGNMENT(#40,(#32));
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#500=GEOMETRIC_CURVE_SET('ap203-approval-person-org-empty-person-identity',
  (#20,#21,#22,#30,#31,#32,#40,#41,#42));
/* Product chain */
#600=APPLICATION_CONTEXT('mechanical design');
#601=PRODUCT_CONTEXT('',#600,'mechanical');
#602=PRODUCT('M138','M138','M138',(#601));
#603=PRODUCT_DEFINITION_FORMATION('','',#602);
#604=PRODUCT_DEFINITION_CONTEXT(#600,'design');
#605=PRODUCT_DEFINITION('','',#603,#604);
#606=PRODUCT_DEFINITION_SHAPE('','',#605);
#607=SHAPE_REPRESENTATION('',(#500),#14);
#608=SHAPE_DEFINITION_REPRESENTATION(#606,#607);
ENDSEC;
END-ISO-10303-21;
