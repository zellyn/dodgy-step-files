#7=CARTESIAN_POINT('cgr_origin',(0.,0.,0.));
#8=DIRECTION('cgr_z',(0.,0.,1.));
#9=DIRECTION('cgr_x',(1.,0.,0.));
#10=AXIS2_PLACEMENT_3D('cgr_placement',#7,#8,#9);
#11=PLANE('supp_ref_plane',#10);
#12=CONSTRUCTIVE_GEOMETRY_REPRESENTATION('supplemental_geom',(#11,#6),$);
#13=GEOMETRIC_CURVE_SET('supplemental-geometry-unsupported-type',(#12,#11,#6));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('M033','M033','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
