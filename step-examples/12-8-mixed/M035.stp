ISO-10303-21;
/* M035 - Single-item CONSTRUCTIVE_GEOMETRY_REPRESENTATION crashes
 * translator.
 * Defect: STEP CGR with only one representation item caused exception
 * during OCCT translation (Mantis 31472, fixed in 1e1b83c). Readers
 * must accept single-item representations. */
HEADER;
FILE_DESCRIPTION(('M035 test case','single-item CGR'),'2;1');
FILE_NAME('M035.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2014,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-6),#10,'distance_accuracy_value','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
     REPRESENTATION_CONTEXT('part','3D'));
/* One supplemental plane. */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=DIRECTION('',(0.0,0.0,1.0));
#102=DIRECTION('',(1.0,0.0,0.0));
#103=AXIS2_PLACEMENT_3D('',#100,#101,#102);
#104=PLANE('only_item',#103);
/* CGR with exactly one item - the historical crash trigger. */
#200=CONSTRUCTIVE_GEOMETRY_REPRESENTATION('single_item_cgr',
       (#104),#14);
ENDSEC;
END-ISO-10303-21;
