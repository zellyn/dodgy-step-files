ISO-10303-21;
/* M152: AP210 microvia depth exceeds substrate thickness */
/* DEFECT: VIA_DEFINITION drill depth 0.5mm > LAMINATE_TABLE total 0.4mm */
/* The drill exits 0.1mm through the back copper — physically impossible */
/* Per ISO 10303-210 §6 via depth must not exceed stackup thickness */
/* Byte assertion: contains(b'ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN') */
/* Byte assertion: contains(b'VIA_DEFINITION') */
/* Byte assertion: contains(b'LAMINATE_TABLE') */
HEADER;
FILE_DESCRIPTION(('M152: AP210 microvia drill depth exceeds board thickness'),'2;1');
FILE_NAME('M152.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN') */
FILE_SCHEMA(('ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN { 1 0 10303 210 3 1 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('electronic_assembly_interconnect_and_packaging_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'electronic_assembly_interconnect_and_packaging_design',2014,#1);
/* Standard unit context (mm) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('pcb','3D'));
/* Stackup layers: total = 0.015+0.015+0.355+0.015+0.015 = 0.415 mm */
#100=LAMINATE_OR_PLY_DEFINITION('copper_top',LENGTH_MEASURE(0.015),$);
#101=LAMINATE_OR_PLY_DEFINITION('prepreg_top',LENGTH_MEASURE(0.015),$);
#102=LAMINATE_OR_PLY_DEFINITION('core',LENGTH_MEASURE(0.355),$);
#103=LAMINATE_OR_PLY_DEFINITION('prepreg_bot',LENGTH_MEASURE(0.015),$);
#104=LAMINATE_OR_PLY_DEFINITION('copper_bot',LENGTH_MEASURE(0.015),$);
/* Byte assertion: contains(b'LAMINATE_TABLE') */
/* LAMINATE_TABLE: ordered layer stack, total thickness ~0.4mm */
#110=LAMINATE_TABLE('pcb_stackup',(#100,#101,#102,#103,#104));
/* Byte assertion: contains(b'VIA_DEFINITION') */
/* DEFECT: microvia drill depth 0.5mm > board thickness 0.415mm */
/* The drill exits through the back copper — fabrication is impossible */
#120=VIA_DEFINITION('microvia_1',LENGTH_MEASURE(0.5),LENGTH_MEASURE(0.2),#100,#104);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#200=GEOMETRIC_CURVE_SET('ap210-microvia-depth-exceeds-substrate-thickness',
  (#100,#101,#102,#103,#104,#110,#120));
/* Product chain */
#400=APPLICATION_CONTEXT('mechanical design');
#401=PRODUCT_CONTEXT('',#400,'mechanical');
#402=PRODUCT('M152','M152','M152',(#401));
#403=PRODUCT_DEFINITION_FORMATION('','',#402);
#404=PRODUCT_DEFINITION_CONTEXT(#400,'design');
#405=PRODUCT_DEFINITION('','',#403,#404);
#406=PRODUCT_DEFINITION_SHAPE('','',#405);
#407=SHAPE_REPRESENTATION('',(#200),#14);
#408=SHAPE_DEFINITION_REPRESENTATION(#406,#407);
ENDSEC;
END-ISO-10303-21;
