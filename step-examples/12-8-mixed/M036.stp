ISO-10303-21;
/* M036: GEOMETRIC_CURVE_SET containing datum-target frame with near-parallel DIRECTION vectors whose cross-product norm is <= 0.05; input: AP242 STEP file where two direction vectors used to define a datum-target or supplemental-geometry AXIS2_PLACEMENT_3D are nearly identical (angle < 0.05 rad), making the orthonormal frame ill-conditioned; the z-axis is (0.,0.,1.) and x-axis is (0.001,0.,1.) — norm of cross product is ~0.001, below the 0.05 threshold; kernel must warn and heal by substituting a numerically stable frame, or reject with a diagnostic; OCC silently accepts (no diagnostic, empty result); GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty; synonyms: datum target axes nearly identical, near-collinear DIRECTION pair, frame cross-product near zero, datum frame ill-conditioned */
HEADER;
FILE_DESCRIPTION(('M036'),'2;1');
FILE_NAME('M036.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('datum_target_origin',(0.,0.,0.));
#2=DIRECTION('datum_target_z',(0.,0.,1.));
#3=DIRECTION('datum_target_x',(0.001,0.,1.));
#4=AXIS2_PLACEMENT_3D('datum_target_frame',#1,#2,#3);
#5=PLANE('datum_target_plane',#4);
#6=CONSTRUCTIVE_GEOMETRY_REPRESENTATION('datum_target_supplemental_geom',(#5),$);
#7=GEOMETRIC_CURVE_SET('datum-target-axes-nearly-identical',(#6,#5,#4));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('M036','M036','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#7),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
END-ISO-10303-21;
