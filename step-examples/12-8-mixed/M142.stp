ISO-10303-21;
/* M142: AP203 CHANGE_REQUEST targets revision already superseded */
/* DEFECT: APPLIED_ACTION_ASSIGNMENT (change_request) targets #22 (rev_A) */
/* but PRODUCT_DEFINITION_RELATIONSHIP records rev_B (#24) as successor of rev_A */
/* The change request is stale: it targets an obsolete revision */
/* Per ISO 10303-203 §4.5 ECOs must target the current released baseline revision */
/* Byte assertion: contains(b'CONFIG_CONTROL_DESIGN') */
/* Byte assertion: contains(b'APPLIED_ACTION_ASSIGNMENT') */
/* Byte assertion: contains(b'PRODUCT_DEFINITION_RELATIONSHIP') */
HEADER;
FILE_DESCRIPTION(('M142: AP203 CHANGE_REQUEST APPLIED_ACTION_ASSIGNMENT targets superseded revision'),'2;1');
FILE_NAME('M142.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'CONFIG_CONTROL_DESIGN') */
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN { 1 0 10303 203 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('configuration controlled 3D designs of mechanical parts and assemblies');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'config_control_design',1994,#1);
/* Standard unit context (mm) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('ctx','3D'));
/* Product with two revisions: rev_A (old) and rev_B (current released baseline) */
#20=PRODUCT('PART-606','Gear Housing Cover','Sealed housing for gear assembly',(#1));
/* rev_A: the original design that has been superseded */
#21=PRODUCT_DEFINITION_FORMATION('rev_A','Original design release',#20);
/* #22 is the superseded PRODUCT_DEFINITION — the stale target of the change request */
#22=PRODUCT_DEFINITION('design','original release',#21,PRODUCT_DEFINITION_CONTEXT(#1,'design'));
/* rev_B: the released successor created by engineering change ECO-2024-047 */
#23=PRODUCT_DEFINITION_FORMATION('rev_B','ECO-2024-047 material change',#20);
/* #24 is the current PRODUCT_DEFINITION — the one the change request SHOULD target */
#24=PRODUCT_DEFINITION('design','material change applied',#23,PRODUCT_DEFINITION_CONTEXT(#1,'design'));
/* Byte assertion: contains(b'PRODUCT_DEFINITION_RELATIONSHIP') */
/* Succession record: rev_B (#24) is derived from rev_A (#22) */
/* This relationship formally marks #22 (rev_A) as superseded */
/* Any change request that targets #22 is by definition stale */  
#30=PRODUCT_DEFINITION_RELATIONSHIP('eco','derived_from',#22,#24);
/* ACTION representing the in-flight engineering change request ECO-2024-099 */
#35=ACTION('ECO-2024-099','Update sealing gasket specification',$);
#36=ACTION_METHOD('change_request','Standard ECO review procedure',$,'open');
/* Byte assertion: contains(b'APPLIED_ACTION_ASSIGNMENT') */
/* DEFECT: items=(#22) targets rev_A — the superseded PRODUCT_DEFINITION */
/* The correct target is #24 (rev_B, the current baseline) */   
/* A PDM tool checking effective revision before routing ECO-2024-099 would */
/* detect that #22 is no longer the head revision and reject or re-target */
#40=APPLIED_ACTION_ASSIGNMENT(#35,(#22),ACTION_REQUEST_SOLUTION(#36,#35));
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#500=GEOMETRIC_CURVE_SET('ap203-change-request-targets-superseded-revision-rev-A',
  (#20,#21,#22,#23,#24,#30,#35,#36,#40));
/* Product chain */
#600=APPLICATION_CONTEXT('mechanical design');
#601=PRODUCT_CONTEXT('',#600,'mechanical');
#602=PRODUCT('M142','M142','M142',(#601));
#603=PRODUCT_DEFINITION_FORMATION('','',#602);
#604=PRODUCT_DEFINITION_CONTEXT(#600,'design');
#605=PRODUCT_DEFINITION('','',#603,#604);
#606=PRODUCT_DEFINITION_SHAPE('','',#605);
#607=SHAPE_REPRESENTATION('',(#500),#14);
#608=SHAPE_DEFINITION_REPRESENTATION(#606,#607);
ENDSEC;
END-ISO-10303-21;
