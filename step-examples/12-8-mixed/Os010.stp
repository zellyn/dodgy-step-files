ISO-10303-21;
/* Os010 - Loft profiles have inconsistent edge counts.
 * Defect: triangle (3 edges) and pentagon (5 edges) submitted as
 * ThruSections profiles. Encoded: 3 EDGE_CURVEs + EDGE_LOOP for the
 * triangle and 5 EDGE_CURVEs + EDGE_LOOP for the pentagon. */
HEADER;
FILE_DESCRIPTION(('Os010 test case','Loft profiles inconsistent edge counts'),'2;1');
FILE_NAME('Os010.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Triangle profile vertices and points (z=0) */
#10=CARTESIAN_POINT('tri1',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('tri2',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('tri3',(0.5,1.0,0.0));
#13=VERTEX_POINT('',#10);
#14=VERTEX_POINT('',#11);
#15=VERTEX_POINT('',#12);
/* Triangle direction/vectors/lines */
#16=DIRECTION('',(1.0,0.0,0.0));
#17=VECTOR('',#16,1.0);
#18=LINE('',#10,#17);
#19=DIRECTION('',(-0.4472135954999579,0.8944271909999159,0.0));
#20=VECTOR('',#19,1.118);
#21=LINE('',#11,#20);
#22=DIRECTION('',(-0.4472135954999579,-0.8944271909999159,0.0));
#23=VECTOR('',#22,1.118);
#24=LINE('',#12,#23);
/* 3 triangle edges */
#25=EDGE_CURVE('tri_e1',#13,#14,#18,.T.);
#26=EDGE_CURVE('tri_e2',#14,#15,#21,.T.);
#27=EDGE_CURVE('tri_e3',#15,#13,#24,.T.);
#28=ORIENTED_EDGE('',*,*,#25,.T.);
#29=ORIENTED_EDGE('',*,*,#26,.T.);
#30=ORIENTED_EDGE('',*,*,#27,.T.);
#31=EDGE_LOOP('triangle_loop',(#28,#29,#30));
/* Pentagon profile vertices (z=1) */
#40=CARTESIAN_POINT('p1',(0.0,0.0,1.0));
#41=CARTESIAN_POINT('p2',(1.0,0.0,1.0));
#42=CARTESIAN_POINT('p3',(1.3,1.0,1.0));
#43=CARTESIAN_POINT('p4',(0.5,1.5,1.0));
#44=CARTESIAN_POINT('p5',(-0.3,1.0,1.0));
#45=VERTEX_POINT('',#40);
#46=VERTEX_POINT('',#41);
#47=VERTEX_POINT('',#42);
#48=VERTEX_POINT('',#43);
#49=VERTEX_POINT('',#44);
/* Pentagon directions/vectors/lines */
#50=DIRECTION('',(1.0,0.0,0.0));
#51=VECTOR('',#50,1.0);
#52=LINE('',#40,#51);
#53=DIRECTION('',(0.2873478855663454,0.9578262852211513,0.0));
#54=VECTOR('',#53,1.044);
#55=LINE('',#41,#54);
#56=DIRECTION('',(-0.8479983040050879,0.5299989400031799,0.0));
#57=VECTOR('',#56,0.943);
#58=LINE('',#42,#57);
#59=DIRECTION('',(-0.8479983040050879,-0.5299989400031799,0.0));
#60=VECTOR('',#59,0.943);
#61=LINE('',#43,#60);
#62=DIRECTION('',(0.2873478855663454,-0.9578262852211513,0.0));
#63=VECTOR('',#62,1.044);
#64=LINE('',#44,#63);
/* 5 pentagon edges */
#65=EDGE_CURVE('pent_e1',#45,#46,#52,.T.);
#66=EDGE_CURVE('pent_e2',#46,#47,#55,.T.);
#67=EDGE_CURVE('pent_e3',#47,#48,#58,.T.);
#68=EDGE_CURVE('pent_e4',#48,#49,#61,.T.);
#69=EDGE_CURVE('pent_e5',#49,#45,#64,.T.);
#70=ORIENTED_EDGE('',*,*,#65,.T.);
#71=ORIENTED_EDGE('',*,*,#66,.T.);
#72=ORIENTED_EDGE('',*,*,#67,.T.);
#73=ORIENTED_EDGE('',*,*,#68,.T.);
#74=ORIENTED_EDGE('',*,*,#69,.T.);
#75=EDGE_LOOP('pentagon_loop',(#70,#71,#72,#73,#74));
ENDSEC;
END-ISO-10303-21;
