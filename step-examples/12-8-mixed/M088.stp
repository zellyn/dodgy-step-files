ISO-10303-21;
/* M088 - AP210 measurement context confusion: etherometric vs metric.
 * Defect: a PCB stackup uses etherometric (sheet-relative) coordinates
 * for ply outlines but the file's representation_context is the global
 * Cartesian (length-unit-bearing) one. Etherometric measurements are
 * normalized 0..1 across a sheet; consumed as mm, the ply outline
 * collapses to a sub-millimeter speck. */
HEADER;
FILE_DESCRIPTION(('M088 test case','AP210 etherometric vs metric context confusion'),'2;1');
FILE_NAME('M088.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN { 1 0 10303 210 3 1 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('electronic_assembly_interconnect_and_packaging_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'electronic_assembly_interconnect_and_packaging_design',2014,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10))
     REPRESENTATION_CONTEXT('pcb_metric','3D'));
/* The outline coordinates are 0..1 in normalized etherometric units,
 * but the context is mm - so the actual import scales them as mm and
 * produces a 1mm x 1mm board instead of a 100mm x 100mm one. */
#20=CARTESIAN_POINT('bl',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('br',(1.0,0.0,0.0));
#22=CARTESIAN_POINT('tr',(1.0,1.0,0.0));
#23=CARTESIAN_POINT('tl',(0.0,1.0,0.0));
#24=POLYLINE('etherometric_outline',(#20,#21,#22,#23,#20));
#100=LAMINATE_OR_PLY_DEFINITION('core',$,$,$,LENGTH_MEASURE(0.2));
#101=PLY_BOUNDARY_REPRESENTATION('core_outline',(#24),#14);
/* No SCALAR_TIMES or context-conversion linking etherometric coords
 * to physical mm. */
ENDSEC;
END-ISO-10303-21;
