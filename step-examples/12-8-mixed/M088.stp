ISO-10303-21;
/* M088: AP210 etherometric vs metric measurement context confusion */
/* DEFECT: PLY_BOUNDARY_REPRESENTATION has etherometric (0..1) coords in mm context */
/* Consumed as mm, the 100mm PCB board collapses to a 1mm speck */
/* Byte assertion: contains(b'ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN') */
/* Byte assertion: contains(b'PLY_BOUNDARY_REPRESENTATION') */
/* Byte assertion: contains(b'LAMINATE_OR_PLY_DEFINITION') */
HEADER;
FILE_DESCRIPTION(('M088: AP210 etherometric vs metric context confusion'),'2;1');
FILE_NAME('M088.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN') */
FILE_SCHEMA(('ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN { 1 0 10303 210 3 1 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('electronic_assembly_interconnect_and_packaging_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'electronic_assembly_interconnect_and_packaging_design',2014,#1);
/* Unit context declares mm — but coordinates below are etherometric (0..1) */
/* This context mismatch is the defect: etherometric in metric context */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('pcb','3D'));
/* DEFECT: ply outline uses etherometric (sheet-normalized) unit-square coords */
/* In etherometric space these represent a 100mm x 100mm board corner locations */
/* Parsed as mm, the outline is only 1mm x 1mm — 100x too small */
/* Etherometric unit square corners: (0,0), (1,0), (1,1), (0,1) */
#20=CARTESIAN_POINT('bl',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('br',(1.0,0.0,0.0));
#22=CARTESIAN_POINT('tr',(1.0,1.0,0.0));
#23=CARTESIAN_POINT('tl',(0.0,1.0,0.0));
/* Closed POLYLINE outline (etherometric unit square — wrong in mm context) */
#25=POLYLINE('ply_outline',(#20,#21,#22,#23,#20));
/* Byte assertion: contains(b'LAMINATE_OR_PLY_DEFINITION') */
/* Stackup ply definition — references the mismatched boundary representation */
#100=LAMINATE_OR_PLY_DEFINITION('stackup_ply',$,$,$,LENGTH_MEASURE(0.2));
/* Byte assertion: contains(b'PLY_BOUNDARY_REPRESENTATION') */
/* DEFECT: PLY_BOUNDARY_REPRESENTATION uses etherometric coords (0..1) in mm context */
/* Receiver parsing this file treats coords as mm: 1mm board instead of 100mm */
#101=PLY_BOUNDARY_REPRESENTATION('ply_boundary',(#25),#14);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#300=GEOMETRIC_CURVE_SET('ap210-etherometric-vs-metric-context-confusion',
  (#25,#100,#101,#20,#21,#22,#23));
/* Product chain */
#400=APPLICATION_CONTEXT('mechanical design');
#401=PRODUCT_CONTEXT('',#400,'mechanical');
#402=PRODUCT('M088','M088','M088',(#401));
#403=PRODUCT_DEFINITION_FORMATION('','',#402);
#404=PRODUCT_DEFINITION_CONTEXT(#400,'design');
#405=PRODUCT_DEFINITION('','',#403,#404);
#406=PRODUCT_DEFINITION_SHAPE('','',#405);
#407=SHAPE_REPRESENTATION('',(#300),#14);
#408=SHAPE_DEFINITION_REPRESENTATION(#406,#407);
ENDSEC;
END-ISO-10303-21;
