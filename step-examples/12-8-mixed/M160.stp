ISO-10303-21;
/* M160 - STEP file imports as a near-empty document despite well-formed entities
 * Defect: SHAPE_REPRESENTATION_RELATIONSHIP links two reps but reader's traversal
 * only reaches one branch; the other representation's geometry is dropped. */
HEADER;
FILE_DESCRIPTION(('M160 - silent-empty import on file linked via SHAPE_REPRESENTATION_RELATIONSHIP'),'2;1');
FILE_NAME('M160.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('M160','silent empty','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
#22=CARTESIAN_POINT('',(0.0,0.0,0.0));
#23=CARTESIAN_POINT('',(1.0,0.0,0.0));
#24=VERTEX_POINT('',#22);
#25=VERTEX_POINT('',#23);
#26=DIRECTION('',(1.0,0.0,0.0));
#27=VECTOR('',#26,1.0);
#28=LINE('',#22,#27);
#29=EDGE_CURVE('',#24,#25,#28,.T.);
#31=ORIENTED_EDGE('',*,*,#29,.T.);
#32=EDGE_LOOP('',(#31));
#33=FACE_OUTER_BOUND('',#32,.T.);
#30=ADVANCED_FACE('',(#33),#20,.T.);
#40=CLOSED_SHELL('',(#30));
#50=MANIFOLD_SOLID_BREP('shape_inside_repB',#40);
#60=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#13)) REPRESENTATION_CONTEXT('','3D'));
#70=ADVANCED_BREP_SHAPE_REPRESENTATION('repA',(#13),#60);
#71=ADVANCED_BREP_SHAPE_REPRESENTATION('repB',(#50),#60);
#80=SHAPE_REPRESENTATION_RELATIONSHIP('','linkAB',#70,#71);
#90=SHAPE_DEFINITION_REPRESENTATION(#8,#70);
ENDSEC;
END-ISO-10303-21;
