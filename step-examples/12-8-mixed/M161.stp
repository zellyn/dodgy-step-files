ISO-10303-21;
/* M161 - Reader does not validate cross-references; dangling references silently accepted
 * Defect: EDGE_CURVE references entity #9999 which is never defined in the data section.
 * Reader silently treats as null, downstream call site receives partial shape. */
HEADER;
FILE_DESCRIPTION(('M161 - dangling reference silently accepted by STEP reader'),'2;1');
FILE_NAME('M161.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(1.0,0.0,0.0));
#12=VERTEX_POINT('',#10);
#13=VERTEX_POINT('',#11);
#14=DIRECTION('',(1.0,0.0,0.0));
#15=VECTOR('',#14,1.0);
/* Defect: EDGE_CURVE's underlying curve reference points to undefined entity #9999. */
#20=EDGE_CURVE('dangling_curve_ref',#12,#13,#9999,.T.);
ENDSEC;
END-ISO-10303-21;
