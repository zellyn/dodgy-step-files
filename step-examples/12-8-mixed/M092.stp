ISO-10303-21;
/* M092 - AP238 workplan with workingsteps in non-executable order.
 * Defect: a finishing operation appears in the workplan element list
 * BEFORE the roughing operation that targets the same feature. AP238
 * §6.4 makes the workplan list the executable sequence; running this
 * file as written cuts the finish pass into raw stock. */
HEADER;
FILE_DESCRIPTION(('M092 test case','AP238 workplan order finishing before roughing'),'2;1');
FILE_NAME('M092.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 1 0 0 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('numerical_control_machining');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'numerical_control_machining',2007,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10))
     REPRESENTATION_CONTEXT('nc','3D'));
/* Both ops target the same feature #500. */
#100=MACHINING_OPERATION('finish_pocket',$,$,$,$,#500);
#101=MACHINING_OPERATION('rough_pocket',$,$,$,$,#500);
/* Defect: WORKPLAN lists finish (#100) before rough (#101). */
#200=WORKPLAN('main',(#100,#101),$,$,$);
#500=CARTESIAN_POINT('feature_locator',(50.0,30.0,0.0));
ENDSEC;
END-ISO-10303-21;
