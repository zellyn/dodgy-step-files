ISO-10303-21;
/* Os009: GEOMETRIC_CURVE_SET containing two loft profiles; profile 1: closed WIRE — single CIRCLE edge (v_seam to v_seam); profile 2: open WIRE — single LINE edge (v0 to v1) at z=5; mixing closed and open profiles breaks ThruSections topology; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty; no orphaned entities */
HEADER;
FILE_DESCRIPTION(('Os009'),'2;1');
FILE_NAME('Os009.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
