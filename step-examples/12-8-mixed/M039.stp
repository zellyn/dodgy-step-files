ISO-10303-21;
/* M039: STYLED_ITEM not parented under MDGPR/DRAUGHTING_MODEL (Autodesk Inventor 2014); input: AP214 STEP file with MANIFOLD_SOLID_BREP (1 mm cube) where two STYLED_ITEM entities reference cube faces with colour bindings but are not placed inside any MECHANICAL_DESIGN_GEOMETRIC_PRESENTATION_REPRESENTATION or DRAUGHTING_MODEL wrapper; OCCT ec661e4 (Mantis 0024159): reader skipped bare STYLED_ITEMs, dropping all colors on import; kernel must heal: accept and apply styles even without a presentation-representation parent; synonyms: STYLED_ITEM not under MDGPR, Inventor styled_item dropped, presentation parent missing, all colors lost on Inventor STEP */
HEADER;
FILE_DESCRIPTION(('M039'),'2;1');
FILE_NAME('M039.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
