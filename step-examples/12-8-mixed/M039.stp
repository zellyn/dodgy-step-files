/* Defect: bare STYLED_ITEMs with no MDGPR/DRAUGHTING_MODEL parent.
   Autodesk Inventor 2014 emits STYLED_ITEM at the top level.
   OCCT ec661e4 (Mantis 0024159) silently skips them — all colors lost.
   Both STYLED_ITEMs reference a real face (#5850) with a COLOUR_RGB. */
#600=COLOUR_RGB('inventor_red',0.8,0.1,0.1);
#601=FILL_AREA_STYLE_COLOUR('',#600);
#602=FILL_AREA_STYLE('',(#601));
#603=SURFACE_STYLE_FILL_AREA(#602);
#604=SURFACE_SIDE_STYLE('',(#603));
#605=SURFACE_STYLE_USAGE(.BOTH.,#604);
#606=PRESENTATION_STYLE_ASSIGNMENT((#605));
/* Bare STYLED_ITEM: not inside MDGPR or DRAUGHTING_MODEL. Inventor bug. */
#607=STYLED_ITEM('bottom_face_style',(#606),#5850);
#610=COLOUR_RGB('inventor_blue',0.1,0.1,0.8);
#611=FILL_AREA_STYLE_COLOUR('',#610);
#612=FILL_AREA_STYLE('',(#611));
