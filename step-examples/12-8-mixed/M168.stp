ISO-10303-21;
/* M168 - AP238 TURNING_FINISHING_FACE with feed direction inverted.
 * Defect: a face-turning finishing op declares a feed_direction vector
 * pointing OUTWARD (toward the chuck) instead of toward the spindle axis.
 * The tool retracts during what should be the finishing pass, leaving
 * uncut stock and a witness mark from the entry point. */
HEADER;
FILE_DESCRIPTION(('M168 test case','AP238 face-turning feed direction reversed'),'2;1');
FILE_NAME('M168.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 1 0 0 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('numerical_control_machining');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'numerical_control_machining',2007,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10))
     REPRESENTATION_CONTEXT('nc','3D'));
/* For face-turning the feed should point inward (-X toward axis).
   Defect: feed_direction is +X (outward, away from axis). */
#50=DIRECTION('feed_outward_WRONG',(1.0,0.0,0.0));
#100=TURNING_FINISHING_FACE('finish_face_op',$,$,$,$,$,$,#50);
#200=WORKPLAN('main',(#100),$,$,$);
ENDSEC;
END-ISO-10303-21;
