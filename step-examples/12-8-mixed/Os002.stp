ISO-10303-21;
/* Os002 - Inward offset by exactly cylinder radius (degenerate).
 * Defect: cylinder radius 5; offset distance 5 inward; result is
 * the cylinder axis (a line) - no surface. */
HEADER;
FILE_DESCRIPTION(('Os002 - degenerate offset to axis','Pass C gap-fill'),'2;1');
FILE_NAME('Os002.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=CYLINDRICAL_SURFACE('cyl_r5',#13,5.0);
/* Offset distance: -5.0 mm (inward; equal to cylinder radius -> degenerate
 * collapse to the cylinder axis). Encoded as MEASURE_WITH_UNIT in DATA. */
#20=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#21=MEASURE_WITH_UNIT(LENGTH_MEASURE(-5.0),#20);
#22=OFFSET_SURFACE(#14,-5.0,.F.);
ENDSEC;
END-ISO-10303-21;
