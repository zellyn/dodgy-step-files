ISO-10303-21;
/* M004 - Watertightness lost: each tessellated face has its own
 * COORDINATES_LIST with quantization-different shared-edge vertices.
 * Defect: Best practice is one COORDINATES_LIST per tessellated solid
 * plus TESSELLATED_CONNECTING_EDGE per shared edge. Here the cube's
 * six faces each define their own list. The shared corners differ
 * after the 6th decimal (1.0000003 vs 0.9999997 vs 1.0). Vertices are
 * therefore not bitwise-equal across faces and the resulting mesh has
 * sub-tolerance gaps along every shared edge. Healers should merge
 * within model uncertainty. */
HEADER;
FILE_DESCRIPTION(('M004 test case','per-face coordinates_list breaks watertightness'),'2;1');
FILE_NAME('M004.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2014,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-6),#10,'distance_accuracy_value','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
     REPRESENTATION_CONTEXT('part','3D'));
/* Six independent coordinates_lists - shared corners differ in the
 * last few digits. */
#100=COORDINATES_LIST('bottom_z0',4,
  ((0.0000000,0.0000000,0.0000000),(1.0000003,0.0000000,0.0000000),
   (1.0000003,1.0000003,0.0000000),(0.0000000,1.0000003,0.0000000)));
#110=TRIANGULATED_FACE('bottom',#100,$,$,(),((1,2,3),(1,3,4)));
#101=COORDINATES_LIST('top_z1',4,
  ((0.0000000,0.0000000,0.9999997),(1.0000000,0.0000000,0.9999997),
   (1.0000000,1.0000000,0.9999997),(0.0000000,1.0000000,0.9999997)));
#111=TRIANGULATED_FACE('top',#101,$,$,(),((1,2,3),(1,3,4)));
#102=COORDINATES_LIST('front_y0',4,
  ((0.0000000,0.0000000,0.0000003),(1.0000000,0.0000000,0.0000003),
   (1.0000000,0.0000000,1.0000000),(0.0000000,0.0000000,1.0000000)));
#112=TRIANGULATED_FACE('front',#102,$,$,(),((1,2,3),(1,3,4)));
#103=COORDINATES_LIST('back_y1',4,
  ((0.0000000,0.9999997,0.0000000),(1.0000000,0.9999997,0.0000000),
   (1.0000000,0.9999997,1.0000003),(0.0000000,0.9999997,1.0000003)));
#113=TRIANGULATED_FACE('back',#103,$,$,(),((1,2,3),(1,3,4)));
#104=COORDINATES_LIST('left_x0',4,
  ((0.0000000,0.0000000,0.0000000),(0.0000000,1.0000000,0.0000000),
   (0.0000000,1.0000000,1.0000000),(0.0000000,0.0000000,1.0000000)));
#114=TRIANGULATED_FACE('left',#104,$,$,(),((1,2,3),(1,3,4)));
#105=COORDINATES_LIST('right_x1',4,
  ((1.0000003,0.0000000,0.0000000),(1.0000003,1.0000000,0.0000000),
   (1.0000003,1.0000000,1.0000000),(1.0000003,0.0000000,1.0000000)));
#115=TRIANGULATED_FACE('right',#105,$,$,(),((1,2,3),(1,3,4)));
/* Solid bundles them - no tessellated_connecting_edge between faces */
#120=TESSELLATED_SOLID('leaky_cube',(#110,#111,#112,#113,#114,#115),$);
#200=TESSELLATED_SHAPE_REPRESENTATION('',(#120),#14);
ENDSEC;
END-ISO-10303-21;
