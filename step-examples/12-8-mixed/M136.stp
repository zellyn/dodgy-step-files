ISO-10303-21;
/* M136 - AP203 APPROVED_ITEM points to a product not in the design pool.
 * Defect: an APPROVAL is bound via CC_DESIGN_APPROVAL to a
 * PRODUCT_DEFINITION (#999) that was never declared in the file's
 * design pool. The approval references a phantom product. The
 * approval cycle is broken - what was approved cannot be located. */
HEADER;
FILE_DESCRIPTION(('M136 test case','AP203 approval points to phantom product'),'2;1');
FILE_NAME('M136.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('configuration controlled 3D design of mechanical parts and assemblies');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','config_control_design',1994,#1);
#10=PRODUCT('real_part','real_part','present in pool',(#1));
#20=PRODUCT_DEFINITION_FORMATION('rev_A','released',#10);
#30=PRODUCT_DEFINITION('design','',#20,#1);
#40=APPROVAL_STATUS('approved');
#41=APPROVAL('formal_approval',#40);
/* Defect: CC_DESIGN_APPROVAL references PD #999 which is undeclared. */
#100=CC_DESIGN_APPROVAL(#41,(#999));
ENDSEC;
END-ISO-10303-21;
