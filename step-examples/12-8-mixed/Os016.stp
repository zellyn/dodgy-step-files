ISO-10303-21;
/* Os016 - Draft edge recomputation produces multi-component intersection.
 * Defect: two ADVANCED_FACEs sharing one EDGE_CURVE, with different
 * draft-angle SHAPE_ASPECTs. After drafting, the new surfaces' intersection
 * is non-simple; the kernel cannot pick a unique edge curve. */
HEADER;
FILE_DESCRIPTION(('Os016 test case','Draft edge multi-component intersection'),'2;1');
FILE_NAME('Os016.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('part1','part1','part1',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
/* Shared edge endpoints */
#20=CARTESIAN_POINT('shared_edge_v1',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('shared_edge_v2',(1.0,0.0,0.0));
#22=VERTEX_POINT('',#20);
#23=VERTEX_POINT('',#21);
/* Shared edge */
#24=DIRECTION('',(1.0,0.0,0.0));
#25=VECTOR('',#24,1.0);
#26=LINE('shared_line',#20,#25);
#27=EDGE_CURVE('shared_edge',#22,#23,#26,.T.);
/* Two surfaces meeting along the shared edge */
#30=DIRECTION('',(0.0,0.0,1.0));
#31=DIRECTION('',(1.0,0.0,0.0));
#32=AXIS2_PLACEMENT_3D('',#20,#30,#31);
#33=PLANE('face_a_plane',#32);
#34=DIRECTION('',(0.0,1.0,0.0));
#35=AXIS2_PLACEMENT_3D('',#20,#34,#31);
#36=PLANE('face_b_plane',#35);
/* Two ADVANCED_FACEs sharing the edge */
#40=ORIENTED_EDGE('',*,*,#27,.T.);
#41=EDGE_LOOP('',(#40));
#42=FACE_OUTER_BOUND('',#41,.T.);
#43=ADVANCED_FACE('face_a',(#42),#33,.T.);
#44=ADVANCED_FACE('face_b',(#42),#36,.T.);
/* Per-face draft-angle SHAPE_ASPECTs (very different angles) */
#50=SHAPE_ASPECT('draft_a','draft 5 deg',#15,.T.);
#51=SHAPE_ASPECT('draft_b','draft 60 deg',#15,.T.);
/* Add SDR linking PRODUCT to existing geometry. */
#9000=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9001=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9002=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9003=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9000,'distance_accuracy_value','');
#9004=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9003))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9000,#9001,#9002))REPRESENTATION_CONTEXT('','3D'));
#9010=OPEN_SHELL('wrap_shell',(#43,#44));
#9011=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9010));
#9020=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9011),#9004);
#9021=SHAPE_DEFINITION_REPRESENTATION(#15,#9020);
ENDSEC;
END-ISO-10303-21;
