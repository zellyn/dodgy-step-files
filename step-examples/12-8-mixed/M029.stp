ISO-10303-21;
/* M029 - PMI-count validation property failure.
 * Defect: number of dimensions / GD&T tolerances / datum features is
 * embedded as a validation property; receiver reports a different
 * count after import. Typically because some PMI was tagged graphic-
 * only and dropped, or composite callouts were exploded.
 * Recorded counts: 12 PMI annotations total, 6 dimensions, 4
 * tolerances, 2 datums. Receiver parses only 10 (graphic-only PMI was
 * stripped). Archive systems must reject; CAD-to-CAD must warn. */
HEADER;
FILE_DESCRIPTION(('M029 test case','PMI count validation mismatch'),'2;1');
FILE_NAME('M029.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2014,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-6),#10,'distance_accuracy_value','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
     REPRESENTATION_CONTEXT('part','3D'));
#300=PRODUCT('part','part','',(#310));
#310=MECHANICAL_CONTEXT('',#1,'mechanical');
#320=PRODUCT_DEFINITION_FORMATION('','',#300);
#330=PRODUCT_DEFINITION('design','',#320,#340);
#340=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#350=PRODUCT_DEFINITION_SHAPE('','',#330);
/* Validation property: PMI counts. */
#400=PROPERTY_DEFINITION('geometric validation property',
       'PMI counts',#350);
/* Recorded: 12 annotations total, 6 dimensions, 4 tolerances, 2 datums.
 * Receiver actually parses 10 - graphic-only PMI dropped. */
#410=INTEGER_REPRESENTATION_ITEM('number of annotations',12.);
#411=INTEGER_REPRESENTATION_ITEM('number of dimensions',6.);
#412=INTEGER_REPRESENTATION_ITEM('number of tolerances',4.);
#413=INTEGER_REPRESENTATION_ITEM('number of datums',2.);
#420=REPRESENTATION('pmi_counts',(#410,#411,#412,#413),#14);
#430=PROPERTY_DEFINITION_REPRESENTATION(#400,#420);
ENDSEC;
END-ISO-10303-21;
