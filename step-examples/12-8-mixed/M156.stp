ISO-10303-21;
/* M156: AP210 power net carries only mechanical placement constraint */
/* DEFECT: NETWORK 'PWR_5V' has mechanical_placement_constraint but no electrical constraint */
/* Power rail needs current_capacity / voltage_rating for validation */
/* ECAD exporter dropped electrical-class constraints during export */
/* Per ISO 10303-210 §7 power-distribution net requires electrical attribute */
/* Byte assertion: contains(b'ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN') */
/* Byte assertion: contains(b"NETWORK('PWR_5V'") */
/* Byte assertion: contains(b'mechanical_placement_constraint') */
HEADER;
FILE_DESCRIPTION(('M156: AP210 PWR_5V net has only mechanical constraint, no electrical'),'2;1');
FILE_NAME('M156.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN') */
FILE_SCHEMA(('ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN { 1 0 10303 210 3 1 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('electronic_assembly_interconnect_and_packaging_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'electronic_assembly_interconnect_and_packaging_design',2014,#1);
/* Standard unit context (mm) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('pcb','3D'));
/* VCC entry terminal on the power connector */
#51=CARTESIAN_POINT('VCC_PIN_loc',(2.0,2.0,0.0));
#50=TERMINAL('VCC_PIN',#51);
/* Byte assertion: contains(b"NETWORK('PWR_5V'") */
/* DEFECT: NETWORK 'PWR_5V' — 5V power rail — will receive only a mechanical property */
#60=NETWORK('PWR_5V',(#50));
/* Byte assertion: contains(b'mechanical_placement_constraint') */
/* PROPERTY_DEFINITION with only a mechanical placement constraint — missing electrical */
#70=PROPERTY_DEFINITION('mechanical_placement_constraint',
  'Component spacing rule for 5V rail',#60);
#71=DESCRIPTIVE_REPRESENTATION_ITEM('mechanical_placement_constraint',
  '0.2mm_min_clearance');
#72=REPRESENTATION('mech_props',(#71),#14);
#73=PROPERTY_DEFINITION_REPRESENTATION(#70,#72);
/* NOTE: no current_capacity, voltage_rating, or impedance PROPERTY_DEFINITION */
/* The absence of electrical constraint is the defect per ISO 10303-210 §7 */
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#200=GEOMETRIC_CURVE_SET('ap210-power-net-no-electrical-constraint-pwr5v-mechanical-only',
  (#50,#51,#60,#70,#71,#72,#73));
/* Product chain */
#400=APPLICATION_CONTEXT('mechanical design');
#401=PRODUCT_CONTEXT('',#400,'mechanical');
#402=PRODUCT('M156','M156','M156',(#401));
#403=PRODUCT_DEFINITION_FORMATION('','',#402);
#404=PRODUCT_DEFINITION_CONTEXT(#400,'design');
#405=PRODUCT_DEFINITION('','',#403,#404);
#406=PRODUCT_DEFINITION_SHAPE('','',#405);
#407=SHAPE_REPRESENTATION('',(#200),#14);
#408=SHAPE_DEFINITION_REPRESENTATION(#406,#407);
ENDSEC;
END-ISO-10303-21;
