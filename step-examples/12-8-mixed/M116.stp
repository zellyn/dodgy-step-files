ISO-10303-21;
/* M116 - AP209 modal extraction request exceeds DOF rank.
 * Defect: a FEA_MODEL_3D has 3 free nodes (9 active DOFs) but a modal
 * extraction parameter requests 50 modes. The eigensolver either
 * returns 9 real modes plus 41 NaN entries, or fails outright. */
HEADER;
FILE_DESCRIPTION(('M116 test case','AP209 mode count exceeds DOF rank'),'2;1');
FILE_NAME('M116.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('STRUCTURAL_ANALYSIS_DESIGN { 1 0 10303 209 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('structural_analysis_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'structural_analysis_design',2001,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10))
     REPRESENTATION_CONTEXT('fea','3D'));
#100=CARTESIAN_POINT('a',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('b',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('c',(0.0,1.0,0.0));
#110=NODE('n1',(#100),$);
#111=NODE('n2',(#101),$);
#112=NODE('n3',(#102),$);
#150=NODE_GROUP('mesh_nodes',(#110,#111,#112),$);
/* Defect: model has 9 DOFs; modal request asks for 50 modes
   (encoded in the model's description). */
#200=FEA_MODEL_3D('modal_test_model_50_modes_requested',$,#150,$,$);
ENDSEC;
END-ISO-10303-21;
