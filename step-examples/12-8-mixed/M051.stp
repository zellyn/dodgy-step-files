ISO-10303-21;
/* M051 - Bare GEOMETRIC_SET / GEOMETRIC_CURVE_SET with non-geometric
 * children, or mesh-as-surfaces.
 * Defect: STEP `GEOMETRIC_SET`/`GEOMETRIC_CURVE_SET` may aggregate
 * items beyond curve/surface/point - axis placements, scalar measures,
 * descriptive text - or may be populated only with bounded surfaces
 * with no shell/face superstructure. Many importers reject as
 * "no solid found" or skip silently.
 * This fixture aggregates a LINE + AXIS2_PLACEMENT_3D + descriptive
 * text inside one GEOMETRIC_SET, plus a free-standing
 * B_SPLINE_SURFACE_WITH_KNOTS in another - neither has any face/shell
 * wrapping. */
HEADER;
FILE_DESCRIPTION(('M051 test case','GEOMETRIC_SET with non-geometric children and free surfaces'),'2;1');
FILE_NAME('M051.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-6),#10,'distance_accuracy_value','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
     REPRESENTATION_CONTEXT('part','3D'));
/* A line, an axis placement, and a descriptive text. None of these
 * are valid GEOMETRIC_SET children except the line. */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=DIRECTION('',(1.0,0.0,0.0));
#102=VECTOR('',#101,1.0);
#103=LINE('a_line',#100,#102);
#104=DIRECTION('',(0.0,0.0,1.0));
#105=AXIS2_PLACEMENT_3D('axis_at_origin',#100,#104,#101);
#106=DESCRIPTIVE_REPRESENTATION_ITEM('label','this is text not geometry');
/* Defect: GEOMETRIC_SET aggregates a LINE, an AXIS2_PLACEMENT and a
 * non-geometric DESCRIPTIVE_REPRESENTATION_ITEM. */
#200=GEOMETRIC_SET('mixed_set',(#103,#105,#106));
/* Free-standing B-spline surface with no face/shell wrapping. */
#300=CARTESIAN_POINT('',(0.0,0.0,0.0));
#301=CARTESIAN_POINT('',(1.0,0.0,0.0));
#302=CARTESIAN_POINT('',(0.0,1.0,0.0));
#303=CARTESIAN_POINT('',(1.0,1.0,1.0));
#310=B_SPLINE_SURFACE_WITH_KNOTS('free_surface',1,1,
       ((#300,#301),(#302,#303)),
       .UNSPECIFIED.,.F.,.F.,.F.,
       (2,2),(2,2),(0.0,1.0),(0.0,1.0),.UNSPECIFIED.);
#320=GEOMETRIC_SET('free_surfaces_only',(#310));
ENDSEC;
END-ISO-10303-21;
