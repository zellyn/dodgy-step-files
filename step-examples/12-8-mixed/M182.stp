ISO-10303-21;
/* M182: AP238 setup_instruction sequence with non-monotonic time stamps */
/* DEFECT: timestamps 09:00 -> 08:30 -> 09:15 are non-monotonic */
/* Instruction 'locate_workpiece' at 08:30 goes backward from 'mount_fixture' 09:00 */
/* Publisher copied stamps from different job or steps re-ordered without update */
/* Per ISO 10303-238 §5.4 and ISO 8601: setup-instruction timestamps must be monotonic */
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
/* Byte assertion: contains(b'SETUP_INSTRUCTION') */
/* Byte assertion: contains(b'2026-05-02T09:00:00') */
/* Byte assertion: contains(b'2026-05-02T08:30:00') */
HEADER;
FILE_DESCRIPTION(('M182: AP238 setup_instruction non-monotonic timestamps'),'2;1');
FILE_NAME('M182.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 3 1 1 1 }'));
ENDSEC;
DATA;
/* Standard unit context (mm) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('ctx','3D'));
/* mm length unit reference for MEASURE_WITH_UNIT */
#15=SI_UNIT(.MILLI.,.METRE.);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#20=GEOMETRIC_CURVE_SET('ap238-setup-instruction-non-monotonic-timestamps',
  (#51,#60));
/* Byte assertion: contains(b'SETUP_INSTRUCTION') */
/* Step 1: mount_fixture at 09:00 — first step, valid starting time */
/* Byte assertion: contains(b'2026-05-02T09:00:00') */
#40=SETUP_INSTRUCTION('mount_fixture','Mount fixture on machine table','2026-05-02T09:00:00',$);
/* DEFECT: locate_workpiece at 08:30 — goes BACKWARD from mount_fixture at 09:00 */
/* Byte assertion: contains(b'2026-05-02T08:30:00') */
#41=SETUP_INSTRUCTION('locate_workpiece','Locate workpiece in fixture','2026-05-02T08:30:00',$);
/* Step 3: tighten_clamps at 09:15 — forward from step 1 but after backward step 2 */
#42=SETUP_INSTRUCTION('tighten_clamps','Tighten workpiece clamps','2026-05-02T09:15:00',$);
/* WORKPIECE 'setup_workpiece' */
#60=WORKPIECE('setup_workpiece','Workpiece for non-monotonic setup test',$,$,$,$,$);
/* SETUP 'machine_setup' references all three setup instructions in declared order */
/* Declared sequence: #40 (09:00), #41 (08:30), #42 (09:15) — DEFECT: non-monotonic */
#51=SETUP('machine_setup',$,$,(#40,#41,#42),#60);
/* WORKPLAN: non-monotonic setup followed by no operations */
#50=WORKPLAN('non_monotonic_setup_program','Non-monotonic setup instruction workplan',(),$,());
/* Product chain */
#100=APPLICATION_CONTEXT('mechanical design');
#101=PRODUCT_CONTEXT('',#100,'mechanical');
#102=PRODUCT('M182','M182','M182',(#101));
#103=PRODUCT_DEFINITION_FORMATION('','',#102);
#104=PRODUCT_DEFINITION_CONTEXT(#100,'design');
#105=PRODUCT_DEFINITION('','',#103,#104);
#106=PRODUCT_DEFINITION_SHAPE('','',#105);
#107=SHAPE_REPRESENTATION('',(#20),#14);
#108=SHAPE_DEFINITION_REPRESENTATION(#106,#107);
ENDSEC;
END-ISO-10303-21;
