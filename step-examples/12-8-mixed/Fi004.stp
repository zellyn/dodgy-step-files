ISO-10303-21;
/* Fi004 - Faulty fillet contour: edges don't connect AND one self-crosses.
 * Defect: three EDGE_CURVEs submitted as one fillet contour:
 *   e1, e2 share vertex #21 (connected pair),
 *   e3_self_crossing is a B-spline whose control polygon describes a
 *   figure-eight (geometric self-cross),
 * meeting all three sub-conditions in the catalog claim. */
HEADER;
FILE_DESCRIPTION(('Fi004 test case','Faulty fillet contour: disjoint and self-crossing'),'2;1');
FILE_NAME('Fi004.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Three connected vertices for e1, e2 */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('',(2.0,0.0,0.0));
#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('shared',#11);
#22=VERTEX_POINT('',#12);
/* e1: linear segment 0..1; e2: linear segment 1..2 */
#30=DIRECTION('',(1.0,0.0,0.0));
#31=VECTOR('',#30,1.0);
#32=LINE('',#10,#31);
#33=LINE('',#11,#31);
#40=EDGE_CURVE('e1',#20,#21,#32,.T.);
#41=EDGE_CURVE('e2',#21,#22,#33,.T.);
/* Disjoint, self-crossing third edge: a B-spline with figure-eight
 * control polygon. Endpoints at (5,0,0) and (5,0,0) (closed) so the
 * curve's polygon crosses itself geometrically. */
#50=CARTESIAN_POINT('p0',(5.0,0.0,0.0));
#51=CARTESIAN_POINT('p1',(6.0,1.0,0.0));
#52=CARTESIAN_POINT('p2',(7.0,-1.0,0.0));
#53=CARTESIAN_POINT('p3',(7.0,1.0,0.0));
#54=CARTESIAN_POINT('p4',(6.0,-1.0,0.0));
#55=CARTESIAN_POINT('p5',(5.0,0.0,0.0));
#60=B_SPLINE_CURVE_WITH_KNOTS('figure_eight',3,(#50,#51,#52,#53,#54,#55),
       .UNSPECIFIED.,.F.,.F.,(4,2,4),(0.0,0.5,1.0),.UNSPECIFIED.);
#61=VERTEX_POINT('',#50);
#62=VERTEX_POINT('',#55);
#63=EDGE_CURVE('e3_self_crossing',#61,#62,#60,.T.);
/* {e1, e2, e3_self_crossing} is not a valid fillet contour:
 * e3 is disjoint from {e1,e2} AND self-crosses. */
/* PRODUCT chain so OCCT loads the geometry. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Fi004','Fi004','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#40,#41,#63));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
