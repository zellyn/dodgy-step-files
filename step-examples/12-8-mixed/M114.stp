ISO-10303-21;
/* M114: AP209 hex element with extreme aspect ratio 10000:1 */
/* DEFECT: hex spans 1000mm in X but only 0.1mm in Y and Z */
/* Stiffness matrix ill-conditioned; bending stresses diverge */
/* Byte assertion: contains(b'STRUCTURAL_ANALYSIS_DESIGN') */
/* Byte assertion: contains(b'VOLUME_3D_ELEMENT_DESCRIPTOR') */
HEADER;
FILE_DESCRIPTION(('M114: AP209 sliver hex element aspect ratio 10000:1'),'2;1');
FILE_NAME('M114.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'STRUCTURAL_ANALYSIS_DESIGN') */
FILE_SCHEMA(('STRUCTURAL_ANALYSIS_DESIGN { 1 0 10303 209 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('structural_analysis_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'structural_analysis_design',2001,#1);
/* Standard unit context */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('fea','3D'));
/* Ribbon hex corners: 1000mm in X, only 0.1mm in Y and Z — aspect ratio 10000:1 */
/* Bottom face (z=0.0) */
#100=CARTESIAN_POINT('n1',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('n2',(1000.0,0.0,0.0));
#102=CARTESIAN_POINT('n3',(1000.0,0.1,0.0));
#103=CARTESIAN_POINT('n4',(0.0,0.1,0.0));
/* Top face (z=0.1mm) — making the hex 1000mm × 0.1mm × 0.1mm */
#104=CARTESIAN_POINT('n5',(0.0,0.0,0.1));
#105=CARTESIAN_POINT('n6',(1000.0,0.0,0.1));
#106=CARTESIAN_POINT('n7',(1000.0,0.1,0.1));
#107=CARTESIAN_POINT('n8',(0.0,0.1,0.1));
#110=NODE('n1',(#100),$);
#111=NODE('n2',(#101),$);
#112=NODE('n3',(#102),$);
#113=NODE('n4',(#103),$);
#114=NODE('n5',(#104),$);
#115=NODE('n6',(#105),$);
#116=NODE('n7',(#106),$);
#117=NODE('n8',(#107),$);
/* NODE_GROUP containing all eight corner nodes */
#300=NODE_GROUP('sliver_nodes',(#110,#111,#112,#113,#114,#115,#116,#117),$);
#310=FEA_MODEL('sliver_model',$,'',(#300),(),());
/* Byte assertion: contains(b'VOLUME_3D_ELEMENT_DESCRIPTOR') */
/* DEFECT: hex8 with aspect ratio 10000:1 — 1000mm × 0.1mm × 0.1mm ribbon */
/* Stiffness matrix condition number ≈ aspect_ratio^2 = 1e8; solver ill-conditioned */
#400=VOLUME_3D_ELEMENT_DESCRIPTOR('hex8_sliver',.HEX.,
  (#110,#111,#112,#113,#114,#115,#116,#117));
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#500=GEOMETRIC_CURVE_SET('ap209-hex-element-aspect-ratio-greater-than-10000',
  (#110,#111,#112,#113,#114,#115,#116,#117,#310,#400));
/* Product chain */
#600=APPLICATION_CONTEXT('mechanical design');
#601=PRODUCT_CONTEXT('',#600,'mechanical');
#602=PRODUCT('M114','M114','M114',(#601));
#603=PRODUCT_DEFINITION_FORMATION('','',#602);
#604=PRODUCT_DEFINITION_CONTEXT(#600,'design');
#605=PRODUCT_DEFINITION('','',#603,#604);
#606=PRODUCT_DEFINITION_SHAPE('','',#605);
#607=SHAPE_REPRESENTATION('',(#500),#14);
#608=SHAPE_DEFINITION_REPRESENTATION(#606,#607);
ENDSEC;
END-ISO-10303-21;
