ISO-10303-21;
/* M194: TESSELLATED_SHELL whose topological_link references a real OPEN_SHELL entity (#38, own PLANE/EDGE_LOOP face) that is never itself wired into a MANIFOLD_SOLID_BREP or shape representation reachable from the model; input: AP242 file where a tessellated shell declares an exact-BRep counterpart the reader transfer graph never visits, so the topological_link entity is syntactically present but never bound in the transient-process map; wired as a direct shape_representation item (own COORDINATES_LIST, no GEOMETRIC_CURVE_SET wrapper) per the M193 finding that the GEOMETRIC_SET GRI-fallback path crashes OCCT independent of link content; StepToTopoDS_TranslateShell.cxx:140-157 looks up the link via aTP->Find() (a lookup, not a recursive translate), finds no binder, and falls back to a fresh TopoDS_Shell built from the shell own tessellated items with theHasGeom cleared; covers stp-tess-dangling-brep-link (shell subvariant); mirrors Pmi164 (single shared COORDINATES_LIST across 6 faces, no topological_link at all) fixed by using one face with its own coordinate list and an actual unresolvable topological_link; synonyms: tessellated shell dangling topological_link, unresolved exact-BRep shell counterpart, fresh shell on unbound link, TESSELLATED_SHELL topological_link unbound */
HEADER;
FILE_DESCRIPTION(('M194'),'2;1');
FILE_NAME('M194.stp','2026-07-12T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
