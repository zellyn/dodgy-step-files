ISO-10303-21;
/* M148: AP210 same NETWORK identifier used for two unrelated nets */
/* DEFECT: two NETWORK entities both named 'VCC' route different conductors */
/* Sub-design A VCC and sub-design B VCC are electrically independent */
/* Net-by-name lookup returns either #200 or #201 — ordering-dependent */
/* Connectivity tools merge unrelated traces, breaking continuity checks */
/* Per ISO 10303-210 §7 NETWORK.name must be unique within a design */
/* Byte assertion: contains(b'ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN') */
/* Byte assertion: count_entity_def(b'NETWORK') >= 2 */
/* Byte assertion: contains(b"NETWORK('VCC',") */
HEADER;
FILE_DESCRIPTION(('M148: AP210 duplicate NETWORK name VCC'),'2;1');
FILE_NAME('M148.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN') */
FILE_SCHEMA(('ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN { 1 0 10303 210 3 1 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('electronic_assembly_interconnect_and_packaging_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'electronic_assembly_interconnect_and_packaging_design',2014,#1);
/* Standard unit context (mm) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('pcb','3D'));
/* Sub-design A power rail nodes — independent conductor set */
#100=NETWORK_NODE('vcc_node_a1',());
#101=NETWORK_NODE('vcc_node_a2',());
/* Sub-design B power rail nodes — different independent conductor set */
#102=NETWORK_NODE('vcc_node_b1',());
#103=NETWORK_NODE('vcc_node_b2',());
/* Byte assertion: count_entity_def(b'NETWORK') >= 2 */
/* Byte assertion: contains(b"NETWORK('VCC',") */
/* DEFECT: both networks named 'VCC' but route different conductors */
/* Sub-design A VCC net — routes vcc_node_a1 and vcc_node_a2 */
#200=NETWORK('VCC',(#100,#101));
/* Sub-design B VCC net — routes vcc_node_b1 and vcc_node_b2 */
/* No shared nodes with #200 — these are unrelated conductors */
#201=NETWORK('VCC',(#102,#103));
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#300=GEOMETRIC_CURVE_SET('ap210-duplicate-network-name-vcc-two-unrelated-nets',
  (#100,#101,#102,#103,#200,#201));
/* Product chain */
#400=APPLICATION_CONTEXT('mechanical design');
#401=PRODUCT_CONTEXT('',#400,'mechanical');
#402=PRODUCT('M148','M148','M148',(#401));
#403=PRODUCT_DEFINITION_FORMATION('','',#402);
#404=PRODUCT_DEFINITION_CONTEXT(#400,'design');
#405=PRODUCT_DEFINITION('','',#403,#404);
#406=PRODUCT_DEFINITION_SHAPE('','',#405);
#407=SHAPE_REPRESENTATION('',(#300),#14);
#408=SHAPE_DEFINITION_REPRESENTATION(#406,#407);
ENDSEC;
END-ISO-10303-21;
