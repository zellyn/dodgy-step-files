ISO-10303-21;
/* Os011 - Loft with profiles of unsupported types.
 * Defect: profile 1 is a single VERTEX_POINT, profile 2 is a closed wire. */
HEADER;
FILE_DESCRIPTION(('Os011 - loft wrong usage','Pass C gap-fill'),'2;1');
FILE_NAME('Os011.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('apex',(0.0,0.0,0.0));
#11=VERTEX_POINT('',#10);
/* Profile 2 - closed circle at z=1 */
#20=CARTESIAN_POINT('center',(0.0,0.0,1.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=CIRCLE('',#23,1.0);
ENDSEC;
END-ISO-10303-21;
