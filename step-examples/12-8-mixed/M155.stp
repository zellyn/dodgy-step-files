ISO-10303-21;
/* M155: AP210 net connectivity ends at a non-pin element */
/* DEFECT: NETWORK_NODE 'node_floating' references CARTESIAN_POINT not TERMINAL */
/* The PCB trace endpoint has no electrical pin — connectivity broken */
/* ECAD exporter promoted a routing-graph point to a node without making a TERMINAL */
/* Per ISO 10303-210 §7 NETWORK_NODE must reference a TERMINAL subtype */
/* Byte assertion: contains(b'ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN') */
/* Byte assertion: contains(b'NETWORK_NODE') */
/* Byte assertion: contains(b'CARTESIAN_POINT') */
HEADER;
FILE_DESCRIPTION(('M155: AP210 NETWORK_NODE references CARTESIAN_POINT not TERMINAL'),'2;1');
FILE_NAME('M155.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN') */
FILE_SCHEMA(('ELECTRONIC_ASSEMBLY_INTERCONNECT_AND_PACKAGING_DESIGN { 1 0 10303 210 3 1 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('electronic_assembly_interconnect_and_packaging_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'electronic_assembly_interconnect_and_packaging_design',2014,#1);
/* Standard unit context (mm) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('pcb','3D'));
/* DEFECT: #50 is a CARTESIAN_POINT; a NETWORK_NODE will reference it below */
/* A valid endpoint would be a TERMINAL, not a bare geometry point */
#50=CARTESIAN_POINT('floating_endpoint',(10.0,5.0,0.0));
/* Valid TERMINAL at the start of the trace */
#52=CARTESIAN_POINT('T_start_loc',(0.0,5.0,0.0));
#51=TERMINAL('T_start',#52);
/* Byte assertion: contains(b'NETWORK_NODE') */
/* NETWORK_NODE 'node_start' — valid: references a TERMINAL */
#60=NETWORK_NODE('node_start',#51);
/* DEFECT: NETWORK_NODE 'node_floating' references CARTESIAN_POINT #50 not TERMINAL */
/* This trace end has no electrical pin; per AP210 this must be a TERMINAL */
#61=NETWORK_NODE('node_floating',#50);
/* NETWORK 'PCB_NET' groups both nodes — one valid, one defective */
#70=NETWORK('PCB_NET',(#60,#61));
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#200=GEOMETRIC_CURVE_SET('ap210-net-endpoint-not-terminal-network-node-cartesian-point',
  (#50,#51,#52,#60,#61,#70));
/* Product chain */
#400=APPLICATION_CONTEXT('mechanical design');
#401=PRODUCT_CONTEXT('',#400,'mechanical');
#402=PRODUCT('M155','M155','M155',(#401));
#403=PRODUCT_DEFINITION_FORMATION('','',#402);
#404=PRODUCT_DEFINITION_CONTEXT(#400,'design');
#405=PRODUCT_DEFINITION('','',#403,#404);
#406=PRODUCT_DEFINITION_SHAPE('','',#405);
#407=SHAPE_REPRESENTATION('',(#200),#14);
#408=SHAPE_DEFINITION_REPRESENTATION(#406,#407);
ENDSEC;
END-ISO-10303-21;
