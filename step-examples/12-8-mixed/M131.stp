ISO-10303-21;
/* M131 - AP203 PRODUCT_DEFINITION linked to wrong PRODUCT_CONTEXT
 * frame_of_reference.
 * Defect: a mechanical PRODUCT is declared with frame_of_reference
 * referencing #1 (mechanical context) but its PRODUCT_DEFINITION
 * uses an electrical PRODUCT_CONTEXT (#3). The class hierarchy is
 * mis-wired - mechanical product appears to be classified as electrical. */
HEADER;
FILE_DESCRIPTION(('M131 test case','AP203 product context mis-classification'),'2;1');
FILE_NAME('M131.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('configuration controlled 3D design of mechanical parts and assemblies');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','config_control_design',1994,#1);
#3=PRODUCT_CONTEXT('mech_ctx',#1,'mechanical');
#4=PRODUCT_CONTEXT('elec_ctx',#1,'electrical');
/* PRODUCT declares mechanical frame_of_reference. */
#10=PRODUCT('bracket','bracket','steel mounting bracket',(#3));
#20=PRODUCT_DEFINITION_FORMATION('rev_A','released',#10);
/* Defect: PRODUCT_DEFINITION uses ELECTRICAL context #4 not mechanical #3. */
#30=PRODUCT_DEFINITION('design','wrong context',#20,#4);
ENDSEC;
END-ISO-10303-21;
