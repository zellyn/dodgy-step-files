ISO-10303-21;
/* M131: AP203 PRODUCT_DEFINITION linked to wrong PRODUCT_CONTEXT frame_of_reference */
/* DEFECT: PRODUCT declares mechanical context; PRODUCT_DEFINITION uses electrical context */
/* Per AP203 §4.2 PRODUCT_DEFINITION.frame_of_reference must match parent PRODUCT's context */
/* Discipline-filtered queries return wrong set; mechanical part filed under electrical */
/* Byte assertion: contains(b'CONFIG_CONTROL_DESIGN') */
/* Byte assertion: count_entity_def(b'PRODUCT_CONTEXT') >= 2 */
/* Byte assertion: contains(b'PRODUCT_DEFINITION') */
HEADER;
FILE_DESCRIPTION(('M131: AP203 PRODUCT_DEFINITION frame_of_reference context mismatch'),'2;1');
FILE_NAME('M131.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'CONFIG_CONTROL_DESIGN') */
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN { 1 0 10303 203 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('configuration controlled 3D designs of mechanical parts and assemblies');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'config_control_design',1994,#1);
/* Standard unit context (mm) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('ctx','3D'));
/* Byte assertion: count_entity_def(b'PRODUCT_CONTEXT') >= 2 */
/* Two PRODUCT_CONTEXTs: one mechanical (correct for PRODUCT), one electrical (wrong in PD) */
#20=PRODUCT_CONTEXT('mechanical_context',#1,'mechanical');
#21=PRODUCT_CONTEXT('electrical_context',#1,'electrical');
/* PRODUCT declares mechanical frame_of_reference — correct */
#30=PRODUCT('bracket','Mounting Bracket','Structural mounting bracket',(#20));
#31=PRODUCT_DEFINITION_FORMATION('rev_A','Initial release',#30);
/* Byte assertion: contains(b'PRODUCT_DEFINITION') */
/* DEFECT: PRODUCT_DEFINITION.frame_of_reference = #21 (electrical) */
/* but parent PRODUCT.frame_of_reference = (#20) which is mechanical */
/* A valid file would use #20 here so both contexts agree on 'mechanical' */
#32=PRODUCT_DEFINITION('design','Bracket design definition',#31,#21);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#500=GEOMETRIC_CURVE_SET('ap203-product-context-discipline-mismatch',
  (#20,#21,#30,#31,#32));
/* Product chain */
#600=APPLICATION_CONTEXT('mechanical design');
#601=PRODUCT_CONTEXT('',#600,'mechanical');
#602=PRODUCT('M131','M131','M131',(#601));
#603=PRODUCT_DEFINITION_FORMATION('','',#602);
#604=PRODUCT_DEFINITION_CONTEXT(#600,'design');
#605=PRODUCT_DEFINITION('','',#603,#604);
#606=PRODUCT_DEFINITION_SHAPE('','',#605);
#607=SHAPE_REPRESENTATION('',(#500),#14);
#608=SHAPE_DEFINITION_REPRESENTATION(#606,#607);
ENDSEC;
END-ISO-10303-21;
