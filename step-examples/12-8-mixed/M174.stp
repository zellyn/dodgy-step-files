ISO-10303-21;
/* M174: AP238 milling_feed_rate varies along path with no F-code transition */
/* DEFECT: MILLING_FEED_RATE jumps from 300.0 to 1200.0 mm/min with no ramp declared */
/* Adjacent MILLING_OPERATION entries in WORKPLAN; no transition operation between them */
/* Controllers snap discontinuously or silently apply one rate for entire path */
/* Per ISO 10303-238 §5.8 feedrate changes require an explicit transition */
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
/* Byte assertion: contains(b'MILLING_FEED_RATE') */
/* Byte assertion: contains(b'1200.0') */
/* Byte assertion: contains(b'300.0') */
HEADER;
FILE_DESCRIPTION(('M174: AP238 milling_feed_rate jump 300 to 1200 mm/min no transition'),'2;1');
FILE_NAME('M174.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 3 1 1 1 }'));
ENDSEC;
DATA;
/* Standard unit context (mm) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('ctx','3D'));
/* mm/min velocity unit for MILLING_FEED_RATE magnitude */
#15=SI_UNIT(.MILLI.,.METRE.);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#20=GEOMETRIC_CURVE_SET('ap238-milling-feed-rate-jump-no-transition',
  (#52,#62,#70));
/* Byte assertion: contains(b'MILLING_FEED_RATE') */
/* DEFECT: MILLING_FEED_RATE 300.0 mm/min — first segment, no transition out */
#53=MILLING_FEED_RATE(300.0,$,$,$,$);
/* MILLING_OPERATION 'mill_op_slow': feed at 300.0 mm/min */
#52=MILLING_OPERATION('mill_op_slow',$,(#53),$,$,$,$,$,$,$,$,$,$);
/* DEFECT: MILLING_FEED_RATE 1200.0 mm/min — second segment, no ramp from 300.0 */
#63=MILLING_FEED_RATE(1200.0,$,$,$,$);
/* MILLING_OPERATION 'mill_op_fast': feed at 1200.0 mm/min (4x jump) */
#62=MILLING_OPERATION('mill_op_fast',$,(#63),$,$,$,$,$,$,$,$,$,$);
/* WORKPIECE 'mill_workpiece' */
#70=WORKPIECE('mill_workpiece','Milling workpiece for feedrate jump test',$,$,$,$,$);
/* MACHINING_WORKINGSTEP 'mill_step_slow' — first step at 300.0 mm/min */
#51=MACHINING_WORKINGSTEP('mill_step_slow','Slow feedrate milling step',#52,#70,$);
/* MACHINING_WORKINGSTEP 'mill_step_fast' — adjacent, jumps to 1200.0 mm/min */
#61=MACHINING_WORKINGSTEP('mill_step_fast','Fast feedrate milling step',#62,#70,$);
/* WORKPLAN: two steps adjacent with no transition operation between them */
#50=WORKPLAN('feedrate_jump_program','Feedrate jump workplan',(),$,(#51,#61));
/* Product chain */
#100=APPLICATION_CONTEXT('mechanical design');
#101=PRODUCT_CONTEXT('',#100,'mechanical');
#102=PRODUCT('M174','M174','M174',(#101));
#103=PRODUCT_DEFINITION_FORMATION('','',#102);
#104=PRODUCT_DEFINITION_CONTEXT(#100,'design');
#105=PRODUCT_DEFINITION('','',#103,#104);
#106=PRODUCT_DEFINITION_SHAPE('','',#105);
#107=SHAPE_REPRESENTATION('',(#20),#14);
#108=SHAPE_DEFINITION_REPRESENTATION(#106,#107);
ENDSEC;
END-ISO-10303-21;
