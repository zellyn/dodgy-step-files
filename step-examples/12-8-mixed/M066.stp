ISO-10303-21;
/* M066 - Non-manifold COMPSOLID translated as separate SOLIDs.
 * Defect: two MANIFOLD_SOLID_BREPs whose CLOSED_SHELLs each include the
 * same shared ADVANCED_FACE (#56). On non-manifold round-trip the
 * shared face is duplicated; the cellular relationship is lost. */
HEADER;
FILE_DESCRIPTION(('M066 test case','Non-manifold COMPSOLID translated as set of SOLIDs'),'2;1');
FILE_NAME('M066.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('compsolid','compsolid','',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
/* Common axis */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
/* Surfaces - one is the shared partition between the two solids */
#30=PLANE('p_a_top',#23);
#31=PLANE('p_a_left',#23);
#32=PLANE('p_a_front',#23);
#33=PLANE('p_a_back',#23);
#34=PLANE('p_a_bot',#23);
#35=PLANE('shared_plane',#23);
#36=PLANE('p_b_top',#23);
#37=PLANE('p_b_right',#23);
#38=PLANE('p_b_front',#23);
#39=PLANE('p_b_back',#23);
#40=PLANE('p_b_bot',#23);
/* Faces - face #56 is the SHARED face referenced by both shells */
/* --- single triangular face placeholder for OPEN_SHELL --- */
#5700=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#5701=CARTESIAN_POINT('p1',(1.0,0.0,0.0));
#5702=CARTESIAN_POINT('p2',(0.0,1.0,0.0));
#5710=VERTEX_POINT('',#5700);
#5711=VERTEX_POINT('',#5701);
#5712=VERTEX_POINT('',#5702);
#5720=DIRECTION('dx',(1.0,0.0,0.0));
#5721=DIRECTION('dy',(0.0,1.0,0.0));
#5722=DIRECTION('dz',(0.0,0.0,1.0));
#5730=VECTOR('vx',#5720,1.0);
#5731=VECTOR('vy',#5721,1.0);
#5732=VECTOR('vd',#5720,1.0);
#5740=LINE('',#5700,#5730);
#5741=DIRECTION('dxy',(-0.7071067811865476,0.7071067811865476,0.0));
#5742=VECTOR('vxy',#5741,1.4142135623730951);
#5743=LINE('',#5701,#5742);
#5744=LINE('',#5700,#5731);
#5760=EDGE_CURVE('',#5710,#5711,#5740,.T.);
#5761=EDGE_CURVE('',#5711,#5712,#5743,.T.);
#5762=EDGE_CURVE('',#5710,#5712,#5744,.T.);
#5780=AXIS2_PLACEMENT_3D('',#5700,#5722,#5720);
#5790=PLANE('',#5780);
#5800=ORIENTED_EDGE('',*,*,#5760,.T.);
#5801=ORIENTED_EDGE('',*,*,#5761,.T.);
#5802=ORIENTED_EDGE('',*,*,#5762,.F.);
#5830=EDGE_LOOP('',(#5800,#5801,#5802));
#5840=FACE_OUTER_BOUND('',#5830,.T.);
#5850=ADVANCED_FACE('placeholder',(#5840),#5790,.T.);
/* OPEN_SHELL replacing empty () body */
#50=ADVANCED_FACE('a_top',(#5840),#30,.T.);
#51=ADVANCED_FACE('a_left',(#5840),#31,.T.);
#52=ADVANCED_FACE('a_front',(#5840),#32,.T.);
#53=ADVANCED_FACE('a_back',(#5840),#33,.T.);
#54=ADVANCED_FACE('a_bot',(#5840),#34,.T.);
#56=ADVANCED_FACE('shared_face',(#5840),#35,.T.);
#57=ADVANCED_FACE('b_top',(#5840),#36,.T.);
#58=ADVANCED_FACE('b_right',(#5840),#37,.T.);
#59=ADVANCED_FACE('b_front',(#5840),#38,.T.);
#60=ADVANCED_FACE('b_back',(#5840),#39,.T.);
#61=ADVANCED_FACE('b_bot',(#5840),#40,.T.);
/* Two CLOSED_SHELLs sharing face #56 */
#70=CLOSED_SHELL('s1',(#50,#51,#52,#53,#54,#56));
#71=CLOSED_SHELL('s2',(#56,#57,#58,#59,#60,#61));
#80=MANIFOLD_SOLID_BREP('compsolid_part1',#70);
#81=MANIFOLD_SOLID_BREP('compsolid_part2',#71);
/* Add SDR linking PRODUCT to existing geometry. */
#9000=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9001=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9002=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9003=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9000,'distance_accuracy_value','');
#9004=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9003))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9000,#9001,#9002))REPRESENTATION_CONTEXT('','3D'));
#9020=ADVANCED_BREP_SHAPE_REPRESENTATION('',(#80),#9004);
#9021=SHAPE_DEFINITION_REPRESENTATION(#15,#9020);
ENDSEC;
END-ISO-10303-21;
