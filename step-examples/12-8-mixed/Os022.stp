ISO-10303-21;
/* Os022: GEOMETRIC_CURVE_SET containing exactly 2 LINE entities; LINE 1: VECTOR(DIRECTION(1,0,0), 10.0) — unit direction, param length=10; LINE 2: VECTOR(DIRECTION(0.5,0,0), 20.0) — non-unit direction, same 3D extent but param length=20 (magnitude*||dir||^-1 = 20/0.5 = 40 or 20 depending on convention); FindContigousEdges detects free-edge pair with mismatched param lengths; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty; no orphaned entities */
HEADER;
FILE_DESCRIPTION(('Os022'),'2;1');
FILE_NAME('Os022.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
