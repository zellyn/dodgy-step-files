ISO-10303-21;
/* M181: AP238 workpiece_complete_for_nc missing required clamping references */
/* DEFECT: WORKPIECE_COMPLETE_FOR_NC 'finished_part' has empty clamping_position list */
/* AP238 requires workpieces tied to fixturing for collision-checking */
/* Controller cannot enforce keep-out zones without clamping references */
/* Per ISO 10303-238 §5.4 at least one clamping reference must be declared */
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
/* Byte assertion: contains(b'WORKPIECE_COMPLETE_FOR_NC') */
HEADER;
FILE_DESCRIPTION(('M181: AP238 workpiece_complete_for_nc with empty clamping list'),'2;1');
FILE_NAME('M181.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 3 1 1 1 }'));
ENDSEC;
DATA;
/* Standard unit context (mm) */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('ctx','3D'));
/* mm length unit reference for MEASURE_WITH_UNIT */
#15=SI_UNIT(.MILLI.,.METRE.);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#20=GEOMETRIC_CURVE_SET('ap238-workpiece-complete-for-nc-missing-clamping-references',
  (#41,#52,#60));
/* Base workpiece (raw stock) */
#40=WORKPIECE('raw_stock','Raw stock for finished part',$,$,$,$,$);
/* Byte assertion: contains(b'WORKPIECE_COMPLETE_FOR_NC') */
/* DEFECT: WORKPIECE_COMPLETE_FOR_NC with empty clamping_position list () */
/* AP238 §5.4 invariant: clamping_position must be non-empty for safe machining */
#41=WORKPIECE_COMPLETE_FOR_NC('finished_part',$,$,$,$,$,$,(),$);
/* WORKPIECE 'mill_workpiece' for the milling step */
#60=WORKPIECE('mill_workpiece','Workpiece for unclamped test',$,$,$,$,$);
/* MILLING_OPERATION references the unclamped workpiece scenario */
#52=MILLING_OPERATION('mill_op',$,$,$,$,$,$,$,$,$,$,$,$);
/* MACHINING_WORKINGSTEP links milling op to workpiece */
#51=MACHINING_WORKINGSTEP('mill_step','Unclamped workpiece mill step',#52,#60,$);
/* WORKPLAN: single milling step on workpiece with missing clamps */
#50=WORKPLAN('unclamped_workpiece_program','Unclamped workpiece milling workplan',(),$,(#51));
/* Product chain */
#100=APPLICATION_CONTEXT('mechanical design');
#101=PRODUCT_CONTEXT('',#100,'mechanical');
#102=PRODUCT('M181','M181','M181',(#101));
#103=PRODUCT_DEFINITION_FORMATION('','',#102);
#104=PRODUCT_DEFINITION_CONTEXT(#100,'design');
#105=PRODUCT_DEFINITION('','',#103,#104);
#106=PRODUCT_DEFINITION_SHAPE('','',#105);
#107=SHAPE_REPRESENTATION('',(#20),#14);
#108=SHAPE_DEFINITION_REPRESENTATION(#106,#107);
ENDSEC;
END-ISO-10303-21;
