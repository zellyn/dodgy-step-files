/* AXIS2_PLACEMENT_3D for component placement — forbidden in TESSELLATED_SHAPE_REPRESENTATION (Ed.1) */
#131=CARTESIAN_POINT('comp_origin',(20.,0.,0.));
#132=DIRECTION('comp_z',(0.,0.,1.));
/* #133 = AXIS2_PLACEMENT_3D — the item that violates AP242 Ed.1 §4.1 */
#133=AXIS2_PLACEMENT_3D('component_placement',#131,#132,$);
/* TESSELLATED_SHAPE_REPRESENTATION: items=(#7, #133) — #133 is forbidden in Ed.1 */
/* Byte assertion: matches(rb'TESSELLATED_SHAPE_REPRESENTATION\([^)]*#133') */
#134=TESSELLATED_SHAPE_REPRESENTATION('defect_tess_rep',(#7,#133),#14);
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#200=GEOMETRIC_CURVE_SET('ap242-ed1-tess-rep-with-placement',(#1,#2,#3,#4));
