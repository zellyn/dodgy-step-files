ISO-10303-21;
/* M002: AP242 Ed.1 TESSELLATED_SHAPE_REPRESENTATION with AXIS2_PLACEMENT_3D in items */
/* DEFECT: AP242 Ed.1 §4.1 forbids AXIS2_PLACEMENT_3D inside TESSELLATED_SHAPE_REPRESENTATION */
/* Only tessellated_representation_item subtypes are allowed in Ed.1 items list */
/* Correct writer: use plain SHAPE_REPRESENTATION for placement, separate rep for tess */
/* Buggy writer: mixes AXIS2_PLACEMENT_3D directly into TESSELLATED_SHAPE_REPRESENTATION */
HEADER;
FILE_DESCRIPTION(('M002: AP242 Ed.1 TESSELLATED_SHAPE_REPRESENTATION with forbidden AXIS2_PLACEMENT_3D'),'2;1');
FILE_NAME('M002.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
/* Tessellated geometry: a simple quad split into two triangles */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('pt_a',(10.,0.,0.));
#3=CARTESIAN_POINT('pt_b',(0.,10.,0.));
#4=CARTESIAN_POINT('pt_c',(10.,10.,0.));
/* COORDINATES_LIST: four quad vertices */
#5=COORDINATES_LIST('quad_coords',3,((0.,0.,0.),(10.,0.,0.),(0.,10.,0.),(10.,10.,0.)));
/* TRIANGULATED_FACE: two triangles from the quad (0-based indices) */
#6=TRIANGULATED_FACE('quad_face',#5,$,((.FALSE.,.FALSE.,.FALSE.,.FALSE.)),((0,1,2),(1,3,2)));
/* TESSELLATED_SOLID: wraps the triangulated face */
#7=TESSELLATED_SOLID('tess_solid',(#6));
/* Standard mm context */
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
#15=CARTESIAN_POINT('pad_15',(0.,0.,0.));
