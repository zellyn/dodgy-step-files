ISO-10303-21;
/* M081 - AP209 integration_point_count not matching element_type.
 * Defect: a CURVE_3D_ELEMENT_DESCRIPTOR declares linear_beam topology and
 * its associated FEA_MODEL_3D states a Gauss-quadrature integration_rule
 * with 5 integration points, but a linear_beam mass / stiffness matrix
 * is computed exactly with at most 2 Gauss points; with 5, the model
 * either over-integrates (locks) or some integration points fall in
 * non-existent regions of the parametric domain. */
HEADER;
FILE_DESCRIPTION(('M081 test case','AP209 integration point count mismatch'),'2;1');
FILE_NAME('M081.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('STRUCTURAL_ANALYSIS_DESIGN { 1 0 10303 209 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('structural_analysis_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'structural_analysis_design',2001,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10))
     REPRESENTATION_CONTEXT('fea','3D'));
#100=CARTESIAN_POINT('n1',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('n2',(1.0,0.0,0.0));
#110=NODE('n1',(#100),$);
#111=NODE('n2',(#101),$);
/* Linear beam with 2 endpoint nodes - exact Gauss integration uses 2
 * integration points. */
#200=CURVE_3D_ELEMENT_DESCRIPTOR('beam','linear_beam',(#110,#111));
/* Defect: integration rule states 5 points - over-integrated. */
#300=ELEMENT_REPRESENTATION('beam_rep',
       (CONSTANT_MEASURE(NUMERIC_MEASURE(5.0),
         INTEGRATION_POINT_COUNT_NAME('Gauss_pts'))),#14);
ENDSEC;
END-ISO-10303-21;
