ISO-10303-21;
/* M081: AP209 integration_point_count not consistent with element_type */
/* DEFECT: linear_beam requires 1-2 Gauss points; 5 declared here */
/* Over-integrated beam element locks artificially stiff */
/* Byte assertion: contains(b'STRUCTURAL_ANALYSIS_DESIGN') */
/* Byte assertion: contains(b'CURVE_3D_ELEMENT_DESCRIPTOR') */
HEADER;
FILE_DESCRIPTION(('M081: AP209 linear_beam with 5 integration points not 1-2'),'2;1');
FILE_NAME('M081.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'STRUCTURAL_ANALYSIS_DESIGN') */
FILE_SCHEMA(('STRUCTURAL_ANALYSIS_DESIGN { 1 0 10303 209 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('structural_analysis_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'structural_analysis_design',2001,#1);
/* Standard unit context */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('fea','3D'));
/* Beam end-nodes: a 100mm beam along X */
#100=CARTESIAN_POINT('n1',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('n2',(100.0,0.0,0.0));
#110=NODE('n1',(#100),$);
#111=NODE('n2',(#101),$);
/* Byte assertion: contains(b'CURVE_3D_ELEMENT_DESCRIPTOR') */
/* linear_beam: an Euler-Bernoulli beam; exact-integration needs 1-2 Gauss points */
#120=CURVE_3D_ELEMENT_DESCRIPTOR('beam','linear_beam',(#110,#111));
/* DEFECT: ELEMENT_REPRESENTATION states 5 integration points for linear_beam */
/* INTEGRATION_POINT_COUNT_NAME('Gauss_pts') value is 5.0 — correct is 1 or 2 */
/* 5 Gauss points on a linear beam: over-integration causes artificial locking */
#200=ELEMENT_REPRESENTATION('beam_rep',
  (CONSTANT_MEASURE(NUMERIC_MEASURE(5.0),
    INTEGRATION_POINT_COUNT_NAME('Gauss_pts'))),#14);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#300=GEOMETRIC_CURVE_SET('ap209-linear-beam-5-integration-points-not-1-2',
  (#110,#111,#120,#200));
/* Product chain */
#400=APPLICATION_CONTEXT('mechanical design');
#401=PRODUCT_CONTEXT('',#400,'mechanical');
#402=PRODUCT('M081','M081','M081',(#401));
#403=PRODUCT_DEFINITION_FORMATION('','',#402);
#404=PRODUCT_DEFINITION_CONTEXT(#400,'design');
#405=PRODUCT_DEFINITION('','',#403,#404);
#406=PRODUCT_DEFINITION_SHAPE('','',#405);
#407=SHAPE_REPRESENTATION('',(#300),#14);
#408=SHAPE_DEFINITION_REPRESENTATION(#406,#407);
ENDSEC;
END-ISO-10303-21;
