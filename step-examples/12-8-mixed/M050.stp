ISO-10303-21;
/* M050: GEOMETRIC_CURVE_SET containing COMPOSITE_PLY_DEFINITION with LIMITED_AREA_INDICATOR marking a partial-area ply boundary; input: AP242 STEP file (Ed.2) with a composite layup where one ply covers only part of the base surface; the ply boundary is encoded as LIMITED_AREA_INDICATOR referencing a bounding curve; prostep ivip MBx-IF / CAx-IF Composites RP v4.4 (M033): LLAI extension targeted at AP242 Ed.4; older Ed.2 implementations silently drop the LIMITED_AREA_INDICATOR entity or encode it inconsistently across vendors; kernel must warn-and-accept (document loss) when Ed.4 LLAI extension is unavailable; never silently drop partial-area boundary; OCC silently accepts (no diagnostic, empty result); GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty; synonyms: composite LLAI gaps, limited length area indicator missing, ply extends only over part of base, LLAI metadata inconsistent across vendors */
HEADER;
FILE_DESCRIPTION(('M050'),'2;1');
FILE_NAME('M050.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('base_origin',(0.,0.,0.));
#2=DIRECTION('base_normal',(0.,0.,1.));
#3=DIRECTION('base_ref_dir',(1.,0.,0.));
#4=AXIS2_PLACEMENT_3D('base_placement',#1,#2,#3);
#5=CARTESIAN_POINT('b0',(0.1,0.1,0.));
#6=CARTESIAN_POINT('b1',(0.5,0.1,0.));
#7=CARTESIAN_POINT('b2',(0.5,0.5,0.));
#8=CARTESIAN_POINT('b3',(0.1,0.5,0.));
#9=DIRECTION('bound_dir',(1.,0.,0.));
#10=LINE('boundary_edge',#5,VECTOR(#9,0.4));
#11=LIMITED_AREA_INDICATOR('partial_ply_boundary',(#5,#6,#7,#8));
#12=COMPOSITE_PLY_DEFINITION('ply_layer_1','carbon_fibre_0deg',#4,#11);
#13=GEOMETRIC_CURVE_SET('composite-llai-partial-area-ply',(#12,#11,#4,#5,#6,#7,#8));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('M050','M050','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#13),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
END-ISO-10303-21;
