ISO-10303-21;
/* M050 - Composite material LLAI (Limited Length / Area Indicator)
 * gaps.
 * Defect: composite-ply geometry that requires "limited length or
 * area indicators" for plies extending only over part of a base
 * surface is not yet uniformly implemented. Older AP242 vendors drop
 * the LLAI metadata or encode it inconsistently. LLAI extension is
 * targeted at AP242 Ed.4.
 * This fixture: a layup with a partial-area ply round-tripped through
 * AP242 Ed.2. The ply (#220) carries an LLAI with `is_limited = .T.`
 * and a region boundary, but the FILE_SCHEMA is Ed.2 - readers under
 * Ed.2 do not recognize LLAI. */
HEADER;
FILE_DESCRIPTION(('M050 test case','partial-area composite ply LLAI under AP242 Ed.2'),'2;1');
FILE_NAME('M050.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 2 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap242_managed_model_based_3d_engineering',2020,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-6),#10,'distance_accuracy_value','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
     REPRESENTATION_CONTEXT('layup','3D'));
/* Base surface placeholder - a 200x100 mm panel. */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=DIRECTION('',(0.0,0.0,1.0));
#102=DIRECTION('',(1.0,0.0,0.0));
#103=AXIS2_PLACEMENT_3D('panel_origin',#100,#101,#102);
#104=PLANE('panel_surface',#103);
/* A region polygon on the panel for the limited-area indicator. */
#110=CARTESIAN_POINT('',(50.0,25.0,0.0));
#111=CARTESIAN_POINT('',(150.0,25.0,0.0));
#112=CARTESIAN_POINT('',(150.0,75.0,0.0));
#113=CARTESIAN_POINT('',(50.0,75.0,0.0));
#114=POLYLINE('partial_area_region',(#110,#111,#112,#113,#110));
/* Composite ply with LLAI - Ed.4-only entity. */
#200=PRODUCT('ply_45deg','45-degree_ply','',());
#210=COMPOSITE_PLY_DEFINITION('45deg_ply',45.0,#100,#104,$);
/* Hypothetical LLAI: marks ply as covering only the region #114. */
#220=LIMITED_AREA_INDICATOR('partial_area',#210,#114,.T.);
ENDSEC;
END-ISO-10303-21;
