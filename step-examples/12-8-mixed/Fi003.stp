ISO-10303-21;
/* Fi003 - Fillet radius exceeds local curvature radius.
 * Defect: cylinder of radius 5; user requests fillet of radius 6 at the
 * top end-cap edge. Rolling ball (r=6) cannot fit between cylinder
 * (curvature 1/5) and the cap. Encoded: cylinder + end EDGE_CURVE
 * (the spine) + a SHAPE_ASPECT carrying the requested fillet radius. */
HEADER;
FILE_DESCRIPTION(('Fi003 test case','Fillet radius exceeds local curvature'),'2;1');
FILE_NAME('Fi003.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('cyl_part','cyl_part','',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
/* Cylinder of radius 5 */
#20=CARTESIAN_POINT('axis_pt',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('cyl_axis',#20,#21,#22);
#24=CYLINDRICAL_SURFACE('cyl_r5',#23,5.0);
/* End-cap edge: a circle on top of the cylinder (z = 10) */
#30=CARTESIAN_POINT('top_center',(0.0,0.0,10.0));
#31=AXIS2_PLACEMENT_3D('top_axis',#30,#21,#22);
#32=CIRCLE('top_edge_circle',#31,5.0);
#33=CARTESIAN_POINT('top_seam',(5.0,0.0,10.0));
#34=VERTEX_POINT('seam_vertex',#33);
/* Spine edge - the closed top circle */
#40=EDGE_CURVE('top_spine_edge',#34,#34,#32,.T.);
/* Cylindrical face referencing the spine edge */
#41=ORIENTED_EDGE('',*,*,#40,.T.);
#42=EDGE_LOOP('top_loop',(#41));
#43=FACE_OUTER_BOUND('',#42,.T.);
#44=ADVANCED_FACE('cyl_face',(#43),#24,.T.);
/* Fillet input: SHAPE_ASPECT + a measure carrying r=6 */
#50=SHAPE_ASPECT('fillet_input','fillet on top edge',#15,.T.);
#51=DIMENSIONAL_SIZE(#50,'requested_radius');
/* Operation parameter: requested fillet radius = 6.0 mm.
 * Encoded as MEASURE_WITH_UNIT in DATA so the cited number is byte-visible. */
#52=MEASURE_WITH_UNIT(LENGTH_MEASURE(6.0),#9000);
/* Add SDR linking PRODUCT to existing geometry. */
#9000=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9001=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9002=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9003=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9000,'distance_accuracy_value','');
#9004=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9003))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9000,#9001,#9002))REPRESENTATION_CONTEXT('','3D'));
#9010=OPEN_SHELL('wrap_shell',(#44));
#9011=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9010));
#9020=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9011),#9004);
#9021=SHAPE_DEFINITION_REPRESENTATION(#15,#9020);
ENDSEC;
END-ISO-10303-21;
