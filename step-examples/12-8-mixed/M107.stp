ISO-10303-21;
/* M107 - AP238 cutting tool diameter declared as zero.
 * Defect: a milling tool's diameter MEASURE_WITH_UNIT carries the
 * value 0.0 mm. Toolpaths computed against this tool have zero radial
 * offset; passes overlap themselves with no material removal. */
HEADER;
FILE_DESCRIPTION(('M107 test case','AP238 tool zero diameter'),'2;1');
FILE_NAME('M107.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 1 0 0 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('numerical_control_machining');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'numerical_control_machining',2007,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10))
     REPRESENTATION_CONTEXT('nc','3D'));
/* Defect: tool diameter declared 0.0 (POSITIVE_LENGTH_MEASURE
   schema-illegally allows it through producer mis-implementation). */
#80=MEASURE_WITH_UNIT(POSITIVE_LENGTH_MEASURE(0.0),#10);
#150=MACHINING_TOOL('zero_diameter_endmill',$,$,#80);
#100=MACHINING_OPERATION('rough',$,$,#150,$,$);
#200=WORKPLAN('main',(#100),$,$,$);
ENDSEC;
END-ISO-10303-21;
