ISO-10303-21;
/* Os019 - Middle path between two diverging wires fails.
 * Defect: two diverging wires (a fan shape) - their envelope is not
 * strip-like, so no medial axis exists. Encoded: apex VERTEX_POINT
 * + two LINE-backed EDGE_CURVEs to the two end points + an
 * EDGE_LOOP for each wire. */
HEADER;
FILE_DESCRIPTION(('Os019 test case','Middle path between diverging wires'),'2;1');
FILE_NAME('Os019.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Apex + two divergent endpoints */
#10=CARTESIAN_POINT('apex',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('w1_end',(1.0,1.0,0.0));
#12=CARTESIAN_POINT('w2_end',(1.0,-1.0,0.0));
#13=VERTEX_POINT('apex_vertex',#10);
#14=VERTEX_POINT('w1_end_vertex',#11);
#15=VERTEX_POINT('w2_end_vertex',#12);
/* Two divergent lines */
#20=DIRECTION('',(0.7071,0.7071,0.0));
#21=VECTOR('',#20,1.4142);
#22=LINE('w1_line',#10,#21);
#23=DIRECTION('',(0.7071,-0.7071,0.0));
#24=VECTOR('',#23,1.4142);
#25=LINE('w2_line',#10,#24);
/* Two EDGE_CURVEs apex -> respective endpoints */
#30=EDGE_CURVE('w1_edge',#13,#14,#22,.T.);
#31=EDGE_CURVE('w2_edge',#13,#15,#25,.T.);
/* Wires (edge loops) */
#40=ORIENTED_EDGE('',*,*,#30,.T.);
#41=ORIENTED_EDGE('',*,*,#31,.T.);
#42=EDGE_LOOP('wire_1',(#40));
#43=EDGE_LOOP('wire_2',(#41));
ENDSEC;
END-ISO-10303-21;
