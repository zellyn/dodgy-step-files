ISO-10303-21;
/* M104: AP238 SETUP emitted where WORKPIECE_SETUP is required */
/* DEFECT: MACHINING_WORKINGSTEP.its_setup references SETUP not WORKPIECE_SETUP */
/* SETUP = machine-fixture config; WORKPIECE_SETUP = workpiece-on-fixture placement */
/* Consumers lose workpiece clamp data or fixture geometry — wrong tool-origin offset */
/* Violates ISO 10303-238 §5.4 setup vs workpiece_setup distinction */
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
/* Byte assertion: contains(b'SETUP') */
HEADER;
FILE_DESCRIPTION(('M104: AP238 SETUP where WORKPIECE_SETUP required'),'2;1');
FILE_NAME('M104.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('step_nc_mim');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'ap238_step_nc_mim',2007,#1);
/* Standard unit context — mm */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('nc','3D'));
/* Byte assertion: contains(b'SETUP') */
/* DEFECT: SETUP entity for machine-fixture configuration (vise on tombstone) */
/* This should be WORKPIECE_SETUP (workpiece-on-fixture placement with clamp data) */
/* The publisher merged both concepts into a single SETUP entity — type mismatch */
#50=SETUP('vise_config',$,$,$);
/* Target machined feature — a face milling pass */
#55=MACHINED_FEATURE('face_d',$,$,$,$,$);
/* 50mm face mill */
#60=MACHINING_TOOL('facemill_50mm',$,$,$);
/* Machining operation for face milling */
#70=MACHINING_OPERATION('face_op',#60,$,$,$,$,$,$,#55,$,$);
/* DEFECT: MACHINING_WORKINGSTEP.its_setup references SETUP #50 */
/* Per AP238 §5.4 its_setup must reference WORKPIECE_SETUP, not bare SETUP */
/* Correct fix: replace #50 with WORKPIECE_SETUP('vise_config_wp',...) */
#80=MACHINING_WORKINGSTEP('face_step',#55,#70,#50);
/* WORKPLAN referencing the workingstep with the mistyped setup reference */
#90=WORKPLAN('main',(#80),$,$,$);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#300=GEOMETRIC_CURVE_SET('ap238-setup-emitted-where-workpiece-setup-required',
  (#50,#55,#60,#70,#80,#90));
/* Product chain */
#400=APPLICATION_CONTEXT('mechanical design');
#401=PRODUCT_CONTEXT('',#400,'mechanical');
#402=PRODUCT('M104','M104','M104',(#401));
#403=PRODUCT_DEFINITION_FORMATION('','',#402);
#404=PRODUCT_DEFINITION_CONTEXT(#400,'design');
#405=PRODUCT_DEFINITION('','',#403,#404);
#406=PRODUCT_DEFINITION_SHAPE('','',#405);
#407=SHAPE_REPRESENTATION('',(#300),#14);
#408=SHAPE_DEFINITION_REPRESENTATION(#406,#407);
ENDSEC;
END-ISO-10303-21;
