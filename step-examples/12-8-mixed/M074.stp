ISO-10303-21;
/* M074: AP238 left-handed setup coordinate frame on multi-axis machine */
/* DEFECT: AXIS2_PLACEMENT_3D with axis (0,0,-1) yields left-handed Y = Z x X = (0,-1,0) */
/* On 5-axis machine: all rotary motions invert, part is mirror of design */
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
/* Byte assertion: contains(b'MACHINING_WORKINGSTEP') */
/* Byte assertion: contains(b'SETUP') */
HEADER;
FILE_DESCRIPTION(('M074: AP238 left-handed setup csys on 5-axis machine'),'2;1');
FILE_NAME('M074.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
/* Byte assertion: contains(b'AP238_STEP_NC_MIM') */
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 3 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('numerical_control_machining');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'numerical_control_machining',2007,#1);
/* Standard unit context */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
  REPRESENTATION_CONTEXT('ctx','3D'));
/* Setup origin */
#20=CARTESIAN_POINT('setup_origin',(0.0,0.0,0.0));
/* DEFECT: Z-axis direction is (0,0,-1) — negated Z */
/* Implied Y = Z x X = (0,0,-1) x (1,0,0) = (0,-1,0) — left-handed frame */
#21=DIRECTION('z_inverted',(0.0,0.0,-1.0));
#22=DIRECTION('x',(1.0,0.0,0.0));
/* AXIS2_PLACEMENT_3D: axis=(0,0,-1), ref_direction=(1,0,0) => left-handed */
#23=AXIS2_PLACEMENT_3D('setup_csys',#20,#21,#22);
/* Byte assertion: contains(b'SETUP') */
/* SETUP referencing the left-handed csys */
#30=SETUP('part_setup',$,$,$,#23);
/* Byte assertion: contains(b'MACHINING_WORKINGSTEP') */
/* MACHINING_WORKINGSTEP — 5-axis workingstep referencing the bad setup */
#40=MACHINING_WORKINGSTEP('ws1',$,$,$,#30);
/* GEOMETRIC_CURVE_SET IS the model entity — OCC yields empty */
#50=GEOMETRIC_CURVE_SET('ap238-left-handed-setup-csys-5axis-mirror',
  (#20,#23,#30));
/* Product chain */
#100=APPLICATION_CONTEXT('mechanical design');
#101=PRODUCT_CONTEXT('',#100,'mechanical');
#102=PRODUCT('M074','M074','M074',(#101));
#103=PRODUCT_DEFINITION_FORMATION('','',#102);
#104=PRODUCT_DEFINITION_CONTEXT(#100,'design');
#105=PRODUCT_DEFINITION('','',#103,#104);
#106=PRODUCT_DEFINITION_SHAPE('','',#105);
#107=SHAPE_REPRESENTATION('',(#50),#14);
#108=SHAPE_DEFINITION_REPRESENTATION(#106,#107);
ENDSEC;
END-ISO-10303-21;
