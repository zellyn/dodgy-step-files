ISO-10303-21;
/* M099 - AP238 tool feedrate declared as zero on a cutting move.
 * Defect: MACHINING_TOOL_FEEDSPEED carries value 0.0 mm/min while the
 * tool is in contact (not a dwell). The controller dwells indefinitely
 * with the spindle running, work-hardening the surface and burning
 * the tool tip. */
HEADER;
FILE_DESCRIPTION(('M099 test case','AP238 feedrate zero during cut'),'2;1');
FILE_NAME('M099.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP238_STEP_NC_MIM { 1 0 10303 238 1 0 0 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('numerical_control_machining');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'numerical_control_machining',2007,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#15=(NAMED_UNIT(*)SI_UNIT($,.SECOND.)TIME_UNIT());
#16=(DERIVED_UNIT_ELEMENT(#10,1.0));
#17=(DERIVED_UNIT_ELEMENT(#15,-1.0));
#18=DERIVED_UNIT((#16,#17));
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#15))
     REPRESENTATION_CONTEXT('nc','3D'));
/* Defect: feedrate zero. */
#80=MEASURE_WITH_UNIT(POSITIVE_RATIO_MEASURE(0.0),#18);
#90=MACHINING_TOOL_FEEDSPEED($,#80,$);
#100=MACHINING_OPERATION('finish_pass',$,$,$,$,$);
#200=WORKPLAN('main',(#100),$,$,$);
ENDSEC;
END-ISO-10303-21;
