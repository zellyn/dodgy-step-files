ISO-10303-21;
/* M119 - AP209 shell element with zero plate thickness.
 * Defect: a SURFACE_3D_ELEMENT_DESCRIPTOR for a linear_quadrilateral
 * shell carries an associated POSITIVE_LENGTH_MEASURE(0.0) thickness.
 * Bending stiffness collapses to zero. */
HEADER;
FILE_DESCRIPTION(('M119 test case','AP209 zero-thickness shell element'),'2;1');
FILE_NAME('M119.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('STRUCTURAL_ANALYSIS_DESIGN { 1 0 10303 209 1 0 0 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('structural_analysis_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'structural_analysis_design',2001,#1);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10))
     REPRESENTATION_CONTEXT('fea','3D'));
#100=CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('p2',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('p3',(1.0,1.0,0.0));
#103=CARTESIAN_POINT('p4',(0.0,1.0,0.0));
#110=NODE('n1',(#100),$);
#111=NODE('n2',(#101),$);
#112=NODE('n3',(#102),$);
#113=NODE('n4',(#103),$);
/* Defect: thickness measure carries 0.0. */
#150=MEASURE_WITH_UNIT(POSITIVE_LENGTH_MEASURE(0.0),#10);
#200=SURFACE_3D_ELEMENT_DESCRIPTOR('zero_thickness_shell','linear_quadrilateral',
       (#110,#111,#112,#113));
ENDSEC;
END-ISO-10303-21;
