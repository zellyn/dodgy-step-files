ISO-10303-21;
/* Gs162 - C0 continuity detection: surface C1 in U, C0 in V
 *
 * Defect: ShapeUpgrade surface continuity check uses AND logic (C1 in both U
 * and V required) instead of OR. Result: surfaces discontinuous in only one
 * direction are not flagged as C0. Reproducer requires C1-U with C0-V.
 *
 * Reproducer: B-SPLINE_SURFACE with knot multiplicities creating C0 in V
 * direction only; verify continuity checker identifies the defect.
 */
HEADER;
FILE_DESCRIPTION(('Gs162 test case','Surface C0 in single direction undetected'),'2;1');
FILE_NAME('Gs162.stp','2026-06-16T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
