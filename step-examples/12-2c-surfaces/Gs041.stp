ISO-10303-21;
/* Gs041 - RECTANGULAR_COMPOSITE_SURFACE with non-uniform patch grid
 * Defect: A RECTANGULAR_COMPOSITE_SURFACE is parameterised as an
 * MxN grid of SURFACE_PATCH children. The U-direction parameter
 * spans across all M patches; the V-direction across all N. The
 * spec permits non-uniform parameter intervals (one patch occupies
 * U=0..0.7, the next U=0.7..1.0). Many receivers assume uniform
 * spacing and either pass through with a wrong global parameterisation
 * or trip an internal assertion. Here a 2x1 composite surface has
 * U-intervals of 0.3 and 0.7. */
HEADER;
FILE_DESCRIPTION(('Gs041 - RECTANGULAR_COMPOSITE_SURFACE non-uniform patch grid'),'2;1');
FILE_NAME('Gs041.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
/* Two adjacent planar quad patches sharing an edge along V at U=0.3 */
#10=CARTESIAN_POINT('p00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p10',(3.0,0.0,0.0));
#12=CARTESIAN_POINT('p01',(0.0,1.0,0.0));
#13=CARTESIAN_POINT('p11',(3.0,1.0,0.0));
#14=CARTESIAN_POINT('p20',(10.0,0.0,0.0));
#15=CARTESIAN_POINT('p21',(10.0,1.0,0.0));
/* Bezier patch 1 - U range [0.0, 0.3] */
#20=B_SPLINE_SURFACE_WITH_KNOTS('left_patch',1,1,
  ((#10,#11),(#12,#13)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (2,2),(2,2),(0.0,0.3),(0.0,1.0),
  .UNSPECIFIED.);
/* Bezier patch 2 - U range [0.3, 1.0] - non-uniform with patch 1 */
#21=B_SPLINE_SURFACE_WITH_KNOTS('right_patch',1,1,
  ((#11,#14),(#13,#15)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (2,2),(2,2),(0.3,1.0),(0.0,1.0),
  .UNSPECIFIED.);
/* Defect: composite surface 2 patches wide, 1 tall, with the
 * left occupying 0..0.3 and the right 0.3..1.0 - non-uniform */
#30=SURFACE_PATCH(#20,.U_TYPE_OF_TRANSITION.,.U_TYPE_OF_TRANSITION.,.T.,.T.);
#31=SURFACE_PATCH(#21,.U_TYPE_OF_TRANSITION.,.U_TYPE_OF_TRANSITION.,.T.,.T.);
#40=RECTANGULAR_COMPOSITE_SURFACE('rcs',((#30,#31)));
ENDSEC;
END-ISO-10303-21;
