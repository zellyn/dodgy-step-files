ISO-10303-21;
/* Gs099 - Sphere pole singularity: iso-curve sampling misses pole
 *
 * Defect: ShapeAnalysis_Surface.Singularity() must report both poles of a sphere,
 * but iso-curve sampling (e.g., UIso/VIso sampling) may miss poles if orientation
 * places them outside the parametric trim bounds. Newton iteration on iso-curve
 * sampling fails to detect singular points at poles.
 *
 * Reproducer: SPHERICAL_SURFACE at non-zero U rotation offset; parametric trim
 * places poles v=0 and v=pi outside iso-curve sampling window.
 */
HEADER;
FILE_DESCRIPTION(('Gs099 test case','Sphere pole singularity; iso-curve sampling misses pole'),'2;1');
FILE_NAME('Gs099.stp','2026-06-15T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Axis placement: sphere centered at (100, 50, 25) */
#10=CARTESIAN_POINT('',(100.0,50.0,25.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* SPHERICAL_SURFACE radius 30.0 mm */
#20=SPHERICAL_SURFACE('',#13,30.0);
/* RECTANGULAR_TRIMMED_SURFACE: u in [0.5, 2.5], v in [0.3, 2.8]
   This trim places the northern pole (v~1.57) inside window but clips
   southern pole (v~0 and v~pi) near/outside bounds. */
#21=RECTANGULAR_TRIMMED_SURFACE('',#20,0.5,2.5,0.3,2.8,.T.,.T.);
/* Outer-bound vertex on sphere surface */
#30=CARTESIAN_POINT('',(130.0,50.0,25.0));
#31=VERTEX_POINT('',#30);
#32=VERTEX_LOOP('',#31);
#33=FACE_OUTER_BOUND('',#32,.T.);
/* ADVANCED_FACE with the trimmed sphere */
#34=ADVANCED_FACE('',(#33),#21,.T.);
#40=OPEN_SHELL('',(#34));
/* Product definition */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs099','Gs099','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#40),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
