ISO-10303-21;
/* Gs081 - ShapeAnalysis_Surface.IsUClosed extrusion-base form
 *
 * Defect: SURFACE_OF_LINEAR_EXTRUSION with open base curve; IsUClosed reports
 * false (correct) but loses extrusion-axis-closed information needed downstream.
 *
 * Reproducer: SURFACE_OF_LINEAR_EXTRUSION with open parabolic base curve
 * extruded along Z axis. */
HEADER;
FILE_DESCRIPTION(('Gs081 test case','Linear extrusion open-base IsUClosed loss'),'2;1');
FILE_NAME('Gs081.stp','2026-06-15T00:00:00',('Zellyn Hunter'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Base curve: parabola B-spline (open) */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(1.0,0.5,0.0));
#22=CARTESIAN_POINT('',(2.0,0.0,0.0));
#30=B_SPLINE_CURVE_WITH_KNOTS('',2,
  (#20,#21,#22),
  .UNSPECIFIED.,.F.,.F.,
  (2,2),
  (0.0,1.0),
  .UNSPECIFIED.);
/* Extrusion direction (Z-axis) */
#40=DIRECTION('',(0.0,0.0,1.0));
/* Linear extrusion of open parabola along Z */
#50=SURFACE_OF_LINEAR_EXTRUSION('',#30,#40);
/* Outer bound vertex */
#60=VERTEX_POINT('',#20);
#61=VERTEX_LOOP('',#60);
#62=FACE_OUTER_BOUND('',#61,.T.);
#70=ADVANCED_FACE('',(#62),#50,.T.);
#80=OPEN_SHELL('',(#70));
/* Product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs081','Gs081','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#80),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
