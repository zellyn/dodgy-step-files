ISO-10303-21;
/* Gs144 - ShapeAnalysis_Surface.ComputeBoxes null-ISO silent skip
 *
 * Defect: ComputeBoxes() iterates over ISO curves (U and V isos) to compute
 * boundary boxes. When an ISO curve is null (e.g., degenerate surface, missing
 * evaluation), the code skips BndLib_Add3dCurve::Add without reporting the
 * omission. Result: boundary box is incomplete, missing facets that touch
 * degenerate edges.
 *
 * Reproducer: TOROIDAL_SURFACE with one degenerate V-iso near seam;
 * ComputeBoxes silently omits the missing boundary contribution.
 */
HEADER;
FILE_DESCRIPTION(('Gs144 test case','ComputeBoxes null-ISO silent skip'),'2;1');
FILE_NAME('Gs144.stp','2026-06-16T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
