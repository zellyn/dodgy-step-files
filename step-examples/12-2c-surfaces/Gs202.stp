ISO-10303-21;
/* Gs202: PLANE IS ADVANCED_FACE.face_geometry; defect EDGE_CURVE curve_3d IS a clamped, NON-
   periodic, NON-closed degree-3 B_SPLINE_CURVE_WITH_KNOTS (4 poles, single span); the edge's own
   VERTEX_POINTs are SWAPPED relative to the curve's own parametrization -- edge_start sits at the
   curve's TRUE end pole (6,0,0) and edge_end sits at the curve's TRUE start pole (0,0,0) -- so
   vertex projection yields w1=1.0 (curve's last parameter) > w2=0.0 (curve's first parameter);
   StepToTopoDS_GeometricTool::UpdateParam3d's ordinary-bounded-curve fallback (distinct from the
   periodic/closed/near-closed branches) must physically REVERSE the curve (Geom_Curve::Reverse())
   and remap w1,w2 via ReversedParameter, restoring an increasing [0,1] range on the reversed
   curve rather than leaving w1>w2 unresolved */
HEADER;
FILE_DESCRIPTION(('Gs202'),'2;1');
FILE_NAME('Gs202.stp','2026-07-13T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
