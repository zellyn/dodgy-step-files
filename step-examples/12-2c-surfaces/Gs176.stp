ISO-10303-21;
/* Gs176 - RectangularTrimmedSurface basis-unwrap null check
 *
 * Defect: BasisSurface unwrapping assumes non-null, well-formed result.
 * Down_cast succeeds but BasisSurface() returns null; subsequent
 * GeomAdaptor_Surface(S) receives null, undefined behavior.
 *
 * Minimal reproducer: Trimmed B-spline (degree 2, 3x3 poles).
 * Wrapper delegates to basis. Healing should handle null basis.
 */
HEADER;
FILE_DESCRIPTION(('Gs176 test case','RectangularTrimmedSurface null basis unwrap'),'2;1');
FILE_NAME('Gs176.stp','2026-06-16T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
