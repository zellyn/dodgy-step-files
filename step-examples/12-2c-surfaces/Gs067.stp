ISO-10303-21;
/* Gs067: OFFSET_SURFACE (distance=-2.5) wrapping PLANE IS inside GEOMETRIC_CURVE_SET; negative distance (sign-flipped offset, plane on opposite side) IS the defect; ConvertSurfaceToBezierBasis ignores offset sign, collapses or inverts surface IS the mechanism failure; shape_null */
HEADER;
FILE_DESCRIPTION(('Gs067'),'2;1');
FILE_NAME('Gs067.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=DIRECTION('',(0.0,0.0,1.0));
#3=DIRECTION('',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('gs067_pl_ax',#1,#2,#3);
#5=PLANE('gs067_plane',#4);
#6=OFFSET_SURFACE('gs067_offset',#5,-2.5,.F.);
#7=CARTESIAN_POINT('',(0.0,0.0,0.0));
#8=CARTESIAN_POINT('',(0.0,0.0,-2.5));
#9=CARTESIAN_POINT('',(1.0,1.0,-2.5));
#10=GEOMETRIC_CURVE_SET('gs067_gcs',(#6,#7,#8,#9));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Gs067','Gs067','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#10),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
END-ISO-10303-21;
