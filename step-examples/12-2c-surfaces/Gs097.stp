ISO-10303-21;
/* Gs097 - ShapeUpgrade_FaceDivideArea.Perform threshold reset
 *
 * Defect: Face splitting by area threshold; threshold value 0.0 should mean
 * "don't split" but is incorrectly treated as "split every sub-face".
 * Reproducer: Planar face with area threshold 0.0 triggers infinite recursion.
 */
HEADER;
FILE_DESCRIPTION(('Gs097 test case','Face divide area threshold zero-value semantics'),'2;1');
FILE_NAME('Gs097.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
