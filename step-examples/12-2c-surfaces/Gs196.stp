ISO-10303-21;
/* Gs196: single ADVANCED_FACE on a CYLINDRICAL_SURFACE (radius 5.0) trimmed to U:[0, 2pi-1e-9] -- a genuine 1e-9 radian sliver short of the full period, bounded by two DISTINCT (non-shared) near-coincident end edges, so no seam edge exists. ShapeUpgrade_ClosedFaceDivide::SplitSurface's seam scan finds nothing; the geometric-closure fallback sees mySurf->IsUClosed()==True (cylinder is always U-closed) and (U2-U1)-(Ul-Uf)=1e-9 which is below GeomAdaptor_Surface::UResolution(Precision::Confusion()) (~2e-8 rad for this radius), so it builds a half-period Geom_RectangularTrimmedSurface and confirms that half is NOT closed, forcing the split -- live-verified via ShapeUpgrade_ShapeDivideClosed: 1 face -> 2 faces, split at the U midpoint */
HEADER;
FILE_DESCRIPTION(('Gs196'),'2;1');
FILE_NAME('Gs196.stp','2026-07-13T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
