#4=AXIS2_PLACEMENT_3D('gs196_cyl_ax',#1,#2,#3);
#5=CYLINDRICAL_SURFACE('gs196_cyl',#4,5.0);
#6=(GEOMETRIC_REPRESENTATION_CONTEXT(2)PARAMETRIC_REPRESENTATION_CONTEXT()REPRESENTATION_CONTEXT('UV','2D'));
