ISO-10303-21;
/* Gs201: PLANE IS ADVANCED_FACE.face_geometry; defect EDGE_CURVE curve_3d IS TRIMMED_CURVE over
   LINE with declared bounds PARAMETER_VALUE(1.5)..PARAMETER_VALUE(4.5), but the edge's own
   VERTEX_POINTs sit at line-parameter 1.0 and 5.0 -- both OUTSIDE the curve's own bounded
   definition range; StepToTopoDS_GeometricTool::UpdateParam3d's Geom_BoundedCurve clamp branch
   must clamp both projected parameters back to the curve's [1.5,4.5] domain rather than leaving
   an out-of-range trim; distinct from Gs029 (periodic wrap-wrong-way) and Twi086 (w1==w2) */
HEADER;
FILE_DESCRIPTION(('Gs201'),'2;1');
FILE_NAME('Gs201.stp','2026-07-13T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
