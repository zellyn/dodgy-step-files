ISO-10303-21;
/* Gs057 - RECTANGULAR_COMPOSITE_SURFACE silently dropped (LoadONBrep stub)
   Defect: BRL-CAD step-g implements RECTANGULAR_COMPOSITE_SURFACE::Load
   (it parses the segments grid into SurfacePatch objects) but its
   LoadONBrep is a stub that prints "::LoadONBrep(...) not implemented for
   <entity>" and returns false.  The face referencing the composite
   surface is dropped without further diagnostic; downstream the shell
   appears with one face missing.  Algebraically a rectangular composite
   surface is just a piecewise-Bezier / piecewise-NURBS quilt and could
   be promoted to a single B_SPLINE_SURFACE_WITH_KNOTS at multiplicity
   degree+1 internal knots.
   Sources: BRL-CAD src/conv/step/step-g/RectangularCompositeSurface.cpp
   LoadONBrep stub. */
HEADER;
FILE_DESCRIPTION(
  ('Gs057 - RECTANGULAR_COMPOSITE_SURFACE silently dropped by step-g'),
  '2;1');
FILE_NAME('Gs057.stp','2026-05-02T00:00:00',('cad-research-suite'),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Two adjacent 4x4 Bezier patches forming a 1x2 rectangular composite
   surface. */
#10=CARTESIAN_POINT('p00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p01',(0.0,1.0,0.0));
#12=CARTESIAN_POINT('p02',(0.0,2.0,0.0));
#13=CARTESIAN_POINT('p03',(0.0,3.0,0.0));
#20=CARTESIAN_POINT('p10',(1.0,0.0,0.5));
#21=CARTESIAN_POINT('p11',(1.0,1.0,1.0));
#22=CARTESIAN_POINT('p12',(1.0,2.0,1.0));
#23=CARTESIAN_POINT('p13',(1.0,3.0,0.5));
#30=CARTESIAN_POINT('p20',(2.0,0.0,0.5));
#31=CARTESIAN_POINT('p21',(2.0,1.0,1.0));
#32=CARTESIAN_POINT('p22',(2.0,2.0,1.0));
#33=CARTESIAN_POINT('p23',(2.0,3.0,0.5));
#40=CARTESIAN_POINT('p30',(3.0,0.0,0.0));
#41=CARTESIAN_POINT('p31',(3.0,1.0,0.0));
#42=CARTESIAN_POINT('p32',(3.0,2.0,0.0));
#43=CARTESIAN_POINT('p33',(3.0,3.0,0.0));
#50=CARTESIAN_POINT('p40',(4.0,0.0,0.0));
#51=CARTESIAN_POINT('p41',(4.0,1.0,0.0));
#52=CARTESIAN_POINT('p42',(4.0,2.0,0.0));
#53=CARTESIAN_POINT('p43',(4.0,3.0,0.0));
#60=CARTESIAN_POINT('p50',(5.0,0.0,0.5));
#61=CARTESIAN_POINT('p51',(5.0,1.0,0.5));
#62=CARTESIAN_POINT('p52',(5.0,2.0,0.5));
#63=CARTESIAN_POINT('p53',(5.0,3.0,0.5));
#70=CARTESIAN_POINT('p60',(6.0,0.0,0.0));
#71=CARTESIAN_POINT('p61',(6.0,1.0,0.0));
#72=CARTESIAN_POINT('p62',(6.0,2.0,0.0));
#73=CARTESIAN_POINT('p63',(6.0,3.0,0.0));
/* Patch (0,0): 4x4 Bezier, U/V transition CONT (continuous at boundary
   to the next patch). */
#100=BEZIER_SURFACE('patchA',3,3,
  ((#10,#11,#12,#13),(#20,#21,#22,#23),(#30,#31,#32,#33),(#40,#41,#42,#43)),
  .UNSPECIFIED.,.F.,.F.,.F.);
#101=SURFACE_PATCH(#100,.CONT_SAME_GRADIENT.,.UNSPECIFIED.,.T.,.T.);
/* Patch (0,1). */
#200=BEZIER_SURFACE('patchB',3,3,
  ((#40,#41,#42,#43),(#50,#51,#52,#53),(#60,#61,#62,#63),(#70,#71,#72,#73)),
  .UNSPECIFIED.,.F.,.F.,.F.);
#201=SURFACE_PATCH(#200,.UNSPECIFIED.,.UNSPECIFIED.,.T.,.T.);
/* Defect: RECTANGULAR_COMPOSITE_SURFACE - step-g LoadONBrep stub
   silently drops the face. */
#300=RECTANGULAR_COMPOSITE_SURFACE('quilt',((#101,#201)));
ENDSEC;
END-ISO-10303-21;
