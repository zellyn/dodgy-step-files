ISO-10303-21;
/* Gs098 - ShapeAnalysis_Surface.IsDegenerated revolution-axis-on-curve
 *
 * Defect: SURFACE_OF_REVOLUTION where basis curve passes through the axis.
 * IsDegenerated only checks axis vector direction, not curve position,
 * missing the degenerate apex singularity.
 * Reproducer: Surface of revolution with profile curve crossing axis.
 */
HEADER;
FILE_DESCRIPTION(('Gs098 test case','Surface of revolution axis-crossing profile'),'2;1');
FILE_NAME('Gs098.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Axis of revolution — Z-axis */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=AXIS1_PLACEMENT('',#10,#11);
/* Profile curve that crosses the axis: line from (0,0,0) to (2,0,5) */
/* This curve touches the axis at origin, creating degeneracy */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(2.0,0.0,5.0));
#22=LINE('',#20,#23);
#23=VECTOR('',(2.0,0.0,5.0),1.0);
#24=VERTEX_POINT('',#20);
#25=VERTEX_POINT('',#21);
#26=EDGE_CURVE('',#24,#25,#22,.T.);
#27=ORIENTED_EDGE('',*,*,#26,.T.);
#28=EDGE_LOOP('',(#27));
/* Surface of revolution from profile */
#30=SURFACE_OF_REVOLUTION('',#22,#12);
/* Boundary vertex */
#40=CARTESIAN_POINT('',(0.0,0.0,0.0));
#41=VERTEX_POINT('',#40);
#42=VERTEX_LOOP('',#41);
#43=FACE_OUTER_BOUND('',#42,.T.);
#44=ADVANCED_FACE('',(#43),#30,.T.);
#45=OPEN_SHELL('',(#44));
/* Product context and shape representation */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs098','Gs098','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#30),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
