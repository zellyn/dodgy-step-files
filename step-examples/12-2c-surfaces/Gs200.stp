ISO-10303-21;
/* Gs200: single ADVANCED_FACE on a TOROIDAL_SURFACE (major radius 6.0, minor radius 2.0), a
   quarter-wedge in the MAJOR (U) angle direction that is FULLY CLOSED in the MINOR (V, tube)
   direction; loop = tube-circle at u=0 (full circle, V-closed) + outer-equator seam arc (u:0->
   pi/2, v=0) + tube-circle at u=pi/2 (full circle) + a SECOND, geometrically-coincident but
   UNSHARED outer-equator arc entity closing back to u=0 -- the two equator-arc edges are the
   V-periodic seam pair BRepBuilderAPI_Sewing::IsMergedClosed/AnalysisNearestEdges must recognize
   and merge (V-periodic analogue of Tsh209's U-periodic cylinder seam pair) */
HEADER;
FILE_DESCRIPTION(('Gs200'),'2;1');
FILE_NAME('Gs200.stp','2026-07-13T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
