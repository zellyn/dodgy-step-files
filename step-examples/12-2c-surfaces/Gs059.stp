ISO-10303-21;
/* Gs059 - ShapeAnalysis_Surface.IsUClosed B-spline knot-multiplicity midpoint sanity
 * Closed B-spline surface where midpoint sample disagrees with knot-implied closure.
 * Defect: A B_SPLINE_SURFACE_WITH_KNOTS is declared CLOSED in U direction via
 * identical start/end knot vectors and periodic knot multiplicities. IsUClosed
 * checks both the knot structure AND a midpoint sample. If the last pole at u_max
 * differs from the first pole at u_min, the closure claim is false. Here we
 * construct a surface where knot structure implies closure but the pole at u_max
 * is offset by a small amount, breaking actual closure. */
HEADER;
FILE_DESCRIPTION(('Gs059 - B-spline knot-multiplicity closure sanity check'),'2;1');
FILE_NAME('Gs059.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
/* Degree 3, 8 control points in U, 4 in V */
/* U knots: [0, 0, 0, 0, 1, 2, 3, 4, 4, 4, 4] with multiplicities [4,1,1,1,4] */
/* This makes the surface closed in U via periodic wrapping */
#10=CARTESIAN_POINT('pole_0_0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('pole_1_0',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('pole_2_0',(2.0,0.5,0.0));
#13=CARTESIAN_POINT('pole_3_0',(1.5,1.5,0.0));
#14=CARTESIAN_POINT('pole_4_0',(1.0,2.0,0.0));
#15=CARTESIAN_POINT('pole_5_0',(0.5,1.5,0.0));
#16=CARTESIAN_POINT('pole_6_0',(-0.5,0.5,0.0));
/* DEFECT: pole_7_0 offset by 0.01 in Z so it differs from pole_0_0 */
#17=CARTESIAN_POINT('pole_7_0_broken',(0.0,0.0,0.01));
/* V row 1 */
#20=CARTESIAN_POINT('pole_0_1',(0.0,0.0,1.0));
#21=CARTESIAN_POINT('pole_1_1',(1.0,0.0,1.0));
#22=CARTESIAN_POINT('pole_2_1',(2.0,0.5,1.0));
#23=CARTESIAN_POINT('pole_3_1',(1.5,1.5,1.0));
#24=CARTESIAN_POINT('pole_4_1',(1.0,2.0,1.0));
#25=CARTESIAN_POINT('pole_5_1',(0.5,1.5,1.0));
#26=CARTESIAN_POINT('pole_6_1',(-0.5,0.5,1.0));
#27=CARTESIAN_POINT('pole_7_1_broken',(0.0,0.0,1.01));
/* V row 2 */
#30=CARTESIAN_POINT('pole_0_2',(0.0,0.0,2.0));
#31=CARTESIAN_POINT('pole_1_2',(1.0,0.0,2.0));
#32=CARTESIAN_POINT('pole_2_2',(2.0,0.5,2.0));
#33=CARTESIAN_POINT('pole_3_2',(1.5,1.5,2.0));
#34=CARTESIAN_POINT('pole_4_2',(1.0,2.0,2.0));
#35=CARTESIAN_POINT('pole_5_2',(0.5,1.5,2.0));
#36=CARTESIAN_POINT('pole_6_2',(-0.5,0.5,2.0));
#37=CARTESIAN_POINT('pole_7_2_broken',(0.0,0.0,2.01));
/* V row 3 */
#40=CARTESIAN_POINT('pole_0_3',(0.0,0.0,3.0));
#41=CARTESIAN_POINT('pole_1_3',(1.0,0.0,3.0));
#42=CARTESIAN_POINT('pole_2_3',(2.0,0.5,3.0));
#43=CARTESIAN_POINT('pole_3_3',(1.5,1.5,3.0));
#44=CARTESIAN_POINT('pole_4_3',(1.0,2.0,3.0));
#45=CARTESIAN_POINT('pole_5_3',(0.5,1.5,3.0));
#46=CARTESIAN_POINT('pole_6_3',(-0.5,0.5,3.0));
#47=CARTESIAN_POINT('pole_7_3_broken',(0.0,0.0,3.01));
/* B-spline surface: 8 poles U x 4 poles V, degree 3 in U, degree 2 in V */
#100=B_SPLINE_SURFACE_WITH_KNOTS(
  'closed_but_broken',
  3,2,
  ((#10,#11,#12,#13,#14,#15,#16,#17),
   (#20,#21,#22,#23,#24,#25,#26,#27),
   (#30,#31,#32,#33,#34,#35,#36,#37),
   (#40,#41,#42,#43,#44,#45,#46,#47)),
  .UNSPECIFIED.,
  .F.,
  .F.,
  (4,1,1,1,4),
  (3,1,1,3),
  (0.0,1.0,2.0,3.0,4.0),
  (0.0,1.0,2.0,3.0),
  .UNSPECIFIED.,
  .UNSPECIFIED.);
ENDSEC;
END-ISO-10303-21;
