ISO-10303-21;
/* Gs205: CLOSED_SHELL whose CONICAL_SURFACE face (ref radius 5 at z=0, 45-degree semi-angle, apex at (0,0,-5)) has its apex expressed as a VERTEX_LOOP inner FACE_BOUND -- the ISO 10303-42 encoding for a boundary that collapses to a single point. The reader turns it into a zero-length edge with no 3D curve at all, formally flagged degenerate: a legitimate, non-defective piece of B-Rep topology that a healing pass must recognise and leave alone rather than treat as a small/collapsed edge to remove */
HEADER;
FILE_DESCRIPTION(('Gs205'),'2;1');
FILE_NAME('Gs205.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
