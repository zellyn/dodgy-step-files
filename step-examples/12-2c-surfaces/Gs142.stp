ISO-10303-21;
/* Gs142 - ShapeUpgrade_Surface.Segment rational-weight singularity edge case
 *
 * Defect: Segment() splits rational B-spline surfaces by subdividing in U/V
 * but does not validate that computed singular points (where weight=0 or
 * near-singular) remain within parametric bounds after split. Weights can
 * create false singularities at split edges.
 *
 * Reproducer: Rational B-spline surface (degree 2, mixed weights 1.0 and 0.5);
 * splitting at u=0.5 creates patch where weight transition occurs at boundary,
 * rendering boundary evaluation unstable.
 */
HEADER;
FILE_DESCRIPTION(('Gs142 test case','Segment rational-weight singularity'),'2;1');
FILE_NAME('Gs142.stp','2026-06-16T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
