ISO-10303-21;
/* Gs156 - ShapeExtend_WireData::EditVertex ordering corruption
 *
 * Defect: EditVertex modifies a wire's vertex list in-place during iteration.
 * If the wire has multiple edges sharing the same vertex, the reorder may corrupt
 * edge-to-vertex connectivity, breaking EDGE_LOOP traversal invariants.
 *
 * Reproducer: EDGE_LOOP where edge N and N+1 share a vertex; apply
 * EditVertex and verify loop closure remains valid.
 */
HEADER;
FILE_DESCRIPTION(('Gs156 test case','EditVertex ordering corruption'),'2;1');
FILE_NAME('Gs156.stp','2026-06-16T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
