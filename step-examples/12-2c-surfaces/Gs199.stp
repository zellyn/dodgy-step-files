ISO-10303-21;
/* Gs199: TOROIDAL_SURFACE IS ADVANCED_FACE.face_geometry; VERTEX_LOOP (single point on the outer
   equator) IS the face's sole FACE_OUTER_BOUND; distinct from Gs039's sphere (natural-bounds
   branch, StepToTopoDS_TranslateFace.cxx:566-585) and Twi281's plane (warned-and-dropped branch,
   :590-593) -- on a TOROIDAL_SURFACE the VERTEX_LOOP bound is SILENTLY dropped with no warning
   at all (:587-589 `if (GeomSurf->IsKind(STANDARD_TYPE(Geom_ToroidalSurface))) { continue; }`) */
HEADER;
FILE_DESCRIPTION(('Gs199'),'2;1');
FILE_NAME('Gs199.stp','2026-07-13T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=DIRECTION('',(0.0,0.0,1.0));
#3=DIRECTION('',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('gs199_ax',#1,#2,#3);
#5=TOROIDAL_SURFACE('gs199_torus',#4,6.0,2.0);
#6=CARTESIAN_POINT('',(8.0,0.0,0.0));
#7=VERTEX_POINT('',#6);
#8=VERTEX_LOOP('gs199_vloop',#7);
#9=FACE_OUTER_BOUND('',#8,.T.);
#10=ADVANCED_FACE('gs199_face',(#9),#5,.T.);
#11=OPEN_SHELL('gs199_shell',(#10));
#12=SHELL_BASED_SURFACE_MODEL('gs199_sbsm',(#11));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Gs199','Gs199','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#12),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
END-ISO-10303-21;
