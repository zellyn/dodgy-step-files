ISO-10303-21;
/* Gs195: single ADVANCED_FACE on a SURFACE_OF_REVOLUTION sweeping a full CIRCLE profile (radius 1.5, offset 5.0 from the Z revolution axis) through a 270-degree wedge (u:pi/2..2pi) -- two DISTINCT (non-shared) profile-circle edges bound the wedge in U, so no seam edge exists; V is fully periodic and untrimmed since the swept curve is a closed circle. Geom_SurfaceOfRevolution::IsVClosed() returns basisCurve->IsClosed()==True while the face's own U range does not span the surface's full 2pi period, so ShapeUpgrade_ClosedFaceDivide::SplitSurface's seam scan finds nothing, U-closure's near-full-period guard fails (U trim is only 270 of 360 degrees), and the V-fallback (sas->IsVClosed) alone triggers the split -- live-verified via ShapeUpgrade_ShapeDivideClosed: 1 face -> 2 faces, split along V only, U bounds unchanged */
HEADER;
FILE_DESCRIPTION(('Gs195'),'2;1');
FILE_NAME('Gs195.stp','2026-07-13T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
/* profile circle at u=0, in local XZ-plane, center (5,0,0), radius 1.5 */
#1=CARTESIAN_POINT('',(5.0,0.0,0.0));
#2=DIRECTION('',(0.0,-1.0,0.0));
#3=DIRECTION('',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('gs195_profile0_ax',#1,#2,#3);
#5=CIRCLE('gs195_profile0',#4,1.5);
/* revolution axis: Z through origin */
#6=CARTESIAN_POINT('',(0.0,0.0,0.0));
#7=DIRECTION('',(0.0,0.0,1.0));
#8=AXIS1_PLACEMENT('gs195_rev_ax',#6,#7);
#9=SURFACE_OF_REVOLUTION('gs195_surf',#5,#8);
#10=(GEOMETRIC_REPRESENTATION_CONTEXT(2)PARAMETRIC_REPRESENTATION_CONTEXT()REPRESENTATION_CONTEXT('UV','2D'));
/* edge at u=0: reuse profile circle #5 as 3D curve, closed vertex-to-itself */
#11=CARTESIAN_POINT('',(6.5,0.0,0.0));
#12=VERTEX_POINT('',#11);
#13=CARTESIAN_POINT('',(0.0,0.0));
#14=DIRECTION('',(0.0,1.0));
#15=VECTOR('',#14,6.283185307179586);
#16=LINE('',#13,#15);
#17=DEFINITIONAL_REPRESENTATION('u0_pcdef',(#16),#10);
#18=PCURVE('u0_pc',#9,#17);
#19=SURFACE_CURVE('u0_sc',#5,(#18),.PCURVE_S1.);
#20=EDGE_CURVE('gs195_edge_u0',#12,#12,#19,.T.);
/* profile circle at u=pi/2, center (0,5,0), radius 1.5, rotated 90deg about Z */
#21=CARTESIAN_POINT('',(0.0,5.0,0.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=DIRECTION('',(0.0,1.0,0.0));
#24=AXIS2_PLACEMENT_3D('gs195_profile90_ax',#21,#22,#23);
#25=CIRCLE('gs195_profile90',#24,1.5);
#26=CARTESIAN_POINT('',(0.0,6.5,0.0));
#27=VERTEX_POINT('',#26);
#28=CARTESIAN_POINT('',(1.5707963268,0.0));
#29=DIRECTION('',(0.0,1.0));
#30=VECTOR('',#29,6.283185307179586);
#31=LINE('',#28,#30);
#32=DEFINITIONAL_REPRESENTATION('u90_pcdef',(#31),#10);
#33=PCURVE('u90_pc',#9,#32);
#34=SURFACE_CURVE('u90_sc',#25,(#33),.PCURVE_S1.);
#35=EDGE_CURVE('gs195_edge_u90',#27,#27,#34,.T.);
#36=ORIENTED_EDGE('',$,$,#20,.T.);
#37=EDGE_LOOP('',(#36));
#38=FACE_OUTER_BOUND('',#37,.T.);
#39=ORIENTED_EDGE('',$,$,#35,.T.);
#40=EDGE_LOOP('',(#39));
#41=FACE_BOUND('',#40,.T.);
#42=ADVANCED_FACE('',(#38,#41),#9,.T.);
#43=OPEN_SHELL('',(#42));
#44=SHELL_BASED_SURFACE_MODEL('',(#43));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Gs195','Gs195','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#44),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
END-ISO-10303-21;
