ISO-10303-21;
/* Gs054 - Composite curve segment self-cyclic to its containing composite
 * Defect: COMPOSITE_CURVE_SEGMENT.parent_curve references the very
 * COMPOSITE_CURVE that contains the segment. Translator must break the
 * recursion (drop the segment with a warning) rather than recursing
 * forever or stack-overflowing. */
HEADER;
FILE_DESCRIPTION(('Gs054 - composite curve segment self-cyclic'),'2;1');
FILE_NAME('Gs054.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Bounded basis LINE for the valid second segment */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(1.0,0.0,0.0));
#12=VECTOR('',#11,1.0);
#13=LINE('',#10,#12);
#14=PARAMETER_VALUE(0.0);
#15=PARAMETER_VALUE(10.0);
#16=TRIMMED_CURVE('',#13,(#14),(#15),.T.,.PARAMETER.);
/* Defect: parent_curve forward-references the COMPOSITE_CURVE that contains
   this segment (cyclic to #30). */
#21=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#30);
/* Valid segment for compositional integrity */
#22=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#16);
#30=COMPOSITE_CURVE('',(#21,#22),.F.);
ENDSEC;
END-ISO-10303-21;
