ISO-10303-21;
/* Gs106 - Concentrated-poles surface with Newton underflow
 *
 * Defect: ShapeAnalysis_Surface.NextValueOfUV fails on surfaces where all
 *  control poles cluster in a small region, creating high curvature and
 *  causing Newton iteration step to underflow (step size becomes subnormal).
 *
 * Reproducer: B-spline surface with control poles clustered in 1mm cube
 *  at origin; parameter queries fail to converge due to ill-conditioned
 *  Hessian in Newton solver.
 *
 * Expected kernel behavior:
 *   heal - detect pole clustering, refit surface with better distribution;
 *   reject with "numerically ill-conditioned surface" diagnostic. */
HEADER;
FILE_DESCRIPTION(('Gs106 test case','Concentrated-poles surface Newton underflow'),'2;1');
FILE_NAME('Gs106.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Defect: All 9 control poles clustered in tiny region near origin */
/* Meant to approximate a point cloud at small scale, creates numerical instability */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(0.1,0.0,0.0));
#12=CARTESIAN_POINT('',(0.2,0.0,0.0));
#13=CARTESIAN_POINT('',(0.0,0.1,0.0));
#14=CARTESIAN_POINT('',(0.1,0.1,0.05));
#15=CARTESIAN_POINT('',(0.2,0.1,0.0));
#16=CARTESIAN_POINT('',(0.0,0.2,0.0));
#17=CARTESIAN_POINT('',(0.1,0.2,0.0));
#18=CARTESIAN_POINT('',(0.2,0.2,0.0));
/* 3x3 B-spline surface with poles in millimeter cube */
/* High curvature concentration causes ill-conditioning */
#30=B_SPLINE_SURFACE_WITH_KNOTS('',2,2,
  ((#10,#13,#16),(#11,#14,#17),(#12,#15,#18)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (3,3),(3,3),(0.0,1.0),(0.0,1.0),
  .UNSPECIFIED.);
/* Outer-bound vertex */
#40=CARTESIAN_POINT('',(0.0,0.0,0.0));
#41=VERTEX_POINT('',#40);
#42=VERTEX_LOOP('',#41);
#43=FACE_OUTER_BOUND('',#42,.T.);
/* Face with ill-conditioned surface */
#44=ADVANCED_FACE('',(#43),#30,.T.);
#45=OPEN_SHELL('',(#44));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs106','Gs106','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#45),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
