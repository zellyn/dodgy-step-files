ISO-10303-21;
/* Gs177 - ConicalSurface apex singularity detection
 *
 * Defect: ComputeSingularities.conic-apex-singularity
 * Apex point at computed v-parameter. Without detection,
 * healer unable to correct degeneracy at cone collapse.
 *
 * Minimal reproducer: Cone (semi-angle π/4, ref-radius 1.0).
 * Apex should be at v-parameter computed from geometry.
 * Verify singularity point matches cone apex in 3D.
 */
HEADER;
FILE_DESCRIPTION(('Gs177 test case','ConicalSurface apex singularity'),'2;1');
FILE_NAME('Gs177.stp','2026-06-16T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
