ISO-10303-21;
/* Gs082 - ShapeAnalysis_Surface.NextValueOfUV curvature step-size
 *
 * Defect: surface with high curvature gradient at target; Newton step shrinks
 * to under epsilon before converging.
 *
 * Reproducer: B_SPLINE_SURFACE with sharp peak (high curvature discontinuity). */
HEADER;
FILE_DESCRIPTION(('Gs082 test case','High-curvature gradient Newton step collapse'),'2;1');
FILE_NAME('Gs082.stp','2026-06-15T00:00:00',('Zellyn Hunter'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Control points: 3x3 grid with sharp peak at center */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(1.0,0.0,0.0));
#22=CARTESIAN_POINT('',(2.0,0.0,0.0));
#23=CARTESIAN_POINT('',(0.0,1.0,0.0));
#24=CARTESIAN_POINT('',(1.0,1.0,5.0));
#25=CARTESIAN_POINT('',(2.0,1.0,0.0));
#26=CARTESIAN_POINT('',(0.0,2.0,0.0));
#27=CARTESIAN_POINT('',(1.0,2.0,0.0));
#28=CARTESIAN_POINT('',(2.0,2.0,0.0));
/* B-spline with sharp discontinuity */
#30=B_SPLINE_SURFACE_WITH_KNOTS('',2,2,
  (#20,#21,#22,#23,#24,#25,#26,#27,#28),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (2,1,2),(2,1,2),
  (0.0,0.5,1.0,1.5),
  (0.0,0.5,1.0,1.5),
  .UNSPECIFIED.);
/* Outer bound */
#40=VERTEX_POINT('',#20);
#41=VERTEX_LOOP('',#40);
#42=FACE_OUTER_BOUND('',#41,.T.);
#50=ADVANCED_FACE('',(#42),#30,.T.);
#60=OPEN_SHELL('',(#50));
/* Product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs082','Gs082','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#60),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
