ISO-10303-21;
/* Gs110 - ShapeUpgrade_SplitSurface.SetUSplitValues count-mismatch
 *
 * Defect: SetUSplitValues called with 3 split values for a surface that
 *  internally allocates 2 split slots; silently drops 3rd value without
 *  validation or warning.
 *
 * Reproducer: PLANE surface with SetUSplitValues(3 values) when internal
 *  allocation expects 2; the 3rd value is ignored.
 *
 * Expected kernel behavior:
 *   validate - SetUSplitValues should reject mismatched split counts or
 *              allocate dynamically. */
HEADER;
FILE_DESCRIPTION(('Gs110 test case','ShapeUpgrade_SplitSurface count-mismatch'),'2;1');
FILE_NAME('Gs110.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Axis placement at origin */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* PLANE surface */
#20=PLANE('',#13);
/* Bounding vertices forming a rectangular face */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=CARTESIAN_POINT('',(100.0,0.0,0.0));
#32=CARTESIAN_POINT('',(100.0,100.0,0.0));
#33=CARTESIAN_POINT('',(0.0,100.0,0.0));
#34=VERTEX_POINT('',#30);
#35=VERTEX_POINT('',#31);
#36=VERTEX_POINT('',#32);
#37=VERTEX_POINT('',#33);
/* Edge loop defining the rectangular perimeter */
#40=EDGE_CURVE('',#34,#35,#41,.T.);
#41=LINE('',#30,#50);
#50=VECTOR('',#51,100.0);
#51=DIRECTION('',(1.0,0.0,0.0));
#60=EDGE_LOOP('',(#40));
#61=FACE_OUTER_BOUND('',#60,.T.);
/* ADVANCED_FACE with plane */
#62=ADVANCED_FACE('',(#61),#20,.T.);
/* Wrap into shell */
#70=OPEN_SHELL('',(#62));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs110','Gs110','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#70),#9010);
