ISO-10303-21;
/* Gs158 - BRepBuilderAPI_Sewing::AddFace null geometry propagation
 *
 * Defect: AddFace processes ADVANCED_FACE entities but does not validate
 * that the underlying surface is non-null. If a surface reference is invalid
 * or dangling, the sewing algorithm may silently skip the face or propagate
 * null pointers downstream, breaking shell coherence without diagnostic.
 *
 * Reproducer: ADVANCED_FACE with well-formed geometry, apply sewing,
 * and verify null-check robustness.
 */
HEADER;
FILE_DESCRIPTION(('Gs158 test case','AddFace null geometry propagation'),'2;1');
FILE_NAME('Gs158.stp','2026-06-16T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
