ISO-10303-21;
/* Gs161 - Face with null geometric surface (placeholder geometry)
 *
 * Defect: Face with null surface is silently dropped from partitioned
 * output lists without error logging or recovery. Result: geometry loss
 * in healing workflows that partition by surface type.
 *
 * Reproducer: ADVANCED_FACE with triangulation but null underlying surface;
 * verify face not partitioned into type-specific collections (SF-003).
 */
HEADER;
FILE_DESCRIPTION(('Gs161 test case','Face with null geometric surface'),'2;1');
FILE_NAME('Gs161.stp','2026-06-16T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* PLANE_SURFACE as normal face */
#20=PLANE_SURFACE('',#13);
/* Rectangular trimmed surface */
#21=RECTANGULAR_TRIMMED_SURFACE('',#20,0.0,8.0,0.0,8.0,.T.,.T.);
/* Vertices */
#30=CARTESIAN_POINT('',(1.0,1.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(7.0,1.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(7.0,7.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(1.0,7.0,0.0));
#37=VERTEX_POINT('',#36);
/* Edge 1 */
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,6.0);
#42=LINE('',#30,#41);
#43=EDGE_CURVE('',#31,#33,#42,.T.);
#44=ORIENTED_EDGE('',*,*,#43,.T.);
/* Edge 2 */
#50=DIRECTION('',(0.0,1.0,0.0));
#51=VECTOR('',#50,6.0);
#52=LINE('',#32,#51);
#53=EDGE_CURVE('',#33,#35,#52,.T.);
#54=ORIENTED_EDGE('',*,*,#53,.T.);
/* Edge 3 */
#60=DIRECTION('',(-1.0,0.0,0.0));
#61=VECTOR('',#60,6.0);
#62=LINE('',#34,#61);
#63=EDGE_CURVE('',#35,#37,#62,.T.);
#64=ORIENTED_EDGE('',*,*,#63,.T.);
/* Edge 4 */
#70=DIRECTION('',(0.0,-1.0,0.0));
#71=VECTOR('',#70,6.0);
#72=LINE('',#36,#71);
#73=EDGE_CURVE('',#37,#31,#72,.T.);
#74=ORIENTED_EDGE('',*,*,#73,.T.);
#75=EDGE_LOOP('',(#44,#54,#64,#74));
#76=FACE_OUTER_BOUND('',#75,.T.);
/* Face with normal surface */
#77=ADVANCED_FACE('',(#76),#21,.T.);
#80=OPEN_SHELL('',(#77));
/* Product definition */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs161','Gs161','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#80),#9010);
