ISO-10303-21;
/* Gs111 - ShapeAnalysis_Surface.IsDegenerated SURFACE_OF_LINEAR_EXTRUSION zero-extrusion
 *
 * Defect: SURFACE_OF_LINEAR_EXTRUSION with zero-magnitude extrusion vector;
 *  surface collapses to base curve but IsDegenerated's test uses Length()
 *  which returns positive value for zero VECTOR magnitude due to sign bug.
 *
 * Reproducer: SURFACE_OF_LINEAR_EXTRUSION('',base_curve,extrusion_vector)
 *  where extrusion_vector has magnitude 0.0; IsDegenerated fails to detect
 *  the degenerate case.
 *
 * Expected kernel behavior:
 *   detect - IsDegenerated should return TRUE for zero extrusion magnitude. */
HEADER;
FILE_DESCRIPTION(('Gs111 test case','ShapeAnalysis_Surface.IsDegenerated zero extrusion'),'2;1');
FILE_NAME('Gs111.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Axis placement at origin */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Base curve - a LINE */
#20=LINE('',#10,#30);
#30=VECTOR('',#31,100.0);
#31=DIRECTION('',(1.0,0.0,0.0));
/* Zero-magnitude extrusion vector - causes degeneration */
#40=VECTOR('',#41,0.0);
#41=DIRECTION('',(0.0,0.0,1.0));
/* SURFACE_OF_LINEAR_EXTRUSION with zero extrusion */
#50=SURFACE_OF_LINEAR_EXTRUSION('',#20,#40);
/* Bounding vertex */
#60=CARTESIAN_POINT('',(100.0,0.0,0.0));
#61=VERTEX_POINT('',#60);
#62=VERTEX_LOOP('',#61);
#63=FACE_OUTER_BOUND('',#62,.T.);
/* ADVANCED_FACE with degenerate extrusion surface */
#64=ADVANCED_FACE('',(#63),#50,.T.);
/* Wrap into shell */
#70=OPEN_SHELL('',(#64));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs111','Gs111','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#70),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
