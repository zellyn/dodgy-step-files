ISO-10303-21;
/* Gs194: single ADVANCED_FACE on a TOROIDAL_SURFACE closed in BOTH U and V; one explicit seam edge (U direction, referenced forward+reversed) plus a second seam edge (V direction, referenced forward+reversed) sharing the single vertex at their intersection -- the face wraps the FULL period in both parametric directions with no other boundary. ShapeUpgrade_ClosedFaceDivide::SplitSurface detects the explicit U seam first (splits U), then recursively re-invokes SplitSurface on each resulting sub-face, which is still V-closed and gets split again -- live-verified via ShapeUpgrade_ShapeDivideClosed: 1 face -> 4 faces (2x2 grid covering full U x full V) */
HEADER;
FILE_DESCRIPTION(('Gs194'),'2;1');
FILE_NAME('Gs194.stp','2026-07-13T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
