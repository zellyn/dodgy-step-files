ISO-10303-21;
/* Gs078: nested OFFSET_SURFACE (outer +0.5 wraps inner +0.5 wrapping PLANE) IS inside GEOMETRIC_CURVE_SET; total expected Z-offset = +1.0 IS the correct result; ConvertSurfaceToBezierBasis sign error in recursive offset chain IS the mechanism failure; computes Z=0.0 or Z=-1.0 instead of +1.0; shape_null */
HEADER;
FILE_DESCRIPTION(('Gs078'),'2;1');
FILE_NAME('Gs078.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
