#11=CARTESIAN_POINT('',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('',(2.0,0.0,0.0));
#13=CARTESIAN_POINT('',(3.0,0.0,0.0));
#14=CARTESIAN_POINT('',(4.0,0.0,0.0));
/* Source line */
