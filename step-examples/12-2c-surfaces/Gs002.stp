ISO-10303-21;
/* Gs002 - Degenerate (lemon/apple) torus where minor_radius >= major_radius
 *
 * Sources:  G010, G011, G066
 *
 * Defect: STEP TOROIDAL_SURFACE with minor radius equal to or exceeding major
 *  radius collapses the analytic torus into a self-intersecting "lemon"
 *  (minor>major, no central hole) or an "apple" (minor=major, single pinch
 *  point). OCCT pre-fix produced overlarge bounding boxes and FixMissingSeam
 *  did not handle the degenerate-torus case; revolved-shape variant (G011)
 *  imported inverted.
 *
 * Reproducer:  TOROIDAL_SURFACE with major_radius=2, minor_radius=3.
 *  Reference from a face with single FACE_OUTER_BOUND covering the full
 *  parameter rectangle (single VERTEX_LOOP natural bound).
 *
 * Expected kernel behavior:
 *   heal - accept the analytic surface, recognise it as degenerate, treat the
 *   parameter range as regular for seam insertion; compute bbox correctly for
 *   visualisation. */
HEADER;
FILE_DESCRIPTION(('Gs002 test case','Lemon/apple torus minor>=major'),'2;1');
FILE_NAME('Gs002.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Defect: lemon torus, minor (3.0) > major (2.0); no central hole, self-intersects */
#20=TOROIDAL_SURFACE('',#13,2.0,3.0);
/* Single FACE_OUTER_BOUND covering full parameter rectangle */
/* Outer vertex at outer-equator of the lemon torus: |major|+|minor| = 5.0 */
#30=CARTESIAN_POINT('',(5.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=VERTEX_LOOP('',#31);
#33=FACE_OUTER_BOUND('',#32,.T.);
#34=ADVANCED_FACE('',(#33),#20,.T.);
/* OPEN_SHELL exposes the degenerate face to volume / centroid checks */
#40=OPEN_SHELL('',(#34));
ENDSEC;
END-ISO-10303-21;
