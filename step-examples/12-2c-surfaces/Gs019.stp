ISO-10303-21;
/* Gs019 - Pcurves shifted by integer period on closed surface
 * Defect: Three consecutive edges on a cylinder with pcurves at U+0, U+2*pi, U+0 -
 * middle edge's pcurve shifted by exactly one surface period. ShapeFix_Wire::FixShifted
 * must re-shift the middle pcurve to match neighbors while preserving 3D consistency. */
HEADER;
FILE_DESCRIPTION(('Gs019 test case','Per-edge pcurve period shift'),'2;1');
FILE_NAME('Gs019.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Cylinder of radius 5, period 2*pi in U */
#20=CYLINDRICAL_SURFACE('',#13,5.0);
/* Three vertices stacked along z */
#30=CARTESIAN_POINT('',(5.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(5.0,0.0,3.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(5.0,0.0,6.0));
#35=VERTEX_POINT('',#34);
#36=DIRECTION('',(0.0,0.0,1.0));
#37=VECTOR('',#36,1.0);
#38=LINE('',#30,#37);
#39=LINE('',#32,#37);
/* PCurve A: at canonical U=0, V=0..3 */
#40=CARTESIAN_POINT('',(0.0,0.0));
#41=DIRECTION('',(0.0,1.0));
#42=VECTOR('',#41,1.0);
#43=LINE('',#40,#42);
#44=DEFINITIONAL_REPRESENTATION('',(#43),#45);
#45=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('','') );
#46=PCURVE('',#20,#44);
/* PCurve B (DEFECT): shifted by one period U=2*pi, V=3..6 */
#50=CARTESIAN_POINT('',(6.2831853072,3.0));
#51=DIRECTION('',(0.0,1.0));
#52=VECTOR('',#51,1.0);
#53=LINE('',#50,#52);
#54=DEFINITIONAL_REPRESENTATION('',(#53),#55);
#55=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('','') );
#56=PCURVE('',#20,#54);
/* SURFACE_CURVE for first edge - canonical pcurve */
#60=SURFACE_CURVE('',#38,(#46),.PCURVE_S1.);
#61=EDGE_CURVE('',#31,#33,#60,.T.);
/* SURFACE_CURVE for second edge - middle pcurve shifted by period */
#62=SURFACE_CURVE('',#39,(#56),.PCURVE_S1.);
#63=EDGE_CURVE('',#33,#35,#62,.T.);
#70=ORIENTED_EDGE('',*,*,#61,.T.);
#71=ORIENTED_EDGE('',*,*,#63,.T.);
#80=EDGE_LOOP('',(#70,#71));
#81=FACE_OUTER_BOUND('',#80,.T.);
#82=ADVANCED_FACE('',(#81),#20,.T.);
ENDSEC;
END-ISO-10303-21;
