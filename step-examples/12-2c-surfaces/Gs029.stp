ISO-10303-21;
/* Gs029 - Curve with last < first parameter range
 *
 * Sources:  F071
 * Senders:  Pro/E PRO7747 #4875, PRO7656 #33334
 *
 * Defect: A TRIMMED_CURVE or EDGE_CURVE claims [first, last] parameter range
 *  outside the curve's natural domain or with last < first. Translator and
 *  downstream evaluation must normalise.
 *
 * Reproducer:  TRIMMED_CURVE over a unit-radius CIRCLE with
 *    trim_1 = PARAMETER_VALUE(2*pi),
 *    trim_2 = PARAMETER_VALUE(0),
 *  and sense_agreement = .T.. last < first.
 *
 * Expected kernel behavior:
 *   heal - clamp / wrap parameter values into natural domain; if last < first,
 *   swap or wrap modulo period. */
HEADER;
FILE_DESCRIPTION(('Gs029 test case','TRIMMED_CURVE last<first parameter'),'2;1');
FILE_NAME('Gs029.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=CIRCLE('',#13,1.0);
/* Defect: trim_1 (first) = 2*pi, trim_2 (last) = 0, sense .T. -> last<first */
#21=PARAMETER_VALUE(6.2831853071795864);
#22=PARAMETER_VALUE(0.0);
#23=TRIMMED_CURVE('',#20,(#21),(#22),.T.,.PARAMETER.);
#30=CARTESIAN_POINT('',(1.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#40=EDGE_CURVE('',#31,#31,#23,.T.);
ENDSEC;
END-ISO-10303-21;
