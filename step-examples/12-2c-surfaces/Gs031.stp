ISO-10303-21;
/* Gs031 - Face with duplicated outer contour (overlapping pcurves)
 * Defect: A single face stores the same outer wire twice in the parametric domain -
 * two FACE_OUTER_BOUNDs trace the same contour. Caused by REHOSTing a face onto a
 * new surface and reprojecting all 3D edges including those already representing the
 * contour. Healing must merge or reject duplicates. */
HEADER;
FILE_DESCRIPTION(('Gs031 test case','Duplicated outer wire on face'),'2;1');
