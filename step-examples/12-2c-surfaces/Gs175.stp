ISO-10303-21;
/* Gs175 - ToroidalSurface pinch singularity with major > minor
 *
 * Defect: ComputeSingularities.toroidal-pinch-singularities
 * Fails to detect dual-pinch when MajorRadius > MinorRadius.
 * Healing misses torus-specific degeneracy at inner radius.
 *
 * Minimal reproducer: Torus (majorR=3.0, minorR=1.5, center origin).
 * Two singularities expected at angular positions pi +/- asin(minorR/majorR).
 */
HEADER;
FILE_DESCRIPTION(('Gs175 test case','ToroidalSurface dual-pinch singularity'),'2;1');
FILE_NAME('Gs175.stp','2026-06-16T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Toroidal surface: majorR=3.0, minorR=1.5 */
#20=TOROIDAL_SURFACE('',#13,3.0,1.5);
/* RECTANGULAR_TRIMMED_SURFACE: full torus */
#30=RECTANGULAR_TRIMMED_SURFACE('',#20,0.0,6.283185307179586,0.0,6.283185307179586,.T.,.T.);
#40=CARTESIAN_POINT('',(4.5,0.0,0.0));
#41=VERTEX_POINT('',#40);
#42=VERTEX_LOOP('',#41);
#43=FACE_OUTER_BOUND('',#42,.T.);
#44=ADVANCED_FACE('',(#43),#30,.T.);
#50=OPEN_SHELL('',(#44));
/* Product definition */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs175','Gs175','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#50),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
