ISO-10303-21;
/* Gs150 - ShapeConstruct_Surface.AdjustByTransformation placement mismatch
 *
 * Defect: AdjustByTransformation applies a coordinate system change to a
 * surface. If the input transformation is improper (singular, degenerate scale,
 * or inconsistent axis orientation), the resulting surface parameterization
 * becomes inconsistent with its AXIS2_PLACEMENT_3D anchor, breaking
 * parametric coherence.
 *
 * Reproducer: CYLINDRICAL_SURFACE with axis transformation; verify surface
 * parameterization remains consistent after adjustment.
 */
HEADER;
