ISO-10303-21;
/* Gs132 - TOROIDAL_SURFACE wrongly elevated to non-analytic Bezier
 *
 * Defect: ShapeUpgrade_SplitSurfaceContinuity.Compute is called on an
 *  analytic surface (C∞ continuous, like TOROIDAL_SURFACE). The method
 *  attempts to split and elevate continuity via Bezier approximation,
 *  producing a non-analytic BSpline surface with wrong continuity class.
 *  The output surface appears to have higher continuity than input, but
 *  the Bezier knot structure contradicts the analytic properties.
 *
 * Reproducer: TOROIDAL_SURFACE (inherently C∞). Call Compute() with
 *  continuity elevation request. Output: BSpline surface with degree > 4,
 *  knot vector not matching torus singularities, subsequent operations
 *  (curvature, geodesic) fail or produce non-physical results.
 *
 * Expected kernel behavior:
 *   heal - detect analytic input; skip unnecessary elevation; return
 *  the original analytic surface or a faithful Bezier approximation
 *  preserving the original continuity class. */
HEADER;
FILE_DESCRIPTION(('Gs132 test case','TOROIDAL_SURFACE wrongly elevated to non-analytic Bezier'),'2;1');
FILE_NAME('Gs132.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Axis placement at origin */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* TOROIDAL_SURFACE: major=30, minor=8
 * Inherently analytic (C∞) everywhere except at singularities
 * (poles at Z = ±8 where major/minor meet) */
#20=TOROIDAL_SURFACE('',#13,30.0,8.0);
/* Vertex near torus singularity (pole): (major+minor, 0, minor) = (38, 0, 8) */
#30=CARTESIAN_POINT('',(38.0,0.0,8.0));
#31=VERTEX_POINT('',#30);
/* Vertex slightly offset to create Bezier elevation challenge */
#35=CARTESIAN_POINT('',(37.99,0.01,7.99));
#36=VERTEX_POINT('',#35);
/* Edge near singularity */
#40=EDGE_CURVE('',#31,#36,#41,.T.);
#41=LINE('',#30,#42);
#42=DIRECTION('',(-0.01,0.01,-0.01));
/* Wire and face on torus */
#50=WIRE('',((#40)));
#51=FACE_OUTER_BOUND('',#50,.T.);
#52=ADVANCED_FACE('',(#51),#20,.T.);
/* Shell */
#60=OPEN_SHELL('',(#52));
/* Product context chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs132','Gs132','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#60),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
