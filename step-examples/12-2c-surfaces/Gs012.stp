ISO-10303-21;
/* Gs012 - Non-simple parametric loop (face boundary self-crosses in UV)
 * Defect: Face's outer EDGE_LOOP has segments that cross each other in surface UV
 * parameter space, even when 3D positions look fine. Jordan-curve violation.
 * Boundary cannot be unambiguously interpreted as inside/outside. */
HEADER;
FILE_DESCRIPTION(('Gs012 test case','Bow-tie outer wire in UV'),'2;1');
FILE_NAME('Gs012.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Defect: four ORIENTED_EDGEs whose 2D pcurves form a bow-tie in UV. */
/* Vertices in (intentionally bow-tie) order: A(0,0) - C(10,10) - B(10,0) - D(0,10). */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(10.0,10.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(10.0,0.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(0.0,10.0,0.0));
#37=VERTEX_POINT('',#36);
/* Edges A->C, C->B, B->D, D->A in 3D. The UV pcurves cross. */
#40=DIRECTION('',(0.7071067811865476,0.7071067811865476,0.0));
#41=VECTOR('',#40,14.142135623730951);
#42=LINE('',#30,#41);
#43=DIRECTION('',(0.0,-1.0,0.0));
#44=VECTOR('',#43,10.0);
#45=LINE('',#32,#44);
#46=DIRECTION('',(-0.7071067811865476,0.7071067811865476,0.0));
#47=VECTOR('',#46,14.142135623730951);
#48=LINE('',#34,#47);
#49=DIRECTION('',(0.0,-1.0,0.0));
#50=VECTOR('',#49,10.0);
#51=LINE('',#36,#50);
#60=EDGE_CURVE('',#31,#33,#42,.T.);
#61=EDGE_CURVE('',#33,#35,#45,.T.);
#62=EDGE_CURVE('',#35,#37,#48,.T.);
#63=EDGE_CURVE('',#37,#31,#51,.T.);
#70=ORIENTED_EDGE('',*,*,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#61,.T.);
#72=ORIENTED_EDGE('',*,*,#62,.T.);
#73=ORIENTED_EDGE('',*,*,#63,.T.);
#80=EDGE_LOOP('',(#70,#71,#72,#73));
#81=FACE_OUTER_BOUND('',#80,.T.);
#82=ADVANCED_FACE('',(#81),#20,.T.);
ENDSEC;
END-ISO-10303-21;
