ISO-10303-21;
/* Gs163 - ShapeUpgrade_SplitSurface: large-pole B-spline detection threshold
 *
 * Defect: ShapeUpgrade observer tracks B-SPLINE_SURFACE with pole count
 * exceeding 8192 (NbUPoles * NbVPoles) but threshold is hardcoded without
 * justification. Result: surfaces near boundary not flagged; downstream
 * algorithms may fail on unexpectedly large interpolation tasks.
 *
 * Reproducer: B-SPLINE_SURFACE with 64x64 poles (4096 total, below 8192);
 * verify detection threshold and performance impact.
 */
HEADER;
FILE_DESCRIPTION(('Gs163 test case','ShapeUpgrade large-pole B-spline threshold'),'2;1');
FILE_NAME('Gs163.stp','2026-06-16T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
