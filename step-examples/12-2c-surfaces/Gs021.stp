ISO-10303-21;
/* Gs021 - Line displaced from true position (FPX Expert PCB)
 *
 * Sources:  G001, Q011, W012
 * Senders:  FPX Expert 2013 (PCB design system)
 *
 * Defect: EDGE_CURVE based on a LINE whose direction is correct but whose pnt
 *  (origin) is parallel-displaced from the line that actually passes through
 *  both vertex points. Vertex points are approximately equidistant off the
 *  line. Translator must shift the line to vertices.
 *
 * Reproducer:  VERTEX_POINT(A=(0,0,0)), VERTEX_POINT(B=(10,0,0)),
 *  EDGE_CURVE referring to LINE(pnt=(0,0,0.5), dir=(1,0,0)) - line is parallel
 *  to AB but offset by 0.5 in Z.
 *
 * Expected kernel behavior:
 *   heal-to-vertices - replace the line so it passes through both vertices,
 *   preserving original direction. */
HEADER;
FILE_DESCRIPTION(('Gs021 test case','Line offset from vertices'),'2;1');
FILE_NAME('Gs021.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Vertex A at (0,0,0), Vertex B at (10,0,0) */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=VERTEX_POINT('',#10);
#12=CARTESIAN_POINT('',(10.0,0.0,0.0));
#13=VERTEX_POINT('',#12);
/* Defect: LINE origin is at (0,0,0.5), parallel to AB but offset by 0.5 in Z */
#20=CARTESIAN_POINT('',(0.0,0.0,0.5));
#21=DIRECTION('',(1.0,0.0,0.0));
#22=VECTOR('',#21,1.0);
#23=LINE('',#20,#22);
/* The EDGE_CURVE references vertices A and B but the LINE doesn't pass through them */
#30=EDGE_CURVE('',#11,#13,#23,.T.);
#31=ORIENTED_EDGE('',*,*,#30,.T.);
#40=EDGE_LOOP('',(#31));
ENDSEC;
END-ISO-10303-21;
