ISO-10303-21;
/* Gs137 - ShapeUpgrade_SplitSurface non-axis-aligned-split
 *
 * Defect: Split parameter at irrational position (e.g. π/√2 ≈ 2.221) gets
 * clamped to nearest representable machine-precision double. SplitSurface
 * doesn't preserve semantic intent; numerical rounding creates artificial
 * split discontinuities or produces mathematically singular split points.
 *
 * Reproducer: NURBS surface with split request at u = π/(2√2). The clamping
 * logic rounds to nearest knot-span boundary, creating a split not at the
 * requested parameter but at an adjacent knot value.
 *
 * Expected kernel behavior:
 *   heal - use rational parameters or preserve split-intent tolerance;
 *   document rounding behavior and allow client-side adjustment. */
HEADER;
FILE_DESCRIPTION(('Gs137 test case','Irrational split parameter clamping'),'2;1');
FILE_NAME('Gs137.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
