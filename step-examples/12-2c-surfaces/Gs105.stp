ISO-10303-21;
/* Gs105 - FaceDivide crossing-curves defect
 *
 * Defect: ShapeUpgrade_FaceDivide.SplitCurves fails when splitting curves
 *  cross each other. The algorithm doesn't handle intersection between
 *  splitter curves and produces overlapping sub-faces on same surface.
 *
 * Reproducer: Rectangular B-spline surface divided by two crossing edge curves
 *  (like diagonal lines that intersect mid-surface).
 *
 * Expected kernel behavior:
 *   heal - detect crossing splitters, recompute intersection, subdivide correctly;
 *   reject with "non-manifold face subdivision" diagnostic. */
HEADER;
FILE_DESCRIPTION(('Gs105 test case','FaceDivide crossing-curves subdivision failure'),'2;1');
FILE_NAME('Gs105.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Simple rectangular B-spline surface */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(5.0,0.0,0.0));
#12=CARTESIAN_POINT('',(10.0,0.0,0.0));
#13=CARTESIAN_POINT('',(0.0,10.0,0.0));
#14=CARTESIAN_POINT('',(5.0,10.0,0.0));
#15=CARTESIAN_POINT('',(10.0,10.0,0.0));
#16=CARTESIAN_POINT('',(0.0,20.0,0.0));
#17=CARTESIAN_POINT('',(5.0,20.0,0.0));
#18=CARTESIAN_POINT('',(10.0,20.0,0.0));
/* 3x3 control grid for rectangular surface */
#30=B_SPLINE_SURFACE_WITH_KNOTS('',2,2,
  ((#10,#13,#16),(#11,#14,#17),(#12,#15,#18)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (3,3),(3,3),(0.0,1.0),(0.0,1.0),
  .UNSPECIFIED.);
/* Two crossing edge curves (diagonals at different parameter heights) */
/* Splitter 1: approximate diagonal from lower-left to upper-right */
#40=CARTESIAN_POINT('',(0.0,0.0,0.0));
#41=CARTESIAN_POINT('',(5.0,10.0,0.0));
#42=CARTESIAN_POINT('',(10.0,20.0,0.0));
#43=B_SPLINE_CURVE_WITH_KNOTS('',2,
  (#40,#41,#42),
  .UNSPECIFIED.,.F.,.F.,
  (3,3),(0.0,1.0),
  .UNSPECIFIED.);
/* Splitter 2: opposite diagonal that crosses Splitter 1 */
#50=CARTESIAN_POINT('',(10.0,0.0,0.0));
#51=CARTESIAN_POINT('',(5.0,10.0,0.0));
#52=CARTESIAN_POINT('',(0.0,20.0,0.0));
#53=B_SPLINE_CURVE_WITH_KNOTS('',2,
  (#50,#51,#52),
  .UNSPECIFIED.,.F.,.F.,
  (3,3),(0.0,1.0),
  .UNSPECIFIED.);
/* Outer bound vertex */
#60=CARTESIAN_POINT('',(0.0,0.0,0.0));
#61=VERTEX_POINT('',#60);
#62=VERTEX_LOOP('',#61);
#63=FACE_OUTER_BOUND('',#62,.T.);
/* Face with crossing splitter curves — subdivision will fail */
#64=ADVANCED_FACE('',(#63),#30,.T.);
#65=OPEN_SHELL('',(#64));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs105','Gs105','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#65),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
