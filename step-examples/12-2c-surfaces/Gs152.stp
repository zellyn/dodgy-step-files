ISO-10303-21;
/* Gs152 - ShapeUpgrade_Surface.SplitSurface continuity breach on trim
 *
 * Defect: SplitSurface.Build() splits a base surface into patches for shape
 * optimization. When the base is RECTANGULAR_TRIMMED_SURFACE, the algorithm
 * may incorrectly apply splits that ignore the trim bounds, creating patches
 * that extend beyond the trimmed envelope and breaking G1/C2 continuity.
 *
 * Reproducer: B-SPLINE_SURFACE_WITH_KNOTS trimmed to partial domain;
 * request parametric split; verify split patches respect trim bounds.
 */
HEADER;
FILE_DESCRIPTION(('Gs152 test case','SplitSurface continuity breach on trim'),'2;1');
FILE_NAME('Gs152.stp','2026-06-16T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
