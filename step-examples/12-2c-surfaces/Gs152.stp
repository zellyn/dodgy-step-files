#45=CARTESIAN_POINT('',(9.0,9.0,1.0));
/* RECTANGULAR_TRIMMED_SURFACE: trim to u in [1.0, 3.0], v in [1.5, 3.5] */
#50=RECTANGULAR_TRIMMED_SURFACE('',#20,1.0,3.0,1.5,3.5,.T.,.T.);
#60=CARTESIAN_POINT('',(4.5,3.0,1.75));
