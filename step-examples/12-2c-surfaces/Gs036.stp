ISO-10303-21;
/* Gs036 - Negative-radius / zero-magnitude direction or vector
 * Defect: DIRECTION with all-zero direction_ratios (S020); axis2_placement_3d whose
 * axis and ref_direction are colinear so an orthonormal frame cannot be constructed
 * (S021). This file demonstrates both: a zero DIRECTION and a degenerate placement
 * with parallel axis and ref_direction. */
HEADER;
FILE_DESCRIPTION(('Gs036 test case','Zero direction and degenerate placement'),'2;1');
FILE_NAME('Gs036.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
/* Defect 1: zero-magnitude direction ratios */
#11=DIRECTION('',(0.0,0.0,0.0));
/* Defect 2: ref_direction parallel to axis - cannot build orthonormal frame */
#12=DIRECTION('',(0.0,0.0,1.0));
#13=DIRECTION('',(0.0,0.0,1.0));
#14=AXIS2_PLACEMENT_3D('',#10,#12,#13);
/* Use the zero direction in a vector - magnitude is 1 but direction_ratios are zero */
#15=VECTOR('',#11,1.0);
#16=LINE('',#10,#15);
/* Reference the degenerate placement on a plane - reader should reject */
#20=PLANE('',#14);
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=VERTEX_LOOP('',#31);
#33=FACE_OUTER_BOUND('',#32,.T.);
#34=ADVANCED_FACE('',(#33),#20,.T.);
ENDSEC;
END-ISO-10303-21;
