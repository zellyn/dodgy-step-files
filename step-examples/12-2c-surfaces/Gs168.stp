#73=EDGE_CURVE('',#53,#55,#72,.T.);
#74=ORIENTED_EDGE('',*,*,#73,.T.);
/* Edge 3 */
#80=DIRECTION('',(-1.0,0.0,0.0));
#81=VECTOR('',#80,1.0);
