ISO-10303-21;
/* Gs178 - OffsetSurface edge degeneracy sampling
 *
 * Defect: ComputeSingularities.bounded-surface-edge-singularities
 * Fails to detect edge degeneracies in offset surfaces via
 * 4-point boundary edge sampling. Offset distance amplifies
 * collapse signatures.
 *
 * Minimal reproducer: OffsetSurface (offset 0.5 from plane).
 * Four edge-midpoint distances sampled; maximum distance captures
 * potential degeneracy signature at boundary collapse.
 */
HEADER;
FILE_DESCRIPTION(('Gs178 test case','OffsetSurface edge degeneracy'),'2;1');
FILE_NAME('Gs178.stp','2026-06-16T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Plane surface: normal (0,0,1), location (0,0,0) */
#20=PLANE('',#13);
/* RECTANGULAR_TRIMMED_SURFACE: plane bounded u,v in [0,5] */
#30=RECTANGULAR_TRIMMED_SURFACE('',#20,0.0,5.0,0.0,5.0,.T.,.T.);
/* OFFSET_SURFACE: offset 0.5 from plane */
#40=OFFSET_SURFACE('',#30,0.5,.T.);
#50=CARTESIAN_POINT('',(2.5,2.5,0.5));
#51=VERTEX_POINT('',#50);
#52=VERTEX_LOOP('',#51);
#53=FACE_OUTER_BOUND('',#52,.T.);
#54=ADVANCED_FACE('',(#53),#40,.T.);
#60=OPEN_SHELL('',(#54));
/* Product definition */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs178','Gs178','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#60),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
