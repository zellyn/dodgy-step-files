ISO-10303-21;
/* Gs209: the ADVANCED_FACE's face_geometry is a RECTANGULAR_TRIMMED_SURFACE trimming the cone with u1 = u2 = 0.0 (zero angular width), violating ISO 10303-42 rectangular_trimmed_surface WR1 (u1 <> u2); OCCT accepts the file (part21 accepts, structural silent — a value constraint) but the zero-width trimmed surface collapses: the face is silently dropped and OCCT returns a shell with ZERO faces, while gmsh returns nothing at all (cross-oracle divergence); distinct from Gp191 (a 2D pcurve trim collapse w1==w2) — this is a zero-width surface rectangular trim; spec-driven, mined from the AP242 MIM rectangular_trimmed_surface WHERE-rules; expected strict behavior: reject a rectangular trim whose u1 equals u2 (or v1 equals v2); synonyms: zero-width RECTANGULAR_TRIMMED_SURFACE, u1 equals u2 trim, zero-extent rectangular trim, collapsed trimmed surface drops face; the zero-width trimmed surface is the defect carrier */
HEADER;
FILE_DESCRIPTION(('Gs209'),'2;1');
FILE_NAME('Gs209.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
