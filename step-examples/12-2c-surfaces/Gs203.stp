ISO-10303-21;
/* Gs203: PLANE IS ADVANCED_FACE.face_geometry; defect EDGE_CURVE curve_3d IS a clamped, NON-
   periodic degree-3 B_SPLINE_CURVE_WITH_KNOTS (4 poles) whose start pole (0,0,0) and end pole
   (5e-8,0,0) are close only WITHIN 3D tolerance (gap 5e-8, below the fixture's own declared
   UNCERTAINTY_MEASURE_WITH_UNIT of 1e-7) but NOT formally .Closed. (Geom_BSplineCurve::IsClosed's
   own tight 1e-8 test reports False); edge_start sits at the curve's exact MIDPOINT (t=0.5,
   unambiguous), edge_end sits at the curve's exact START pole (0,0,0, projects exactly to t=0);
   this yields w1=0.5 > w2=0.0 on a curve that is NOT periodic and NOT formally closed, but IS
   closed within 3D tolerance -- StepToTopoDS_GeometricTool::UpdateParam3d's B-spline
   near-closed-tolerance branch (distinct from Gs202's ordinary-curve reversal fallback) must
   reinterpret w2 as landing on the wrong (near) end of the near-loop and re-target it to the
   curve's TRUE last parameter (1.0) instead */
HEADER;
FILE_DESCRIPTION(('Gs203'),'2;1');
FILE_NAME('Gs203.stp','2026-07-13T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
