ISO-10303-21;
/* Gs155 - ShapeUpgrade_ShapeCopyTool::CopyTrimmedSurface uv-param loss
 *
 * Defect: CopyTrimmedSurface duplicates a RECTANGULAR_TRIMMED_SURFACE but
 * does not preserve parameterization bounds if the base is a non-linear
 * surface (e.g., TOROIDAL). Result: trim bounds become semantically invalid
 * in the copy, breaking downstream topology.
 *
 * Reproducer: TOROIDAL_SURFACE wrapped in RECTANGULAR_TRIMMED_SURFACE;
 * copy and verify parameter bounds remain coherent.
 */
HEADER;
FILE_DESCRIPTION(('Gs155 test case','CopyTrimmedSurface uv-param loss'),'2;1');
FILE_NAME('Gs155.stp','2026-06-16T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* TOROIDAL_SURFACE: major 4.0, minor 1.5 */
#20=TOROIDAL_SURFACE('',#13,4.0,1.5);
/* Trim to restricted u,v range */
#21=RECTANGULAR_TRIMMED_SURFACE('',#20,0.5,2.5,1.0,4.5,.T.,.T.);
/* Create a face with edges on toroid */
#50=CARTESIAN_POINT('',(5.0,0.0,0.0));
#51=VERTEX_POINT('',#50);
#52=CARTESIAN_POINT('',(5.0,1.5,0.0));
#53=VERTEX_POINT('',#52);
#54=CARTESIAN_POINT('',(4.0,1.5,0.0));
#55=VERTEX_POINT('',#54);
#56=CARTESIAN_POINT('',(4.0,0.0,0.0));
#57=VERTEX_POINT('',#56);
/* Edges forming quad loop */
#60=DIRECTION('',(0.0,1.0,0.0));
#61=VECTOR('',#60,1.5);
#62=LINE('',#50,#61);
#63=EDGE_CURVE('',#51,#53,#62,.T.);
#64=ORIENTED_EDGE('',*,*,#63,.T.);
#70=DIRECTION('',(0.0,0.0,1.0));
#71=VECTOR('',#70,0.0);
#72=LINE('',#52,#71);
#73=EDGE_CURVE('',#53,#55,#72,.T.);
#74=ORIENTED_EDGE('',*,*,#73,.T.);
#80=DIRECTION('',(0.0,-1.0,0.0));
#81=VECTOR('',#80,1.5);
#82=LINE('',#54,#81);
#83=EDGE_CURVE('',#55,#57,#82,.T.);
#84=ORIENTED_EDGE('',*,*,#83,.T.);
#90=DIRECTION('',(0.0,0.0,-1.0));
#91=VECTOR('',#90,0.0);
#92=LINE('',#56,#91);
#93=EDGE_CURVE('',#57,#51,#92,.T.);
#94=ORIENTED_EDGE('',*,*,#93,.T.);
#95=EDGE_LOOP('',(#64,#74,#84,#94));
#96=FACE_OUTER_BOUND('',#95,.T.);
#97=ADVANCED_FACE('',(#96),#21,.T.);
#110=OPEN_SHELL('',(#97));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs155','Gs155','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#110),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
