ISO-10303-21;
/* Gs104 - SURFACE_OF_REVOLUTION with profile-on-axis
 *
 * Defect: ShapeAnalysis_Surface.IsDegenerated fails to detect degenerate
 *  SURFACE_OF_REVOLUTION where the profile curve coincides with the axis
 *  of revolution. The cross-product test produces near-zero result but is
 *  not properly classified as singular.
 *
 * Reproducer: Profile B-spline control points all lie on the Z-axis;
 *  revolution around Z-axis creates a degenerate surface (collapsed to line).
 *
 * Expected kernel behavior:
 *   heal - reject with "degenerate revolution surface" diagnostic;
 *   IsDegenerated should return TRUE. */
HEADER;
FILE_DESCRIPTION(('Gs104 test case','SURFACE_OF_REVOLUTION with profile-on-axis degeneration'),'2;1');
FILE_NAME('Gs104.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Axis placement at origin, Z-axis is revolution axis */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Defect: Profile B-spline with all control points ON the Z-axis (X=0, Y=0) */
/* 4 control points at Z=0, 5, 10, 15 — all at origin X,Y */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(0.0,0.0,5.0));
#22=CARTESIAN_POINT('',(0.0,0.0,10.0));
#23=CARTESIAN_POINT('',(0.0,0.0,15.0));
/* Degenerate B-spline profile curve (line on Z-axis) */
#30=B_SPLINE_CURVE_WITH_KNOTS('',3,
  (#20,#21,#22,#23),
  .UNSPECIFIED.,.F.,.F.,
  (4,4),(0.0,1.0),
  .UNSPECIFIED.);
/* Surface of revolution: degenerate because profile lies on axis */
#40=SURFACE_OF_REVOLUTION('',#30,#13);
/* Outer-bound vertex */
#50=CARTESIAN_POINT('',(0.0,0.0,0.0));
#51=VERTEX_POINT('',#50);
#52=VERTEX_LOOP('',#51);
#53=FACE_OUTER_BOUND('',#52,.T.);
/* ADVANCED_FACE with degenerate surface */
#54=ADVANCED_FACE('',(#53),#40,.T.);
#55=OPEN_SHELL('',(#54));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs104','Gs104','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#55),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
