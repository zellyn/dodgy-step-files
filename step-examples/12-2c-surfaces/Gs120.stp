ISO-10303-21;
/* Gs120 - FaceDivide splitter curve tangent to boundary (zero-area sub-face)
 *
 * Defect: ShapeUpgrade_FaceDivide.SplitCurves produces zero-area sub-face
 *  when splitter curve is tangent to face boundary at a single point.
 *  The division logic doesn't guard against tangency leading to degenerate splits.
 *
 * Reproducer: Face with a splitter curve that touches the outer bound tangentially.
 *  After splitting, one sub-face has zero interior area (boundary collapses).
 *
 * Expected kernel behavior:
 *   heal - detect tangent-splitter condition and refuse the split or merge result;
 *   reject only when split point is outside face bounds. */
HEADER;
FILE_DESCRIPTION(('Gs120 test case','Face divide splitter curve tangent to boundary'),'2;1');
FILE_NAME('Gs120.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Base plane placement */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Plane surface (XY plane at Z=0) */
#20=PLANE('',#13);
/* Outer boundary: circle of radius 10 centered at origin */
#30=CIRCLE('',#13,10.0);
#31=EDGE_CURVE('',#30,#30,#30,.T.);
#32=VERTEX_POINT('',#10);
/* Boundary curve (closed circle) */
#33=ORIENTED_EDGE('',.F.,#31);
#34=EDGE_LOOP('',(#33));
#35=FACE_OUTER_BOUND('',#34,.T.);
/* Inner boundary: line segment tangent to outer circle at (10,0,0)
 * This creates a tangency condition at the boundary */
#40=CARTESIAN_POINT('',(10.0,0.0,0.0));
#41=CARTESIAN_POINT('',(12.0,0.0,0.0));
#42=LINE('',#40,#12);
#43=EDGE_CURVE('',#40,#41,#42,.T.);
#44=ORIENTED_EDGE('',.T.,#43);
#45=EDGE_LOOP('',(#44));
#46=FACE_INNER_BOUND('',#45,.T.);
/* Face with tangent inner edge */
#50=ADVANCED_FACE('',(#35,#46),#20,.T.);
/* Shell containing the face */
#60=OPEN_SHELL('',(#50));
/* Product context chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs120','Gs120','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#60),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
