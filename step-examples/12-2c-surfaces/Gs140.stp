ISO-10303-21;
/* Gs140 - ShapeAnalysis_Surface.IsVClosed knot-multiplicity shortcut bypass
 *
 * Defect: IsVClosed() optimizes closed-surface detection via knot multiplicity
 * check at V-boundaries, but for Bezier surfaces (implicit knots) misses edge
 * case where pole count and endpoint coincidence disagree on closure status.
 *
 * Reproducer: Bezier surface (implicit knots) with 4x5 poles; first and last
 * V-column poles coincide spatially but parametric representation differs;
 * shortcut incorrectly declares surface V-closed.
 */
HEADER;
FILE_DESCRIPTION(('Gs140 test case','IsVClosed Bezier pole-coincidence shortcut'),'2;1');
FILE_NAME('Gs140.stp','2026-06-16T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
