#21=RECTANGULAR_TRIMMED_SURFACE('',#20,0.0,6.2832,0.0,6.2832,.T.,.T.);
#50=CARTESIAN_POINT('',(7.0,0.0,0.0));
#51=VERTEX_POINT('',#50);
#52=CARTESIAN_POINT('',(7.0,0.0,3.0));
#53=VERTEX_POINT('',#52);
#60=DIRECTION('',(0.0,0.0,1.0));
