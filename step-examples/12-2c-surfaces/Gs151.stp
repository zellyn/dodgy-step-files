ISO-10303-21;
/* Gs151 - ShapeFix_Face.FixWireTool seam edge consolidation
 *
 * Defect: FixWireTool processes EDGE_LOOPs on closed (seam) surfaces.
 * If seam-edge handling is omitted or asymmetric (forward/reverse), edges
 * may be duplicated or left malformed, breaking wire closure on toroidal/
 * cylindrical surfaces.
 *
 * Reproducer: TOROIDAL_SURFACE with seam edge at u=0; verify FixWireTool
 * correctly consolidates seam representation without duplication.
 */
HEADER;
FILE_DESCRIPTION(('Gs151 test case','FixWireTool seam edge consolidation'),'2;1');
FILE_NAME('Gs151.stp','2026-06-16T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
