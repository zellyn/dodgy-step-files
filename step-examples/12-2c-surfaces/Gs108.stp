ISO-10303-21;
/* Gs108 - Singularity boundary classification error
 *
 * Defect: ShapeAnalysis_Surface.Singularity fails to classify singularities at
 *  parameter boundaries. When singularity occurs at v=v_max (inclusive boundary),
 *  the analyzer treats the boundary as exclusive, misclassifying interior vs.
 *  boundary singularities.
 *
 * Reproducer: Cone surface with singularity apex at v=v_max parameter value;
 *  cone parametrization has degenerate pole at one end of v-range.
 *
 * Expected kernel behavior:
 *   heal - include boundary value in singularity test (v <= v_max, not v < v_max);
 *   reject with "boundary singularity misclassified" diagnostic. */
HEADER;
FILE_DESCRIPTION(('Gs108 test case','Singularity boundary classification error'),'2;1');
FILE_NAME('Gs108.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Axis placement at origin, Z-axis up */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Cone surface using B-spline approximation */
/* Profile: straight line from apex (0,0,0) to base circle */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(3.0,0.0,3.0));
#22=CARTESIAN_POINT('',(6.0,0.0,6.0));
/* Base circle control points at v=1.0 */
#23=CARTESIAN_POINT('',(10.0,0.0,10.0));
#24=CARTESIAN_POINT('',(0.0,10.0,10.0));
#25=CARTESIAN_POINT('',(-10.0,0.0,10.0));
#26=CARTESIAN_POINT('',(0.0,-10.0,10.0));
/* Defect: Apex singularity at v=v_max (v=1.0, inclusive) */
/* Control net revolves around Z-axis */
#30=B_SPLINE_SURFACE_WITH_KNOTS('',3,2,
  ((#20,#21,#22,#23),
   (#20,#21,#22,#24),
   (#20,#21,#22,#25),
   (#20,#21,#22,#26),
   (#20,#21,#22,#23)),
  .UNSPECIFIED.,.T.,.F.,.F.,
  (4,4,4,4,4),(4,4),(0.0,1.0),(0.0,1.0),
  .UNSPECIFIED.);
/* Outer-bound vertex */
#40=CARTESIAN_POINT('',(0.0,0.0,0.0));
#41=VERTEX_POINT('',#40);
#42=VERTEX_LOOP('',#41);
#43=FACE_OUTER_BOUND('',#42,.T.);
/* Face with cone surface singularity at boundary */
#44=ADVANCED_FACE('',(#43),#30,.T.);
#45=OPEN_SHELL('',(#44));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs108','Gs108','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#45),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
