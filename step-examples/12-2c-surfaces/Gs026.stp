ISO-10303-21;
/* Gs026 - Helix on cylinder mis-projected (analytic line lost)
 *
 * Sources:  R027, G073
 * Originally also catalogued as: Gp009, Gn006
 *
 * Defect: When a 3D helix is projected to the parametric space of its hosting
 *  cylinder, projection should yield an analytic 2D line segment. OCCT's
 *  ShapeConstruct_ProjectCurveOnSurface instead returned a BSpline approximation
 *  with poor accuracy. BRepAdaptor_Surface UV bounds also recomputed unnecessarily
 *  on cylinder query.
 *
 * Reproducer:  Edge whose 3D curve is helix on cylinder, no pcurve attached;
 *  reference from face on CYLINDRICAL_SURFACE.
 *
 * Expected kernel behavior:
 *   heal - detect line-on-elementary-surface case; emit a 2D LINE pcurve. Add
 *   closeness-to-line check using normal-distance for C1 surfaces. */
HEADER;
FILE_DESCRIPTION(('Gs026 test case','Helix on cylinder, missing analytic pcurve'),'2;1');
FILE_NAME('Gs026.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=CYLINDRICAL_SURFACE('',#13,5.0);
/* 3D helix as a B_SPLINE_CURVE approximation (one helical pitch) */
#30=CARTESIAN_POINT('',(5.0,0.0,0.0));
#31=CARTESIAN_POINT('',(5.0,5.0,2.5));
#32=CARTESIAN_POINT('',(0.0,5.0,5.0));
#33=CARTESIAN_POINT('',(-5.0,5.0,7.5));
#34=CARTESIAN_POINT('',(-5.0,0.0,10.0));
#35=B_SPLINE_CURVE_WITH_KNOTS('',3,
  (#30,#31,#32,#33,#34),
  .UNSPECIFIED.,.F.,.F.,
  (4,1,4),(0.0,0.5,1.0),
  .UNSPECIFIED.);
#40=VERTEX_POINT('',#30);
#41=VERTEX_POINT('',#34);
/* Defect: SURFACE_CURVE on a cylinder has empty associated_geometry where an
 * analytic 2D LINE pcurve should appear (helix maps to straight line in (U,V)). */
#50=SURFACE_CURVE('',#35,(),.PCURVE_S1.);
#60=EDGE_CURVE('',#40,#41,#50,.T.);
#61=ORIENTED_EDGE('',*,*,#60,.T.);
#62=EDGE_LOOP('',(#61));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#20,.T.);
ENDSEC;
END-ISO-10303-21;
