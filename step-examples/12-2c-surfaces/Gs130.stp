ISO-10303-21;
/* Gs130 - FACE with trim coincident to existing split edge
 *
 * Defect: ShapeUpgrade_FaceDivide.Perform uses a splitter parameter that
 *  exactly coincides with an existing trim edge. The implementation does not
 *  detect this collision and creates an empty sub-face whose loop has zero
 *  area or degenerate bounds. This sub-face passes validation checks but
 *  fails during downstream geometry operations (tessellation, meshing).
 *
 * Reproducer: ADVANCED_FACE with a trim edge from (0,0) to (10,0).
 *  FaceDivide.Perform is called with split parameter at x=10.0, exactly
 *  on the existing trim. Result: degenerate sub-face with zero extent.
 *
 * Expected kernel behavior:
 *   heal - detect trim-coincides-with-split condition; skip that split
 *  or merge the degenerate face into an adjacent sub-face. */
HEADER;
FILE_DESCRIPTION(('Gs130 test case','FACE with trim edge coinciding with split parameter'),'2;1');
FILE_NAME('Gs130.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Axis placement at origin */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* PLANE surface: Z=0 */
#20=PLANE('',#13);
/* Rectangle vertices: (0,0,0) to (10,10,0) */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(10.0,0.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(10.0,10.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(0.0,10.0,0.0));
#37=VERTEX_POINT('',#36);
/* Bottom edge: (0,0,0) to (10,0,0) — EXISTING TRIM */
#40=EDGE_CURVE('',#31,#33,#41,.T.);
#41=LINE('',#30,#42);
#42=DIRECTION('',(1.0,0.0,0.0));
/* Right edge: (10,0,0) to (10,10,0) */
#50=EDGE_CURVE('',#33,#35,#51,.T.);
#51=LINE('',#32,#52);
#52=DIRECTION('',(0.0,1.0,0.0));
/* Top edge: (10,10,0) to (0,10,0) */
#60=EDGE_CURVE('',#35,#37,#61,.T.);
#61=LINE('',#34,#62);
#62=DIRECTION('',(-1.0,0.0,0.0));
/* Left edge: (0,10,0) to (0,0,0) */
#70=EDGE_CURVE('',#37,#31,#71,.T.);
#71=LINE('',#36,#72);
#72=DIRECTION('',(0.0,-1.0,0.0));
/* Outer wire: rectangle boundary */
#80=WIRE('',((#40),(#50),(#60),(#70)));
#81=FACE_OUTER_BOUND('',#80,.T.);
/* Vertical trim edge at x=10.0 — COINCIDES WITH SPLIT POINT */
#90=EDGE_CURVE('',#33,#35,#91,.T.);
#91=LINE('',#32,#92);
#92=DIRECTION('',(0.0,1.0,0.0));
/* Inner wire with coincident trim */
#100=WIRE('',((#90)));
#101=FACE_INNER_BOUND('',#100,.F.);
/* ADVANCED_FACE with outer and inner bounds
 * Inner bound is exactly at x=10.0 (coincident with right edge) */
#110=ADVANCED_FACE('',(#81,#101),#20,.T.);
/* Shell */
#120=OPEN_SHELL('',(#110));
/* Product context chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs130','Gs130','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#120),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
