ISO-10303-21;
/* Gs038 - Pcurve U/V parameter has large jump near periodic boundary on BSpline
 * Defect: 2D points along a projected pcurve sometimes have a huge jump (>0.95 of
 * UV range) on a BSpline surface when the corresponding 3D points are close - the
 * surface near-periodicity is not recognized. Self-touching closed BSpline surface
 * where 2D pcurve crosses near the wrap-around boundary. */
HEADER;
FILE_DESCRIPTION(('Gs038 test case','Pcurve UV jump near period boundary'),'2;1');
FILE_NAME('Gs038.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Self-touching closed BSpline surface: first U row equals last U row */
#10=CARTESIAN_POINT('',(10.0,0.0,0.0));
#11=CARTESIAN_POINT('',(0.0,10.0,0.0));
#12=CARTESIAN_POINT('',(-10.0,0.0,0.0));
#13=CARTESIAN_POINT('',(0.0,-10.0,0.0));
#14=CARTESIAN_POINT('',(10.0,0.0,0.0));
#15=CARTESIAN_POINT('',(10.0,0.0,5.0));
#16=CARTESIAN_POINT('',(0.0,10.0,5.0));
#17=CARTESIAN_POINT('',(-10.0,0.0,5.0));
#18=CARTESIAN_POINT('',(0.0,-10.0,5.0));
#19=CARTESIAN_POINT('',(10.0,0.0,5.0));
#20=B_SPLINE_SURFACE_WITH_KNOTS('',2,1,
  ((#10,#15),(#11,#16),(#12,#17),(#13,#18),(#14,#19)),
  .UNSPECIFIED.,.T.,.F.,.F.,
  (3,1,1,3),(2,2),(0.0,0.25,0.75,1.0),(0.0,1.0),
  .UNSPECIFIED.);
/* Edge whose 3D curve consists of two close points but pcurve crosses the period */
#30=CARTESIAN_POINT('',(10.0,0.0,2.5));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(9.99,0.1,2.5));
#33=VERTEX_POINT('',#32);
#34=DIRECTION('',(0.0,1.0,0.0));
#35=VECTOR('',#34,0.1);
#36=LINE('',#30,#35);
/* Defect: 2D pcurve in (U,V) jumps from U=0.99 to U=0.01 - a 0.98 jump in the 1.0
 * U-range, despite 3D points being only 0.1 apart. Reader misses near-periodicity. */
#40=CARTESIAN_POINT('',(0.99,0.5));
#41=DIRECTION('',(-1.0,0.0));
#42=VECTOR('',#41,0.98);
#43=LINE('',#40,#42);
#44=DEFINITIONAL_REPRESENTATION('',(#43),#45);
#45=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('','') );
#46=PCURVE('',#20,#44);
#50=SURFACE_CURVE('',#36,(#46),.PCURVE_S1.);
#60=EDGE_CURVE('',#31,#33,#50,.T.);
#61=ORIENTED_EDGE('',*,*,#60,.T.);
#62=EDGE_LOOP('',(#61));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#20,.T.);
ENDSEC;
END-ISO-10303-21;
