ISO-10303-21;
/* Gs107 - Closed-surface preservation in Bezier conversion
 *
 * Defect: ShapeUpgrade_ConvertSurfaceToBezierBasis fails to preserve closure
 *  when converting closed cylindrical surfaces to Bezier basis. The resulting
 *  Bezier patches don't maintain seam closure or periodic boundary conditions.
 *
 * Reproducer: Closed cylindrical surface (infinite height, closed around axis)
 *  converted via B-spline to Bezier; seam periodicity is lost in conversion.
 *
 * Expected kernel behavior:
 *   heal - detect closed surfaces, force boundary continuity in Bezier conversion;
 *   reject with "closure lost in Bezier conversion" diagnostic. */
HEADER;
FILE_DESCRIPTION(('Gs107 test case','Closed cylindrical surface Bezier conversion failure'),'2;1');
FILE_NAME('Gs107.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Axis placement at origin */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Defect: Closed cylindrical surface (U-parameter closed, V-parameter open) */
/* Control net for cylinder: 4 points around circle, 3 points vertically */
#20=CARTESIAN_POINT('',(10.0,0.0,0.0));
#21=CARTESIAN_POINT('',(0.0,10.0,0.0));
#22=CARTESIAN_POINT('',(-10.0,0.0,0.0));
#23=CARTESIAN_POINT('',(0.0,-10.0,0.0));
#24=CARTESIAN_POINT('',(10.0,0.0,5.0));
#25=CARTESIAN_POINT('',(0.0,10.0,5.0));
#26=CARTESIAN_POINT('',(-10.0,0.0,5.0));
#27=CARTESIAN_POINT('',(0.0,-10.0,5.0));
#28=CARTESIAN_POINT('',(10.0,0.0,10.0));
#29=CARTESIAN_POINT('',(0.0,10.0,10.0));
#30=CARTESIAN_POINT('',(-10.0,0.0,10.0));
#31=CARTESIAN_POINT('',(0.0,-10.0,10.0));
/* Closed B-spline surface: U periodic (closed), V open */
#40=B_SPLINE_SURFACE_WITH_KNOTS('',3,2,
  ((#20,#24,#28),(#21,#25,#29),(#22,#26,#30),(#23,#27,#31),(#20,#24,#28)),
  .UNSPECIFIED.,.T.,.F.,.F.,
  (4,4,4,4,4),(3,3),(0.0,1.0),(0.0,1.0),
  .UNSPECIFIED.);
/* Outer-bound vertex */
#50=CARTESIAN_POINT('',(10.0,0.0,0.0));
#51=VERTEX_POINT('',#50);
#52=VERTEX_LOOP('',#51);
#53=FACE_OUTER_BOUND('',#52,.T.);
/* Face with closed cylindrical surface */
#54=ADVANCED_FACE('',(#53),#40,.T.);
#55=OPEN_SHELL('',(#54));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs107','Gs107','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#55),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
