ISO-10303-21;
/* Gs024 - Round-trip planar face becomes trimmed B-spline (degree-1 NURBS)
 * Defect: An untrimmed PLANE was exported and re-imported as a degree-(1,1)
 * B_SPLINE_SURFACE_WITH_KNOTS with a 2x2 control net spanning a slightly oversized
 * natural rectangle. No PLANE remains. Affects feature recognition, mass props,
 * Booleans. Healing requires analytic recovery. */
HEADER;
FILE_DESCRIPTION(('Gs024 test case','Plane round-tripped to degree-1 NURBS'),'2;1');
FILE_NAME('Gs024.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* 2x2 degree-1 control net spanning [0,100] x [0,50] in XY plane at Z=0 */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(100.0,0.0,0.0));
#12=CARTESIAN_POINT('',(0.0,50.0,0.0));
#13=CARTESIAN_POINT('',(100.0,50.0,0.0));
/* Defect: should be a PLANE; instead emitted as degree-1 NURBS spanning oversize rect */
#20=B_SPLINE_SURFACE_WITH_KNOTS('',1,1,
  ((#10,#12),(#11,#13)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (2,2),(2,2),(0.0,1.0),(0.0,1.0),
  .UNSPECIFIED.);
/* Trim wire is a rectangle inset within the NURBS natural rectangle */
#30=CARTESIAN_POINT('',(10.0,5.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(90.0,5.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(90.0,45.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(10.0,45.0,0.0));
#37=VERTEX_POINT('',#36);
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,80.0);
#42=LINE('',#30,#41);
#43=DIRECTION('',(0.0,1.0,0.0));
#44=VECTOR('',#43,40.0);
#45=LINE('',#32,#44);
#46=DIRECTION('',(-1.0,0.0,0.0));
#47=VECTOR('',#46,80.0);
#48=LINE('',#34,#47);
#49=DIRECTION('',(0.0,-1.0,0.0));
#50=VECTOR('',#49,40.0);
#51=LINE('',#36,#50);
#60=EDGE_CURVE('',#31,#33,#42,.T.);
#61=EDGE_CURVE('',#33,#35,#45,.T.);
#62=EDGE_CURVE('',#35,#37,#48,.T.);
#63=EDGE_CURVE('',#37,#31,#51,.T.);
#70=ORIENTED_EDGE('',*,*,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#61,.T.);
#72=ORIENTED_EDGE('',*,*,#62,.T.);
#73=ORIENTED_EDGE('',*,*,#63,.T.);
#80=EDGE_LOOP('',(#70,#71,#72,#73));
#81=FACE_OUTER_BOUND('',#80,.T.);
#82=ADVANCED_FACE('',(#81),#20,.T.);
ENDSEC;
END-ISO-10303-21;
