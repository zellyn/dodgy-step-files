ISO-10303-21;
/* Gs167 - ShapeUpgrade_ShapeCopy: RectangularTrimmedSurface null basis
 *
 * Defect: Trimmed-surface unwrapping calls BasisSurface() without null check.
 * If basis is null (malformed STEP), down_cast succeeds but result overwritten
 * to null. Downstream GeomAdaptor_Surface(null) invokes undefined behavior.
 *
 * Reproducer: RECTANGULAR_TRIMMED_SURFACE with crafted basis reference;
 * verify null-safety on basis extraction and GeomAdaptor initialization.
 */
HEADER;
FILE_DESCRIPTION(('Gs167 test case','RectangularTrimmedSurface null basis detection'),'2;1');
FILE_NAME('Gs167.stp','2026-06-16T00:00:00',('zellyn@gmail.com'),'','auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
