ISO-10303-21;
/* Gs198: single ADVANCED_FACE on a B_SPLINE_SURFACE_WITH_KNOTS, U degree=2 with an interior U knot at 0.5 of multiplicity 2 (=degree, formally C0) whose control points were derived by exact Boehm knot INSERTION from a smooth single-span surface (poles (0,*,0)-(1,*,0.5)-(2,*,0.5)-(3,*,0.5)-(4,*,0)) -- the pole placement satisfies knot-removal continuity exactly (live-measured deviation ~2e-16, i.e. genuinely smooth, not a real kink; contrast Gs049's non-collinear-pole genuine break). ShapeUpgrade_SplitSurfaceContinuity::Compute finds Continuity<C1 at this knot, attempts MyBSpline->RemoveUKnot(iknot, degree-myCont, myTolerance) BEFORE adding a split value; the removal succeeds within tolerance (ShapeExtend_DONE3), so the surface is repaired in place and NO split value is added -- live-verified directly against Geom_BSplineSurface/ShapeUpgrade_SplitSurfaceContinuity: DONE1 (split needed)=False, DONE3 (knot removed)=True, USplitValues stay at the original [0,1] bounds */
HEADER;
FILE_DESCRIPTION(('Gs198'),'2;1');
FILE_NAME('Gs198.stp','2026-07-13T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
