ISO-10303-21;
/* Gs112 - ShapeUpgrade_ConvertSurfaceToBezierBasis cone-with-trim
 *
 * Defect: Trimmed CONICAL_SURFACE conversion to Bezier patch boundaries
 *  doesn't translate cleanly; trim boundaries don't align with Bezier patch
 *  boundaries, causing conversion artifacts.
 *
 * Reproducer: CONICAL_SURFACE trimmed with FACE_BOUND defining a partial
 *  cone; conversion to Bezier basis produces misaligned boundary curves.
 *
 * Expected kernel behavior:
 *   convert - Bezier conversion should validate trim boundary alignment
 *            or adjust patch layout to match. */
HEADER;
FILE_DESCRIPTION(('Gs112 test case','ShapeUpgrade_ConvertSurfaceToBezierBasis trimmed cone'),'2;1');
FILE_NAME('Gs112.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Axis placement at origin */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* CONICAL_SURFACE with apex at origin, half-angle 30 degrees */
#20=CONICAL_SURFACE('',#13,0.52359877,50.0);
/* Trimmed boundary vertices */
#30=CARTESIAN_POINT('',(25.0,0.0,43.30127));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(25.0,0.0,0.0));
#33=VERTEX_POINT('',#32);
/* Simple edge loop for the outer bound */
#40=EDGE_CURVE('',#31,#33,#41,.T.);
#41=LINE('',#30,#42);
#42=VECTOR('',#43,43.30127);
#43=DIRECTION('',(0.0,0.0,-1.0));
#44=EDGE_LOOP('',(#40));
#45=FACE_OUTER_BOUND('',#44,.T.);
/* Inner bound trimming a partial cone */
#50=CARTESIAN_POINT('',(50.0,0.0,86.60254));
#51=VERTEX_POINT('',#50);
#52=VERTEX_LOOP('',#51);
#53=FACE_BOUND('',#52,.T.);
/* ADVANCED_FACE with trimmed conical surface */
#60=ADVANCED_FACE('',(#45,#53),#20,.T.);
/* Wrap into shell */
#70=OPEN_SHELL('',(#60));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs112','Gs112','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#70),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
