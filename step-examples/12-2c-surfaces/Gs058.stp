/* Gs058 - SURFACE_PATCH transition_code, u_sense, v_sense parsed but ignored
   Defect: BRL-CAD step-g SurfacePatch::Load reads u_transition,
   v_transition (Transition_code enum: DISCONTINUOUS / CONTINUOUS /
   CONT_SAME_GRADIENT / CONT_SAME_GRADIENT_SAME_CURVATURE) and the
   u_sense / v_sense BOOLEANs, then SurfacePatch::LoadONBrep is a stub
   that prints "not implemented" and returns false.  Even a producer that
   carefully sets transition_code = .CONT_SAME_GRADIENT_SAME_CURVATURE.
   to declare C2 continuity at the patch boundary loses that information
   on the import side; the receiver cannot use the producer's continuity
   guarantee, will re-evaluate continuity numerically, and may emit a
   gap or kink at the boundary.  Distinct from Gs057 (which is the
   wholesale silent drop of RECTANGULAR_COMPOSITE_SURFACE): this is the
   specific loss of the per-patch transition / sense metadata.
   Sources: BRL-CAD src/conv/step/step-g/SurfacePatch.cpp Load+LoadONBrep
   stub. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(
  ('Gs058 - SURFACE_PATCH transition_code dropped by step-g'),
  '2;1');
FILE_NAME('Gs058.stp','2026-05-02T00:00:00',('cad-research-suite'),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Two adjacent 4x4 Bezier patches with a producer-declared C2 boundary. */
#10=CARTESIAN_POINT('a00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('a01',(0.0,1.0,0.0));
#12=CARTESIAN_POINT('a02',(0.0,2.0,0.0));
#13=CARTESIAN_POINT('a03',(0.0,3.0,0.0));
#20=CARTESIAN_POINT('a10',(1.0,0.0,0.0));
#21=CARTESIAN_POINT('a11',(1.0,1.0,0.0));
#22=CARTESIAN_POINT('a12',(1.0,2.0,0.0));
#23=CARTESIAN_POINT('a13',(1.0,3.0,0.0));
#30=CARTESIAN_POINT('a20',(2.0,0.0,0.0));
#31=CARTESIAN_POINT('a21',(2.0,1.0,0.0));
#32=CARTESIAN_POINT('a22',(2.0,2.0,0.0));
#33=CARTESIAN_POINT('a23',(2.0,3.0,0.0));
#40=CARTESIAN_POINT('a30',(3.0,0.0,0.0));
#41=CARTESIAN_POINT('a31',(3.0,1.0,0.0));
#42=CARTESIAN_POINT('a32',(3.0,2.0,0.0));
#43=CARTESIAN_POINT('a33',(3.0,3.0,0.0));
#100=BEZIER_SURFACE('patchA',3,3,
  ((#10,#11,#12,#13),(#20,#21,#22,#23),(#30,#31,#32,#33),(#40,#41,#42,#43)),
  .UNSPECIFIED.,.F.,.F.,.F.);
/* Defect: SURFACE_PATCH carrying explicit
   .CONT_SAME_GRADIENT_SAME_CURVATURE. continuity (C2 at boundary).
   step-g parses u_transition + v_transition + u_sense + v_sense then
   does nothing with them; the C2 hint is lost on import. */
#101=SURFACE_PATCH(#100,
  .CONT_SAME_GRADIENT_SAME_CURVATURE.,
  .CONT_SAME_GRADIENT_SAME_CURVATURE.,
  .T.,.F.);
ENDSEC;
END-ISO-10303-21;
