ISO-10303-21;
/* Gs030 - Edge geometry inconsistent with adjacent faces' actual intersection
 *
 * Sources:  B025 (TransMagic), W013
 *
 * Defect: After local edits (face translation, blend suppression, partial
 *  defeaturing) an edge's stored 3D curve no longer matches the geometric
 *  intersection of its two host faces. Edge survives as topology but its curve
 *  is stale, leading to large tolerances or visible cracks.
 *
 *  TransMagic phrasing: "edges for the geometry do not match the surfaces that
 *  they are edges for." Also applies to translator output where edges deviate
 *  from cylinder / cone surfaces beyond tolerance.
 *
 * Reproducer:  ADVANCED_FACE on CYLINDRICAL_SURFACE of radius 10 mm whose
 *  EDGE_CURVE is a LINE 0.5 mm radially off the cylinder.
 *
 * Expected kernel behavior:
 *   heal - rebuild-edge re-intersects host faces and rebuilds vertices;
 *   reproject curve onto surface, or replace with surface intersection. */
HEADER;
FILE_DESCRIPTION(('Gs030 test case','Stale edge geometry off cylinder'),'2;1');
FILE_NAME('Gs030.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Cylinder radius 10mm */
#20=CYLINDRICAL_SURFACE('',#13,10.0);
/* Vertices on cylinder - at exact radius 10 */
#30=CARTESIAN_POINT('',(10.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(10.0,0.0,5.0));
#33=VERTEX_POINT('',#32);
/* Defect: LINE origin radially offset by 0.5mm to (10.5, 0, 0), still goes +Z */
/* The edge claims to lie on the cylinder but its 3D curve passes through r=10.5 */
#40=CARTESIAN_POINT('',(10.5,0.0,0.0));
#41=DIRECTION('',(0.0,0.0,1.0));
#42=VECTOR('',#41,1.0);
#43=LINE('',#40,#42);
#50=EDGE_CURVE('',#31,#33,#43,.T.);
#51=ORIENTED_EDGE('',*,*,#50,.T.);
#60=EDGE_LOOP('',(#51));
#61=FACE_OUTER_BOUND('',#60,.T.);
#62=ADVANCED_FACE('',(#61),#20,.T.);
ENDSEC;
END-ISO-10303-21;
