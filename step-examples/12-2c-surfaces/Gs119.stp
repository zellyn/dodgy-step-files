ISO-10303-21;
/* Gs119 - CONICAL_SURFACE with zero radius (degenerate point)
 *
 * Defect: ShapeAnalysis_Surface.IsDegenerated CONICAL_SURFACE zero-radius
 *  cone with radius 0 and arbitrary semi-angle (effectively a degenerate point).
 *  IsDegenerated should detect but the radius test uses `radius > 0` not abs(radius).
 *
 * Reproducer: CONICAL_SURFACE with semi_angle > 0 and radius = 0.0
 *  The cone degenerates to a point at the apex; the method should flag it degenerate
 *  but only checks radius > 0, missing the zero case.
 *
 * Expected kernel behavior:
 *   heal - detect and repair zero-radius cone as a degenerate surface;
 *   reject only when semi-angle is invalid (< 0 or > pi/2). */
HEADER;
FILE_DESCRIPTION(('Gs119 test case','CONICAL_SURFACE with zero radius'),'2;1');
FILE_NAME('Gs119.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Axis placement at origin, Z pointing up */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Defect: CONICAL_SURFACE with radius = 0.0 and semi_angle = 0.3 radians */
/* This cone degenerates to a point at the apex; radius check only tests radius > 0 */
#20=CONICAL_SURFACE('',#13,0.0,0.3);
/* Vertex at apex (the only non-degenerate point of the surface) */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
/* Vertex loop wrapping the apex */
#32=VERTEX_LOOP('',#31);
#33=FACE_OUTER_BOUND('',#32,.T.);
/* ADVANCED_FACE with zero-radius cone */
#34=ADVANCED_FACE('',(#33),#20,.T.);
/* Wrap into a shell */
#40=OPEN_SHELL('',(#34));
/* Product context chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs119','Gs119','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#40),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
