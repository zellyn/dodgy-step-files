ISO-10303-21;
/* Gs011 - Trim curves with self-intersection (mesh-derived BRep, STL->STEP)
 *
 * Sources:  J024, X012
 * Senders:  FreeCAD `Part / Create shape from mesh`; other STL->STEP utilities
 * Originally also catalogued as: Gn028
 *
 * Defect: Mesh-to-BRep tools fit B_SPLINE_SURFACE_WITH_KNOTS patches per triangle
 *  and stitch; near sharp creases the patches' trim curves self-intersect or
 *  overlap. Output STEP loads but every later boolean fails.
 *
 * Reproducer:  STL with creases > ~30 degrees; sew tolerance <= 1e-6; resulting
 *  ADVANCED_FACE contains pcurves that cross.
 *
 * Expected kernel behavior:
 *   STL->STEP path should emit faceted BRep (FACETED_BREP / OPEN_SHELL) rather
 *   than smooth NURBS; or run self-intersection healing as a final step. */
HEADER;
FILE_DESCRIPTION(('Gs011 test case','Mesh-derived self-intersecting trim curves'),'2;1');
FILE_NAME('Gs011.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Two trim segments cross in UV: A->B at (0,0)->(10,10), C->D at (0,10)->(10,0) */
/* These pcurves overlap/cross within the same wire - typical mesh-stitch artefact. */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(10.0,10.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(0.0,10.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(10.0,0.0,0.0));
#37=VERTEX_POINT('',#36);
#40=DIRECTION('',(0.7071067811865476,0.7071067811865476,0.0));
#41=VECTOR('',#40,14.142135623730951);
#42=LINE('',#30,#41);
#43=DIRECTION('',(0.7071067811865476,-0.7071067811865476,0.0));
#44=VECTOR('',#43,14.142135623730951);
#45=LINE('',#34,#44);
/* Defect: two edges of same wire cross in UV at (5,5) - mesh-stitch trim defect */
#50=EDGE_CURVE('',#31,#33,#42,.T.);
#51=EDGE_CURVE('',#35,#37,#45,.T.);
#52=ORIENTED_EDGE('',*,*,#50,.T.);
#53=ORIENTED_EDGE('',*,*,#51,.T.);
/* Wire intentionally non-Jordan to trigger trim-curve self-intersection check */
#60=EDGE_LOOP('',(#52,#53));
#61=FACE_OUTER_BOUND('',#60,.T.);
#62=ADVANCED_FACE('',(#61),#20,.T.);
ENDSEC;
END-ISO-10303-21;
