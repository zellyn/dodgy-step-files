ISO-10303-21;
/* Gs197: single ADVANCED_FACE on a SURFACE_OF_REVOLUTION whose swept curve is a degree-2 B_SPLINE_CURVE_WITH_KNOTS with an interior knot at v=0.5 of multiplicity 2 (=degree), a genuine C0 position-only kink (non-collinear poles), revolved through u:0..pi. The SURFACE itself (not just its 2D pcurves) inherits C0 continuity from the basis curve. ShapeUpgrade_SplitSurfaceContinuity::Compute special-cases Geom_SurfaceOfRevolution: since Surface->Continuity() (C0) is below the C1 criterion, it hands the BASIS CURVE (not the surface) to ShapeUpgrade_SplitCurve3dContinuity, which returns split value v=0.5 -- the surface is split in V, U untouched. Live-verified directly against Geom_SurfaceOfRevolution/ShapeUpgrade_SplitSurfaceContinuity: face reads as 1 face (Continuity=C0); split produces 2 faces (V:[0,0.5] and V:[0.5,1], both U:[0,pi]) */
HEADER;
FILE_DESCRIPTION(('Gs197'),'2;1');
FILE_NAME('Gs197.stp','2026-07-13T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
/* profile_u0 basis curve: degree2 B-spline, C0 knot at v=0.5 (interior mult=2=degree), genuine kink */
#1=CARTESIAN_POINT('',(4.0,0.0,0.0));
#2=CARTESIAN_POINT('',(3.5,0.0,0.5));
#3=CARTESIAN_POINT('',(3.0,0.0,0.2));
#4=CARTESIAN_POINT('',(2.5,0.0,-0.5));
#5=CARTESIAN_POINT('',(2.0,0.0,0.0));
#6=B_SPLINE_CURVE_WITH_KNOTS('gs197_profile_u0',2,(#1,#2,#3,#4,#5),.UNSPECIFIED.,.F.,.F.,(3,2,3),(0.0,0.5,1.0),.UNSPECIFIED.);
/* revolution axis: Z through origin */
#7=CARTESIAN_POINT('',(0.0,0.0,0.0));
#8=DIRECTION('',(0.0,0.0,1.0));
#9=AXIS1_PLACEMENT('gs197_rev_ax',#7,#8);
#10=SURFACE_OF_REVOLUTION('gs197_surf',#6,#9);
#11=(GEOMETRIC_REPRESENTATION_CONTEXT(2)PARAMETRIC_REPRESENTATION_CONTEXT()REPRESENTATION_CONTEXT('UV','2D'));
/* vertices */
#12=CARTESIAN_POINT('',(4.0,0.0,0.0));
#13=VERTEX_POINT('',#12);
#14=CARTESIAN_POINT('',(-4.0,0.0,0.0));
#15=VERTEX_POINT('',#14);
#16=CARTESIAN_POINT('',(-2.0,0.0,0.0));
#17=VERTEX_POINT('',#16);
#18=CARTESIAN_POINT('',(2.0,0.0,0.0));
#19=VERTEX_POINT('',#18);
/* E_bottom: arc_v0 radius 4, z=0, u:0->pi, VA->VB */
#20=DIRECTION('',(0.0,0.0,1.0));
#21=DIRECTION('',(1.0,0.0,0.0));
#22=AXIS2_PLACEMENT_3D('',#7,#20,#21);
#23=CIRCLE('gs197_arc_v0',#22,4.0);
#24=CARTESIAN_POINT('',(0.0,0.0));
#25=DIRECTION('',(1.0,0.0));
#26=VECTOR('',#25,3.14159265359);
#27=LINE('',#24,#26);
#28=DEFINITIONAL_REPRESENTATION('bottom_pcdef',(#27),#11);
#29=PCURVE('bottom_pc',#10,#28);
#30=SURFACE_CURVE('bottom_sc',#23,(#29),.PCURVE_S1.);
#31=EDGE_CURVE('gs197_e_bottom',#13,#15,#30,.T.);
/* E_right: profile_uPi (rotated pi about Z: negate X), v:0->1, VB->VC */
#32=CARTESIAN_POINT('',(-4.0,0.0,0.0));
#33=CARTESIAN_POINT('',(-3.5,0.0,0.5));
#34=CARTESIAN_POINT('',(-3.0,0.0,0.2));
#35=CARTESIAN_POINT('',(-2.5,0.0,-0.5));
#36=CARTESIAN_POINT('',(-2.0,0.0,0.0));
#37=B_SPLINE_CURVE_WITH_KNOTS('gs197_profile_uPi',2,(#32,#33,#34,#35,#36),.UNSPECIFIED.,.F.,.F.,(3,2,3),(0.0,0.5,1.0),.UNSPECIFIED.);
#38=CARTESIAN_POINT('',(3.14159265359,0.0));
#39=DIRECTION('',(0.0,1.0));
#40=VECTOR('',#39,1.0);
#41=LINE('',#38,#40);
#42=DEFINITIONAL_REPRESENTATION('right_pcdef',(#41),#11);
#43=PCURVE('right_pc',#10,#42);
#44=SURFACE_CURVE('right_sc',#37,(#43),.PCURVE_S1.);
#45=EDGE_CURVE('gs197_e_right',#15,#17,#44,.T.);
/* E_top: arc_v1 radius 2, z=0, u:0->pi, VD->VC */
#46=CIRCLE('gs197_arc_v1',#22,2.0);
#47=CARTESIAN_POINT('',(0.0,1.0));
#48=DIRECTION('',(1.0,0.0));
#49=VECTOR('',#48,3.14159265359);
#50=LINE('',#47,#49);
#51=DEFINITIONAL_REPRESENTATION('top_pcdef',(#50),#11);
#52=PCURVE('top_pc',#10,#51);
#53=SURFACE_CURVE('top_sc',#46,(#52),.PCURVE_S1.);
#54=EDGE_CURVE('gs197_e_top',#19,#17,#53,.T.);
/* E_left: profile_u0 (#6 reused), v:0->1, VA->VD */
#55=CARTESIAN_POINT('',(0.0,0.0));
#56=DIRECTION('',(0.0,1.0));
#57=VECTOR('',#56,1.0);
#58=LINE('',#55,#57);
#59=DEFINITIONAL_REPRESENTATION('left_pcdef',(#58),#11);
#60=PCURVE('left_pc',#10,#59);
#61=SURFACE_CURVE('left_sc',#6,(#60),.PCURVE_S1.);
#62=EDGE_CURVE('gs197_e_left',#13,#19,#61,.T.);
#63=ORIENTED_EDGE('',$,$,#31,.T.);
#64=ORIENTED_EDGE('',$,$,#45,.T.);
#65=ORIENTED_EDGE('',$,$,#54,.F.);
#66=ORIENTED_EDGE('',$,$,#62,.F.);
#67=EDGE_LOOP('',(#63,#64,#65,#66));
#68=FACE_OUTER_BOUND('',#67,.T.);
#69=ADVANCED_FACE('',(#68),#10,.T.);
#70=OPEN_SHELL('',(#69));
#71=SHELL_BASED_SURFACE_MODEL('',(#70));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Gs197','Gs197','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#71),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
END-ISO-10303-21;
