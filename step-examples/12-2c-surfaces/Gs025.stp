ISO-10303-21;
/* Gs025 - C0-only joins where C1 expected (interior continuity violation)
 *
 * Sources:  R006, F047, F075, M006, L043, H054
 *
 * Defect: BSpline curves and surfaces whose interior knot-multiplicity equals the
 *  order produce only C0 continuity at the join, but downstream CAD/CAM/CAE tools
 *  assume at least C1. After format conversion, neighbouring faces re-parametrised
 *  into different surface types show G0/G1/G2 discontinuities at shared edges
 *  that were smooth in source.
 *
 * Reproducer:  BSpline curve with internal knot of multiplicity equal to order
 *  producing G0-only spot (here: degree 3, internal knot of multiplicity 3 - one
 *  short of the 4-mult that would split it; this is the borderline pathology).
 *
 * Expected kernel behavior:
 *   heal - split curve / surface at continuity drops via
 *   ShapeUpgrade_ShapeDivideContinuity or C0BSplineToSequenceOfC1BsplineCurve;
 *   report as quality warning; archive-stable only if validation properties
 *   still match. */
HEADER;
FILE_DESCRIPTION(('Gs025 test case','C0-only knot in cubic BSpline curve'),'2;1');
FILE_NAME('Gs025.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* 8 control points: two cubic Bezier segments meeting at u=0.5 */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(1.0,2.0,0.0));
#12=CARTESIAN_POINT('',(2.0,2.0,0.0));
#13=CARTESIAN_POINT('',(3.0,0.0,0.0));
#1310=CARTESIAN_POINT('',(3.0,-1.5,0.0));
#14=CARTESIAN_POINT('',(4.0,-2.0,0.0));
#15=CARTESIAN_POINT('',(5.0,-2.0,0.0));
#16=CARTESIAN_POINT('',(6.0,0.0,0.0));
/* Defect: knot vector has interior knot at 0.5 with multiplicity 4 (==order=degree+1) */
/* Knots: 0(4), 0.5(4), 1(4) -- mult=order at interior gives C-1 (positional break);
 * the catalog title labels this "C0 cusp / kink" because the curve is
 * locally interpretable as two clamped Bezier pieces with coincident
 * end/start poles (their meeting position equals the shared knot value,
 * tangent direction undefined). 8 control points satisfies
 * n_cps = sum(mults) - degree - 1 = 12 - 3 - 1 = 8. */
#20=B_SPLINE_CURVE_WITH_KNOTS('',3,
  (#10,#11,#12,#13,#1310,#14,#15,#16),
  .UNSPECIFIED.,.F.,.F.,
  (4,4,4),(0.0,0.5,1.0),
  .UNSPECIFIED.);
#30=VERTEX_POINT('',#10);
#31=VERTEX_POINT('',#16);
#40=EDGE_CURVE('',#30,#31,#20,.T.);
ENDSEC;
END-ISO-10303-21;
