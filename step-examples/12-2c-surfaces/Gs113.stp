ISO-10303-21;
/* Gs113 - ShapeAnalysis_Surface.ComputeBoundIsos negative-trim
 *
 * Defect: ComputeBoundIsos doesn't validate trim parameter range; when
 *  v_min > v_max (inverted range), produces inverted iso sweeps without
 *  error or warning.
 *
 * Reproducer: Face trim with inverted v-parameter range (e.g., v_min=1.0,
 *  v_max=0.0); ComputeBoundIsos generates iso curves with reversed sweep.
 *
 * Expected kernel behavior:
 *   validate - ComputeBoundIsos should detect and reject inverted ranges
 *             or normalize them. */
HEADER;
FILE_DESCRIPTION(('Gs113 test case','ShapeAnalysis_Surface.ComputeBoundIsos negative trim'),'2;1');
FILE_NAME('Gs113.stp','2026-06-15T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Axis placement at origin */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* RECTANGULAR_TRIMMED_SURFACE with inverted v-range (negative trim) */
#20=PLANE('',#13);
#21=RECTANGULAR_TRIMMED_SURFACE('',#20,0.0,100.0,100.0,0.0,.T.,.T.);
/* Bounding vertex - using absolute position */
#30=CARTESIAN_POINT('',(100.0,100.0,0.0));
#31=VERTEX_POINT('',#30);
#32=VERTEX_LOOP('',#31);
#33=FACE_OUTER_BOUND('',#32,.T.);
/* ADVANCED_FACE with inverted-range trimmed surface */
#34=ADVANCED_FACE('',(#33),#21,.T.);
/* Wrap into shell */
#40=OPEN_SHELL('',(#34));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gs113','Gs113','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#40),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
