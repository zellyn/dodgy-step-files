ISO-10303-21;
/* Lh029: FILE_SCHEMA with embedded comment inside the schema-name list */
/* DEFECT: FILE_SCHEMA(('CONFIG_CONTROL_DESIGN' /* legacy */, 'AUTOMOTIVE_DESIGN')) */
/* Naive parsers using byte-level regex on the raw header text choke on inline comments */
/* OCC silently accepts (no diagnostic, empty result); catalog requires heal and accept */
HEADER;
FILE_DESCRIPTION(('Lh029: FILE_SCHEMA with embedded comment in schema-name list'),'2;1');
FILE_NAME('Lh029.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
/* DEFECT: embedded /* legacy */ comment inside the schema name list */
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN' /* legacy */, 'AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('comment-in-schema-name-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
