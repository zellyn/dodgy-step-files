ISO-10303-21;
/* Lh011: FILE_NAME timestamp is locale-formatted (DD/MM/YYYY HH:MM), not ISO-8601 */
/* ISO 10303-21 §8: timestamp must be ISO-8601 form YYYY-MM-DDThh:mm:ss */
/* DEFECT: '27/12/2003 11:57' is a locale-formatted date, not ISO-8601 */
/* File parses (STRING is lexically valid) but semantic layer must warn */
/* Produced by older CAD exporters that use system locale date formatting */
HEADER;
FILE_DESCRIPTION(('Lh011: FILE_NAME timestamp not in ISO-8601 form'),'2;1');
/* DEFECT: timestamp '27/12/2003 11:57' is DD/MM/YYYY HH:MM format, not ISO-8601 */
FILE_NAME('Lh011.stp','27/12/2003 11:57',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('non-iso8601-timestamp-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
