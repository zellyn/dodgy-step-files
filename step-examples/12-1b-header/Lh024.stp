/* Lh024 — Reuse of #NNN across different DATA sections (Edition-3
 *         multi-section)
 * Defect: Edition 3 allows multiple DATA;...ENDSEC; sections, each
 * with its own #NNN namespace; cross-section references use
 * @section_name#N syntax. Tools targeting Edition 1/2 either fail
 * at the second DATA; or silently flatten namespaces, causing
 * collisions when #10 appears in both sections. This file emits
 * two DATA sections that both define #10 and #11. The
 * implementation_level '4;1' signals Edition-3 conformance. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'4;1');
FILE_NAME('Lh024.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#10=PRODUCT('a','part-a','',(#3));
#11=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#12=DIRECTION('z',(0.0,0.0,1.0));
ENDSEC;
DATA('extra',('AUTOMOTIVE_DESIGN'));
/* Reuse of #10 and #11 in second section: legal under Ed.3
 * (per-section namespace); silently merged by Edition-1/2 readers. */
#10=APPLICATION_CONTEXT('overlapping id reused in second section');
#11=PRODUCT('b','part-b','',(#10));
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#21=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#22=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#23=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#20,
  'distance_accuracy_value','');
#24=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#23))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#21,#22))
  REPRESENTATION_CONTEXT('Lh024','3D'));
ENDSEC;
END-ISO-10303-21;
