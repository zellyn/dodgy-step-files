ISO-10303-21;
/* Lh024: two DATA sections each define #10 — Ed.3 namespace collision */
/* ISO 10303-21 Ed.3: each DATA section has its own #NNN namespace */
/* DEFECT: Ed.1/2 readers flatten namespaces; #10 collides across sections */
/* Cross-section references should use @section_name#N syntax in Ed.3 */
/* OCC: silently accepts (empty result); catalog requires heal or reject */
HEADER;
FILE_DESCRIPTION(('Lh024: #NNN reused across two DATA sections'),'2;1');
FILE_NAME('Lh024.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
/* First DATA section: defines #10 as PRODUCT */
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#10=PRODUCT('part-a','Part A','',(#11));
#11=APPLICATION_CONTEXT('automotive design');
#12=GEOMETRIC_CURVE_SET('section1-shape',(#1,#2));
ENDSEC;
/* DEFECT: second DATA section reuses #10 — collides with #10 from first section */
DATA('supplemental',('AUTOMOTIVE_DESIGN'));
#10=APPLICATION_CONTEXT('supplemental context');
#20=CARTESIAN_POINT('extra',(2.,2.,0.));
#21=GEOMETRIC_CURVE_SET('section2-shape',(#20));
ENDSEC;
END-ISO-10303-21;
