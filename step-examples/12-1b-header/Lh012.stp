ISO-10303-21;
/* Lh012: FILE_NAME timestamp is a bare token, not a quoted STRING */
/* ISO 10303-21 §8: timestamp attribute of FILE_NAME must be a STRING (apostrophe-delimited) */
/* DEFECT: 2013-10-24T12:12:06 lacks surrounding apostrophes */
/* The bare token tokenizes as identifiers/numbers and fails the Part-21 grammar */
/* Produced by older stepcode versions (issue #267) */
HEADER;
FILE_DESCRIPTION(('Lh012: unquoted timestamp in FILE_NAME - timestamp not a STRING'),'2;1');
/* DEFECT: timestamp 2013-10-24T12:12:06 is a bare token, not a quoted STRING */
FILE_NAME('Lh012.stp',2013-10-24T12:12:06,(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('unquoted-timestamp-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
