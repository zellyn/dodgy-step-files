ISO-10303-21;
/* Lh007: FILE_SCHEMA lists two schema names — implementation-defined behavior */
/* ISO 10303-21 §8: behavior is undefined when FILE_SCHEMA contains multiple names */
/* DEFECT: FILE_SCHEMA(('AP203_CONFIG_CONTROL_DESIGN','AUTOMOTIVE_DESIGN')); */
/* Receivers diverge: first-wins vs most-capable-wins; both are non-deterministic */
HEADER;
FILE_DESCRIPTION(('Lh007: FILE_SCHEMA with multiple schema names'),'2;1');
FILE_NAME('Lh007.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
/* DEFECT: two schema names in one FILE_SCHEMA — divergent receiver behavior */
FILE_SCHEMA(('AP203_CONFIG_CONTROL_DESIGN','AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('multi-schema-file-schema-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
