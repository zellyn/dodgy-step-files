ISO-10303-21;
/* Lh032: #PI used as schema-defined constant where an instance reference is required */
/* ISO 10303-21: #NAME refers to a schema-defined constant; #NNN refers to an instance */
/* DEFECT: #PI is not a constant in AUTOMOTIVE_DESIGN; unresolved-reference error */
/* OCC silently accepts with diagnostic (empty result); catalog requires reject */
HEADER;
FILE_DESCRIPTION(('Lh032: #PI constant reference where #NNN instance expected'),'2;1');
FILE_NAME('Lh032.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('pi-point',(#PI,0.,0.));
/* DEFECT: #PI used as if it were a schema-defined constant (like math pi = 3.14159) */
/* but AUTOMOTIVE_DESIGN defines no constant named PI; this is an unresolved reference */
#3=DIRECTION('xdir',(#PI,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('constant-ref-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
