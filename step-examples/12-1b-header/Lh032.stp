/* Lh032 — Constant reference (#NAME / @NAME) used where instance
 *         reference required
 * Defect: ISO 10303-21 distinguishes #NAME / @NAME (uppercase
 * identifier — refers to a schema-defined constant) from
 * #NNN / @NNN (refers to an instance). Tools occasionally emit
 * #PI thinking it is a literal alias when the schema defines no
 * such constant, producing an unresolved-reference error. This
 * file places #PI as one component of a DIRECTION coordinate
 * triple. The remainder of the file is otherwise valid. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('Lh032.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT('Lh032-part','Lh032 demo','',(#3));
#5=PRODUCT_DEFINITION_FORMATION('','',#4);
#6=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
/* The defect: #PI as a coordinate value where a REAL is required;
 * #PI is not a schema-defined constant in AUTOMOTIVE_DESIGN. */
#11=DIRECTION('mis-uses-#PI-as-constant',(#PI,0.0,0.0));
#12=DIRECTION('z',(0.0,0.0,1.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#21=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#22=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#23=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#20,
  'distance_accuracy_value','');
#24=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#23))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#21,#22))
  REPRESENTATION_CONTEXT('Lh032','3D'));
ENDSEC;
END-ISO-10303-21;
