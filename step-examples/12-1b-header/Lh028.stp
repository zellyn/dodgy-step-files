ISO-10303-21;
/* Lh028: forward reference in ANCHOR section to undefined instance #100 */
/* ISO 10303-21 Ed.3: every #NNN in ANCHOR must resolve in a DATA section */
/* DEFECT: <part_anchor>=#100; but #100 is absent from all DATA sections */
/* pure-Python validator rejects (E_UNRESOLVED_REFS); OCC silently accepts empty */
HEADER;
FILE_DESCRIPTION(('Lh028: ANCHOR forward reference to undefined #100'),'2;1');
FILE_NAME('Lh028.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
ANCHOR;
/* DEFECT: #100 is not defined anywhere in the DATA section below */
<part_anchor>=#100;
<valid_anchor>=#1;
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('anchor-ghost-shape',(#1,#2));
/* NOTE: #100 referenced in ANCHOR above is intentionally absent */
ENDSEC;
END-ISO-10303-21;
