ISO-10303-21;
/* Lh040: FILE_INFO timestamp contradicts FILE_NAME date */
/* ISO 10303-21 Ed.3 §6.3: FILE_INFO provides supplementary revision metadata */
/* DEFECT: FILE_NAME says 2026-04-26 but FILE_INFO claims 2016-01-01 (10 years earlier) */
/* OCC silently picks one timestamp without surfacing the conflict */
/* expected: surface both timestamps; warn on mismatch; define precedence deterministically */
HEADER;
FILE_DESCRIPTION(('Lh040: FILE_INFO date contradicts FILE_NAME date'),'2;1');
FILE_NAME('Lh040.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
FILE_INFO('rev','2016-01-01T00:00:00','release-r12');
/* DEFECT: FILE_INFO claims 2016-01-01 but FILE_NAME above says 2026-04-26 */
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('conflicting-timestamp-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
