/* Lh025 — Mixing #NNN (entity) and @NNN (value) namespaces (Edition-3)
 * Defect: Edition 3 introduces @NNN for value instances. The integer
 * space is disjoint from #NNN entity instances: #1 and @1 are
 * distinct. Readers that collapse them into one map silently merge
 * unrelated objects. This file deliberately uses #1 and @1 as
 * different objects, and references @1 from a #-attribute slot in
 * #2 to exercise namespace-disambiguation logic. The
 * implementation_level '4;1' signals Edition-3 conformance. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'4;1');
FILE_NAME('Lh025.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=PRODUCT('a','part-a','',$);
@1=POSITIVE_LENGTH_MEASURE(2.5);
#2=ITEM_DEFINED_TRANSFORMATION('',$,@1);
#3=APPLICATION_CONTEXT('automotive design');
#4=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#3);
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#21=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#22=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#23=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#20,
  'distance_accuracy_value','');
#24=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#23))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#21,#22))
  REPRESENTATION_CONTEXT('Lh025','3D'));
ENDSEC;
END-ISO-10303-21;
