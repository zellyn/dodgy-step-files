ISO-10303-21;
/* Lh025: mixing #NNN entity and @NNN value namespaces (Edition 3) */
/* ISO 10303-21 Ed.3: #NNN and @NNN are disjoint namespaces; #1 != @1 */
/* DEFECT: @1 value-instance used in slot expecting #NNN entity-instance */
/* Readers collapsing both namespaces into one map silently merge unrelated objects */
/* OCC silently accepts (empty result); catalog requires reject */
HEADER;
FILE_DESCRIPTION(('Lh025: mixing #NNN entity and @NNN value namespaces'),'2;1');
FILE_NAME('Lh025.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
/* DEFECT: @1 is an Ed.3 value-instance identifier — not valid here */
@1=POSITIVE_LENGTH_MEASURE(2.5);
/* DEFECT: ITEM_DEFINED_TRANSFORMATION attribute slot expects #NNN entity reference */
/* but @1 (a value-instance) is supplied instead — namespace confusion */
#5=ITEM_DEFINED_TRANSFORMATION('transform',$,@1);
#6=GEOMETRIC_CURVE_SET('namespace-confusion-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
