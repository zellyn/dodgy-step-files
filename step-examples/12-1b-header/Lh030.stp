ISO-10303-21;
/* Lh030: mixed-case RP keyword value — 'Composite' instead of 'composite' */
/* DEFECT: GEOMETRIC_TOLERANCE_RELATIONSHIP uses 'Composite' (mixed case) */
/* Recommended Practices require canonical lower-case 'composite' */
/* Receivers that string-compare strictly fail; OCC silently accepts empty */
HEADER;
FILE_DESCRIPTION(('Lh030: mixed-case RP keyword Composite instead of composite'),'2;1');
FILE_NAME('Lh030.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.5),#6);
#6=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#7=GEOMETRIC_TOLERANCE_WITH_DATUM_REFERENCE($,$,#5,#8,(#9));
#8=GEOMETRIC_CURVE_SET('rp-case-mismatch-shape',(#1,#2));
#9=DATUM_REFERENCE(1,'A');
/* DEFECT: 'Composite' is mixed-case; RP canonical form is 'composite' */
#10=GEOMETRIC_TOLERANCE_RELATIONSHIP('Composite','composite tolerance pair',#7,#7);
ENDSEC;
END-ISO-10303-21;
