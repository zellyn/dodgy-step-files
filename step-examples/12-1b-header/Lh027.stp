ISO-10303-21;
/* Lh027: malformed entity ID in ANCHOR entry — #42@x is not a valid #NNN reference */
/* ISO 10303-21 Ed.3: ANCHOR entries must use pure #NNN integer form */
/* DEFECT: <part_anchor>=#42@x has non-numeric suffix @x after digits */
/* OCC silently accepts (empty result); catalog requires reject with diagnostic */
HEADER;
FILE_DESCRIPTION(('Lh027: malformed entity ID in ANCHOR entry'),'2;1');
FILE_NAME('Lh027.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
/* DEFECT: ANCHOR section with malformed reference #42@x */
ANCHOR;
/* DEFECT: #42@x is not a valid entity-instance reference; @x suffix violates grammar */
<part_anchor>=#42@x;
<valid_anchor>=#1;
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('malformed-anchor-id-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
