ISO-10303-21;
/* Lh038: FILE_POPULATION header record without closing population marker */
/* ISO 10303-21 Ed.3 §6.3: FILE_POPULATION must have a corresponding close marker */
/* DEFECT: FILE_POPULATION('release_a',...) has no terminator/close marker */
/* instances appear to belong to population 'release_a' or to none; */
/* OCC silently accepts with no diagnostic; expected: reject or require deterministic apply */
HEADER;
FILE_DESCRIPTION(('Lh038: FILE_POPULATION without close marker'),'2;1');
FILE_NAME('Lh038.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
FILE_POPULATION('release_a','version-1','release-baseline');
/* DEFECT: no closing/terminating record for the population 'release_a' */
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('unterminated-population-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
