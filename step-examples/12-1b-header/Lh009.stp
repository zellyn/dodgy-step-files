ISO-10303-21;
/* Lh009: FILE_SCHEMA uses non-canonical truncated schema name */
/* ISO 10303-21 §8: schema name must match a registered AP identifier exactly */
/* DEFECT: 'AUTOMOTIVE_DESIGN_MIM' is missing the required '_LF' suffix */
/* Correct form: FILE_SCHEMA(('AUTOMOTIVE_DESIGN_MIM_LF')); */
/* Receivers that do exact-match comparison will fail to bind the schema */
HEADER;
FILE_DESCRIPTION(('Lh009: FILE_SCHEMA with non-canonical truncated schema name'),'2;1');
FILE_NAME('Lh009.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
/* DEFECT: AUTOMOTIVE_DESIGN_MIM is not a registered schema; _LF suffix is required */
FILE_SCHEMA(('AUTOMOTIVE_DESIGN_MIM'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('unrecognised-schema-name-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
