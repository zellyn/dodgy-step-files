ISO-10303-21;
/* Lh008: HEADER contains two FILE_SCHEMA records with conflicting schema names */
/* ISO 10303-21 §8: exactly one FILE_SCHEMA record is permitted in HEADER */
/* DEFECT: two FILE_SCHEMA lines — last-write-wins vs first-write-wins diverges */
/* Receivers disagree which schema wins; both are non-deterministic silent mis-bindings */
HEADER;
FILE_DESCRIPTION(('Lh008: duplicate FILE_SCHEMA with conflicting names'),'2;1');
FILE_NAME('Lh008.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
/* DEFECT: first FILE_SCHEMA record */
FILE_SCHEMA(('AP203_CONFIG_CONTROL_DESIGN'));
/* DEFECT: second FILE_SCHEMA record — only one is permitted */
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('duplicate-file-schema-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
