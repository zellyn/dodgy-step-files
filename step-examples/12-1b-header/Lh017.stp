ISO-10303-21;
/* Lh017: user-defined entity with ! prefix in DATA section */
/* ISO 10303-21 §11: ! prefix designates user-defined entity types */
/* DEFECT: schema readers with regex [A-Z][0-9A-Z_]* reject ! identifiers */
/* Cross-oracle: pure Python rejects E_UNRESOLVED_REFS; OCCT silently accepts */
HEADER;
FILE_DESCRIPTION(('Lh017: user-defined entity with ! prefix in DATA section'),'2;1');
FILE_NAME('Lh017.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
/* DEFECT: !MYCURVE uses the ! prefix for user-defined entity — breaks schema readers */
#12=!MYCURVE(0.0,0.0,0.0,1.0,$,$,$);
#5=GEOMETRIC_CURVE_SET('bang-prefixed-entity-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
