/* Lh026 — Edition-3 ANCHOR / REFERENCE / SIGNATURE sections present
 *         in Edition-2 readers
 * Defect: Edition 3 introduces three optional sections: ANCHOR
 * (named external entry points), REFERENCE (named external links
 * via URI), and SIGNATURE (digital signature).
 * implementation_level becomes '4;1'. Older Edition-2 readers
 * either fail to parse, strip-and-reparse, or warn-and-skip —
 * behavior is implementation-defined. This file emits all three
 * optional sections after HEADER and around DATA. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'4;1');
FILE_NAME('Lh026.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
ANCHOR;
<part_anchor>=#4;
<placement_anchor>=#13;
<context_anchor>=#24;
ENDSEC;
REFERENCE;
<external_geometry>='https://example.invalid/Lh026/external.stp#root';
<companion_part>='file:./companion.stp#part_anchor';
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT('Lh026-part','Lh026 demo','',(#3));
#5=PRODUCT_DEFINITION_FORMATION('','',#4);
#6=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#21=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#22=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#23=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#20,
  'distance_accuracy_value','');
#24=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#23))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#21,#22))
  REPRESENTATION_CONTEXT('Lh026','3D'));
ENDSEC;
SIGNATURE;
'MIIBuwYJKoZIhvcNAQcCoIIBrDCCAagCAQExCzAJBgUrDgMCGgUAMA0GCSqGSIb3DQEHAaAA';
