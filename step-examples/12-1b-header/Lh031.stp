ISO-10303-21;
/* Lh031: FILE_NAME preprocessor_version contains 'I-DEAS Master Series 11' */
/* DEFECT: OCCT auto-detects I-DEAS non-manifold mode by substring match on this field */
/* Correct detection: inspect entity graph for NON_MANIFOLD_SURFACE_SHAPE_REPRESENTATION */
/* This file has no non-manifold entities; auto-detect fires a false positive */
/* OCC silently accepts (empty result); catalog requires heal and accept */
HEADER;
FILE_DESCRIPTION(('Lh031: I-DEAS substring in FILE_NAME preprocessor_version'),'2;1');
/* DEFECT: preprocessor_version field contains I-DEAS substring; triggers false-positive */
FILE_NAME('Lh031.stp','2026-06-20T00:00:00',(''),(''),'I-DEAS Master Series 11','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('ideas-false-positive-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
