/* Lh031 — Header recognition relies on FILE_NAME originating-system
 *         substring (I-DEAS auto-detect)
 * Defect: OCCT auto-detects I-DEAS-style non-manifold encoding by
 * substring-matching the FILE_NAME originating_system field.
 * Misses other I-DEAS variants whose preprocessor string differs;
 * flags false positives on tools whose preprocessor mentions
 * "I-DEAS". This file places 'I-DEAS Master Series 8' in the
 * originating_system slot to exercise the substring match. The
 * DATA section does *not* contain
 * NON_MANIFOLD_SURFACE_SHAPE_REPRESENTATION — so the header
 * heuristic disagrees with the entity graph (a robust kernel
 * should look at the entity types, not at a header substring). */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('Lh031.stp','2026-04-26T00:00:00',(''),(''),
  '','I-DEAS Master Series 8','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT('Lh031-part','Lh031 demo','',(#3));
#5=PRODUCT_DEFINITION_FORMATION('','',#4);
#6=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#21=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#22=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#23=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#20,
  'distance_accuracy_value','');
#24=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#23))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#21,#22))
  REPRESENTATION_CONTEXT('Lh031','3D'));
ENDSEC;
END-ISO-10303-21;
