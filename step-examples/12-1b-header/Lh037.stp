ISO-10303-21;
/* Lh037: user-defined !FOO header entity placed before FILE_DESCRIPTION */
/* ISO 10303-21 Ed.3 §6.2: FILE_DESCRIPTION must be the first HEADER record */
/* DEFECT: !COMPANY_INFO appears before FILE_DESCRIPTION — violates required order */
/* OCC rejects under strict mode; expected: skip !FOO with warning, tolerate any position */
HEADER;
!COMPANY_INFO('ACME','release-2026','contact@acme.example');
/* DEFECT: standard records follow the !FOO entity, not precede it */
FILE_DESCRIPTION(('Lh037: !COMPANY_INFO vendor header before FILE_DESCRIPTION'),'2;1');
FILE_NAME('Lh037.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
!INTERNAL_ROUTING_TAG('dept=CAD','priority=low');
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('vendor-header-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
