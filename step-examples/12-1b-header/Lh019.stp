ISO-10303-21;
/* Lh019: FILE_SCHEMA claims IFC4 but DATA contains IFC2X3_PROJECT from IFC2X3 */
/* DEFECT: schema mismatch — FILE_SCHEMA declares IFC4, entity belongs to IFC2X3 */
/* Conforming kernel must reject with diagnostic naming offending entity vs schema */
/* OCC silently accepts (no diagnostic, empty result) — catalog forbids silent acceptance */
HEADER;
FILE_DESCRIPTION(('Lh019: FILE_SCHEMA IFC4 but DATA uses IFC2X3_PROJECT'),'2;1');
FILE_NAME('Lh019.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
/* DEFECT: declares IFC4 but DATA below uses IFC2X3 entity types */
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* DEFECT: IFC2X3_PROJECT belongs to IFC2X3, not IFC4 as declared in FILE_SCHEMA */
#1=IFC2X3_PROJECT('2TH4j2P0X0JvdGnNH$MHRS',$,'Lh019 schema mismatch project',$,$,(#2),$);
#2=GEOMETRIC_CURVE_SET('schema-mismatch-shape',());
ENDSEC;
END-ISO-10303-21;
