ISO-10303-21;
/* Lh048 - STEP reader cannot consume non-seekable stream
 * The file content is well-formed; the catalog defect is that the reader's
 * public API requires a filesystem path and offers no std::istream entry point. */
HEADER;
FILE_DESCRIPTION(('Lh048 - reader API requires filesystem path; no in-memory stream entry'),'2;1');
FILE_NAME('Lh048.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
