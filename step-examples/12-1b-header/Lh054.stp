ISO-10303-21;
/* Lh054: FILE_NAME.preprocessor_version 'I-DEAS Master Series 11' engages the preprocessor-substring auto-detect, PLUS the I-DEAS closing topology in its ONLY workable encoding: a unit cube whose bottom and 4 sides form 'main_open_shell' (5 faces, genuinely open) and whose lid forms 'closing_shell' (1 face) built on FOUR NEW EDGE_CURVE entities whose names 'e_lid_1'..'e_lid_4' duplicate the main shell's own top-edge names -- distinct records matched by name, the real I-DEAS authoring shape, and the only encoding that reaches the non-manifold-edge registration that the pure-non-manifold-shell test requires (reusing the SAME EDGE_CURVE entities, as Lh053 does, short-circuits earlier and registers nothing). A second unrelated representation item, 'second_item_model', is present because a single-item representation makes the reader bind the pre-merge per-item shape and discard the merged compound. Both shells ARE items of the shape representation via SHELL_BASED_SURFACE_MODEL; never orphaned */
HEADER;
FILE_DESCRIPTION(('Lh054'),'2;1');
FILE_NAME('Lh054.stp','2026-06-17T00:00:00',(''),(''),'I-DEAS Master Series 11','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
