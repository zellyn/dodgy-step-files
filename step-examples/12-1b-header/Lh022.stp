ISO-10303-21;
/* Lh022: duplicate instance ID — #4=PRODUCT defined twice in one DATA section */
/* DEFECT: ISO 10303-21 requires each #N to appear at most once as LHS in DATA */
/* Produced by concatenating two STEP files without renumbering IDs */
/* OCC: silently accepts (last-write-wins); catalog forbids silent overwrite */
HEADER;
FILE_DESCRIPTION(('Lh022: duplicate instance ID #4 defined twice in DATA'),'2;1');
FILE_NAME('Lh022.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=PRODUCT_DEFINITION_CONTEXT('part definition',#5,'design');
/* DEFECT: first definition of #4 */
#4=PRODUCT('widget-a','Widget A','',(#3));
#5=APPLICATION_CONTEXT('automotive design');
/* DEFECT: second definition of #4 — same ID reused, violates ISO 10303-21 */
#4=PRODUCT('widget-b','Widget B','',(#3));
#6=GEOMETRIC_CURVE_SET('duplicate-id-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
