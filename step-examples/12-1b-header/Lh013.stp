ISO-10303-21;
/* Lh013: FILE_NAME timestamp sourced from system clock (non-deterministic) */
/* ISO 10303-21 §8: timestamp should be user-supplied for reproducible builds */
/* DEFECT: '2024-08-15T09:23:47' was written by the system clock at export time */
/* Each export of the same geometry produces a different file hash */
/* Breaks: AUR packaging, CI artefact comparison, LibrePCB content hashes */
/* Produced by: build123d export_step, CadQuery (#1396) without explicit timestamp */
HEADER;
FILE_DESCRIPTION(('Lh013: non-deterministic build-time timestamp in FILE_NAME'),'2;1');
/* DEFECT: timestamp below was taken from the system clock, not a user parameter */
FILE_NAME('Lh013.stp','2024-08-15T09:23:47',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('nondeterministic-timestamp-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
