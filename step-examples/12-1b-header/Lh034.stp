ISO-10303-21;
/* Lh034: REFERENCE section with unresolvable external anchors */
/* ISO 10303-21 Ed.3: REFERENCE entry must resolve against a companion ANCHOR section */
/* DEFECT: companion-file.stp does not exist; missing_anchor name is misspelt */
/* DEFECT: https://example.invalid/no-such-file.stp is not reachable */
/* pure-Python validator rejects (E_UNRESOLVED_REFS); OCC silently accepts empty */
HEADER;
FILE_DESCRIPTION(('Lh034: REFERENCE section with unresolvable external anchors'),'2;1');
FILE_NAME('Lh034.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
REFERENCE;
/* DEFECT: companion-file.stp does not exist; #missing_anchor is not published */
#10=<file:companion-file.stp#missing_anchor>;
/* DEFECT: example.invalid URI is unresolvable; also_missing anchor absent */
#11=<https://example.invalid/no-such-file.stp#also_missing>;
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('broken-crossfile-link-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
