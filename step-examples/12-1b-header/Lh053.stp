/* Front face (y=0) */
#80=AXIS2_PLACEMENT_3D('',#1,#70,#67);
#81=PLANE('',#80);
#82=ORIENTED_EDGE('',$,$,#20,.T.);
#83=ORIENTED_EDGE('',$,$,#40,.T.);
#84=ORIENTED_EDGE('',$,$,#52,.F.);
#85=ORIENTED_EDGE('',$,$,#36,.F.);
#86=EDGE_LOOP('',(#82,#83,#84,#85));
#87=FACE_OUTER_BOUND('',#86,.T.);
#88=ADVANCED_FACE('front',(#87),#81,.T.);
/* Right face (x=1) */
#89=AXIS2_PLACEMENT_3D('',#2,#67,#69);
#90=PLANE('',#89);
#91=ORIENTED_EDGE('',$,$,#24,.T.);
#92=ORIENTED_EDGE('',$,$,#44,.T.);
#93=ORIENTED_EDGE('',$,$,#56,.F.);
#94=ORIENTED_EDGE('',$,$,#40,.F.);
#95=EDGE_LOOP('',(#91,#92,#93,#94));
#96=FACE_OUTER_BOUND('',#95,.T.);
#97=ADVANCED_FACE('right',(#96),#90,.T.);
/* Back face (y=1) */
#98=AXIS2_PLACEMENT_3D('',#3,#69,#68);
#99=PLANE('',#98);
#100=ORIENTED_EDGE('',$,$,#28,.T.);
#101=ORIENTED_EDGE('',$,$,#48,.T.);
#102=ORIENTED_EDGE('',$,$,#60,.F.);
#103=ORIENTED_EDGE('',$,$,#44,.F.);
#104=EDGE_LOOP('',(#100,#101,#102,#103));
#105=FACE_OUTER_BOUND('',#104,.T.);
#106=ADVANCED_FACE('back',(#105),#99,.T.);
/* Left face (x=0) */
#107=AXIS2_PLACEMENT_3D('',#4,#68,#70);
#108=PLANE('',#107);
#109=ORIENTED_EDGE('',$,$,#32,.T.);
#110=ORIENTED_EDGE('',$,$,#36,.T.);
#111=ORIENTED_EDGE('',$,$,#64,.F.);
#112=ORIENTED_EDGE('',$,$,#48,.F.);
#113=EDGE_LOOP('',(#109,#110,#111,#112));
#114=FACE_OUTER_BOUND('',#113,.T.);
#115=ADVANCED_FACE('left',(#114),#108,.T.);
/* Main shell: bottom + 4 sides -- OPEN (missing the top face) */
#125=OPEN_SHELL('main_open_shell',(#79,#88,#97,#106,#115));
/* Top (closing) face -- reuses the SAME e_top1..4_shared EDGE_CURVE entities already used */
/* by the 4 side faces above; genuine cross-shell entity sharing, not duplicated geometry */
#116=AXIS2_PLACEMENT_3D('',#5,#65,#67);
#117=PLANE('',#116);
#118=ORIENTED_EDGE('',$,$,#52,.T.);
#119=ORIENTED_EDGE('',$,$,#56,.T.);
#120=ORIENTED_EDGE('',$,$,#60,.T.);
#121=ORIENTED_EDGE('',$,$,#64,.T.);
#122=EDGE_LOOP('',(#118,#119,#120,#121));
#123=FACE_OUTER_BOUND('',#122,.T.);
#124=ADVANCED_FACE('top_closing',(#123),#117,.T.);
#126=OPEN_SHELL('closing_shell',(#124));
#127=SHELL_BASED_SURFACE_MODEL('ideas_shells',(#125,#126));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Lh053','Lh053','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#127),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
