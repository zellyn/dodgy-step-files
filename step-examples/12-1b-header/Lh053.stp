#18=VECTOR('',#17,1.0);
#19=LINE('',#1,#18);
#20=EDGE_CURVE('e_bottom1',#9,#10,#19,.T.);
#21=DIRECTION('',(0.0,1.0,0.0));
#22=VECTOR('',#21,1.0);
#23=LINE('',#2,#22);
#24=EDGE_CURVE('e_bottom2',#10,#11,#23,.T.);
#25=DIRECTION('',(-1.0,0.0,0.0));
#26=VECTOR('',#25,1.0);
#27=LINE('',#3,#26);
#28=EDGE_CURVE('e_bottom3',#11,#12,#27,.T.);
#29=DIRECTION('',(0.0,-1.0,0.0));
#30=VECTOR('',#29,1.0);
#31=LINE('',#4,#30);
#32=EDGE_CURVE('e_bottom4',#12,#9,#31,.T.);
#33=DIRECTION('',(0.0,0.0,1.0));
#34=VECTOR('',#33,1.0);
#35=LINE('',#1,#34);
#36=EDGE_CURVE('e_vert1',#9,#13,#35,.T.);
#37=DIRECTION('',(0.0,0.0,1.0));
#38=VECTOR('',#37,1.0);
#39=LINE('',#2,#38);
#40=EDGE_CURVE('e_vert2',#10,#14,#39,.T.);
#41=DIRECTION('',(0.0,0.0,1.0));
#42=VECTOR('',#41,1.0);
#43=LINE('',#3,#42);
#44=EDGE_CURVE('e_vert3',#11,#15,#43,.T.);
#45=DIRECTION('',(0.0,0.0,1.0));
#46=VECTOR('',#45,1.0);
#47=LINE('',#4,#46);
#48=EDGE_CURVE('e_vert4',#12,#16,#47,.T.);
/* DEFECT: these 4 top-square edges are the SAME EDGE_CURVE entities reused by BOTH the 4 */
/* side faces' top boundary (main shell) AND the closing shell's single top face below */
#49=DIRECTION('',(1.0,0.0,0.0));
#50=VECTOR('',#49,1.0);
#51=LINE('',#5,#50);
#52=EDGE_CURVE('e_top1_shared',#13,#14,#51,.T.);
#53=DIRECTION('',(0.0,1.0,0.0));
#54=VECTOR('',#53,1.0);
#55=LINE('',#6,#54);
#56=EDGE_CURVE('e_top2_shared',#14,#15,#55,.T.);
#57=DIRECTION('',(-1.0,0.0,0.0));
#58=VECTOR('',#57,1.0);
#59=LINE('',#7,#58);
#60=EDGE_CURVE('e_top3_shared',#15,#16,#59,.T.);
#61=DIRECTION('',(0.0,-1.0,0.0));
#62=VECTOR('',#61,1.0);
#63=LINE('',#8,#62);
#64=EDGE_CURVE('e_top4_shared',#16,#13,#63,.T.);
#65=DIRECTION('',(0.0,0.0,1.0));
#66=DIRECTION('',(0.0,0.0,-1.0));
#67=DIRECTION('',(1.0,0.0,0.0));
#68=DIRECTION('',(-1.0,0.0,0.0));
#69=DIRECTION('',(0.0,1.0,0.0));
#70=DIRECTION('',(0.0,-1.0,0.0));
/* Bottom face (normal -Z) */
#71=AXIS2_PLACEMENT_3D('',#1,#66,#67);
#72=PLANE('',#71);
#73=ORIENTED_EDGE('',$,$,#20,.F.);
#74=ORIENTED_EDGE('',$,$,#32,.T.);
#75=ORIENTED_EDGE('',$,$,#28,.F.);
#76=ORIENTED_EDGE('',$,$,#24,.F.);
#77=EDGE_LOOP('',(#73,#74,#75,#76));
#78=FACE_OUTER_BOUND('',#77,.T.);
