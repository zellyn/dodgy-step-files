ISO-10303-21;
/* Lh053: FILE_NAME preprocessor_version contains 'I-DEAS', PLUS real open-shell + */
/* adjacent, genuinely edge-sharing closing-shell topology (not Lh031's header-only probe) */
/* DEFECT: computeIDEASClosings/closeIDEASShell (opt-in via read.step.nonmanifold) would */
/* merge the closing shell's face into the open shell and prune it if redundant; under */
/* this corpus's default oracle settings the two shells load verbatim, unmerged */
HEADER;
FILE_DESCRIPTION(('Lh053: I-DEAS header trigger with real open+closing shell topology'),'2;1');
FILE_NAME('Lh053.stp','2026-07-12T00:00:00',(''),(''),'I-DEAS Master Series 11','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=CARTESIAN_POINT('',(1.0,0.0,0.0));
#3=CARTESIAN_POINT('',(1.0,1.0,0.0));
#4=CARTESIAN_POINT('',(0.0,1.0,0.0));
