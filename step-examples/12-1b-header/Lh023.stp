ISO-10303-21;
/* Lh023: whitespace between # and instance-ID digits */
/* ISO 10303-21 §5.6: #NNN is a single token — no spaces allowed inside */
/* DEFECT: '# 12 = CARTESIAN_POINT(..)' has a space between # and 12 */
/* stepcode: tolerates space silently; IfcOpenShell: rejects; OCC: empty result */
HEADER;
FILE_DESCRIPTION(('Lh023: whitespace between # and instance ID digits'),'2;1');
FILE_NAME('Lh023.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
/* DEFECT: space between # and 12 — non-conformant per ISO 10303-21 §5.6 */
# 12=CARTESIAN_POINT('defect-space-in-id',(0.5,0.5,0.));
#5=GEOMETRIC_CURVE_SET('whitespace-in-id-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
