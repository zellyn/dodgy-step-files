/* Lh023 — Whitespace, tab, or comment between # and digits of an
 * instance ID.  #NNN is a single token per ISO 10303-21 §5.6;
 * whitespace inside it is non-conformant. This file mixes three
 * variants on three different defining lines:
 *   line A: hash-space-digits  (space between # and digits)
 *   line B: hash-PartComment-digits  (a Part-21 comment then digits)
 *   line C: hash-digit-tab-digit  (a tab between digits — tolerant
 *           readers that treat tab as separator silently merge the
 *           digits, e.g. into a different #14)
 * Strict parsers must reject all three. The geometry references
 * the offending IDs with the *original* spelling, so silent
 * digit-merge gives a semantically different graph. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('Lh023.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT('Lh023-part','Lh023 demo','',(#3));
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
# 12 = DIRECTION('x',(1.0,0.0,0.0));
# /* note */ 13 = AXIS2_PLACEMENT_3D('placement',#10,#11,# 12);
#1	4 = CARTESIAN_POINT('also-origin',(0.0,0.0,0.0));
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#21=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#22=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#23=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#20,
  'distance_accuracy_value','');
#24=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#23))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#21,#22))
  REPRESENTATION_CONTEXT('Lh023','3D'));
ENDSEC;
END-ISO-10303-21;
