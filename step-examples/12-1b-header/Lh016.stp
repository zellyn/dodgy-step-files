ISO-10303-21;
/* Lh016: Edition-3 extra header entities beyond the required three */
/* ISO 10303-21 Ed.3: FILE_POPULATION, SECTION_LANGUAGE, FILE_INFO are permitted */
/* Strict Ed.1/2 readers reject any header entity beyond the canonical three */
/* DEFECT: FILE_INFO and FILE_POPULATION appear after FILE_SCHEMA */
