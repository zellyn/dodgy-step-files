ISO-10303-21;
/* Lh035: ANCHOR section with duplicate anchor name <origin> */
/* ISO 10303-21 Ed.3: ANCHOR maps anchor-name to instance handle */
/* DEFECT: <origin> is published twice — once for #10, once for #11 */
/* strict receiver must reject; lenient receiver must document first-wins/last-wins */
/* OCC silently accepts with diagnostic but loads empty result */
HEADER;
FILE_DESCRIPTION(('Lh035: ANCHOR section with duplicate anchor name origin'),'2;1');
FILE_NAME('Lh035.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
ANCHOR;
/* DEFECT: <origin> appears twice — maps to two different instances */
<origin>=#10;
<origin>=#11;
<corner>=#12;
ENDSEC;
DATA;
#10=CARTESIAN_POINT('origin-a',(0.,0.,0.));
#11=CARTESIAN_POINT('origin-b',(0.5,0.,0.));
#12=CARTESIAN_POINT('corner',(1.,1.,0.));
#13=DIRECTION('xdir',(1.,0.,0.));
#14=DIRECTION('zdir',(0.,0.,1.));
#15=GEOMETRIC_CURVE_SET('duplicate-anchor-shape',(#10,#12));
ENDSEC;
END-ISO-10303-21;
