ISO-10303-21;
/* Lh035 - ANCHOR section publishing the same anchor name twice
 * Defect: ISO 10303-21 Edition 3 ANCHOR sections publish a mapping
 * from anchor-name (a string) to instance handle. The spec is silent
 * on whether duplicate names are permitted; a strict implementation
 * rejects, a lenient one takes first-wins or last-wins (divergent).
 * A REFERENCE section in another file pointing at the duplicated
 * anchor name resolves nondeterministically. */
HEADER;
FILE_DESCRIPTION(('Lh035 - ANCHOR section duplicate anchor name'),'2;1');
FILE_NAME('Lh035.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
ANCHOR;
/* Defect: anchor name 'origin' published twice for two different
 * instances - which one wins on cross-file resolution? */
<origin>=#10;
<origin>=#11;
ENDSEC;
DATA;
#10=CARTESIAN_POINT('first-origin',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('second-origin',(1.0,1.0,1.0));
#20=DIRECTION('z',(0.0,0.0,1.0));
#21=DIRECTION('x',(1.0,0.0,0.0));
#22=AXIS2_PLACEMENT_3D('placement',#10,#20,#21);
ENDSEC;
END-ISO-10303-21;
