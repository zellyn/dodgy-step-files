ISO-10303-21;
/* Lh006: FILE_SCHEMA argument is a bare string, not a list-of-string */
/* ISO 10303-21 §8: FILE_SCHEMA requires LIST OF STRING: FILE_SCHEMA(('NAME')); */
/* DEFECT: FILE_SCHEMA('AUTOMOTIVE_DESIGN'); — outer list parens are missing */
/* Strict parsers reject; lenient parsers may auto-promote to a singleton list */
HEADER;
FILE_DESCRIPTION(('Lh006: FILE_SCHEMA without double parentheses'),'2;1');
FILE_NAME('Lh006.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
/* DEFECT: bare string instead of list — missing outer parentheses around schema name */
FILE_SCHEMA('AUTOMOTIVE_DESIGN');
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('file-schema-no-double-parens-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
