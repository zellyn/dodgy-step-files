/* Lh004 — HEADER missing one of the three required entities
 * Defect: FILE_SCHEMA omitted from HEADER. ISO 10303-21 mandates
 * exactly one each of FILE_DESCRIPTION, FILE_NAME, FILE_SCHEMA, in
 * that order. Strict parsers must reject with "missing required
 * header entity FILE_SCHEMA" rather than null-deref the schema
 * pointer. The DATA section is otherwise valid AUTOMOTIVE_DESIGN
 * content to confirm that downstream entity resolution would have
 * succeeded if the header were complete. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('Lh004.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
ENDSEC;
