ISO-10303-21;
/* Lh041: REFERENCE section with mixed URI schemes including unsupported ones */
/* ISO 10303-21 Ed.3 §8: REFERENCE entries carry URIs; spec does not constrain scheme */
/* DEFECT: urn: and plmlink: schemes are typically unsupported by receivers */
/* pure-Python validator rejects (E_UNRESOLVED_REFS); OCC silently accepts empty */
/* expected: classify each URI scheme; report unsupported entries deterministically */
HEADER;
FILE_DESCRIPTION(('Lh041: REFERENCE section with mixed URI schemes'),'2;1');
FILE_NAME('Lh041.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
REFERENCE;
/* supported scheme: file: */
#10=<file:companion.stp#part_a>;
/* supported scheme: https: */
#11=<https://example.invalid/companion.stp#part_b>;
/* DEFECT: unsupported scheme urn: */
#12=<urn:plm:org-acme:doc:12345#assembly>;
/* DEFECT: unsupported custom scheme plmlink: */
#13=<plmlink:vault://acme/parts/12345#main>;
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner',(1.,1.,0.));
#3=DIRECTION('xdir',(1.,0.,0.));
#4=DIRECTION('zdir',(0.,0.,1.));
#5=GEOMETRIC_CURVE_SET('mixed-uri-scheme-shape',(#1,#2));
ENDSEC;
END-ISO-10303-21;
