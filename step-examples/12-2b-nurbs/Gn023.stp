ISO-10303-21;
/* Gn023 - STEP->BREP silently injects new B-spline curves (cylinder edges replaced)
   Defect: after STEP->BREP via OCC BRepTools write, B-spline curves
   appear in the BRep that were never in the source -- the analytic
   cylinder edges have been replaced with NURBS approximations.  The
   producer's intent was a CYLINDRICAL_SURFACE bounded by CIRCLE edges;
   the reader / serializer dropped the analytic curve types.
   This file shows the source side that should be preserved: a
   CYLINDRICAL_SURFACE with two CIRCLE seam-and-cap edges (analytic), so
   that any kernel can verify the read should NOT inject NURBS. */
HEADER;
FILE_DESCRIPTION(
  ('Gn023 - cylinder with analytic CIRCLE edges, must not be NURBS-ified'),
  '2;1');
FILE_NAME('Gn023.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Cylinder, R=10, axis +z, height 50. */
#10=CARTESIAN_POINT('cyl_o',(0.0,0.0,0.0));
#11=DIRECTION('cyl_z',(0.0,0.0,1.0));
#12=DIRECTION('cyl_x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('cyl_pl',#10,#11,#12);
#20=CYLINDRICAL_SURFACE('cyl',#13,10.0);
/* Bottom cap circle plane (z=0). */
#30=CARTESIAN_POINT('bot_o',(0.0,0.0,0.0));
#31=AXIS2_PLACEMENT_3D('bot_pl',#30,#11,#12);
#40=CIRCLE('bot_circle',#31,10.0);
/* Top cap circle plane (z=50). */
#50=CARTESIAN_POINT('top_o',(0.0,0.0,50.0));
#51=AXIS2_PLACEMENT_3D('top_pl',#50,#11,#12);
#60=CIRCLE('top_circle',#51,10.0);
/* Edge curves: must remain CIRCLE on read-back, not be replaced by
   B_SPLINE_CURVE_WITH_KNOTS approximations. */
#70=VERTEX_POINT('vb',#30);
#71=VERTEX_POINT('vt',#50);
#80=EDGE_CURVE('bot_edge',#70,#70,#40,.T.);
#81=EDGE_CURVE('top_edge',#71,#71,#60,.T.);
/* PRODUCT chain so OCCT loads the geometry. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn023','Gn023','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#80,#81));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
