/* Gn099 - ShapeAnalysis_Curve.GetSamplePoints conic-arc rational-weight cap
   Defect: CONIC_CURVE (circular arc) with rational weights. GetSamplePoints
   uses degree-3 sample count for degree-2 conic, but conic-arc weight
   distribution requires denser sampling near the arc's rational poles.
   Sparse sampling misses curvature extrema. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Gn099 - Conic arc rational-weight sparse sampling'),'2;1');
FILE_NAME('Gn099.stp','2026-06-15T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Degree-2 rational B-spline representing a 90-degree circular arc
   Control points: (1,0), (1,1), (0,1) with weights 1, sqrt(2)/2, 1
   This forces curvature concentration near the weight pole at t=0.5 */
#10=CARTESIAN_POINT('p0',(1.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(1.0,1.0,0.0));
#12=CARTESIAN_POINT('p2',(0.0,1.0,0.0));
/* Rational weights: 1.0 at endpoints, ~0.707 at middle (weight pole). */
#100=B_SPLINE_CURVE_WITH_KNOTS('rational_arc',2,
  ((#10,#11,#12)),
  .UNSPECIFIED.,.F.,.F.,
  (3,3),
  (0.0,1.0),
  .UNSPECIFIED.);
/* Annotate with rational weights via CURVE entity wrapper. */
#101=CURVE('rational_conic_arc',#100);
/* PRODUCT chain. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn099','Gn099','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#101));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
