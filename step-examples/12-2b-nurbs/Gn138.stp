ISO-10303-21;
/* Gn138: B-SPLINE_SURFACE_WITH_KNOTS trimmed surface Bezier conversion
   Defect: Surface with 5x4 grid. Degree 2/2. ConvertSurfaceToBezierBasis
   delegates recursive conversion to basis surface if input is trimmed.
   Missing validation of trimmed surface bounds propagation causes
   mismatch between parameter domains in recursive call. */
HEADER;
FILE_DESCRIPTION(('Gn138: NURBS trimmed surface Bezier basis delegation'),'2;1');
FILE_NAME('Gn138.stp','2026-06-16T00:00:00',('auto'),(''),
  'auto','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#10=CARTESIAN_POINT('p00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p01',(0.0,1.0,0.0));
#12=CARTESIAN_POINT('p02',(0.0,2.0,0.0));
#13=CARTESIAN_POINT('p03',(0.0,3.0,0.0));
#20=CARTESIAN_POINT('p10',(1.0,0.0,0.3));
#21=CARTESIAN_POINT('p11',(1.0,1.0,0.5));
#22=CARTESIAN_POINT('p12',(1.0,2.0,0.5));
#23=CARTESIAN_POINT('p13',(1.0,3.0,0.3));
#30=CARTESIAN_POINT('p20',(2.0,0.0,0.4));
#31=CARTESIAN_POINT('p21',(2.0,1.0,0.6));
#32=CARTESIAN_POINT('p22',(2.0,2.0,0.6));
#33=CARTESIAN_POINT('p23',(2.0,3.0,0.4));
#40=CARTESIAN_POINT('p30',(3.0,0.0,0.3));
#41=CARTESIAN_POINT('p31',(3.0,1.0,0.5));
#42=CARTESIAN_POINT('p42',(3.0,2.0,0.5));
#43=CARTESIAN_POINT('p43',(3.0,3.0,0.3));
#50=CARTESIAN_POINT('p40',(4.0,0.0,0.0));
#51=CARTESIAN_POINT('p41',(4.0,1.0,0.0));
#52=CARTESIAN_POINT('p42',(4.0,2.0,0.0));
#53=CARTESIAN_POINT('p43',(4.0,3.0,0.0));
/* 5x4 grid, degree 2 u, degree 2 v
   U: 5 poles, degree 2 => 5+2+1=8 knot multiplicities => (3,1,1,3)
   V: 4 poles, degree 2 => 4+2+1=7 knot multiplicities => (3,1,3) */
#100=B_SPLINE_SURFACE_WITH_KNOTS('trimmed_basis_mismatch',2,2,
  ((#10,#11,#12,#13),(#20,#21,#22,#23),(#30,#31,#32,#33),(#40,#41,#42,#43),(#50,#51,#52,#53)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (3,1,1,3),
  (3,1,3),
  (0.0,0.333,0.667,1.0),
  (0.0,0.5,1.0),
  .UNSPECIFIED.);
#101=SURFACE('',#100);
#102=REPRESENTATION_ITEM('',#101);
#110=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#111=DIRECTION('dir',(1.0,0.0,0.0));
#112=VECTOR('vec',#111,1.0);
#113=LINE('ref_axis',#110,#112);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn138','Gn138','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('curve_set',(#113));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
