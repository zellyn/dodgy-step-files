ISO-10303-21;
/* Gn041 - ShapeAnalysis_Surface.NextValueOfUV C0-discontinuity at knot
   Defect: a B_SPLINE_SURFACE_WITH_KNOTS with a C0 continuity discontinuity
   (multiplicity = degree) at an interior U-knot causes Newton iteration in
   NextValueOfUV() to converge to the wrong-side solution. The iterator
   lacks checks for C0 knots and uses derivatives that are invalid at the
   discontinuity, leading to incorrect projected points. */
HEADER;
FILE_DESCRIPTION(('Gn041 - BSpline surface C0 knot Newton divergence','2;1');
FILE_NAME('Gn041.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Two cubic Bezier patches joined at U=0.5 with C0 discontinuity
   (different Z-heights on each side). 4x4 control net per patch. */
#10=CARTESIAN_POINT('a00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('a01',(0.0,1.0,0.0));
#12=CARTESIAN_POINT('a02',(0.0,2.0,0.0));
#13=CARTESIAN_POINT('a03',(0.0,3.0,0.0));
#20=CARTESIAN_POINT('a10',(0.25,0.0,0.0));
#21=CARTESIAN_POINT('a11',(0.25,1.0,0.5));
#22=CARTESIAN_POINT('a12',(0.25,2.0,0.5));
#23=CARTESIAN_POINT('a13',(0.25,3.0,0.0));
#30=CARTESIAN_POINT('a20',(0.5,0.0,0.0));
#31=CARTESIAN_POINT('a21',(0.5,1.0,0.5));
#32=CARTESIAN_POINT('a22',(0.5,2.0,0.5));
#33=CARTESIAN_POINT('a23',(0.5,3.0,0.0));
/* Left patch row 3 (closer to C0 knot). */
#40=CARTESIAN_POINT('a30',(0.75,0.0,0.0));
#41=CARTESIAN_POINT('a31',(0.75,1.0,0.3));
#42=CARTESIAN_POINT('a32',(0.75,2.0,0.3));
#43=CARTESIAN_POINT('a33',(0.75,3.0,0.0));
/* Right patch row 0 (after C0 knot at U=0.5, Z jumps to 1.5). */
#50=CARTESIAN_POINT('b00',(0.75,0.0,1.5));
#51=CARTESIAN_POINT('b01',(0.75,1.0,1.5));
#52=CARTESIAN_POINT('b02',(0.75,2.0,1.5));
#53=CARTESIAN_POINT('b03',(0.75,3.0,1.5));
#60=CARTESIAN_POINT('b10',(1.0,0.0,1.5));
#61=CARTESIAN_POINT('b11',(1.0,1.0,2.0));
#62=CARTESIAN_POINT('b12',(1.0,2.0,2.0));
#63=CARTESIAN_POINT('b13',(1.0,3.0,1.5));
#70=CARTESIAN_POINT('b20',(1.25,0.0,1.5));
#71=CARTESIAN_POINT('b21',(1.25,1.0,2.0));
#72=CARTESIAN_POINT('b22',(1.25,2.0,2.0));
#73=CARTESIAN_POINT('b23',(1.25,3.0,1.5));
#80=CARTESIAN_POINT('b30',(1.5,0.0,1.5));
#81=CARTESIAN_POINT('b31',(1.5,1.0,1.5));
#82=CARTESIAN_POINT('b32',(1.5,2.0,1.5));
#83=CARTESIAN_POINT('b33',(1.5,3.0,1.5));
/* Defect: U knot multiplicity at 0.5 equals degree (3) -> C0 discontinuity.
   V direction is smooth (C2). U multiplicities: 4,3,4 (interior mult=degree).
   This creates a sharp kink in the U-direction at U=0.5. */
#100=B_SPLINE_SURFACE_WITH_KNOTS('c0_u_knot',3,3,
  ((#10,#11,#12,#13),(#20,#21,#22,#23),(#30,#31,#32,#33),(#40,#41,#42,#43),
   (#50,#51,#52,#53),(#60,#61,#62,#63),(#70,#71,#72,#73),(#80,#81,#82,#83)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (4,3,4),
  (4,1,1,4),
  (0.0,0.5,1.0),
  (0.0,0.33,0.67,1.0),
  .UNSPECIFIED.);
/* PRODUCT chain wrapping surface. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn041','Gn041','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#100),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
