/* Gn097 - ShapeUpgrade_SplitSurface.Init duplicate-split-values
   Defect: call Init with duplicate split parameters [0.5, 0.5, 0.5]; dedup
   logic doesn't fully collapse leaving phantom splits. The surface is split
   at the same parameter value multiple times, and the deduplication logic
   fails to fully remove redundant split locations. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Gn097 - SplitSurface.Init duplicate split values'),'2;1');
FILE_NAME('Gn097.stp','2026-06-15T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Simple 3x3 control net, degree (2,2) patch. */
#10=CARTESIAN_POINT('p00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p01',(0.0,1.0,0.0));
#12=CARTESIAN_POINT('p02',(0.0,2.0,0.0));
#20=CARTESIAN_POINT('p10',(1.0,0.0,0.0));
#21=CARTESIAN_POINT('p11',(1.0,1.0,0.5));
#22=CARTESIAN_POINT('p12',(1.0,2.0,0.0));
#30=CARTESIAN_POINT('p20',(2.0,0.0,0.0));
#31=CARTESIAN_POINT('p21',(2.0,1.0,0.0));
#32=CARTESIAN_POINT('p22',(2.0,2.0,0.0));
/* Degree (2,2) surface. Knot vectors have interior knot at 0.5 on both axes.
   Nominal: would split at U=0.5 and V=0.5 once each.
   Defect: if Init is called with [0.5, 0.5, 0.5], dedup should collapse to [0.5]
   but may leave phantom splits in internal data structures. */
#100=B_SPLINE_SURFACE_WITH_KNOTS('dup_split_surface',
  2,2,
  ((#10,#11,#12),(#20,#21,#22),(#30,#31,#32)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (3,1,3),
  (3,1,3),
  (0.0,0.5,1.0),
  (0.0,0.5,1.0),
  .UNSPECIFIED.);
/* PRODUCT chain. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn097','Gn097','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_SURFACE_SET('surf_set',(#100));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
