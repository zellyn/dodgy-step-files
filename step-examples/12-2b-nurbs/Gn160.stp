ISO-10303-21;
/* Gn160 - Periodic B-spline curve with parameter wrapping issue.
   Defect: Closed curve with period=1.0; projection parameter may exceed
   curve definition range after wrapping. Falsifiable: theProjParam after
   wrapping in periodic NURBS must be validated against [uMin, uMax]. */
HEADER;
FILE_DESCRIPTION(('Gn160 - Periodic B-spline curve, parameter wrapping'),'2;1');
FILE_NAME('Gn160.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 5 poles, degree 2, periodic (closed)
   Period = 1.0; knot vector: (0, 0, 0, 0.333, 0.667, 1.0, 1.0, 1.0) */
#10=CARTESIAN_POINT('p0',(1.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(0.707,0.707,0.0));
#12=CARTESIAN_POINT('p2',(0.0,1.0,0.0));
#13=CARTESIAN_POINT('p3',(-0.707,0.707,0.0));
#14=CARTESIAN_POINT('p4',(-1.0,0.0,0.0));
/* 5 poles, degree 2 => sum(mult) = 5+2+1 = 8
   For periodic: omit one pole from knot vector (implicit repeat)
   Multiplicities: (3, 1, 1, 1, 1, 1) => sum=8. Hmm, that's 6 knot values.
   Periodic with 5 poles, degree 2: knot count = 5+2 = 7 (wraps)
   Let me recalculate: for periodic, sum(mult) = n+d = 5+2 = 7
   Multiplicities: (2, 1, 1, 1, 2) => sum=7 (5 distinct values) */
#100=B_SPLINE_CURVE_WITH_KNOTS('periodic_closed',2,
  (#10,#11,#12,#13,#14),
  .UNSPECIFIED.,.F.,.T.,
  (2,1,1,1,2),
  (0.0,0.0,0.333,0.667,1.0,1.0,1.333),
  .UNSPECIFIED.);
#110=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#111=DIRECTION('zdir',(0.0,0.0,1.0));
#112=VECTOR('zvec',#111,1.0);
#113=LINE('ref_axis',#110,#112);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn160','Gn160','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('curve_set',(#100,#113));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
