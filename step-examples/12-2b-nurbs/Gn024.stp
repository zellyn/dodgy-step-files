/* Gn024 - Self-intersecting curve geometry on BSpline edge (figure-eight or fold)
   Defect: a 3D B_SPLINE_CURVE_WITH_KNOTS of degree 3 has a control
   polygon producing a figure-eight inside its parameter range.
   Common output of poorly-trimmed offset surfaces or translator
   re-fitting.  The healer should re-fit / sub-set or reject; never use
   such a curve for projection without first checking parameter
   monotonicity under reprojection.
   Control polygon: (0,0,0) -> (4,0,0) -> (0,3,0) -> (4,3,0) -> (0,0,0)
   -- this crosses itself between parameters 0.25 and 0.75. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(
  ('Gn024 - self-intersecting BSpline curve (figure-eight control polygon)'),
  '2;1');
FILE_NAME('Gn024.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Five-pole figure-eight control polygon. */
#10=CARTESIAN_POINT('a',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('b',(4.0,0.0,0.0));
#12=CARTESIAN_POINT('c',(0.0,3.0,0.0));
#13=CARTESIAN_POINT('d',(4.0,3.0,0.0));
#14=CARTESIAN_POINT('e',(0.0,0.0,0.0));
/* Defect: degree-3 BSpline whose control polygon traces a figure-eight;
   the resulting 3D curve self-intersects within (0, 1). */
#100=B_SPLINE_CURVE_WITH_KNOTS('figure_eight',3,
  (#10,#11,#12,#13,#14),
  .UNSPECIFIED.,.F.,.F.,
  (4,1,4),
  (0.0,0.5,1.0),
  .UNSPECIFIED.);
/* Reference from an EDGE_CURVE so a downstream importer surfaces the
   defect on edge construction. */
#200=VERTEX_POINT('v_start',#10);
#201=VERTEX_POINT('v_end',#14);
#300=EDGE_CURVE('self_int_edge',#200,#201,#100,.T.);
/* PRODUCT chain so OCCT loads the geometry. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn024','Gn024','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#300));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
