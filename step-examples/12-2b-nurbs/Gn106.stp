ISO-10303-21;
/* Gn106 - B-spline-of-Bezier conversion bloat
   Defect: ShapeUpgrade_ConvertSurfaceToBezierBasis converts
   single-Bezier B-spline into multiple Bezier patches when
   direct passthrough would suffice. Input: 4x4 grid with
   all multiplicities = 1 (IS a single Bezier). */
HEADER;
FILE_DESCRIPTION(('Gn106 - B-spline-of-Bezier conversion bloat'),'2;1');
FILE_NAME('Gn106.stp','2026-06-15T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 4x4 control net for degree-3 B-spline that IS a single Bezier */
#1001=CARTESIAN_POINT('p',(0.0,0.0,0.0));
#1002=CARTESIAN_POINT('p',(1.0,0.0,1.0));
#1003=CARTESIAN_POINT('p',(2.0,0.0,1.0));
#1004=CARTESIAN_POINT('p',(3.0,0.0,0.0));
#1005=CARTESIAN_POINT('p',(0.0,1.0,1.0));
#1006=CARTESIAN_POINT('p',(1.0,1.0,2.0));
#1007=CARTESIAN_POINT('p',(2.0,1.0,2.0));
#1008=CARTESIAN_POINT('p',(3.0,1.0,1.0));
#1009=CARTESIAN_POINT('p',(0.0,2.0,1.0));
#1010=CARTESIAN_POINT('p',(1.0,2.0,2.0));
#1011=CARTESIAN_POINT('p',(2.0,2.0,2.0));
#1012=CARTESIAN_POINT('p',(3.0,2.0,1.0));
#1013=CARTESIAN_POINT('p',(0.0,3.0,0.0));
#1014=CARTESIAN_POINT('p',(1.0,3.0,1.0));
#1015=CARTESIAN_POINT('p',(2.0,3.0,1.0));
#1016=CARTESIAN_POINT('p',(3.0,3.0,0.0));

/* Degree-3 B-spline; knot multiplicities (4,1,3) sum to 8 */
#5000=B_SPLINE_SURFACE_WITH_KNOTS('bezier_bloat',
  3,3,
  ((#1001,#1002,#1003,#1004),
   (#1005,#1006,#1007,#1008),
   (#1009,#1010,#1011,#1012),
   (#1013,#1014,#1015,#1016)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (4,1,3),
  (4,1,3),
  (0.0,0.333,1.0),
  (0.0,0.333,1.0),
  .UNSPECIFIED.);

#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gn106','Gn106','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#5000),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);

ENDSEC;
