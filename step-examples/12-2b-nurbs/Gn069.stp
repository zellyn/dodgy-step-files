ISO-10303-21;
/* Gn069 - ShapeAnalysis_Curve.GetSamplePoints BSpline knot-aware sampling
   Defect: B-spline with closely-spaced interior knots (0.5, 0.51, 0.52)
   triggers over-densification in knot-aware sampler, producing hundreds of
   samples in a tiny region instead of adaptive sampling. */
HEADER;
FILE_DESCRIPTION(('Gn069 - B-spline over-dense knot sampling'',''2;1'',''2;1'),'2;1');
FILE_NAME('Gn069.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* B-spline degree 3 with 6 control points and closely-spaced interior knots
   at 0.5, 0.51, 0.52. Knot vector: (0,0,0,0, 0.5,0.51,0.52, 1,1,1,1) */
#10=CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p2',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('p3',(2.0,1.0,0.0));
#13=CARTESIAN_POINT('p4',(2.0,2.0,0.0));
#14=CARTESIAN_POINT('p5',(1.0,2.0,0.0));
#15=CARTESIAN_POINT('p6',(0.0,1.0,0.0));
/* Degree 3, 6 poles, clamped. Knot multiplicities: (4,1,1,1,4)
   Sum = 4+1+1+1+4 = 11 = 6+3+1. Closely-spaced knots trigger over-sampling. */
#100=B_SPLINE_CURVE_WITH_KNOTS('dense_knots',3,
  (#10,#11,#12,#13,#14,#15),
  .UNSPECIFIED.,.F.,.F.,
  (4,1,1,1,4),
  (0.0,0.0,0.0,0.0,0.5,0.51,0.52,1.0,1.0,1.0,1.0),
  .UNSPECIFIED.);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn069','Gn069','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#100));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
