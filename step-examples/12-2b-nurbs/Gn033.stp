/* Gn033 - Pcurve / 3D-curve large jumps on closed BSpline surface
   Defect: 2D points along a projected pcurve sometimes show a huge
   jump (>0.95 of UV range) on a closed-but-not-periodic
   B_SPLINE_SURFACE_WITH_KNOTS where 3D points are close to each other.
   The surface near-periodicity is not recognized; the pcurve crosses
   the wrap-around boundary unannounced.
   Also covers Gn005 / "undeclared periodic closed surface": the
   surface's first row of poles equals its last row (ring closure in U)
   but surface_form is .UNSPECIFIED. and u_closed = .F.  A correct
   exporter would mark the surface periodic / closed; this file does NOT.
   Sources: Mantis 0030075, OCCT b735354. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(
  ('Gn033 - closed-but-not-periodic BSpline surface with pcurve jump'),
  '2;1');
FILE_NAME('Gn033.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 5 rows in U where row 0 == row 4 in 3D position (ring closure).
   Row j is a quadratic in V from y=0 to y=2 with a slight z bump. */
/* U = 0  (row 0) -- theta = 0 */
#10=CARTESIAN_POINT('u0_v0',( 1.0, 0.0, 0.0));
#11=CARTESIAN_POINT('u0_v1',( 1.0, 1.0, 0.5));
#12=CARTESIAN_POINT('u0_v2',( 1.0, 2.0, 0.0));
/* U = 0.25 -- theta = pi/2 */
#20=CARTESIAN_POINT('u1_v0',( 0.0, 0.0, 1.0));
#21=CARTESIAN_POINT('u1_v1',( 0.0, 1.0, 1.5));
#22=CARTESIAN_POINT('u1_v2',( 0.0, 2.0, 1.0));
/* U = 0.5 -- theta = pi */
#30=CARTESIAN_POINT('u2_v0',(-1.0, 0.0, 0.0));
#31=CARTESIAN_POINT('u2_v1',(-1.0, 1.0, 0.5));
#32=CARTESIAN_POINT('u2_v2',(-1.0, 2.0, 0.0));
/* U = 0.75 -- theta = 3pi/2 */
#40=CARTESIAN_POINT('u3_v0',( 0.0, 0.0,-1.0));
#41=CARTESIAN_POINT('u3_v1',( 0.0, 1.0,-0.5));
#42=CARTESIAN_POINT('u3_v2',( 0.0, 2.0,-1.0));
/* U = 1  (row 4) -- theta = 2pi == row 0 (ring closure). */
#50=CARTESIAN_POINT('u4_v0',( 1.0, 0.0, 0.0));
#51=CARTESIAN_POINT('u4_v1',( 1.0, 1.0, 0.5));
#52=CARTESIAN_POINT('u4_v2',( 1.0, 2.0, 0.0));
/* Defect: row 0 == row 4 in 3D, but u_closed = .F. and surface_form is
   .UNSPECIFIED. -- undeclared periodic closure. */
#100=B_SPLINE_SURFACE_WITH_KNOTS('undeclared_closed',
  3,2,
  ((#10,#11,#12),(#20,#21,#22),(#30,#31,#32),(#40,#41,#42),(#50,#51,#52)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (4,1,4),(3,3),
  (0.0,0.5,1.0),(0.0,1.0),
  .UNSPECIFIED.);
/* 2D pcurve that crosses the near-period boundary: u jumps from 0.02
   to 0.98 between two adjacent samples, which is > 0.95 of the U
   range. */
#200=CARTESIAN_POINT('uv_a',(0.02,0.5));
#201=CARTESIAN_POINT('uv_b',(0.98,0.5));
#210=B_SPLINE_CURVE_WITH_KNOTS('jump_pcurve',1,(#200,#201),
  .UNSPECIFIED.,.F.,.F.,(2,2),(0.0,1.0),.UNSPECIFIED.);
#220=DEFINITIONAL_REPRESENTATION('',(#210),#230);
#230=(
  GEOMETRIC_REPRESENTATION_CONTEXT(2)
  PARAMETRIC_REPRESENTATION_CONTEXT()
  REPRESENTATION_CONTEXT('surf_param','2D'));
#240=PCURVE('jumping_pcurve',#100,#220);
ENDSEC;
END-ISO-10303-21;
