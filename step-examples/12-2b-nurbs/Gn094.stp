/* Gn094 - ShapeAnalysis_Curve.IsClosed degree-0-curve
   Defect: B-spline of degree 0 (piecewise constant); IsClosed reports false
   but the curve has no meaningful direction, so closed-vs-open is ill-defined.
   A degree-0 B-spline is piecewise constant segments. No tangent, no direction.
   IsClosed logic assumes non-zero degree and fails to handle degenerate case. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Gn094 - IsClosed on degree-0 piecewise constant curve'),'2;1');
FILE_NAME('Gn094.stp','2026-06-15T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Degree-0 B-spline: piecewise constant between 3 control points.
   Knot vector (2,1,1,2) gives 3 intervals of constant value. */
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('p2',(1.0,1.0,0.0));
/* Defect: degree-0 curve with multiplicity-2 at end knots (open).
   If endpoints equal, IsClosed would trivially return false (no direction). */
#100=B_SPLINE_CURVE_WITH_KNOTS('deg0_const',0,
  (#10,#11,#12),
  .UNSPECIFIED.,.F.,.F.,
  (2,1,1,2),
  (0.0,0.5,1.0),
  .UNSPECIFIED.);
/* PRODUCT chain. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn094','Gn094','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#100));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
