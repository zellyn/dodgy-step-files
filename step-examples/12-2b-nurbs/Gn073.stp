ISO-10303-21;
/* Gn073 - ShapeAnalysis_Curve.FillBndBox composite-curve segment switch
   Defect: COMPOSITE_CURVE with three B-spline segments where inter-segment
   maxima occur at segment transitions. FillBndBox samples each segment
   independently and misses extrema that would be caught by joint analysis. */
HEADER;
FILE_DESCRIPTION(('Gn073 - COMPOSITE_CURVE inter-segment extrema miss'',''2;1'',''2;1'),'2;1');
FILE_NAME('Gn073.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Three B-spline segments forming a COMPOSITE_CURVE.
   Each segment is degree 2, 4 poles, clamped.
   Inter-segment boundaries trigger sampling gaps. */

/* Segment 1: parabolic arc from (0,0) to (1,1) */
#10=CARTESIAN_POINT('seg1_p1',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('seg1_p2',(0.5,0.5,0.0));
#12=CARTESIAN_POINT('seg1_p3',(0.8,1.0,0.0));
#13=CARTESIAN_POINT('seg1_p4',(1.0,1.2,0.0));
#100=B_SPLINE_CURVE_WITH_KNOTS('seg1',2,
  (#10,#11,#12,#13),
  .UNSPECIFIED.,.F.,.F.,
  (3,1,3),
  (0.0,0.0,0.0,0.5,1.0,1.0,1.0),
  .UNSPECIFIED.);

/* Segment 2: parabolic arc from (1,1.2) to (2,0.8) with local max at transition */
#20=CARTESIAN_POINT('seg2_p1',(1.0,1.2,0.0));
#21=CARTESIAN_POINT('seg2_p2',(1.5,1.5,0.0));
#22=CARTESIAN_POINT('seg2_p3',(1.8,1.1,0.0));
#23=CARTESIAN_POINT('seg2_p4',(2.0,0.8,0.0));
#101=B_SPLINE_CURVE_WITH_KNOTS('seg2',2,
  (#20,#21,#22,#23),
  .UNSPECIFIED.,.F.,.F.,
  (3,1,3),
  (0.0,0.0,0.0,0.5,1.0,1.0,1.0),
  .UNSPECIFIED.);

/* Segment 3: parabolic arc from (2,0.8) to (3,0) */
#30=CARTESIAN_POINT('seg3_p1',(2.0,0.8,0.0));
#31=CARTESIAN_POINT('seg3_p2',(2.5,0.5,0.0));
#32=CARTESIAN_POINT('seg3_p3',(2.8,0.2,0.0));
#33=CARTESIAN_POINT('seg3_p4',(3.0,0.0,0.0));
#102=B_SPLINE_CURVE_WITH_KNOTS('seg3',2,
  (#30,#31,#32,#33),
  .UNSPECIFIED.,.F.,.F.,
  (3,1,3),
  (0.0,0.0,0.0,0.5,1.0,1.0,1.0),
  .UNSPECIFIED.);

/* COMPOSITE_CURVE connecting three segments.
   Segment transitions at parameter values create joint extrema. */
#200=COMPOSITE_CURVE('three_seg_composite',
  (
    COMPOSITE_CURVE_SEGMENT(.UNIDIRECTIONAL.,#100),
    COMPOSITE_CURVE_SEGMENT(.UNIDIRECTIONAL.,#101),
    COMPOSITE_CURVE_SEGMENT(.UNIDIRECTIONAL.,#102)
  ),
  .F.);

#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn073','Gn073','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#200));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
