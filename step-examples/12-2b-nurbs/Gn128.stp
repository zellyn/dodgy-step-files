/* Gn128 - ShapeAnalysis_Curve.IsClosed B-spline with-identical-knots-different-poles
   Defect: closed B-spline whose first and last knots are identical but the
   corresponding poles differ by tiny amount; IsClosed reports closed but
   downstream geometry has gap. The closure check uses knot comparison but
   ignores pole mismatch, leading to false closure assertion. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Gn128 - BSpline closed with gap in poles'),
  '2;1');
FILE_NAME('Gn128.stp','2026-06-15T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=GEOMETRIC_REPRESENTATION_CONTEXT(3);
#2=SI_UNIT(*,.METRE.);
#3=NAMED_UNIT(*,#2);
/* B-spline with identical first and last knots but different poles */
#10=CARTESIAN_POINT('p0',(1.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(0.707,0.707,0.0));
#12=CARTESIAN_POINT('p2',(0.0,1.0,0.0));
#13=CARTESIAN_POINT('p3',(-0.707,0.707,0.0));
/* Last pole differs from first by small amount (gap) */
#14=CARTESIAN_POINT('p4',(1.0,0.001,0.0));
/* Knot vector: degree 3, 5 poles, so knot length = 5+3+1 = 9
   Multiplicities: (2,1,1,1,2) = 2+1+1+1+2 = 7... need to fix.
   Correct: degree 3, 5 poles => knot length must be 5+3+1 = 9
   Multiplicities must sum to 5+3+1=9
   Use (3,1,1,3) = 3+1+1+3 = 8... still wrong.
   For degree 3, 5 control points: knot length = 9
   Use multiplicities (4,1,1,3) = 9 ✓ */
#100=B_SPLINE_CURVE_WITH_KNOTS('bspl_closed_gap',
  3,.T.,
  (#10,#11,#12,#13,#14),
  .UNSPECIFIED.,
  (4,1,1,3),
  (0.0,0.333333,0.666667,1.0),
  .UNSPECIFIED.);
#1000=PRODUCT_CONTEXT('',#1,'mechanical');
#1001=PRODUCT('Gn128','Gn128','',(#1000));
#1002=PRODUCT_DEFINITION_FORMATION('','',#1001);
#1003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#1004=PRODUCT_DEFINITION('','',#1002,#1003);
#1005=PRODUCT_DEFINITION_SHAPE('','',#1004);
#1006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#1007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#1008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#1009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#1006,'distance_accuracy_value','');
#1010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#1009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#1006,#1007,#1008))REPRESENTATION_CONTEXT('','3D'));
#1022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#100),#1010);
#1023=SHAPE_DEFINITION_REPRESENTATION(#1005,#1022);
ENDSEC;
END-ISO-10303-21;
