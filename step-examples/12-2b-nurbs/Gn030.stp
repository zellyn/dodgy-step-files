ISO-10303-21;
/* Gn030 - Flat 3D curve as p-curve (instead of 2D PCURVE)
   Defect: a SURFACE_CURVE's associated_geometry references a 3D LINE
   directly rather than a PCURVE in (u,v).  For a flat host PLANE the
   3D LINE may lie on the surface, but the receiver code path that
   evaluates pcurve->surface to recover the 3D curve fails because the
   element in associated_geometry has no parameter-space representation.
   Surprisingly common in Parasolid-origin files (W041 / CAD Exchanger
   CHANGES v3.24.11).
   Note: pcurve_or_surface is a SELECT that admits PCURVE (2D in the
   surface's parameter space) OR SURFACE; some receivers tolerate a 3D
   curve here as a vendor extension and others reject it.  This fixture
   stores the 3D LINE directly to expose the failure mode. */
HEADER;
FILE_DESCRIPTION(
  ('Gn030 - SURFACE_CURVE.associated_geometry holds 3D LINE instead of PCURVE'),
  '2;1');
FILE_NAME('Gn030.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Plane z = 0, parameterised by (u = world x, v = world y). */
#10=CARTESIAN_POINT('plane_o',(0.0,0.0,0.0));
#11=DIRECTION('plane_z',(0.0,0.0,1.0));
#12=DIRECTION('plane_x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plane_pl',#10,#11,#12);
#20=PLANE('flat_face',#13);
/* 3D LINE in z=0 from (0,0,0) along +X.  This is the curve_3d slot of
   the SURFACE_CURVE below (i.e. the principal 3D representation). */
#30=CARTESIAN_POINT('line_a',(0.0,0.0,0.0));
#31=DIRECTION('line_dir',(1.0,0.0,0.0));
#32=VECTOR('line_vec',#31,1.0);
#33=LINE('flat_3d_line',#30,#32);
#40=VERTEX_POINT('v_a',#30);
#41=CARTESIAN_POINT('line_b',(10.0,0.0,0.0));
#42=VERTEX_POINT('v_b',#41);
/* Defect: associated_geometry holds a 3D LINE (#43) instead of a
   PCURVE in (u,v).  Receivers that hardcode the PCURVE form fail to
   interpret the entry.  Same shape as Gp010 (which places a 3D LINE
   in this slot deliberately as a Parasolid-emit defect). */
#43=LINE('flat_3d_pcurve_proxy',#30,#32);
#100=SURFACE_CURVE('flat_3d_pcurve_mismatch',#33,(#43),.CURVE_3D.);
/* PRODUCT chain so OCCT loads the geometry. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn030','Gn030','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#100));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
