ISO-10303-21;
/* Gn153 - Periodic B-spline with origin shift after C0->C1 upgrade
   Defect: Periodic 2D B-spline with C0 interior knot. After Geom2dConvert upgrade,
   origin shifts (parametrization point at FirstParameter changes). Healing must
   re-anchor origin via SetOrigin to maintain continuity across period.
   Curve: degree 2, 4 control points (periodic closed), C0 at parameter 0.5.
*/
HEADER;
FILE_DESCRIPTION(('Gn153 - Periodic B-spline origin shift post-upgrade'),'2;1');
FILE_NAME('Gn153.stp','2026-06-17T00:00:00',('auto'),(''),
  'auto','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 4 control points for periodic curve (closed loop) */
#10=CARTESIAN_POINT('p0',(0.5,0.0,0.0));
#11=CARTESIAN_POINT('p1',(0.0,0.5,0.0));
#12=CARTESIAN_POINT('p2',(-0.5,0.0,0.0));
#13=CARTESIAN_POINT('p3',(0.0,-0.5,0.0));
/* Defect: Periodic BSpline, degree 2, 4 poles.
   For periodic: sum(mults) = n_poles + degree = 4 + 2 = 6
   Knots: (3, 2, 1) => 3+2+1=6 correct
   Values: (0, 0, 0, 0.5, 1.0, 1.0) with periodicity
   Interior knot at 0.5 has mult 1 (C1 in this case, but post-upgrade scenario).
   After C0->C1 upgrade on a variant with mult=2 at 0.5:
   knots become (0, 0, 0, 0.25, 0.5, 0.75, 1.0, 1.0)
   FirstParameter point D0(0) may shift. SetOrigin must find matching knot
   span to re-anchor and preserve D0(0) == D0(period). */
#100=B_SPLINE_CURVE_WITH_KNOTS('periodic_origin_shift',2,
  (#10,#11,#12,#13),
  .UNSPECIFIED.,.T.,.F.,
  (3,2,1),
  (0.0,0.0,0.0,0.5,1.0,1.0),
  .UNSPECIFIED.);
/* Reference LINE for PRODUCT chain */
#110=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#111=DIRECTION('dir',(1.0,0.0,0.0));
#112=VECTOR('vec',#111,1.0);
#113=LINE('ref_axis',#110,#112);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn153','Gn153','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('curve_set',(#113));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
