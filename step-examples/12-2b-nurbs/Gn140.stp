ISO-10303-21;
/* Gn140: B_SPLINE_SURFACE_WITH_KNOTS U-periodic mismatch in periodic bounds check
   Defect: Closed U-direction surface. BRepLib::ExtendFace periodic_bounds_adjust
   uses aSVMax instead of aSVMin for V-closed validation. Geometry is U-periodic
   but V-open; bounds check fails when V-max is unbounded. */
HEADER;
FILE_DESCRIPTION(('Gn140 - U-periodic surface V-bounds mismatch'),'2;1');
FILE_NAME('Gn140.stp','2026-06-17T00:00:00',('auto'),(''),
  'auto','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 3x4 control net: U-periodic (3 poles), V-open (4 poles)
   U-direction: 3 poles, degree 2, periodic
   U: 3 + 2 + 1 = 6 knot slots => (1,1,1,1,1,1) with period 1.0
   V: 4 poles, degree 2, open clamped
   V: 4 + 2 + 1 = 7 knot slots => (3,1,3) */
#10=CARTESIAN_POINT('p00',(0.0,0.0,1.0));
#11=CARTESIAN_POINT('p01',(0.0,1.0,1.2));
#12=CARTESIAN_POINT('p02',(0.0,2.0,0.8));
#13=CARTESIAN_POINT('p03',(0.0,3.0,1.0));
#20=CARTESIAN_POINT('p10',(1.0,0.0,1.0));
#21=CARTESIAN_POINT('p11',(1.0,1.0,1.5));
#22=CARTESIAN_POINT('p12',(1.0,2.0,1.5));
#23=CARTESIAN_POINT('p13',(1.0,3.0,1.0));
#30=CARTESIAN_POINT('p20',(-1.0,0.0,1.0));
#31=CARTESIAN_POINT('p21',(-1.0,1.0,1.2));
#32=CARTESIAN_POINT('p22',(-1.0,2.0,0.8));
#33=CARTESIAN_POINT('p23',(-1.0,3.0,1.0));
/* 3x4 grid: U-periodic degree 2, V-open degree 2
   U knots: period 1.0
   V knots: open clamped */
#100=B_SPLINE_SURFACE_WITH_KNOTS('u_periodic_v_open',2,2,
  ((#10,#11,#12,#13),(#20,#21,#22,#23),(#30,#31,#32,#33)),
  .UNSPECIFIED.,.T.,.F.,.F.,
  (1,1,1,1,1,1),
  (3,1,3),
  (0.0,0.333,0.667),
  (0.0,0.5,1.0),
  .UNSPECIFIED.);
#101=SURFACE('',#100);
#102=REPRESENTATION_ITEM('',#101);
#110=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#111=DIRECTION('dir',(1.0,0.0,0.0));
#112=VECTOR('vec',#111,1.0);
#113=LINE('ref_axis',#110,#112);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn140','Gn140','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('curve_set',(#113));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
