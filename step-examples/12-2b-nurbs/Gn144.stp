ISO-10303-21;
/* Gn144: B_SPLINE_SURFACE_WITH_KNOTS periodic knot-vector closure mismatch
   Defect: Periodic BSpline surface with non-periodic knot vector (missing
   repeated boundary knots). Pole endpoints do not match, topology closed but
   parameter space invalid. Triggers closure-check logic without knot symmetry.
   Surface: degree 2, 4 poles U-direction (non-periodic knots), closed topology. */
HEADER;
FILE_DESCRIPTION(('Gn144 - Periodic surface with mismatched knot topology'),'2;1');
FILE_NAME('Gn144.stp','2026-06-17T00:00:00',('auto'),(''),
  'auto','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 4x3 control net: U non-periodic (4 poles), V open (3 poles)
   Degree: U=2, V=2 */
#10=CARTESIAN_POINT('p00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p01',(0.0,1.0,0.0));
#12=CARTESIAN_POINT('p02',(0.0,2.0,0.0));
#20=CARTESIAN_POINT('p10',(1.0,0.0,0.5));
#21=CARTESIAN_POINT('p11',(1.0,1.0,1.0));
#22=CARTESIAN_POINT('p12',(1.0,2.0,0.5));
#30=CARTESIAN_POINT('p20',(2.0,0.0,0.5));
#31=CARTESIAN_POINT('p21',(2.0,1.0,1.0));
#32=CARTESIAN_POINT('p22',(2.0,2.0,0.5));
#40=CARTESIAN_POINT('p30',(3.0,0.0,0.0));
#41=CARTESIAN_POINT('p31',(3.0,1.0,0.0));
#42=CARTESIAN_POINT('p32',(3.0,2.0,0.0));
/* Defect: Marked periodic=.T. in U, but U knot vector is open-clamped (3,3)
   instead of periodic wrap. Knot mults (3,3) + 4 poles suggests closed knots.
   With 4 poles, degree 2: sum should be 4+2+1=7 => but (3,3) sums to 6.
   This forces periodic logic but knot structure conflicts. */
#100=B_SPLINE_SURFACE_WITH_KNOTS('periodic_knot_conflict',2,2,
  ((#10,#11,#12),(#20,#21,#22),(#30,#31,#32),(#40,#41,#42)),
  .UNSPECIFIED.,.T.,.F.,.F.,
  (3,3),
  (3,3),
  (0.0,0.33,0.66),
  (0.0,1.0),
  .UNSPECIFIED.);
#110=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#111=DIRECTION('dir',(1.0,0.0,0.0));
#112=VECTOR('vec',#111,1.0);
#113=LINE('ref_axis',#110,#112);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn144','Gn144','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('curve_set',(#113));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
