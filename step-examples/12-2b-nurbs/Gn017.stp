ISO-10303-21;
/* Gn017 - Bezier conversion required for export to legacy systems
   Defect (input side): a B_SPLINE_SURFACE_WITH_KNOTS of degree (3,3)
   carries TWO interior knots in U (at 0.33 and 0.67), so the surface is
   3 Bezier patches per V-strip.  Some legacy receivers accept Bezier
   (no internal knots, multiplicity = degree+1 at endpoints) but not
   arbitrary NURBS.  Healers
   ShapeUpgrade_ConvertSurfaceToBezierBasis / ShapeUpgrade_ShapeConvertToBezier
   must split exactly at interior knots and preserve continuity.
   This is the input file; expected output: 3 Bezier patches per V-strip
   (i.e. 3 BEZIER_SURFACE entities replacing the one BSpline). */
HEADER;
FILE_DESCRIPTION(
  ('Gn017 - degree-3 NURBS surface with interior knots, for Bezier convert'),
  '2;1');
FILE_NAME('Gn017.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 6x4 control net.  Net produces a degree (3,3) BSpline with 2 interior
   knots in U.  After Bezier conversion expect 3 patches in U x 1 patch
   in V. */
#10=CARTESIAN_POINT('p',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p',(0.0,1.0,0.0));
#12=CARTESIAN_POINT('p',(0.0,2.0,0.0));
#13=CARTESIAN_POINT('p',(0.0,3.0,0.0));
#20=CARTESIAN_POINT('p',(1.0,0.0,0.5));
#21=CARTESIAN_POINT('p',(1.0,1.0,0.5));
#22=CARTESIAN_POINT('p',(1.0,2.0,0.5));
#23=CARTESIAN_POINT('p',(1.0,3.0,0.5));
#30=CARTESIAN_POINT('p',(2.0,0.0,1.0));
#31=CARTESIAN_POINT('p',(2.0,1.0,1.0));
#32=CARTESIAN_POINT('p',(2.0,2.0,1.0));
#33=CARTESIAN_POINT('p',(2.0,3.0,1.0));
#40=CARTESIAN_POINT('p',(3.0,0.0,1.0));
#41=CARTESIAN_POINT('p',(3.0,1.0,1.0));
#42=CARTESIAN_POINT('p',(3.0,2.0,1.0));
#43=CARTESIAN_POINT('p',(3.0,3.0,1.0));
#50=CARTESIAN_POINT('p',(4.0,0.0,0.5));
#51=CARTESIAN_POINT('p',(4.0,1.0,0.5));
#52=CARTESIAN_POINT('p',(4.0,2.0,0.5));
#53=CARTESIAN_POINT('p',(4.0,3.0,0.5));
#60=CARTESIAN_POINT('p',(5.0,0.0,0.0));
#61=CARTESIAN_POINT('p',(5.0,1.0,0.0));
#62=CARTESIAN_POINT('p',(5.0,2.0,0.0));
#63=CARTESIAN_POINT('p',(5.0,3.0,0.0));
/* Defect-side input: degree (3,3) NURBS with 2 interior U knots; legacy
   receivers cannot consume directly; needs conversion to Bezier patches. */
#100=B_SPLINE_SURFACE_WITH_KNOTS('nurbs_for_bezier_split',
  3,3,
  ((#10,#11,#12,#13),(#20,#21,#22,#23),(#30,#31,#32,#33),
   (#40,#41,#42,#43),(#50,#51,#52,#53),(#60,#61,#62,#63)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (4,1,1,4),(4,4),
  (0.0,0.33,0.67,1.0),(0.0,1.0),
  .UNSPECIFIED.);
ENDSEC;
END-ISO-10303-21;
