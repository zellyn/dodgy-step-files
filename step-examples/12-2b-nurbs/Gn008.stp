ISO-10303-21;
/* Gn008: High-curvature B-spline curves: (A) B_SPLINE_CURVE_WITH_KNOTS degree 3 with interior knot of multiplicity 3 (full degree = cusp-producing near-cusp); (B) RATIONAL_B_SPLINE_CURVE with weights (1,1000,1,1) — ratio ~1e3 causes mesher over-resolution or failure; accept geometrically; flag as quality warning; downstream meshers must detect and refuse/refit before meshing. The cusp/high-weight curves sit in an unreferenced GEOMETRIC_CURVE_SET, so OCC loads only a 1-vertex stub; the near-cusp / weight-ratio is byte-present but is a geometry-QUALITY property invisible to the load-time shape-count oracles (shape(1)), not a genuine load-time demonstration */
HEADER;
FILE_DESCRIPTION(('Gn008'),'2;1');
FILE_NAME('Gn008.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=GEOMETRIC_CURVE_SET('',(#1));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Gn008','Gn008','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#2),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
#9063=CARTESIAN_POINT('',(0.0,0.0,0.0));
#9064=CARTESIAN_POINT('',(0.5,1.0,0.0));
#9065=CARTESIAN_POINT('',(1.0,2.0,0.0));
#9066=CARTESIAN_POINT('',(1.5,0.0,0.0));
#9067=CARTESIAN_POINT('',(2.0,-1.0,0.0));
#9068=CARTESIAN_POINT('',(2.5,0.5,0.0));
#9069=CARTESIAN_POINT('',(3.0,0.0,0.0));
#9070=B_SPLINE_CURVE_WITH_KNOTS('cusp_mult3',3,(#9063,#9064,#9065,#9066,#9067,#9068,#9069),.UNSPECIFIED.,.F.,.F.,(4,3,4),(0.0,0.5,1.0),.UNSPECIFIED.);
#9071=CARTESIAN_POINT('',(0.0,0.0,0.0));
#9072=CARTESIAN_POINT('',(1.0,2.0,0.0));
#9073=CARTESIAN_POINT('',(2.0,2.0,0.0));
#9074=CARTESIAN_POINT('',(3.0,0.0,0.0));
#9075=(
  BOUNDED_CURVE()
  B_SPLINE_CURVE(3,(#9071,#9072,#9073,#9074),.UNSPECIFIED.,.F.,.F.)
  B_SPLINE_CURVE_WITH_KNOTS((4,4),(0.0,1.0),.UNSPECIFIED.)
  CURVE()
  GEOMETRIC_REPRESENTATION_ITEM()
  RATIONAL_B_SPLINE_CURVE((1.0,1000.0,1.0,1.0))
  REPRESENTATION_ITEM('high_weight_ratio')
);
ENDSEC;
END-ISO-10303-21;
