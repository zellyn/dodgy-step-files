/* Gn008 - High-curvature curves: knot multiplicity at full degree producing
   near-cusps; rational with weight ratio above 1e3
   Defect: two flavors that produce mesher pathologies:
     #110 - degree-3 B_SPLINE_CURVE_WITH_KNOTS with an interior knot of
            multiplicity 3 (= degree).  This forces a true C0 join and a
            sharp tangent break (cusp-like geometry).
     #210 - RATIONAL_B_SPLINE_CURVE with weights (1, 1000, 1, 1).  The huge
            weight ratio pulls the curve toward the second pole and forces
            downstream meshers to over-resolve near it, or fail.
   Geometry remains valid; readers should accept and emit a quality
   warning. Downstream meshers must detect and refit before meshing. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Gn008 - high-curvature near-cusp BSpline curves'),'2;1');
FILE_NAME('Gn008.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Curve A: degree 3, interior knot of multiplicity 3 -> C0 join. */
#10=CARTESIAN_POINT('a0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('a1',(1.0,0.5,0.0));
#12=CARTESIAN_POINT('a2',(2.0,1.0,0.0));
#13=CARTESIAN_POINT('a3',(3.0,1.0,0.0));
#14=CARTESIAN_POINT('a4',(4.0,0.5,0.0));
#15=CARTESIAN_POINT('a5',(5.0,-0.5,0.0)); /* drop -> cusp */
#16=CARTESIAN_POINT('a6',(6.0,0.0,0.0));
/* Defect: interior knot multiplicity 3 == degree -> C0 / cusp at param 0.5. */
#110=B_SPLINE_CURVE_WITH_KNOTS('cusp_curve',3,(#10,#11,#12,#13,#14,#15,#16),
  .UNSPECIFIED.,.F.,.F.,
  (4,3,4),
  (0.0,0.5,1.0),
  .UNSPECIFIED.);
/* Curve B: rational with extreme weight ratio. */
#20=CARTESIAN_POINT('b0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('b1',(1.0,5.0,0.0));
#22=CARTESIAN_POINT('b2',(2.0,5.0,0.0));
#23=CARTESIAN_POINT('b3',(3.0,0.0,0.0));
/* Defect: weight ratio 1000:1 forces near-degenerate parametrization. */
#210=(
  BOUNDED_CURVE()
  B_SPLINE_CURVE(3,(#20,#21,#22,#23),.UNSPECIFIED.,.F.,.F.)
  B_SPLINE_CURVE_WITH_KNOTS((4,4),(0.0,1.0),.UNSPECIFIED.)
  CURVE()
  GEOMETRIC_REPRESENTATION_ITEM()
  RATIONAL_B_SPLINE_CURVE((1.0,1000.0,1.0,1.0))
  REPRESENTATION_ITEM('extreme_weight_ratio'));
ENDSEC;
END-ISO-10303-21;
