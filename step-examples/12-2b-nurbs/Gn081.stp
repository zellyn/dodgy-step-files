ISO-10303-21;
/* Gn081 - ShapeAnalysis_Curve.GetSamplePoints CIRCLE shortcut scale-insensitive
   Defect: full-circle CIRCLE with radius 0.001 (micro-scale); sample count
   capped at 360 regardless of curve scale, producing 1µm spacing for 1µm radius. */
HEADER;
FILE_DESCRIPTION(('Gn081 - CIRCLE sampling unscaled sample count limit','2;1');
FILE_NAME('Gn081.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Micro-scale CIRCLE with radius 0.001 mm (1 micrometer).
   Full circle: arc range [0, 2*pi]. Default sampling caps at 360 points,
   giving ~6.28e-6 mm sample spacing, which exceeds the 1e-7 tolerance. */
#10=AXIS2_PLACEMENT_3D('ax',#11,#12,#13);
#11=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#12=DIRECTION('dir1',(0.0,0.0,1.0));
#13=DIRECTION('dir2',(1.0,0.0,0.0));
#20=CIRCLE('micro_circle',#10,0.001);
#100=TRIMMED_CURVE('full_circle_trimmed',#20,.T.,
  (PARAMETER_VALUE(0.0)),(PARAMETER_VALUE(6.283185307)),
  .PARAMETER.,.PARAMETER.);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn081','Gn081','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#100),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
