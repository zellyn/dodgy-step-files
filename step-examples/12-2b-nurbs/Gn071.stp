ISO-10303-21;
/* Gn071 - ShapeAnalysis_Curve.IsClosed BezierCurve check
   Defect: BEZIER_CURVE entity with matching first/last poles treated as B-spline
   for closure check. IsClosed reports false (technically correct for B-spline
   interpretation) but misses Bezier-specific closure semantics. */
HEADER;
FILE_DESCRIPTION(('Gn071 - BEZIER_CURVE closure semantic mismatch'',''2;1'',''2;1'),'2;1');
FILE_NAME('Gn071.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* BEZIER_CURVE degree 3 with 5 control points.
   First pole (0,0,0), last pole (0,0,0) - identical endpoints.
   For a Bezier curve, matching endpoints indicate closure. */
#10=CARTESIAN_POINT('bp1',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('bp2',(1.5,1.0,0.0));
#12=CARTESIAN_POINT('bp3',(2.0,2.0,0.0));
#13=CARTESIAN_POINT('bp4',(1.5,3.0,0.0));
/* Matching first pole - Bezier closure semantics. */
#14=CARTESIAN_POINT('bp5',(0.0,0.0,0.0));
/* BEZIER_CURVE with matching first/last poles.
   IsClosed should recognize closure but B-spline interpretation may fail. */
#100=BEZIER_CURVE('closed_bezier',3,(#10,#11,#12,#13,#14));
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn071','Gn071','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#100));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
