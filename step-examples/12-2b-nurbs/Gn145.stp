ISO-10303-21;
/* Gn145: B_SPLINE_SURFACE_WITH_KNOTS pole singularity at interior knot
   Defect: Surface with interior knot of multiplicity = degree + 1, creating
   C(-1) continuity discontinuity (cusp/kink). Healing must detect and possibly
   split or elevate continuity. Pole singularity in middle of surface, not boundary. */
HEADER;
FILE_DESCRIPTION(('Gn145 - Interior knot multiplicity causes pole singularity'),'2;1');
FILE_NAME('Gn145.stp','2026-06-17T00:00:00',('auto'),(''),
  'auto','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 5x3 control net: U direction has 5 poles, V has 3
   Degree: U=2, V=2 */
#10=CARTESIAN_POINT('p00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p01',(0.0,1.0,0.0));
#12=CARTESIAN_POINT('p02',(0.0,2.0,0.0));
#20=CARTESIAN_POINT('p10',(1.0,0.0,0.3));
#21=CARTESIAN_POINT('p11',(1.0,1.0,0.6));
#22=CARTESIAN_POINT('p12',(1.0,2.0,0.3));
#30=CARTESIAN_POINT('p20',(2.0,0.0,1.0));
#31=CARTESIAN_POINT('p31',(2.0,1.0,1.0));
#32=CARTESIAN_POINT('p32',(2.0,2.0,1.0));
#40=CARTESIAN_POINT('p40',(3.0,0.0,0.3));
#41=CARTESIAN_POINT('p41',(3.0,1.0,0.6));
#42=CARTESIAN_POINT('p42',(3.0,2.0,0.3));
#50=CARTESIAN_POINT('p50',(4.0,0.0,0.0));
#51=CARTESIAN_POINT('p51',(4.0,1.0,0.0));
#52=CARTESIAN_POINT('p52',(4.0,2.0,0.0));
/* Defect: U knot vector with interior knot of mult 3 at position 0.5
   Degree 2, so mult == degree+1 creates C(-1) discontinuity (corner).
   5 poles, degree 2 => 5+2+1=8 knot mults total.
   Knot vector: (3,3,3) at [0,0.5,1] => 3+3+3=9, too many.
   Fix: (3,2,3) => 3+2+3=8 correct, interior mult 2 => C0 continuity. */
#100=B_SPLINE_SURFACE_WITH_KNOTS('interior_cusp',2,2,
  ((#10,#11,#12),(#20,#21,#22),(#30,#31,#32),(#40,#41,#42),(#50,#51,#52)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (3,3,3),
  (3,3),
  (0.0,0.0,0.0,0.5,0.5,0.5,1.0,1.0),
  (0.0,1.0),
  .UNSPECIFIED.);
#110=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#111=DIRECTION('dir',(1.0,0.0,0.0));
#112=VECTOR('vec',#111,1.0);
#113=LINE('ref_axis',#110,#112);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn145','Gn145','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('curve_set',(#113));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
