ISO-10303-21;
/* Gn042 - ShapeUpgrade_ConvertSurfaceToBezierBasis knot-insertion thin patch
   Defect: a B_SPLINE_SURFACE_WITH_KNOTS with double knot multiplicity
   at an interior position causes the Bezier basis converter to produce
   degenerate (thin) Bezier patches after knot insertion. The thin patch
   filter fails to remove these patches because the extent check is
   insufficient. */
HEADER;
FILE_DESCRIPTION(('Gn042 - BSpline surface double knot thin patch'',''2;1'',''2;1'),'2;1');
FILE_NAME('Gn042.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 4x4 control net for a cubic B-spline surface with a double knot
   at interior U=0.5 position. The knot multiplicity of 2 at 0.5 creates
   a C1 discontinuity (not C2), which after knot insertion for Bezier
   conversion yields thin patches. */
#10=CARTESIAN_POINT('p00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p01',(0.0,1.0,0.0));
#12=CARTESIAN_POINT('p02',(0.0,2.0,0.0));
#13=CARTESIAN_POINT('p03',(0.0,3.0,0.0));
#20=CARTESIAN_POINT('p10',(1.0,0.0,0.0));
#21=CARTESIAN_POINT('p11',(1.0,1.0,0.5));
#22=CARTESIAN_POINT('p12',(1.0,2.0,0.5));
#23=CARTESIAN_POINT('p13',(1.0,3.0,0.0));
#30=CARTESIAN_POINT('p20',(2.0,0.0,0.0));
#31=CARTESIAN_POINT('p21',(2.0,1.0,0.5));
#32=CARTESIAN_POINT('p22',(2.0,2.0,0.5));
#33=CARTESIAN_POINT('p23',(2.0,3.0,0.0));
#40=CARTESIAN_POINT('p30',(3.0,0.0,0.0));
#41=CARTESIAN_POINT('p31',(3.0,1.0,0.0));
#42=CARTESIAN_POINT('p32',(3.0,2.0,0.0));
#43=CARTESIAN_POINT('p33',(3.0,3.0,0.0));
/* Fifth U-row of control points so multiplicities (4,2,3) sum 9 =
   5 ctrl pts + degree 3 + 1, as required by the knot-vector invariant. */
#50=CARTESIAN_POINT('p40',(4.0,0.0,0.0));
#51=CARTESIAN_POINT('p41',(4.0,1.0,0.0));
#52=CARTESIAN_POINT('p42',(4.0,2.0,0.0));
#53=CARTESIAN_POINT('p43',(4.0,3.0,0.0));
/* Defect: U knot multiplicity 2 at interior knot U=0.5 (a "double knot")
   creates a C1 (not C2) continuity for degree 3. The ConvertSurfaceToBezierBasis
   knot-inserter subdivides at 0.5 to reach Bezier form, but the close-spaced
   subdivisions leave a thin patch sliver. */
#100=B_SPLINE_SURFACE_WITH_KNOTS('thin_patch',3,3,
  ((#10,#11,#12,#13),(#20,#21,#22,#23),(#30,#31,#32,#33),(#40,#41,#42,#43),(#50,#51,#52,#53)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (4,2,3),
  (4,1,1,4),
  (0.0,0.5,1.0),
  (0.0,0.4,0.6,1.0),
  .UNSPECIFIED.);
/* PRODUCT chain wrapping surface. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn042','Gn042','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#100),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
