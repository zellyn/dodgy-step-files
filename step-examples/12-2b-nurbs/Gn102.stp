ISO-10303-21;
/* Gn102 - ShapeUpgrade_ConvertCurve2dToBezier degree-elevation-skip
   Defect: 2D B_SPLINE_CURVE_WITH_KNOTS of degree 0 (piecewise constant).
   Degree-elevation routine computes elevation_diff = target_degree - source_degree.
   For degree 0, this produces -1, causing negative-degree processing or underflow. */
HEADER;
FILE_DESCRIPTION(('Gn102 - Constant (degree-0) spline elevation underflow'),'2;1');
FILE_NAME('Gn102.stp','2026-06-15T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Degree-0 B-spline: piecewise constant. Control points: (1,1), (2,2), (3,1).
   Knot vector with multiplicity matching degree+cp_count: (0,0,1,1,2,2,3,3)
   This defines a step function with 3 flat segments. */
#10=CARTESIAN_POINT('p0',(1.0,1.0,0.0));
#11=CARTESIAN_POINT('p1',(2.0,2.0,0.0));
#12=CARTESIAN_POINT('p2',(3.0,1.0,0.0));
/* Defect: degree 0 will cause elevation_diff to underflow when raised to
   higher degree (e.g., target degree 2 -> diff = 2-0 = 2, but for degree 0
   special-case paths may compute diff = target - 0 incorrectly as -1). */
#100=B_SPLINE_CURVE_WITH_KNOTS('constant_spline',0,
  ((#10,#11,#12)),
  .UNSPECIFIED.,.F.,.F.,
  (2,2,2),
  (0.0,1.0,2.0,3.0),
  .UNSPECIFIED.);
/* Wrap in CURVE entity for 2D context. */
#101=CURVE('const_2d',#100);
/* PRODUCT chain. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn102','Gn102','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#101));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
