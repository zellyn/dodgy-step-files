ISO-10303-21;
/* Gn147: B_SPLINE_SURFACE_WITH_KNOTS stripe singularity (collapsed row)
   Defect: B-spline surface with entire U-row of poles collapsed to single point
   (stripe defect). Healing must detect and potentially split surface or collapse
   degenerate patches. Surface row singularity, not boundary (pin). */
HEADER;
FILE_DESCRIPTION(('Gn147 - BSpline surface with collapsed pole row (stripe)'),'2;1');
FILE_NAME('Gn147.stp','2026-06-17T00:00:00',('auto'),(''),
  'auto','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 3x4 control net: 3 poles U, 4 poles V
   Degree: U=2, V=2 */
#10=CARTESIAN_POINT('p00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p01',(0.0,1.0,0.0));
#12=CARTESIAN_POINT('p02',(0.0,2.0,0.0));
#13=CARTESIAN_POINT('p03',(0.0,3.0,0.0));
#20=CARTESIAN_POINT('p10',(1.0,0.0,0.5));
#21=CARTESIAN_POINT('p11',(1.0,1.0,0.5));
#22=CARTESIAN_POINT('p12',(1.0,2.0,0.5));
#23=CARTESIAN_POINT('p13',(1.0,3.0,0.5));
#30=CARTESIAN_POINT('p20',(2.0,0.0,0.0));
#31=CARTESIAN_POINT('p21',(2.0,1.0,0.0));
#32=CARTESIAN_POINT('p22',(2.0,2.0,0.0));
#33=CARTESIAN_POINT('p23',(2.0,3.0,0.0));
/* Defect: Middle row (U=1.0) has all V-poles at same (x,y,z) = (1.0, *, 0.5).
   This creates a stripe singularity: the entire middle row collapses to a line.
   3 poles U, degree 2 => 3+2+1=6 => (3,3) mults
   4 poles V, degree 2 => 4+2+1=7 => need (3,2,2) or similar
   Here: (4,3) => 4+3=7 correct for V */
#100=B_SPLINE_SURFACE_WITH_KNOTS('stripe_collapse',2,2,
  ((#10,#11,#12,#13),(#20,#21,#22,#23),(#30,#31,#32,#33)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (3,3),
  (4,3),
  (0.0,1.0),
  (0.0,0.33,0.67),
  .UNSPECIFIED.);
#110=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#111=DIRECTION('dir',(1.0,0.0,0.0));
#112=VECTOR('vec',#111,1.0);
#113=LINE('ref_axis',#110,#112);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn147','Gn147','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('curve_set',(#113));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
