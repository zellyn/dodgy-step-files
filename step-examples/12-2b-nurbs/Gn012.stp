/* Gn012 - C0 BSpline curve should be split into C1+ pieces
   Defect: a B_SPLINE_CURVE_WITH_KNOTS of degree 3 has an interior knot
   whose multiplicity equals the degree (3), which makes the curve only
   C0 there.  Downstream tools requiring at least C1 (split-tool path
   generation, Booleans, mass properties) fail at the kink.  Healer
   ShapeUpgrade_ShapeDivideContinuity / C0BSplineToSequenceOfC1BsplineCurve
   should split the curve at that location, emitting each piece as its
   own EDGE_CURVE with a shared vertex. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(
  ('Gn012 - C0 join in BSpline curve (interior mult = degree)'),'2;1');
FILE_NAME('Gn012.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Two control polygons that meet at (3,1,0) but with different incoming
   and outgoing tangents -> sharp tangent break (C0). */
#10=CARTESIAN_POINT('a',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('b',(1.0,0.5,0.0));
#12=CARTESIAN_POINT('c',(2.0,1.0,0.0));
#13=CARTESIAN_POINT('d',(3.0,1.0,0.0));
#14=CARTESIAN_POINT('e',(4.0,0.5,0.0));
#15=CARTESIAN_POINT('f',(5.0,-0.5,0.0));
#16=CARTESIAN_POINT('g',(6.0,-1.0,0.0));
/* Defect: interior knot 0.5 has multiplicity 3 == degree -> C0 join. */
#100=B_SPLINE_CURVE_WITH_KNOTS('c0_join',3,
  (#10,#11,#12,#13,#14,#15,#16),
  .UNSPECIFIED.,.F.,.F.,
  (4,3,4),
  (0.0,0.5,1.0),
  .UNSPECIFIED.);
/* PRODUCT chain so OCCT loads the geometry. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn012','Gn012','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#100));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
