ISO-10303-21;
/* Gn061 - ShapeAnalysis_Curve.GetSamplePoints (3D 2pt LINE shortcut)
   Defect: LINE entity sampled with the 2-point shortcut; the 2 points don't
   capture trim limits, missing midspan information used downstream.
   This is a trimmed line with significant offset from endpoints. */
HEADER;
FILE_DESCRIPTION(('Gn061 - GetSamplePoints 2pt LINE shortcut misses trim','2;1');
FILE_NAME('Gn061.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* A LINE defined by two points: start at (0,0,0) and end at (10,0,0).
   The line will be trimmed to a small window, but GetSamplePoints
   with 2-point shortcut only samples the trimmed endpoints, missing
   the geometric center used by downstream healing. */
#10=CARTESIAN_POINT('start',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('end',(10.0,0.0,0.0));
#100=LINE('baseline',#10,#11);
/* Trimmed to [2.0, 8.0], which excludes the midpoint at u=5.0 from
   standard 2-point sampling. Downstream curvature analysis relies on
   the midspan geometry to detect degeneracy or discontinuity. */
#101=TRIMMED_CURVE('trimmed_line',#100,.T.,
  PARAMETER_VALUE(2.0),PARAMETER_VALUE(8.0));
/* PRODUCT chain wrapping wireframe. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn061','Gn061','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#101));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
