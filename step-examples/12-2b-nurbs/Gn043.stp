/* Gn043 - ShapeAnalysis_Curve.GetSamplePoints rational B-spline 4x amplification
   Defect: a rational B_SPLINE_CURVE_WITH_KNOTS with non-uniform weights causes
   the sample point generation to amplify the sample count by a factor of 4x.
   The denominator pre-image expansion in rational curves is not properly
   accounted for, leading to excessive sampling overhead and potential numerical
   instability during healing operations. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Gn043 - Rational BSpline 4x sample amplification','2;1');
FILE_NAME('Gn043.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Rational cubic B-spline with 5 control points and non-uniform weights.
   The weight array [1.0, 2.0, 1.0, 2.0, 1.0] has large variation (2.0 vs 1.0)
   that amplifies the denominator variation, causing sample-count amplification. */
#10=CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p2',(1.0,2.0,0.0));
#12=CARTESIAN_POINT('p3',(2.0,1.0,0.0));
#13=CARTESIAN_POINT('p4',(3.0,2.0,0.0));
#14=CARTESIAN_POINT('p5',(4.0,0.0,0.0));
/* Defect: non-uniform weights cause denominator pre-image expansion.
   GetSamplePoints applies a 4x amplification factor to account for
   weight variation, causing 4x more samples than necessary. */
#100=B_SPLINE_CURVE_WITH_KNOTS('rational_amplify',3,
  (#10,#11,#12,#13,#14),
  .UNSPECIFIED.,.F.,.F.,
  (4,1,4),
  (0.0,0.5,1.0),
  .UNSPECIFIED.,
  (1.0,2.0,1.0,2.0,1.0));
/* PRODUCT chain wrapping wireframe. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn043','Gn043','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#100));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
