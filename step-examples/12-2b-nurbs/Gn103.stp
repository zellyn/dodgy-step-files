ISO-10303-21;
/* Gn103 - ShapeAnalysis_Curve.FillBndBox bspline-bezier-mixed
   Defect: COMPOSITE_CURVE with 1 B-spline segment and 1 Bezier segment.
   FillBndBox dispatches per-segment but uses wrong sample-count for the
   Bezier component (applies B-spline count instead of Bezier count). */
HEADER;
FILE_DESCRIPTION(('Gn103 - Composite BSpline+Bezier bounding-box sample mismatch'),'2;1');
FILE_NAME('Gn103.stp','2026-06-15T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Segment 1: Degree-3 B-spline curve (4 control points, clamped). */
#10=CARTESIAN_POINT('bs_p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('bs_p1',(1.0,2.0,0.0));
#12=CARTESIAN_POINT('bs_p2',(2.0,2.0,0.0));
#13=CARTESIAN_POINT('bs_p3',(3.0,0.0,0.0));
#20=B_SPLINE_CURVE_WITH_KNOTS('bspline_seg',3,
  ((#10,#11,#12,#13)),
  .UNSPECIFIED.,.F.,.F.,
  (4,4),
  (0.0,1.0),
  .UNSPECIFIED.);
/* Segment 2: Degree-2 Bezier curve (3 control points).
   Bezier requires fewer samples than the degree-3 B-spline above. */
#30=CARTESIAN_POINT('bez_p0',(3.0,0.0,0.0));
#31=CARTESIAN_POINT('bez_p1',(3.5,1.0,0.0));
#32=CARTESIAN_POINT('bez_p2',(4.0,0.0,0.0));
#21=BEZIER_CURVE('bezier_seg',2,((#30,#31,#32)),.UNSPECIFIED.,.F.,.F.);
/* Composite: BSpline then Bezier. FillBndBox will apply B-spline
   sample count to Bezier, missing curvature extrema. */
#100=COMPOSITE_CURVE('mixed_curve',
  (#20,#21),
  .F.,
  .UNSPECIFIED.);
/* PRODUCT chain. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn103','Gn103','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#100));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
