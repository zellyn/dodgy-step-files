ISO-10303-21;
/* Gn060 - ShapeUpgrade_ConvertCurve2dToBezier loop-variable persistence
   Defect: 2D B-spline with 6+ patches; the bezier conversion loop variable
   j1 doesn't reset between outer iterations, causing patch skip.
   This fixture is a 2D trimmed curve with multiple continuity breaks. */
HEADER;
FILE_DESCRIPTION(('Gn060 - ConvertCurve2dToBezier j1 persistence loop bug'',''2;1'',''2;1'),'2;1');
FILE_NAME('Gn060.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 2D Trimmed curve based on a B-spline with 9 control points, degree 2.
   This produces 6+ segments when converted to piecewise Bezier.
   Knot vector: [0, 0, 0, 0.25, 0.5, 0.75, 1.0, 1.0, 1.0, 1.0]
   This creates multiple C0 and C1 continuities. */
#10=CARTESIAN_POINT('p1',(0.0,0.0));
#11=CARTESIAN_POINT('p2',(1.0,0.5));
#12=CARTESIAN_POINT('p3',(2.0,1.5));
#13=CARTESIAN_POINT('p4',(3.0,1.0));
#14=CARTESIAN_POINT('p5',(4.0,2.0));
#15=CARTESIAN_POINT('p6',(5.0,1.5));
#16=CARTESIAN_POINT('p7',(6.0,2.5));
#17=CARTESIAN_POINT('p8',(7.0,1.0));
#18=CARTESIAN_POINT('p9',(8.0,0.0));
/* 2D B-spline: degree 2, 9 control points yields knot length = 9+2+1 = 12.
   Multiplicities: (3,1,1,1,1,1,1,1,2) sum to 12. 9 unique knot values. */
#100=B_SPLINE_CURVE_WITH_KNOTS('multi_patch_2d',2,
  (#10,#11,#12,#13,#14,#15,#16,#17,#18),
  .UNSPECIFIED.,.F.,.F.,
  (3,1,1,1,1,1,1,1,2),
  (0.0,0.15,0.3,0.45,0.6,0.75,0.85,0.95,1.0),
  .UNSPECIFIED.);
/* Trimmed curve using the above B-spline, trimmed to [0.0, 1.0]. */
#101=TRIMMED_CURVE('trimmed_2d',#100,.T.,
  PARAMETER_VALUE(0.0),PARAMETER_VALUE(1.0));
/* PRODUCT chain wrapping wireframe. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn060','Gn060','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#101));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
