ISO-10303-21;
/* Gn009 - High-degree NURBS surface bloat (degree >5, redundant knots)
   Defect: a near-flat patch is exported as B_SPLINE_SURFACE_WITH_KNOTS of
   degree (9,9) with REDUNDANT INTERIOR KNOTS, where degree-3 with a few
   control points would suffice.  Often produced by aggressive degree-
   elevation in the source kernel; causes meshing slowdowns and is a main
   impact on FEA prep.  See CADfix tutorial "Reducing High Degree NURBS
   Surfaces" (W016).
   The knot vector here is (10, 1, 1, 1, 1, 10) on each side: i.e. degree
   9 with FOUR simple interior knots, giving five spans across the patch
   instead of one Bezier span.  That requires 14 poles per row -- a
   14x14 net of near-coplanar points.  A degree-3 PLANE patch with a few
   poles would represent the same shape within authoring tolerance.
   Bytes: full 14x14 net of unique CARTESIAN_POINTs (no ID re-use). */
HEADER;
FILE_DESCRIPTION(('Gn009 - degree-9 NURBS bloat with interior knots'),'2;1');
FILE_NAME('Gn009.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
