ISO-10303-21;
/* Gn156 - Periodic B-spline curve with mismatched closed-loop control polygon
   Defect: Periodic Geom_BSplineCurve marked .T. (periodic) but control points
   do not form a closed loop (first != last pole). Healing must either enforce
   closure or strip periodicity flag. Degree 2, 5 poles (circular, but P[0] != P[4]).
   After Geom2dConvert C0->C1 upgrade, origin may shift without SetOrigin fix. */
HEADER;
FILE_DESCRIPTION(('Gn156 - Periodic curve with non-closing polygon, origin shift risk'),'2;1');
FILE_NAME('Gn156.stp','2026-06-17T00:00:00',('auto'),(''),
  'auto','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 5 poles forming approximate circle, but P0 != P4 (open polygon) */
#10=CARTESIAN_POINT('p0',(1.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(0.0,1.0,0.0));
#12=CARTESIAN_POINT('p2',(-1.0,0.0,0.0));
#13=CARTESIAN_POINT('p3',(0.0,-1.0,0.0));
#14=CARTESIAN_POINT('p4',(0.9,-0.1,0.0));
/* Defect: Periodic curve, degree 2, 5 poles.
   Periodic formula: sum_mults = n_poles + degree = 5 + 2 = 7
   Multiplicities: (2,2,2,1) => sum=7. Good.
   Knot values: (0.0, 0.0, 0.25, 0.5, 0.75, 1.0, 1.0)
   But P[0]=(1,0,0) != P[4]=(0.9,-0.1,0), so polygon doesn't close.
   Periodic semantics require closure. This is the defect. */
#100=B_SPLINE_CURVE_WITH_KNOTS('open_periodic_polygon',2,
  (#10,#11,#12,#13,#14),
  .UNSPECIFIED.,.T.,.F.,
  (2,2,2,1),
  (0.0,0.0,0.25,0.5,0.75,1.0,1.0),
  .UNSPECIFIED.);
/* Reference LINE */
#110=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#111=DIRECTION('dir',(1.0,0.0,0.0));
#112=VECTOR('vec',#111,1.0);
#113=LINE('ref_axis',#110,#112);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn156','Gn156','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('curve_set',(#113));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
