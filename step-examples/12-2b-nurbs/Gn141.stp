ISO-10303-21;
/* Gn141: B_SPLINE_SURFACE_WITH_KNOTS with excessive V-multiplicity
   Defect: V-direction interior knot has multiplicity equal to degree.
   GeomAPI_ProjectPointOnSurface sampling depends on UMultiplicity(1) < UDegree()+1
   but skips V-multiplicity check. High V-multiplicity==degree causes G0-only
   continuity at that V-line, breaking derivative-based projection. */
HEADER;
FILE_DESCRIPTION(('Gn141 - V-multiplicity continuity gap in projection'),'2;1');
FILE_NAME('Gn141.stp','2026-06-17T00:00:00',('auto'),(''),
  'auto','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 4x3 control net: U-open, V-open
   U: 4 poles, degree 2 => 4+2+1=7 => (3,1,3)
   V: 3 poles, degree 2, but interior knot at V=0.5 with mult=2 (=degree)
   V knots: (0,0,0, 0.5,0.5, 1.0,1.0,1.0) => mults: (3,2,3) sum=8
   This creates G0 discontinuity at V=0.5. */
#10=CARTESIAN_POINT('p00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p01',(0.0,1.0,0.3));
#12=CARTESIAN_POINT('p02',(0.0,2.0,0.0));
#20=CARTESIAN_POINT('p10',(1.0,0.0,0.2));
#21=CARTESIAN_POINT('p11',(1.0,1.0,0.6));
#22=CARTESIAN_POINT('p12',(1.0,2.0,0.2));
#30=CARTESIAN_POINT('p20',(2.0,0.0,0.3));
#31=CARTESIAN_POINT('p21',(2.0,1.0,0.7));
#32=CARTESIAN_POINT('p22',(2.0,2.0,0.3));
#40=CARTESIAN_POINT('p30',(3.0,0.0,0.0));
#41=CARTESIAN_POINT('p31',(3.0,1.0,0.4));
#42=CARTESIAN_POINT('p32',(3.0,2.0,0.0));
/* 4x3 surface, U degree 2, V degree 2
   U knots: fully clamped (3,1,3)
   V knots: interior multiplicity 2 (equals degree, creates G0 jump) */
#100=B_SPLINE_SURFACE_WITH_KNOTS('v_high_mult',2,2,
  ((#10,#11,#12),(#20,#21,#22),(#30,#31,#32),(#40,#41,#42)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (3,1,3),
  (3,2,3),
  (0.0,0.333,0.667,1.0),
  (0.0,0.5,1.0),
  .UNSPECIFIED.);
#101=SURFACE('',#100);
#102=REPRESENTATION_ITEM('',#101);
#110=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#111=DIRECTION('dir',(1.0,0.0,0.0));
#112=VECTOR('vec',#111,1.0);
#113=LINE('ref_axis',#110,#112);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn141','Gn141','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('curve_set',(#113));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
