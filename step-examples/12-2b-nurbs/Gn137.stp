ISO-10303-21;
/* Gn137: B-SPLINE_CURVE_WITH_KNOTS precision asymmetry in split
   Defect: Curve with 7 poles, degree 3. Split logic uses asymmetric
   precision test: (parU - param < prec) instead of Abs(parU - param).
   If split parameter slightly above a knot, loop exits prematurely,
   skipping valid patch segments. */
HEADER;
FILE_DESCRIPTION(('Gn137: B-spline curve precision asymmetry in split'),'2;1');
FILE_NAME('Gn137.stp','2026-06-16T00:00:00',('auto'),(''),
  'auto','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(0.5,0.5,0.0));
#12=CARTESIAN_POINT('p2',(1.0,0.2,0.0));
#13=CARTESIAN_POINT('p3',(1.5,0.8,0.0));
#14=CARTESIAN_POINT('p4',(2.0,0.3,0.0));
#15=CARTESIAN_POINT('p5',(2.5,0.6,0.0));
#16=CARTESIAN_POINT('p6',(3.0,0.0,0.0));
/* 7 poles, degree 3 => 7+3+1=11 knot multiplicities
   Distinct knots: [0.0, 0.33, 0.66, 1.0] (4 distinct)
   Multiplicities: (4, 2, 2, 3) = 11 total */
#100=B_SPLINE_CURVE_WITH_KNOTS('precision_asymmetry',3,
  (#10,#11,#12,#13,#14,#15,#16),
  .UNSPECIFIED.,.F.,.F.,
  (4,2,2,3),
  (0.0,0.33,0.66,1.0),
  .UNSPECIFIED.);
#101=CURVE('',#100);
#102=REPRESENTATION_ITEM('',#101);
#110=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#111=DIRECTION('dir',(1.0,0.0,0.0));
#112=VECTOR('vec',#111,1.0);
#113=LINE('ref_axis',#110,#112);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn137','Gn137','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('curve_set',(#101,#113));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
