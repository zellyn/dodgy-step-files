ISO-10303-21;
/* Gn090 - ShapeAnalysis_Curve.IsPlanar Z-NaN
   Defect: B-spline with one control point having Z=NaN. IsPlanar's pole
   sampling produces NaN result, which IEEE compare-with-zero returns false,
   incorrectly reporting the curve as planar. */
HEADER;
FILE_DESCRIPTION(('Gn090 - B-spline with NaN control point'),'2;1');
FILE_NAME('Gn090.stp','2026-06-15T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Degree-3 B-spline, 6 control points; middle point has Z=NaN */
#1=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#2=CARTESIAN_POINT('p1',(1.0,0.0,0.0));
#3=CARTESIAN_POINT('p2',(2.0,0.0,0.0));
#4=CARTESIAN_POINT('p3',(3.0,0.0,0.0));
#5=CARTESIAN_POINT('p4',(4.0,0.0,0.0));
#6=CARTESIAN_POINT('p5',(5.0,0.0,0.0));
/* Control point with NaN in Z coordinate (represented as a very large number
   to approximate NaN behavior in parser). Point #4 will cause IsPlanar to fail. */
#7=CARTESIAN_POINT('p_nan',(2.5,1.5,1.0E+100));
/* Degree-3 curve; knot vector clamped: (4,1,1,4) multiplicity
   The NaN value in pole #7 should be caught by validation but is missed
   by naive planar checks. */
#100=B_SPLINE_CURVE_WITH_KNOTS('curve_with_nan',
  3,
  (#1,#2,#7,#4,#5,#6),
  .UNSPECIFIED.,.F.,.F.,
  (4,1,1,4),
  (0.0,0.333,0.667,1.0),
  .UNSPECIFIED.);
/* Product chain */
#9000=PRODUCT_CONTEXT('',#200,'mechanical');
#9001=PRODUCT('Gn090','Gn090','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#200,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#100),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
#200=SI_UNIT($,.METRE.);
ENDSEC;
END-ISO-10303-21;
