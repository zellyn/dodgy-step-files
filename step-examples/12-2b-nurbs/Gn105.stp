ENDSEC;
DATA;
/* 5-point rational B-spline curve with coincident start/end poles */
#1001=CARTESIAN_POINT('p',(0.0,0.0,0.0));
#1002=CARTESIAN_POINT('p',(1.0,0.0,0.0));
#1003=CARTESIAN_POINT('p',(1.0,1.0,0.0));
#1004=CARTESIAN_POINT('p',(0.0,1.0,0.0));
#1005=CARTESIAN_POINT('p',(0.0,0.0,0.0));

/* Rational B-spline: coincident endpoints, weights[0]=1.0 weights[4]=0.5 */
#5000=B_SPLINE_CURVE_WITH_KNOTS('rational_closed',
  3,.T.,
  (#1001,#1002,#1003,#1004,#1005),
  (1.0,0.7,0.7,0.7,0.5),
  .UNSPECIFIED.,.F.,.F.,
  (4,1,1,3),
  (0.0,0.333,0.667,1.0),
  .UNSPECIFIED.);

#9000=PRODUCT_CONTEXT('',#1,'mechanical');
