ISO-10303-21;
/* Gn105 - rational-with-coincident-poles IsClosed
   Defect: ShapeAnalysis_Curve.IsClosed checks position only,
   ignoring weights on coincident poles. This 4-point loop has
   start/end at (0,0,0) with weights 1.0 vs 0.5: discontinuous
   but IsClosed returns true. */
HEADER;
FILE_DESCRIPTION(('Gn105 - rational-with-coincident-poles IsClosed'),'2;1');
FILE_NAME('Gn105.stp','2026-06-15T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
