ISO-10303-21;
/* Gn148: B_SPLINE_SURFACE_WITH_KNOTS knot vector ill-conditioning
   Defect: BSpline surface with clustered interior knots (bad knot ratio).
   Knot spacing [0, 0.001, 0.002, 0.98, 0.99, 1.0] creates extreme ratio.
   Numerical solvers fail due to near-singularity. Healing must detect and
   reparametrize with arc-length or uniform distribution. */
HEADER;
FILE_DESCRIPTION(('Gn148 - BSpline with ill-conditioned knot distribution'),'2;1');
FILE_NAME('Gn148.stp','2026-06-17T00:00:00',('auto'),(''),
  'auto','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 4x3 control net: 4 poles U, 3 poles V
   Degree: U=2, V=2 */
#10=CARTESIAN_POINT('p00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p01',(0.0,1.0,0.0));
#12=CARTESIAN_POINT('p02',(0.0,2.0,0.0));
#20=CARTESIAN_POINT('p10',(0.1,0.0,0.5));
#21=CARTESIAN_POINT('p11',(0.1,1.0,1.0));
#22=CARTESIAN_POINT('p12',(0.1,2.0,0.5));
#30=CARTESIAN_POINT('p20',(0.2,0.0,0.5));
#31=CARTESIAN_POINT('p21',(0.2,1.0,1.0));
#32=CARTESIAN_POINT('p22',(0.2,2.0,0.5));
#40=CARTESIAN_POINT('p30',(1.0,0.0,0.0));
#41=CARTESIAN_POINT('p41',(1.0,1.0,0.0));
#42=CARTESIAN_POINT('p42',(1.0,2.0,0.0));
/* Defect: U knot vector with extreme clustering. All interior knots packed near 0,
   rest compressed near 1. Ratio of interval [0, 0.001] to [0.99, 1.0] is > 1000:1.
   This ill-conditioning causes numerical instability in fitting, evaluation, and splitting.
   4 poles U, degree 2 => 4+2+1=7 knots needed
   Knots: (3,2,2) => 3+2+2=7 correct, but spacing is bad.
   Good spacing: (0, 0, 0, 0.33, 0.67, 1, 1, 1)
   Bad spacing: (0, 0, 0, 0.001, 0.002, 1, 1) <- high ratio
   V is normal: (0, 1, 1) for 2 internal => (3, 3) mults fine. */
#100=B_SPLINE_SURFACE_WITH_KNOTS('ill_knot_ratio',2,2,
  ((#10,#11,#12),(#20,#21,#22),(#30,#31,#32),(#40,#41,#42)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (3,2,2),
  (3,3),
  (0.0,0.0,0.0,0.001,0.002,1.0,1.0),
  (0.0,1.0),
  .UNSPECIFIED.);
#110=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#111=DIRECTION('dir',(1.0,0.0,0.0));
#112=VECTOR('vec',#111,1.0);
#113=LINE('ref_axis',#110,#112);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn148','Gn148','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('curve_set',(#113));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
