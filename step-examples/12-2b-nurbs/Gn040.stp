ISO-10303-21;
/* Gn040 - ShapeAnalysis_Curve.FillBndBox B-spline approximate-mode undersample
   Defect: a B_SPLINE_CURVE_WITH_KNOTS in approximate mode (2-point sampling)
   used for bounding box calculation misses the inflection extremum in an
   S-curve geometry. The linear parameter grid with only two samples fails
   to capture the peak Z-coordinate between the endpoints. */
HEADER;
FILE_DESCRIPTION(('Gn040 - BSpline approximate undersample extremum miss'',''2;1'',''2;1'),'2;1');
FILE_NAME('Gn040.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* S-curve: starts at (0,0,0), inflects with Z peak near parameter 0.5,
   ends at (1,1,0). Control points designed to produce high curvature
   at the inflection but low curvature at endpoints. */
#10=CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p2',(0.3,0.3,2.0));
#12=CARTESIAN_POINT('p3',(0.7,0.7,2.0));
#13=CARTESIAN_POINT('p4',(1.0,1.0,0.0));
/* Degree-2 B-spline with 4 control points. Knot multiplicity vector sums
   to 4+2+1=7. Clamped endpoints. */
#100=B_SPLINE_CURVE_WITH_KNOTS('s_curve',2,
  (#10,#11,#12,#13),
  .UNSPECIFIED.,.F.,.F.,
  (3,1,3),
  (0.0,0.5,1.0),
  .UNSPECIFIED.);
/* PRODUCT chain wrapping wireframe. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn040','Gn040','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#100));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
