ISO-10303-21;
/* Gn162 - B-spline curve with repeated interior knot at degree+1 multiplicity.
   Defect: Degree 3, 6 poles, interior knot with multiplicity 4 (full clamping).
   At interior point, this creates a geometric discontinuity.
   Falsifiable: Knot removal or smoothing must detect and repair interior
   over-multiplicity that causes C^-1 or worse continuity. */
HEADER;
FILE_DESCRIPTION(('Gn162 - B-spline curve with interior knot multiplicity=degree+1'),'2;1');
FILE_NAME('Gn162.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 6 poles, degree 3, clamped at boundaries + one interior clamping
   Degree 3, 6 poles => sum(mult) = 6+3+1 = 10
   Multiplicities: (4, 4, 2) => sum=10. Three distinct knot values. */
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(1.0,0.3,0.0));
#12=CARTESIAN_POINT('p2',(2.0,0.8,0.0));
#13=CARTESIAN_POINT('p3',(3.0,0.6,0.0));
#14=CARTESIAN_POINT('p4',(4.0,0.4,0.0));
#15=CARTESIAN_POINT('p5',(5.0,0.0,0.0));
/* Knots: (0,0,0,0, 0.5,0.5,0.5,0.5, 1,1,1) with multiplicities (4,4,3)
   Interior knot at 0.5 has full degree+1 multiplicity => discontinuity */
#100=B_SPLINE_CURVE_WITH_KNOTS('interior_clamp',3,
  (#10,#11,#12,#13,#14,#15),
  .UNSPECIFIED.,.F.,.F.,
  (4,4,2),
  (0.0,0.0,0.0,0.0,0.5,0.5,0.5,0.5,1.0,1.0,1.0),
  .UNSPECIFIED.);
#110=CARTESIAN_POINT('origin',(0.0,-1.0,0.0));
#111=DIRECTION('dir',(0.0,1.0,0.0));
#112=VECTOR('vec',#111,1.0);
#113=LINE('ref_axis',#110,#112);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn162','Gn162','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('curve_set',(#100,#113));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
