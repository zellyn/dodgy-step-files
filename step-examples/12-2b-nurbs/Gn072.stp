ISO-10303-21;
/* Gn072 - ShapeUpgrade_SplitSurface explicit-knot-spec mismatch
   Defect: B-spline surface declares .UNIFORM_KNOTS. but knot vectors have
   non-uniform spacing. Init() follows the tag and produces incorrect splits
   because actual spacing contradicts declared uniformity. */
HEADER;
FILE_DESCRIPTION(('Gn072 - B-spline surface knot uniformity mismatch','2;1');
FILE_NAME('Gn072.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 3D B-spline surface. Degree (2,2), 4x4 poles.
   U-knots declared UNIFORM but actually non-uniform.
   V-knots uniform. */
#10=CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p2',(1.0,0.0,0.5));
#12=CARTESIAN_POINT('p3',(2.0,0.0,1.0));
#13=CARTESIAN_POINT('p4',(3.0,0.0,0.5));
