ISO-10303-21;
/* Gn059 - ShapeAnalysis_Curve.FillBndBox SearchForExtremum drift
   Defect: Non-uniform B-spline where the extremum search uses a fixed step
   that overshoots the peak; resulting bbox is too small at the peak.
   The curve has a sharp peak at u=0.5 with weight concentration that
   requires adaptive sampling, but fixed-step search misses it. */
HEADER;
FILE_DESCRIPTION(('Gn059 - SearchForExtremum bbox drift on non-uniform B-spline','2;1');
FILE_NAME('Gn059.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Non-uniform rational B-spline (NURBS) with degree 3, 6 control points.
   Midpoint (#13) has Y-coordinate 5.0, creating a sharp peak.
   Weights concentrate at midpoint to amplify the peak curvature. */
#10=CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p2',(1.0,1.0,0.0));
#12=CARTESIAN_POINT('p3',(2.0,2.5,0.0));
/* Defect: sharp peak at u=0.5 with weight 2.0 to pull curve upward. */
#13=CARTESIAN_POINT('p4',(3.0,5.0,0.0));
#14=CARTESIAN_POINT('p5',(4.0,2.5,0.0));
#15=CARTESIAN_POINT('p6',(5.0,1.0,0.0));
/* Degree 3, 6 control points: knot vector length = 6+3+1 = 10.
   Non-uniform knots at [0, 0, 0, 0, 0.3, 0.7, 1, 1, 1, 1].
   Multiplicities: (4,1,1,1,4) sum to 11, but we need 10.
   Correct: (4,1,1,1,1,2) sum to 10. */
#100=B_SPLINE_CURVE_WITH_KNOTS('extremum_drift',3,
  (#10,#11,#12,#13,#14,#15),
  .UNSPECIFIED.,.F.,.F.,
  (4,1,1,1,1,2),
  (0.0,0.3,0.6,0.7,1.0,1.0),
  .UNSPECIFIED.);
/* PRODUCT chain wrapping wireframe. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn059','Gn059','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#100));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
