ISO-10303-21;
/* Gn101 - ShapeAnalysis_Curve.IsClosed COMPOSITE_CURVE with-discontinuity
   Defect: COMPOSITE_CURVE with 3 segments where segment 2 doesn't start
   where segment 1 ends (discontinuity gap). IsClosed only checks endpoints
   (first-to-last), ignoring segment-to-segment continuity. Misses internal gap. */
HEADER;
FILE_DESCRIPTION(('Gn101 - Composite curve with internal discontinuity'),'2;1');
FILE_NAME('Gn101.stp','2026-06-15T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Segment 1: line from (0,0) to (1,0). */
#10=CARTESIAN_POINT('start',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('seg1_end',(1.0,0.0,0.0));
#20=LINE('line1',#10,#11);
/* Segment 2: line from (1.1,0.1) to (2,0) -- DISCONTINUOUS START! */
#12=CARTESIAN_POINT('seg2_start',(1.1,0.1,0.0));
#13=CARTESIAN_POINT('seg2_end',(2.0,0.0,0.0));
#21=LINE('line2',#12,#13);
/* Segment 3: line from (2,0) to (0,0) -- loops back to start. */
#14=CARTESIAN_POINT('seg3_start',(2.0,0.0,0.0));
#15=CARTESIAN_POINT('end',(0.0,0.0,0.0));
#22=LINE('line3',#14,#15);
/* Composite curve with segments but gap between seg1/seg2 endpoints.
   IsClosed checks only first(0,0) == last(0,0) -> true, misses the gap. */
#100=COMPOSITE_CURVE('gapped_loop',
  (#20,#21,#22),
  .F.,
  .UNSPECIFIED.);
/* PRODUCT chain. */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn101','Gn101','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('wire_set',(#100));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
