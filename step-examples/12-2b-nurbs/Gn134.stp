ISO-10303-21;
/* Gn134: B-SPLINE_SURFACE_WITH_KNOTS weight array all-unit propagation
   Defect: Surface with 6 control points (3x2 grid) over degree 2/1.
   All weights = 1.0 (rational NURBS), but ConvertSurfaceToBezierBasis
   may fail to preserve or validate weight consistency across patches.
   Knot vector: U=(3,1,3), V=(2,2) means 6 poles in u-dir and 2 in v-dir.
   Intent: expose weight propagation bug in Bezier conversion. */
HEADER;
FILE_DESCRIPTION(('Gn134: NURBS weight array uniform propagation edge case'),'2;1');
FILE_NAME('Gn134.stp','2026-06-16T00:00:00',('auto'),(''),
  'auto','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#10=CARTESIAN_POINT('p00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p01',(0.0,1.0,0.0));
#12=CARTESIAN_POINT('p10',(1.0,0.0,0.5));
#13=CARTESIAN_POINT('p11',(1.0,1.0,0.5));
#14=CARTESIAN_POINT('p20',(2.0,0.0,0.0));
#15=CARTESIAN_POINT('p21',(2.0,1.0,0.0));
/* 3x2 grid, degree 2 u, degree 1 v
   U: 6 poles, degree 2 => 6+2+1=9 knot multiplicities => (3,1,1,1,3)
   V: 2 poles, degree 1 => 2+1+1=4 knot multiplicities => (2,2) */
#100=B_SPLINE_SURFACE_WITH_KNOTS('weight_propagation',2,1,
  ((#10,#11),(#12,#13),(#14,#15),(#10,#11),(#12,#13),(#14,#15)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (3,1,1,1,3),
  (2,2),
  (0.0,0.333,0.667,1.0),
  (0.0,1.0),
  .UNSPECIFIED.);
#101=SURFACE('',#100);
#102=REPRESENTATION_ITEM('',#101);
#110=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#111=DIRECTION('dir',(1.0,0.0,0.0));
#112=VECTOR('vec',#111,1.0);
#113=LINE('ref_axis',#110,#112);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn134','Gn134','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('curve_set',(#113));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
