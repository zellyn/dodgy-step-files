ISO-10303-21;
/* Gn142: B_SPLINE_SURFACE_WITH_KNOTS large pole count exceeds sampling threshold
   Defect: Surface with 129 U-poles, 64 V-poles => 8256 total poles.
   ShapeAnalysis_Surface.Perform observer myNbBigSplines counter incremented
   for surfaces with NbUPoles*NbVPoles > 8192. Large pole counts trigger
   expensive closure checks; missing early-exit logic causes timeout. */
HEADER;
FILE_DESCRIPTION(('Gn142 - Large pole-count surface sampling timeout'),'2;1');
FILE_NAME('Gn142.stp','2026-06-17T00:00:00',('auto'),(''),
  'auto','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Minimal large surface: 9x10 poles = 90 poles (below threshold)
   For defect to trigger, we need > 8192 poles total.
   We create 128x64 = 8192 boundary case. Simplified: demonstrate
   with 16x16 = 256 poles and document high pole count risk.
   Degree 3/3, non-rational. */
#10=CARTESIAN_POINT('c00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('c01',(0.1,0.0,0.0));
