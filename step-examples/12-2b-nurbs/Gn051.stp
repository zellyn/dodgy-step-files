ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Gn051: ShapeAnalysis_Curve.GetSamplePoints offset/trimmed recursion depth'),'2;1');
FILE_NAME('Gn051.stp','',(''),(''),'',' ','');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
#1=MECHANICAL_DESIGN_GEOMETRIC_PRESENTATION_REPRESENTATION('',(#9022),#9010);
/* Curve nesting: OFFSET_CURVE wraps TRIMMED_CURVE wraps B_SPLINE_CURVE.
   GetSamplePoints recursion picks wrong sample density when traversing
   nesting depth; offset distance 0.5mm on trimmed span [0.25, 0.75]. */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(2.0,1.5,0.0));
#12=CARTESIAN_POINT('',(4.0,2.0,0.0));
#13=CARTESIAN_POINT('',(6.0,1.0,0.0));
#14=CARTESIAN_POINT('',(8.0,0.0,0.0));
#20=DIRECTION('',(0.0,0.0,1.0));
/* Base B-spline curve */
#100=B_SPLINE_CURVE_WITH_KNOTS('Gn051_base',
  2,
  (#10,#11,#12,#13,#14),
  .UNSPECIFIED.,
  .F.,
  .F.,
  (3,1,1,1,3),
  (0.0,0.0,0.0,0.333333,0.666667,1.0,1.0,1.0),
  .UNSPECIFIED.);
/* Trim to [0.25, 0.75] */
#101=TRIMMED_CURVE('Gn051_trimmed',#100,.T.,.T.,0.25,0.75);
/* Offset by 0.5mm perpendicular to Z plane */
#102=OFFSET_CURVE('Gn051_offset',#101,0.5,#20);
#103=CURVE_3D(#102);
#104=REPRESENTATION_ITEM('',#103);
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gn051','Gn051','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#104),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
