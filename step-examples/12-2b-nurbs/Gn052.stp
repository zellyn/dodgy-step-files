ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Gn052: ShapeUpgrade_ConvertSurfaceToBezierBasis knot-multiplicity boundary insertion'),'2;1');
FILE_NAME('Gn052.stp','',(''),(''),'',' ','');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
#1=MECHANICAL_DESIGN_GEOMETRIC_PRESENTATION_REPRESENTATION('',(#9022),#9010);
/* B-spline surface with interior knot where multiplicity == degree (C0 continuity).
   ConvertSurfaceToBezierBasis should NOT subdivide further at this knot boundary,
   but current code re-inserts and creates spurious splits. Degree=3, interior knot
   multiplicity=3 at V=0.5. */
#10=CARTESIAN_POINT('p00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p01',(0.0,1.0,0.0));
#12=CARTESIAN_POINT('p02',(0.0,2.0,0.0));
#13=CARTESIAN_POINT('p03',(0.0,3.0,0.0));
#20=CARTESIAN_POINT('p10',(1.0,0.0,0.0));
#21=CARTESIAN_POINT('p11',(1.0,1.0,0.5));
#22=CARTESIAN_POINT('p12',(1.0,2.0,0.5));
#23=CARTESIAN_POINT('p13',(1.0,3.0,0.0));
#30=CARTESIAN_POINT('p20',(2.0,0.0,0.0));
#31=CARTESIAN_POINT('p21',(2.0,1.0,0.5));
#32=CARTESIAN_POINT('p22',(2.0,2.0,0.5));
#33=CARTESIAN_POINT('p23',(2.0,3.0,0.0));
#40=CARTESIAN_POINT('p30',(3.0,0.0,0.0));
#41=CARTESIAN_POINT('p31',(3.0,1.0,0.0));
#42=CARTESIAN_POINT('p32',(3.0,2.0,0.0));
#43=CARTESIAN_POINT('p33',(3.0,3.0,0.0));
/* V multiplicity (4,3,4) at knots (0,0.5,1) with degree 3 creates C0 boundary.
   U is simple (4,1,3) Bezier-like. U knots: (4+1+3)=8, V knots: (4+3+4)=11. */
#100=B_SPLINE_SURFACE_WITH_KNOTS('Gn052_c0_interior',
  3,3,
  ((#10,#11,#12,#13),(#20,#21,#22,#23),(#30,#31,#32,#33),(#40,#41,#42,#43)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (4,1,3),
  (4,3,4),
  (0.0,0.0,0.0,0.0,0.5,1.0,1.0,1.0),
  (0.0,0.5,0.5,0.5,1.0),
  .UNSPECIFIED.);
#101=SURFACE('',#100);
#102=REPRESENTATION_ITEM('',#101);
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Gn052','Gn052','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('',(#102),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
