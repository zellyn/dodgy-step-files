ISO-10303-21;
/* Gn077 - ShapeAnalysis_Curve.IsClosed direction-reversed self-intersection
   Defect: B-spline curve with control polygon [P0,P1,P2,P3,P4,P0] where
   the last pole matches the first (closing), but internal direction reversal
   at P2 causes the curve to cross itself. IsClosed reports closed but misses
   the self-intersection. */
HEADER;
FILE_DESCRIPTION(('Gn077 - IsClosed with self-intersecting direction reversal'',''2;1'',''2;1'),'2;1');
FILE_NAME('Gn077.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* B-spline curve with control points forming a closed loop but with
   direction reversal causing self-intersection. P0=(0,0,0), P1=(2,1,0),
   P2=(1,-1,0) [direction reversal], P3=(2,-1,0), P4=(0,0,0) [closed].
   The curve crosses itself between P1 and P2/P3. */
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(2.0,1.0,0.0));
#12=CARTESIAN_POINT('p2',(1.0,-1.0,0.0));
#13=CARTESIAN_POINT('p3',(2.0,-1.0,0.0));
#14=CARTESIAN_POINT('p4',(0.0,0.0,0.0));
/* Degree-2 B-spline with 5 control points.
   Knot multiplicities (3,1,1,3) sum to 8 = 5+2+1. */
#100=B_SPLINE_CURVE_WITH_KNOTS('self_intersecting_closed',2,
  (#10,#11,#12,#13,#14),
  .UNSPECIFIED.,.F.,.T.,
  (3,1,1,3),
  (0.0,0.0,0.0,0.33,0.67,1.0,1.0,1.0),
  .UNSPECIFIED.);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn077','Gn077','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#100),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
