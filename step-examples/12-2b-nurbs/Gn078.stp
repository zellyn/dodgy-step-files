ISO-10303-21;
/* Gn078 - ShapeUpgrade_ConvertCurve2dToBezier double-degree-elevation knot error
   Defect: 2D B-spline degree 2 elevated to degree 4 in single pass (skip step).
   The algorithm assumes single-step elevation and produces wrong knots.
   Correct path: degree 2→3→4 (two steps); incorrect: 2→4 (direct). */
HEADER;
FILE_DESCRIPTION(('Gn078 - 2D curve double-degree elevation knot error','2;1');
FILE_NAME('Gn078.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 2D B-spline curve degree 2 with 6 control points that will be elevated
   to degree 4. Knot vector for degree 2: multiplicities (3,1,1,1,3)
   sum to 9 = 6+2+1. When elevated to degree 4, multiplicities should
   become (5,2,2,2,5) summing to 16 = 6+4+1+5. */
#10=CARTESIAN_POINT('p0',(0.0,0.0));
#11=CARTESIAN_POINT('p1',(1.0,0.5));
#12=CARTESIAN_POINT('p2',(2.0,1.5));
#13=CARTESIAN_POINT('p3',(3.0,1.2));
#14=CARTESIAN_POINT('p4',(4.0,0.5));
#15=CARTESIAN_POINT('p5',(5.0,0.0));
/* Degree-2 B-spline in 2D with 6 control points.
   Knot vector: (0,0,0, 0.25,0.5,0.75, 1,1,1) */
#100=B_SPLINE_CURVE_WITH_KNOTS('degree2_2d_curve',2,
  (#10,#11,#12,#13,#14,#15),
  .UNSPECIFIED.,.F.,.F.,
  (3,1,1,1,3),
  (0.0,0.0,0.0,0.25,0.5,0.75,1.0,1.0,1.0),
  .UNSPECIFIED.);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn078','Gn078','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#100),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
