ISO-10303-21;
/* Gn087: B_SPLINE_SURFACE_WITH_KNOTS (degree 2x2, 3x3 control net); U-knot vector starts with -0.0 instead of 0.0; SetUSplitValues dedup does not treat -0.0 == 0.0; spurious split at boundary; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Gn087'),'2;1');
FILE_NAME('Gn087.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
