ISO-10303-21;
/* Gn087 - ShapeUpgrade_SplitSurface.SetUSplitValues neg-zero defect
   Defect: split values array contains -0.0; dedup logic doesn't treat -0.0 == 0.0
   and produces an extra knot at the boundary. Fixture: degree-(2,2) B-spline
   surface with U split values [0.0, -0.0, 0.5, 1.0]; a compliant deduplicator
   should reduce to [0.0, 0.5, 1.0] but naive float comparison fails. */
HEADER;
FILE_DESCRIPTION(('Gn087 - Negative-zero split boundary'),'2;1');
FILE_NAME('Gn087.stp','2026-06-15T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
