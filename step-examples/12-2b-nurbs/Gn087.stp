#31=CARTESIAN_POINT('p21',(2.0,1.0,0.0));
#32=CARTESIAN_POINT('p22',(2.0,2.0,0.0));
/* Degree-(2,2) B-spline; U and V are [0.0, 0.5, 1.0], strictly ordered */
#100=B_SPLINE_SURFACE_WITH_KNOTS('neg_zero_split',
  2,2,
  ((#10,#11,#12),(#20,#21,#22),(#30,#31,#32)),
  .UNSPECIFIED.,.F.,.F.,.F.,
  (3,3),
  (3,3),
  (0.0,0.5,1.0),
  (0.0,0.5,1.0),
  .UNSPECIFIED.);
#9000=PRODUCT_CONTEXT('',#200,'mechanical');
