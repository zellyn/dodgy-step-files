ISO-10303-21;
/* Gn152 - B-spline with knot ratio anomaly after C0->C1 upgrade
   Defect: After Geom2dConvert::C0BSplineToC1 upgrade, knot spacing becomes
   highly non-uniform with ratio > 10 between consecutive intervals.
   This ill-conditioning causes numerical instability. Healing must detect
   via IsBad flag and trigger arc-length reparametrization.
   Curve: degree 2, 6 poles, clustered interior knots pre-upgrade.
*/
HEADER;
FILE_DESCRIPTION(('Gn152 - B-spline knot ratio anomaly post-C0->C1'),'2;1');
FILE_NAME('Gn152.stp','2026-06-17T00:00:00',('auto'),(''),
  'auto','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 6 control points */
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(0.1,0.5,0.0));
#12=CARTESIAN_POINT('p2',(0.2,0.6,0.0));
#13=CARTESIAN_POINT('p3',(0.3,0.1,0.0));
#14=CARTESIAN_POINT('p4',(0.8,0.4,0.0));
#15=CARTESIAN_POINT('p5',(1.0,0.0,0.0));
/* Defect: Knot vector with clustered interior knots.
   Degree: 2, poles: 6 => sum(mults) = 6 + 2 + 1 = 9 required
   Knots: (3, 3, 2, 1) => 3+3+2+1=9 correct
   Values: (0, 0, 0, 0.01, 0.02, 0.95, 1, 1, 1)
   After initial C0->C1 pass, interior knots would cluster further:
   [0, 0, 0, 0.005, 0.015, 0.98, 1, 1, 1]
   Ratio of [0.01, 0.02] interval to [0.98, 1.0] is ~100:1, triggers IsBad.
   Healing must apply arc-length reparametrization (Approx_CurvilinearParameter). */
#100=B_SPLINE_CURVE_WITH_KNOTS('knot_ratio_anomaly',2,
  (#10,#11,#12,#13,#14,#15),
  .UNSPECIFIED.,.F.,.F.,
  (3,3,2,1),
  (0.0,0.0,0.0,0.01,0.02,0.95,1.0,1.0,1.0),
  .UNSPECIFIED.);
/* Reference LINE for PRODUCT chain */
#110=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#111=DIRECTION('dir',(1.0,0.0,0.0));
#112=VECTOR('vec',#111,1.0);
#113=LINE('ref_axis',#110,#112);
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn152','Gn152','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#9990,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=GEOMETRIC_CURVE_SET('curve_set',(#113));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
