ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Test case for Gn064: Periodic B-spline curve with non-closing control polygon'),2000);
FILE_NAME('Gn064.stp','2026-06-15T00:00:00Z',(''),(''),('CAD Kernel Test','1.0'),(''));
FILE_SCHEMA(('IFC2X3'));
ENDSEC;
DATA;
#1=SI_UNIT(*,.METRE.);
#2=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#3=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#4=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#5=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#2,'distance_accuracy_value','');
#6=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#5))GLOBAL_UNIT_ASSIGNED_CONTEXT((#2,#3,#4))REPRESENTATION_CONTEXT('','3D'));
#7=B_SPLINE_CURVE_WITH_KNOTS('periodic_non_closing',3,.T.,.T.,
(#10,#11,#12,#13,#14),
((2,2,2,2,2)),
(0.,1.,2.,3.,4.),
.F.,
.T.);
#10=CARTESIAN_POINT('',(0.,0.,0.));
#11=CARTESIAN_POINT('',(1.,0.,0.));
#12=CARTESIAN_POINT('',(1.,1.,0.));
#13=CARTESIAN_POINT('',(0.,1.,0.));
#14=CARTESIAN_POINT('',(0.5,0.,0.));
#100=PRODUCT_CONTEXT('',#1,'mechanical');
#101=PRODUCT('Gn064','Gn064','',(#100));
#102=PRODUCT_DEFINITION_FORMATION('','',#101);
#103=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#104=PRODUCT_DEFINITION('','',#102,#103);
#105=PRODUCT_DEFINITION_SHAPE('','',#104);
#106=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#107=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#108=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#109=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#106,'distance_accuracy_value','');
#110=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#109))GLOBAL_UNIT_ASSIGNED_CONTEXT((#106,#107,#108))REPRESENTATION_CONTEXT('','3D'));
#120=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#7),#110);
#121=SHAPE_DEFINITION_REPRESENTATION(#105,#120);
ENDSEC;
END-ISO-10303-21;
