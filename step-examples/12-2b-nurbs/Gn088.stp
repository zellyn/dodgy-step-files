ISO-10303-21;
/* Gn088 - ShapeAnalysis_Curve.IsClosed B-spline open-via-knots defect
   Defect: B-spline whose control polygon closes (first and last poles match)
   but the knot vector is clamped at the endpoints with multiplicity = degree+1,
   making the curve intentionally open. IsClosed checks polygon closure without
   verifying knot parameterization. Fixture: degree-3 B-spline with 6 control
   points, first and last coincident at origin, but knot multiplicities 4,1,1,4. */
HEADER;
FILE_DESCRIPTION(('Gn088 - B-spline polygon-closed but knot-open'),'2;1');
FILE_NAME('Gn088.stp','2026-06-15T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Degree-3 B-spline, 6 control points; first and last are the same (origin) */
#1=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#2=CARTESIAN_POINT('p1',(1.0,0.0,0.0));
#3=CARTESIAN_POINT('p2',(1.5,1.0,0.0));
#4=CARTESIAN_POINT('p3',(1.0,2.0,0.0));
#5=CARTESIAN_POINT('p4',(0.0,2.0,0.0));
#6=CARTESIAN_POINT('p5',(0.0,0.0,0.0));
/* Degree-3 curve; knot vector clamped: (4, 1, 1, 4) multiplicities
   Control polygon closes but the clamped knots mean the curve does not
   form a closed loop (start ≠ end in parametric sense). */
#100=B_SPLINE_CURVE_WITH_KNOTS('polygon_closed_knots_open',
  3,
  (#1,#2,#3,#4,#5,#6),
  .UNSPECIFIED.,.F.,.F.,
  (4,1,1,4),
  (0.0,0.333,0.667,1.0),
  .UNSPECIFIED.);
#9000=PRODUCT_CONTEXT('',#200,'mechanical');
#9001=PRODUCT('Gn088','Gn088','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#200,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#100),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
#200=SI_UNIT($,.METRE.);
ENDSEC;
END-ISO-10303-21;
