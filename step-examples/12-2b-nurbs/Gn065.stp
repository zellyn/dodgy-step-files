ISO-10303-21;
/* Gn065: nested TRIMMED B-spline inside COMPOSITE_CURVE */
HEADER;
FILE_DESCRIPTION(('Gn065'),'2;1');
FILE_NAME('Gn065.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=CARTESIAN_POINT('',(1.0,1.0,0.0));
#3=CARTESIAN_POINT('',(2.0,0.0,0.0));
#4=B_SPLINE_CURVE_WITH_KNOTS('inner1',2,(#1,#2,#3),.UNSPECIFIED.,.F.,.F.,(3,3),(0.0,1.0),.UNSPECIFIED.);
#5=TRIMMED_CURVE('trim1_wraps_inner1',#4,(PARAMETER_VALUE(0.0)),(PARAMETER_VALUE(1.0)),.T.,.PARAMETER.);
#6=CARTESIAN_POINT('',(2.0,0.0,0.0));
#7=CARTESIAN_POINT('',(3.0,-1.0,0.0));
#8=CARTESIAN_POINT('',(4.0,0.0,0.0));
#9=B_SPLINE_CURVE_WITH_KNOTS('inner2',2,(#6,#7,#8),.UNSPECIFIED.,.F.,.F.,(3,3),(0.0,1.0),.UNSPECIFIED.);
#10=TRIMMED_CURVE('trim2_wraps_inner2',#9,(PARAMETER_VALUE(0.0)),(PARAMETER_VALUE(1.0)),.T.,.PARAMETER.);
#11=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#5);
#12=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#10);
#13=COMPOSITE_CURVE('nested_recursion',(#11,#12),.F.);
#14=GEOMETRIC_CURVE_SET('cset',(#13));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Gn065','Gn065','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#14),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
