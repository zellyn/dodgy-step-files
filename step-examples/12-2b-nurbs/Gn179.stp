ISO-10303-21;
/* Gn179: SURFACE_OF_REVOLUTION whose swept curve is a straight LINE parallel to the revolution
   axis (offset radius 3.0) -- an exact cylinder authored via the generic swept-surface entity
   rather than CYLINDRICAL_SURFACE; a consumer requiring canonical elementary-surface form cannot
   recognize this as a cylinder without conversion; exercises ShapeCustom_SweptToElementary's
   SurfaceOfRevolution+Line->Geom_CylindricalSurface branch; the inverse direction of Gn178 and
   the genuinely-swept-source variant that N030/Gn015 (B-spline generatrix sources) don't cover */
HEADER;
FILE_DESCRIPTION(('Gn179'),'2;1');
FILE_NAME('Gn179.stp','2026-07-13T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
