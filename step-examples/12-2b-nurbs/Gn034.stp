ISO-10303-21;
/* Gn034 - B-spline knots too close together (insufficient separation)
 * Defect: a B_SPLINE_CURVE_WITH_KNOTS has consecutive knot values
 * differing by less than the kernel's parametric epsilon. Evaluation
 * at parameter t in that gap is unstable. */
HEADER;
FILE_DESCRIPTION(('Gn034 test case','B-spline knots too close together (insufficient separation)'),'2;1');
FILE_NAME('Gn034.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* B-spline curve with two knots at distance 1e-12 */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=VERTEX_POINT('',#20);
#22=CARTESIAN_POINT('',(10.0,0.0,0.0));
#23=VERTEX_POINT('',#22);
#24=CARTESIAN_POINT('',(2.5,0.5,0.0));
#25=CARTESIAN_POINT('',(5.0,1.0,0.0));
#26=CARTESIAN_POINT('',(7.5,0.5,0.0));
/* Two knots almost equal: 0.5 and 0.5+1e-12 */
#30=B_SPLINE_CURVE_WITH_KNOTS('',2,(#20,#24,#25,#26,#22),.UNSPECIFIED.,
  .F.,.F.,(3,1,1,3),(0.0,0.5,0.500000000001,1.0),.UNSPECIFIED.);
#50=EDGE_CURVE('',#21,#23,#30,.T.);
#60=ORIENTED_EDGE('',*,*,#50,.T.);
#70=EDGE_LOOP('',(#60));
#71=FACE_OUTER_BOUND('',#70,.T.);
#72=ADVANCED_FACE('',(#71),#14,.T.);
ENDSEC;
END-ISO-10303-21;
