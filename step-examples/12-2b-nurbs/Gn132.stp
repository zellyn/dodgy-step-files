ISO-10303-21;
/* Gn132 - Geom_BSplineCurve.IncreaseDegree weight-redistribution asymmetry
   Defect: Rational B-spline curve degree 2, 4 poles, with non-uniform
   weights [1.0, 2.0, 1.5, 1.0]. IncreaseDegree to degree 3 inserts
   new control points via Oslo algorithm. Weight redistribution is not
   properly scaled, causing geometric shift and loss of continuity.
   Poles: (0,0,0) -> (1,2,0) -> (2,1,0) -> (3,0,0)
   Weights: [1.0, 2.0, 1.5, 1.0]
   Knots: [0,0,0, 0.5, 1,1,1] */
HEADER;
FILE_DESCRIPTION(('Gn132 - B-spline rational curve weight redistribution asymmetry'),'2;1');
FILE_NAME('Gn132.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 4 control points, degree 2, rational (weighted) */
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(1.0,2.0,0.0));
#12=CARTESIAN_POINT('p2',(2.0,1.0,0.0));
#13=CARTESIAN_POINT('p3',(3.0,0.0,0.0));
/* Rational B-spline with non-uniform weights */
#100=B_SPLINE_CURVE_WITH_KNOTS('rational_degree2',2,
  (#10,#11,#12,#13),
  .UNSPECIFIED.,.F.,.F.,
  (3,1,1,3),
  (0.0,0.0,0.0,0.5,1.0,1.0,1.0),
  (1.0,2.0,1.5,1.0));
/* LINE (3-arg form) as reference */
#110=CARTESIAN_POINT('line_pt',(0.0,0.0,0.0));
#111=DIRECTION('line_d',(1.0,0.0,0.0));
#112=VECTOR('line_v',#111,3.0);
#113=LINE('ref_line',#110,#112);
/* PRODUCT chain */
#9990=APPLICATION_CONTEXT('automotive_design');
#9000=PRODUCT_CONTEXT('',#9990,'mechanical');
#9001=PRODUCT('Gn132','Gn132','',(#9000));
