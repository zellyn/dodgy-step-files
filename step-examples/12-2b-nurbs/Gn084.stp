ISO-10303-21;
/* Gn084 - ShapeAnalysis_Curve.IsPlanar tolerance-zero defect
   Defect: IsPlanar called with tolerance=0 (strict planarity check). The
   implementation uses tolerance > 0 in comparisons and returns false for any
   non-trivial floating-point deviation, even from well-formed plane curves.
   A 3D B-spline that analytically lies in the XY plane (z=0) but with z-values
   that are tiny non-zero (±1e-12) should return true with zero tolerance only
   if exact; this fixture exploits the boundary behavior. */
HEADER;
FILE_DESCRIPTION(('Gn084 - IsPlanar tolerance-zero boundary'),'2;1');
FILE_NAME('Gn084.stp','2026-06-15T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#2=CARTESIAN_POINT('p1',(1.0,0.0,1e-12));
#3=CARTESIAN_POINT('p2',(2.0,1.0,0.0));
#4=CARTESIAN_POINT('p3',(3.0,2.0,-1e-12));
#5=CARTESIAN_POINT('p4',(4.0,3.0,0.0));
/* Degree-2 B-spline curve: control points near XY plane with z deviations < 1e-11 */
#100=B_SPLINE_CURVE_WITH_KNOTS('planar_z_drift',
  2,
  (#1,#2,#3,#4,#5),
  .UNSPECIFIED.,.F.,.F.,
  (3,1,1,3),
  (0.0,0.5,1.0),
  .UNSPECIFIED.);
#9000=PRODUCT_CONTEXT('',#10,'mechanical');
#9001=PRODUCT('Gn084','Gn084','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#10,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#100),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
#10=SI_UNIT($,.METRE.);
ENDSEC;
END-ISO-10303-21;
