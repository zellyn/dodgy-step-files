ISO-10303-21;
/* Gn133 - ShapeAnalysis_Curve.CheckOffsetCurve knot-ratio-overflow
   Defect: B-spline curve 9 poles, degree 3, knot vector with extreme
   outlier spacings: [0, 0, 0, 0, 0.01, 0.5, 0.51, 1, 1, 1, 1, 1].
   CheckOffsetCurve evaluates each segment. Knot-ratio > 100.
   Degenerate segment (0.5 to 0.51) causes offset evaluation to fail
   or produce invalid tangent.
   Poles concentrated in [0, 0.01] and [0.5, 0.51], sparse [0.01, 0.5] */
HEADER;
FILE_DESCRIPTION(('Gn133 - B-spline curve knot-ratio overflow degenerate segment'),'2;1');
FILE_NAME('Gn133.stp','2026-06-16T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* 9 control points, degree 3 */
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(0.005,0.01,0.0));
#12=CARTESIAN_POINT('p2',(0.01,0.005,0.0));
#13=CARTESIAN_POINT('p3',(0.25,0.25,0.0));
#14=CARTESIAN_POINT('p4',(0.4,0.3,0.0));
#15=CARTESIAN_POINT('p5',(0.5,0.01,0.0));
#16=CARTESIAN_POINT('p6',(0.501,0.02,0.0));
#17=CARTESIAN_POINT('p7',(0.75,0.5,0.0));
#18=CARTESIAN_POINT('p8',(1.0,0.0,0.0));
/* B-spline with extreme knot-ratio anomalies
   9 poles, degree 3 => need 9+3+1 = 13 knot values
   Distinct knots: [0.0, 0.01, 0.5, 0.51, 1.0] (5 distinct)
   Multiplicities: (4, 1, 1, 1, 4) => sum = 11, still need 13
   Need to adjust: (4, 2, 2, 2, 3) = 13? Or keep interior at (1,1,1)
   Solution: multiplicities (4, 1, 1, 1, 1, 1, 1, 1, 4) with 9 distinct values */
#100=B_SPLINE_CURVE_WITH_KNOTS('knot_ratio_overflow',3,
  (#10,#11,#12,#13,#14,#15,#16,#17,#18),
  .UNSPECIFIED.,.F.,.F.,
  (4,1,1,1,1,1,1,1,4),
  (0.0,0.01,0.2,0.5,0.51,0.75,0.875,0.9375,1.0),
  .UNSPECIFIED.);
/* LINE (3-arg form) for structure */
#110=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#111=DIRECTION('dir',(1.0,0.0,0.0));
#112=VECTOR('vec',#111,1.0);
#113=LINE('ref_axis',#110,#112);
