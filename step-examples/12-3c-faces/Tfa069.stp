ISO-10303-21;
/* Tfa069 - Lettering bottoms not closed in exported STEP.
 * Defect (FreeCAD #20588): each glyph's pocket-floor face emits an
 * EDGE_LOOP that is one edge short -- the floor has only 3 of the
 * required 4 boundary edges, leaving an open boundary. */
HEADER;
FILE_DESCRIPTION(('Tfa069 - pocket-floor EDGE_LOOP missing one edge'),'2;1');
FILE_NAME('Tfa069.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('Tfa069_text','lettering bottoms not closed','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
#20=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('p1',(1.0,0.0,0.0));
#22=CARTESIAN_POINT('p2',(1.0,1.0,0.0));
#23=CARTESIAN_POINT('p3',(0.0,1.0,0.0));
#24=VERTEX_POINT('',#20); #25=VERTEX_POINT('',#21);
#26=VERTEX_POINT('',#22); #27=VERTEX_POINT('',#23);
#28=DIRECTION('',(1.0,0.0,0.0)); #29=VECTOR('',#28,1.0);
#30=LINE('',#20,#29);
#31=EDGE_CURVE('e0',#24,#25,#30,.T.);
#32=EDGE_CURVE('e1',#25,#26,#30,.T.);
#33=EDGE_CURVE('e2',#26,#27,#30,.T.);
/* Defect: e3 (would close the loop p3->p0) is omitted. */
#34=ORIENTED_EDGE('',*,*,#31,.T.);
#35=ORIENTED_EDGE('',*,*,#32,.T.);
#36=ORIENTED_EDGE('',*,*,#33,.T.);
#40=EDGE_LOOP('pocket_floor_3edges',(#34,#35,#36));
#50=CARTESIAN_POINT('',(0.0,0.0,0.0));
#51=DIRECTION('',(0.0,0.0,1.0));
#52=DIRECTION('',(1.0,0.0,0.0));
#53=AXIS2_PLACEMENT_3D('',#50,#51,#52);
#54=PLANE('pocket_floor',#53);
#55=FACE_OUTER_BOUND('open_bound',#40,.T.);
#56=ADVANCED_FACE('pocket_floor',(#55),#54,.T.);
#60=CLOSED_SHELL('shell',(#56));
#61=MANIFOLD_SOLID_BREP('Tfa069_body',#60);
#70=SHAPE_REPRESENTATION('Tfa069_repr',(#53,#61),#14);
#71=SHAPE_DEFINITION_REPRESENTATION(#8,#70);
ENDSEC;
END-ISO-10303-21;
