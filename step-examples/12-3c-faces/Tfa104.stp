ISO-10303-21;
/* Tfa104 — ShapeAnalysis_CheckSmallFace.CheckSplittingVertices NM-vertex
 * Face with a non-manifold vertex (used by 3+ edges).
 * The bug: CheckSplittingVertices' splitting plan only handles 2-edge incidence.
 */
HEADER;
FILE_DESCRIPTION(('Tfa104 test case','Face with non-manifold vertex (3-edge incidence)'),'2;1');
FILE_NAME('Tfa104.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Plane */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('nm_vertex_plane',#13);
/* Create a face with 3 triangular regions sharing a central vertex (non-manifold) */
/* Central point: (5.0, 5.0, 0.0) used by 3 edges */
#20=CARTESIAN_POINT('',(5.0,5.0,0.0));
#21=VERTEX_POINT('center',#20);
/* Outer vertices for three triangles */
#22=CARTESIAN_POINT('',(7.0,5.0,0.0));
#23=VERTEX_POINT('tri1_a',#22);
#24=CARTESIAN_POINT('',(6.0,7.0,0.0));
#25=VERTEX_POINT('tri1_b',#24);
#26=CARTESIAN_POINT('',(3.0,7.0,0.0));
#27=VERTEX_POINT('tri2_a',#26);
#28=CARTESIAN_POINT('',(4.0,3.0,0.0));
#29=VERTEX_POINT('tri3_a',#28);
/* Triangle 1 edges: center -> tri1_a -> tri1_b -> center */
#30=DIRECTION('',(1.0,0.0,0.0));
#31=VECTOR('',#30,1.0);
#32=LINE('t1e1',#20,#31);
#33=EDGE_CURVE('edge_tri1_1',#21,#23,#32,.T.);
#34=DIRECTION('',(-0.316,-0.949,0.0));
#35=VECTOR('',#34,1.0);
#36=LINE('t1e2',#22,#35);
#37=EDGE_CURVE('edge_tri1_2',#23,#25,#36,.T.);
#38=DIRECTION('',(-0.316,0.949,0.0));
#39=VECTOR('',#38,1.0);
#40=LINE('t1e3',#24,#39);
#41=EDGE_CURVE('edge_tri1_3',#25,#21,#40,.T.);
/* Triangle 2 edges: center -> tri2_a -> back to center */
#42=DIRECTION('',(-1.0,1.0,0.0));
#43=VECTOR('',#42,1.0);
#44=LINE('t2e1',#20,#43);
#45=EDGE_CURVE('edge_tri2_1',#21,#27,#44,.T.);
#46=DIRECTION('',(1.0,-1.0,0.0));
#47=VECTOR('',#46,1.0);
#48=LINE('t2e2',#26,#47);
#49=EDGE_CURVE('edge_tri2_2',#27,#21,#48,.T.);
/* Triangle 3 edges: center -> tri3_a -> back */
#50=DIRECTION('',(-1.0,-1.0,0.0));
#51=VECTOR('',#50,1.0);
#52=LINE('t3e1',#20,#51);
#53=EDGE_CURVE('edge_tri3_1',#21,#29,#52,.T.);
#54=DIRECTION('',(1.0,1.0,0.0));
#55=VECTOR('',#54,1.0);
#56=LINE('t3e2',#28,#55);
#57=EDGE_CURVE('edge_tri3_2',#29,#21,#56,.T.);
/* Create one wire with all edges (non-manifold at center vertex) */
#60=ORIENTED_EDGE('oe_t1_1',*,*,#33,.T.);
#61=ORIENTED_EDGE('oe_t1_2',*,*,#37,.T.);
#62=ORIENTED_EDGE('oe_t1_3',*,*,#41,.T.);
#63=ORIENTED_EDGE('oe_t2_1',*,*,#45,.T.);
#64=ORIENTED_EDGE('oe_t2_2',*,*,#49,.T.);
#65=ORIENTED_EDGE('oe_t3_1',*,*,#53,.T.);
#66=ORIENTED_EDGE('oe_t3_2',*,*,#57,.T.);
#67=EDGE_LOOP('nm_vertex_loop',(#60,#61,#62,#63,#64,#65,#66));
#68=FACE_OUTER_BOUND('',#67,.T.);
#70=ADVANCED_FACE('nm_vertex_face',(#68),#14,.T.);
/* Product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa104','Tfa104','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9030));
#9030=OPEN_SHELL('nm_shell',(#70));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
