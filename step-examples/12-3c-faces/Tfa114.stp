ISO-10303-21;
/* Tfa114 — ShapeAnalysis_CheckSmallFace.CheckSpotFace zero-radius
 * Defect: face whose enclosing circle radius is exactly 0.0 (all vertices identical);
 * CheckSpotFace returns "definitely a spot" but the geometry is degenerate beyond classification.
 * All 4 vertices of a planar quadrilateral mapped to the same 3D point, creating a degenerate
 * face that collapses to a single point. Bounding circle radius = 0.0. */
HEADER;
FILE_DESCRIPTION(('Tfa114 - CheckSpotFace zero-radius degenerate face'),'2;1');
FILE_NAME('Tfa114.stp','2026-06-16T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Planar surface: z=0 */
#10=PLANE('plane_z0',(#11));
#11=AXIS2_PLACEMENT_3D('origin_place',#12,#13,#14);
#12=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#13=DIRECTION('z_normal',(0.0,0.0,1.0));
#14=DIRECTION('x_axis',(1.0,0.0,0.0));
/* All four vertices at the same point (5.0, 5.0, 0.0) */
#20=CARTESIAN_POINT('v_spot',(5.0,5.0,0.0));
#21=VERTEX_POINT('vp1',#20);
#22=VERTEX_POINT('vp2',#20);
#23=VERTEX_POINT('vp3',#20);
#24=VERTEX_POINT('vp4',#20);
/* Four degenerate edges all from the same point to itself */
#30=POINT('e1_geom',#20);
#31=EDGE_CURVE('e1',#21,#22,#30,.T.);
#32=POINT('e2_geom',#20);
#33=EDGE_CURVE('e2',#22,#23,#32,.T.);
#34=POINT('e3_geom',#20);
#35=EDGE_CURVE('e3',#23,#24,#34,.T.);
#36=POINT('e4_geom',#20);
#37=EDGE_CURVE('e4',#24,#21,#36,.T.);
/* Outer loop with degenerate edges */
#40=ORIENTED_EDGE('oe1',*,*,#31,.T.);
#41=ORIENTED_EDGE('oe2',*,*,#33,.T.);
#42=ORIENTED_EDGE('oe3',*,*,#35,.T.);
#43=ORIENTED_EDGE('oe4',*,*,#37,.T.);
#44=EDGE_LOOP('degenerate_loop',(#40,#41,#42,#43));
#45=FACE_OUTER_BOUND('spot_bound',#44,.T.);
/* Face with all vertices collapsed to single point */
#50=ADVANCED_FACE('spot_face',(#45),#10,.T.);
/* PRODUCT chain */
#200=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#201=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#202=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#203=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#200,'distance_accuracy_value','');
#204=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#203))GLOBAL_UNIT_ASSIGNED_CONTEXT((#200,#201,#202))REPRESENTATION_CONTEXT('','3D'));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa114','Tfa114','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9020=OPEN_SHELL('wrap_shell',(#50));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#204);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
