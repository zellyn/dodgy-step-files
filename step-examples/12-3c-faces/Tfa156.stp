/* Inner wire: arc-like tangent curve approximated with 3 short edges forming smooth tangent arc */
#60=CARTESIAN_POINT('',(5.0,4.5,0.0));#61=VERTEX_POINT('',#60);
#62=CARTESIAN_POINT('',(5.5,4.65,0.0));#63=VERTEX_POINT('',#62);
