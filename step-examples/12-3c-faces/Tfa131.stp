ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('dodgy-step-files wave 28 face fixture Tfa131'),'2;1');
FILE_NAME('','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2009,#1);
/* Tfa131 - FixWiresTwoCoincEdges.crossing-wires-coincident-segment
 * Defect: Two wires with coincident edge segments.
 * FixWiresTwoCoincEdges can't decide which wire owns the segment.
 * Trigger: Face with two non-trivial wires sharing an edge curve.
 */

#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);

/* Outer wire: large rectangle */
#20=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('p1',(10.0,0.0,0.0));
#22=CARTESIAN_POINT('p2',(10.0,10.0,0.0));
#23=CARTESIAN_POINT('p3',(0.0,10.0,0.0));

/* Inner wire: shares edge (p1,p2) with outer */
#24=CARTESIAN_POINT('p4',(10.0,0.0,0.0));
#25=CARTESIAN_POINT('p5',(10.0,10.0,0.0));
#26=CARTESIAN_POINT('p6',(12.0,10.0,0.0));
#27=CARTESIAN_POINT('p7',(12.0,0.0,0.0));

/* Vertices */
#30=VERTEX_POINT('v0',#20);
#31=VERTEX_POINT('v1',#21);
#32=VERTEX_POINT('v2',#22);
#33=VERTEX_POINT('v3',#23);
#34=VERTEX_POINT('v4',#24);
#35=VERTEX_POINT('v5',#25);
#36=VERTEX_POINT('v6',#26);
#37=VERTEX_POINT('v7',#27);

/* Edges - outer wire */
#40=DIRECTION('d1',(1.0,0.0,0.0));
#41=DIRECTION('d2',(0.0,1.0,0.0));
#42=DIRECTION('d3',(-1.0,0.0,0.0));
#43=DIRECTION('d4',(0.0,-1.0,0.0));
#44=VECTOR('v1',#40,10.0);
#45=VECTOR('v2',#41,10.0);
#46=VECTOR('v3',#42,10.0);
#47=VECTOR('v4',#43,10.0);
#50=LINE('line1',#20,#44);
#51=LINE('line2',#21,#45);
#52=LINE('line3',#22,#46);
#53=LINE('line4',#23,#47);

/* Outer wire edges */
#60=EDGE_CURVE('e0',#30,#31,#50,.T.);
#61=EDGE_CURVE('e1',#31,#32,#51,.T.);
#62=EDGE_CURVE('e2',#32,#33,#52,.T.);
#63=EDGE_CURVE('e3',#33,#30,#53,.T.);

/* Inner wire edges - shares e1 with outer */
#64=DIRECTION('d5',(0.0,-1.0,0.0));
#65=DIRECTION('d6',(1.0,0.0,0.0));
#66=DIRECTION('d7',(0.0,1.0,0.0));
#67=VECTOR('v7',#65,2.0);
#68=VECTOR('v8',#66,10.0);
#69=VECTOR('v9',#64,2.0);
#70=LINE('line5',#27,#67);
#71=LINE('line6',#26,#68);
#72=LINE('line7',#25,#69);

#73=EDGE_CURVE('e4',#37,#36,#70,.T.);
#74=EDGE_CURVE('e5',#36,#35,#71,.T.);
#75=EDGE_CURVE('e6',#35,#34,#72,.T.);

/* Oriented edges - outer */
#80=ORIENTED_EDGE('oe0',*,*,#60,.T.);
#81=ORIENTED_EDGE('oe1',*,*,#61,.T.);
#82=ORIENTED_EDGE('oe2',*,*,#62,.T.);
#83=ORIENTED_EDGE('oe3',*,*,#63,.T.);

/* Oriented edges - inner (reuses e1 from outer) */
#84=ORIENTED_EDGE('oe4',*,*,#75,.T.);
#85=ORIENTED_EDGE('oe5',*,*,#61,.T.);
#86=ORIENTED_EDGE('oe6',*,*,#73,.T.);
#87=ORIENTED_EDGE('oe7',*,*,#74,.T.);

/* Edge loops */
#90=EDGE_LOOP('loop1',(#80,#81,#82,#83));
#91=EDGE_LOOP('loop2',(#84,#85,#86,#87));

/* Face bounds */
#100=FACE_OUTER_BOUND('outer',#90,.T.);
#101=FACE_INNER_BOUND('inner',#91,.T.);

/* Geometry */
#110=PLANE('plane',#13);

/* Face with shared edge triggering FixWiresTwoCoincEdges */
#120=ADVANCED_FACE('coincident',(#100,#101),#110,.T.);

#130=OPEN_SHELL('shell',(#120));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa131','Tfa131','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#130));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
