ISO-10303-21;
/* Tfa020 - Sewing - free bounds on closed shell
 * Defect: a shell that should be closed has free (naked) edges - edges
 * incident to fewer than two faces. Either a face is missing or
 * adjacent face boundaries weren't sewn within tolerance. Healer should
 * run BRepBuilderAPI_Sewing with model-derived tolerance, promote to
 * CLOSED_SHELL when topology proves closure, and recompute IsClosed
 * flag from connectivity.
 * Reproducer: shell exported as separate faces inside an OPEN_SHELL
 * with adjacent face edges sitting within 1e-5 m of each other but
 * referencing different EDGE_CURVE records.
 */
HEADER;
FILE_DESCRIPTION(('Tfa020 sewing free bounds open shell'),'2;1');
FILE_NAME('Tfa020.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
#14=PLANE('plane_xy',#13);
/* Face A: square (0..10) x (0..10).                                    */
#20=CARTESIAN_POINT('a0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('a1',(10.0,0.0,0.0));
#22=CARTESIAN_POINT('a2',(10.0,10.0,0.0));
#23=CARTESIAN_POINT('a3',(0.0,10.0,0.0));
/* Face B: shifted by 1e-5 in y so its left edge is "almost" coincident
 * with face A's right edge. Sewing must close this gap.                */
#24=CARTESIAN_POINT('b0',(10.0,0.00001,0.0));
#25=CARTESIAN_POINT('b1',(20.0,0.0,0.0));
#26=CARTESIAN_POINT('b2',(20.0,10.0,0.0));
#27=CARTESIAN_POINT('b3',(10.0,10.00001,0.0));
#30=VERTEX_POINT('',#20);
#31=VERTEX_POINT('',#21);
#32=VERTEX_POINT('',#22);
#33=VERTEX_POINT('',#23);
#34=VERTEX_POINT('',#24);
#35=VERTEX_POINT('',#25);
#36=VERTEX_POINT('',#26);
#37=VERTEX_POINT('',#27);
#40=DIRECTION('',(1.0,0.0,0.0));
#41=DIRECTION('',(0.0,1.0,0.0));
#42=DIRECTION('',(-1.0,0.0,0.0));
#43=DIRECTION('',(0.0,-1.0,0.0));
#50=VECTOR('',#40,10.0);
#51=VECTOR('',#41,10.0);
#52=VECTOR('',#42,10.0);
#53=VECTOR('',#43,10.0);
#60=LINE('',#20,#50);
#61=LINE('',#21,#51);
#62=LINE('',#22,#52);
#63=LINE('',#23,#53);
#64=LINE('',#24,#50);
#65=LINE('',#25,#51);
#66=LINE('',#26,#52);
#67=LINE('',#27,#53);
#70=EDGE_CURVE('',#30,#31,#60,.T.);
#71=EDGE_CURVE('',#31,#32,#61,.T.);
#72=EDGE_CURVE('',#32,#33,#62,.T.);
#73=EDGE_CURVE('',#33,#30,#63,.T.);
#74=EDGE_CURVE('',#34,#35,#64,.T.);
#75=EDGE_CURVE('',#35,#36,#65,.T.);
#76=EDGE_CURVE('',#36,#37,#66,.T.);
#77=EDGE_CURVE('',#37,#34,#67,.T.);
#80=ORIENTED_EDGE('',*,*,#70,.T.);
#81=ORIENTED_EDGE('',*,*,#71,.T.);
#82=ORIENTED_EDGE('',*,*,#72,.T.);
#83=ORIENTED_EDGE('',*,*,#73,.T.);
#84=ORIENTED_EDGE('',*,*,#74,.T.);
#85=ORIENTED_EDGE('',*,*,#75,.T.);
#86=ORIENTED_EDGE('',*,*,#76,.T.);
#87=ORIENTED_EDGE('',*,*,#77,.T.);
#90=EDGE_LOOP('A',(#80,#81,#82,#83));
#91=EDGE_LOOP('B',(#84,#85,#86,#87));
#100=FACE_OUTER_BOUND('',#90,.T.);
#101=FACE_OUTER_BOUND('',#91,.T.);
#110=ADVANCED_FACE('A',(#100),#14,.T.);
#111=ADVANCED_FACE('B',(#101),#14,.T.);
/* Defect site: OPEN_SHELL with free bounds along each face's right and
 * the other face's left edge (separated by 1e-5).                      */
#120=OPEN_SHELL('open_shell_to_sew',(#110,#111));
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa020','Tfa020','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#120));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
