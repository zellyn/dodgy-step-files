ISO-10303-21;
/* Tfa117 — ShapeAnalysis_CheckSmallFace.CheckSplittingVertices vertex-on-degenerate-edge
 * Defect: face's vertex sits on the midpoint of a degenerate (zero-length)
 * edge of an adjacent face; CheckSplittingVertices can't classify the T-vertex. */
HEADER;
FILE_DESCRIPTION(('Tfa117 - CheckSplittingVertices vertex-on-degenerate-edge defect'),'2;1');
FILE_NAME('Tfa117.stp','2026-06-16T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* First face: rectangular face with degenerate edge (zero-length) at midpoint */
#10=CARTESIAN_POINT('p1_origin',(0.0,0.0,0.0));
#11=VERTEX_POINT('v1_origin',#10);
#12=CARTESIAN_POINT('p1_x',(2.0,0.0,0.0));
#13=VERTEX_POINT('v1_x',#12);
#14=CARTESIAN_POINT('p1_xy',(2.0,2.0,0.0));
#15=VERTEX_POINT('v1_xy',#14);
#16=CARTESIAN_POINT('p1_y',(0.0,2.0,0.0));
#17=VERTEX_POINT('v1_y',#16);
/* Degenerate edge at (1,0,0) — zero length, both endpoints at same point */
#18=CARTESIAN_POINT('p_degenerate',(1.0,0.0,0.0));
#19=VERTEX_POINT('v_degenerate',#18);
#20=CARTESIAN_POINT('p_degenerate_dup',(1.0,0.0,0.0));
#21=VERTEX_POINT('v_degenerate_dup',#20);
#22=LINE('degen_line',(#18),#23);
#23=VECTOR('degen_vec',#24,0.0);
#24=DIRECTION('degen_dir',(1.0,0.0,0.0));
#25=EDGE_CURVE('degen_edge',#19,#21,#22,.T.);
/* Normal edges for first face */
#26=LINE('edge1_line',(#10),#27);
#27=VECTOR('edge1_vec',#28,1.0);
#28=DIRECTION('edge1_dir',(1.0,0.0,0.0));
#29=EDGE_CURVE('edge1',#11,#13,#26,.T.);
#30=LINE('edge2_line',(#12),#31);
#31=VECTOR('edge2_vec',#32,1.0);
#32=DIRECTION('edge2_dir',(0.0,1.0,0.0));
#33=EDGE_CURVE('edge2',#13,#15,#30,.T.);
#34=LINE('edge3_line',(#14),#35);
#35=VECTOR('edge3_vec',#36,1.0);
#36=DIRECTION('edge3_dir',(-1.0,0.0,0.0));
#37=EDGE_CURVE('edge3',#15,#17,#34,.T.);
#38=LINE('edge4_line',(#16),#39);
#39=VECTOR('edge4_vec',#40,1.0);
#40=DIRECTION('edge4_dir',(0.0,-1.0,0.0));
#41=EDGE_CURVE('edge4',#17,#11,#38,.T.);
/* Loops for first face */
#42=ORIENTED_EDGE('oe1',*,*,#29,.T.);
#43=ORIENTED_EDGE('oe2',*,*,#33,.T.);
#44=ORIENTED_EDGE('oe3',*,*,#37,.T.);
#45=ORIENTED_EDGE('oe4',*,*,#41,.T.);
#46=EDGE_LOOP('loop1',(#42,#43,#44,#45));
#47=FACE_OUTER_BOUND('bound1',#46,.T.);
#48=AXIS2_PLACEMENT_3D('place_z',#10,#24,#28);
#49=PLANE('plane1',#48);
#50=ADVANCED_FACE('face1',(#47),#49,.T.);
/* Second face: splits the degenerate edge — has vertex at midpoint */
#51=CARTESIAN_POINT('p2_start',(1.0,0.0,0.0));
#52=VERTEX_POINT('v2_start',#51);
#53=CARTESIAN_POINT('p2_end',(1.0,1.0,0.0));
#54=VERTEX_POINT('v2_end',#53);
#55=LINE('edge5_line',(#51),#56);
#56=VECTOR('edge5_vec',#57,1.0);
#57=DIRECTION('edge5_dir',(0.0,1.0,0.0));
#58=EDGE_CURVE('edge5',#52,#54,#55,.T.);
#59=LINE('edge6_line',(#53),#60);
#60=VECTOR('edge6_vec',#32,1.0);
#61=EDGE_CURVE('edge6',#54,#11,#59,.T.);
#62=LINE('edge7_line',(#10),#63);
#63=VECTOR('edge7_vec',#56,1.0);
#64=EDGE_CURVE('edge7',#11,#52,#62,.T.);
#65=ORIENTED_EDGE('oe5',*,*,#58,.T.);
#66=ORIENTED_EDGE('oe6',*,*,#61,.T.);
#67=ORIENTED_EDGE('oe7',*,*,#64,.T.);
#68=EDGE_LOOP('loop2',(#65,#66,#67));
#69=FACE_OUTER_BOUND('bound2',#68,.T.);
#70=ADVANCED_FACE('face2',(#69),#49,.T.);
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa117','Tfa117','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('shell',(#50,#70));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
