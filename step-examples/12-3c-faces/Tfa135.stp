#52=VERTEX_POINT('v12',#32);
#53=VERTEX_POINT('v13',#33);
#54=VERTEX_POINT('v14',#34);
#55=VERTEX_POINT('v15',#35);
/* Outer wire edges */
#60=DIRECTION('d0',(1.0,0.0,0.0));
#61=VECTOR('v_o0',#60,20.0);
#62=LINE('l0',#20,#61);
#63=DIRECTION('d1',(0.0,1.0,0.0));
#64=VECTOR('v_o1',#63,20.0);
#65=LINE('l1',#21,#64);
#66=DIRECTION('d2',(-1.0,0.0,0.0));
#67=VECTOR('v_o2',#66,20.0);
#68=LINE('l2',#22,#67);
#69=DIRECTION('d3',(0.0,-1.0,0.0));
#70=VECTOR('v_o3',#69,20.0);
#71=LINE('l3',#23,#70);
