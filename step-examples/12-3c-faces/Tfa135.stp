#94=LINE('l8',#28,#93);
#95=DIRECTION('d9',(0.0,1.0,0.0));
#96=VECTOR('v_i21',#95,0.15);
#97=LINE('l9',#29,#96);
#98=DIRECTION('d10',(-1.0,0.0,0.0));
#99=VECTOR('v_i22',#98,0.15);
#100=LINE('l10',#30,#99);
#101=DIRECTION('d11',(0.0,-1.0,0.0));
#102=VECTOR('v_i23',#101,0.15);
#103=LINE('l11',#31,#102);
#104=EDGE_CURVE('e8',#48,#49,#94,.T.);
#105=EDGE_CURVE('e9',#49,#50,#97,.T.);
#106=EDGE_CURVE('e10',#50,#51,#100,.T.);
#107=EDGE_CURVE('e11',#51,#48,#103,.T.);
/* Inner wire 3 edges (0.2x0.2) */
#108=DIRECTION('d12',(1.0,0.0,0.0));
#109=VECTOR('v_i30',#108,0.2);
#110=LINE('l12',#32,#109);
#111=DIRECTION('d13',(0.0,1.0,0.0));
#112=VECTOR('v_i31',#111,0.2);
#113=LINE('l13',#33,#112);
#114=DIRECTION('d14',(-1.0,0.0,0.0));
