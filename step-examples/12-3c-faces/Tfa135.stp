FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2009,#1);
/* Tfa135 - FixSmallAreaWire.chained-removal
 * Defect: Three small inner wires; removing first changes area calc,
 * causing second to also fall below threshold (cascade effect).
 * Trigger: Face with multiple small wires where removal propagates.
 */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);
/* Outer wire: large square */
#20=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('p1',(20.0,0.0,0.0));
#22=CARTESIAN_POINT('p2',(20.0,20.0,0.0));
#23=CARTESIAN_POINT('p3',(0.0,20.0,0.0));
/* Small inner wire 1 (0.1x0.1) */
#24=CARTESIAN_POINT('p4',(2.0,2.0,0.0));
#25=CARTESIAN_POINT('p5',(2.1,2.0,0.0));
#26=CARTESIAN_POINT('p6',(2.1,2.1,0.0));
#27=CARTESIAN_POINT('p7',(2.0,2.1,0.0));
/* Small inner wire 2 (0.15x0.15) */
#28=CARTESIAN_POINT('p8',(5.0,5.0,0.0));
#29=CARTESIAN_POINT('p9',(5.15,5.0,0.0));
#30=CARTESIAN_POINT('p10',(5.15,5.15,0.0));
#31=CARTESIAN_POINT('p11',(5.0,5.15,0.0));
/* Small inner wire 3 (0.2x0.2) */
#32=CARTESIAN_POINT('p12',(8.0,8.0,0.0));
#33=CARTESIAN_POINT('p13',(8.2,8.0,0.0));
#34=CARTESIAN_POINT('p14',(8.2,8.2,0.0));
#35=CARTESIAN_POINT('p15',(8.0,8.2,0.0));
/* Vertices */
#40=VERTEX_POINT('v0',#20);
#41=VERTEX_POINT('v1',#21);
#42=VERTEX_POINT('v2',#22);
#43=VERTEX_POINT('v3',#23);
#44=VERTEX_POINT('v4',#24);
#45=VERTEX_POINT('v5',#25);
#46=VERTEX_POINT('v6',#26);
#47=VERTEX_POINT('v7',#27);
#48=VERTEX_POINT('v8',#28);
