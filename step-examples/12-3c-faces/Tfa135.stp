#74=EDGE_CURVE('e2',#42,#43,#68,.T.);
#75=EDGE_CURVE('e3',#43,#40,#71,.T.);
/* Inner wire 1 edges (0.1x0.1) */
#76=DIRECTION('d4',(1.0,0.0,0.0));
#77=VECTOR('v_i10',#76,0.1);
#78=LINE('l4',#24,#77);
#79=DIRECTION('d5',(0.0,1.0,0.0));
#80=VECTOR('v_i11',#79,0.1);
#81=LINE('l5',#25,#80);
#82=DIRECTION('d6',(-1.0,0.0,0.0));
#83=VECTOR('v_i12',#82,0.1);
#84=LINE('l6',#26,#83);
#85=DIRECTION('d7',(0.0,-1.0,0.0));
#86=VECTOR('v_i13',#85,0.1);
#87=LINE('l7',#27,#86);
