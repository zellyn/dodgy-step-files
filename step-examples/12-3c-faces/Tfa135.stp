/* Oriented edges */
#130=ORIENTED_EDGE('oe0',*,*,#72,.T.);
#131=ORIENTED_EDGE('oe1',*,*,#73,.T.);
#132=ORIENTED_EDGE('oe2',*,*,#74,.T.);
