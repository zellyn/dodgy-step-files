ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('dodgy-step-files wave 28 face fixture Tfa135'),'2;1');
FILE_NAME('','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2009,#1);
/* Tfa135 - FixSmallAreaWire.chained-removal
 * Defect: Three small inner wires; removing first changes area calc,
 * causing second to also fall below threshold (cascade effect).
 * Trigger: Face with multiple small wires where removal propagates.
 */

#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);

/* Outer wire: large square */
#20=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('p1',(20.0,0.0,0.0));
#22=CARTESIAN_POINT('p2',(20.0,20.0,0.0));
#23=CARTESIAN_POINT('p3',(0.0,20.0,0.0));

/* Small inner wire 1 */
#24=CARTESIAN_POINT('p4',(2.0,2.0,0.0));
#25=CARTESIAN_POINT('p5',(2.1,2.0,0.0));
#26=CARTESIAN_POINT('p6',(2.1,2.1,0.0));
#27=CARTESIAN_POINT('p7',(2.0,2.1,0.0));

/* Small inner wire 2 */
#28=CARTESIAN_POINT('p8',(5.0,5.0,0.0));
#29=CARTESIAN_POINT('p9',(5.15,5.0,0.0));
#30=CARTESIAN_POINT('p10',(5.15,5.15,0.0));
#31=CARTESIAN_POINT('p11',(5.0,5.15,0.0));

/* Small inner wire 3 */
#32=CARTESIAN_POINT('p12',(8.0,8.0,0.0));
#33=CARTESIAN_POINT('p13',(8.2,8.0,0.0));
#34=CARTESIAN_POINT('p14',(8.2,8.2,0.0));
#35=CARTESIAN_POINT('p15',(8.0,8.2,0.0));

/* Vertices */
#40=VERTEX_POINT('v0',#20);
#41=VERTEX_POINT('v1',#21);
#42=VERTEX_POINT('v2',#22);
#43=VERTEX_POINT('v3',#23);
#44=VERTEX_POINT('v4',#24);
#45=VERTEX_POINT('v5',#25);
#46=VERTEX_POINT('v6',#26);
#47=VERTEX_POINT('v7',#27);
#48=VERTEX_POINT('v8',#28);
#49=VERTEX_POINT('v9',#29);
#50=VERTEX_POINT('v10',#30);
#51=VERTEX_POINT('v11',#31);
#52=VERTEX_POINT('v12',#32);
#53=VERTEX_POINT('v13',#33);
#54=VERTEX_POINT('v14',#34);
#55=VERTEX_POINT('v15',#35);

/* Outer wire edges */
#60=LINE('l0',#20,#(VECTOR('',#(DIRECTION('',(1.0,0.0,0.0))),20.0)));
#61=LINE('l1',#21,#(VECTOR('',#(DIRECTION('',(0.0,1.0,0.0))),20.0)));
#62=LINE('l2',#22,#(VECTOR('',#(DIRECTION('',(-1.0,0.0,0.0))),20.0)));
#63=LINE('l3',#23,#(VECTOR('',#(DIRECTION('',(0.0,-1.0,0.0))),20.0)));

#70=EDGE_CURVE('e0',#40,#41,#60,.T.);
#71=EDGE_CURVE('e1',#41,#42,#61,.T.);
#72=EDGE_CURVE('e2',#42,#43,#62,.T.);
#73=EDGE_CURVE('e3',#43,#40,#63,.T.);

/* Inner wire 1 edges (very small 0.1x0.1) */
#74=LINE('l4',#24,#(VECTOR('',#(DIRECTION('',(1.0,0.0,0.0))),0.1)));
#75=LINE('l5',#25,#(VECTOR('',#(DIRECTION('',(0.0,1.0,0.0))),0.1)));
#76=LINE('l6',#26,#(VECTOR('',#(DIRECTION('',(-1.0,0.0,0.0))),0.1)));
#77=LINE('l7',#27,#(VECTOR('',#(DIRECTION('',(0.0,-1.0,0.0))),0.1)));

#78=EDGE_CURVE('e4',#44,#45,#74,.T.);
#79=EDGE_CURVE('e5',#45,#46,#75,.T.);
#80=EDGE_CURVE('e6',#46,#47,#76,.T.);
#81=EDGE_CURVE('e7',#47,#44,#77,.T.);

/* Inner wire 2 edges (small 0.15x0.15) */
#82=LINE('l8',#28,#(VECTOR('',#(DIRECTION('',(1.0,0.0,0.0))),0.15)));
#83=LINE('l9',#29,#(VECTOR('',#(DIRECTION('',(0.0,1.0,0.0))),0.15)));
#84=LINE('l10',#30,#(VECTOR('',#(DIRECTION('',(-1.0,0.0,0.0))),0.15)));
#85=LINE('l11',#31,#(VECTOR('',#(DIRECTION('',(0.0,-1.0,0.0))),0.15)));

#86=EDGE_CURVE('e8',#48,#49,#82,.T.);
#87=EDGE_CURVE('e9',#49,#50,#83,.T.);
#88=EDGE_CURVE('e10',#50,#51,#84,.T.);
#89=EDGE_CURVE('e11',#51,#48,#85,.T.);

/* Inner wire 3 edges (small 0.2x0.2) */
#90=LINE('l12',#32,#(VECTOR('',#(DIRECTION('',(1.0,0.0,0.0))),0.2)));
#91=LINE('l13',#33,#(VECTOR('',#(DIRECTION('',(0.0,1.0,0.0))),0.2)));
#92=LINE('l14',#34,#(VECTOR('',#(DIRECTION('',(-1.0,0.0,0.0))),0.2)));
#93=LINE('l15',#35,#(VECTOR('',#(DIRECTION('',(0.0,-1.0,0.0))),0.2)));

#94=EDGE_CURVE('e12',#52,#53,#90,.T.);
#95=EDGE_CURVE('e13',#53,#54,#91,.T.);
#96=EDGE_CURVE('e14',#54,#55,#92,.T.);
#97=EDGE_CURVE('e15',#55,#52,#93,.T.);

/* Oriented edges */
#100=ORIENTED_EDGE('oe0',*,*,#70,.T.);
#101=ORIENTED_EDGE('oe1',*,*,#71,.T.);
#102=ORIENTED_EDGE('oe2',*,*,#72,.T.);
#103=ORIENTED_EDGE('oe3',*,*,#73,.T.);

#104=ORIENTED_EDGE('oe4',*,*,#78,.T.);
#105=ORIENTED_EDGE('oe5',*,*,#79,.T.);
#106=ORIENTED_EDGE('oe6',*,*,#80,.T.);
#107=ORIENTED_EDGE('oe7',*,*,#81,.T.);

#108=ORIENTED_EDGE('oe8',*,*,#86,.T.);
#109=ORIENTED_EDGE('oe9',*,*,#87,.T.);
#110=ORIENTED_EDGE('oe10',*,*,#88,.T.);
#111=ORIENTED_EDGE('oe11',*,*,#89,.T.);

#112=ORIENTED_EDGE('oe12',*,*,#94,.T.);
#113=ORIENTED_EDGE('oe13',*,*,#95,.T.);
#114=ORIENTED_EDGE('oe14',*,*,#96,.T.);
#115=ORIENTED_EDGE('oe15',*,*,#97,.T.);

/* Edge loops */
#120=EDGE_LOOP('outer',(#100,#101,#102,#103));
#121=EDGE_LOOP('inner1',(#104,#105,#106,#107));
#122=EDGE_LOOP('inner2',(#108,#109,#110,#111));
#123=EDGE_LOOP('inner3',(#112,#113,#114,#115));

/* Face bounds */
#130=FACE_OUTER_BOUND('outer',#120,.T.);
#131=FACE_INNER_BOUND('inner1',#121,.T.);
#132=FACE_INNER_BOUND('inner2',#122,.T.);
#133=FACE_INNER_BOUND('inner3',#123,.T.);

/* Geometry */
#140=PLANE('plane',#13);

/* Face with three small inner wires triggering chained removal */
#150=ADVANCED_FACE('chained',(#130,#131,#132,#133),#140,.T.);

#160=OPEN_SHELL('shell',(#150));

/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa135','Tfa135','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#160));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
