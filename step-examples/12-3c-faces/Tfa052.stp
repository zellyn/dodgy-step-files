ISO-10303-21;
/* Tfa052 - Face split because surface area exceeds threshold
 * Single PLANE face 100x100 (area = 10000 mm^2). With caller-supplied
 * max-area threshold = 100 mm^2, the divider must produce >=100 sub-faces. */
HEADER;
FILE_DESCRIPTION(('Tfa052 test case','100x100 face -- area 10000mm^2 must divide into >=100 sub-faces at threshold 100mm^2'),'2;1');
FILE_NAME('Tfa052.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
#15=CARTESIAN_POINT('',(0.0,0.0,0.0));
#16=VERTEX_POINT('',#15);
#17=CARTESIAN_POINT('',(100.0,0.0,0.0));
#18=VERTEX_POINT('',#17);
#19=CARTESIAN_POINT('',(100.0,100.0,0.0));
#20=VERTEX_POINT('',#19);
#21=CARTESIAN_POINT('',(0.0,100.0,0.0));
#22=VERTEX_POINT('',#21);
#23=DIRECTION('',(1.0,0.0,0.0));#24=VECTOR('',#23,1.0);#25=LINE('',#15,#24);
#26=EDGE_CURVE('',#16,#18,#25,.T.);
#27=DIRECTION('',(0.0,1.0,0.0));#28=VECTOR('',#27,1.0);#29=LINE('',#17,#28);
#30=EDGE_CURVE('',#18,#20,#29,.T.);
#31=DIRECTION('',(-1.0,0.0,0.0));#32=VECTOR('',#31,1.0);#33=LINE('',#19,#32);
#34=EDGE_CURVE('',#20,#22,#33,.T.);
#35=DIRECTION('',(0.0,-1.0,0.0));#36=VECTOR('',#35,1.0);#37=LINE('',#21,#36);
#38=EDGE_CURVE('',#22,#16,#37,.T.);
#40=ORIENTED_EDGE('',*,*,#26,.T.);
#41=ORIENTED_EDGE('',*,*,#30,.T.);
#42=ORIENTED_EDGE('',*,*,#34,.T.);
#43=ORIENTED_EDGE('',*,*,#38,.T.);
#44=EDGE_LOOP('',(#40,#41,#42,#43));
#45=FACE_OUTER_BOUND('',#44,.T.);
#46=ADVANCED_FACE('large_face_100x100',(#45),#14,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa052','Tfa052','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#46));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
