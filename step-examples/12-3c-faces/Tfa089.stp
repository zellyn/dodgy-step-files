ISO-10303-21;
/* Tfa089 - ShapeAnalysis_CheckSmallFace.CheckSpotFace: tolerance scaling
 * Face slightly larger than the spot threshold but with vertex tolerances
 * larger than the face dimension. Tolerance-scaled comparison misclassifies as spot.
 */
HEADER;
FILE_DESCRIPTION(('Tfa089 test case','Small face with large vertex tolerances; tolerance-scaled comparison misclassifies as spot'),'2;1');
FILE_NAME('Tfa089.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Plane at Z=0 */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('base_plane',#13);
/* Small square: 0.1 x 0.1 (area = 0.01)
   Spot threshold is typically around 1e-7 to 1e-8.
   This face is larger than spot threshold.
*/
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=VERTEX_POINT('v0',#20);
#22=CARTESIAN_POINT('',(0.1,0.0,0.0));
#23=VERTEX_POINT('v1',#22);
#24=CARTESIAN_POINT('',(0.1,0.1,0.0));
#25=VERTEX_POINT('v2',#24);
#26=CARTESIAN_POINT('',(0.0,0.1,0.0));
#27=VERTEX_POINT('v3',#26);
/* Edges with vertex tolerances larger than face dimension */
#30=DIRECTION('',(1.0,0.0,0.0));
#31=VECTOR('',#30,1.0);
#32=LINE('',#20,#31);
#33=EDGE_CURVE('e_bottom',#21,#23,#32,.T.);
#34=DIRECTION('',(0.0,1.0,0.0));
#35=VECTOR('',#34,1.0);
#36=LINE('',#22,#35);
#37=EDGE_CURVE('e_right',#23,#25,#36,.T.);
#38=DIRECTION('',(-1.0,0.0,0.0));
#39=VECTOR('',#38,1.0);
#40=LINE('',#24,#39);
#41=EDGE_CURVE('e_top',#25,#27,#40,.T.);
#42=DIRECTION('',(0.0,-1.0,0.0));
#43=VECTOR('',#42,1.0);
#44=LINE('',#26,#43);
#45=EDGE_CURVE('e_left',#27,#21,#44,.T.);
#46=ORIENTED_EDGE('',*,*,#33,.T.);
#47=ORIENTED_EDGE('',*,*,#37,.T.);
#48=ORIENTED_EDGE('',*,*,#41,.T.);
#49=ORIENTED_EDGE('',*,*,#45,.T.);
#50=EDGE_LOOP('boundary_loop',(#46,#47,#48,#49));
#51=FACE_OUTER_BOUND('',#50,.T.);
/* Face with nominal size > spot threshold but vertex tolerances >> face dimension */
#90=ADVANCED_FACE('small_face_large_tolerance',(#51),#14,.T.);
/* Minimal PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa089','Tfa089','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9100));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
#9100=CLOSED_SHELL('shell_for_product',(#90));
ENDSEC;
END-ISO-10303-21;
