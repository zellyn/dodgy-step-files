ISO-10303-21;
/* Hea014 - Compound rebuild during ShapeCustom misses location chain
 * Compound containing one solid at NON-IDENTITY location, attached via a
 * MAPPED_ITEM that places the solid at (50,0,0). Renumbered IDs so there
 * are no duplicates. After ShapeCustom rebuild the compound's location
 * should still be honored; the defect is implementation-only. */
HEADER;
FILE_DESCRIPTION(('Hea014 test case','Compound w/ solid at non-identity location via MAPPED_ITEM'),'2;1');
FILE_NAME('Hea014.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Identity placement and host plane */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('identity',#10,#11,#12);
#14=PLANE('host',#13);
/* Unit-square face (the "solid" stand-in for this fixture) */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));#21=VERTEX_POINT('',#20);
#22=CARTESIAN_POINT('',(1.0,0.0,0.0));#23=VERTEX_POINT('',#22);
#24=CARTESIAN_POINT('',(1.0,1.0,0.0));#25=VERTEX_POINT('',#24);
#26=CARTESIAN_POINT('',(0.0,1.0,0.0));#27=VERTEX_POINT('',#26);
#30=DIRECTION('',(1.0,0.0,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#20,#31);
#33=EDGE_CURVE('',#21,#23,#32,.T.);
#34=DIRECTION('',(0.0,1.0,0.0));#35=VECTOR('',#34,1.0);#36=LINE('',#22,#35);
#37=EDGE_CURVE('',#23,#25,#36,.T.);
#38=DIRECTION('',(-1.0,0.0,0.0));#39=VECTOR('',#38,1.0);#40=LINE('',#24,#39);
#41=EDGE_CURVE('',#25,#27,#40,.T.);
#42=DIRECTION('',(0.0,-1.0,0.0));#43=VECTOR('',#42,1.0);#44=LINE('',#26,#43);
#45=EDGE_CURVE('',#27,#21,#44,.T.);
#50=ORIENTED_EDGE('',*,*,#33,.T.);#51=ORIENTED_EDGE('',*,*,#37,.T.);
#52=ORIENTED_EDGE('',*,*,#41,.T.);#53=ORIENTED_EDGE('',*,*,#45,.T.);
#54=EDGE_LOOP('',(#50,#51,#52,#53));
#55=FACE_OUTER_BOUND('',#54,.T.);
#56=ADVANCED_FACE('quad',(#55),#14,.T.);
#57=CLOSED_SHELL('child_shell',(#56));
#58=MANIFOLD_SOLID_BREP('child_solid',#57);
/* PRODUCT chain (renumbered to avoid duplicate IDs) */
#60=PRODUCT_CONTEXT('',#1,'mechanical');
#61=PRODUCT('part1','part1','part1',(#60));
#62=PRODUCT_DEFINITION_FORMATION('','',#61);
#63=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#64=PRODUCT_DEFINITION('','',#62,#63);
#65=PRODUCT_DEFINITION_SHAPE('','',#64);
/* Non-identity placement at (50, 0, 0); attach the solid via REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION */
#70=CARTESIAN_POINT('',(50.0,0.0,0.0));
#71=DIRECTION('',(0.0,0.0,1.0));#72=DIRECTION('',(1.0,0.0,0.0));
#73=AXIS2_PLACEMENT_3D('non_identity',#70,#71,#72);
#74=ITEM_DEFINED_TRANSFORMATION('move_50',$,#13,#73);
#75=GEOMETRIC_REPRESENTATION_CONTEXT('local_ctx',(#13),3);
#76=SHAPE_REPRESENTATION('child_repr',(#56),#75);
#77=SHAPE_REPRESENTATION('parent_compound',(#73),#75);
#78=(REPRESENTATION_RELATIONSHIP('move','solid located at non-identity',#76,#77)
     REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#74)
     SHAPE_REPRESENTATION_RELATIONSHIP());
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Hea014','Hea014','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9022=ADVANCED_BREP_SHAPE_REPRESENTATION('',(#58),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
