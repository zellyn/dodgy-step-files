ISO-10303-21;
/* Tfa115 — ShapeFix_Face.FixPeriodicDegenerated revolution-axis edge
 * Defect: surface of revolution where the revolution axis intersects the face;
 * the degenerate edge construction misplaces the apex curve.
 * 360-degree cylinder (surface of revolution with v-periodic, radius=1, axis at z).
 * A face on this surface touches the rotation axis at one edge (degenerate v=0 edge).
 * FixPeriodicDegenerated must correctly handle the revolution-axis degenerate edge,
 * different from cone apex. Revolution surfaces pinch at v=0 to a line on the axis. */
HEADER;
FILE_DESCRIPTION(('Tfa115 - FixPeriodicDegenerated revolution-axis degenerate edge'),'2;1');
FILE_NAME('Tfa115.stp','2026-06-16T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Surface of revolution: cylinder of radius 1.0, axis along z, full 360 degrees */
#10=CARTESIAN_POINT('axis_origin',(0.0,0.0,0.0));
#11=DIRECTION('revolution_axis',(0.0,0.0,1.0));
#12=DIRECTION('axis_ref_x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('revolution_place',#10,#11,#12);
/* Profile: line from (1,0,0) to (1,0,2), perpendicular to axis at distance 1.0 */
#14=CARTESIAN_POINT('profile_start',(1.0,0.0,0.0));
#15=DIRECTION('profile_dir',(0.0,0.0,1.0));
#16=VECTOR('profile_vec',#15,1.0);
#17=LINE('profile_line',#14,#16);
/* Construct a parametric 2D representation for the profile (curve in the revolution plane) */
#18=CARTESIAN_POINT('profile_2d_start',(1.0,0.0));
#19=DIRECTION('profile_2d_dir',(0.0,1.0));
#20=VECTOR('profile_2d_vec',#19,1.0);
#21=LINE('profile_2d_line',#18,#20);
/* Create surface of revolution (will be approximated as plane for this fixture) */
/* Using a cylindrical surface as substitute for SURFACE_OF_REVOLUTION */
#22=CYLINDRICAL_SURFACE('cylinder_approx',#13,1.0);
/* Face boundary: rectangle in (u,v) parameter space where u is revolution angle [0,2pi], v is height [0,2] */
/* u=0, v from 0 to 2 */
#30=CARTESIAN_POINT('bound_v1',(1.0,0.0,0.0));
#31=VERTEX_POINT('bvp1',#30);
#32=CARTESIAN_POINT('bound_v2',(1.0,0.0,2.0));
#33=VERTEX_POINT('bvp2',#32);
/* u=pi, v from 0 to 2 (opposite side of cylinder) */
#34=CARTESIAN_POINT('bound_v3',(-1.0,0.0,2.0));
#35=VERTEX_POINT('bvp3',#34);
#36=CARTESIAN_POINT('bound_v4',(-1.0,0.0,0.0));
#37=VERTEX_POINT('bvp4',#36);
/* Edge 1: u=0, v from 0 to 2 (line on cylinder) */
#40=LINE('edge1_3d',(#30),#41);
#41=VECTOR('edge1_vec',#42,1.0);
#42=DIRECTION('edge1_dir',(0.0,0.0,1.0));
#43=EDGE_CURVE('edge1',#31,#33,#40,.T.);
/* Edge 2: v=2, u from 0 to pi (arc on top of cylinder) */
#44=CARTESIAN_POINT('e2_center',(0.0,0.0,2.0));
#45=DIRECTION('e2_x',(1.0,0.0,0.0));
#46=DIRECTION('e2_z',(0.0,0.0,1.0));
#47=AXIS2_PLACEMENT_3D('e2_place',#44,#46,#45);
#48=CIRCLE('e2_arc',#47,1.0);
#49=EDGE_CURVE('edge2',#33,#35,#48,.T.);
/* Edge 3: u=pi, v from 2 to 0 (line on cylinder) */
#50=LINE('edge3_3d',(#34),#51);
#51=VECTOR('edge3_vec',#52,1.0);
#52=DIRECTION('edge3_dir',(0.0,0.0,-1.0));
#53=EDGE_CURVE('edge3',#35,#37,#50,.T.);
/* Edge 4: v=0, u from pi to 0 (DEGENERATE: touches rotation axis) */
/* At v=0 on revolution surface, all points collapse to a line on the rotation axis */
/* This is the DEGENERATE edge that FixPeriodicDegenerated must handle */
#54=CARTESIAN_POINT('e4_on_axis',(0.0,0.0,0.0));
#55=DIRECTION('e4_along_axis',(0.0,0.0,1.0));
#56=VECTOR('e4_axis_vec',#55,1.0);
#57=LINE('e4_axis_line',#54,#56);
/* Vertex at end of degenerate edge differs from start only in parameter space */
#58=EDGE_CURVE('edge4_degenerate',#37,#31,#57,.T.);
/* Outer loop */
#60=ORIENTED_EDGE('oe1',*,*,#43,.T.);
#61=ORIENTED_EDGE('oe2',*,*,#49,.T.);
#62=ORIENTED_EDGE('oe3',*,*,#53,.T.);
#63=ORIENTED_EDGE('oe4',*,*,#58,.T.);
#64=EDGE_LOOP('revolution_loop',(#60,#61,#62,#63));
#65=FACE_OUTER_BOUND('revolution_bound',#64,.T.);
/* Face on cylindrical surface (approximating SURFACE_OF_REVOLUTION) */
#70=ADVANCED_FACE('revolution_face',(#65),#22,.T.);
/* PRODUCT chain */
#200=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#201=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#202=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#203=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#200,'distance_accuracy_value','');
#204=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#203))GLOBAL_UNIT_ASSIGNED_CONTEXT((#200,#201,#202))REPRESENTATION_CONTEXT('','3D'));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa115','Tfa115','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9020=OPEN_SHELL('wrap_shell',(#70));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#204);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
