#9=DIRECTION('',(-1.0,0.0,0.0));
#10=AXIS2_PLACEMENT_3D('',#8,#2,#9);
#11=CIRCLE('',#10,2.0000000000);
#12=EDGE_CURVE('belt_above_apex',#7,#7,#11,.T.);
