/* Tfa070 - CURVE_BOUNDED_SURFACE.implicit_outer = .U. (unset)
   Defect: BRL-CAD step-g CurveBoundedSurface::Load reads the
   `implicit_outer` BOOLEAN attribute via getBooleanAttribute with a
   default of BUnset; LoadONBrep is a stub that prints "not implemented
   for <entity>" and returns false.  The schema actually allows three
   states (.T. / .F. / unset implied via missing attribute), but a
   .U. literal in the file leaves the boundary semantics ambiguous: is
   the natural boundary of the basis surface to be considered the outer
   loop, or are all listed boundaries explicit? step-g neither chooses
   a default behaviour nor rejects the construction; the face is
   silently dropped.
   Sources: BRL-CAD src/conv/step/step-g/CurveBoundedSurface.cpp -
   `implicit_outer` defaults BUnset; LoadONBrep stub. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(
  ('Tfa070 - CURVE_BOUNDED_SURFACE implicit_outer unset and LoadONBrep stub'),
  '2;1');
FILE_NAME('Tfa070.stp','2026-05-02T00:00:00',('cad-research-suite'),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Host plane. */
#10=CARTESIAN_POINT('o',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('pl',#10,#11,#12);
#14=PLANE('host',#13);
/* 2D parameter context. */
#20=(GEOMETRIC_REPRESENTATION_CONTEXT(2)
     PARAMETRIC_REPRESENTATION_CONTEXT()
     REPRESENTATION_CONTEXT('uv','2D'));
/* A single rectangular boundary in (u,v). */
#30=CARTESIAN_POINT('uv0',(0.0,0.0));
#31=CARTESIAN_POINT('uv1',(1.0,0.0));
#32=CARTESIAN_POINT('uv2',(1.0,1.0));
#33=CARTESIAN_POINT('uv3',(0.0,1.0));
#40=POLYLINE('rect_uv',(#30,#31,#32,#33,#30));
#50=DEFINITIONAL_REPRESENTATION('def',(#40),#20);
#60=PCURVE('rect_pcurve',#14,#50);
/* The boundary curve as required by CURVE_BOUNDED_SURFACE.boundaries. */
#70=BOUNDARY_CURVE('boundary',(#60),.PCURVE_S1.);
/* Defect: CURVE_BOUNDED_SURFACE with implicit_outer = .U. (unknown).
   step-g reads BUnset and never picks a side; LoadONBrep stubs out. */
#80=CURVE_BOUNDED_SURFACE('cbs_face',#14,(#70),.U.);
ENDSEC;
END-ISO-10303-21;
