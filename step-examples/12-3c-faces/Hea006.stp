ISO-10303-21;
/* Hea006 - Shape-contents inventory: subshape histogram
 * Compound containing one ADVANCED_FACE (a unit square) plus one free
 * 4-edge wire (a separate unit square in the y=2 plane). Subshape
 * inventory should report: 1 face, 1 wire, 8 edges, 8 vertices. */
HEADER;
FILE_DESCRIPTION(('Hea006 test case','Compound: 1 face + 1 free wire (4-edge); inventory totals 8 edges, 8 vertices'),'2;1');
FILE_NAME('Hea006.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
/* The face: unit square at z=0 */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));#21=VERTEX_POINT('V1',#20);
#22=CARTESIAN_POINT('',(1.0,0.0,0.0));#23=VERTEX_POINT('V2',#22);
#24=CARTESIAN_POINT('',(1.0,1.0,0.0));#25=VERTEX_POINT('V3',#24);
#26=CARTESIAN_POINT('',(0.0,1.0,0.0));#27=VERTEX_POINT('V4',#26);
#30=DIRECTION('',(1.0,0.0,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#20,#31);#33=EDGE_CURVE('e1',#21,#23,#32,.T.);
#34=DIRECTION('',(0.0,1.0,0.0));#35=VECTOR('',#34,1.0);#36=LINE('',#22,#35);#37=EDGE_CURVE('e2',#23,#25,#36,.T.);
#38=DIRECTION('',(-1.0,0.0,0.0));#39=VECTOR('',#38,1.0);#40=LINE('',#24,#39);#41=EDGE_CURVE('e3',#25,#27,#40,.T.);
#42=DIRECTION('',(0.0,-1.0,0.0));#43=VECTOR('',#42,1.0);#44=LINE('',#26,#43);#45=EDGE_CURVE('e4',#27,#21,#44,.T.);
#50=ORIENTED_EDGE('',*,*,#33,.T.);#51=ORIENTED_EDGE('',*,*,#37,.T.);
#52=ORIENTED_EDGE('',*,*,#41,.T.);#53=ORIENTED_EDGE('',*,*,#45,.T.);
#54=EDGE_LOOP('face_loop',(#50,#51,#52,#53));
#55=FACE_OUTER_BOUND('',#54,.T.);
#56=ADVANCED_FACE('the_one_face',(#55),#14,.T.);
/* The free wire: unit square at z=2 -- topologically separate, NOT attached to a face */
#60=CARTESIAN_POINT('',(0.0,0.0,2.0));#61=VERTEX_POINT('W1',#60);
#62=CARTESIAN_POINT('',(1.0,0.0,2.0));#63=VERTEX_POINT('W2',#62);
#64=CARTESIAN_POINT('',(1.0,1.0,2.0));#65=VERTEX_POINT('W3',#64);
#66=CARTESIAN_POINT('',(0.0,1.0,2.0));#67=VERTEX_POINT('W4',#66);
#70=DIRECTION('',(1.0,0.0,0.0));#71=VECTOR('',#70,1.0);#72=LINE('',#60,#71);#73=EDGE_CURVE('we1',#61,#63,#72,.T.);
#74=DIRECTION('',(0.0,1.0,0.0));#75=VECTOR('',#74,1.0);#76=LINE('',#62,#75);#77=EDGE_CURVE('we2',#63,#65,#76,.T.);
#78=DIRECTION('',(-1.0,0.0,0.0));#79=VECTOR('',#78,1.0);#80=LINE('',#64,#79);#81=EDGE_CURVE('we3',#65,#67,#80,.T.);
#82=DIRECTION('',(0.0,-1.0,0.0));#83=VECTOR('',#82,1.0);#84=LINE('',#66,#83);#85=EDGE_CURVE('we4',#67,#61,#84,.T.);
#86=ORIENTED_EDGE('',*,*,#73,.T.);#87=ORIENTED_EDGE('',*,*,#77,.T.);
#88=ORIENTED_EDGE('',*,*,#81,.T.);#89=ORIENTED_EDGE('',*,*,#85,.T.);
#90=EDGE_LOOP('the_one_free_wire',(#86,#87,#88,#89));
/* Compound */
#100=GEOMETRIC_SET('compound_face_plus_wire',(#56,#90));
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Hea006','Hea006','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#56));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
