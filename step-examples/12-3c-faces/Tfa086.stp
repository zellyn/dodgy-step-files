/* Third hole: (6,1)-(10,5) */
#110=CARTESIAN_POINT('',(6.0,1.0,0.0));
#111=VERTEX_POINT('v_h3_0',#110);
#112=CARTESIAN_POINT('',(10.0,1.0,0.0));
