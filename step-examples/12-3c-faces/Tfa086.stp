#119=VECTOR('',#118,1.0);
#120=LINE('',#112,#119);
#121=EDGE_CURVE('e_h3_right',#113,#63,#120,.T.);
#122=ORIENTED_EDGE('oe_h3_bot',*,*,#117,.T.);
#123=ORIENTED_EDGE('oe_h3_right',*,*,#121,.T.);
#124=ORIENTED_EDGE('oe_h3_shared_rev',*,*,#67,.F.);
#125=ORIENTED_EDGE('oe_h3_left',*,*,#45,.F.);
#126=EDGE_LOOP('hole3_loop',(#122,#123,#124,#125));
#127=FACE_INNER_BOUND('',#126,.T.);
/* Face with 3 inner bounds all using same coincident edge */
#130=ADVANCED_FACE('face_3coincident',(#51,#89,#109,#127),#14,.T.);
/* Minimal PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa086','Tfa086','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
