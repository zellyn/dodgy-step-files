#47=ORIENTED_EDGE('',*,*,#37,.T.);
#48=ORIENTED_EDGE('',*,*,#41,.T.);
#49=ORIENTED_EDGE('',*,*,#45,.T.);
#50=EDGE_LOOP('outer_loop',(#46,#47,#48,#49));
#51=FACE_OUTER_BOUND('',#50,.T.);
/* Shared edge at Y=5 from (2,5) to (10,5) - used by 3 wires */
#60=CARTESIAN_POINT('',(2.0,5.0,0.0));
#61=VERTEX_POINT('v_shared_start',#60);
#62=CARTESIAN_POINT('',(10.0,5.0,0.0));
#63=VERTEX_POINT('v_shared_end',#62);
#64=DIRECTION('',(1.0,0.0,0.0));
#65=VECTOR('',#64,1.0);
#66=LINE('',#60,#65);
#67=EDGE_CURVE('e_shared_coincident',#61,#63,#66,.T.);
/* First hole: (2,1)-(4,5) */
#70=CARTESIAN_POINT('',(2.0,1.0,0.0));
#71=VERTEX_POINT('v_h1_0',#70);
#72=CARTESIAN_POINT('',(4.0,1.0,0.0));
#73=VERTEX_POINT('v_h1_1',#72);
