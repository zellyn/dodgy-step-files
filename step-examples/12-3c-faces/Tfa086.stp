ISO-10303-21;
/* Tfa086 - ShapeFix_Face.FixWiresTwoCoincEdges: 3-edge coincidence
 * Face with three wires sharing a coincident edge. FixWiresTwoCoincEdges
 * only handles the 2-wire case and skips the 3rd wire.
 */
HEADER;
FILE_DESCRIPTION(('Tfa086 test case','Face with 3 wires sharing coincident edge; FixWiresTwoCoincEdges handles 2-wire only'),'2;1');
FILE_NAME('Tfa086.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Plane at Z=0 */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
