ISO-10303-21;
/* Tfa063 - Stack overflow on RemoveSmallFaces due to unbounded recursion
 * Shell of 10 stacked thin slabs each 1x1mm but at successive z-heights of
 * 0.0001mm. Catalog calls for 1000 slabs; this fixture is a scaled
 * representative -- topology pattern (chain of small faces each smaller
 * than the threshold) is identical. */
HEADER;
FILE_DESCRIPTION(('Tfa063 test case','Stack of 10 thin slabs (scaled representative of 1000)'),'2;1');
FILE_NAME('Tfa063.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
