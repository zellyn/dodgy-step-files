ISO-10303-21;
/* Tfa064 - Missing-seam reconstruction fails on face whose wire already contains a partial seam
 * Cylindrical face on radius=1, height=2. The wire has the seam at U=0 only
 * for the LOWER half (V in [0,1]) and the rest of the boundary closes via
 * a top arc, the lateral pcurve at U=2*PI, and the bottom arc -- the
 * UPPER seam segment (V in [1,2]) is MISSING. */
HEADER;
FILE_DESCRIPTION(('Tfa064 test case','Cylindrical face wire with partial-only seam (lower half present, upper missing)'),'2;1');
FILE_NAME('Tfa064.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('cyl_axis',#10,#11,#12);
#14=CYLINDRICAL_SURFACE('host',#13,1.0);
/* Vertices for the wire */
#20=CARTESIAN_POINT('seam_bottom',(1.0,0.0,0.0));#21=VERTEX_POINT('Vsb',#20);
#22=CARTESIAN_POINT('seam_mid',(1.0,0.0,1.0));#23=VERTEX_POINT('Vsm',#22);
#24=CARTESIAN_POINT('top_far_a',(1.0,0.0,2.0));#25=VERTEX_POINT('Vt',#24);
#26=CARTESIAN_POINT('top_far_b',(1.0,0.0,2.0));#27=VERTEX_POINT('Vt2',#26);
/* edge1: PARTIAL SEAM lower half V=[0,1] */
#30=DIRECTION('',(0.0,0.0,1.0));#31=VECTOR('',#30,1.0);
#32=LINE('partial_seam_lower',#20,#31);#33=EDGE_CURVE('seam_lower',#21,#23,#32,.T.);
/* edge2: top arc Vsm -> Vt (full top circle as placeholder for lateral closure) */
#40=CARTESIAN_POINT('arc_top_centre',(0.0,0.0,1.0));
#41=DIRECTION('',(0.0,0.0,1.0));#42=DIRECTION('',(1.0,0.0,0.0));
#43=AXIS2_PLACEMENT_3D('',#40,#41,#42);
#44=CIRCLE('mid_arc',#43,1.0);
#45=EDGE_CURVE('lateral_via_top_arc',#23,#25,#44,.T.);
/* edge3: bottom-arc back from Vt2 to Vsb (closing the wire) -- Vt and Vt2 are
 * coincident geometrically but separate VERTEX_POINTs because the missing
 * upper seam has not yet been spliced in. */
#50=CARTESIAN_POINT('arc_bottom_centre',(0.0,0.0,2.0));
#51=DIRECTION('',(0.0,0.0,1.0));#52=DIRECTION('',(1.0,0.0,0.0));
#53=AXIS2_PLACEMENT_3D('',#50,#51,#52);
#54=CIRCLE('return_arc',#53,1.0);
#55=EDGE_CURVE('return',#27,#21,#54,.T.);
/* Wire references the lower partial seam, the top arc, and the closing arc.
 * The UPPER half of the seam (Vsm -> Vt at U=0) is INTENTIONALLY ABSENT. */
#60=ORIENTED_EDGE('',*,*,#33,.T.);
#61=ORIENTED_EDGE('',*,*,#45,.T.);
#62=ORIENTED_EDGE('',*,*,#55,.T.);
#63=EDGE_LOOP('partial_seam_no_upper_half',(#60,#61,#62));
#64=FACE_OUTER_BOUND('',#63,.T.);
#65=ADVANCED_FACE('cyl_partial_seam',(#64),#14,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa064','Tfa064','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#65));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
