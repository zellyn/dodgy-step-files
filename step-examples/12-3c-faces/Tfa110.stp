ISO-10303-21;
/* Tfa110 - ShapeFix_Face.FixOrientation indeterminate-normal
 * Face with a wire that's a single closed curve (e.g., circle).
 * FixOrientation's winding-direction test doesn't have well-defined inside/outside
 * for a planar circle without external context.
 * Expected: should handle planar circular wires unambiguously.
 */
HEADER;
FILE_DESCRIPTION(('Tfa110 test case','Face with single planar circular wire (indeterminate normal)'),'2;1');
FILE_NAME('Tfa110.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* === Planar surface: z = 0 === */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);#14=PLANE('circle_plane',#13);
/* === Single closed circular wire (radius 5) === */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=AXIS2_PLACEMENT_3D('',#20,#11,#12);
#22=CIRCLE('boundary_circle',#21,5.0);
/* === Start/end vertex on the circle === */
#30=CARTESIAN_POINT('',(5.0,0.0,0.0));#31=VERTEX_POINT('',#30);
/* === Full circle edge (closed curve) === */
#40=EDGE_CURVE('circle_edge_closed',#31,#31,#22,.T.);
/* === Edge in loop (single edge forming closed wire) === */
#50=ORIENTED_EDGE('oe_circle',*,*,#40,.T.);
#51=EDGE_LOOP('circle_wire_single_edge',(#50));
#52=FACE_OUTER_BOUND('',#51,.T.);
/* === Face with single-edge circular boundary === */
#60=ADVANCED_FACE('indeterminate_normal_face',(#52),#14,.T.);
/* === Mandatory product chain === */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa110','Tfa110','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=OPEN_SHELL('shell',(#60));
#9022=SHELL_BASED_SURFACE_MODEL('sbsm',(#9021));
#9023=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9022),#9010);
#9024=SHAPE_DEFINITION_REPRESENTATION(#9005,#9023);
ENDSEC;
END-ISO-10303-21;
