ISO-10303-21;
/* Tfa137 - ShapeAnalysis_CheckSmallFace.CheckTwisted face-with-hole
 * A rectangular face with a hole inside. The twist classification uses only
 * the outer wire for inside/outside test, missing the hole's winding contribution.
 */
HEADER;
FILE_DESCRIPTION(('Tfa137 test case','ShapeAnalysis_CheckSmallFace.CheckTwisted face-with-hole'),'2;1');
FILE_NAME('Tfa137.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* === Face with outer + inner bounds === */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);#14=PLANE('face_plane',#13);
