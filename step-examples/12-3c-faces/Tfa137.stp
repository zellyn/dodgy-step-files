#22=CARTESIAN_POINT('',(12.0,0.0,0.0));#23=VERTEX_POINT('',#22);
#24=CARTESIAN_POINT('',(12.0,10.0,0.0));#25=VERTEX_POINT('',#24);
#26=CARTESIAN_POINT('',(0.0,10.0,0.0));#27=VERTEX_POINT('',#26);
#30=DIRECTION('',(1.0,0.0,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#20,#31);
#33=EDGE_CURVE('e_outer_1',#21,#23,#32,.T.);
#34=DIRECTION('',(0.0,1.0,0.0));#35=VECTOR('',#34,1.0);#36=LINE('',#22,#35);
#37=EDGE_CURVE('e_outer_2',#23,#25,#36,.T.);
#38=DIRECTION('',(-1.0,0.0,0.0));#39=VECTOR('',#38,1.0);#40=LINE('',#24,#39);
#41=EDGE_CURVE('e_outer_3',#25,#27,#40,.T.);
#42=DIRECTION('',(0.0,-1.0,0.0));#43=VECTOR('',#42,1.0);#44=LINE('',#26,#43);
#45=EDGE_CURVE('e_outer_4',#27,#21,#44,.T.);
#46=ORIENTED_EDGE('',*,*,#33,.T.);#47=ORIENTED_EDGE('',*,*,#37,.T.);
#48=ORIENTED_EDGE('',*,*,#41,.T.);#49=ORIENTED_EDGE('',*,*,#45,.T.);
#50=EDGE_LOOP('outer_loop',(#46,#47,#48,#49));
#51=FACE_OUTER_BOUND('',#50,.T.);
/* === Inner wire (hole): 4x3 rectangle at center (4,3.5) to (8,6.5) === */
#60=CARTESIAN_POINT('',(4.0,3.5,0.0));#61=VERTEX_POINT('',#60);
#62=CARTESIAN_POINT('',(8.0,3.5,0.0));#63=VERTEX_POINT('',#62);
#64=CARTESIAN_POINT('',(8.0,6.5,0.0));#65=VERTEX_POINT('',#64);
#66=CARTESIAN_POINT('',(4.0,6.5,0.0));#67=VERTEX_POINT('',#66);
#70=DIRECTION('',(1.0,0.0,0.0));#71=VECTOR('',#70,1.0);#72=LINE('',#60,#71);
#73=EDGE_CURVE('e_hole_1',#61,#63,#72,.T.);
#74=DIRECTION('',(0.0,1.0,0.0));#75=VECTOR('',#74,1.0);#76=LINE('',#62,#75);
#77=EDGE_CURVE('e_hole_2',#63,#65,#76,.T.);
#78=DIRECTION('',(-1.0,0.0,0.0));#79=VECTOR('',#78,1.0);#80=LINE('',#64,#79);
#81=EDGE_CURVE('e_hole_3',#65,#67,#80,.T.);
#82=DIRECTION('',(0.0,-1.0,0.0));#83=VECTOR('',#82,1.0);#84=LINE('',#66,#83);
#85=EDGE_CURVE('e_hole_4',#67,#61,#84,.T.);
#86=ORIENTED_EDGE('',*,*,#73,.T.);#87=ORIENTED_EDGE('',*,*,#77,.T.);
#88=ORIENTED_EDGE('',*,*,#81,.T.);#89=ORIENTED_EDGE('',*,*,#85,.T.);
#90=EDGE_LOOP('hole_loop',(#86,#87,#88,#89));
#91=FACE_INNER_BOUND('',#90,.T.);
#100=ADVANCED_FACE('face_with_hole',(#51,#91),#14,.T.);
/* === Wrap in PRODUCT chain === */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
