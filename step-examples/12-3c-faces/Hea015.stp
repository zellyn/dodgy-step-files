ISO-10303-21;
/* Hea015 - Shape healing regression after PR #584
 * Two ADVANCED_FACEs on the SAME PLANE sharing one edge E. The shared
 * edge's SURFACE_CURVE carries TWO pcurves (one per face's parameter
 * frame). After a glue-edges-with-pcurves operation, defective heal
 * leaves only one pcurve attached. */
HEADER;
FILE_DESCRIPTION(('Hea015 test case','Two faces on same PLANE share edge E with pcurves on both sides'),'2;1');
FILE_NAME('Hea015.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Single shared PLANE for both faces */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('shared_plane_repr',#10,#11,#12);
#14=PLANE('shared_plane',#13);
/* 6 perimeter vertices */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));#21=VERTEX_POINT('V_A0',#20);
#22=CARTESIAN_POINT('',(1.0,0.0,0.0));#23=VERTEX_POINT('V_S0',#22);
#24=CARTESIAN_POINT('',(2.0,0.0,0.0));#25=VERTEX_POINT('V_B0',#24);
#26=CARTESIAN_POINT('',(2.0,1.0,0.0));#27=VERTEX_POINT('V_B1',#26);
#28=CARTESIAN_POINT('',(1.0,1.0,0.0));#29=VERTEX_POINT('V_S1',#28);
#30=CARTESIAN_POINT('',(0.0,1.0,0.0));#31=VERTEX_POINT('V_A1',#30);
/* Plain edges (no pcurve) */
#40=DIRECTION('',(1.0,0.0,0.0));#41=VECTOR('',#40,1.0);#42=LINE('',#20,#41);#43=EDGE_CURVE('A_bottom',#21,#23,#42,.T.);
#48=DIRECTION('',(-1.0,0.0,0.0));#49=VECTOR('',#48,1.0);#50=LINE('',#28,#49);#51=EDGE_CURVE('A_top',#29,#31,#50,.T.);
#52=DIRECTION('',(0.0,-1.0,0.0));#53=VECTOR('',#52,1.0);#54=LINE('',#30,#53);#55=EDGE_CURVE('A_left',#31,#21,#54,.T.);
#56=DIRECTION('',(1.0,0.0,0.0));#57=VECTOR('',#56,1.0);#58=LINE('',#22,#57);#59=EDGE_CURVE('B_bottom',#23,#25,#58,.T.);
#60=DIRECTION('',(0.0,1.0,0.0));#61=VECTOR('',#60,1.0);#62=LINE('',#24,#61);#63=EDGE_CURVE('B_right',#25,#27,#62,.T.);
#64=DIRECTION('',(-1.0,0.0,0.0));#65=VECTOR('',#64,1.0);#66=LINE('',#26,#65);#67=EDGE_CURVE('B_top',#27,#29,#66,.T.);
/* Shared edge E: SURFACE_CURVE with TWO pcurves */
#70=DIRECTION('',(0.0,1.0,0.0));#71=VECTOR('',#70,1.0);#72=LINE('shared_3d',#22,#71);
/* pcurve A: U=1.0 along the edge in face A's UV frame */
#73=CARTESIAN_POINT('uv_pcA_start',(1.0,0.0));
#74=DIRECTION('',(0.0,1.0));#75=VECTOR('',#74,1.0);
#76=LINE('pcA_uv',#73,#75);
#77=DEFINITIONAL_REPRESENTATION('A_repr',(#76),#13);
#78=PCURVE('pcurve_A_side',#14,#77);
/* pcurve B: U=1.0 along the edge in face B's UV frame (also referencing same plane) */
#80=CARTESIAN_POINT('uv_pcB_start',(1.0,0.0));
#81=DIRECTION('',(0.0,1.0));#82=VECTOR('',#81,1.0);
#83=LINE('pcB_uv',#80,#82);
#84=DEFINITIONAL_REPRESENTATION('B_repr',(#83),#13);
#85=PCURVE('pcurve_B_side',#14,#84);
/* SURFACE_CURVE bundling both pcurves */
#86=SURFACE_CURVE('shared_edge_surface',#72,(#78,#85),.PCURVE_S1_AND_S2.);
#87=EDGE_CURVE('shared_E_with_two_pcurves',#23,#29,#86,.T.);
/* Face A outer wire */
#90=ORIENTED_EDGE('',*,*,#43,.T.);#91=ORIENTED_EDGE('',*,*,#87,.T.);
#92=ORIENTED_EDGE('',*,*,#51,.T.);#93=ORIENTED_EDGE('',*,*,#55,.T.);
#94=EDGE_LOOP('',(#90,#91,#92,#93));#95=FACE_OUTER_BOUND('',#94,.T.);
#96=ADVANCED_FACE('faceA_on_shared_plane',(#95),#14,.T.);
/* Face B outer wire */
#100=ORIENTED_EDGE('',*,*,#59,.T.);#101=ORIENTED_EDGE('',*,*,#63,.T.);
#102=ORIENTED_EDGE('',*,*,#67,.T.);#103=ORIENTED_EDGE('',*,*,#87,.F.);
#104=EDGE_LOOP('',(#100,#101,#102,#103));#105=FACE_OUTER_BOUND('',#104,.T.);
#106=ADVANCED_FACE('faceB_on_shared_plane',(#105),#14,.T.);
#110=OPEN_SHELL('two_faces_share_edge_with_two_pcurves',(#96,#106));
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Hea015','Hea015','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#110));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
