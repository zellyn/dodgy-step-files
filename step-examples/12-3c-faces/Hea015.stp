ISO-10303-21;
/* Hea015: Two ADVANCED_FACEs (A: (0,0)-(1,1), B: (1,0)-(2,1)) on same PLANE share edge E (x=1.0, from V_S0 to V_S1); shared edge has SURFACE_CURVE with TWO identical PCURVE entries (.PCURVE_S1_AND_S2., both at uv_start=(1.0,0.0) direction (0,1)); glue-edges-with-pcurves drops one pcurve, leaving wrong face binding; heal regression: pcurve-to-face binding must be preserved */
HEADER;
FILE_DESCRIPTION(('Hea015'),'2;1');
FILE_NAME('Hea015.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
