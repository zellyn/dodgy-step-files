ISO-10303-21;
/* Tfa072 — ShapeFix_FixSmallFace.ReplaceVerticesInCaseOfSpot tolerance drift
 * Defect: planar spot-face with 3 vertices in tight cluster (0.001 radius).
 * Each EDGE_CURVE has a LINE direction that properly points from start to end
 * vertex. One vertex has tolerance 0.001, another 0.0001 to test tolerance
 * drift in vertex replacement logic. Healing must recognize cluster and
 * replace with single representative vertex. */
HEADER;
FILE_DESCRIPTION(('Tfa072 - spot-face vertex replacement with tolerance drift'),'2;1');
FILE_NAME('Tfa072.stp','2026-06-16T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Planar surface (spot face) */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z_dir',(0.0,0.0,1.0));
#12=DIRECTION('x_dir',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plane_place',#10,#11,#12);
#14=PLANE('spot_plane',#13);
/* Three vertices in tight cluster (within 0.001 radius of origin) */
#20=CARTESIAN_POINT('v1',(0.0005,0.0,0.0));
#21=VERTEX_POINT('vp1',#20);
#22=CARTESIAN_POINT('v2',(-0.0005,0.0008,0.0));
#23=VERTEX_POINT('vp2',#22);
#24=CARTESIAN_POINT('v3',(0.0,0.0009,0.0));
#25=VERTEX_POINT('vp3',#24);
/* Edge 1: v1 to v2. Direction must point from v1 toward v2: (-0.001, 0.0008, 0) */
#30=CARTESIAN_POINT('e1_start',(0.0005,0.0,0.0));
#31=DIRECTION('e1_dir',(-0.7809,0.6247,0.0));
#32=VECTOR('e1_vec',#31,0.00128);
#33=LINE('e1_line',#30,#32);
#34=EDGE_CURVE('edge1',#21,#23,#33,.T.);
/* Edge 2: v2 to v3. Direction must point from v2 toward v3: (0.0005, 0.0001, 0) */
#35=CARTESIAN_POINT('e2_start',(-0.0005,0.0008,0.0));
#36=DIRECTION('e2_dir',(0.981,0.1961,0.0));
#37=VECTOR('e2_vec',#36,0.00051);
#38=LINE('e2_line',#35,#37);
#39=EDGE_CURVE('edge2',#23,#25,#38,.T.);
/* Edge 3: v3 to v1. Direction must point from v3 toward v1: (0.0005, -0.0009, 0) */
#40=CARTESIAN_POINT('e3_start',(0.0,0.0009,0.0));
#41=DIRECTION('e3_dir',(0.4873,-0.8729,0.0));
#42=VECTOR('e3_vec',#41,0.00103);
#43=LINE('e3_line',#40,#42);
#44=EDGE_CURVE('edge3',#25,#21,#43,.T.);
/* Oriented edges forming closed loop */
#50=ORIENTED_EDGE('oe1',*,*,#34,.T.);
#51=ORIENTED_EDGE('oe2',*,*,#39,.T.);
#52=ORIENTED_EDGE('oe3',*,*,#44,.T.);
#53=EDGE_LOOP('spot_loop',(#50,#51,#52));
#54=FACE_OUTER_BOUND('spot_bound',#53,.T.);
/* Spot face on plane */
#60=ADVANCED_FACE('spot_face',(#54),#14,.T.);
/* Defect: tight vertex cluster with mixed tolerances 0.001 and 0.0001 */
/* PRODUCT chain */
#200=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#201=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#202=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#203=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#200,'distance_accuracy_value','');
#204=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#203))GLOBAL_UNIT_ASSIGNED_CONTEXT((#200,#201,#202))REPRESENTATION_CONTEXT('','3D'));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa072','Tfa072','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9020=OPEN_SHELL('wrap_shell',(#60));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#204);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
