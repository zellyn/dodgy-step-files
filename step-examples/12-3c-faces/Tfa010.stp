/* Tfa010 - Splitting vertex within face (vertex of one wire on edge of another)
 * Defect: a face contains a vertex that lies on the interior of another
 * wire's edge, effectively bisecting the face. The face boundary
 * regularity is broken; downstream Booleans see ambiguous adjacency.
 * Healer should split the face at the splitting vertex into two (or more)
 * regular faces, or flag and surface the defect.
 * Reproducer: ADVANCED_FACE outer wire 0,0 -> 10,0 -> 10,10 -> 0,10. An
 * inner edge from (5,5) to (5,0) anchors a vertex (5,0) sitting on the
 * interior of the outer wire's bottom edge.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Tfa010 splitting vertex within face'),'2;1');
FILE_NAME('Tfa010.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
#20=PLANE('plane_xy',#13);
#21=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#22=CARTESIAN_POINT('p1',(10.0,0.0,0.0));
#23=CARTESIAN_POINT('p2',(10.0,10.0,0.0));
#24=CARTESIAN_POINT('p3',(0.0,10.0,0.0));
/* Splitting vertex (5,0) sits on outer wire bottom edge interior.     */
#25=CARTESIAN_POINT('split',(5.0,0.0,0.0));
/* Mid vertex (5,5) for the splitting interior edge.                   */
#26=CARTESIAN_POINT('mid',(5.0,5.0,0.0));
#30=VERTEX_POINT('',#21);
#31=VERTEX_POINT('',#22);
#32=VERTEX_POINT('',#23);
#33=VERTEX_POINT('',#24);
#34=VERTEX_POINT('split_v',#25);
#35=VERTEX_POINT('mid_v',#26);
#40=DIRECTION('',(1.0,0.0,0.0));
#41=DIRECTION('',(0.0,1.0,0.0));
#42=DIRECTION('',(-1.0,0.0,0.0));
#43=DIRECTION('',(0.0,-1.0,0.0));
#50=VECTOR('',#40,10.0);
#51=VECTOR('',#41,10.0);
#52=VECTOR('',#42,10.0);
#53=VECTOR('',#43,10.0);
#54=VECTOR('',#43,5.0);
#60=LINE('',#21,#50);
#61=LINE('',#22,#51);
#62=LINE('',#23,#52);
#63=LINE('',#24,#53);
#64=LINE('inner_line',#26,#54);
#70=EDGE_CURVE('',#30,#31,#60,.T.);
#71=EDGE_CURVE('',#31,#32,#61,.T.);
#72=EDGE_CURVE('',#32,#33,#62,.T.);
#73=EDGE_CURVE('',#33,#30,#63,.T.);
/* Inner edge (5,5)->(5,0); its endpoint (5,0) lies on the interior of
 * outer edge #70 - the splitting vertex defect.                       */
#74=EDGE_CURVE('inner',#35,#34,#64,.T.);
#80=ORIENTED_EDGE('',*,*,#70,.T.);
#81=ORIENTED_EDGE('',*,*,#71,.T.);
#82=ORIENTED_EDGE('',*,*,#72,.T.);
#83=ORIENTED_EDGE('',*,*,#73,.T.);
#84=ORIENTED_EDGE('',*,*,#74,.T.);
#90=EDGE_LOOP('outer',(#80,#81,#82,#83));
/* Inner wire as a degenerate (open) FACE_BOUND: anchors vertex (5,0). */
#91=EDGE_LOOP('inner',(#84));
#100=FACE_OUTER_BOUND('',#90,.T.);
#101=FACE_BOUND('',#91,.T.);
#110=ADVANCED_FACE('split_vertex',(#100,#101),#20,.T.);
/* Minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa010','Tfa010','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#110));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
