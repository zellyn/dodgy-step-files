#134=AXIS2_PLACEMENT_3D('y2_place',#14,#135,#136);
#135=DIRECTION('y2_normal',(0.0,1.0,0.0));
#136=DIRECTION('y2_x',(1.0,0.0,0.0));
#137=ORIENTED_EDGE('f4_oe1',*,*,#37,.T.);
