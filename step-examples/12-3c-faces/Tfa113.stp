#108=EDGE_LOOP('f1_loop',(#104,#105,#106,#107));
#109=FACE_OUTER_BOUND('f1_bound',#108,.T.);
#110=ADVANCED_FACE('face1',(#109),#100,.F.);
/* Face 2: z=2 (top) */
#111=PLANE('plane_z2',(#112));
