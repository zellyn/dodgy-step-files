ISO-10303-21;
/* Tfa113 — ShapeFix_Face.FixOrientation 8-face polyhedron
 * Defect: face is one of 8 faces in a polyhedron (cube); orientation propagation
 * has to traverse the 8-face cycle and an off-by-one error means one face stays inverted.
 * All 8 faces of a cube with one face deliberately reversed; orientation traversal loop
 * fails to fix the last face due to iteration boundary condition. */
HEADER;
FILE_DESCRIPTION(('Tfa113 - FixOrientation 8-face cube'),'2;1');
FILE_NAME('Tfa113.stp','2026-06-16T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Cube vertices: 8 corners of a 2.0 x 2.0 x 2.0 cube */
#10=CARTESIAN_POINT('v_000',(0.0,0.0,0.0));
#11=VERTEX_POINT('vp_000',#10);
#12=CARTESIAN_POINT('v_001',(0.0,0.0,2.0));
