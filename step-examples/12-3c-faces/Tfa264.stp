ISO-10303-21;
/* Tfa264: FACE_SURFACE whose face_geometry slot references AXIS2_PLACEMENT_3D('placement_as_face_geometry') — the placement the plane would have been built from — and no PLANE (or any other surface) exists in the file. The boundary chain (closed circle, oriented edge, edge loop, face outer bound) is complete; the surface level alone was dropped */
HEADER;
FILE_DESCRIPTION(('Tfa264'),'2;1');
FILE_NAME('Tfa264.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=DIRECTION('',(0.0,0.0,1.0));
#3=DIRECTION('',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('placement_as_face_geometry',#1,#2,#3);
#5=CIRCLE('',#4,3.0);
#6=CARTESIAN_POINT('',(3.0,0.0,0.0));
#7=VERTEX_POINT('',#6);
#8=EDGE_CURVE('',#7,#7,#5,.T.);
#9=ORIENTED_EDGE('',$,$,#8,.T.);
#10=EDGE_LOOP('',(#9));
#11=FACE_OUTER_BOUND('',#10,.T.);
#12=FACE_SURFACE('tfa264_disc',(#11),#4,.T.);
#13=OPEN_SHELL('',(#12));
#14=SHELL_BASED_SURFACE_MODEL('',(#13));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Tfa264','Tfa264','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#14),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
END-ISO-10303-21;
