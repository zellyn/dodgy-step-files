ISO-10303-21;
/* Tfa099 - ShapeAnalysis_CheckSmallFace.CheckTwisted concave-cone
 * Face on cone with wire wrapped such that v-parameter decreases (reverse wrap).
 * CheckTwisted's normal-direction test mis-classifies for v-decreasing wraps.
 * Constructs cone and wire with decreasing v-parameter. */
HEADER;
FILE_DESCRIPTION(('Tfa099 test case','Face on cone with v-decreasing wrap'),'2;1');
FILE_NAME('Tfa099.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Cone surface: semi-vertical angle 30°, apex at origin, axis along z */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=CONE('cone_surf',#13,1.0,0.5236);
/* Vertices on cone: 4 points defining a wire at decreasing v (height) */
/* Point 1: u=0, v=4.0 (z=4.0) */
#20=CARTESIAN_POINT('',(4.0,0.0,4.0));#21=VERTEX_POINT('',#20);
/* Point 2: u=π/2, v=4.0 (z=4.0) */
#22=CARTESIAN_POINT('',(0.0,4.0,4.0));#23=VERTEX_POINT('',#22);
/* Point 3: u=π/2, v=2.0 (z=2.0) -- v DECREASES */
#24=CARTESIAN_POINT('',(0.0,2.0,2.0));#25=VERTEX_POINT('',#24);
/* Point 4: u=0, v=2.0 (z=2.0) -- v DECREASES */
#26=CARTESIAN_POINT('',(2.0,0.0,2.0));#27=VERTEX_POINT('',#26);
/* Edges on cone surface (using line approximations in 3D) */
/* Edge 1: (4,0,4) to (0,4,4) along v=4.0 circle */
#30=DIRECTION('',(-1.0,1.0,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#20,#31);
#33=EDGE_CURVE('cone_e1',#21,#23,#32,.T.);
/* Edge 2: (0,4,4) to (0,2,2) -- v decreases from 4 to 2 */
#34=DIRECTION('',(0.0,-1.0,-1.0));#35=VECTOR('',#34,1.0);#36=LINE('',#22,#35);
#37=EDGE_CURVE('cone_e2_v_dec',#23,#25,#36,.T.);
/* Edge 3: (0,2,2) to (2,0,2) -- v=2.0 circle, v still low */
#38=DIRECTION('',(1.0,-1.0,0.0));#39=VECTOR('',#38,1.0);#40=LINE('',#24,#39);
#41=EDGE_CURVE('cone_e3',#25,#27,#40,.T.);
/* Edge 4: (2,0,2) to (4,0,4) -- v increases from 2 to 4 */
#42=DIRECTION('',(1.0,0.0,1.0));#43=VECTOR('',#42,1.0);#44=LINE('',#26,#43);
#45=EDGE_CURVE('cone_e4_v_inc',#27,#21,#44,.T.);
/* Close outer loop with decreasing v wrap */
#50=ORIENTED_EDGE('',*,*,#33,.T.);#51=ORIENTED_EDGE('',*,*,#37,.T.);
#52=ORIENTED_EDGE('',*,*,#41,.T.);#53=ORIENTED_EDGE('',*,*,#45,.T.);
#54=EDGE_LOOP('cone_v_decreasing',(#50,#51,#52,#53));
#55=FACE_OUTER_BOUND('',#54,.T.);
/* Face on cone with v-decreasing wrap */
#60=ADVANCED_FACE('twisted_cone_face',(#55),#14,.T.);
/* PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa099','Tfa099','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#70));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
/* Closed shell wrapper */
#70=CLOSED_SHELL('shell',(#60));
ENDSEC;
END-ISO-10303-21;
