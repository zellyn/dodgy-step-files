ISO-10303-21;
/* Tfa111 — ShapeFix_Face.FixSmallAreaWire mixed-context
 * Defect: face has a small inner wire AND a large inner wire; FixSmallAreaWire
 * removes small one but accidentally also disturbs the large one's vertex references.
 * Mixed context: small hole at one location, large hole at another. When small wire
 * removed, vertex indices get corrupted for large wire's edges. */
HEADER;
FILE_DESCRIPTION(('Tfa111 - FixSmallAreaWire mixed-context small+large holes'),'2;1');
FILE_NAME('Tfa111.stp','2026-06-16T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Planar face 10.0 x 10.0 with outer boundary and two inner wires */
#10=PLANE('base_plane',(#11));
#11=AXIS2_PLACEMENT_3D('plane_loc',#12,#13,#14);
#12=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#13=DIRECTION('z_axis',(0.0,0.0,1.0));
#14=DIRECTION('x_axis',(1.0,0.0,0.0));
/* Outer boundary: 10x10 square vertices */
#20=CARTESIAN_POINT('outer_v1',(0.0,0.0,0.0));
#21=VERTEX_POINT('outvp1',#20);
#22=CARTESIAN_POINT('outer_v2',(10.0,0.0,0.0));
#23=VERTEX_POINT('outvp2',#22);
#24=CARTESIAN_POINT('outer_v3',(10.0,10.0,0.0));
#25=VERTEX_POINT('outvp3',#24);
#26=CARTESIAN_POINT('outer_v4',(0.0,10.0,0.0));
#27=VERTEX_POINT('outvp4',#26);
/* Outer boundary edges */
#30=LINE('outer_e1_line',#20,#31);
#31=VECTOR('outer_e1_vec',#32,1.0);
#32=DIRECTION('outer_e1_dir',(1.0,0.0,0.0));
#33=EDGE_CURVE('outer_e1',#21,#23,#30,.T.);
#34=LINE('outer_e2_line',#22,#35);
#35=VECTOR('outer_e2_vec',#36,1.0);
#36=DIRECTION('outer_e2_dir',(0.0,1.0,0.0));
#37=EDGE_CURVE('outer_e2',#23,#25,#34,.T.);
#38=LINE('outer_e3_line',#24,#39);
#39=VECTOR('outer_e3_vec',#40,1.0);
#40=DIRECTION('outer_e3_dir',(-1.0,0.0,0.0));
#41=EDGE_CURVE('outer_e3',#25,#27,#38,.T.);
#42=LINE('outer_e4_line',#26,#43);
#43=VECTOR('outer_e4_vec',#44,1.0);
#44=DIRECTION('outer_e4_dir',(0.0,-1.0,0.0));
#45=EDGE_CURVE('outer_e4',#27,#21,#42,.T.);
/* Outer loop */
#50=ORIENTED_EDGE('outer_oe1',*,*,#33,.T.);
#51=ORIENTED_EDGE('outer_oe2',*,*,#37,.T.);
#52=ORIENTED_EDGE('outer_oe3',*,*,#41,.T.);
#53=ORIENTED_EDGE('outer_oe4',*,*,#45,.T.);
#54=EDGE_LOOP('outer_loop',(#50,#51,#52,#53));
#55=FACE_OUTER_BOUND('outer_bound',#54,.T.);
/* LARGE INNER WIRE: 2.0 x 2.0 square at center (4,4) */
#60=CARTESIAN_POINT('large_iv1',(4.0,4.0,0.0));
#61=VERTEX_POINT('large_ivp1',#60);
#62=CARTESIAN_POINT('large_iv2',(6.0,4.0,0.0));
#63=VERTEX_POINT('large_ivp2',#62);
#64=CARTESIAN_POINT('large_iv3',(6.0,6.0,0.0));
#65=VERTEX_POINT('large_ivp3',#64);
#66=CARTESIAN_POINT('large_iv4',(4.0,6.0,0.0));
#67=VERTEX_POINT('large_ivp4',#66);
/* Large inner edges */
#70=LINE('large_ie1_line',#60,#71);
#71=VECTOR('large_ie1_vec',#72,1.0);
#72=DIRECTION('large_ie1_dir',(1.0,0.0,0.0));
#73=EDGE_CURVE('large_ie1',#61,#63,#70,.T.);
#74=LINE('large_ie2_line',#62,#75);
#75=VECTOR('large_ie2_vec',#76,1.0);
#76=DIRECTION('large_ie2_dir',(0.0,1.0,0.0));
#77=EDGE_CURVE('large_ie2',#63,#65,#74,.T.);
#78=LINE('large_ie3_line',#64,#79);
#79=VECTOR('large_ie3_vec',#80,1.0);
#80=DIRECTION('large_ie3_dir',(-1.0,0.0,0.0));
#81=EDGE_CURVE('large_ie3',#65,#67,#78,.T.);
#82=LINE('large_ie4_line',#66,#83);
#83=VECTOR('large_ie4_vec',#84,1.0);
#84=DIRECTION('large_ie4_dir',(0.0,-1.0,0.0));
#85=EDGE_CURVE('large_ie4',#67,#61,#82,.T.);
/* Large inner loop (area = 4.0 m^2, well above threshold) */
#90=ORIENTED_EDGE('large_ioe1',*,*,#73,.F.);
#91=ORIENTED_EDGE('large_ioe2',*,*,#77,.F.);
#92=ORIENTED_EDGE('large_ioe3',*,*,#81,.F.);
#93=ORIENTED_EDGE('large_ioe4',*,*,#85,.F.);
#94=EDGE_LOOP('large_iloop',(#90,#91,#92,#93));
#95=FACE_BOUND('large_inner_bound',#94,.T.);
/* SMALL INNER WIRE: 0.05 x 0.05 square at corner (1,1), area = 0.0025 m^2 */
#100=CARTESIAN_POINT('small_iv1',(1.0,1.0,0.0));
#101=VERTEX_POINT('small_ivp1',#100);
#102=CARTESIAN_POINT('small_iv2',(1.05,1.0,0.0));
#103=VERTEX_POINT('small_ivp2',#102);
#104=CARTESIAN_POINT('small_iv3',(1.05,1.05,0.0));
#105=VERTEX_POINT('small_ivp3',#104);
#106=CARTESIAN_POINT('small_iv4',(1.0,1.05,0.0));
#107=VERTEX_POINT('small_ivp4',#106);
/* Small inner edges */
#110=LINE('small_ie1_line',#100,#111);
#111=VECTOR('small_ie1_vec',#112,1.0);
#112=DIRECTION('small_ie1_dir',(1.0,0.0,0.0));
#113=EDGE_CURVE('small_ie1',#101,#103,#110,.T.);
#114=LINE('small_ie2_line',#102,#115);
#115=VECTOR('small_ie2_vec',#116,1.0);
#116=DIRECTION('small_ie2_dir',(0.0,1.0,0.0));
#117=EDGE_CURVE('small_ie2',#103,#105,#114,.T.);
#118=LINE('small_ie3_line',#104,#119);
#119=VECTOR('small_ie3_vec',#120,1.0);
#120=DIRECTION('small_ie3_dir',(-1.0,0.0,0.0));
#121=EDGE_CURVE('small_ie3',#105,#107,#118,.T.);
#122=LINE('small_ie4_line',#106,#123);
#123=VECTOR('small_ie4_vec',#124,1.0);
#124=DIRECTION('small_ie4_dir',(0.0,-1.0,0.0));
#125=EDGE_CURVE('small_ie4',#107,#101,#122,.T.);
/* Small inner loop (area = 0.0025 m^2, below typical threshold ~1e-6 m^2) */
#130=ORIENTED_EDGE('small_ioe1',*,*,#113,.F.);
#131=ORIENTED_EDGE('small_ioe2',*,*,#117,.F.);
#132=ORIENTED_EDGE('small_ioe3',*,*,#121,.F.);
#133=ORIENTED_EDGE('small_ioe4',*,*,#125,.F.);
#134=EDGE_LOOP('small_iloop',(#130,#131,#132,#133));
#135=FACE_BOUND('small_inner_bound',#134,.T.);
/* Face with outer + large inner + small inner bounds */
#140=ADVANCED_FACE('planar_face',(#55,#95,#135),#10,.T.);
/* PRODUCT chain */
#200=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#201=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#202=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#203=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#200,'distance_accuracy_value','');
#204=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#203))GLOBAL_UNIT_ASSIGNED_CONTEXT((#200,#201,#202))REPRESENTATION_CONTEXT('','3D'));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa111','Tfa111','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9020=OPEN_SHELL('wrap_shell',(#140));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#204);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
