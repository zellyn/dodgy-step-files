ISO-10303-21;
/* Tfa098 - ShapeFix_Face.FixSplitFace null-line
 * Face split by a LINE that has been internally replaced with null geometry.
 * FixSplitFace doesn't validate the splitter, leading to null-deref or
 * silently dropping the split. Outer wire contains edge referencing null LINE. */
HEADER;
FILE_DESCRIPTION(('Tfa098 test case','Face split by null-line edge'),'2;1');
FILE_NAME('Tfa098.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Plane */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);#14=PLANE('surf',#13);
/* Rectangle outer boundary */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));#21=VERTEX_POINT('',#20);
#22=CARTESIAN_POINT('',(10.0,0.0,0.0));#23=VERTEX_POINT('',#22);
#24=CARTESIAN_POINT('',(10.0,10.0,0.0));#25=VERTEX_POINT('',#24);
#26=CARTESIAN_POINT('',(0.0,10.0,0.0));#27=VERTEX_POINT('',#26);
/* Edge 1: normal */
#30=DIRECTION('',(1.0,0.0,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#20,#31);
#33=EDGE_CURVE('outer_e1',#21,#23,#32,.T.);
/* Edge 2: normal */
#34=DIRECTION('',(0.0,1.0,0.0));#35=VECTOR('',#34,1.0);#36=LINE('',#22,#35);
#37=EDGE_CURVE('outer_e2',#23,#25,#36,.T.);
/* Edge 3: normal */
#38=DIRECTION('',(-1.0,0.0,0.0));#39=VECTOR('',#38,1.0);#40=LINE('',#24,#39);
#41=EDGE_CURVE('outer_e3',#25,#27,#40,.T.);
/* Edge 4: DEFECT - references #99 which is intentionally null/undefined */
#42=DIRECTION('',(0.0,-1.0,0.0));#43=VECTOR('',#42,1.0);#44=LINE('',#26,#43);
#45=EDGE_CURVE('outer_e4_null_line',#27,#21,#99,.T.);
/* Outer loop with null-line edge */
#50=ORIENTED_EDGE('',*,*,#33,.T.);#51=ORIENTED_EDGE('',*,*,#37,.T.);
#52=ORIENTED_EDGE('',*,*,#41,.T.);#53=ORIENTED_EDGE('',*,*,#45,.T.);
#54=EDGE_LOOP('outer_with_null',(#50,#51,#52,#53));
#55=FACE_OUTER_BOUND('',#54,.T.);
/* Inner wire: dividing edge (splitter) also references null */
#60=CARTESIAN_POINT('',(1.0,1.0,0.0));#61=VERTEX_POINT('',#60);
#62=CARTESIAN_POINT('',(9.0,1.0,0.0));#63=VERTEX_POINT('',#62);
#64=EDGE_CURVE('splitter_null',#61,#63,#99,.T.);
#65=ORIENTED_EDGE('',*,*,#64,.T.);
#66=EDGE_LOOP('split_loop',(#65));
#67=FACE_INNER_BOUND('',#66,.T.);
/* Face with null-line references */
#70=ADVANCED_FACE('null_split_face',(#55,#67),#14,.T.);
/* PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa098','Tfa098','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#80));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
/* Closed shell wrapper */
#80=CLOSED_SHELL('shell',(#70));
ENDSEC;
END-ISO-10303-21;
