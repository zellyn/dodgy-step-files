ISO-10303-21;
/* Tfa030 - Reshape recording / location handling lost
 * Defect: BRepTools_ReShape historically lost local TopLoc_Location
 * transforms when replacing sub-shapes. A face/edge/vertex deep inside
 * a body could carry a non-identity location only meaningful for
 * assembly leaves; healers that propagate the wrong transform produce
 * shifted geometry. Healer should absorb the location into the
 * underlying surface/curve when sub-shapes carry non-identity location;
 * reset sub-shape location to identity. Preserve declared assembly
 * locations.
 * Reproducer: face whose AXIS2_PLACEMENT_3D carries a non-identity
 * transform (translation + rotation) at the leaf level - representing
 * a face Located(trsf) in the OCC API. After ReShape, the location
 * must survive.
 */
HEADER;
FILE_DESCRIPTION(('Tfa030 reshape location lost'),'2;1');
FILE_NAME('Tfa030.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('global_origin',(0.0,0.0,0.0));
#11=DIRECTION('z_global',(0.0,0.0,1.0));
#12=DIRECTION('x_global',(1.0,0.0,0.0));
/* Defect site: face-level placement is shifted by (3,4,5) and rotated
 * 30 deg about z. Only meaningful at the assembly leaf.                */
#20=CARTESIAN_POINT('face_origin_shifted',(3.0,4.0,5.0));
#21=DIRECTION('z_face',(0.0,0.0,1.0));
#22=DIRECTION('x_face',(0.866025403784439,0.5,0.0));
#23=AXIS2_PLACEMENT_3D('face_local_plc',#20,#21,#22);
#30=PLANE('face_plane_local',#23);
/* Outer wire defined in the local frame.                               */
#40=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#41=CARTESIAN_POINT('p1',(10.0,0.0,0.0));
#42=CARTESIAN_POINT('p2',(10.0,10.0,0.0));
#43=CARTESIAN_POINT('p3',(0.0,10.0,0.0));
#50=VERTEX_POINT('',#40);
#51=VERTEX_POINT('',#41);
#52=VERTEX_POINT('',#42);
#53=VERTEX_POINT('',#43);
#60=DIRECTION('',(1.0,0.0,0.0));
#61=DIRECTION('',(0.0,1.0,0.0));
#62=DIRECTION('',(-1.0,0.0,0.0));
#63=DIRECTION('',(0.0,-1.0,0.0));
#64=VECTOR('',#60,10.0);
#65=VECTOR('',#61,10.0);
#66=VECTOR('',#62,10.0);
#67=VECTOR('',#63,10.0);
#70=LINE('',#40,#64);
#71=LINE('',#41,#65);
#72=LINE('',#42,#66);
#73=LINE('',#43,#67);
#80=EDGE_CURVE('',#50,#51,#70,.T.);
#81=EDGE_CURVE('',#51,#52,#71,.T.);
#82=EDGE_CURVE('',#52,#53,#72,.T.);
#83=EDGE_CURVE('',#53,#50,#73,.T.);
#90=ORIENTED_EDGE('',*,*,#80,.T.);
#91=ORIENTED_EDGE('',*,*,#81,.T.);
#92=ORIENTED_EDGE('',*,*,#82,.T.);
#93=ORIENTED_EDGE('',*,*,#83,.T.);
#100=EDGE_LOOP('',(#90,#91,#92,#93));
#110=FACE_OUTER_BOUND('',#100,.T.);
#120=ADVANCED_FACE('face_with_location',(#110),#30,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa030','Tfa030','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#120));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
