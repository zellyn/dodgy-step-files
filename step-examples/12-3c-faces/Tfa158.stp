ISO-10303-21;
/* Tfa158 — ShapeFix_Face.FixOrientation closed-shell-context-loss
 * Single face with ambiguous orientation flag; FixOrientation loses closed-shell context.
 * Decision made context-free; closed-shell context would inform correctness.
 */
HEADER;
FILE_DESCRIPTION(('Tfa158 test case','Face with ambiguous orientation; context-free FixOrientation'),'2;1');
FILE_NAME('Tfa158.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
