/* Inner wire (hole): 2x2 square at (4,4) */
#60=CARTESIAN_POINT('',(4.0,4.0,0.0));#61=VERTEX_POINT('',#60);
#62=CARTESIAN_POINT('',(6.0,4.0,0.0));#63=VERTEX_POINT('',#62);
