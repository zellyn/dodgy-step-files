/* Tfa006 - Spot face: face collapsed to a point
 * Defect: a face whose entire boundary lies within Precision::Confusion
 * of a single point. All vertex coordinates are equal within tolerance,
 * surface evaluation degenerates. Common in Pro/E rounding output, ECAD
 * imports, and reverse-engineering pipelines. Healer must collapse the
 * spot face to a tolerant_vertex, remove the face from the shell, and
 * re-stitch incident edges via that vertex.
 * Reproducer: ADVANCED_FACE on a PLANE whose 4-edge FACE_OUTER_BOUND
 * traces vertices at (0,0,0), (1e-9,0,0), (1e-9,1e-9,0), (0,1e-9,0).
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Tfa006 spot face collapsed to point'),'2;1');
FILE_NAME('Tfa006.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
#20=PLANE('plane_xy',#13);
/* Defect site: four vertices within 1e-9 of one point.                 */
#21=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#22=CARTESIAN_POINT('p1',(1.0E-9,0.0,0.0));
#23=CARTESIAN_POINT('p2',(1.0E-9,1.0E-9,0.0));
#24=CARTESIAN_POINT('p3',(0.0,1.0E-9,0.0));
#30=VERTEX_POINT('',#21);
#31=VERTEX_POINT('',#22);
#32=VERTEX_POINT('',#23);
#33=VERTEX_POINT('',#24);
#40=DIRECTION('',(1.0,0.0,0.0));
#41=DIRECTION('',(0.0,1.0,0.0));
#42=DIRECTION('',(-1.0,0.0,0.0));
#43=DIRECTION('',(0.0,-1.0,0.0));
/* VECTOR magnitudes set to unit length so OCCT can build Geom_Line;
 * the defect tininess is preserved by vertex coordinates and TRIMMED_CURVE
 * parameter ranges below (1e-9). */
#50=VECTOR('',#40,1.0);
#51=VECTOR('',#41,1.0);
#52=VECTOR('',#42,1.0);
#53=VECTOR('',#43,1.0);
#60=LINE('',#21,#50);
#61=LINE('',#22,#51);
#62=LINE('',#23,#52);
#63=LINE('',#24,#53);
#70=EDGE_CURVE('',#30,#31,#60,.T.);
#71=EDGE_CURVE('',#31,#32,#61,.T.);
#72=EDGE_CURVE('',#32,#33,#62,.T.);
#73=EDGE_CURVE('',#33,#30,#63,.T.);
#80=ORIENTED_EDGE('',*,*,#70,.T.);
#81=ORIENTED_EDGE('',*,*,#71,.T.);
#82=ORIENTED_EDGE('',*,*,#72,.T.);
#83=ORIENTED_EDGE('',*,*,#73,.T.);
#90=EDGE_LOOP('',(#80,#81,#82,#83));
/* Trim the underlying PLANE to the tiny 1e-9 x 1e-9 spot face region.
 * This ensures the surface domain is finite even if OCCT collapses the
 * sub-tolerance wire (Precision::Confusion = 1e-7). Without this trim,
 * BRepGProp::SurfaceProperties walks the unbounded plane and reports
 * area=8e+100 which is meaningless. */
#95=RECTANGULAR_TRIMMED_SURFACE('spot_trim',#20,0.0,1.0E-9,0.0,1.0E-9,.T.,.T.);
#100=FACE_OUTER_BOUND('',#90,.T.);
#110=ADVANCED_FACE('spot',(#100),#95,.T.);
/* Minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa006','Tfa006','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#110));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
