ISO-10303-21;
/* Tfa082 - ShapeAnalysis_CheckSmallFace.CheckPin: pin-direction classification
 * Face with sharp pin (near-zero-angle convex corner) along V parametric axis
 * instead of U; classifier assumes pin aligns with U, should be axis-agnostic.
 * Uses NURBS surface with a singularity in the V-parameter direction.
 */
HEADER;
FILE_DESCRIPTION(('Tfa082 test case','Face with pin along V-axis; CheckPin classifier needs axis-agnostic detection'),'2;1');
FILE_NAME('Tfa082.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* NURBS surface: 3x2 poles, degree 2 in U, degree 1 in V
   Pin singularity along V-axis at v=0.5 */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Pole grid for NURBS (3 U-knots, 2 V-knots): U=[0,0,0,1,1,1], V=[0,1] */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(2.5,0.0,0.0));
#22=CARTESIAN_POINT('',(5.0,0.0,0.0));
#23=CARTESIAN_POINT('',(0.0,5.0,0.001));
#24=CARTESIAN_POINT('',(2.5,5.0,0.0));
#25=CARTESIAN_POINT('',(5.0,5.0,0.001));
#30=B_SPLINE_SURFACE('pin_surface_v_axis',.F.,.F.,.F.,(
  (#20,#21,#22),
  (#23,#24,#25)
),2,1,(0.0,0.0,0.0,1.0,1.0,1.0),(0.0,1.0),.UNSPECIFIED.,.F.,.F.);
#40=RECTANGULAR_TRIMMED_SURFACE('trimmed_pin_v',#30,0.0,1.0,0.0,1.0);
/* Square boundary in parametric space maps to pin shape in 3D */
#50=CARTESIAN_POINT('',(0.0,0.0,0.0));
#51=VERTEX_POINT('pv0',#50);
#52=CARTESIAN_POINT('',(5.0,0.0,0.0));
#53=VERTEX_POINT('pv1',#52);
#54=CARTESIAN_POINT('',(5.0,5.0,0.001));
#55=VERTEX_POINT('pv2',#54);
#56=CARTESIAN_POINT('',(0.0,5.0,0.001));
#57=VERTEX_POINT('pv3',#56);
#60=DIRECTION('',(1.0,0.0,0.0));
#61=VECTOR('',#60,1.0);
#62=LINE('',#50,#61);
#63=EDGE_CURVE('pe0',#51,#53,#62,.T.);
#64=DIRECTION('',(0.0,1.0,0.0));
#65=VECTOR('',#64,1.0);
#66=LINE('',#52,#65);
#67=EDGE_CURVE('pe1',#53,#55,#66,.T.);
#68=DIRECTION('',(-1.0,0.0,0.0));
#69=VECTOR('',#68,1.0);
#70=LINE('',#54,#69);
#71=EDGE_CURVE('pe2',#55,#57,#70,.T.);
#72=DIRECTION('',(0.0,-1.0,0.0));
#73=VECTOR('',#72,1.0);
#74=LINE('',#56,#73);
#75=EDGE_CURVE('pe3',#57,#51,#74,.T.);
#76=ORIENTED_EDGE('poe0',*,*,#63,.T.);
#77=ORIENTED_EDGE('poe1',*,*,#67,.T.);
#78=ORIENTED_EDGE('poe2',*,*,#71,.T.);
#79=ORIENTED_EDGE('poe3',*,*,#75,.T.);
#80=EDGE_LOOP('pin_outer',(#76,#77,#78,#79));
#81=FACE_OUTER_BOUND('',#80,.T.);
#90=ADVANCED_FACE('pin_face_v_axis',(#81),#40,.T.);
/* Minimal PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa082','Tfa082','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9100));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
#9100=CLOSED_SHELL('shell_for_product',(#90));
ENDSEC;
END-ISO-10303-21;
