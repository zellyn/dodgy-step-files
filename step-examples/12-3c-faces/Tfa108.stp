ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Tfa108 Natural boundary on RECTANGULAR_TRIMMED surface'),'2;1');
FILE_NAME('Tfa108.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2009,#1);
/* === Base torus surface with full parameter bounds === */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
#14=TOROIDAL_SURFACE('base_torus',#13,5.0,2.0);
/* === RectangularTrimmedSurface with restricted param bounds === */
/* Base surface: torus [u:0..2π, v:0..2π]
   Trimmed bounds: [u:0.5..3.5, v:0.5..3.5] (restricted quarter-section)  */
#20=RECTANGULAR_TRIMMED_SURFACE('trimmed_torus',#14,0.5,3.5,0.5,3.5,.T.,.T.);
/* === Boundary loop on trimmed surface === */
#30=CARTESIAN_POINT('pt1',(6.5,0.0,0.0));
#31=VERTEX_POINT('v1',#30);
#32=CARTESIAN_POINT('pt2',(7.5,0.0,0.0));
#33=VERTEX_POINT('v2',#32);
#34=CARTESIAN_POINT('pt3',(7.5,2.0,0.0));
#35=VERTEX_POINT('v3',#34);
#36=CARTESIAN_POINT('pt4',(6.5,2.0,0.0));
#37=VERTEX_POINT('v4',#36);
/* === Edges with 2D curves in trimmed surface parameter space === */
#40=DIRECTION('d0',(1.0,0.0,0.0));
#41=VECTOR('v0',#40,1.0);
#42=LINE('curve0',#30,#41);
#43=PCURVE('pc0',#20,#42);
#44=EDGE_CURVE('trim_e1',#31,#33,#43,.T.);
#45=DIRECTION('d1',(0.0,1.0,0.0));
#46=VECTOR('v1',#45,1.0);
#47=LINE('curve1',#32,#46);
#48=PCURVE('pc1',#20,#47);
#49=EDGE_CURVE('trim_e2',#33,#35,#48,.T.);
#50=DIRECTION('d2',(-1.0,0.0,0.0));
#51=VECTOR('v2',#50,1.0);
#52=LINE('curve2',#34,#51);
#53=PCURVE('pc2',#20,#52);
#54=EDGE_CURVE('trim_e3',#35,#37,#53,.T.);
#55=DIRECTION('d3',(0.0,-1.0,0.0));
#56=VECTOR('v3',#55,1.0);
#57=LINE('curve3',#36,#56);
#58=PCURVE('pc3',#20,#57);
#59=EDGE_CURVE('trim_e4',#37,#31,#58,.T.);
#60=ORIENTED_EDGE('oe1',*,*,#44,.T.);
#61=ORIENTED_EDGE('oe2',*,*,#49,.T.);
#62=ORIENTED_EDGE('oe3',*,*,#54,.T.);
#63=ORIENTED_EDGE('oe4',*,*,#59,.T.);
#64=EDGE_LOOP('boundary',(#60,#61,#62,#63));
#65=FACE_OUTER_BOUND('outer',#64,.T.);
#66=ADVANCED_FACE('trimmed_torus_face',(#65),#20,.T.);
/* === Mandatory product chain === */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa108','Tfa108','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=OPEN_SHELL('shell',(#66));
#9022=SHELL_BASED_SURFACE_MODEL('sbsm',(#9021));
#9023=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9022),#9010);
#9024=SHAPE_DEFINITION_REPRESENTATION(#9005,#9023);
ENDSEC;
END-ISO-10303-21;
