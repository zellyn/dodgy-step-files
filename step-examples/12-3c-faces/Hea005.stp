ISO-10303-21;
/* Hea005 - Notches detected on a free-bound contour
 * Open shell of one face whose perimeter has a notched-wire defect from
 * Twi054: bottom edge replaced by 3-edge bump-out detour pulling vertex
 * (5,-0.05) inward forming a sharp triangular notch. Loop becomes 6 edges. */
HEADER;
FILE_DESCRIPTION(('Hea005 test case','Open shell whose face has a triangular notch detour on the bottom edge'),'2;1');
FILE_NAME('Hea005.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
/* 7 vertices: V1, V2a (notch start), V_notch (apex inward), V2b (notch end), V2 (corner), V3, V4 */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));#21=VERTEX_POINT('V1',#20);
#22=CARTESIAN_POINT('',(4.5,0.0,0.0));#23=VERTEX_POINT('V_notch_a',#22);
#24=CARTESIAN_POINT('notch_apex_inward',(5.0,0.05,0.0));#25=VERTEX_POINT('V_notch_apex',#24);
#26=CARTESIAN_POINT('',(5.5,0.0,0.0));#27=VERTEX_POINT('V_notch_b',#26);
#28=CARTESIAN_POINT('',(10.0,0.0,0.0));#29=VERTEX_POINT('V2',#28);
#30=CARTESIAN_POINT('',(10.0,10.0,0.0));#31=VERTEX_POINT('V3',#30);
#32=CARTESIAN_POINT('',(0.0,10.0,0.0));#33=VERTEX_POINT('V4',#32);
/* Bottom-1 V1 -> V_notch_a (4.5 long along +X) */
#40=DIRECTION('',(1.0,0.0,0.0));#41=VECTOR('',#40,1.0);#42=LINE('',#20,#41);#43=EDGE_CURVE('b1',#21,#23,#42,.T.);
/* notch up V_notch_a -> V_notch_apex */
#44=DIRECTION('',(0.9950371902099893,0.09950371902099893,0.0));#45=VECTOR('',#44,0.50249);#46=LINE('',#22,#45);#47=EDGE_CURVE('notch_up',#23,#25,#46,.T.);
/* notch down V_notch_apex -> V_notch_b */
#48=DIRECTION('',(0.9950371902099893,-0.09950371902099893,0.0));#49=VECTOR('',#48,0.50249);#50=LINE('',#24,#49);#51=EDGE_CURVE('notch_down',#25,#27,#50,.T.);
/* Bottom-2 V_notch_b -> V2 */
#52=DIRECTION('',(1.0,0.0,0.0));#53=VECTOR('',#52,1.0);#54=LINE('',#26,#53);#55=EDGE_CURVE('b2',#27,#29,#54,.T.);
/* Right V2 -> V3 */
#56=DIRECTION('',(0.0,1.0,0.0));#57=VECTOR('',#56,1.0);#58=LINE('',#28,#57);#59=EDGE_CURVE('right',#29,#31,#58,.T.);
/* Top V3 -> V4 */
#60=DIRECTION('',(-1.0,0.0,0.0));#61=VECTOR('',#60,1.0);#62=LINE('',#30,#61);#63=EDGE_CURVE('top',#31,#33,#62,.T.);
/* Left V4 -> V1 */
#64=DIRECTION('',(0.0,-1.0,0.0));#65=VECTOR('',#64,1.0);#66=LINE('',#32,#65);#67=EDGE_CURVE('left',#33,#21,#66,.T.);
#70=ORIENTED_EDGE('',*,*,#43,.T.);
#71=ORIENTED_EDGE('',*,*,#47,.T.);
#72=ORIENTED_EDGE('',*,*,#51,.T.);
#73=ORIENTED_EDGE('',*,*,#55,.T.);
#74=ORIENTED_EDGE('',*,*,#59,.T.);
#75=ORIENTED_EDGE('',*,*,#63,.T.);
#76=ORIENTED_EDGE('',*,*,#67,.T.);
#77=EDGE_LOOP('outer_with_notch',(#70,#71,#72,#73,#74,#75,#76));
#78=FACE_OUTER_BOUND('',#77,.T.);
#79=ADVANCED_FACE('face_with_notch',(#78),#14,.T.);
#80=OPEN_SHELL('shell_with_notch_contour',(#79));
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Hea005','Hea005','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#80));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
