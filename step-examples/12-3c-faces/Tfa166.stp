ISO-10303-21;
/* Tfa166 - ShapeFix_Face.FixSmallAreaWire negative-area-from-orientation
 * Wire whose signed area is negative due to traversal direction; FixSmallAreaWire
 * uses absolute value but the orientation is incorrect for outer-bound.
 * Inner wire is traversed counter-clockwise (wrong direction for inner bound),
 * causing negative signed area. FixSmallAreaWire should correct orientation. */
HEADER;
FILE_DESCRIPTION(('Tfa166 test case','ShapeFix_Face.FixSmallAreaWire negative-area-from-orientation'),'2;1');
FILE_NAME('Tfa166.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Outer square face: 10x10 */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('face_plane',#13);
/* Outer wire vertices */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));#21=VERTEX_POINT('',#20);
#22=CARTESIAN_POINT('',(10.0,0.0,0.0));#23=VERTEX_POINT('',#22);
#24=CARTESIAN_POINT('',(10.0,10.0,0.0));#25=VERTEX_POINT('',#24);
#26=CARTESIAN_POINT('',(0.0,10.0,0.0));#27=VERTEX_POINT('',#26);
/* Outer wire edges */
#30=DIRECTION('',(1.0,0.0,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#20,#31);
#33=EDGE_CURVE('outer_e1',#21,#23,#32,.T.);
#34=DIRECTION('',(0.0,1.0,0.0));#35=VECTOR('',#34,1.0);#36=LINE('',#22,#35);
#37=EDGE_CURVE('outer_e2',#23,#25,#36,.T.);
#38=DIRECTION('',(-1.0,0.0,0.0));#39=VECTOR('',#38,1.0);#40=LINE('',#24,#39);
#41=EDGE_CURVE('outer_e3',#25,#27,#40,.T.);
#42=DIRECTION('',(0.0,-1.0,0.0));#43=VECTOR('',#42,1.0);#44=LINE('',#26,#43);
#45=EDGE_CURVE('outer_e4',#27,#21,#44,.T.);
#46=ORIENTED_EDGE('',*,*,#33,.T.);#47=ORIENTED_EDGE('',*,*,#37,.T.);
#48=ORIENTED_EDGE('',*,*,#41,.T.);#49=ORIENTED_EDGE('',*,*,#45,.T.);
#50=EDGE_LOOP('outer_loop',(#46,#47,#48,#49));
#51=FACE_OUTER_BOUND('',#50,.T.);
/* DEFECT: Inner wire traversed counter-clockwise (wrong direction for hole)
 * This creates negative signed area. Small inner square at (2,2) to (3,3) */
#60=CARTESIAN_POINT('',(3.0,3.0,0.0));#61=VERTEX_POINT('',#60);
#62=CARTESIAN_POINT('',(3.0,2.0,0.0));#63=VERTEX_POINT('',#62);
#63a=CARTESIAN_POINT('',(2.0,2.0,0.0));#64=VERTEX_POINT('',#63a);
#65=CARTESIAN_POINT('',(2.0,3.0,0.0));#66=VERTEX_POINT('',#65);
/* Inner wire edges - counter-clockwise (wrong for hole) */
#70=DIRECTION('',(0.0,-1.0,0.0));#71=VECTOR('',#70,1.0);#72=LINE('',#60,#70);
#73=EDGE_CURVE('inner_e1',#61,#63,#72,.T.);
#74=DIRECTION('',(-1.0,0.0,0.0));#75=VECTOR('',#74,1.0);#76=LINE('',#63a,#74);
#77=EDGE_CURVE('inner_e2',#63,#64,#76,.T.);
#78=DIRECTION('',(0.0,1.0,0.0));#79=VECTOR('',#78,1.0);#80=LINE('',#64,#78);
#81=EDGE_CURVE('inner_e3',#64,#66,#80,.T.);
#82=DIRECTION('',(1.0,0.0,0.0));#83=VECTOR('',#82,1.0);#84=LINE('',#65,#82);
#85=EDGE_CURVE('inner_e4',#66,#61,#84,.T.);
#86=ORIENTED_EDGE('',*,*,#73,.T.);#87=ORIENTED_EDGE('',*,*,#77,.T.);
#88=ORIENTED_EDGE('',*,*,#81,.T.);#89=ORIENTED_EDGE('',*,*,#85,.T.);
#90=EDGE_LOOP('inner_ccw_wrong',(#86,#87,#88,#89));
#91=FACE_INNER_BOUND('inner_negative_area',#90,.T.);
#100=ADVANCED_FACE('face_with_wrong_orientation',(#51,#91),#14,.T.);
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa166','Tfa166','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#100));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
