ISO-10303-21;
/* Tfa031 - Locations attached to sub-shapes - instance flattening
 * Defect: after STEP round-trip, individual faces acquire near-identity
 * TopLoc_Location transforms even though the source carried no
 * per-face transforms. The reader interprets a top-level Compound as
 * an assembly and propagates locations down to leaves. Locations are
 * computationally meaningless but break IsEqual / hash dedup. Healer
 * should collapse identity locations on leaf faces during reader (or
 * a healer pass); RemoveLocations flattens orphan locations.
 * Reproducer: a TopoDS_Compound containing a single shell, written and
 * re-read so each face carries a near-identity AXIS2_PLACEMENT_3D
 * (epsilon translation 1e-15, identity rotation).
 */
HEADER;
FILE_DESCRIPTION(('Tfa031 sub-shape locations near-identity'),'2;1');
FILE_NAME('Tfa031.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Defect site: per-face placement carries near-identity translation
 * 1e-15 - meaningless numerically but breaks IsEqual.                  */
#10=CARTESIAN_POINT('eps_origin',(1.0E-15,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('near_identity',#10,#11,#12);
#20=PLANE('plane',#13);
#21=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#22=CARTESIAN_POINT('p1',(10.0,0.0,0.0));
#23=CARTESIAN_POINT('p2',(10.0,10.0,0.0));
#24=CARTESIAN_POINT('p3',(0.0,10.0,0.0));
#30=VERTEX_POINT('',#21);
#31=VERTEX_POINT('',#22);
#32=VERTEX_POINT('',#23);
#33=VERTEX_POINT('',#24);
#40=DIRECTION('',(1.0,0.0,0.0));
#41=DIRECTION('',(0.0,1.0,0.0));
#42=DIRECTION('',(-1.0,0.0,0.0));
#43=DIRECTION('',(0.0,-1.0,0.0));
#50=VECTOR('',#40,10.0);
#51=VECTOR('',#41,10.0);
#52=VECTOR('',#42,10.0);
#53=VECTOR('',#43,10.0);
#60=LINE('',#21,#50);
#61=LINE('',#22,#51);
#62=LINE('',#23,#52);
#63=LINE('',#24,#53);
#70=EDGE_CURVE('',#30,#31,#60,.T.);
#71=EDGE_CURVE('',#31,#32,#61,.T.);
#72=EDGE_CURVE('',#32,#33,#62,.T.);
#73=EDGE_CURVE('',#33,#30,#63,.T.);
#80=ORIENTED_EDGE('',*,*,#70,.T.);
#81=ORIENTED_EDGE('',*,*,#71,.T.);
#82=ORIENTED_EDGE('',*,*,#72,.T.);
#83=ORIENTED_EDGE('',*,*,#73,.T.);
#90=EDGE_LOOP('',(#80,#81,#82,#83));
#100=FACE_OUTER_BOUND('',#90,.T.);
#110=ADVANCED_FACE('orphan_loc_face',(#100),#20,.T.);
#120=OPEN_SHELL('shell',(#110));
#130=SHELL_BASED_SURFACE_MODEL('orphan_loc_compound',(#120));
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa031','Tfa031','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#120));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
