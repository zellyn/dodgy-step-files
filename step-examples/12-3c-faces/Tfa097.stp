ISO-10303-21;
/* Tfa097 - ShapeAnalysis_CheckSmallFace.CheckPinFace blunt-pin classification
 * Face with a pin (singular region tapering to point) at ~10° angle, not sharp.
 * CheckPinFace's angle threshold (typically M_PI/6 ≈ 30°) flags blunt pins as sharp.
 * Constructs face on plane with narrow wedge (10° internal angle). */
HEADER;
FILE_DESCRIPTION(('Tfa097 test case','Face with blunt pin ~10 degrees'),'2;1');
FILE_NAME('Tfa097.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Plane at origin */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);#14=PLANE('surf',#13);
/* Wedge-shaped outer wire: wide base, narrow point (10° internal angle) */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));#21=VERTEX_POINT('',#20);
#22=CARTESIAN_POINT('',(10.0,0.0,0.0));#23=VERTEX_POINT('',#22);
#24=CARTESIAN_POINT('',(5.0,1.0,0.0));#25=VERTEX_POINT('',#24);
/* Edge base (0,0) to (10,0) */
#30=DIRECTION('',(1.0,0.0,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#20,#31);
#33=EDGE_CURVE('base',#21,#23,#32,.T.);
/* Edge left: (10,0) to apex (5,1) -- angle ~80° from horizontal */
#34=DIRECTION('',(-0.4472,0.8944,0.0));#35=VECTOR('',#34,1.0);#36=LINE('',#22,#35);
#37=EDGE_CURVE('left_edge',#23,#25,#36,.T.);
/* Edge right: apex (5,1) to (0,0) -- angle ~80° from horizontal (opposite) */
#38=DIRECTION('',(-0.4472,-0.8944,0.0));#39=VECTOR('',#38,1.0);#40=LINE('',#24,#39);
#41=EDGE_CURVE('right_edge',#25,#21,#40,.T.);
/* Close outer loop */
#50=ORIENTED_EDGE('',*,*,#33,.T.);#51=ORIENTED_EDGE('',*,*,#37,.T.);
#52=ORIENTED_EDGE('',*,*,#41,.T.);
#53=EDGE_LOOP('outer_wedge',(#50,#51,#52));
#54=FACE_OUTER_BOUND('',#53,.T.);
/* Face on plane */
#60=ADVANCED_FACE('blunt_pin_face',(#54),#14,.T.);
/* PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa097','Tfa097','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#70));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
/* Closed shell wrapper */
#70=CLOSED_SHELL('shell',(#60));
ENDSEC;
END-ISO-10303-21;
