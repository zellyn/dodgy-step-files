ISO-10303-21;
/* Tfa074 — ShapeFix_Face.FixWiresTwoCoincEdges orientation detection
   Defect: face with two identical edges at FORWARD orientation that should
   be merged, but orientation detection fails to recognize coincident pattern. */
HEADER;
FILE_DESCRIPTION(('Tfa074 - coincident-edge orientation detection'),'2;1');
FILE_NAME('Tfa074.stp','2026-06-15T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#2=DIRECTION('zdir',(0.0,0.0,1.0));
#3=DIRECTION('xdir',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('placement',#1,#2,#3);
#5=PLANE('plane',#4);
/* Shared endpoint for two coincident edges */
#10=CARTESIAN_POINT('v1',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('v2',(1.0,0.0,0.0));
#12=VERTEX_POINT('vp1',#10);
#13=VERTEX_POINT('vp2',#11);
/* Single line segment used twice in same wire */
#20=LINE('line',#10,#27);
#21=DIRECTION('',(1.0,0.0,0.0));
#27=VECTOR('',#21,1.0);
/* Edge curve: shared geometry */
#30=EDGE_CURVE('coincident_edge',#12,#13,#20,.T.);
/* Wire with two identical edges [E, E] at FORWARD orientation */
#33=ORIENTED_EDGE('oe1',*,*,#30,.T.);
#34=ORIENTED_EDGE('oe2',*,*,#30,.T.);
#40=EDGE_LOOP('two_coin_loop',(#33,#34));
#41=FACE_OUTER_BOUND('bound',#40,.T.);
/* Face: two-wire structure with coincident edges */
#50=ADVANCED_FACE('coin_face',(#41),#5,.T.);
#60=CLOSED_SHELL('shell',(#50));
#70=MANIFOLD_SOLID_BREP('solid',#60);
ENDSEC;
END-ISO-10303-21;
