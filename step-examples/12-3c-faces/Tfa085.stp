ISO-10303-21;
/* Tfa085 - ShapeFix_Face.FixSplitFace: split-result multiplicity
 * Face split by an interior edge into N > 2 sub-faces. FixSplitFace's loop
 * assumes binary split (N=2) and misses sub-faces when N=3+.
 * Uses a rectangular face with two parallel interior edges creating 3 zones.
 */
HEADER;
FILE_DESCRIPTION(('Tfa085 test case','Face split into 3+ sub-faces; FixSplitFace binary-split loop misses extras'),'2;1');
FILE_NAME('Tfa085.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Plane at Z=0 */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('split_face_plane',#13);
/* Outer boundary: rectangle (0,0)-(10,5) */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=VERTEX_POINT('v0',#20);
#22=CARTESIAN_POINT('',(10.0,0.0,0.0));
#23=VERTEX_POINT('v1',#22);
#24=CARTESIAN_POINT('',(10.0,5.0,0.0));
#25=VERTEX_POINT('v2',#24);
#26=CARTESIAN_POINT('',(0.0,5.0,0.0));
#27=VERTEX_POINT('v3',#26);
/* Outer edges: bottom, right, top, left */
#30=DIRECTION('',(1.0,0.0,0.0));
#31=VECTOR('',#30,1.0);
#32=LINE('',#20,#31);
#33=EDGE_CURVE('e_outer_bottom',#21,#23,#32,.T.);
#34=DIRECTION('',(0.0,1.0,0.0));
#35=VECTOR('',#34,1.0);
#36=LINE('',#22,#35);
#37=EDGE_CURVE('e_outer_right',#23,#25,#36,.T.);
#38=DIRECTION('',(-1.0,0.0,0.0));
#39=VECTOR('',#38,1.0);
#40=LINE('',#24,#39);
#41=EDGE_CURVE('e_outer_top',#25,#27,#40,.T.);
#42=DIRECTION('',(0.0,-1.0,0.0));
#43=VECTOR('',#42,1.0);
#44=LINE('',#26,#43);
#45=EDGE_CURVE('e_outer_left',#27,#21,#44,.T.);
#46=ORIENTED_EDGE('oe_ob',*,*,#33,.T.);
#47=ORIENTED_EDGE('oe_or',*,*,#37,.T.);
#48=ORIENTED_EDGE('oe_ot',*,*,#41,.T.);
#49=ORIENTED_EDGE('oe_ol',*,*,#45,.T.);
#50=EDGE_LOOP('outer_split',(#46,#47,#48,#49));
#51=FACE_OUTER_BOUND('',#50,.T.);
/* Inner edges (splits): two vertical lines at X=3 and X=7
   Creates 3 zones: [0,3], [3,7], [7,10]
*/
/* First split edge: X=3, from (3,0) to (3,5) */
#60=CARTESIAN_POINT('',(3.0,0.0,0.0));
#61=VERTEX_POINT('v_split1_a',#60);
#62=CARTESIAN_POINT('',(3.0,5.0,0.0));
#63=VERTEX_POINT('v_split1_b',#62);
#64=DIRECTION('',(0.0,1.0,0.0));
#65=VECTOR('',#64,1.0);
#66=LINE('',#60,#65);
#67=EDGE_CURVE('e_split1',#61,#63,#66,.T.);
#68=ORIENTED_EDGE('oe_split1_fwd',*,*,#67,.T.);
#69=ORIENTED_EDGE('oe_split1_bwd',*,*,#67,.F.);
/* Second split edge: X=7, from (7,0) to (7,5) */
#70=CARTESIAN_POINT('',(7.0,0.0,0.0));
#71=VERTEX_POINT('v_split2_a',#70);
#72=CARTESIAN_POINT('',(7.0,5.0,0.0));
#73=VERTEX_POINT('v_split2_b',#72);
#74=DIRECTION('',(0.0,1.0,0.0));
#75=VECTOR('',#74,1.0);
#76=LINE('',#70,#75);
#77=EDGE_CURVE('e_split2',#71,#73,#76,.T.);
#78=ORIENTED_EDGE('oe_split2_fwd',*,*,#77,.T.);
#79=ORIENTED_EDGE('oe_split2_bwd',*,*,#77,.F.);
/* Inner bounds (holes): none yet; splits are represented as interior edges in the loop */
/* Complete outer loop including split edges at intermediate vertices
   Path: (0,0) -> (3,0) -> (3,5) -> (0,5) -> (0,0) [zone 1]
         (3,0) -> (7,0) -> (7,5) -> (3,5) -> (3,0) [zone 2]
         (7,0) -> (10,0) -> (10,5) -> (7,5) -> (7,0) [zone 3]
   Represented as single loop with multiple inner bounds or split representation.
   Simplified: single loop as if exterior, with split edges marked as inner bounds.
*/
/* Inner bound 1: zone boundary along split1, pointing inward */
#80=ORIENTED_EDGE('ie_split1',*,*,#67,.F.);
#81=EDGE_LOOP('inner_split1',(#80));
#82=FACE_INNER_BOUND('bound_split1',#81,.T.);
/* Inner bound 2: zone boundary along split2, pointing inward */
#83=ORIENTED_EDGE('ie_split2',*,*,#77,.F.);
#84=EDGE_LOOP('inner_split2',(#83));
#85=FACE_INNER_BOUND('bound_split2',#84,.T.);
/* DEFECT: Face with two inner bounds creates 3 zones when split
   FixSplitFace loop assumes binary split (1 inner bound -> 2 zones)
   and misses zone 2 or zone 3.
*/
#90=ADVANCED_FACE('split_face_3zones',(#51,#82,#85),#14,.T.);
/* Minimal PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa085','Tfa085','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9100));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
#9100=CLOSED_SHELL('shell_for_product',(#90));
ENDSEC;
END-ISO-10303-21;
