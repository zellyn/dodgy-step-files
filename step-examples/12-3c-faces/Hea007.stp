ISO-10303-21;
/* Hea007 - Transferring parameter values between 3D curve and pcurve
 * Single edge from (0,0,0)->(10,0,0) on a PLANE. 3D curve is a quadratic
 * B_SPLINE_CURVE with non-uniform parameterization (knot multiplicity
 * makes arc-length advance non-linearly with parameter). Pcurve is a
 * straight LINE with uniform U distance 0..10. Arc-length-vs-pcurve-U
 * follow different monotone functions. */
HEADER;
FILE_DESCRIPTION(('Hea007 test case','Edge with non-uniform 3D B-spline + uniform pcurve LINE -- non-affine reparam'),'2;1');
FILE_NAME('Hea007.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('host',#13);
/* 3D B-spline (degree 2, 4 control points, non-uniform knots biased toward x=0) */
#20=CARTESIAN_POINT('cp0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('cp1',(1.0,0.0,0.0));
#22=CARTESIAN_POINT('cp2',(7.0,0.0,0.0));
#23=CARTESIAN_POINT('cp3',(10.0,0.0,0.0));
#24=B_SPLINE_CURVE_WITH_KNOTS('non_uniform_3d',2,(#20,#21,#22,#23),.UNSPECIFIED.,.F.,.F.,(3,1,3),(0.0,0.2,1.0),.UNSPECIFIED.);
#25=CARTESIAN_POINT('start_pt',(0.0,0.0,0.0));#26=VERTEX_POINT('Vstart',#25);
#27=CARTESIAN_POINT('end_pt',(10.0,0.0,0.0));#28=VERTEX_POINT('Vend',#27);
/* pcurve: uniform LINE U=0..10 */
#30=CARTESIAN_POINT('uv_start',(0.0,0.0));
#31=DIRECTION('',(1.0,0.0));
#32=VECTOR('',#31,10.0);
#33=LINE('uniform_pcurve',#30,#32);
#34=DEFINITIONAL_REPRESENTATION('',(#33),#13);
#35=PCURVE('uniform_pcurve_in_repr',#14,#34);
#36=SURFACE_CURVE('non_affine_reparam',#24,(#35),.PCURVE_S1.);
#40=EDGE_CURVE('non_uniform_3d_uniform_pcurve',#26,#28,#36,.T.);
#41=ORIENTED_EDGE('',*,*,#40,.T.);
#42=EDGE_LOOP('single_non_affine_edge',(#41));
ENDSEC;
END-ISO-10303-21;
