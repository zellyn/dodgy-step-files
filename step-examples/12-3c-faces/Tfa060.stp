ISO-10303-21;
/* Tfa060 - Shell parametric coverage exceeds host surface bounds
 * Face on a RECTANGULAR_TRIMMED_SURFACE with u1=0, u2=1, v1=0, v2=1.
 * The bounding wire has a pcurve whose U-parameter range overshoots to
 * U=1.5 -- 0.5 unit beyond the trimmed surface domain. */
HEADER;
FILE_DESCRIPTION(('Tfa060 test case','Face on RECTANGULAR_TRIMMED_SURFACE u in[0,1] with pcurve to U=1.5'),'2;1');
FILE_NAME('Tfa060.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('base_plane',#13);
/* Trimmed to u in [0,1], v in [0,1] */
#15=RECTANGULAR_TRIMMED_SURFACE('trimmed_unit',#14,0.0,0.0,1.0,1.0,.T.,.T.);
/* 4 vertex corners; right edge runs out to U=1.5, V=0..1. */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));#21=VERTEX_POINT('V1',#20);
#22=CARTESIAN_POINT('',(1.5,0.0,0.0));#23=VERTEX_POINT('V2_at_U1p5',#22);
#24=CARTESIAN_POINT('',(1.5,1.0,0.0));#25=VERTEX_POINT('V3_at_U1p5',#24);
#26=CARTESIAN_POINT('',(0.0,1.0,0.0));#27=VERTEX_POINT('V4',#26);
/* edge1: V1->V2 -- pcurve runs U=0 to U=1.5, OVERSHOOTING the surface trim. */
#30=DIRECTION('',(1.0,0.0,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#20,#31);
#33=CARTESIAN_POINT('uv_start',(0.0,0.0));
#34=DIRECTION('',(1.0,0.0));#35=VECTOR('',#34,1.5);
#36=LINE('pcurve_overshoots_to_U1p5',#33,#35);
#37=DEFINITIONAL_REPRESENTATION('',(#36),#13);
#38=PCURVE('pcurve_U_0_to_1p5',#15,#37);
#39=SURFACE_CURVE('overshoot',#32,(#38),.PCURVE_S1.);
#40=EDGE_CURVE('e1_overshoot_pcurve',#21,#23,#39,.T.);
#41=DIRECTION('',(0.0,1.0,0.0));#42=VECTOR('',#41,1.0);#43=LINE('',#22,#42);
#44=EDGE_CURVE('e2',#23,#25,#43,.T.);
#45=DIRECTION('',(-1.0,0.0,0.0));#46=VECTOR('',#45,1.5);#47=LINE('',#24,#46);
#48=EDGE_CURVE('e3',#25,#27,#47,.T.);
#49=DIRECTION('',(0.0,-1.0,0.0));#50=VECTOR('',#49,1.0);#51=LINE('',#26,#50);
#52=EDGE_CURVE('e4',#27,#21,#51,.T.);
#60=ORIENTED_EDGE('',*,*,#40,.T.);
#61=ORIENTED_EDGE('',*,*,#44,.T.);
#62=ORIENTED_EDGE('',*,*,#48,.T.);
#63=ORIENTED_EDGE('',*,*,#52,.T.);
#64=EDGE_LOOP('outer_overshoots_trim',(#60,#61,#62,#63));
#65=FACE_OUTER_BOUND('',#64,.T.);
#100=ADVANCED_FACE('wire_overflows_trim',(#65),#15,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa060','Tfa060','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#100));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
