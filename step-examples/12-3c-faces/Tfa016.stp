/* Tfa016 - Faces share same supporting surface - UnifySameDomain
 * Defect: multiple coplanar faces from a Boolean union remain separate,
 * joined by an artificial internal edge. Feature recognition and CAM/FEA
 * pipelines see redundant topology. Healer should run
 * ShapeUpgrade_UnifySameDomain to merge adjacent faces sharing one
 * underlying surface and colinear edges. After USD bopcheck must be
 * clean. Detect periodic direction and do NOT merge across cylinder/
 * torus seam.
 * Reproducer: two coplanar ADVANCED_FACE entries sharing one PLANE.
 * Both reference the same internal edge between them.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Tfa016 same domain faces unifiable'),'2;1');
FILE_NAME('Tfa016.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
/* One shared PLANE across both faces (same supporting surface).        */
#20=PLANE('shared_plane',#13);
/* Six vertices: two squares sharing the middle edge from (10,0) to
 * (10,10).                                                             */
#21=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#22=CARTESIAN_POINT('p1',(10.0,0.0,0.0));
#23=CARTESIAN_POINT('p2',(10.0,10.0,0.0));
#24=CARTESIAN_POINT('p3',(0.0,10.0,0.0));
#25=CARTESIAN_POINT('p4',(20.0,0.0,0.0));
#26=CARTESIAN_POINT('p5',(20.0,10.0,0.0));
#30=VERTEX_POINT('',#21);
#31=VERTEX_POINT('',#22);
#32=VERTEX_POINT('',#23);
#33=VERTEX_POINT('',#24);
#34=VERTEX_POINT('',#25);
#35=VERTEX_POINT('',#26);
#40=DIRECTION('',(1.0,0.0,0.0));
#41=DIRECTION('',(0.0,1.0,0.0));
#42=DIRECTION('',(-1.0,0.0,0.0));
#43=DIRECTION('',(0.0,-1.0,0.0));
#50=VECTOR('',#40,10.0);
#51=VECTOR('',#41,10.0);
#52=VECTOR('',#42,10.0);
#53=VECTOR('',#43,10.0);
#60=LINE('',#21,#50);
#61=LINE('',#22,#51);
#62=LINE('',#23,#52);
#63=LINE('',#24,#53);
#64=LINE('',#22,#50);
#65=LINE('',#25,#51);
#66=LINE('',#26,#52);
#70=EDGE_CURVE('a_bottom',#30,#31,#60,.T.);
#71=EDGE_CURVE('shared_mid',#31,#32,#61,.T.);
#72=EDGE_CURVE('a_top',#32,#33,#62,.T.);
#73=EDGE_CURVE('a_left',#33,#30,#63,.T.);
#74=EDGE_CURVE('b_bottom',#31,#34,#64,.T.);
#75=EDGE_CURVE('b_right',#34,#35,#65,.T.);
#76=EDGE_CURVE('b_top',#35,#32,#66,.T.);
/* Both faces share edge #71 (artificial internal edge after USD).      */
#80=ORIENTED_EDGE('',*,*,#70,.T.);
#81=ORIENTED_EDGE('',*,*,#71,.T.);
#82=ORIENTED_EDGE('',*,*,#72,.T.);
#83=ORIENTED_EDGE('',*,*,#73,.T.);
#84=ORIENTED_EDGE('',*,*,#74,.T.);
#85=ORIENTED_EDGE('',*,*,#75,.T.);
#86=ORIENTED_EDGE('',*,*,#76,.T.);
#87=ORIENTED_EDGE('',*,*,#71,.F.);
#90=EDGE_LOOP('A',(#80,#81,#82,#83));
#91=EDGE_LOOP('B',(#84,#85,#86,#87));
#100=FACE_OUTER_BOUND('outer_A',#90,.T.);
#101=FACE_OUTER_BOUND('outer_B',#91,.T.);
/* Defect site: two adjacent coplanar faces sharing supporting surface
 * #20 and joined by internal shared edge #71.                          */
#110=ADVANCED_FACE('coplanar_A',(#100),#20,.T.);
#111=ADVANCED_FACE('coplanar_B',(#101),#20,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa016','Tfa016','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#110,#111));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
