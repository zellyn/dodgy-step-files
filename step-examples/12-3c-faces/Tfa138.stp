ISO-10303-21;
/* Tfa138 - ShapeFix_Face.FixAddNaturalBound surface-not-closed-but-flagged
 * A cylindrical surface with u_closed=true but actually NOT closed (seam gap exists).
 * FixAddNaturalBound incorrectly constructs a natural boundary at the assumed closure point.
 */
HEADER;
FILE_DESCRIPTION(('Tfa138 test case','ShapeFix_Face.FixAddNaturalBound surface-not-closed-but-flagged'),'2;1');
FILE_NAME('Tfa138.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* === Cylindrical surface (almost closed, but with seam gap) === */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Cylinder axis at origin, radius 5, height 10 */
#20=DIRECTION('',(0.0,0.0,1.0));
#21=AXIS2_PLACEMENT_3D('',#10,#20,#12);
/* Surface_of_revolution approximation via SURFACE_OF_REVOLUTION */
#22=DIRECTION('',(1.0,0.0,0.0));#23=VECTOR('',#22,5.0);#24=LINE('',#10,#23);
#25=SURFACE_OF_REVOLUTION('cylinder_srf',#24,#21);
/* Face bounds: outer loop (small circle at base) */
#30=CARTESIAN_POINT('',(5.0,0.0,0.0));#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(5.0,0.01,0.0));#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(4.99,0.02,0.0));#35=VERTEX_POINT('',#34);
#36=DIRECTION('',(1.0,0.0,0.0));#37=VECTOR('',#36,1.0);#38=LINE('',#30,#37);
#39=EDGE_CURVE('e1',#31,#33,#38,.T.);
#40=DIRECTION('',(-0.5,0.866,0.0));#41=VECTOR('',#40,1.0);#42=LINE('',#32,#41);
#43=EDGE_CURVE('e2',#33,#35,#42,.T.);
#44=DIRECTION('',(-0.5,-0.866,0.0));#45=VECTOR('',#44,1.0);#46=LINE('',#34,#45);
#47=EDGE_CURVE('e3',#35,#31,#46,.T.);
#48=ORIENTED_EDGE('',*,*,#39,.T.);#49=ORIENTED_EDGE('',*,*,#43,.T.);
#50=ORIENTED_EDGE('',*,*,#47,.T.);
#51=EDGE_LOOP('bound_loop',(#48,#49,#50));
#52=FACE_OUTER_BOUND('',#51,.T.);
/* Face flagged with u_closed=true but surface is NOT actually closed */
#90=ADVANCED_FACE('pseudo_closed_cylinder',(#52),#25,.T.);
/* === Wrap in PRODUCT chain === */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa138','Tfa138','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9050));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
#9050=CLOSED_SHELL('shell',(#90));
ENDSEC;
END-ISO-10303-21;
