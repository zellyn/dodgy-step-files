ISO-10303-21;
/* Tfa116 — ShapeFix_Face.FixLoopWire concentric circles
 * Defect: face with two concentric circles as inner wires; FixLoopWire's
 * wire-merge logic produces a single doubled-up wire instead of preserving
 * the annular topology. */
HEADER;
FILE_DESCRIPTION(('Tfa116 - FixLoopWire concentric circles defect'),'2;1');
FILE_NAME('Tfa116.stp','2026-06-16T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Outer circle — radius 5, center at origin */
#10=CARTESIAN_POINT('outer_center',(0.0,0.0,0.0));
#11=DIRECTION('z_axis',(0.0,0.0,1.0));
#12=DIRECTION('x_axis',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('outer_place',#10,#11,#12);
#14=CIRCLE('outer_circle',#13,5.0);
#15=CARTESIAN_POINT('outer_p1',(5.0,0.0,0.0));
#16=VERTEX_POINT('outer_v1',#15);
#17=CARTESIAN_POINT('outer_p2',(-5.0,0.0,0.0));
#18=VERTEX_POINT('outer_v2',#17);
#19=EDGE_CURVE('outer_edge1',#16,#18,#14,.T.);
#20=EDGE_CURVE('outer_edge2',#18,#16,#14,.T.);
#21=ORIENTED_EDGE('outer_oe1',*,*,#19,.T.);
#22=ORIENTED_EDGE('outer_oe2',*,*,#20,.T.);
#23=EDGE_LOOP('outer_loop',(#21,#22));
#24=FACE_OUTER_BOUND('outer_bound',#23,.T.);
/* First inner circle — radius 2, center at origin (concentric) */
#30=CIRCLE('inner_circle1',#13,2.0);
#31=CARTESIAN_POINT('inner1_p1',(2.0,0.0,0.0));
#32=VERTEX_POINT('inner1_v1',#31);
#33=CARTESIAN_POINT('inner1_p2',(-2.0,0.0,0.0));
#34=VERTEX_POINT('inner1_v2',#33);
#35=EDGE_CURVE('inner1_edge1',#32,#34,#30,.T.);
#36=EDGE_CURVE('inner1_edge2',#34,#32,#30,.T.);
#37=ORIENTED_EDGE('inner1_oe1',*,*,#35,.T.);
#38=ORIENTED_EDGE('inner1_oe2',*,*,#36,.T.);
#39=EDGE_LOOP('inner_loop1',(#37,#38));
#40=FACE_INNER_BOUND('inner_bound1',#39,.T.);
/* Second inner circle — radius 1, center at origin (concentric) */
#45=CIRCLE('inner_circle2',#13,1.0);
#46=CARTESIAN_POINT('inner2_p1',(1.0,0.0,0.0));
#47=VERTEX_POINT('inner2_v1',#46);
#48=CARTESIAN_POINT('inner2_p2',(-1.0,0.0,0.0));
#49=VERTEX_POINT('inner2_v2',#48);
#50=EDGE_CURVE('inner2_edge1',#47,#49,#45,.T.);
#51=EDGE_CURVE('inner2_edge2',#49,#47,#45,.T.);
#52=ORIENTED_EDGE('inner2_oe1',*,*,#50,.T.);
#53=ORIENTED_EDGE('inner2_oe2',*,*,#51,.T.);
#54=EDGE_LOOP('inner_loop2',(#52,#53));
#55=FACE_INNER_BOUND('inner_bound2',#54,.T.);
/* PLANE surface in XY */
#60=AXIS2_PLACEMENT_3D('plane_place',#10,#11,#12);
#61=PLANE('xy_plane',#60);
/* Face with outer and two inner loops */
#70=ADVANCED_FACE('concentric_face',(#24,#40,#55),#61,.T.);
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa116','Tfa116','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('concentric_shell',(#70));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
