ISO-10303-21;
/* Hea012 - Shape-process operator: pluggable healing step contract
 * Defect: a single registered operator must accept a context, perform
 * its healing step, and record changes back to the context for
 * subsequent operators to observe. */
HEADER;
FILE_DESCRIPTION(('Hea012 test case','Shape-process operator: pluggable healing step contract'),'2;1');
FILE_NAME('Hea012.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
