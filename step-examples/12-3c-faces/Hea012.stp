#45=ADVANCED_FACE('',(#44),#14,.T.);
/* Defect bundle: inner wire whose orientation flag is .T. (outer)
 * but whose enclosed area is sub-tolerance; edges out of order. */
#200=CARTESIAN_POINT('',(5.0,5.0,0.0));
#201=VERTEX_POINT('',#200);
#202=CARTESIAN_POINT('',(5.001,5.0,0.0));
