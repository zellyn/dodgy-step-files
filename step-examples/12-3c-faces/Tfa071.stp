ISO-10303-21;
/* Tfa071 — ShapeFix_Face.FixPeriodicDegenerated apex-curve direction
   Defect: cone with apex below wire, where isUDecrease=false triggers
   conditional wire reversal. Apex curve direction and wire orientation
   set incorrectly when apex bounds positioning conflicts with wire wrapping. */
HEADER;
FILE_DESCRIPTION(('Tfa071 - cone apex-curve direction with conditional wire reversal'),'2;1');
FILE_NAME('Tfa071.stp','2026-06-15T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
