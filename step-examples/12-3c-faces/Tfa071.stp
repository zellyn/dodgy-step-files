DATA;
#1=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#2=DIRECTION('zdir',(0.0,0.0,1.0));
#3=DIRECTION('xdir',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('placement',#1,#2,#3);
/* Conical surface: semi-angle ~30 deg, apex at V=-1 (below wire bounds) */
#5=CONICAL_SURFACE('cone',#4,0.5,0.52359877);
/* Wire vertices on cone at V=1..3 (above apex) */
#10=CARTESIAN_POINT('v1',(0.5,0.0,1.0));
