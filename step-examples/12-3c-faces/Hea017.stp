/* Hea017 - Extrude of 2D Offset of Sketch fails STEP export as
 * non-manifold.
 * Defect (FreeCAD #23694): the offset trace self-intersected, producing
 * a B-spline EDGE_CURVE whose first and last control points are equal
 * but whose tangents are opposite -- a degenerate-loop edge. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Hea017 - degenerate-loop B-spline EDGE_CURVE'),'2;1');
FILE_NAME('Hea017.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('Hea017_offset','2d offset extrude','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
/* Defect: B-spline EDGE_CURVE whose first and last control points are
   the same but whose middle control points double back -- a
   degenerate-loop curve. */
#20=CARTESIAN_POINT('cp0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('cp1',(1.0,1.0,0.0));
#22=CARTESIAN_POINT('cp2',(1.0,-1.0,0.0));
#23=CARTESIAN_POINT('cp3',(0.0,0.0,0.0));
#24=B_SPLINE_CURVE_WITH_KNOTS('degenerate_loop',3,(#20,#21,#22,#23),
       .UNSPECIFIED.,.F.,.F.,(4,4),(0.0,1.0),.UNSPECIFIED.);
#25=VERTEX_POINT('',#20);
#26=EDGE_CURVE('',#25,#25,#24,.T.);
#27=ORIENTED_EDGE('',*,*,#26,.T.);
#28=EDGE_LOOP('degenerate_edge_loop',(#27));
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=DIRECTION('',(0.0,0.0,1.0));
#32=DIRECTION('',(1.0,0.0,0.0));
#33=AXIS2_PLACEMENT_3D('',#30,#31,#32);
#34=PLANE('',#33);
#35=FACE_OUTER_BOUND('',#28,.T.);
#36=ADVANCED_FACE('side_wall',(#35),#34,.T.);
#40=CLOSED_SHELL('',(#36));
#41=MANIFOLD_SOLID_BREP('Hea017_body',#40);
#50=SHAPE_REPRESENTATION('Hea017_repr',(#33,#41),#14);
#51=SHAPE_DEFINITION_REPRESENTATION(#8,#50);
ENDSEC;
END-ISO-10303-21;
