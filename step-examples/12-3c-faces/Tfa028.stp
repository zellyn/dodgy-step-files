/* Tfa028 - Surface revolution span exceeds angle cap (split_angle)
 * Defect: cones, cylinders, surfaces of revolution with angular range
 * exceeding configured threshold (e.g. 90, 180, 360 deg) must be
 * subdivided. Downstream meshers misbehave on full-revolution faces;
 * CAM tool-axis derivation expects per-segment. Healer should split
 * into N faces with configurable angular cap, preserve underlying
 * surface, and insert seam edges between segments.
 * Reproducer: full-revolution face on a CYLINDRICAL_SURFACE (angular
 * span 2*pi) bounded by a single closed seam.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Tfa028 full revolution face'),'2;1');
FILE_NAME('Tfa028.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('axis_origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('cyl_plc',#10,#11,#12);
#20=CYLINDRICAL_SURFACE('cyl',#13,10.0);
/* Seam point.                                                          */
#30=CARTESIAN_POINT('seam_bot',(10.0,0.0,0.0));
#31=CARTESIAN_POINT('seam_top',(10.0,0.0,5.0));
#40=VERTEX_POINT('',#30);
#41=VERTEX_POINT('',#31);
/* Bottom and top circles (full circles).                               */
#50=CARTESIAN_POINT('top_org',(0.0,0.0,5.0));
#51=AXIS2_PLACEMENT_3D('top_plc',#50,#11,#12);
#52=CIRCLE('bot_circle',#13,10.0);
#53=CIRCLE('top_circle',#51,10.0);
/* Vertical seam from bottom to top.                                    */
#60=DIRECTION('',(0.0,0.0,1.0));
#61=VECTOR('',#60,5.0);
#62=LINE('seam',#30,#61);
/* Defect site: single closed face spans full revolution (2*pi).        */
#70=EDGE_CURVE('bot_full',#40,#40,#52,.T.);
#71=EDGE_CURVE('top_full',#41,#41,#53,.T.);
#72=EDGE_CURVE('seam_edge',#40,#41,#62,.T.);
#80=ORIENTED_EDGE('',*,*,#70,.T.);
#81=ORIENTED_EDGE('',*,*,#72,.T.);
#82=ORIENTED_EDGE('',*,*,#71,.F.);
#83=ORIENTED_EDGE('',*,*,#72,.F.);
#90=EDGE_LOOP('full_rev',(#80,#81,#82,#83));
#100=FACE_OUTER_BOUND('',#90,.T.);
#110=ADVANCED_FACE('full_revolution_face',(#100),#20,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa028','Tfa028','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#110));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
