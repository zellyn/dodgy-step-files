ISO-10303-21;
/* Tfa169 - ShapeAnalysis_CheckSmallFace.CheckSplittingVertices vertex-shared-by-many
 * Vertex used by 5+ edges in a face's wires; CheckSplittingVertices's pairwise
 * pairing logic doesn't scale. Central vertex shared by 6 edges radiating outward. */
HEADER;
FILE_DESCRIPTION(('Tfa169 test case','ShapeAnalysis_CheckSmallFace.CheckSplittingVertices vertex-shared-by-many'),'2;1');
FILE_NAME('Tfa169.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Plane surface */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('face_plane',#13);
/* Central vertex shared by many edges */
#20=CARTESIAN_POINT('',(5.0,5.0,0.0));#21=VERTEX_POINT('center',#20);
