#56=DIRECTION('',(-0.5,-0.866,0.0));#57=VECTOR('',#56,1.0);#58=LINE('',#20,#57);
#59=EDGE_CURVE('e5',#21,#31,#58,.T.);
#60=DIRECTION('',(0.5,-0.866,0.0));#61=VECTOR('',#60,1.0);#62=LINE('',#20,#61);
#63=EDGE_CURVE('e6',#21,#33,#62,.T.);
/* 6 outer edges completing hexagon */
#64=DIRECTION('',(0.5,0.866,0.0));#65=VECTOR('',#64,1.0);#66=LINE('',#22,#65);
#67=EDGE_CURVE('e_out1',#23,#25,#66,.T.);
#68=DIRECTION('',(-1.0,0.0,0.0));#69=VECTOR('',#68,1.0);#70=LINE('',#24,#69);
#71=EDGE_CURVE('e_out2',#25,#27,#70,.T.);
#72=DIRECTION('',(-0.5,-0.866,0.0));#73=VECTOR('',#72,1.0);#74=LINE('',#26,#73);
#75=EDGE_CURVE('e_out3',#27,#29,#74,.T.);
#76=DIRECTION('',(-0.5,-0.866,0.0));#77=VECTOR('',#76,1.0);#78=LINE('',#28,#77);
#79=EDGE_CURVE('e_out4',#29,#31,#78,.T.);
#80=DIRECTION('',(0.5,0.866,0.0));#81=VECTOR('',#80,1.0);#82=LINE('',#30,#81);
#83=EDGE_CURVE('e_out5',#31,#33,#82,.T.);
#84=DIRECTION('',(1.0,0.0,0.0));#85=VECTOR('',#84,1.0);#86=LINE('',#32,#85);
#87=EDGE_CURVE('e_out6',#33,#23,#86,.T.);
/* Create outer wire as 6-edge loop */
#90=ORIENTED_EDGE('',*,*,#67,.T.);#91=ORIENTED_EDGE('',*,*,#71,.T.);
#92=ORIENTED_EDGE('',*,*,#75,.T.);#93=ORIENTED_EDGE('',*,*,#79,.T.);
#94=ORIENTED_EDGE('',*,*,#83,.T.);#95=ORIENTED_EDGE('',*,*,#87,.T.);
