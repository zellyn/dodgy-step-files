/* Create inner wire as 6 edges from outer to center */
#100=ORIENTED_EDGE('',*,*,#43,.T.);#101=ORIENTED_EDGE('',*,*,#47,.T.);
#102=ORIENTED_EDGE('',*,*,#51,.T.);#103=ORIENTED_EDGE('',*,*,#55,.T.);
#104=ORIENTED_EDGE('',*,*,#59,.T.);#105=ORIENTED_EDGE('',*,*,#63,.T.);
#106=EDGE_LOOP('inner_spokes',(#100,#101,#102,#103,#104,#105));
