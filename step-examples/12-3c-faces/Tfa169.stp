#32=CARTESIAN_POINT('',(7.5,1.34,0.0));#33=VERTEX_POINT('v6',#32);
/* 6 edges radiating from center */
#40=DIRECTION('',(1.0,0.0,0.0));#41=VECTOR('',#40,1.0);#42=LINE('',#20,#41);
#43=EDGE_CURVE('e1',#21,#23,#42,.T.);
#44=DIRECTION('',(0.5,0.866,0.0));#45=VECTOR('',#44,1.0);#46=LINE('',#20,#45);
