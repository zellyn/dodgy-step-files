#22=CARTESIAN_POINT('',(10.0,5.0,0.0));#23=VERTEX_POINT('v1',#22);
#24=CARTESIAN_POINT('',(7.5,8.66,0.0));#25=VERTEX_POINT('v2',#24);
#26=CARTESIAN_POINT('',(2.5,8.66,0.0));#27=VERTEX_POINT('v3',#26);
