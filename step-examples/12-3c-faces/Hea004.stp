ISO-10303-21;
/* Hea004 - Free-bound contours: filter by tolerance precision
 * As Hea003 (10x10 face on plane in OPEN_SHELL) but the bottom edge has
 * been subdivided into TEN short LINE segments, each laterally offset by
 * +/-1.0e-7 from the y=0 axis -- a sub-precision wiggle on the perimeter.
 * A precision-filter analyzer with precision >= 1.0e-6 hides this wiggle;
 * with precision < 1.0e-7 it surfaces. */
HEADER;
FILE_DESCRIPTION(('Hea004 test case','Open shell w/ contour whose bottom edge has 10 sub-precision wiggle segments'),'2;1');
FILE_NAME('Hea004.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
/* Eleven vertex points along the bottom (from x=0 to x=10 in 1.0 steps),
 * y oscillating: 0, 1.0e-7, -1.0e-7, 1.0e-7, -1.0e-7, ... */
#20=CARTESIAN_POINT('w0',(0.0,0.0,0.0));#21=VERTEX_POINT('',#20);
#22=CARTESIAN_POINT('w1',(1.0,1.0E-7,0.0));#23=VERTEX_POINT('',#22);
#24=CARTESIAN_POINT('w2',(2.0,-1.0E-7,0.0));#25=VERTEX_POINT('',#24);
#26=CARTESIAN_POINT('w3',(3.0,1.0E-7,0.0));#27=VERTEX_POINT('',#26);
#28=CARTESIAN_POINT('w4',(4.0,-1.0E-7,0.0));#29=VERTEX_POINT('',#28);
#30=CARTESIAN_POINT('w5',(5.0,1.0E-7,0.0));#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('w6',(6.0,-1.0E-7,0.0));#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('w7',(7.0,1.0E-7,0.0));#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('w8',(8.0,-1.0E-7,0.0));#37=VERTEX_POINT('',#36);
#38=CARTESIAN_POINT('w9',(9.0,1.0E-7,0.0));#39=VERTEX_POINT('',#38);
#40=CARTESIAN_POINT('w10',(10.0,0.0,0.0));#41=VERTEX_POINT('',#40);
/* Other 2 corners */
#42=CARTESIAN_POINT('',(10.0,10.0,0.0));#43=VERTEX_POINT('',#42);
#44=CARTESIAN_POINT('',(0.0,10.0,0.0));#45=VERTEX_POINT('',#44);
/* Ten short bottom edges between the 11 wiggle vertices */
#50=DIRECTION('',(1.0,1.0E-7,0.0));#51=VECTOR('',#50,1.0);#52=LINE('',#20,#51);#53=EDGE_CURVE('wig_1',#21,#23,#52,.T.);
#54=DIRECTION('',(1.0,-2.0E-7,0.0));#55=VECTOR('',#54,1.0);#56=LINE('',#22,#55);#57=EDGE_CURVE('wig_2',#23,#25,#56,.T.);
#58=DIRECTION('',(1.0,2.0E-7,0.0));#59=VECTOR('',#58,1.0);#60=LINE('',#24,#59);#61=EDGE_CURVE('wig_3',#25,#27,#60,.T.);
#62=DIRECTION('',(1.0,-2.0E-7,0.0));#63=VECTOR('',#62,1.0);#64=LINE('',#26,#63);#65=EDGE_CURVE('wig_4',#27,#29,#64,.T.);
#66=DIRECTION('',(1.0,2.0E-7,0.0));#67=VECTOR('',#66,1.0);#68=LINE('',#28,#67);#69=EDGE_CURVE('wig_5',#29,#31,#68,.T.);
#70=DIRECTION('',(1.0,-2.0E-7,0.0));#71=VECTOR('',#70,1.0);#72=LINE('',#30,#71);#73=EDGE_CURVE('wig_6',#31,#33,#72,.T.);
#74=DIRECTION('',(1.0,2.0E-7,0.0));#75=VECTOR('',#74,1.0);#76=LINE('',#32,#75);#77=EDGE_CURVE('wig_7',#33,#35,#76,.T.);
#78=DIRECTION('',(1.0,-2.0E-7,0.0));#79=VECTOR('',#78,1.0);#80=LINE('',#34,#79);#81=EDGE_CURVE('wig_8',#35,#37,#80,.T.);
#82=DIRECTION('',(1.0,2.0E-7,0.0));#83=VECTOR('',#82,1.0);#84=LINE('',#36,#83);#85=EDGE_CURVE('wig_9',#37,#39,#84,.T.);
#86=DIRECTION('',(1.0,-1.0E-7,0.0));#87=VECTOR('',#86,1.0);#88=LINE('',#38,#87);#89=EDGE_CURVE('wig_10',#39,#41,#88,.T.);
/* Right, top, left (clean) */
#90=DIRECTION('',(0.0,1.0,0.0));#91=VECTOR('',#90,1.0);#92=LINE('',#40,#91);#93=EDGE_CURVE('right',#41,#43,#92,.T.);
#94=DIRECTION('',(-1.0,0.0,0.0));#95=VECTOR('',#94,1.0);#96=LINE('',#42,#95);#97=EDGE_CURVE('top',#43,#45,#96,.T.);
#98=DIRECTION('',(0.0,-1.0,0.0));#99=VECTOR('',#98,1.0);#100=LINE('',#44,#99);#101=EDGE_CURVE('left',#45,#21,#100,.T.);
#110=ORIENTED_EDGE('',*,*,#53,.T.);#111=ORIENTED_EDGE('',*,*,#57,.T.);
#112=ORIENTED_EDGE('',*,*,#61,.T.);#113=ORIENTED_EDGE('',*,*,#65,.T.);
#114=ORIENTED_EDGE('',*,*,#69,.T.);#115=ORIENTED_EDGE('',*,*,#73,.T.);
#116=ORIENTED_EDGE('',*,*,#77,.T.);#117=ORIENTED_EDGE('',*,*,#81,.T.);
#118=ORIENTED_EDGE('',*,*,#85,.T.);#119=ORIENTED_EDGE('',*,*,#89,.T.);
#120=ORIENTED_EDGE('',*,*,#93,.T.);#121=ORIENTED_EDGE('',*,*,#97,.T.);
#122=ORIENTED_EDGE('',*,*,#101,.T.);
#123=EDGE_LOOP('wiggly_perimeter',(#110,#111,#112,#113,#114,#115,#116,#117,#118,#119,#120,#121,#122));
#124=FACE_OUTER_BOUND('',#123,.T.);
#125=ADVANCED_FACE('face_with_wiggle_bottom',(#124),#14,.T.);
#126=OPEN_SHELL('shell_with_wiggle_contour',(#125));
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Hea004','Hea004','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#126));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
