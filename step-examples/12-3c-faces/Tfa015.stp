ISO-10303-21;
/* Tfa015 - DropSmallSolids / debris solids from booleans
 * Defect: compound contains tiny / zero-volume sub-solids - Boolean
 * fragments, micron-scale residuals. Healer must detect by volume or
 * width-factor and drop or fuse with neighbor; respect user "Merge
 * Solids" flag; preserve XCAF attribute mapping for kept solids.
 * Reproducer: compound where one main solid (10x10x10 mm, V=1000 mm^3)
 * sits next to two debris solids:
 *   - debris A: 1.0e-3 cube (V = 1.0e-9 mm^3)
 *   - debris B: 5.0e-4 cube (V = 1.25e-10 mm^3)
 * All three are emitted as MANIFOLD_SOLID_BREP and aggregated through a
 * GEOMETRIC_REPRESENTATION_ITEM-list inside a single SHAPE_REPRESENTATION
 * standing in for the OCCT TopoDS_Compound the healer would receive.
 */
HEADER;
FILE_DESCRIPTION(('Tfa015 debris solids in compound'),'2;1');
FILE_NAME('Tfa015.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#5=( NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) LENGTH_UNIT() );
#6=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#5,'','');
#7=( GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#6))
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#5))
     REPRESENTATION_CONTEXT('','3D') );
/* ---------- main solid (10 x 10 x 10 mm, V = 1000 mm^3) ----------- */
#100=CARTESIAN_POINT('m000',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('m100',(10.0,0.0,0.0));
#102=CARTESIAN_POINT('m110',(10.0,10.0,0.0));
#103=CARTESIAN_POINT('m010',(0.0,10.0,0.0));
#104=CARTESIAN_POINT('m001',(0.0,0.0,10.0));
#105=CARTESIAN_POINT('m101',(10.0,0.0,10.0));
#106=CARTESIAN_POINT('m111',(10.0,10.0,10.0));
#107=CARTESIAN_POINT('m011',(0.0,10.0,10.0));
#110=VERTEX_POINT('',#100);
#111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102);
#113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104);
#115=VERTEX_POINT('',#105);
#116=VERTEX_POINT('',#106);
#117=VERTEX_POINT('',#107);
#120=DIRECTION('',(0.0,0.0,1.0));
#121=DIRECTION('',(1.0,0.0,0.0));
#122=AXIS2_PLACEMENT_3D('main_plc',#100,#120,#121);
#123=PLANE('main_face_z0',#122);
#130=CLOSED_SHELL('main_shell',(#123));
#131=MANIFOLD_SOLID_BREP('main_solid_10mm',#130);
/* ---------- debris solid A (1.0e-3 mm cube, V = 1.0e-9 mm^3) ---------- */
#200=CARTESIAN_POINT('a000',(100.000,100.000,100.000));
#201=CARTESIAN_POINT('a100',(100.001,100.000,100.000));
#202=CARTESIAN_POINT('a110',(100.001,100.001,100.000));
#203=CARTESIAN_POINT('a010',(100.000,100.001,100.000));
#204=CARTESIAN_POINT('a001',(100.000,100.000,100.001));
#205=CARTESIAN_POINT('a101',(100.001,100.000,100.001));
#206=CARTESIAN_POINT('a111',(100.001,100.001,100.001));
#207=CARTESIAN_POINT('a011',(100.000,100.001,100.001));
#210=VERTEX_POINT('',#200);
#211=VERTEX_POINT('',#201);
#212=VERTEX_POINT('',#202);
#213=VERTEX_POINT('',#203);
#214=VERTEX_POINT('',#204);
#215=VERTEX_POINT('',#205);
#216=VERTEX_POINT('',#206);
#217=VERTEX_POINT('',#207);
#220=AXIS2_PLACEMENT_3D('debris_a_plc',#200,#120,#121);
#221=PLANE('debris_a_face_z0',#220);
#222=CLOSED_SHELL('debris_a_shell',(#221));
#223=MANIFOLD_SOLID_BREP('debris_a_solid_1um',#222);
/* ---------- debris solid B (5.0e-4 mm cube, V = 1.25e-10 mm^3) ----- */
#300=CARTESIAN_POINT('b000',(50.0000,50.0000,50.0000));
#301=CARTESIAN_POINT('b100',(50.0005,50.0000,50.0000));
#302=CARTESIAN_POINT('b110',(50.0005,50.0005,50.0000));
#303=CARTESIAN_POINT('b010',(50.0000,50.0005,50.0000));
#304=CARTESIAN_POINT('b001',(50.0000,50.0000,50.0005));
#305=CARTESIAN_POINT('b101',(50.0005,50.0000,50.0005));
#306=CARTESIAN_POINT('b111',(50.0005,50.0005,50.0005));
#307=CARTESIAN_POINT('b011',(50.0000,50.0005,50.0005));
#310=VERTEX_POINT('',#300);
#311=VERTEX_POINT('',#301);
#312=VERTEX_POINT('',#302);
#313=VERTEX_POINT('',#303);
#314=VERTEX_POINT('',#304);
#315=VERTEX_POINT('',#305);
#316=VERTEX_POINT('',#306);
#317=VERTEX_POINT('',#307);
#320=AXIS2_PLACEMENT_3D('debris_b_plc',#300,#120,#121);
#321=PLANE('debris_b_face_z0',#320);
#322=CLOSED_SHELL('debris_b_shell',(#321));
#323=MANIFOLD_SOLID_BREP('debris_b_solid_500nm',#322);
/* ---------- compound wrapper (XCAF compound stand-in) ------------ */
/* SHAPE_REPRESENTATION acts as the compound here; it aggregates the
 * three MANIFOLD_SOLID_BREP instances together with their bounding
 * placement so that a healer sees one composite item with three solid
 * sub-shapes and decides which to drop / merge. */
#400=PRODUCT_CONTEXT('',#1,'mechanical');
#401=PRODUCT('debris_assembly','debris_assembly','',(#400));
#402=PRODUCT_DEFINITION_FORMATION('','',#401);
#403=PRODUCT_DEFINITION_CONTEXT('',#1,'design');
#404=PRODUCT_DEFINITION('design','',#402,#403);
#405=PRODUCT_DEFINITION_SHAPE('','',#404);
#410=SHAPE_REPRESENTATION('debris_compound',
  (#122,#131,#223,#323),#7);
#411=SHAPE_DEFINITION_REPRESENTATION(#405,#410);
ENDSEC;
END-ISO-10303-21;
