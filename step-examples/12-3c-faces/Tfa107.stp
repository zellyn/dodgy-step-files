ISO-10303-21;
/* Tfa107 - ShapeAnalysis_CheckSmallFace.CheckSpotFace surface-curvature variant
 * Small face on a high-curvature surface (sphere of radius 0.001).
 * CheckSpotFace's threshold uses absolute area not curvature-scaled.
 * Expected: should account for local curvature when assessing if face is spot/degenerate.
 */
HEADER;
FILE_DESCRIPTION(('Tfa107 test case','Small face on high-curvature sphere (radius 0.001)'),'2;1');
FILE_NAME('Tfa107.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* === High-curvature sphere: radius = 0.001 mm === */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=SPHERICAL_SURFACE('tiny_sphere',#13,0.001);
/* === Boundary vertices: rectangular patch on sphere surface === */
#20=CARTESIAN_POINT('',(0.0009,0.0,0.0005));#21=VERTEX_POINT('',#20);
#22=CARTESIAN_POINT('',(0.0009,0.00009,0.0005));#23=VERTEX_POINT('',#22);
#24=CARTESIAN_POINT('',(0.00095,0.00009,0.00055));#25=VERTEX_POINT('',#24);
#26=CARTESIAN_POINT('',(0.00095,0.0,0.00055));#27=VERTEX_POINT('',#26);
/* === 2D curves in parametric space for small patch === */
#30=DIRECTION('',(1.0,0.0,0.0));#31=VECTOR('',#30,0.00001);#32=LINE('',#20,#31);
#33=PCURVE('',#14,#32);
#34=EDGE_CURVE('edge1_u_const',#21,#23,#33,.T.);
#35=DIRECTION('',(0.0,1.0,0.0));#36=VECTOR('',#35,0.00001);#37=LINE('',#23,#36);
#38=PCURVE('',#14,#37);
#39=EDGE_CURVE('edge2_v_const',#23,#25,#38,.T.);
#40=DIRECTION('',(-1.0,0.0,0.0));#41=VECTOR('',#40,0.00001);#42=LINE('',#25,#41);
#43=PCURVE('',#14,#42);
#44=EDGE_CURVE('edge3_u_rev',#25,#27,#43,.T.);
#45=DIRECTION('',(0.0,-1.0,0.0));#46=VECTOR('',#45,0.00001);#47=LINE('',#27,#45);
#48=PCURVE('',#14,#47);
#49=EDGE_CURVE('edge4_v_rev',#27,#21,#48,.T.);
#50=ORIENTED_EDGE('oe1',*,*,#34,.T.);#51=ORIENTED_EDGE('oe2',*,*,#39,.T.);
#52=ORIENTED_EDGE('oe3',*,*,#44,.T.);#53=ORIENTED_EDGE('oe4',*,*,#49,.T.);
#54=EDGE_LOOP('boundary_loop',(#50,#51,#52,#53));
#55=FACE_OUTER_BOUND('',#54,.T.);
#60=ADVANCED_FACE('tiny_sphere_patch',(#55),#14,.T.);
/* === Mandatory product chain === */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa107','Tfa107','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=OPEN_SHELL('shell',(#60));
#9022=SHELL_BASED_SURFACE_MODEL('sbsm',(#9021));
#9023=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9022),#9010);
#9024=SHAPE_DEFINITION_REPRESENTATION(#9005,#9023);
ENDSEC;
END-ISO-10303-21;
