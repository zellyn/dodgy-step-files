ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Tfa133 FixOrientation outer-bound-but-inner-correct'),'2;1');
FILE_NAME('Tfa133.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2009,#1);
/* Tfa133 - FixOrientation.outer-bound-but-inner-correct
 * Defect: Outer bound has wrong winding but inner bounds are correct.
 * FixOrientation flips outer but breaks inner-relative winding.
 * Trigger: Face with counter-clockwise outer (wrong) and clockwise inners (right).
 */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('placement',#10,#11,#12);
/* Outer wire: counter-clockwise (incorrect) */
#20=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('p1',(0.0,20.0,0.0));
#22=CARTESIAN_POINT('p2',(20.0,20.0,0.0));
#23=CARTESIAN_POINT('p3',(20.0,0.0,0.0));
/* Inner wire 1: clockwise (correct relative to ccw outer) */
#24=CARTESIAN_POINT('p4',(2.0,2.0,0.0));
#25=CARTESIAN_POINT('p5',(2.0,8.0,0.0));
#26=CARTESIAN_POINT('p6',(8.0,8.0,0.0));
#27=CARTESIAN_POINT('p7',(8.0,2.0,0.0));
/* Inner wire 2: clockwise (correct relative to ccw outer) */
#28=CARTESIAN_POINT('p8',(12.0,12.0,0.0));
#29=CARTESIAN_POINT('p9',(12.0,18.0,0.0));
#30=CARTESIAN_POINT('p10',(18.0,18.0,0.0));
#31=CARTESIAN_POINT('p11',(18.0,12.0,0.0));
/* Vertices */
#40=VERTEX_POINT('v0',#20);
#41=VERTEX_POINT('v1',#21);
#42=VERTEX_POINT('v2',#22);
#43=VERTEX_POINT('v3',#23);
#44=VERTEX_POINT('v4',#24);
#45=VERTEX_POINT('v5',#25);
#46=VERTEX_POINT('v6',#26);
#47=VERTEX_POINT('v7',#27);
#48=VERTEX_POINT('v8',#28);
#49=VERTEX_POINT('v9',#29);
#50=VERTEX_POINT('v10',#30);
#51=VERTEX_POINT('v11',#31);
/* Outer wire edges (ccw: 0→1→2→3→0) */
#60=DIRECTION('d0',(0.0,1.0,0.0));
#61=VECTOR('v_out0',#60,20.0);
#62=LINE('l0',#20,#61);
#63=DIRECTION('d1',(1.0,0.0,0.0));
#64=VECTOR('v_out1',#63,20.0);
#65=LINE('l1',#21,#64);
#66=DIRECTION('d2',(0.0,-1.0,0.0));
#67=VECTOR('v_out2',#66,20.0);
#68=LINE('l2',#22,#67);
#69=DIRECTION('d3',(-1.0,0.0,0.0));
#70=VECTOR('v_out3',#69,20.0);
#71=LINE('l3',#23,#70);
#72=EDGE_CURVE('e0',#40,#41,#62,.T.);
#73=EDGE_CURVE('e1',#41,#42,#65,.T.);
#74=EDGE_CURVE('e2',#42,#43,#68,.T.);
#75=EDGE_CURVE('e3',#43,#40,#71,.T.);
/* Inner wire 1 edges (cw: 4→5→6→7→4) */
#76=DIRECTION('d4',(0.0,1.0,0.0));
#77=VECTOR('v_in10',#76,6.0);
#78=LINE('l4',#24,#77);
#79=DIRECTION('d5',(1.0,0.0,0.0));
#80=VECTOR('v_in11',#79,6.0);
#81=LINE('l5',#25,#80);
#82=DIRECTION('d6',(0.0,-1.0,0.0));
#83=VECTOR('v_in12',#82,6.0);
#84=LINE('l6',#26,#83);
#85=DIRECTION('d7',(-1.0,0.0,0.0));
#86=VECTOR('v_in13',#85,6.0);
#87=LINE('l7',#27,#86);
#88=EDGE_CURVE('e4',#44,#45,#78,.T.);
#89=EDGE_CURVE('e5',#45,#46,#81,.T.);
#90=EDGE_CURVE('e6',#46,#47,#84,.T.);
#91=EDGE_CURVE('e7',#47,#44,#87,.T.);
/* Inner wire 2 edges (cw: 8→9→10→11→8) */
#92=DIRECTION('d8',(0.0,1.0,0.0));
#93=VECTOR('v_in20',#92,6.0);
#94=LINE('l8',#28,#93);
#95=DIRECTION('d9',(1.0,0.0,0.0));
#96=VECTOR('v_in21',#95,6.0);
#97=LINE('l9',#29,#96);
#98=DIRECTION('d10',(0.0,-1.0,0.0));
#99=VECTOR('v_in22',#98,6.0);
#100=LINE('l10',#30,#99);
#101=DIRECTION('d11',(-1.0,0.0,0.0));
#102=VECTOR('v_in23',#101,6.0);
#103=LINE('l11',#31,#102);
#104=EDGE_CURVE('e8',#48,#49,#94,.T.);
#105=EDGE_CURVE('e9',#49,#50,#97,.T.);
#106=EDGE_CURVE('e10',#50,#51,#100,.T.);
#107=EDGE_CURVE('e11',#51,#48,#103,.T.);
/* Oriented edges */
#110=ORIENTED_EDGE('oe0',*,*,#72,.T.);
#111=ORIENTED_EDGE('oe1',*,*,#73,.T.);
#112=ORIENTED_EDGE('oe2',*,*,#74,.T.);
#113=ORIENTED_EDGE('oe3',*,*,#75,.T.);
#114=ORIENTED_EDGE('oe4',*,*,#88,.T.);
#115=ORIENTED_EDGE('oe5',*,*,#89,.T.);
#116=ORIENTED_EDGE('oe6',*,*,#90,.T.);
#117=ORIENTED_EDGE('oe7',*,*,#91,.T.);
#118=ORIENTED_EDGE('oe8',*,*,#104,.T.);
#119=ORIENTED_EDGE('oe9',*,*,#105,.T.);
#120=ORIENTED_EDGE('oe10',*,*,#106,.T.);
#121=ORIENTED_EDGE('oe11',*,*,#107,.T.);
/* Edge loops */
#130=EDGE_LOOP('outer',(#110,#111,#112,#113));
#131=EDGE_LOOP('inner1',(#114,#115,#116,#117));
#132=EDGE_LOOP('inner2',(#118,#119,#120,#121));
/* Face bounds */
#140=FACE_OUTER_BOUND('outer',#130,.T.);
#141=FACE_INNER_BOUND('inner1',#131,.T.);
#142=FACE_INNER_BOUND('inner2',#132,.T.);
/* Geometry */
#150=PLANE('plane',#13);
/* Face with reversed outer and correct inners */
#160=ADVANCED_FACE('mixed-winding',(#140,#141,#142),#150,.T.);
#170=OPEN_SHELL('shell',(#160));
/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa133','Tfa133','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#170));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
