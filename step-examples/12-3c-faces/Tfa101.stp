ISO-10303-21;
/* Tfa101 — ShapeFix_Face.FixAddNaturalBound torus complete-surface
 * Full torus surface without wires needing natural boundary insertion.
 * The bug: inserter must produce two boundary loops (interior+exterior)
 * but only constructs one, leaving the complete surface un-bounded.
 */
HEADER;
FILE_DESCRIPTION(('Tfa101 test case','Torus complete surface missing natural bounds'),'2;1');
FILE_NAME('Tfa101.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Torus: major radius 5.0, minor radius 1.0, centered at origin */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=TOROIDAL_SURFACE('complete_torus',#13,5.0,1.0);
/* Empty wire list: face has null/zero wire boundary */
#20=EDGE_LOOP('null_boundary',(#30,#31,#32,#33));
#30=ORIENTED_EDGE('',*,*,#40,.T.);
#31=ORIENTED_EDGE('',*,*,#41,.T.);
#32=ORIENTED_EDGE('',*,*,#42,.T.);
#33=ORIENTED_EDGE('',*,*,#43,.T.);
/* Minimal placeholder edges to satisfy syntax */
#40=CARTESIAN_POINT('',(6.0,0.0,0.0));
#41=VERTEX_POINT('',#40);
#42=CARTESIAN_POINT('',(6.0,0.5,0.0));
#43=VERTEX_POINT('',#42);
#44=DIRECTION('',(0.0,1.0,0.0));
#45=VECTOR('',#44,0.5);
#46=LINE('',#40,#45);
#50=EDGE_CURVE('',#41,#43,#46,.T.);
#51=ORIENTED_EDGE('',*,*,#50,.T.);
#52=DIRECTION('',(-1.0,0.0,0.0));
#53=VECTOR('',#52,0.5);
#54=LINE('',#42,#53);
#55=EDGE_CURVE('',#43,#41,#54,.T.);
#56=ORIENTED_EDGE('',*,*,#55,.T.);
#60=EDGE_LOOP('torus_outer',(#30,#31,#32,#33));
#61=FACE_OUTER_BOUND('',#60,.T.);
#70=ADVANCED_FACE('torus_face',(#61),#14,.T.);
/* Product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa101','Tfa101','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9030));
#9030=OPEN_SHELL('torus_shell',(#70));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
