/* Minimal edge to satisfy topology */
#12=CARTESIAN_POINT('v_start',(0.0,0.0,0.0));
#13=CARTESIAN_POINT('v_end',(1.0,0.0,0.0));
#14=VERTEX_POINT('vp_start',#12);
#15=VERTEX_POINT('vp_end',#13);
#20=LINE('edge_line',#12,#27);
#21=DIRECTION('',(1.0,0.0,0.0));
#27=VECTOR('',#21,1.0);
#30=EDGE_CURVE('edge',#14,#15,#20,.T.);
/* Single edge loop (valid WIRE) */
#33=ORIENTED_EDGE('oe',*,*,#30,.T.);
#40=EDGE_LOOP('loop',(#33));
#41=FACE_OUTER_BOUND('bound',#40,.T.);
/* Face constructed from patch */
#50=ADVANCED_FACE('patch_face',(#41),#5,.T.);
#60=CLOSED_SHELL('shell',(#50));
#70=MANIFOLD_SOLID_BREP('solid',#60);
ENDSEC;
