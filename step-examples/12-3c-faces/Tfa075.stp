ISO-10303-21;
/* Tfa075 — ShapeFix_ComposeShell.MakeFacesOnPatch fallback resolution
   Defect: residual loop promotion when topology resolution ambiguous.
   Single non-WIRE loop (e.g., VERTEX) passed to method triggers early
   return without proper face construction. */
HEADER;
FILE_DESCRIPTION(('Tfa075 - MakeFacesOnPatch fallback loop resolution'),'2;1');
FILE_NAME('Tfa075.stp','2026-06-15T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#2=DIRECTION('zdir',(0.0,0.0,1.0));
#3=DIRECTION('xdir',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('placement',#1,#2,#3);
#5=PLANE('patch_plane',#4);
/* Vertex that could be confused as loop */
#10=CARTESIAN_POINT('v_single',(0.5,0.5,0.0));
