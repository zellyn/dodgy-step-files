#6=CARTESIAN_POINT('',(5.0,0.0,0.0));
#7=VERTEX_POINT('',#6);
#8=CARTESIAN_POINT('',(0.0,0.0,0.0));
#9=AXIS2_PLACEMENT_3D('',#8,#2,#3);
#10=CIRCLE('',#9,5.0);
#11=EDGE_CURVE('equator_only_bound',#7,#7,#10,.T.);
#12=ORIENTED_EDGE('',$,$,#11,.T.);
#13=EDGE_LOOP('',(#12));
#14=FACE_OUTER_BOUND('',#13,.T.);
#15=ADVANCED_FACE('',(#14),#5,.T.);
#16=OPEN_SHELL('',(#15));
#17=SHELL_BASED_SURFACE_MODEL('',(#16));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
