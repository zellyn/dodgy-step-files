ISO-10303-21;
/* Tfa037 - Face-level healing pipeline must orchestrate sub-fixes
 * Square 10x10 face on a PLANE has FACE_OUTER_BOUND plus FACE_INNER_BOUND.
 * Inner wire is the defect bundle: edges out of order (3,1,2), enclosed
 * area sub-tolerance (~5.0e-7), and FACE_BOUND orientation flag is .T. (outer)
 * but the wire is positioned as an inner hole. */
HEADER;
FILE_DESCRIPTION(('Tfa037 test case','Square face with out-of-order, sub-tolerance, wrong-orientation inner wire'),'2;1');
FILE_NAME('Tfa037.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
/* outer 10x10 square */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));#21=VERTEX_POINT('',#20);
#22=CARTESIAN_POINT('',(10.0,0.0,0.0));#23=VERTEX_POINT('',#22);
#24=CARTESIAN_POINT('',(10.0,10.0,0.0));#25=VERTEX_POINT('',#24);
#26=CARTESIAN_POINT('',(0.0,10.0,0.0));#27=VERTEX_POINT('',#26);
#30=DIRECTION('',(1.0,0.0,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#20,#31);
#33=EDGE_CURVE('',#21,#23,#32,.T.);
#34=DIRECTION('',(0.0,1.0,0.0));#35=VECTOR('',#34,1.0);#36=LINE('',#22,#35);
#37=EDGE_CURVE('',#23,#25,#36,.T.);
#38=DIRECTION('',(-1.0,0.0,0.0));#39=VECTOR('',#38,1.0);#40=LINE('',#24,#39);
#41=EDGE_CURVE('',#25,#27,#40,.T.);
#42=DIRECTION('',(0.0,-1.0,0.0));#43=VECTOR('',#42,1.0);#44=LINE('',#26,#43);
#45=EDGE_CURVE('',#27,#21,#44,.T.);
#50=ORIENTED_EDGE('',*,*,#33,.T.);
#51=ORIENTED_EDGE('',*,*,#37,.T.);
#52=ORIENTED_EDGE('',*,*,#41,.T.);
#53=ORIENTED_EDGE('',*,*,#45,.T.);
#54=EDGE_LOOP('outer',(#50,#51,#52,#53));
#55=FACE_OUTER_BOUND('outer',#54,.T.);
/* inner triangle: tiny (~5.0e-7 mm^2 area), edges scrambled-order [e3,e1,e2] */
#60=CARTESIAN_POINT('',(5.0,5.0,0.0));#61=VERTEX_POINT('',#60);
#62=CARTESIAN_POINT('',(5.001,5.0,0.0));#63=VERTEX_POINT('',#62);
#64=CARTESIAN_POINT('',(5.0,5.001,0.0));#65=VERTEX_POINT('',#64);
#66=DIRECTION('',(1.0,0.0,0.0));#67=VECTOR('',#66,1.0);#68=LINE('',#60,#67);
#69=EDGE_CURVE('inner_e1',#61,#63,#68,.T.);
#70=DIRECTION('',(-0.7071067811865475,0.7071067811865475,0.0));#71=VECTOR('',#70,1.4142);#72=LINE('',#62,#71);
#73=EDGE_CURVE('inner_e2',#63,#65,#72,.T.);
#74=DIRECTION('',(0.0,-1.0,0.0));#75=VECTOR('',#74,1.0);#76=LINE('',#64,#75);
#77=EDGE_CURVE('inner_e3',#65,#61,#76,.T.);
/* SCRAMBLED order [e3, e1, e2] */
#80=ORIENTED_EDGE('inner_oe_e3_first',*,*,#77,.T.);
#81=ORIENTED_EDGE('inner_oe_e1_second',*,*,#69,.T.);
#82=ORIENTED_EDGE('inner_oe_e2_third',*,*,#73,.T.);
#83=EDGE_LOOP('inner_scrambled',(#80,#81,#82));
/* WRONG ORIENTATION: this is a FACE_INNER_BOUND but the FACE_BOUND
 * orientation flag is .T. (which classifies the wire as outer-style). */
#84=FACE_INNER_BOUND('inner_wrong_orientation_flag_T',#83,.T.);
#90=ADVANCED_FACE('square_with_defect_inner',(#55,#84),#14,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa037','Tfa037','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#90));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
