ISO-10303-21;
/* Tfa012 - Face area zero / negative after fixshape
 * Defect: BRepGProp::SurfaceProperties returns zero or negative area for
 * a face. Either fully degenerate, or healing reversed orientation and
 * the signed-area integration flipped sign. Healer must restore
 * consistent winding; reject if both surface and wire are degenerate
 * (zero unsigned area).
 * Reproducer: ADVANCED_FACE on a PLANE whose outer wire winds clockwise
 * on the natural surface orientation (i.e., reversed) so the signed
 * area is negative. The face normal disagrees with wire winding.
 */
HEADER;
FILE_DESCRIPTION(('Tfa012 face area zero or negative'),'2;1');
FILE_NAME('Tfa012.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
#20=PLANE('plane_xy',#13);
#21=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#22=CARTESIAN_POINT('p1',(10.0,0.0,0.0));
#23=CARTESIAN_POINT('p2',(10.0,10.0,0.0));
#24=CARTESIAN_POINT('p3',(0.0,10.0,0.0));
#30=VERTEX_POINT('',#21);
#31=VERTEX_POINT('',#22);
#32=VERTEX_POINT('',#23);
#33=VERTEX_POINT('',#24);
#40=DIRECTION('',(1.0,0.0,0.0));
#41=DIRECTION('',(0.0,1.0,0.0));
#42=DIRECTION('',(-1.0,0.0,0.0));
#43=DIRECTION('',(0.0,-1.0,0.0));
#50=VECTOR('',#40,10.0);
#51=VECTOR('',#41,10.0);
#52=VECTOR('',#42,10.0);
#53=VECTOR('',#43,10.0);
#60=LINE('',#21,#50);
#61=LINE('',#22,#51);
#62=LINE('',#23,#52);
#63=LINE('',#24,#53);
#70=EDGE_CURVE('',#30,#31,#60,.T.);
#71=EDGE_CURVE('',#31,#32,#61,.T.);
#72=EDGE_CURVE('',#32,#33,#62,.T.);
#73=EDGE_CURVE('',#33,#30,#63,.T.);
/* Defect site: outer wire emitted CLOCKWISE on +Z plane normal (the
 * wire goes p0 -> p3 -> p2 -> p1 instead of p0 -> p1 -> p2 -> p3).    */
#80=ORIENTED_EDGE('',*,*,#73,.F.);
#81=ORIENTED_EDGE('',*,*,#72,.F.);
#82=ORIENTED_EDGE('',*,*,#71,.F.);
#83=ORIENTED_EDGE('',*,*,#70,.F.);
#90=EDGE_LOOP('cw_outer',(#80,#81,#82,#83));
#100=FACE_OUTER_BOUND('',#90,.T.);
#110=ADVANCED_FACE('cw_face',(#100),#20,.T.);
/* Minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa012','Tfa012','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#110));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
