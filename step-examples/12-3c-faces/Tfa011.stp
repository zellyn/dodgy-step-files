ISO-10303-21;
/* Tfa011 - Multiple outer wires (face needs split)
 * Defect: an ADVANCED_FACE is emitted with two (or more) FACE_OUTER_BOUND
 * records when STEP requires exactly one. Often the result of a botched
 * REHOST/MakeFace where every 3D edge - including those already
 * representing the contour - was reprojected onto a new surface without
 * dedup, producing two pcurves tracing the same contour. Healer should
 * split into two faces (one per outer wire), or merge if outer wires
 * coincide; reject if loops cross.
 * Reproducer: ADVANCED_FACE with two FACE_OUTER_BOUND records on PLANE
 * (two disjoint square loops on the same plane).
 */
HEADER;
FILE_DESCRIPTION(('Tfa011 multiple outer wires'),'2;1');
FILE_NAME('Tfa011.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
#20=PLANE('plane_xy',#13);
/* Loop A: square at (0,0)-(10,10).                                     */
#21=CARTESIAN_POINT('a0',(0.0,0.0,0.0));
#22=CARTESIAN_POINT('a1',(10.0,0.0,0.0));
#23=CARTESIAN_POINT('a2',(10.0,10.0,0.0));
#24=CARTESIAN_POINT('a3',(0.0,10.0,0.0));
/* Loop B: square at (20,0)-(30,10), disjoint from A.                   */
#25=CARTESIAN_POINT('b0',(20.0,0.0,0.0));
#26=CARTESIAN_POINT('b1',(30.0,0.0,0.0));
#27=CARTESIAN_POINT('b2',(30.0,10.0,0.0));
#28=CARTESIAN_POINT('b3',(20.0,10.0,0.0));
#30=VERTEX_POINT('',#21);
#31=VERTEX_POINT('',#22);
#32=VERTEX_POINT('',#23);
#33=VERTEX_POINT('',#24);
#34=VERTEX_POINT('',#25);
#35=VERTEX_POINT('',#26);
#36=VERTEX_POINT('',#27);
#37=VERTEX_POINT('',#28);
#40=DIRECTION('',(1.0,0.0,0.0));
#41=DIRECTION('',(0.0,1.0,0.0));
#42=DIRECTION('',(-1.0,0.0,0.0));
#43=DIRECTION('',(0.0,-1.0,0.0));
#50=VECTOR('',#40,10.0);
#51=VECTOR('',#41,10.0);
#52=VECTOR('',#42,10.0);
#53=VECTOR('',#43,10.0);
#60=LINE('',#21,#50);
#61=LINE('',#22,#51);
#62=LINE('',#23,#52);
#63=LINE('',#24,#53);
#64=LINE('',#25,#50);
#65=LINE('',#26,#51);
#66=LINE('',#27,#52);
#67=LINE('',#28,#53);
#70=EDGE_CURVE('',#30,#31,#60,.T.);
#71=EDGE_CURVE('',#31,#32,#61,.T.);
#72=EDGE_CURVE('',#32,#33,#62,.T.);
#73=EDGE_CURVE('',#33,#30,#63,.T.);
#74=EDGE_CURVE('',#34,#35,#64,.T.);
#75=EDGE_CURVE('',#35,#36,#65,.T.);
#76=EDGE_CURVE('',#36,#37,#66,.T.);
#77=EDGE_CURVE('',#37,#34,#67,.T.);
#80=ORIENTED_EDGE('',*,*,#70,.T.);
#81=ORIENTED_EDGE('',*,*,#71,.T.);
#82=ORIENTED_EDGE('',*,*,#72,.T.);
#83=ORIENTED_EDGE('',*,*,#73,.T.);
#84=ORIENTED_EDGE('',*,*,#74,.T.);
#85=ORIENTED_EDGE('',*,*,#75,.T.);
#86=ORIENTED_EDGE('',*,*,#76,.T.);
#87=ORIENTED_EDGE('',*,*,#77,.T.);
#90=EDGE_LOOP('A',(#80,#81,#82,#83));
#91=EDGE_LOOP('B',(#84,#85,#86,#87));
/* Defect site: two FACE_OUTER_BOUND records on the same face.          */
#100=FACE_OUTER_BOUND('outer_A',#90,.T.);
#101=FACE_OUTER_BOUND('outer_B',#91,.T.);
#110=ADVANCED_FACE('two_outers',(#100,#101),#20,.T.);
/* Minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa011','Tfa011','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#110));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
