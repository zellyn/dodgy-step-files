ISO-10303-21;
/* Tfa084 - ShapeAnalysis_FreeBoundsProperties.CheckNotches: gap-after-fix
 * Face whose outer boundary has a notch that, when removed, leaves a gap
 * between the surviving edges. CheckNotches should flag the gap as invalid.
 */
HEADER;
FILE_DESCRIPTION(('Tfa084 test case','Face notch removal leaves gap; CheckNotches should flag gap'),'2;1');
FILE_NAME('Tfa084.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Plane at Z=0 */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('gap_notch_plane',#13);
/* Outer boundary: rectangle with notch that disconnects edges
   Path: (0,0) -> (5,0) -> (5.01,0.1) [notch] -> (4.99,0.1) [notch] -> (5,5) -> (0,5) -> (0,0)
   When notch is removed, edge from (5,0) can't connect to edge from (5,5): gap of 0.1 units
*/
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=VERTEX_POINT('v0',#20);
#22=CARTESIAN_POINT('',(5.0,0.0,0.0));
#23=VERTEX_POINT('v1',#22);
#24=CARTESIAN_POINT('',(5.01,0.1,0.0));
#25=VERTEX_POINT('v_notch_a',#24);
#26=CARTESIAN_POINT('',(4.99,0.1,0.0));
#27=VERTEX_POINT('v_notch_b',#26);
#28=CARTESIAN_POINT('',(5.0,5.0,0.0));
#29=VERTEX_POINT('v2',#28);
#30=CARTESIAN_POINT('',(0.0,5.0,0.0));
#31=VERTEX_POINT('v3',#30);
/* Edge 0: (0,0)->(5,0) */
#32=DIRECTION('',(1.0,0.0,0.0));
#33=VECTOR('',#32,1.0);
#34=LINE('',#20,#33);
#35=EDGE_CURVE('e0_bottom',#21,#23,#34,.T.);
/* Edge 1: (5,0)->(5.01,0.1) -- notch out */
#36=DIRECTION('',(0.1,1.0,0.0));
#37=VECTOR('',#36,1.0025);
#38=LINE('',#22,#37);
#39=EDGE_CURVE('e1_notch_out',#23,#25,#38,.T.);
/* Edge 2: (5.01,0.1)->(4.99,0.1) -- notch across */
#40=DIRECTION('',(-1.0,0.0,0.0));
#41=VECTOR('',#40,0.02);
#42=LINE('',#24,#41);
#43=EDGE_CURVE('e2_notch_across',#25,#27,#42,.T.);
/* Edge 3: (4.99,0.1)->(5,5) -- notch back; creates gap from (5,0) */
#44=DIRECTION('',(0.01,4.9,0.0));
#45=VECTOR('',#44,4.9001);
#46=LINE('',#26,#45);
#47=EDGE_CURVE('e3_gap_right',#27,#29,#46,.T.);
/* Edge 4: (5,5)->(0,5) */
#48=DIRECTION('',(-1.0,0.0,0.0));
#49=VECTOR('',#48,1.0);
#50=LINE('',#28,#49);
#51=EDGE_CURVE('e4_top',#29,#31,#50,.T.);
/* Edge 5: (0,5)->(0,0) */
#52=DIRECTION('',(0.0,-1.0,0.0));
#53=VECTOR('',#52,1.0);
#54=LINE('',#30,#53);
#55=EDGE_CURVE('e5_left',#31,#21,#54,.T.);
/* Orient all edges forward */
#56=ORIENTED_EDGE('oe0',*,*,#35,.T.);
#57=ORIENTED_EDGE('oe1',*,*,#39,.T.);
#58=ORIENTED_EDGE('oe2',*,*,#43,.T.);
#59=ORIENTED_EDGE('oe3',*,*,#47,.T.);
#60=ORIENTED_EDGE('oe4',*,*,#51,.T.);
#61=ORIENTED_EDGE('oe5',*,*,#55,.T.);
#62=EDGE_LOOP('notched_gap_outer',(#56,#57,#58,#59,#60,#61));
#63=FACE_OUTER_BOUND('',#62,.T.);
#90=ADVANCED_FACE('gap_notch_face',(#63),#14,.T.);
/* Minimal PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tfa084','Tfa084','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9100));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
#9100=CLOSED_SHELL('shell_for_product',(#90));
ENDSEC;
END-ISO-10303-21;
