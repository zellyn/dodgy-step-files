ISO-10303-21;
/*
 * A026 — Quadratic-time assembly graph traversal during read
 * Defect (OCCT 63cdf48 / Mantis 0029830, Creo → Inventor OOM, Revit-derived
 *         data, 440MB STEP entity-name map O(n²), 20MB STEP 50s):
 *   STEPCAFControl_Reader performance degrades quadratically with assembly
 *   size; entity-name map lookup is O(n²) and building name→shape map for
 *   10k faces takes ~45 minutes vs ~2 min for the read itself. Hangs at
 *   high % indefinitely. FixShellOrientationMode cost is also a multiplier.
 * This is a SHRUNKEN demonstrator: 24 NAUOs of one shared product. The
 *   shape of the defect is N siblings on a hot-spot in the writer's
 *   entity-name map.
 * Expected kernel: index entity IDs once at parse; bound healing loops by
 *   entity count; use indexed lookup, not nested scan.
 */
HEADER;
FILE_DESCRIPTION(('A026 24 sibling NAUOs sharing one product (O(n^2) trap)'),'2;1');
FILE_NAME('A026.stp','2026-04-26T00:00:00',('catalog'),('cad'),'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('automotive design');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT_DEFINITION_CONTEXT('part definition',#10,'design');
#20 = PRODUCT('A026_ASSY','wide assembly','',(#12));
#21 = PRODUCT_DEFINITION_FORMATION('','',#20);
#22 = PRODUCT_DEFINITION('design','',#21,#13);
#23 = PRODUCT_DEFINITION_SHAPE('','',#22);
#30 = PRODUCT('LEAF','tiny leaf','',(#12));
#31 = PRODUCT_DEFINITION_FORMATION('','',#30);
#32 = PRODUCT_DEFINITION('design','',#31,#13);
#33 = PRODUCT_DEFINITION_SHAPE('','',#32);
/* 24 sibling NAUOs */
#100 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','I_01','',#22,#32,$);
#101 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('2','I_02','',#22,#32,$);
#102 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('3','I_03','',#22,#32,$);
