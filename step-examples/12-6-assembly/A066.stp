ISO-10303-21;
/* A066 - UpdateAssemblies double-applies root location.
 * Defect: root assembly has translation (100,0,0); child has (50,0,0).
 * Real two-level assembly (NAUO + parent/child SHAPE_REPRESENTATION_RELATIONSHIP).
 * Expected leaf placement (150,0,0); UpdateAssemblies produces (200,0,0). */
HEADER;
FILE_DESCRIPTION(('A066 test case','UpdateAssemblies double-applies root location'),'2;1');
FILE_NAME('A066.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
/* Root product */
#11=PRODUCT('ROOT','root_assembly','',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('design','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
/* Child product */
#21=PRODUCT('CHILD','child_part','',(#10));
#22=PRODUCT_DEFINITION_FORMATION('','',#21);
#24=PRODUCT_DEFINITION('design','',#22,#13);
#25=PRODUCT_DEFINITION_SHAPE('','',#24);
/* Identity axis (used by both shape reps) */
#30=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#31=DIRECTION('zdir',(0.0,0.0,1.0));
#32=DIRECTION('xdir',(1.0,0.0,0.0));
#33=AXIS2_PLACEMENT_3D('identity',#30,#31,#32);
/* Root location at (100,0,0) */
#40=CARTESIAN_POINT('root_origin',(100.0,0.0,0.0));
#41=AXIS2_PLACEMENT_3D('root_loc',#40,#31,#32);
/* Child location at (50,0,0), to be composed with root */
#50=CARTESIAN_POINT('child_origin',(50.0,0.0,0.0));
#51=AXIS2_PLACEMENT_3D('child_loc',#50,#31,#32);
/* Shape representations for root and child */
#60=SHAPE_REPRESENTATION('root_rep',(#41),#1);
#61=SHAPE_REPRESENTATION('child_rep',(#51),#1);
#62=SHAPE_DEFINITION_REPRESENTATION(#15,#60);
#63=SHAPE_DEFINITION_REPRESENTATION(#25,#61);
/* NAUO + ITEM_DEFINED_TRANSFORMATION + SRR wiring child under root */
#70=NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','child_under_root','',#14,#24,$);
#71=ITEM_DEFINED_TRANSFORMATION('child_under_root_xf','',#33,#51);
#72=( REPRESENTATION_RELATIONSHIP('child_in_root','',#60,#61)
       REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#71)
       SHAPE_REPRESENTATION_RELATIONSHIP() );
#73=PRODUCT_DEFINITION_SHAPE('','',#70);
#74=CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#72,#73);
ENDSEC;
END-ISO-10303-21;
