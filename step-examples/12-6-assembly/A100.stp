/* A100 - Importer routes Assembly-module assemblies into Part containers.
 * Defect (FreeCAD #18668): the kinematic / mechanism graph is silently
 * dropped. On disk the file carries MECHANISM and KINEMATIC_JOINT
 * annotations alongside two solid bodies; the receiver loads only the
 * geometry and drops everything kinematic. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('A100 - mechanism / kinematic graph alongside geometry'),'2;1');
FILE_NAME('A100.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING { 1 0 10303 442 3 1 4 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('A100_assy','assembly with kinematic data','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=PLANE('a_face',#23);
#25=ADVANCED_FACE('a_face',(),#24,.T.);
#26=CLOSED_SHELL('a_shell',(#25));
#27=MANIFOLD_SOLID_BREP('linkA',#26);
#30=CARTESIAN_POINT('',(50.0,0.0,0.0));
#31=DIRECTION('',(0.0,0.0,1.0));
#32=DIRECTION('',(1.0,0.0,0.0));
#33=AXIS2_PLACEMENT_3D('',#30,#31,#32);
#34=PLANE('b_face',#33);
#35=ADVANCED_FACE('b_face',(),#34,.T.);
#36=CLOSED_SHELL('b_shell',(#35));
#37=MANIFOLD_SOLID_BREP('linkB',#36);
#40=NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','linkA_inst','',#7,#7,$);
#41=NEXT_ASSEMBLY_USAGE_OCCURRENCE('2','linkB_inst','',#7,#7,$);
/* Defect: the kinematic graph below is what FreeCAD's STEP importer
   silently discards. */
#50=KINEMATIC_JOINT('hinge_joint',#27,#37);
#51=MECHANISM('A100_mechanism',(#50));
#52=KINEMATIC_TOPOLOGY_STRUCTURE('A100_kts',(#27,#37),(#50));
ENDSEC;
END-ISO-10303-21;
