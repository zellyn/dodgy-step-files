ISO-10303-21;
/*
 * P012 — STEP-XML (.stpx) and compressed (.stpz) variants unsupported
 * Defect (FreeCAD #12678 .stpx, #8218 .stpZ; PTC Creo, Siemens NX emit .stpx,
 *         compression is generic):
 *   STEP-XML (.stpx, AP242 XML form) and gzip-compressed STEP (.stpz) are
 *   emitted by some commercial tools but only plain ISO-10303-21 is parsed.
 * Reproducer: take any valid STEP file, gzip it and rename .stpZ; or convert
 *   to .stpx XML form. This catalog file is plain Part 21 itself but DOCUMENTS
 *   and notes the format-variant problem because we cannot embed an actual
 *   gzip blob in a 7-bit ASCII catalog file.
 * Expected kernel: recognize and decompress / parse XML form.
 *
 * NOTE: this catalog stub is plain Part 21; the *defect* is a wrapper format,
 *   not a Part-21 entity-graph defect. Stored here for §12.6 completeness.
 */
HEADER;
FILE_DESCRIPTION(('P012 .stpx/.stpz wrapper variants — placeholder catalog stub'),'2;1');
FILE_NAME('P012.stp','2026-04-26T00:00:00',('catalog'),('cad'),'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('automotive design');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT_DEFINITION_CONTEXT('part definition',#10,'design');
#20 = PRODUCT('P012_ASSY','plain Part 21 placeholder for stpx/stpz','',(#12));
#21 = PRODUCT_DEFINITION_FORMATION('','',#20);
#22 = PRODUCT_DEFINITION('design','',#21,#13);
#23 = PRODUCT_DEFINITION_SHAPE('','',#22);
#30 = PRODUCT('LEAF_A','plain part','',(#12));
#31 = PRODUCT_DEFINITION_FORMATION('','',#30);
#32 = PRODUCT_DEFINITION('design','',#31,#13);
#33 = PRODUCT_DEFINITION_SHAPE('','',#32);
#34 = PRODUCT('LEAF_B','companion part','',(#12));
#35 = PRODUCT_DEFINITION_FORMATION('','',#34);
#36 = PRODUCT_DEFINITION('design','',#35,#13);
#37 = PRODUCT_DEFINITION_SHAPE('','',#36);
#40 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','LEAF_A_INST','',#22,#32,$);
#41 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('2','LEAF_B_INST','',#22,#36,$);
/* Externally referenced document — same family of "wrappers we can't open":
   the .stpx / .stpz cases reduce to "cannot decode the bytes the file is in",
   and analogously OCCT cannot follow a DOCUMENT_FILE pointing at an external
   .stpz it has no decoder for. */
#42 = DOCUMENT_FILE('linked-side-A.stpz','external compressed STEP-21','application/x-stepz');
#43 = DOCUMENT_FILE('linked-side-B.stpx','external STEP-XML','application/x-stepx');
#44 = APPLIED_DOCUMENT_REFERENCE(#42,'side-A',(#32));
#45 = APPLIED_DOCUMENT_REFERENCE(#43,'side-B',(#36));
#50 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#51 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#52 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#53 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#50,'distance_accuracy_value','');
#54 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#53))
        GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52)) REPRESENTATION_CONTEXT('','3D') );
#60 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#61 = DIRECTION('',(0.0,0.0,1.0));
#62 = DIRECTION('',(1.0,0.0,0.0));
#63 = AXIS2_PLACEMENT_3D('a_origin',#60,#61,#62);
#64 = SHAPE_REPRESENTATION('a_rep',(#63),#54);
#65 = SHAPE_DEFINITION_REPRESENTATION(#33,#64);
#66 = REPRESENTATION_MAP(#63,#64);
#70 = AXIS2_PLACEMENT_3D('b_origin',#60,#61,#62);
#71 = SHAPE_REPRESENTATION('b_rep',(#70),#54);
#72 = SHAPE_DEFINITION_REPRESENTATION(#37,#71);
#73 = REPRESENTATION_MAP(#70,#71);
#74 = MAPPED_ITEM('a_inst',#66,#63);
#75 = MAPPED_ITEM('b_inst',#73,#70);
#80 = AXIS2_PLACEMENT_3D('assy_origin',#60,#61,#62);
#81 = SHAPE_REPRESENTATION('assy_rep',(#80,#74,#75),#54);
#82 = SHAPE_DEFINITION_REPRESENTATION(#23,#81);
/* Extended catalog notes:
 * This reproducer is a minimal demonstrator of the §12.6 entry
