ISO-10303-21;
/* A106 - Access violation in StepVisual_PresentationStyleAssignment translating STEP file
 * Defect: PRESENTATION_STYLE_ASSIGNMENT arrives with empty styles list (()),
 * translation pass dereferences styles[0] without bounds check. */
HEADER;
FILE_DESCRIPTION(('A106 - empty PRESENTATION_STYLE_ASSIGNMENT styles list crashes translator'),'2;1');
FILE_NAME('A106.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
#30=ADVANCED_FACE('',(),#20,.T.);
#40=CLOSED_SHELL('',(#30));
#50=MANIFOLD_SOLID_BREP('part',#40);
/* Defect: empty styles list. */
#100=PRESENTATION_STYLE_ASSIGNMENT(());
#101=STYLED_ITEM('empty_style_list',(#100),#50);
ENDSEC;
END-ISO-10303-21;
