ISO-10303-21;
/*
 * A017 — XCAF labels/colors/names lost when transformed (Pos/Rot or
 *        location-on-subshape)
 * Defect (build123d #1014: Pos*Rot drops labels; build123d #954 nested
 *         compound labels via STEPControl_Writer; OCCT #541 STEP re-export
 *         loses XCAF colors; orphan TopLoc_Location on subshapes; spurious
 *         face-level locations from STEP round-trip):
 *   Programmatic location attached to a face/edge/vertex within a single
 *   body confuses algorithms that assume identity locations on subshapes.
 *   After STEP round-trip, faces sometimes acquire near-identity transforms
 *   even when source was identity.
 * This example has a face with a non-identity AXIS2_PLACEMENT_3D injected
 *   at the face level (subshape-location pattern), plus colors that can be
 *   lost on round-trip.
 */
HEADER;
FILE_DESCRIPTION(('A017 face carries spurious near-identity placement; XCAF color at risk'),'2;1');
FILE_NAME('A017.stp','2026-04-26T00:00:00',('catalog'),('cad'),'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('automotive design');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT_DEFINITION_CONTEXT('part definition',#10,'design');
#20 = PRODUCT('A017_ASSY','','',(#12));
#21 = PRODUCT_DEFINITION_FORMATION('','',#20);
#22 = PRODUCT_DEFINITION('design','',#21,#13);
#23 = PRODUCT_DEFINITION_SHAPE('','',#22);
#30 = PRODUCT('PART','colored body','',(#12));
#31 = PRODUCT_DEFINITION_FORMATION('','',#30);
#32 = PRODUCT_DEFINITION('design','',#31,#13);
#33 = PRODUCT_DEFINITION_SHAPE('','',#32);
#40 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','PART_INST','',#22,#32,$);
#50 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#51 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#52 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#53 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#50,'distance_accuracy_value','');
#54 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#53))
        GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52)) REPRESENTATION_CONTEXT('','3D') );
#60 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#61 = DIRECTION('',(0.0,0.0,1.0));
#62 = DIRECTION('',(1.0,0.0,0.0));
#63 = AXIS2_PLACEMENT_3D('part_origin',#60,#61,#62);
/* DEFECT: spurious near-identity placement attached at the FACE/SUBSHAPE
   level — a 1-micron offset that should have been baked into the surface
   geometry but instead survives as a TopLoc location on the subshape. */
#70 = CARTESIAN_POINT('subshape_offset',(0.000001,0.0,0.0));
#71 = AXIS2_PLACEMENT_3D('face_subshape_loc',#70,#61,#62);
#72 = PLANE('',#71);
#73 = ADVANCED_FACE('colored_face',(),#72,.T.);
#80 = SHAPE_REPRESENTATION('part_rep',(#63,#73),#54);
#81 = SHAPE_DEFINITION_REPRESENTATION(#33,#80);
#82 = REPRESENTATION_MAP(#63,#80);
#83 = MAPPED_ITEM('inst',#82,#63);
/* Color that goes on round-trip when STEPControl_Writer is used in place of
   STEPCAFControl_Writer (the build123d #954 trap). */
#90 = COLOUR_RGB('red',0.8,0.1,0.1);
#91 = FILL_AREA_STYLE_COLOUR('',#90);
#92 = FILL_AREA_STYLE('',(#91));
#93 = SURFACE_STYLE_FILL_AREA(#92);
#94 = SURFACE_SIDE_STYLE('',(#93));
#95 = SURFACE_STYLE_USAGE(.BOTH.,#94);
#96 = PRESENTATION_STYLE_ASSIGNMENT((#95));
#97 = STYLED_ITEM('face_style',(#96),#73);
#98 = AXIS2_PLACEMENT_3D('assy_origin',#60,#61,#62);
#99 = SHAPE_REPRESENTATION('assy_rep',(#98,#83),#54);
#100 = SHAPE_DEFINITION_REPRESENTATION(#23,#99);
ENDSEC;
END-ISO-10303-21;
