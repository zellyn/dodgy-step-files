ISO-10303-21;
/* A101 - SubShapeBinder-derived Boolean Cut crashes downstream slicers
 * and re-import.
 * Defect (FreeCAD #26994): asterisk-implicit ORIENTED_EDGE references
 * escape into the file body. The receiver tries to materialise them
 * and crashes (PrusaSlicer) or yields empty (FreeCAD self-import). */
HEADER;
FILE_DESCRIPTION(('A101 - asterisk edge_element escapes into file body'),'2;1');
FILE_NAME('A101.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('A101_subshape','subshape-binder boolean','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(10.0,0.0,0.0));
#22=VERTEX_POINT('',#20);
#23=VERTEX_POINT('',#21);
#24=DIRECTION('',(1.0,0.0,0.0));
#25=VECTOR('',#24,10.0);
#26=LINE('',#20,#25);
#27=EDGE_CURVE('',#22,#23,#26,.T.);
/* Defect: ORIENTED_EDGE has both edge_start (* asterisk) and edge_end
   (* asterisk) AND its edge_element points at #99 -- which itself is an
   ORIENTED_EDGE whose own edge_element is *. The receiver dereferences
   into nothing. */
#28=ORIENTED_EDGE('outer_oedge',*,*,#99,.T.);
#29=ORIENTED_EDGE('',*,*,#27,.T.);
#99=ORIENTED_EDGE('asterisk_edge_element',*,*,*,.T.);
#30=EDGE_LOOP('',(#28,#29));
#31=DIRECTION('',(0.0,0.0,1.0));
#32=DIRECTION('',(1.0,0.0,0.0));
#33=AXIS2_PLACEMENT_3D('',#20,#31,#32);
#34=PLANE('',#33);
#35=FACE_OUTER_BOUND('',#30,.T.);
#36=ADVANCED_FACE('',(#35),#34,.T.);
#37=CLOSED_SHELL('',(#36));
#38=MANIFOLD_SOLID_BREP('A101_body',#37);
#40=SHAPE_REPRESENTATION('A101_repr',(#33,#38),#14);
#41=SHAPE_DEFINITION_REPRESENTATION(#8,#40);
ENDSEC;
END-ISO-10303-21;
