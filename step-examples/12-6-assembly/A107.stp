ISO-10303-21;
/* A107 - BinXCAF regression: documents with colour cannot be re-loaded after save
 * The on-disk STEP form holds the colour assignment via STYLED_ITEM; the catalog
 * defect is that a BinXCAF round-trip silently drops the colour after 7.4.0. */
HEADER;
FILE_DESCRIPTION(('A107 - BinXCAF colour driver regression equivalent'),'2;1');
FILE_NAME('A107.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
#30=ADVANCED_FACE('',(),#20,.T.);
#40=CLOSED_SHELL('',(#30));
#50=MANIFOLD_SOLID_BREP('part',#40);
#60=COLOUR_RGB('green',0.0,0.6,0.2);
#61=FILL_AREA_STYLE_COLOUR('',#60);
#62=FILL_AREA_STYLE('',(#61));
#63=SURFACE_STYLE_FILL_AREA(#62);
#64=SURFACE_SIDE_STYLE('',(#63));
#65=SURFACE_STYLE_USAGE(.BOTH.,#64);
#66=PRESENTATION_STYLE_ASSIGNMENT((#65));
#67=STYLED_ITEM('colour_for_BinXCAF_round_trip',(#66),#50);
#70=PRESENTATION_LAYER_ASSIGNMENT('layer','BinXCAF',(#50));
ENDSEC;
END-ISO-10303-21;
