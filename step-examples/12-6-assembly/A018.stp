ISO-10303-21;
/*
 * A018 — STYLED_ITEM at wrong scope: assembly-level color override lost
 * Defect (SolidWorks assembly-level color, per-face → white, Inventor strips
 *         appearances, OCCT root-label color, Onshape pipeline, KiCad nested
 *         STYLED_ITEM lost on flatten, HOOPS material merging):
 *   When color is overridden at assembly node level (not part level), STEP
 *   writers emit per-part STYLED_ITEM rather than per-instance, so receivers
 *   see all instances colored alike. STYLED_ITEM must attach to MAPPED_ITEM-
 *   level instances; here it instead attaches to the part SHAPE_REPRESENTATION,
 *   so the assembly-level red override is impossible to localize.
 * Expected kernel: STYLED_ITEM must attach to MAPPED_ITEM-level instances;
 *   prefer most-specific styled-item; never inherit from sibling sub-assembly.
 */
HEADER;
FILE_DESCRIPTION(('A018 assembly-level red override emitted as part-level styled_item'),'2;1');
FILE_NAME('A018.stp','2026-04-26T00:00:00',('catalog'),('cad'),'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('automotive design');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT_DEFINITION_CONTEXT('part definition',#10,'design');
#20 = PRODUCT('A018_ASSY','','',(#12));
#21 = PRODUCT_DEFINITION_FORMATION('','',#20);
#22 = PRODUCT_DEFINITION('design','',#21,#13);
#23 = PRODUCT_DEFINITION_SHAPE('','',#22);
#30 = PRODUCT('SHARED_PART','reused part','',(#12));
#31 = PRODUCT_DEFINITION_FORMATION('','',#30);
#32 = PRODUCT_DEFINITION('design','',#31,#13);
#33 = PRODUCT_DEFINITION_SHAPE('','',#32);
/* Two instances; user wanted instance #1 RED, instance #2 BLUE. */
#40 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','I_RED','',#22,#32,$);
#41 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('2','I_BLUE','',#22,#32,$);
#50 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#51 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#52 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#53 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#50,'distance_accuracy_value','');
#54 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#53))
        GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52)) REPRESENTATION_CONTEXT('','3D') );
#60 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#61 = DIRECTION('',(0.0,0.0,1.0));
#62 = DIRECTION('',(1.0,0.0,0.0));
#63 = AXIS2_PLACEMENT_3D('part_origin',#60,#61,#62);
#64 = PLANE('',#63);
#65 = ADVANCED_FACE('shared_face',(),#64,.T.);
#66 = SHAPE_REPRESENTATION('shared_rep',(#63,#65),#54);
#67 = SHAPE_DEFINITION_REPRESENTATION(#33,#66);
#68 = REPRESENTATION_MAP(#63,#66);
#70 = CARTESIAN_POINT('',(-50.0,0.0,0.0));
#71 = AXIS2_PLACEMENT_3D('inst_red_place',#70,#61,#62);
#72 = MAPPED_ITEM('I_RED_inst',#68,#71);
#73 = CARTESIAN_POINT('',(50.0,0.0,0.0));
#74 = AXIS2_PLACEMENT_3D('inst_blue_place',#73,#61,#62);
#75 = MAPPED_ITEM('I_BLUE_inst',#68,#74);
#80 = AXIS2_PLACEMENT_3D('assy_origin',#60,#61,#62);
#81 = SHAPE_REPRESENTATION('assy_rep',(#80,#72,#75),#54);
#82 = SHAPE_DEFINITION_REPRESENTATION(#23,#81);
/* Single intended assembly-level RED override — should bind to MAPPED_ITEM #72 */
#90 = COLOUR_RGB('red',0.9,0.1,0.1);
#91 = FILL_AREA_STYLE_COLOUR('',#90);
#92 = FILL_AREA_STYLE('',(#91));
#93 = SURFACE_STYLE_FILL_AREA(#92);
#94 = SURFACE_SIDE_STYLE('',(#93));
#95 = SURFACE_STYLE_USAGE(.BOTH.,#94);
#96 = PRESENTATION_STYLE_ASSIGNMENT((#95));
/* DEFECT: STYLED_ITEM points at the part-level FACE #65 instead of at the
   MAPPED_ITEM #72. Both instances inherit the same red — the assembly-level
   per-instance override is not localizable. */
#97 = STYLED_ITEM('part_level_red',(#96),#65);
ENDSEC;
END-ISO-10303-21;
