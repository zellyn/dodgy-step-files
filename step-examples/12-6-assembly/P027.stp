ISO-10303-21;
/*
 * P027 — Boolean-history Faces with degenerate hole-loop pcurves crash writer
 * Defect (FreeCAD #5783; OCCT issue #80; FreeCAD-internal shape graph):
 *   With "write parametric pcurves" enabled, certain Geom_BSplineSurface
 *   faces with a hole loop whose pcurve domain is degenerate (zero length)
 *   or maps outside the surface's natural domain crash
 *   TopoDSToStep_MakeStepFace::Init (null deref). When such files are
 *   nonetheless emitted, they contain malformed pcurves on read.
 * Reproducer: a B-spline surface face with a hole loop whose 2D pcurve has
 *   zero-length parameter domain.
 * Expected kernel: detect and skip / fix the bad pcurve before writing;
 *   reader should reject malformed pcurves with clear message.
 */
HEADER;
FILE_DESCRIPTION(('P027 hole-loop pcurve with degenerate (zero-length) domain'),'2;1');
FILE_NAME('P027.stp','2026-04-26T00:00:00',('catalog'),('cad'),'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('automotive design');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT_DEFINITION_CONTEXT('part definition',#10,'design');
#20 = PRODUCT('P027_ASSY','','',(#12));
#21 = PRODUCT_DEFINITION_FORMATION('','',#20);
#22 = PRODUCT_DEFINITION('design','',#21,#13);
#23 = PRODUCT_DEFINITION_SHAPE('','',#22);
#30 = PRODUCT('BSPLINE_FACE','face with degenerate hole pcurve','',(#12));
#31 = PRODUCT_DEFINITION_FORMATION('','',#30);
#32 = PRODUCT_DEFINITION('design','',#31,#13);
#33 = PRODUCT_DEFINITION_SHAPE('','',#32);
#40 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','BSP_INST','',#22,#32,$);
/* B-spline surface — minimal 2x2 cubic */
#100 = CARTESIAN_POINT('cp00',(0.0,0.0,0.0));
#101 = CARTESIAN_POINT('cp01',(1.0,0.0,0.0));
#102 = CARTESIAN_POINT('cp10',(0.0,1.0,0.0));
#103 = CARTESIAN_POINT('cp11',(1.0,1.0,0.0));
#104 = B_SPLINE_SURFACE_WITH_KNOTS('bsp_surf',1,1,
         ((#100,#101),(#102,#103)),
         .UNSPECIFIED.,.F.,.F.,.F.,
         (2,2),(2,2),(0.0,1.0),(0.0,1.0),.UNSPECIFIED.);
/* DEFECT: hole-loop pcurve has degenerate domain — start point equals end
   point, both at uv=(0.5,0.5). */
#105 = CARTESIAN_POINT('pc_zero',(0.5,0.5));
#106 = DIRECTION('pc_d',(1.0,0.0));
#107 = VECTOR('pc_v_zero',#106,0.0);
#108 = LINE('pc_zero_line',#105,#107);
#109 = DEFINITIONAL_REPRESENTATION('zero_pc_def',(#108),#54);
#110 = PCURVE('degenerate_hole_pc',#104,#109);
#111 = CARTESIAN_POINT('hole_3d',(0.5,0.5,0.0));
#112 = VERTEX_POINT('vh',#111);
#113 = VECTOR('e3v',#106,0.0);
#114 = LINE('hole_3d_line',#111,#113);
#115 = SURFACE_CURVE('hole_surf_curve',#114,(#110),.PCURVE_S1.);
#116 = EDGE_CURVE('hole_edge',#112,#112,#115,.T.);
#117 = ORIENTED_EDGE('hole_oe',*,*,#116,.T.);
#118 = EDGE_LOOP('hole_loop',(#117));
#119 = FACE_BOUND('hole_inner_bound',#118,.T.);
#50 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#51 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#52 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#53 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#50,'distance_accuracy_value','');
#54 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#53))
        GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52)) REPRESENTATION_CONTEXT('','3D') );
#60 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#61 = DIRECTION('',(0.0,0.0,1.0));
#62 = DIRECTION('',(1.0,0.0,0.0));
#63 = AXIS2_PLACEMENT_3D('part_origin',#60,#61,#62);
#64 = SHAPE_REPRESENTATION('part_rep',(#63,#104,#119),#54);
#65 = SHAPE_DEFINITION_REPRESENTATION(#33,#64);
#66 = REPRESENTATION_MAP(#63,#64);
#67 = MAPPED_ITEM('inst',#66,#63);
#80 = AXIS2_PLACEMENT_3D('assy_origin',#60,#61,#62);
#81 = SHAPE_REPRESENTATION('assy_rep',(#80,#67),#54);
#82 = SHAPE_DEFINITION_REPRESENTATION(#23,#81);
