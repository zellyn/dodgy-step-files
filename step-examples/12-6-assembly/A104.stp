ISO-10303-21;
/* A104 - Exception during STEP write with ExternalReferences mode in XDE document
 * Defect: writer throws Standard_DomainError when one assembly branch is empty
 * (PRODUCT_DEFINITION exists but no PRODUCT_DEFINITION_SHAPE / SHAPE_REPRESENTATION). */
HEADER;
FILE_DESCRIPTION(('A104 - empty branch in multi-file STEP write triggers exception'),'2;1');
FILE_NAME('A104.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#10=PRODUCT('A104_root','root assembly','',(#3));
#11=PRODUCT_DEFINITION_FORMATION('','',#10);
#12=PRODUCT_DEFINITION('design','',#11,#4);
#20=PRODUCT('A104_branchA','populated branch','',(#3));
#21=PRODUCT_DEFINITION_FORMATION('','',#20);
#22=PRODUCT_DEFINITION('design','',#21,#4);
#30=PRODUCT('A104_branchB','empty branch','',(#3));
#31=PRODUCT_DEFINITION_FORMATION('','',#30);
#32=PRODUCT_DEFINITION('design','',#31,#4);
#40=NEXT_ASSEMBLY_USAGE_OCCURRENCE('A','sub-A','',#12,#22,$);
#41=NEXT_ASSEMBLY_USAGE_OCCURRENCE('B','sub-B','',#12,#32,$);
#50=EXTERNALLY_DEFINED_ITEM('','peer_branch_B.stp');
ENDSEC;
END-ISO-10303-21;
