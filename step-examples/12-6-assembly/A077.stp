ISO-10303-21;
/* A077 - Sub-assembly extraction loses XDE attributes
 * Defect: two-level assembly with names + colours on every level; extraction copies geometry only */
HEADER;
FILE_DESCRIPTION(('A077 test case','Sub-assembly extraction loses XDE attributes'),'2;1');
FILE_NAME('A077.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('part1','part1','part1',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
#100=PRODUCT('subassy','sub','',(#10));
#104=PRODUCT_DEFINITION_FORMATION('','',#100);
#105=PRODUCT_DEFINITION('','',#104,#13);
/* NEXT_ASSEMBLY_USAGE_OCCURRENCE relating/related must be PRODUCT_DEFINITION,
 * not PRODUCT. Corrected here: 4th arg is the parent PD (#14), 5th is
 * the child PD (#105). */
#101=NEXT_ASSEMBLY_USAGE_OCCURRENCE('','sub_under_root','',#14,#105,'');
#102=COLOUR_RGB('',0.0,1.0,0.0);
#103=STYLED_ITEM('sub_green',(#102),#105);

ENDSEC;
END-ISO-10303-21;
