ISO-10303-21;
/* A120: SRRWT where only ONE of Origin/Target belongs to its expected representation */
/* DEFECT: Origin(Ax1) IS in Parent's items; Target(Ax2) is in NEITHER rep's items -- */
/* the unrepairable 'does not belong' branch (A007 is the FULLY-swapped, repairable case) */
HEADER;
FILE_DESCRIPTION(('A120: SRRWT half-swap, only Origin resolves to its own representation'),'2;1');
FILE_NAME('A120.stp','2026-07-12T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#100=APPLICATION_CONTEXT('mechanical design');
#101=(GEOMETRIC_REPRESENTATION_CONTEXT(3)REPRESENTATION_CONTEXT('','3D'));
/* ---- Parent product: 1x1 marker face at the origin ---- */
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=DIRECTION('',(0.0,0.0,1.0));
#3=DIRECTION('',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('',#1,#2,#3);
#5=PLANE('',#4);
#6=CARTESIAN_POINT('',(0.0,0.0,0.0));
#7=CARTESIAN_POINT('',(1.0,0.0,0.0));
#8=CARTESIAN_POINT('',(1.0,1.0,0.0));
#9=CARTESIAN_POINT('',(0.0,1.0,0.0));
#10=VERTEX_POINT('',#6);
#11=VERTEX_POINT('',#7);
#12=VERTEX_POINT('',#8);
#13=VERTEX_POINT('',#9);
#14=DIRECTION('',(1.0,0.0,0.0));
#15=VECTOR('',#14,1.0);
#16=LINE('',#6,#15);
#17=EDGE_CURVE('',#10,#11,#16,.T.);
#18=DIRECTION('',(0.0,1.0,0.0));
#19=VECTOR('',#18,1.0);
#20=LINE('',#7,#19);
#21=EDGE_CURVE('',#11,#12,#20,.T.);
#22=DIRECTION('',(-1.0,0.0,0.0));
#23=VECTOR('',#22,1.0);
#24=LINE('',#8,#23);
#25=EDGE_CURVE('',#12,#13,#24,.T.);
#26=DIRECTION('',(0.0,-1.0,0.0));
#27=VECTOR('',#26,1.0);
#28=LINE('',#9,#27);
#29=EDGE_CURVE('',#13,#10,#28,.T.);
#30=ORIENTED_EDGE('',$,$,#17,.T.);
#31=ORIENTED_EDGE('',$,$,#21,.T.);
#32=ORIENTED_EDGE('',$,$,#25,.T.);
#33=ORIENTED_EDGE('',$,$,#29,.T.);
#34=EDGE_LOOP('',(#30,#31,#32,#33));
#35=FACE_OUTER_BOUND('',#34,.T.);
#36=ADVANCED_FACE('',(#35),#5,.T.);
#37=OPEN_SHELL('',(#36));
#38=SHELL_BASED_SURFACE_MODEL('',(#37));
#40=SHAPE_REPRESENTATION('parent_rep',(#38),#101);
#41=PRODUCT_CONTEXT('',#100,'mechanical');
#42=PRODUCT('Parent','Parent','',(#41));
#43=PRODUCT_DEFINITION_FORMATION('','',#42);
#44=PRODUCT_DEFINITION_CONTEXT('part definition',#100,'design');
#45=PRODUCT_DEFINITION('','',#43,#44);
#46=PRODUCT_DEFINITION_SHAPE('','',#45);
#47=SHAPE_DEFINITION_REPRESENTATION(#46,#40);
/* DEFECT setup: a SEPARATE placement-only representation for the assembly relationship -- */
/* Ax1 (Origin) IS included in ITS items, so isOKOrigin=True for the SRRWT membership check */
#39=CARTESIAN_POINT('ax1_origin',(0.0,0.0,0.0));
#60=AXIS2_PLACEMENT_3D('Ax1_Origin',#39,#2,#3);
#48=SHAPE_REPRESENTATION('parent_placement_rep',(#60),#101);
/* ---- Child product: 5x5 marker face at (100,0,0) ---- */
#50=CARTESIAN_POINT('',(100.0,0.0,0.0));
#51=AXIS2_PLACEMENT_3D('',#50,#2,#3);
#52=PLANE('',#51);
#53=CARTESIAN_POINT('',(100.0,0.0,0.0));
#54=CARTESIAN_POINT('',(105.0,0.0,0.0));
#55=CARTESIAN_POINT('',(105.0,5.0,0.0));
#56=CARTESIAN_POINT('',(100.0,5.0,0.0));
#57=VERTEX_POINT('',#53);
#58=VERTEX_POINT('',#54);
#59=VERTEX_POINT('',#55);
#61=VERTEX_POINT('',#56);
#62=VECTOR('',#14,5.0);
#63=LINE('',#53,#62);
#64=EDGE_CURVE('',#57,#58,#63,.T.);
#65=VECTOR('',#18,5.0);
#66=LINE('',#54,#65);
#67=EDGE_CURVE('',#58,#59,#66,.T.);
#68=VECTOR('',#22,5.0);
#69=LINE('',#55,#68);
#70=EDGE_CURVE('',#59,#61,#69,.T.);
#71=VECTOR('',#26,5.0);
#72=LINE('',#56,#71);
#73=EDGE_CURVE('',#61,#57,#72,.T.);
#74=ORIENTED_EDGE('',$,$,#64,.T.);
#75=ORIENTED_EDGE('',$,$,#67,.T.);
#76=ORIENTED_EDGE('',$,$,#70,.T.);
#77=ORIENTED_EDGE('',$,$,#73,.T.);
#78=EDGE_LOOP('',(#74,#75,#76,#77));
#79=FACE_OUTER_BOUND('',#78,.T.);
#80=ADVANCED_FACE('',(#79),#52,.T.);
#81=OPEN_SHELL('',(#80));
#82=SHELL_BASED_SURFACE_MODEL('',(#81));
#83=SHAPE_REPRESENTATION('child_rep',(#82),#101);
#84=PRODUCT_CONTEXT('',#100,'mechanical');
#85=PRODUCT('Child','Child','',(#84));
#86=PRODUCT_DEFINITION_FORMATION('','',#85);
#87=PRODUCT_DEFINITION('','',#86,#44);
#88=PRODUCT_DEFINITION_SHAPE('','',#87);
#89=SHAPE_DEFINITION_REPRESENTATION(#88,#83);
/* Child's SEPARATE placement-only representation for the assembly relationship -- */
/* DEFECT: Ax2 (Target) is NOT included in ITS items (nor Parent's placement rep's) -- */
/* a completely foreign, unreferenced placement -- isOKTarget=False, isSwapTarget=False */
#97=SHAPE_REPRESENTATION('child_placement_rep',(),#101);
#90=CARTESIAN_POINT('ax2_foreign_origin',(200.0,200.0,200.0));
#91=AXIS2_PLACEMENT_3D('Ax2_Target_foreign',#90,#2,#3);
/* ---- NAUO: Parent relating, Child related ---- */
#92=NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','','uses',#45,#87,$);
#93=PRODUCT_DEFINITION_SHAPE('Placement','Placement of an item',#92);
/* DEFECT: SRRWT relates the two PLACEMENT-ONLY reps; Ax1 genuinely belongs to Rep1 */
/* (parent_placement_rep), but Ax2 belongs to NEITHER Rep1 nor Rep2 (child_placement_rep) */
#94=ITEM_DEFINED_TRANSFORMATION('','',#60,#91);
#95=SHAPE_REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION('srrwt','',#48,#97,#94);
#96=CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#95,#93);
ENDSEC;
END-ISO-10303-21;
