ISO-10303-21;
/*
 * A011 — Naming collision: same PRODUCT.name across distinct sub-assemblies
 * Defect (CadQuery on KiCad mobo-3D / SolidWorks/AutoCAD "Duplicate Definition
 *         of Block" / Creo): Either reuse one sub-model for many caps (KiCad)
 *   OR emit the same physical component as multiple distinct PRODUCT_DEFINITIONs
 *   (one per use site). Receivers keyed on label-as-primary-key (CadQuery)
 *   raise ValueError; AutoCAD reports "Duplicate Definition of Block 1
 *   ignored". FreeCAD silently appends an index.
 * Expected kernel: treat entity IDs (#NNN) as primary keys; names are
 *   descriptive; disambiguate names on import; never fail on duplicates.
 */
HEADER;
FILE_DESCRIPTION(('A011 multiple PRODUCTs share name "Cap"'),'2;1');
FILE_NAME('A011.stp','2026-04-26T00:00:00',('catalog'),('cad'),'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('automotive design');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT_DEFINITION_CONTEXT('part definition',#10,'design');
/* Top assembly */
#20 = PRODUCT('A011_PCB','PCB','',(#12));
#21 = PRODUCT_DEFINITION_FORMATION('','',#20);
#22 = PRODUCT_DEFINITION('design','',#21,#13);
#23 = PRODUCT_DEFINITION_SHAPE('','',#22);
/* DEFECT: three distinct PRODUCTs all named 'Cap', same id slot too. */
#30 = PRODUCT('Cap','Cap','',(#12));
#31 = PRODUCT_DEFINITION_FORMATION('','',#30);
#32 = PRODUCT_DEFINITION('design','',#31,#13);
#33 = PRODUCT_DEFINITION_SHAPE('','',#32);
#34 = PRODUCT('Cap','Cap','',(#12));
#35 = PRODUCT_DEFINITION_FORMATION('','',#34);
#36 = PRODUCT_DEFINITION('design','',#35,#13);
#37 = PRODUCT_DEFINITION_SHAPE('','',#36);
#38 = PRODUCT('Cap','Cap','',(#12));
#39 = PRODUCT_DEFINITION_FORMATION('','',#38);
#40 = PRODUCT_DEFINITION('design','',#39,#13);
#41 = PRODUCT_DEFINITION_SHAPE('','',#40);
/* Three NAUOs use distinct PDs but identical NAUO names too */
#42 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','Cap','',#22,#32,$);
#43 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('2','Cap','',#22,#36,$);
#44 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('3','Cap','',#22,#40,$);
/* Units */
#50 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#51 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#52 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#53 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#50,'distance_accuracy_value','');
#54 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#53))
        GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52)) REPRESENTATION_CONTEXT('','3D') );
/* Three identical reps with same name — bit-identical geometry */
#60 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#61 = DIRECTION('',(0.0,0.0,1.0));
#62 = DIRECTION('',(1.0,0.0,0.0));
#63 = AXIS2_PLACEMENT_3D('cap_origin',#60,#61,#62);
#64 = SHAPE_REPRESENTATION('Cap',(#63),#54);
#65 = SHAPE_DEFINITION_REPRESENTATION(#33,#64);
#66 = REPRESENTATION_MAP(#63,#64);
#70 = AXIS2_PLACEMENT_3D('cap_origin',#60,#61,#62);
#71 = SHAPE_REPRESENTATION('Cap',(#70),#54);
#72 = SHAPE_DEFINITION_REPRESENTATION(#37,#71);
#73 = REPRESENTATION_MAP(#70,#71);
#74 = AXIS2_PLACEMENT_3D('cap_origin',#60,#61,#62);
#75 = SHAPE_REPRESENTATION('Cap',(#74),#54);
#76 = SHAPE_DEFINITION_REPRESENTATION(#41,#75);
#77 = REPRESENTATION_MAP(#74,#75);
#80 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#81 = AXIS2_PLACEMENT_3D('a',#80,#61,#62);
#82 = MAPPED_ITEM('I1',#66,#81);
#83 = CARTESIAN_POINT('',(10.0,0.0,0.0));
#84 = AXIS2_PLACEMENT_3D('b',#83,#61,#62);
#85 = MAPPED_ITEM('I2',#73,#84);
#86 = CARTESIAN_POINT('',(20.0,0.0,0.0));
#87 = AXIS2_PLACEMENT_3D('c',#86,#61,#62);
#88 = MAPPED_ITEM('I3',#77,#87);
#90 = AXIS2_PLACEMENT_3D('assy_origin',#60,#61,#62);
#91 = SHAPE_REPRESENTATION('PCB',(#90,#82,#85,#88),#54);
#92 = SHAPE_DEFINITION_REPRESENTATION(#23,#91);
ENDSEC;
END-ISO-10303-21;
