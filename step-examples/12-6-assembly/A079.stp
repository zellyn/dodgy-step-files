ISO-10303-21;
/* A079 - Per-face visibility/transparency ignored by viewer.
 * Defect: one solid; one face has SURFACE_STYLE_TRANSPARENT(0.5)
 * bound via STYLED_ITEM, a different face is referenced by an
 * INVISIBILITY entity. Viewer renders both opaque/visible. */
HEADER;
FILE_DESCRIPTION(('A079 test case','Per-face visibility / transparency ignored by viewer'),'2;1');
FILE_NAME('A079.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('part1','part1','part1',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
/* Two faces of a notional solid */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=PLANE('',#23);
#25=ADVANCED_FACE('transparent_face',(),#24,.T.);
#26=ADVANCED_FACE('invisible_face',(),#24,.T.);
#27=CLOSED_SHELL('shell',(#25,#26));
#28=MANIFOLD_SOLID_BREP('solid',#27);
/* Transparency style binding (0.5) -> STYLED_ITEM on face #25 */
#30=COLOUR_RGB('',1.0,0.0,0.0);
#31=FILL_AREA_STYLE_COLOUR('',#30);
#32=FILL_AREA_STYLE('',(#31));
#33=SURFACE_STYLE_FILL_AREA(#32);
#34=SURFACE_STYLE_TRANSPARENT(0.5);
#35=SURFACE_SIDE_STYLE('',(#33,#34));
#36=SURFACE_STYLE_USAGE(.BOTH.,#35);
#37=PRESENTATION_STYLE_ASSIGNMENT((#36));
#38=STYLED_ITEM('transparency_on_face',(#37),#25);
/* Invisibility on face #26 */
#40=INVISIBILITY((#26));
ENDSEC;
END-ISO-10303-21;
