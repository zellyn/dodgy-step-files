ISO-10303-21;
/*
 * P025 — Body name overwritten by last-operation label on export
 * Defect (FreeCAD #24962; FreeCAD itself, regression late 2025):
 *   STEP write populates PRODUCT.name and NEXT_ASSEMBLY_USAGE_OCCURRENCE.name
 *   from the last operation's label rather than the body's label. Round-trip
 *   loses body names.
 * Reproducer: assembly where each PRODUCT_DEFINITION chain has a name
 *   shadowed by a sub-feature label (e.g. "Pocket" instead of
 *   "MyPart_Body").
 * Expected kernel: stable mapping of body name to STEP product name.
 */
HEADER;
FILE_DESCRIPTION(('P025 PRODUCT.name shows last-operation label instead of body label'),'2;1');
FILE_NAME('P025.stp','2026-04-26T00:00:00',('catalog'),('cad'),'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('automotive design');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT_DEFINITION_CONTEXT('part definition',#10,'design');
/* ASSEMBLY's product name shadowed by "Boolean" — the last op in the tree */
#20 = PRODUCT('Boolean','assy: should have read MyAssy_Top','',(#12));
#21 = PRODUCT_DEFINITION_FORMATION('','',#20);
#22 = PRODUCT_DEFINITION('design','',#21,#13);
#23 = PRODUCT_DEFINITION_SHAPE('','',#22);
/* PART 1: name "Pocket" — should have been "Lid_Body" */
#30 = PRODUCT('Pocket','should be Lid_Body','',(#12));
#31 = PRODUCT_DEFINITION_FORMATION('','',#30);
#32 = PRODUCT_DEFINITION('design','',#31,#13);
#33 = PRODUCT_DEFINITION_SHAPE('','',#32);
/* PART 2: name "Fillet" — should have been "Bracket_Body" */
#34 = PRODUCT('Fillet','should be Bracket_Body','',(#12));
#35 = PRODUCT_DEFINITION_FORMATION('','',#34);
#36 = PRODUCT_DEFINITION('design','',#35,#13);
#37 = PRODUCT_DEFINITION_SHAPE('','',#36);
/* DEFECT: NAUO names also taken from last op */
#40 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','Pocket','',#22,#32,$);
#41 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('2','Fillet','',#22,#36,$);
#50 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#51 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#52 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#53 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#50,'distance_accuracy_value','');
#54 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#53))
        GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52)) REPRESENTATION_CONTEXT('','3D') );
#60 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#61 = DIRECTION('',(0.0,0.0,1.0));
#62 = DIRECTION('',(1.0,0.0,0.0));
#63 = AXIS2_PLACEMENT_3D('lid_origin',#60,#61,#62);
#64 = SHAPE_REPRESENTATION('Pocket_rep',(#63),#54);
#65 = SHAPE_DEFINITION_REPRESENTATION(#33,#64);
#66 = REPRESENTATION_MAP(#63,#64);
#67 = AXIS2_PLACEMENT_3D('bracket_origin',#60,#61,#62);
#68 = SHAPE_REPRESENTATION('Fillet_rep',(#67),#54);
#69 = SHAPE_DEFINITION_REPRESENTATION(#37,#68);
#70 = REPRESENTATION_MAP(#67,#68);
#71 = MAPPED_ITEM('lid_mi',#66,#63);
#72 = MAPPED_ITEM('bracket_mi',#70,#67);
#80 = AXIS2_PLACEMENT_3D('assy_origin',#60,#61,#62);
#81 = SHAPE_REPRESENTATION('Boolean_rep',(#80,#71,#72),#54);
#82 = SHAPE_DEFINITION_REPRESENTATION(#23,#81);
/* Extended catalog notes:
 * This reproducer is a minimal demonstrator of the §12.6 entry
 * referenced in the /* * / header above. The entity-graph above
 * is just enough to exercise the defect on a writer or reader
 * test harness; it is NOT a production-quality assembly.
 *
