ISO-10303-21;
/* A085 - COMPSOLID lost in nonmanifold writes.
 * Defect: two MANIFOLD_SOLID_BREPs whose CLOSED_SHELLs each list the
 * same shared ADVANCED_FACE (#56). On nonmanifold write the shared
 * face appears twice (once per solid) instead of being preserved
 * via NON_MANIFOLD_SURFACE_SHAPE_REPRESENTATION / SHELL_BASED_SURFACE_MODEL. */
HEADER;
FILE_DESCRIPTION(('A085 test case','COMPSOLID lost in nonmanifold writes'),'2;1');
FILE_NAME('A085.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('part1','part1','part1',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
/* Common axis */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
/* Six unique faces for cube A and cube B; one of them (the "shared face"
 * #56) is referenced by both shells. */
#30=PLANE('p_a_top',#23);
#31=PLANE('p_a_bot',#23);
#32=PLANE('p_a_front',#23);
#33=PLANE('p_a_back',#23);
#34=PLANE('p_a_left',#23);
#35=PLANE('shared_plane',#23);
#36=PLANE('p_b_top',#23);
#37=PLANE('p_b_bot',#23);
#38=PLANE('p_b_front',#23);
#39=PLANE('p_b_back',#23);
#40=PLANE('p_b_right',#23);
#50=ADVANCED_FACE('a_top',(),#30,.T.);
#51=ADVANCED_FACE('a_bot',(),#31,.T.);
#52=ADVANCED_FACE('a_front',(),#32,.T.);
#53=ADVANCED_FACE('a_back',(),#33,.T.);
#54=ADVANCED_FACE('a_left',(),#34,.T.);
#56=ADVANCED_FACE('shared_face',(),#35,.T.);
#57=ADVANCED_FACE('b_top',(),#36,.T.);
#58=ADVANCED_FACE('b_bot',(),#37,.T.);
#59=ADVANCED_FACE('b_front',(),#38,.T.);
#60=ADVANCED_FACE('b_back',(),#39,.T.);
#61=ADVANCED_FACE('b_right',(),#40,.T.);
/* Two CLOSED_SHELLs each include the shared face #56 */
#70=CLOSED_SHELL('cube_a_shell',(#50,#51,#52,#53,#54,#56));
#71=CLOSED_SHELL('cube_b_shell',(#56,#57,#58,#59,#60,#61));
#80=MANIFOLD_SOLID_BREP('cube_a',#70);
#81=MANIFOLD_SOLID_BREP('cube_b',#71);
ENDSEC;
END-ISO-10303-21;
