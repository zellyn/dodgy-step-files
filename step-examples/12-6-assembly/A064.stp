ISO-10303-21;
/* A064 - Subshape names not transferred on STEP import.
 * Defect: a solid carries six face-level STYLED_ITEMs with names
 * top/bottom/left/right/front/back; reader records only the top
 * PRODUCT_DEFINITION name and drops per-face names. */
HEADER;
FILE_DESCRIPTION(('A064 test case','Subshape names not transferred on STEP import'),'2;1');
FILE_NAME('A064.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('cube_part','cube_part','',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
/* Six unit-cube face surfaces (analytic planes) sharing one axis system */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#30=PLANE('top_plane',#23);
#31=PLANE('bottom_plane',#23);
#32=PLANE('left_plane',#23);
#33=PLANE('right_plane',#23);
#34=PLANE('front_plane',#23);
#35=PLANE('back_plane',#23);
/* Empty-loop ADVANCED_FACEs - schematic six-face cube */
#40=EDGE_LOOP('',());
#41=FACE_OUTER_BOUND('',#40,.T.);
#50=ADVANCED_FACE('top',(#41),#30,.T.);
#51=ADVANCED_FACE('bottom',(#41),#31,.T.);
#52=ADVANCED_FACE('left',(#41),#32,.T.);
#53=ADVANCED_FACE('right',(#41),#33,.T.);
#54=ADVANCED_FACE('front',(#41),#34,.T.);
#55=ADVANCED_FACE('back',(#41),#35,.T.);
#60=CLOSED_SHELL('cube_shell',(#50,#51,#52,#53,#54,#55));
#61=MANIFOLD_SOLID_BREP('cube_solid',#60);
/* Six per-face styled-items naming the faces - the writer side
 * of this defect emits these; the reader-side defect drops them */
#70=COLOUR_RGB('',1.0,1.0,1.0);
#71=FILL_AREA_STYLE_COLOUR('',#70);
#72=FILL_AREA_STYLE('',(#71));
#73=SURFACE_STYLE_FILL_AREA(#72);
#74=SURFACE_SIDE_STYLE('',(#73));
#75=SURFACE_STYLE_USAGE(.BOTH.,#74);
#76=PRESENTATION_STYLE_ASSIGNMENT((#75));
#80=STYLED_ITEM('top',(#76),#50);
#81=STYLED_ITEM('bottom',(#76),#51);
#82=STYLED_ITEM('left',(#76),#52);
#83=STYLED_ITEM('right',(#76),#53);
#84=STYLED_ITEM('front',(#76),#54);
#85=STYLED_ITEM('back',(#76),#55);
#90=PRESENTATION_LAYER_ASSIGNMENT('cube_layer','',(#50,#51,#52,#53,#54,#55));
ENDSEC;
END-ISO-10303-21;
