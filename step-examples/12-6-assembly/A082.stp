ISO-10303-21;
/* A082 - Big-path STEP write fails with name >150 characters
 * Defect: writer with 200-character output filename; internal buffer is 150 characters */
HEADER;
FILE_DESCRIPTION(('A082 test case','Big-path STEP write fails with name >150 characters'),'2;1');
FILE_NAME('A082.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('part1','part1','part1',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
/* Path-length defect - test via runtime invocation, not file content */

ENDSEC;
END-ISO-10303-21;
