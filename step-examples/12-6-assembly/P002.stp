ISO-10303-21;
/* P002: NAUO name field carries \X2\ STEP-21 Unicode escapes for Chinese '海绵2'; additional PRODUCT entity uses raw Unicode (multi-byte UTF-8) to simulate GB18030 locale bytes written without \X2\ escaping; readers assuming UTF-8 pass-through produce mojibake in object labels; round-trip corrupts project document; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('P002'),'2;1');
FILE_NAME('P002.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
