ISO-10303-21;
/* A118: NAUO + SRR wired through a real CDSR, SRR direction OPPOSITE to NAUO */
/* DEFECT: CheckSRRReversesNAUO detects the reversal; TransferEntity(NAUO) warns */
/* 'SRR reverses relation defined by NAUO; NAUO definition is taken' and silently */
/* resolves via NAUO's direction instead of rejecting the file -- both Parent/Child */
/* carry real, distinguishable geometry (unlike M062's empty-items curve-set orphan) */
HEADER;
FILE_DESCRIPTION(('A118: SRR reverses NAUO direction, wired through a real CDSR'),'2;1');
FILE_NAME('A118.stp','2026-07-12T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#100=APPLICATION_CONTEXT('mechanical design');
#101=(GEOMETRIC_REPRESENTATION_CONTEXT(3)REPRESENTATION_CONTEXT('','3D'));
/* ---- Parent product: small 1x1 marker face at the origin ---- */
#1=CARTESIAN_POINT('',(0.0,0.0,0.0));
#2=DIRECTION('',(0.0,0.0,1.0));
#3=DIRECTION('',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('',#1,#2,#3);
#5=PLANE('',#4);
#6=CARTESIAN_POINT('',(0.0,0.0,0.0));
#7=CARTESIAN_POINT('',(1.0,0.0,0.0));
#8=CARTESIAN_POINT('',(1.0,1.0,0.0));
#9=CARTESIAN_POINT('',(0.0,1.0,0.0));
#10=VERTEX_POINT('',#6);
#11=VERTEX_POINT('',#7);
#12=VERTEX_POINT('',#8);
#13=VERTEX_POINT('',#9);
#14=DIRECTION('',(1.0,0.0,0.0));
#15=VECTOR('',#14,1.0);
#16=LINE('',#6,#15);
#17=EDGE_CURVE('',#10,#11,#16,.T.);
#18=DIRECTION('',(0.0,1.0,0.0));
#19=VECTOR('',#18,1.0);
#20=LINE('',#7,#19);
#21=EDGE_CURVE('',#11,#12,#20,.T.);
#22=DIRECTION('',(-1.0,0.0,0.0));
#23=VECTOR('',#22,1.0);
#24=LINE('',#8,#23);
#25=EDGE_CURVE('',#12,#13,#24,.T.);
#26=DIRECTION('',(0.0,-1.0,0.0));
#27=VECTOR('',#26,1.0);
#28=LINE('',#9,#27);
#29=EDGE_CURVE('',#13,#10,#28,.T.);
#30=ORIENTED_EDGE('',$,$,#17,.T.);
#31=ORIENTED_EDGE('',$,$,#21,.T.);
#32=ORIENTED_EDGE('',$,$,#25,.T.);
#33=ORIENTED_EDGE('',$,$,#29,.T.);
#34=EDGE_LOOP('',(#30,#31,#32,#33));
#35=FACE_OUTER_BOUND('',#34,.T.);
#36=ADVANCED_FACE('',(#35),#5,.T.);
#37=OPEN_SHELL('',(#36));
#38=SHELL_BASED_SURFACE_MODEL('',(#37));
#39=SHAPE_REPRESENTATION('parent_rep',(#38),#101);
#40=PRODUCT_CONTEXT('',#100,'mechanical');
#41=PRODUCT('Parent','Parent','',(#40));
#42=PRODUCT_DEFINITION_FORMATION('','',#41);
#43=PRODUCT_DEFINITION_CONTEXT('part definition',#100,'design');
#44=PRODUCT_DEFINITION('','',#42,#43);
#45=PRODUCT_DEFINITION_SHAPE('','',#44);
#46=SHAPE_DEFINITION_REPRESENTATION(#45,#39);
/* ---- Child product: bigger 5x5 marker face at (100,0,0) ---- */
#50=CARTESIAN_POINT('',(100.0,0.0,0.0));
#51=AXIS2_PLACEMENT_3D('',#50,#2,#3);
#52=PLANE('',#51);
#53=CARTESIAN_POINT('',(100.0,0.0,0.0));
#54=CARTESIAN_POINT('',(105.0,0.0,0.0));
#55=CARTESIAN_POINT('',(105.0,5.0,0.0));
#56=CARTESIAN_POINT('',(100.0,5.0,0.0));
#57=VERTEX_POINT('',#53);
#58=VERTEX_POINT('',#54);
#59=VERTEX_POINT('',#55);
#60=VERTEX_POINT('',#56);
#61=VECTOR('',#14,5.0);
#62=LINE('',#53,#61);
#63=EDGE_CURVE('',#57,#58,#62,.T.);
#64=VECTOR('',#18,5.0);
#65=LINE('',#54,#64);
#66=EDGE_CURVE('',#58,#59,#65,.T.);
#67=VECTOR('',#22,5.0);
#68=LINE('',#55,#67);
#69=EDGE_CURVE('',#59,#60,#68,.T.);
#70=VECTOR('',#26,5.0);
#71=LINE('',#56,#70);
#72=EDGE_CURVE('',#60,#57,#71,.T.);
#73=ORIENTED_EDGE('',$,$,#63,.T.);
#74=ORIENTED_EDGE('',$,$,#66,.T.);
#75=ORIENTED_EDGE('',$,$,#69,.T.);
#76=ORIENTED_EDGE('',$,$,#72,.T.);
#77=EDGE_LOOP('',(#73,#74,#75,#76));
#78=FACE_OUTER_BOUND('',#77,.T.);
#79=ADVANCED_FACE('',(#78),#52,.T.);
#80=OPEN_SHELL('',(#79));
#81=SHELL_BASED_SURFACE_MODEL('',(#80));
#82=SHAPE_REPRESENTATION('child_rep',(#81),#101);
#83=PRODUCT_CONTEXT('',#100,'mechanical');
#84=PRODUCT('Child','Child','',(#83));
#85=PRODUCT_DEFINITION_FORMATION('','',#84);
#86=PRODUCT_DEFINITION('','',#85,#43);
#87=PRODUCT_DEFINITION_SHAPE('','',#86);
#88=SHAPE_DEFINITION_REPRESENTATION(#87,#82);
/* ---- NAUO: Parent(#44) relating (parent), Child(#86) related (child) ---- */
#90=NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','','uses',#44,#86,$);
#91=PRODUCT_DEFINITION_SHAPE('Placement','Placement of an item',#90);
/* DEFECT: SRR wired OPPOSITE the NAUO direction -- Rep1=parent_rep(#39), Rep2=child_rep(#82); */
/* OCCT's own writer convention (STEPConstruct_Assembly::MakeRelationship) always emits */
/* Rep1=child,Rep2=parent for this NAUO direction -- this file swaps them. */
#92=SHAPE_REPRESENTATION_RELATIONSHIP('rel','',#39,#82);
#93=CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#92,#91);
ENDSEC;
END-ISO-10303-21;
