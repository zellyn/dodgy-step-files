ISO-10303-21;
/* A087 - STEP exporter loses shapes after import-export cycle.
 * Defect: document holding one MANIFOLD_SOLID_BREP plus one isolated
 * ADVANCED_FACE - both reachable through the document's PRODUCT chain.
 * Exporter walks only the "main" representation; the isolated face is
 * dropped on re-export. */
HEADER;
FILE_DESCRIPTION(('A087 test case','Exporter loses shapes after import-export cycle'),'2;1');
FILE_NAME('A087.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('part1','part1','part1',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
/* Common axis */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
/* The solid (a single-face placeholder shell) */
#30=PLANE('solid_face_plane',#23);
#31=ADVANCED_FACE('solid_face',(),#30,.T.);
#32=CLOSED_SHELL('shell',(#31));
#33=MANIFOLD_SOLID_BREP('main_solid',#32);
/* The "isolated" face - top-level, not part of any shell or solid */
#40=PLANE('isolated_face_plane',#23);
#41=ADVANCED_FACE('isolated_face',(),#40,.T.);
/* Both at top level via SHAPE_REPRESENTATION */
#50=SHAPE_REPRESENTATION('main_rep',(#33,#41),#1);
#51=SHAPE_DEFINITION_REPRESENTATION(#15,#50);
ENDSEC;
END-ISO-10303-21;
