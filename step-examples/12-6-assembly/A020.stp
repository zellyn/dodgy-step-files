ISO-10303-21;
/*
 * A020 — Bare STYLED_ITEM at top level (no MDGPR / DRAUGHTING_MODEL parent)
 * Defect (OCCT ec661e4 / Mantis 0024159, NULL STYLED_ITEM.item, PSA NULL handle):
 *   Inventor 2014 emits STYLED_ITEM entities not parented under
 *   MECHANICAL_DESIGN_GEOMETRIC_PRESENTATION_REPRESENTATION or
 *   DRAUGHTING_MODEL; older readers skipped them, dropping all colors.
 *   Variant: STYLED_ITEM.item is NULL or its PSA.styles set has NULL elements.
 * Expected kernel: accept bare styled items; null-check PSA styles; skip
 *   NULL silently.
 */
HEADER;
FILE_DESCRIPTION(('A020 bare STYLED_ITEM at top + PSA with NULL style member'),'2;1');
FILE_NAME('A020.stp','2026-04-26T00:00:00',('catalog'),('cad'),'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('automotive design');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT_DEFINITION_CONTEXT('part definition',#10,'design');
#20 = PRODUCT('A020_PART','part with bare styled_item','',(#12));
#21 = PRODUCT_DEFINITION_FORMATION('','',#20);
#22 = PRODUCT_DEFINITION('design','',#21,#13);
#23 = PRODUCT_DEFINITION_SHAPE('','',#22);
#50 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#51 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#52 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#53 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#50,'distance_accuracy_value','');
#54 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#53))
        GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52)) REPRESENTATION_CONTEXT('','3D') );
#60 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#61 = DIRECTION('',(0.0,0.0,1.0));
#62 = DIRECTION('',(1.0,0.0,0.0));
#63 = AXIS2_PLACEMENT_3D('part_origin',#60,#61,#62);
#64 = PLANE('',#63);
#65 = ADVANCED_FACE('face',(),#64,.T.);
#66 = SHAPE_REPRESENTATION('part_rep',(#63,#65),#54);
#67 = SHAPE_DEFINITION_REPRESENTATION(#23,#66);
/* Color setup */
#80 = COLOUR_RGB('orange',0.9,0.5,0.0);
#81 = FILL_AREA_STYLE_COLOUR('',#80);
#82 = FILL_AREA_STYLE('',(#81));
#83 = SURFACE_STYLE_FILL_AREA(#82);
#84 = SURFACE_SIDE_STYLE('',(#83));
#85 = SURFACE_STYLE_USAGE(.BOTH.,#84);
/* DEFECT 1: PSA whose styles set contains a NULL entry. */
#86 = PRESENTATION_STYLE_ASSIGNMENT((#85,$));
/* DEFECT 2: bare STYLED_ITEM, NOT wrapped in any MDGPR or DRAUGHTING_MODEL. */
#87 = STYLED_ITEM('bare_at_top',(#86),#65);
/* DEFECT 3: STYLED_ITEM whose item is NULL. */
#88 = STYLED_ITEM('null_item',(#86),$);
ENDSEC;
END-ISO-10303-21;
