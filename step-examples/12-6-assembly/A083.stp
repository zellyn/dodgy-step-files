ISO-10303-21;
/* A083 - Exporter generates B-spline approximation with C0 isolines.
 * Defect: a face on a SURFACE_OF_REVOLUTION of a parabolic profile around
 * the Z axis; the exporter fallback emits a B-spline with C0 along
 * control-point rows. The fixture encodes the input that triggers this. */
HEADER;
FILE_DESCRIPTION(('A083 test case','Exporter emits C0-isoline B-spline for revolution'),'2;1');
FILE_NAME('A083.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('part1','part1','part1',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
/* Z axis for revolution */
#100=CARTESIAN_POINT('axis_origin',(0.0,0.0,0.0));
#101=DIRECTION('axis_z',(0.0,0.0,1.0));
#102=AXIS1_PLACEMENT('rev_axis',#100,#101);
/* B-spline profile approximating y = x^2 (parabola) in the XZ plane.
 * Five control points; degree 2; clamped knot vector. */
#110=CARTESIAN_POINT('p0',(1.0,0.0,0.0));
#111=CARTESIAN_POINT('p1',(1.5,0.0,0.5));
#112=CARTESIAN_POINT('p2',(2.0,0.0,1.0));
#113=CARTESIAN_POINT('p3',(2.5,0.0,2.25));
#114=CARTESIAN_POINT('p4',(3.0,0.0,4.0));
#120=B_SPLINE_CURVE_WITH_KNOTS('parabolic_profile',2,(#110,#111,#112,#113,#114),
       .UNSPECIFIED.,.F.,.F.,(3,1,3),(0.0,0.5,1.0),.UNSPECIFIED.);
/* Surface of revolution sweeping the parabolic profile around Z */
#130=SURFACE_OF_REVOLUTION('parabolic_revolution',#120,#102);
/* Face on the revolved surface */
#140=ADVANCED_FACE('parabolic_face',(),#130,.T.);
ENDSEC;
END-ISO-10303-21;
