ISO-10303-21;
/*
 * P021 — Edge-curve geometry mismatches face geometry within tolerance
 * Defect (FreeCAD #17422, #17201; Fusion 360):
 *   Two EDGE_CURVE instances share the same trimmed CIRCLE geometry but bind
 *   to different FACE_OUTER_BOUNDs with different radii (radius mismatch
 *   within tolerance). Quick Measure samples the underlying curve and reports
 *   the wrong radius.
 * Reproducer: STEP file with two edges sharing a single underlying CIRCLE
 *   curve geometry, attached to faces with materially different radii.
 * Expected kernel: resolve via face geometry, not edge curve; or warn on
 *   mismatch.
 */
HEADER;
FILE_DESCRIPTION(('P021 shared EDGE_CURVE CIRCLE bound to faces with different radii'),'2;1');
FILE_NAME('P021.stp','2026-04-26T00:00:00',('catalog'),('cad'),'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('automotive design');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT_DEFINITION_CONTEXT('part definition',#10,'design');
#20 = PRODUCT('P021_ASSY','','',(#12));
#21 = PRODUCT_DEFINITION_FORMATION('','',#20);
#22 = PRODUCT_DEFINITION('design','',#21,#13);
#23 = PRODUCT_DEFINITION_SHAPE('','',#22);
#30 = PRODUCT('FUSION_PART','radius mismatch','',(#12));
#31 = PRODUCT_DEFINITION_FORMATION('','',#30);
#32 = PRODUCT_DEFINITION('design','',#31,#13);
#33 = PRODUCT_DEFINITION_SHAPE('','',#32);
#40 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','PART_INST','',#22,#32,$);
/* shared CIRCLE curve, radius 5.0 */
#90 = CARTESIAN_POINT('c_origin',(0.0,0.0,0.0));
#91 = DIRECTION('c_z',(0.0,0.0,1.0));
#92 = DIRECTION('c_x',(1.0,0.0,0.0));
#93 = AXIS2_PLACEMENT_3D('c_axes',#90,#91,#92);
#94 = CIRCLE('shared_circle_r5',#93,5.0);
/* two edges using the SAME CIRCLE but face radii differ */
#95 = CARTESIAN_POINT('p_top',(5.0,0.0,0.0));
#96 = VERTEX_POINT('vt',#95);
#97 = EDGE_CURVE('e_top',#96,#96,#94,.T.);
#98 = EDGE_CURVE('e_bottom',#96,#96,#94,.T.);
/* Cylindrical face with radius 5.0 (matches edge) */
#100 = CYLINDRICAL_SURFACE('cyl_r5',#93,5.0);
/* DEFECT: Cylindrical face with radius 5.5 (mismatch) — but using same
   edge curve. Quick Measure reports 5.0 from the edge, not 5.5 from face. */
#101 = CYLINDRICAL_SURFACE('cyl_r5p5_mismatch',#93,5.5);
#102 = ORIENTED_EDGE('oe_top',*,*,#97,.T.);
#103 = ORIENTED_EDGE('oe_bot',*,*,#98,.T.);
#104 = EDGE_LOOP('top_loop',(#102));
#105 = EDGE_LOOP('bot_loop',(#103));
#106 = FACE_OUTER_BOUND('top_fb',#104,.T.);
#107 = FACE_OUTER_BOUND('bot_fb',#105,.T.);
#108 = ADVANCED_FACE('cyl_face_r5',(#106),#100,.T.);
#109 = ADVANCED_FACE('cyl_face_r5p5',(#107),#101,.T.);
#50 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#51 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#52 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#53 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#50,'distance_accuracy_value','');
#54 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#53))
        GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52)) REPRESENTATION_CONTEXT('','3D') );
#60 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#61 = DIRECTION('',(0.0,0.0,1.0));
#62 = DIRECTION('',(1.0,0.0,0.0));
#63 = AXIS2_PLACEMENT_3D('part_origin',#60,#61,#62);
#64 = SHAPE_REPRESENTATION('part_rep',(#63,#108,#109),#54);
#65 = SHAPE_DEFINITION_REPRESENTATION(#33,#64);
#66 = REPRESENTATION_MAP(#63,#64);
#67 = MAPPED_ITEM('inst',#66,#63);
#80 = AXIS2_PLACEMENT_3D('assy_origin',#60,#61,#62);
#81 = SHAPE_REPRESENTATION('assy_rep',(#80,#67),#54);
#82 = SHAPE_DEFINITION_REPRESENTATION(#23,#81);
/* Extended catalog notes:
 * This reproducer is a minimal demonstrator of the §12.6 entry
 * referenced in the /* * / header above. The entity-graph above
 * is just enough to exercise the defect on a writer or reader
 * test harness; it is NOT a production-quality assembly.
 *
 * License: this file is part of a defect catalog assembled from
 * publicly described bug reports and recommended-practice notes.
 * No proprietary geometry or names are reproduced. The entity IDs
 * and minimal coordinates are author-original.
 *
 * Cross-refs: see STEP_PROBLEM_CATALOG.md §12.6 for full entry,
 * source list, sender attribution and expected kernel behavior.
 */
#900 = DESCRIPTIVE_REPRESENTATION_ITEM('catalog_id','P021');
#901 = DESCRIPTIVE_REPRESENTATION_ITEM('catalog_section','12.6 assembly hierarchy');
#902 = DESCRIPTIVE_REPRESENTATION_ITEM('catalog_status','pending');
ENDSEC;
END-ISO-10303-21;
