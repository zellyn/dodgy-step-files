ISO-10303-21;
/* A067 - Baking placements into geometry breaks shared-subshape sharing.
 * Defect: a compound contains 3 instances of the SAME 10x10x10 cube
 * MANIFOLD_SOLID_BREP via 3 distinct AXIS2_PLACEMENT_3D translations
 * (origin (0,0,0), (20,0,0), (40,0,0)) using REPRESENTATION_MAP /
 * MAPPED_ITEM. The shared sub-shape exists exactly once in the file;
 * a "baking" pass that flattens placements would duplicate the cube
 * three times, losing topology sharing and inflating the model. */
HEADER;
FILE_DESCRIPTION(('A067 test case','RemoveLocations duplicates shared geometry'),'2;1');
FILE_NAME('A067.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('A067','A067','shared_cube_part',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
#16=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#17=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#18=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#19=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#16,'distance_accuracy_value','');
#20=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#19))GLOBAL_UNIT_ASSIGNED_CONTEXT((#16,#17,#18))REPRESENTATION_CONTEXT('','3D'));
/* Single shared 10x10x10 cube body. */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=CARTESIAN_POINT('',(10.0,0.0,0.0));
#102=CARTESIAN_POINT('',(10.0,10.0,0.0));
#103=CARTESIAN_POINT('',(0.0,10.0,0.0));
#104=CARTESIAN_POINT('',(0.0,0.0,10.0));
#105=CARTESIAN_POINT('',(10.0,0.0,10.0));
#106=CARTESIAN_POINT('',(10.0,10.0,10.0));
#107=CARTESIAN_POINT('',(0.0,10.0,10.0));
#110=VERTEX_POINT('',#100); #111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102); #113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104); #115=VERTEX_POINT('',#105);
#116=VERTEX_POINT('',#106); #117=VERTEX_POINT('',#107);
#200=DIRECTION('',(0.0,0.0,1.0)); #201=DIRECTION('',(1.0,0.0,0.0));
#202=DIRECTION('',(0.0,0.0,-1.0));
#203=DIRECTION('',(0.0,-1.0,0.0)); #204=DIRECTION('',(0.0,1.0,0.0));
#205=DIRECTION('',(-1.0,0.0,0.0)); #206=DIRECTION('',(1.0,0.0,0.0));
#210=CARTESIAN_POINT('',(5.0,5.0,0.0));
#211=AXIS2_PLACEMENT_3D('',#210,#202,#201); #212=PLANE('',#211);
#220=CARTESIAN_POINT('',(5.0,5.0,10.0));
#221=AXIS2_PLACEMENT_3D('',#220,#200,#201); #222=PLANE('',#221);
#230=CARTESIAN_POINT('',(5.0,0.0,5.0));
#231=AXIS2_PLACEMENT_3D('',#230,#203,#201); #232=PLANE('',#231);
#240=CARTESIAN_POINT('',(5.0,10.0,5.0));
#241=AXIS2_PLACEMENT_3D('',#240,#204,#201); #242=PLANE('',#241);
#250=CARTESIAN_POINT('',(0.0,5.0,5.0));
#251=AXIS2_PLACEMENT_3D('',#250,#205,#204); #252=PLANE('',#251);
#260=CARTESIAN_POINT('',(10.0,5.0,5.0));
#261=AXIS2_PLACEMENT_3D('',#260,#206,#204); #262=PLANE('',#261);
#300=DIRECTION('',(1.0,0.0,0.0)); #301=VECTOR('',#300,10.0);
#302=DIRECTION('',(0.0,1.0,0.0)); #303=VECTOR('',#302,10.0);
#304=DIRECTION('',(0.0,0.0,1.0)); #305=VECTOR('',#304,10.0);
#310=LINE('',#100,#301); #311=EDGE_CURVE('',#110,#111,#310,.T.);
#312=LINE('',#101,#303); #313=EDGE_CURVE('',#111,#112,#312,.T.);
#314=LINE('',#103,#301); #315=EDGE_CURVE('',#113,#112,#314,.T.);
#316=LINE('',#100,#303); #317=EDGE_CURVE('',#110,#113,#316,.T.);
#318=LINE('',#104,#301); #319=EDGE_CURVE('',#114,#115,#318,.T.);
#320=LINE('',#105,#303); #321=EDGE_CURVE('',#115,#116,#320,.T.);
#322=LINE('',#107,#301); #323=EDGE_CURVE('',#117,#116,#322,.T.);
#324=LINE('',#104,#303); #325=EDGE_CURVE('',#114,#117,#324,.T.);
#326=LINE('',#100,#305); #327=EDGE_CURVE('',#110,#114,#326,.T.);
#328=LINE('',#101,#305); #329=EDGE_CURVE('',#111,#115,#328,.T.);
#330=LINE('',#102,#305); #331=EDGE_CURVE('',#112,#116,#330,.T.);
#332=LINE('',#103,#305); #333=EDGE_CURVE('',#113,#117,#332,.T.);
#400=ORIENTED_EDGE('',*,*,#311,.T.); #401=ORIENTED_EDGE('',*,*,#313,.T.);
#402=ORIENTED_EDGE('',*,*,#315,.F.); #403=ORIENTED_EDGE('',*,*,#317,.F.);
#404=EDGE_LOOP('',(#400,#401,#402,#403));
#405=FACE_OUTER_BOUND('',#404,.T.);
#406=ADVANCED_FACE('bot',(#405),#212,.T.);
#410=ORIENTED_EDGE('',*,*,#319,.T.); #411=ORIENTED_EDGE('',*,*,#321,.T.);
#412=ORIENTED_EDGE('',*,*,#323,.F.); #413=ORIENTED_EDGE('',*,*,#325,.F.);
#414=EDGE_LOOP('',(#410,#411,#412,#413));
#415=FACE_OUTER_BOUND('',#414,.T.);
#416=ADVANCED_FACE('top',(#415),#222,.T.);
#420=ORIENTED_EDGE('',*,*,#311,.T.); #421=ORIENTED_EDGE('',*,*,#329,.T.);
#422=ORIENTED_EDGE('',*,*,#319,.F.); #423=ORIENTED_EDGE('',*,*,#327,.F.);
#424=EDGE_LOOP('',(#420,#421,#422,#423));
#425=FACE_OUTER_BOUND('',#424,.T.);
#426=ADVANCED_FACE('front',(#425),#232,.T.);
#430=ORIENTED_EDGE('',*,*,#315,.T.); #431=ORIENTED_EDGE('',*,*,#331,.T.);
#432=ORIENTED_EDGE('',*,*,#323,.F.); #433=ORIENTED_EDGE('',*,*,#333,.F.);
#434=EDGE_LOOP('',(#430,#431,#432,#433));
#435=FACE_OUTER_BOUND('',#434,.T.);
#436=ADVANCED_FACE('back',(#435),#242,.T.);
#440=ORIENTED_EDGE('',*,*,#317,.T.); #441=ORIENTED_EDGE('',*,*,#333,.T.);
#442=ORIENTED_EDGE('',*,*,#325,.F.); #443=ORIENTED_EDGE('',*,*,#327,.F.);
#444=EDGE_LOOP('',(#440,#441,#442,#443));
#445=FACE_OUTER_BOUND('',#444,.T.);
#446=ADVANCED_FACE('left',(#445),#252,.T.);
#450=ORIENTED_EDGE('',*,*,#313,.T.); #451=ORIENTED_EDGE('',*,*,#331,.T.);
#452=ORIENTED_EDGE('',*,*,#321,.F.); #453=ORIENTED_EDGE('',*,*,#329,.F.);
#454=EDGE_LOOP('',(#450,#451,#452,#453));
#455=FACE_OUTER_BOUND('',#454,.T.);
#456=ADVANCED_FACE('right',(#455),#262,.T.);
#500=CLOSED_SHELL('cube_skin',(#406,#416,#426,#436,#446,#456));
#501=MANIFOLD_SOLID_BREP('shared_cube_body',#500);
/* Local origin used by REPRESENTATION_MAP. */
#502=CARTESIAN_POINT('local_origin',(0.0,0.0,0.0));
#503=AXIS2_PLACEMENT_3D('local_axis',#502,#200,#201);
/* SHAPE_REPRESENTATION holding the canonical cube body. */
#510=SHAPE_REPRESENTATION('shared_cube_rep',(#503,#501),#20);
#520=REPRESENTATION_MAP(#503,#510);
/* 3 distinct placements for 3 instances. */
#600=CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#601=AXIS2_PLACEMENT_3D('inst1_axis',#600,#200,#201);
#610=CARTESIAN_POINT('p2',(20.0,0.0,0.0));
#611=AXIS2_PLACEMENT_3D('inst2_axis',#610,#200,#201);
#620=CARTESIAN_POINT('p3',(40.0,0.0,0.0));
#621=AXIS2_PLACEMENT_3D('inst3_axis',#620,#200,#201);
/* 3 MAPPED_ITEMs — all reference the SAME REPRESENTATION_MAP / cube body. */
#700=MAPPED_ITEM('inst1',#520,#601);
#701=MAPPED_ITEM('inst2',#520,#611);
#702=MAPPED_ITEM('inst3',#520,#621);
#800=AXIS2_PLACEMENT_3D('top_axis',#600,#200,#201);
#801=SHAPE_REPRESENTATION('compound_rep',(#800,#700,#701,#702),#20);
#802=SHAPE_DEFINITION_REPRESENTATION(#15,#801);
ENDSEC;
END-ISO-10303-21;
