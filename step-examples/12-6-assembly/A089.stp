ISO-10303-21;
/* A089 - Sub-shape names lost in non-manifold STEP output.
 * Defect: document with two named ADVANCED_FACEs ('inlet' and 'outlet')
 * each carrying a STYLED_ITEM with the face label as its name. The
 * non-manifold writer skips the styled-item / name-emission code,
 * so the face names are absent from the output. */
HEADER;
FILE_DESCRIPTION(('A089 test case','Sub-shape names lost in non-manifold STEP output'),'2;1');
FILE_NAME('A089.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('part1','part1','part1',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
/* Geometry primitives */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=PLANE('inlet_surface',#23);
#25=PLANE('outlet_surface',#23);
/* Two named ADVANCED_FACE entities (face-level, not vertex-level) */
#30=ADVANCED_FACE('inlet',(),#24,.T.);
#31=ADVANCED_FACE('outlet',(),#25,.T.);
/* Style binding the names via STYLED_ITEM */
#40=COLOUR_RGB('',1.0,1.0,1.0);
#41=FILL_AREA_STYLE_COLOUR('',#40);
#42=FILL_AREA_STYLE('',(#41));
#43=SURFACE_STYLE_FILL_AREA(#42);
#44=SURFACE_SIDE_STYLE('',(#43));
#45=SURFACE_STYLE_USAGE(.BOTH.,#44);
#46=PRESENTATION_STYLE_ASSIGNMENT((#45));
#50=STYLED_ITEM('inlet',(#46),#30);
#51=STYLED_ITEM('outlet',(#46),#31);
ENDSEC;
END-ISO-10303-21;
