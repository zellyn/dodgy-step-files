ISO-10303-21;
/* A065 - Empty AppliedGroupAssignment crashes writer.
 * Defect: an APPLIED_GROUP_ASSIGNMENT with an empty members aggregate
 * causes the writer's emitter (which requires >=1 member) to throw.
 * Empty groups are legitimate placeholders and should not crash. */
HEADER;
FILE_DESCRIPTION(('A065 test case','Empty AppliedGroupAssignment crashes writer'),'2;1');
FILE_NAME('A065.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('part1','part1','part1',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
#100=GROUP('empty_group','no members','');
/* Literal APPLIED_GROUP_ASSIGNMENT with empty members aggregate.
 * The () in the second slot is the load-bearing defect - emitter
 * iterates members and fails on empty list. */
#101=APPLIED_GROUP_ASSIGNMENT(#100,());
ENDSEC;
END-ISO-10303-21;
