ISO-10303-21;
/* A095 - STEP export of part with sub-mm fillet generates malformed shape on receiver
 * Defect: writer's emission precision (1e-6) is too coarse for a 0.05mm fillet on a
 * 10mm part — the fillet's distinct vertex coordinates collapse to the same point. */
HEADER;
FILE_DESCRIPTION(('A095 - sub-mm fillet collapses at writer precision'),'2;1');
FILE_NAME('A095.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Two vertices that ARE distinct in the source (a 0.05mm-radius fillet) but
   collapse to the same coordinate at writer's 1e-6 precision. */
#10=CARTESIAN_POINT('v1',(0.0000005,0.0,0.0));
#11=CARTESIAN_POINT('v2',(0.0000004,0.0,0.0));
#12=DIRECTION('',(0.0,0.0,1.0));
#13=DIRECTION('',(1.0,0.0,0.0));
#14=AXIS2_PLACEMENT_3D('fillet_axis',#10,#12,#13);
#15=CYLINDRICAL_SURFACE('tiny_fillet',#14,0.00005);
#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
#30=DIRECTION('',(1.0,0.0,0.0));
#31=VECTOR('',#30,0.0001);
#32=LINE('fillet_edge',#10,#31);
#33=EDGE_CURVE('collapse_edge',#20,#21,#32,.T.);
#40=ADVANCED_FACE('fillet_face',(),#15,.T.);
/* Assembly wiring so this fixture is a representative §12.6 entry. */
#50=PRODUCT_CONTEXT('',#1,'mechanical');
#51=PRODUCT('A095_round_part','sub-mm fillet','',(#50));
#52=PRODUCT_DEFINITION_FORMATION('','',#51);
#53=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#54=PRODUCT_DEFINITION('design','',#52,#53);
#55=NEXT_ASSEMBLY_USAGE_OCCURRENCE('inst','round_part_inst','',#54,#54,$);
ENDSEC;
END-ISO-10303-21;
