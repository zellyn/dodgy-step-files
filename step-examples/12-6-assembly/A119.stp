ISO-10303-21;
/* A119: MAPPED_ITEM with resolvable REPRESENTATION_MAP but unrecognized-type mapping_target */
/* DEFECT: mapping_target (#44) is a plain CARTESIAN_POINT -- neither a */
/* CartesianTransformationOperator3d nor an Axis2Placement3d -- 'case not recognized, */
/* location ignored' fires, but the mapped shape (via the REAL, resolvable */
/* REPRESENTATION_MAP) still loads, un-positioned, rather than being dropped */
HEADER;
FILE_DESCRIPTION(('A119: MAPPED_ITEM unrecognized-type mapping_target, shape still loads'),'2;1');
FILE_NAME('A119.stp','2026-07-12T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
