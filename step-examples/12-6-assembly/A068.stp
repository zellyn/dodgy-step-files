ISO-10303-21;
/* A068 - Root colour not exported
 * Defect: XCAF document with a colour at root label; writer iterates child labels but never visits root */
HEADER;
FILE_DESCRIPTION(('A068 test case','Root colour not exported'),'2;1');
FILE_NAME('A068.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('part1','part1','part1',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
#100=COLOUR_RGB('',1.0,0.0,0.0);
#101=FILL_AREA_STYLE_COLOUR('root_red',#100);
#102=PRESENTATION_STYLE_ASSIGNMENT((#101));
#103=STYLED_ITEM('root_styled',(#102),#11);

ENDSEC;
END-ISO-10303-21;
