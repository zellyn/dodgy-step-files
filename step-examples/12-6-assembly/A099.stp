ISO-10303-21;
/* A099 - PartDesign Body export omits last-feature operation.
 * Defect (FreeCAD #25567): the visible Tip is a Pocket but the writer
 * emits the body without it. On disk: the MANIFOLD_SOLID_BREP has only
 * the pre-Pocket geometry. We model this as a 7-face cube + fillet body
 * that lacks the inner pocket walls/floor that a "tip-applied" body
 * would carry. */
HEADER;
FILE_DESCRIPTION(('A099 - body missing last-feature pocket walls'),'2;1');
FILE_NAME('A099.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('A099_pre_tip','exported one feature behind tip','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
/* Six advanced faces -- a cube with no pocket. The tip the user authored
   was a Pocket; this exported body lacks the pocket walls and floor. */
#30=PLANE('top',#23);
#31=ADVANCED_FACE('top_face',(),#30,.T.);
#32=PLANE('bottom',#23);
#33=ADVANCED_FACE('bottom_face',(),#32,.T.);
#34=PLANE('north',#23);
#35=ADVANCED_FACE('north_face',(),#34,.T.);
#36=PLANE('south',#23);
#37=ADVANCED_FACE('south_face',(),#36,.T.);
#38=PLANE('east',#23);
#39=ADVANCED_FACE('east_face',(),#38,.T.);
#40=PLANE('west',#23);
#41=ADVANCED_FACE('west_face',(),#40,.T.);
#50=CLOSED_SHELL('cube_shell',(#31,#33,#35,#37,#39,#41));
#51=MANIFOLD_SOLID_BREP('A099_body_pre_tip',#50);
#60=SHAPE_REPRESENTATION('A099_repr',(#23,#51),#14);
#61=SHAPE_DEFINITION_REPRESENTATION(#8,#60);
ENDSEC;
END-ISO-10303-21;
