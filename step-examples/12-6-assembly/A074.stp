ISO-10303-21;
/* A074 - Texture lost when saving binary XBF after STEP import
 * Defect: STEP file with IMAGE_TEXTURE; XBF persistence loses texture on save */
HEADER;
FILE_DESCRIPTION(('A074 test case','Texture lost when saving binary XBF after STEP import'),'2;1');
FILE_NAME('A074.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=PRODUCT_CONTEXT('',#1,'mechanical');
#11=PRODUCT('part1','part1','part1',(#10));
#12=PRODUCT_DEFINITION_FORMATION('','',#11);
#13=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#14=PRODUCT_DEFINITION('','',#12,#13);
#15=PRODUCT_DEFINITION_SHAPE('','',#14);
#100=IMAGE_TEXTURE('texture_path','/textures/wood.png','png');
#101=TEXTURE_MAPPING('','',(#100));

ENDSEC;
END-ISO-10303-21;
