ISO-10303-21;
/*
 * P006 — 360 degree revolution of arc-of-ellipse produces self-intersecting
 *        solid
 * Defect (FreeCAD #14447; FreeCAD Part Revolve):
 *   A solid produced by 360 deg revolution of a half-ellipse profile
 *   (major axis on X) emits a self-intersecting / mirrored surface; with
 *   major axis on Y, or generatrix converted to B-spline, round-trips
 *   correctly. Suggests a bug in OCCT's CONIC / ELLIPSE parametric-domain
 *   handling near the seam u=0/2pi.
 * Reproducer (mini): SURFACE_OF_REVOLUTION whose generatrix is a
 *   TRIMMED_CURVE(ELLIPSE) spanning 0..pi/2 of an ellipse with
 *   semi_axis_1 > semi_axis_2, revolved 2pi.
 * Expected kernel: closed valid solid (no self-intersection or mirroring near
 *   the seam).
 */
HEADER;
FILE_DESCRIPTION(('P006 SURFACE_OF_REVOLUTION of arc-of-ellipse self-intersects at seam'),'2;1');
FILE_NAME('P006.stp','2026-04-26T00:00:00',('catalog'),('cad'),'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('automotive design');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT_DEFINITION_CONTEXT('part definition',#10,'design');
#20 = PRODUCT('P006_ASSY','','',(#12));
#21 = PRODUCT_DEFINITION_FORMATION('','',#20);
#22 = PRODUCT_DEFINITION('design','',#21,#13);
#23 = PRODUCT_DEFINITION_SHAPE('','',#22);
#30 = PRODUCT('REVOLVED_HALF_ELLIPSE','','',(#12));
#31 = PRODUCT_DEFINITION_FORMATION('','',#30);
#32 = PRODUCT_DEFINITION('design','',#31,#13);
#33 = PRODUCT_DEFINITION_SHAPE('','',#32);
#40 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','REV_INST','',#22,#32,$);
/* Ellipse generatrix, semi-axis 1 > semi-axis 2, X-major orientation */
#90 = CARTESIAN_POINT('ellipse_center',(0.0,0.0,0.0));
#91 = DIRECTION('z',(0.0,0.0,1.0));
#92 = DIRECTION('x',(1.0,0.0,0.0));
#93 = AXIS2_PLACEMENT_3D('ellipse_axes',#90,#91,#92);
#94 = ELLIPSE('gen_ellipse',#93,10.0,4.0);
#95 = TRIMMED_CURVE('half_ellipse',#94,
        (PARAMETER_VALUE(0.0)),(PARAMETER_VALUE(1.5707963267948966)),
        .T.,.PARAMETER.);
#96 = AXIS1_PLACEMENT('rev_axis',#90,#91);
/* DEFECT: 360-deg revolution of arc-of-ellipse with X-major orientation */
#97 = SURFACE_OF_REVOLUTION('rev_surf',#95,#96);
#50 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#51 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#52 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#53 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#50,'distance_accuracy_value','');
#54 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#53))
        GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52)) REPRESENTATION_CONTEXT('','3D') );
#60 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#61 = DIRECTION('',(0.0,0.0,1.0));
#62 = DIRECTION('',(1.0,0.0,0.0));
#63 = AXIS2_PLACEMENT_3D('part_origin',#60,#61,#62);
#64 = SHAPE_REPRESENTATION('part_rep',(#63,#97),#54);
#65 = SHAPE_DEFINITION_REPRESENTATION(#33,#64);
#66 = REPRESENTATION_MAP(#63,#64);
#67 = MAPPED_ITEM('inst',#66,#63);
#80 = AXIS2_PLACEMENT_3D('assy_origin',#60,#61,#62);
#81 = SHAPE_REPRESENTATION('assy_rep',(#80,#67),#54);
#82 = SHAPE_DEFINITION_REPRESENTATION(#23,#81);
/* Extended catalog notes:
 * This reproducer is a minimal demonstrator of the §12.6 entry
 * referenced in the /* * / header above. The entity-graph above
 * is just enough to exercise the defect on a writer or reader
 * test harness; it is NOT a production-quality assembly.
