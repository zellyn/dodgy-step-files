ISO-10303-21;
/*
 * P018 — Improper rotation (negative determinant) in AXIS2_PLACEMENT_3D
 * Defect (FreeCAD #29209; FreeCAD Link with -1 scale):
 *   A MAPPED_ITEM whose transformation_operator AXIS2_PLACEMENT_3D encodes a
 *   left-handed coordinate system (improper rotation, det = -1) doesn't
 *   round-trip — receiver loses the reflection.
 * Reproducer: STEP MAPPED_ITEM with AXIS2_PLACEMENT_3D direction vectors that
 *   form a left-handed frame.
 * Expected kernel: reader handles non-orthonormal-but-orthogonal placements
 *   explicitly, or rejects with clear error.
 */
HEADER;
FILE_DESCRIPTION(('P018 left-handed AXIS2_PLACEMENT_3D in MAPPED_ITEM'),'2;1');
FILE_NAME('P018.stp','2026-04-26T00:00:00',('catalog'),('cad'),'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('automotive design');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT_DEFINITION_CONTEXT('part definition',#10,'design');
#20 = PRODUCT('P018_ASSY','','',(#12));
#21 = PRODUCT_DEFINITION_FORMATION('','',#20);
#22 = PRODUCT_DEFINITION('design','',#21,#13);
#23 = PRODUCT_DEFINITION_SHAPE('','',#22);
#30 = PRODUCT('MIRRORED_LEAF','left-handed instance via FreeCAD Link','',(#12));
#31 = PRODUCT_DEFINITION_FORMATION('','',#30);
#32 = PRODUCT_DEFINITION('design','',#31,#13);
#33 = PRODUCT_DEFINITION_SHAPE('','',#32);
#40 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','MIRROR_INST','',#22,#32,$);
#50 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#51 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#52 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#53 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#50,'distance_accuracy_value','');
#54 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#53))
        GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52)) REPRESENTATION_CONTEXT('','3D') );
#60 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#61 = DIRECTION('',(0.0,0.0,1.0));
#62 = DIRECTION('',(1.0,0.0,0.0));
#63 = AXIS2_PLACEMENT_3D('leaf_origin',#60,#61,#62);
#64 = SHAPE_REPRESENTATION('leaf_rep',(#63),#54);
#65 = SHAPE_DEFINITION_REPRESENTATION(#33,#64);
#66 = REPRESENTATION_MAP(#63,#64);
/* DEFECT: left-handed frame.
   Z = (0,0,1), X = (-1,0,0). Right-handed Y would be (0,1,0); given the
   spec computes Y = Z x X = (0,0,1) x (-1,0,0) = (0,-1,0), which gives
   negative determinant — a reflection through the YZ plane. */
#70 = CARTESIAN_POINT('mirror_origin',(0.0,0.0,0.0));
#71 = DIRECTION('mirror_z',(0.0,0.0,1.0));
#72 = DIRECTION('mirror_x_neg',(-1.0,0.0,0.0));
#73 = AXIS2_PLACEMENT_3D('left_handed_frame',#70,#71,#72);
#74 = MAPPED_ITEM('mirror_inst',#66,#73);
#80 = AXIS2_PLACEMENT_3D('assy_origin',#60,#61,#62);
#81 = SHAPE_REPRESENTATION('assy_rep',(#80,#74),#54);
#82 = SHAPE_DEFINITION_REPRESENTATION(#23,#81);
