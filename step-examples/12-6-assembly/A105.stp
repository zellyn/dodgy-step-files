ISO-10303-21;
/* A105 - Regression OCC 6.9.1 -> 7.4.0: colours stop appearing on certain STEP files
 * Defect: file routes colour through MECHANICAL_DESIGN_GEOMETRIC_PRESENTATION_REPRESENTATION
 * rather than per-face STYLED_ITEM. 6.9.x reader resolves; 7.4.0+ silently drops. */
HEADER;
FILE_DESCRIPTION(('A105 - colour via MD_GEOMETRIC_PRESENTATION_REPRESENTATION lost in 7.4'),'2;1');
FILE_NAME('A105.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
#30=ADVANCED_FACE('',(),#20,.T.);
#40=COLOUR_RGB('blue',0.0,0.2,0.8);
#41=FILL_AREA_STYLE_COLOUR('',#40);
#42=FILL_AREA_STYLE('',(#41));
#43=SURFACE_STYLE_FILL_AREA(#42);
#44=SURFACE_SIDE_STYLE('',(#43));
#45=SURFACE_STYLE_USAGE(.BOTH.,#44);
#46=PRESENTATION_STYLE_ASSIGNMENT((#45));
#50=SHAPE_REPRESENTATION('shape',(#13),#60);
#51=STYLED_ITEM('rep_level_style',(#46),#50);
#60=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#13)) REPRESENTATION_CONTEXT('',''));
/* Colour delivered through MECHANICAL_DESIGN_GEOMETRIC_PRESENTATION_REPRESENTATION
 * rather than per-face STYLED_ITEM. */
#70=MECHANICAL_DESIGN_GEOMETRIC_PRESENTATION_REPRESENTATION('legacy_route',(#51),#60);
ENDSEC;
END-ISO-10303-21;
