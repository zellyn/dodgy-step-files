/* A102 - Cap part exports as STEP that downstream slicers flag as
 * damaged (open shell wrapped as solid).
 * Defect (FreeCAD #29647): a thin-walled Cap body has one face missing
 * from its outer shell, but the writer wraps the result as
 * MANIFOLD_SOLID_BREP. Slicers (Orca, Bambu) reject as non-manifold. */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('A102 - cap body open shell wrapped as solid'),'2;1');
FILE_NAME('A102.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('A102_cap','cap with open shell','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#10=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#14=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('','3D') );
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
/* Defect: cap is a thin-walled cup. Of the 8 faces an authoring kernel
   would emit (4 outer-side, 4 inner-side, outer-bottom, inner-bottom,
   top-rim) we emit only 7 -- the inner-bottom is missing. The shell is
   still wrapped as MANIFOLD_SOLID_BREP, claiming closure. */
#30=PLANE('outer_side_n',#23); #31=ADVANCED_FACE('outer_side_n',(),#30,.T.);
#32=PLANE('outer_side_e',#23); #33=ADVANCED_FACE('outer_side_e',(),#32,.T.);
#34=PLANE('outer_side_s',#23); #35=ADVANCED_FACE('outer_side_s',(),#34,.T.);
#36=PLANE('outer_side_w',#23); #37=ADVANCED_FACE('outer_side_w',(),#36,.T.);
#38=PLANE('inner_side_n',#23); #39=ADVANCED_FACE('inner_side_n',(),#38,.T.);
#40=PLANE('inner_side_e',#23); #41=ADVANCED_FACE('inner_side_e',(),#40,.T.);
#42=PLANE('outer_bottom',#23); #43=ADVANCED_FACE('outer_bottom',(),#42,.T.);
/* Note: inner_bottom face deliberately absent. */
#50=CLOSED_SHELL('A102_open_shell',(#31,#33,#35,#37,#39,#41,#43));
#51=MANIFOLD_SOLID_BREP('A102_cap_open_as_solid',#50);
#60=SHAPE_REPRESENTATION('A102_repr',(#23,#51),#14);
#61=SHAPE_DEFINITION_REPRESENTATION(#8,#60);
ENDSEC;
END-ISO-10303-21;
