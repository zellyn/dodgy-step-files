ISO-10303-21;
/* Tb001: two VERTEX_POINTs 5e-5 mm apart on end-to-end EDGE_CURVEs; declared uncertainty 1.0E-3 — vertex gap is sub-tolerance so wire appears closed; hardcoded Precision::Confusion ~1e-7 sees a gap; GEOMETRIC_CURVE_SET as model root — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Tb001'),'2;1');
FILE_NAME('Tb001.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('a0',(0.0,0.0,0.0));
#2=CARTESIAN_POINT('a1',(10.0,0.0,0.0));
#3=CARTESIAN_POINT('b0_gap_5e-5',(10.00005,0.0,0.0));
#4=CARTESIAN_POINT('b1',(20.00005,0.0,0.0));
#5=VERTEX_POINT('va0',#1);
#6=VERTEX_POINT('va1',#2);
#7=VERTEX_POINT('vb0_at_gap',#3);
#8=VERTEX_POINT('vb1',#4);
#9=DIRECTION('',(1.0,0.0,0.0));
#10=VECTOR('',#9,10.0);
#11=LINE('',#1,#10);
#12=EDGE_CURVE('eA',#5,#6,#11,.T.);
#13=DIRECTION('',(1.0,0.0,0.0));
#14=VECTOR('',#13,10.0);
#15=LINE('',#3,#14);
#16=EDGE_CURVE('eB',#7,#8,#15,.T.);
#17=GEOMETRIC_CURVE_SET('wire_set',(#12,#16));
#18=APPLICATION_CONTEXT('automotive_design');
#19=PRODUCT_CONTEXT('',#18,'mechanical');
#20=PRODUCT('Tb001','Tb001','',(#19));
#21=PRODUCT_DEFINITION_FORMATION('','',#20);
#22=PRODUCT_DEFINITION_CONTEXT('part definition',#18,'design');
#23=PRODUCT_DEFINITION('','',#21,#22);
#24=PRODUCT_DEFINITION_SHAPE('','',#23);
#25=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#26=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#27=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#28=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-3),#25,'distance_accuracy_value','declared_loose_tolerance');
#29=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#28))GLOBAL_UNIT_ASSIGNED_CONTEXT((#25,#26,#27))REPRESENTATION_CONTEXT('ctx','3D'));
#30=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#17),#29);
#31=SHAPE_DEFINITION_REPRESENTATION(#24,#30);
ENDSEC;
