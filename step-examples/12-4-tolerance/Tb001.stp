ISO-10303-21;
/* Tb001 - Sub-tolerance vertex gap (5e-5 mm) at declared tolerance 1e-3
 * Defect: Two vertices 5e-5 mm apart on an end-to-end edge pair. At declared
 * tolerance 1e-3 the gap is sub-tolerance and the wire is closed; at a
 * receiver-imposed Precision::Confusion (~1e-7) the gap is super-tolerance
 * and the wire is open ("naked edge", "free boundary"). The file is
 * simultaneously valid and invalid depending on which tolerance the
 * receiver honours.
 */
HEADER;
FILE_DESCRIPTION(('Tb001 sub-tolerance vertex gap at declared 1e-3'),'2;1');
FILE_NAME('Tb001.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Edge A goes (0,0,0) -> (10,0,0); Edge B starts at (10.00005,0,0) -- gap 5e-5 mm */
#10=CARTESIAN_POINT('a0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('a1',(10.0,0.0,0.0));
#12=CARTESIAN_POINT('b0',(10.00005,0.0,0.0));
#13=CARTESIAN_POINT('b1',(20.00005,0.0,0.0));
#20=VERTEX_POINT('a0',#10);
#21=VERTEX_POINT('a1_at_endA',#11);
#22=VERTEX_POINT('b0_at_startB_5e-5_offset',#12);
#23=VERTEX_POINT('b1',#13);
#30=DIRECTION('+x',(1.0,0.0,0.0));
#31=VECTOR('vx10',#30,10.0);
#32=LINE('lA',#10,#31);
#33=LINE('lB',#12,#31);
#40=EDGE_CURVE('eA',#20,#21,#32,.T.);
#41=EDGE_CURVE('eB',#22,#23,#33,.T.);
/* Units & tolerance: declared 1e-3 mm. Receiver honoring this sees the wire
 * as effectively closed (5e-5 << 1e-3). Receiver hardcoding 1e-7 sees a gap. */
#50=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#51=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#52=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#60=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-3),#50,
  'distance_accuracy_value','declared_loose_tolerance');
#70=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#60))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52))
  REPRESENTATION_CONTEXT('ctx','3D'));
/* Minimal PRODUCT chain for tier-3 introspection. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tb001','Tb001','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9020=GEOMETRIC_CURVE_SET('wire_set',(#40,#41));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#70);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
