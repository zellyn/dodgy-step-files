/* N071 - BRepLib.UpdateEdgeTol surface-mesh consistency unchecked
 * Defect: UpdateEdgeTol uses 3D curve sampling only, ignoring face mesh
 * deflection. When a face has triangulation that deviates from its
 * geometric surface, the edge tolerance should reflect both the 3D curve
 * accuracy AND the mesh deflection. UpdateEdgeTol computes sampling
 * deviation from the curve alone, so mesh-induced drift is unchecked.
 * Reproducer: Face with ADVANCED_FACE(mesh-deflection 0.1mm) hosting
 * an edge with 3D curve (sampling deviation 0.001mm). UpdateEdgeTol
 * returns 0.001mm, ignoring the mesh-face discrepancy.
 * Expected: tolerance includes max(curve-sampling, mesh-deflection) = 0.1mm.
 * Bug: returns 0.001mm, misses mesh contribution.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N071 BRepLib UpdateEdgeTol surface-mesh consistency','2;1');
FILE_NAME('N071.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Plane with vertices and edge-loop */
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(10.0,0.0,0.0));
#12=CARTESIAN_POINT('p2',(10.0,10.0,0.0));
#13=CARTESIAN_POINT('p3',(0.0,10.0,0.0));
#20=VERTEX_POINT('v0',#10);
#21=VERTEX_POINT('v1',#11);
#22=VERTEX_POINT('v2',#12);
#23=VERTEX_POINT('v3',#13);
/* Edges: high-precision 3D curves (0.001mm sampling-point deviation) */
#30=LINE('edge_curve_0',#10,#(VECTOR('',#(DIRECTION('',(1.0,0.0,0.0))),10.0)));
#31=LINE('edge_curve_1',#11,#(VECTOR('',#(DIRECTION('',(0.0,1.0,0.0))),10.0)));
#32=LINE('edge_curve_2',#12,#(VECTOR('',#(DIRECTION('',(-1.0,0.0,0.0))),10.0)));
#33=LINE('edge_curve_3',#13,#(VECTOR('',#(DIRECTION('',(0.0,-1.0,0.0))),10.0)));
#40=EDGE_CURVE('e0',#20,#21,#30,.T.);
#41=EDGE_CURVE('e1',#21,#22,#31,.T.);
#42=EDGE_CURVE('e2',#22,#23,#32,.T.);
#43=EDGE_CURVE('e3',#23,#20,#33,.T.);
/* Edge loop forming a closed quad */
#50=EDGE_LOOP('el',#(#40,#41,#42,#43));
/* Planar surface XY-plane */
#60=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#61=DIRECTION('z',(0.0,0.0,1.0));
#62=DIRECTION('x',(1.0,0.0,0.0));
#63=AXIS2_PLACEMENT_3D('',#60,#61,#62);
#64=PLANE('xy_plane',#63);
/* Face with outer bound */
#65=FACE_OUTER_BOUND('',#50,.T.);
#66=ADVANCED_FACE('',(#65),#64,.T.);
/* Units: mm, with implicit mesh-deflection tolerance mismatch */
#200=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#201=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#202=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Declared tolerance is tiny (0.001 mm curve sampling) but face mesh
   may deviate by 0.1 mm. UpdateEdgeTol should account for both. */
#203=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-3),#200,
  'distance_accuracy_value','');
#204=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#203))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#200,#201,#202))
  REPRESENTATION_CONTEXT('','3D'));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N071','N071','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#66));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#204);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
