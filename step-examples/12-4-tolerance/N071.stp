ISO-10303-21;
/* N071 — BRepLib.UpdateEdgeTol surface-mesh consistency unchecked
 * Defect: UpdateEdgeTol uses 3D curve sampling only, ignoring face mesh deflection.
 * When a face has triangulation that deviates from its geometric surface, edge
 * tolerance should reflect both curve accuracy AND mesh deflection. UpdateEdgeTol
 * computes sampling deviation from the curve alone, missing mesh-induced drift.
 * Reproducer: Face with mesh deflection 0.1mm hosting an edge with 3D curve
 * sampling deviation 0.001mm. UpdateEdgeTol returns 0.001mm, ignoring mesh.
 * Expected: tolerance includes max(curve_sampling, mesh_deflection) = 0.1mm.
 */
HEADER;
FILE_DESCRIPTION(('N071 BRepLib UpdateEdgeTol surface-mesh consistency'),'2;1');
FILE_NAME('N071.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* 10x10 planar face with edges that have precise 3D curves (0.001mm sampling)
   but the face mesh deflection would be 0.1mm. */
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(10.0,0.0,0.0));
#12=CARTESIAN_POINT('p2',(10.0,10.0,0.0));
#13=CARTESIAN_POINT('p3',(0.0,10.0,0.0));
#20=VERTEX_POINT('v0',#10);
#21=VERTEX_POINT('v1',#11);
#22=VERTEX_POINT('v2',#12);
#23=VERTEX_POINT('v3',#13);
/* Edges: high-precision 3D curves (0.001mm curve-sampling deviation) */
#30=DIRECTION('d0',(1.0,0.0,0.0));
#31=VECTOR('vec0',#30,10.0);
#32=LINE('edge_curve_0',#10,#31);
#33=EDGE_CURVE('e0',#20,#21,#32,.T.);
#34=DIRECTION('d1',(0.0,1.0,0.0));
#35=VECTOR('vec1',#34,10.0);
#36=LINE('edge_curve_1',#11,#35);
#37=EDGE_CURVE('e1',#21,#22,#36,.T.);
#38=DIRECTION('d2',(-1.0,0.0,0.0));
#39=VECTOR('vec2',#38,10.0);
#40=LINE('edge_curve_2',#12,#39);
#41=EDGE_CURVE('e2',#22,#23,#40,.T.);
#42=DIRECTION('d3',(0.0,-1.0,0.0));
#43=VECTOR('vec3',#42,10.0);
#44=LINE('edge_curve_3',#13,#43);
#45=EDGE_CURVE('e3',#23,#20,#44,.T.);
/* Edge loop forming a closed quad */
#46=ORIENTED_EDGE('',*,*,#33,.T.);
#47=ORIENTED_EDGE('',*,*,#37,.T.);
#48=ORIENTED_EDGE('',*,*,#41,.T.);
#49=ORIENTED_EDGE('',*,*,#45,.T.);
#50=EDGE_LOOP('el',(#46,#47,#48,#49));
/* Planar surface XY-plane */
#60=DIRECTION('zdir',(0.0,0.0,1.0));
#61=DIRECTION('xdir',(1.0,0.0,0.0));
#62=AXIS2_PLACEMENT_3D('ax3',#10,#60,#61);
#63=PLANE('xy_plane',#62);
#64=FACE_OUTER_BOUND('',#50,.T.);
/* ADVANCED_FACE — UpdateEdgeTol checks 3D curve only, ignores mesh deflection */
#65=ADVANCED_FACE('face',(#64),#63,.T.);
#66=CLOSED_SHELL('shell',(#65));
/* Units: mm, with 0.001mm declared curve-sampling tolerance.
   Face mesh would deviate by 0.1mm (not captured in STEP, but relevant to defect). */
#200=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#201=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#202=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Declared tolerance is tiny (0.001mm curve sampling) */
#203=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-3),#200,
  'distance_accuracy_value','curve_sampling');
/* Mesh deflection tolerance (0.1mm) — UpdateEdgeTol ignores this */
#204=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-1),#200,
  'distance_accuracy_value','mesh_deflection');
#205=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#203,#204))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#200,#201,#202))
  REPRESENTATION_CONTEXT('','3D'));
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N071','N071','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#66));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
