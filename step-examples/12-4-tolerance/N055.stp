ISO-10303-21;
/* N055: LimitTolerance input: single vertex at origin; tmin == tmax == 0.002; equality boundary makes newtol clamp nondeterministic; GEOMETRIC_CURVE_SET — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('N055'),'2;1');
FILE_NAME('N055.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#2=VERTEX_POINT('v_origin',#1);
#3=CARTESIAN_POINT('p_end',(1.0,0.0,0.0));
#4=VERTEX_POINT('v_end',#3);
#5=DIRECTION('',(1.0,0.0,0.0));
#6=VECTOR('',#5,1.0);
#7=LINE('unit_line',#1,#6);
#8=EDGE_CURVE('edge',#2,#4,#7,.T.);
#9=GEOMETRIC_CURVE_SET('limit_tol_input',(#8));
#10=APPLICATION_CONTEXT('automotive_design');
#11=PRODUCT_CONTEXT('',#10,'mechanical');
#12=PRODUCT('N055','N055','',(#11));
#13=PRODUCT_DEFINITION_FORMATION('','',#12);
#14=PRODUCT_DEFINITION_CONTEXT('part definition',#10,'design');
#15=PRODUCT_DEFINITION('','',#13,#14);
#16=PRODUCT_DEFINITION_SHAPE('','',#15);
#17=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#18=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#19=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#20=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(2.0E-3),#17,'distance_accuracy_value','limit_tol_equal_bounds');
#21=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#20))GLOBAL_UNIT_ASSIGNED_CONTEXT((#17,#18,#19))REPRESENTATION_CONTEXT('ctx','3D'));
#22=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9),#21);
#23=SHAPE_DEFINITION_REPRESENTATION(#16,#22);
ENDSEC;
