ISO-10303-21;
/* N100: CheckPoints precision-asymmetry-extreme: two edges; preci1=1e-15 vs preci2=1.0; averaging masks both extremes; GEOMETRIC_CURVE_SET — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('N100'),'2;1');
FILE_NAME('N100.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('p1A',(0.0,0.0,0.0));
#2=CARTESIAN_POINT('p2A_ultra_close',(1.0E-14,0.0,0.0));
#3=VERTEX_POINT('v1A',#1);
#4=VERTEX_POINT('v2A',#2);
#5=DIRECTION('',(1.0,0.0,0.0));
#6=VECTOR('',#5,1.0E-14);
#7=LINE('ln_ultra_tight',#1,#6);
#8=EDGE_CURVE('eA_ultra_tight',#3,#4,#7,.T.);
#9=CARTESIAN_POINT('p1B',(0.0,1.0,0.0));
#10=CARTESIAN_POINT('p2B_coarse',(0.9,1.0,0.0));
#11=VERTEX_POINT('v1B',#9);
#12=VERTEX_POINT('v2B',#10);
#13=DIRECTION('',(1.0,0.0,0.0));
#14=VECTOR('',#13,0.9);
#15=LINE('ln_coarse',#9,#14);
#16=EDGE_CURVE('eB_coarse',#11,#12,#15,.T.);
#17=GEOMETRIC_CURVE_SET('asymmetric_prec',(#8,#16));
#18=APPLICATION_CONTEXT('automotive_design');
#19=PRODUCT_CONTEXT('',#18,'mechanical');
#20=PRODUCT('N100','N100','',(#19));
#21=PRODUCT_DEFINITION_FORMATION('','',#20);
#22=PRODUCT_DEFINITION_CONTEXT('part definition',#18,'design');
#23=PRODUCT_DEFINITION('','',#21,#22);
#24=PRODUCT_DEFINITION_SHAPE('','',#23);
#25=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#26=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#27=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#28=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-15),#25,'distance_accuracy_value','ultra_tight_preci1');
#29=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0),#25,'distance_accuracy_value','coarse_preci2');
#30=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#28,#29))GLOBAL_UNIT_ASSIGNED_CONTEXT((#25,#26,#27))REPRESENTATION_CONTEXT('ctx','3D'));
#31=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#17),#30);
#32=SHAPE_DEFINITION_REPRESENTATION(#24,#31);
ENDSEC;
END-ISO-10303-21;
