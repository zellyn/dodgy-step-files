/* N073 - BRepLib.UpdateDeflection null-triangulation skip
 * Defect: UpdateDeflection checks if a face has a triangulation; if the
 * reference is null, it silently skips. The deflection state remains
 * uninitialized (undefined, stale, or zero), and downstream consumers
 * that rely on a computed deflection may read garbage or assume the
 * face is valid-triangulated when it is not.
 * Reproducer: Face created from a surface (no triangulation attached).
 * Call UpdateDeflection(face, tol). If face->Triangulation() is null,
 * the routine returns without setting the deflection state.
 * Expected: Either compute deflection from the surface geometry OR
 * raise a diagnostic flag.
 * Bug: silent no-op; deflection state uninitialized.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N073 BRepLib UpdateDeflection null-triangulation','2;1');
FILE_NAME('N073.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Planar face without explicit triangulation record */
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(5.0,0.0,0.0));
#12=CARTESIAN_POINT('p2',(5.0,5.0,0.0));
#13=CARTESIAN_POINT('p3',(0.0,5.0,0.0));
#20=VERTEX_POINT('v0',#10);
#21=VERTEX_POINT('v1',#11);
#22=VERTEX_POINT('v2',#12);
#23=VERTEX_POINT('v3',#13);
/* Simple edge-loop quad */
#30=LINE('',#10,#(VECTOR('',#(DIRECTION('',(1.0,0.0,0.0))),5.0)));
#31=LINE('',#11,#(VECTOR('',#(DIRECTION('',(0.0,1.0,0.0))),5.0)));
#32=LINE('',#12,#(VECTOR('',#(DIRECTION('',(-1.0,0.0,0.0))),5.0)));
#33=LINE('',#13,#(VECTOR('',#(DIRECTION('',(0.0,-1.0,0.0))),5.0)));
#40=EDGE_CURVE('e0',#20,#21,#30,.T.);
#41=EDGE_CURVE('e1',#21,#22,#31,.T.);
#42=EDGE_CURVE('e2',#22,#23,#32,.T.);
#43=EDGE_CURVE('e3',#23,#20,#33,.T.);
#50=EDGE_LOOP('',#(#40,#41,#42,#43));
/* Plane surface (no triangulation attached in STEP data) */
#60=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#61=DIRECTION('z',(0.0,0.0,1.0));
#62=DIRECTION('x',(1.0,0.0,0.0));
#63=AXIS2_PLACEMENT_3D('',#60,#61,#62);
#64=PLANE('xy_plane',#63);
#65=FACE_OUTER_BOUND('',#50,.T.);
/* ADVANCED_FACE with no triangulation — UpdateDeflection will skip */
#66=ADVANCED_FACE('',(#65),#64,.T.);
/* Units and nominal tolerance */
#200=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#201=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#202=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#203=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-2),#200,
  'distance_accuracy_value','');
#204=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#203))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#200,#201,#202))
  REPRESENTATION_CONTEXT('','3D'));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N073','N073','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#66));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#204);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
