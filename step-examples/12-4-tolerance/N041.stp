/* N041 - Manifold epsilon-validity contract: cumulative transform error
 *        inflates epsilon beyond input scale
 * Defect: The Manifold library tracks an epsilon (the maximum vertex
 * perturbation that would suffice to make the mesh strictly non-overlapping).
 * Cumulative transform / Boolean error inflates epsilon beyond the input
 * scale; subsequent Booleans become unstable. User must rebuild from cleaner
 * data or call SetTolerance to widen and Simplify. STEP carrier shows two
 * UNCERTAINTY entries: a clean input epsilon and the inflated epsilon
 * recorded after a Boolean cascade.
 * Reproducer: input mesh epsilon 1.0e-7 m; after a 50-step Boolean cascade
 * the file emerges with epsilon 4.2e-3 m -- four orders of magnitude wider
 * than input scale.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N041 Manifold epsilon-validity inflated by cumulative Boolean drift'),'2;1');
FILE_NAME('N041.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Two cubes the Manifold library would Boolean-fuse; the meaningful
 * carriers are the two GLOBAL_UNCERTAINTY values declaring input vs
 * post-cascade epsilon. */
#10=CARTESIAN_POINT('a0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('a1',(10.0,0.0,0.0));
#12=CARTESIAN_POINT('a2',(10.0,10.0,0.0));
#13=CARTESIAN_POINT('a3',(0.0,10.0,0.0));
#20=VERTEX_POINT('a0',#10);
#21=VERTEX_POINT('a1',#11);
#22=VERTEX_POINT('a2',#12);
#23=VERTEX_POINT('a3',#13);
#30=DIRECTION('+x',(1.0,0.0,0.0));
#31=DIRECTION('+y',(0.0,1.0,0.0));
#32=DIRECTION('-x',(-1.0,0.0,0.0));
#33=DIRECTION('-y',(0.0,-1.0,0.0));
#40=VECTOR('',#30,10.0);
#41=VECTOR('',#31,10.0);
#42=VECTOR('',#32,10.0);
#43=VECTOR('',#33,10.0);
#50=LINE('',#10,#40);
#51=LINE('',#11,#41);
#52=LINE('',#12,#42);
#53=LINE('',#13,#43);
#60=EDGE_CURVE('e0',#20,#21,#50,.T.);
#61=EDGE_CURVE('e1',#21,#22,#51,.T.);
#62=EDGE_CURVE('e2',#22,#23,#52,.T.);
#63=EDGE_CURVE('e3',#23,#20,#53,.T.);
#70=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#71=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#72=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Defect site: epsilon ballooned 4 orders of magnitude across cumulative
 * Boolean operations. Manifold validity contract violated. */
#80=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#70,
  'distance_accuracy_value','manifold_input_epsilon');
#81=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(4.2E-3),#70,
  'distance_accuracy_value','manifold_epsilon_after_50_boolean_steps');
#90=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#80,#81))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#70,#71,#72))
  REPRESENTATION_CONTEXT('ctx_manifold_eps_drift','3D'));
ENDSEC;
END-ISO-10303-21;
