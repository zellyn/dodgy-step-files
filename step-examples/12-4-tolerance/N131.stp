ISO-10303-21;
/* N131 - ShapeAnalysis_ShapeTolerance.InTolerance.vertex_tolerance_filtering_BUGGY
 * Defect: VERTEX iteration uses inverted comparison (tol >= valmax) instead of
 * (tol <= valmax), breaking tolerance range semantics for vertex filtering.
 * Expected behavior: InTolerance(shape, 0.001, 0.002, TopAbs_VERTEX) should
 * return vertices with tolerance in [0.001, 0.002]. Actual (buggy): inverted
 * comparison returns vertices OUTSIDE the range due to >= valmax check.
 */
HEADER;
FILE_DESCRIPTION(('N131 ShapeAnalysis_ShapeTolerance vertex_tolerance_filtering_BUGGY'),'2;1');
FILE_NAME('N131.stp','2026-06-16T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Origin and axes */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
/* Vertex 1: tolerance 0.0015 (in-range for [0.001, 0.002]) */
#20=CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#30=VERTEX_POINT('v_in_range',#20);
/* Vertex 2: tolerance 0.005 (out-of-range for [0.001, 0.002]) */
#21=CARTESIAN_POINT('p2',(1.0,0.0,0.0));
#31=VERTEX_POINT('v_out_range',#21);
/* Edge connecting in-range vertex to out-of-range vertex */
#40=DIRECTION('edge_dir',(1.0,0.0,0.0));
#41=VECTOR('edge_vec',#40,1.0);
#42=LINE('edge1',#20,#41);
#43=EDGE_CURVE('ec1',#30,#31,#42,.T.);
/* Edge loop containing the edge */
#50=ORIENTED_EDGE('oe1',*,*,#43,.T.);
#51=EDGE_LOOP('loop1',(#50));
/* Face using the edge loop */
#60=PLANE('face_plane',#13,1.0);
#61=FACE_OUTER_BOUND('face_bound',#51,.T.);
#62=ADVANCED_FACE('',(#61),#60,.T.);
/* Shell with the face */
#70=CLOSED_SHELL('shell',(#62));
/* Units and context */
#80=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#81=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#82=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#83=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#80,
  'distance_accuracy_value','nominal_tolerance');
#84=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#83))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#80,#81,#82))
  REPRESENTATION_CONTEXT('vertex_tol_ctx','3D'));
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N131','N131','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#70));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
