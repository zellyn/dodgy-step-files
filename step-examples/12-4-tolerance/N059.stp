ISO-10303-21;
/* N059 — BRepLib.UpdateEdgeTol sampling-grid undersample
 * Defect: UpdateEdgeTol uses 23-sample default grid to detect maximum distance
 * between 3D curve and 2D parametric curve. On B-spline edges with high-curvature
 * peaks between sample points, the peak distance is never observed, causing
 * underestimated edge tolerance that fails later validation.
 */
HEADER;
FILE_DESCRIPTION(('N059 UpdateEdgeTol undersample curvature peak'),'2;1');
FILE_NAME('N059.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* B-spline edge with high curvature between sample points.
   5 control points produce a curve with peak curvature near parameter 0.5.
   With 23 default samples, peak at ~0.48 falls between samples. */
#10=CARTESIAN_POINT('cp0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('cp1',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('cp2',(2.0,1.0,0.0));
#13=CARTESIAN_POINT('cp3',(3.0,0.5,0.0));
#14=CARTESIAN_POINT('cp4',(4.0,0.0,0.0));
#20=VERTEX_POINT('v_start',#10);
#21=VERTEX_POINT('v_end',#14);
/* B-spline curve degree 3, 5 control points */
#30=B_SPLINE_CURVE_WITH_KNOTS('bspline_high_curvature',3,
  (#10,#11,#12,#13,#14),
  .UNSPECIFIED.,.F.,.F.,
  (4,1,4),(0.0,0.5,1.0),
  .UNSPECIFIED.);
#40=EDGE_CURVE('bspline_edge',#20,#21,#30,.T.);
/* Close the loop with a straight edge returning to start */
#50=DIRECTION('negx',(-1.0,0.0,0.0));
#51=VECTOR('negxvec',#50,4.0);
#52=LINE('close_line',#14,#51);
#53=EDGE_CURVE('close_edge',#21,#20,#52,.T.);
#54=ORIENTED_EDGE('',*,*,#40,.T.);
#55=ORIENTED_EDGE('',*,*,#53,.T.);
#56=EDGE_LOOP('',(#54,#55));
/* Plane on XY */
#60=DIRECTION('zdir',(0.0,0.0,1.0));
#61=DIRECTION('xdir',(1.0,0.0,0.0));
#62=AXIS2_PLACEMENT_3D('ax3',#10,#60,#61);
#63=PLANE('plane_xy',#62);
#64=FACE_OUTER_BOUND('',#56,.T.);
#65=ADVANCED_FACE('face_on_plane',(#64),#63,.T.);
#66=OPEN_SHELL('shell1',(#65));
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N059','N059','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#66));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
