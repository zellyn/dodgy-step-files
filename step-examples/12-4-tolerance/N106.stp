#14=EDGE_LOOP('',(#13));
#15=FACE_OUTER_BOUND('',#14,.T.);
#16=ADVANCED_FACE('cone_face',(#15),#12,.T.);
#17=CLOSED_SHELL('shell',(#16));
#18=SHELL_BASED_SURFACE_MODEL('',(#17));
