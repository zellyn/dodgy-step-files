ISO-10303-21;
/* N038 - Patrikalakis interval-solid violation: face-pair gap exceeds bound
 * Defect: Adjacent faces are not "approximately equal" to an interval solid:
 * the maximum gap between any two trimmed surfaces along their shared edge
 * exceeds the chosen interval radius. Without this guarantee the boundary
 * reconstruction is not provably gap-free.
 * Reproducer: two B-spline patches whose maximum Hausdorff distance along
 * a shared edge is 5*epsilon while declared epsilon = 1.0e-5 mm. The face-pair
 * gap (5.0e-5) exceeds the tube radius epsilon.
 */
HEADER;
FILE_DESCRIPTION(('N038 Patrikalakis interval-solid face-pair gap exceeds epsilon'),'2;1');
FILE_NAME('N038.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Patch A along z=0; patch B parallel at z=5.0e-5 -- max Hausdorff = 5*1.0e-5 */
#10=CARTESIAN_POINT('A_00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('A_01',(0.0,10.0,0.0));
#12=CARTESIAN_POINT('A_10',(10.0,0.0,0.0));
#13=CARTESIAN_POINT('A_11',(10.0,10.0,0.0));
#14=B_SPLINE_SURFACE_WITH_KNOTS('patch_A',1,1,
  ((#10,#11),(#12,#13)),.UNSPECIFIED.,.F.,.F.,.F.,
  (2,2),(2,2),(0.0,1.0),(0.0,1.0),.UNSPECIFIED.);
#20=CARTESIAN_POINT('B_00',(0.0,0.0,5.0E-5));
#21=CARTESIAN_POINT('B_01',(0.0,10.0,5.0E-5));
#22=CARTESIAN_POINT('B_10',(10.0,0.0,5.0E-5));
#23=CARTESIAN_POINT('B_11',(10.0,10.0,5.0E-5));
#24=B_SPLINE_SURFACE_WITH_KNOTS('patch_B_offset_5eps',1,1,
  ((#20,#21),(#22,#23)),.UNSPECIFIED.,.F.,.F.,.F.,
  (2,2),(2,2),(0.0,1.0),(0.0,1.0),.UNSPECIFIED.);
#30=VERTEX_POINT('shared0',#10);
#31=VERTEX_POINT('shared1',#12);
#40=DIRECTION('+x',(1.0,0.0,0.0));
#41=VECTOR('',#40,10.0);
#42=LINE('',#10,#41);
#50=EDGE_CURVE('shared_edge_with_pair_gap_5eps',#30,#31,#42,.T.);
#60=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#61=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#62=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#63=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-5),#60,
  'distance_accuracy_value','epsilon_smaller_than_face_pair_gap');
#70=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#63))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#60,#61,#62))
  REPRESENTATION_CONTEXT('ctx','3D'));
ENDSEC;
END-ISO-10303-21;
