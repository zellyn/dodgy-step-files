ISO-10303-21;
/* N064 — ShapeAnalysis_Edge.CheckPoints precision asymmetry
 * Defect: An edge with asymmetric vertex tolerances (preci1 != preci2) is validated
 * by CheckPoints, which conflates the two precision values into a single tolerance,
 * losing asymmetry information.
 * Geometry: Single edge from (0,0,0) to (10,0,0) with coarse endpoint (1e-2)
 *   and fine endpoint (1e-5).
 * Expected: CheckPoints should validate each endpoint against its own tolerance;
 * actual behavior uses a single conflated value.
 */
HEADER;
FILE_DESCRIPTION(('N064 ShapeAnalysis_Edge CheckPoints precision asymmetry'),'2;1');
FILE_NAME('N064.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Edge endpoints with asymmetric precision characteristics */
#10=CARTESIAN_POINT('p_coarse',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p_fine',(10.0,0.0,0.0));
#20=VERTEX_POINT('coarse_vtx',#10);
#21=VERTEX_POINT('fine_vtx',#11);
/* Edge curve: LINE from coarse to fine endpoint */
#30=DIRECTION('xdir',(1.0,0.0,0.0));
#31=VECTOR('xvec',#30,10.0);
#32=LINE('edge_line',#10,#31);
#33=EDGE_CURVE('asym_edge',#20,#21,#32,.T.);
/* Close the loop for valid face */
#40=DIRECTION('ydir',(0.0,1.0,0.0));
#41=VECTOR('yvec',#40,1.0);
#42=LINE('line_up',#11,#41);
#43=CARTESIAN_POINT('pt_tr',(10.0,1.0,0.0));
#44=VERTEX_POINT('v_tr',#43);
#45=EDGE_CURVE('e_up',#21,#44,#42,.T.);
#46=DIRECTION('negx',(-1.0,0.0,0.0));
#47=VECTOR('negxvec',#46,10.0);
#48=LINE('line_back',#43,#47);
#49=CARTESIAN_POINT('pt_tl',(0.0,1.0,0.0));
#50=VERTEX_POINT('v_tl',#49);
#51=EDGE_CURVE('e_back',#44,#50,#48,.T.);
#52=DIRECTION('negy',(0.0,-1.0,0.0));
#53=VECTOR('negyvec',#52,1.0);
#54=LINE('line_down',#49,#53);
#55=EDGE_CURVE('e_down',#50,#20,#54,.T.);
#60=ORIENTED_EDGE('',*,*,#33,.T.);
#61=ORIENTED_EDGE('',*,*,#45,.T.);
#62=ORIENTED_EDGE('',*,*,#51,.T.);
#63=ORIENTED_EDGE('',*,*,#55,.T.);
#64=EDGE_LOOP('',(#60,#61,#62,#63));
#65=FACE_OUTER_BOUND('',#64,.T.);
#66=DIRECTION('zdir',(0.0,0.0,1.0));
#67=DIRECTION('xdir2',(1.0,0.0,0.0));
#68=AXIS2_PLACEMENT_3D('ax3',#10,#66,#67);
#69=PLANE('plane_xy',#68);
#70=ADVANCED_FACE('face',(#65),#69,.T.);
#71=CLOSED_SHELL('shell',(#70));
/* Asymmetric tolerance declarations */
#100=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#101=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#102=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Coarse endpoint tolerance: 1e-2 */
#103=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-2),#100,
  'distance_accuracy_value','coarse_tolerance');
/* Fine endpoint tolerance: 1e-5 */
#104=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-5),#100,
  'distance_accuracy_value','fine_tolerance');
#105=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#103,#104))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#100,#101,#102))
  REPRESENTATION_CONTEXT('','3D'));
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N064','N064','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#71));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
