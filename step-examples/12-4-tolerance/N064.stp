ISO-10303-21;
/* N064: CLOSED_SHELL face with asym_edge from coarse_vtx (1e-2) to fine_vtx (1e-5); two UNCERTAINTY_MEASURE entries coarse_tolerance=1e-2 and fine_tolerance=1e-5; CheckPoints conflates them into single value, losing asymmetry */
HEADER;
FILE_DESCRIPTION(('N064'),'2;1');
FILE_NAME('N064.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('p_coarse',(0.0,0.0,0.0));
#2=CARTESIAN_POINT('p_fine',(10.0,0.0,0.0));
