ISO-10303-21;
/* N058: ADVANCED_FACE on PLANE z=0 with no PCURVE entities; SameRange assumes PCurve exists and dereferences null pointer for edge_with_null_pcurve, corrupting downstream edge state */
HEADER;
FILE_DESCRIPTION(('N058'),'2;1');
FILE_NAME('N058.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
