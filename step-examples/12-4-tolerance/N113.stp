#15=EDGE_LOOP('',#14);
#16=FACE_OUTER_BOUND('',#15,.T.);
#17=PLANE('',#4);
#18=FACE('degenerate-face',#16,#17);
#19=CLOSED_SHELL('shell',(#18));
#5=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#6=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#7=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#30=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#5,'distance_accuracy_value','degenerate edge length=0 produces inf tolerance');
#8010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#30))GLOBAL_UNIT_ASSIGNED_CONTEXT((#5,#6,#7))REPRESENTATION_CONTEXT('','3D'));
