ISO-10303-21;
/* N068: B-spline bspline_bulge with 4 control points and ~5-unit interior bulge; UpdateInnerTolerances samples at endpoints only (2 samples), missing the ~1e-2 peak curvature deviation at center */
HEADER;
FILE_DESCRIPTION(('N068'),'2;1');
FILE_NAME('N068.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#2=CARTESIAN_POINT('p3',(10.0,0.0,0.0));
#3=CARTESIAN_POINT('p1',(3.0,5.0,0.0));
#4=CARTESIAN_POINT('p2',(7.0,5.0,0.0));
#5=VERTEX_POINT('v0',#1);
#6=VERTEX_POINT('v1',#2);
#7=B_SPLINE_CURVE_WITH_KNOTS('bspline_bulge',3,(#1,#3,#4,#2),.UNSPECIFIED.,.F.,.F.,(4,4),(0.0,1.0),.UNSPECIFIED.);
#8=EDGE_CURVE('bspl_edge',#5,#6,#7,.T.);
#9=DIRECTION('negx',(-1.0,0.0,0.0));
#10=VECTOR('negxvec',#9,10.0);
#11=LINE('close_line',#2,#10);
#12=EDGE_CURVE('close_edge',#6,#5,#11,.T.);
#13=ORIENTED_EDGE('',$,$,#8,.T.);
#14=ORIENTED_EDGE('',$,$,#12,.T.);
#15=EDGE_LOOP('',(#13,#14));
#16=FACE_OUTER_BOUND('',#15,.T.);
#17=DIRECTION('zdir',(0.0,0.0,1.0));
#18=DIRECTION('xdir',(1.0,0.0,0.0));
#19=AXIS2_PLACEMENT_3D('ax3',#1,#17,#18);
#20=PLANE('plane_xy',#19);
#21=ADVANCED_FACE('face',(#16),#20,.T.);
#22=OPEN_SHELL('shell',(#21));
#23=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#24=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#25=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#26=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-4),#23,'distance_accuracy_value','');
#27=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#26))GLOBAL_UNIT_ASSIGNED_CONTEXT((#23,#24,#25))REPRESENTATION_CONTEXT('','3D'));
#28=SHELL_BASED_SURFACE_MODEL('sbsm',(#22));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('N068','N068','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(.LENGTH_MEASURE(1.0E-7).,#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#28),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
