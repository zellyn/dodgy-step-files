ISO-10303-21;
/* Tb008 - NURBS knot-quantum scaled by parameter range
 * Defect: B-spline curve has knot vector (0.0, 1.0e-2, 1.0e6). Inner knot
 * 1.0e-2 is "small" relative to range 1.0e6 (relative ~1.0e-8) but "large" in
 * absolute terms. Receiver using absolute tolerance keeps the knot;
 * receiver using relative tolerance (knot-spacing/range) drops it.
 * Producers that re-parameterize curves into very large parametric
 * domains hit this regularly.
 */
HEADER;
FILE_DESCRIPTION(('Tb008 NURBS knot quantum relative-vs-absolute tolerance'),'2;1');
FILE_NAME('Tb008.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* 5 control points spread across u in [0,1.0e6]. */
#10=CARTESIAN_POINT('cp0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('cp1',(2.5E5,1.0,0.0));
#12=CARTESIAN_POINT('cp2',(5.0E5,0.5,0.0));
#13=CARTESIAN_POINT('cp3',(7.5E5,1.0,0.0));
#14=CARTESIAN_POINT('cp4',(1.0E6,0.0,0.0));
#20=B_SPLINE_CURVE_WITH_KNOTS('large_param_range',3,
  (#10,#11,#12,#13,#14),.UNSPECIFIED.,.F.,.F.,
  (4,1,4),(0.0,1.0E-2,1.0E6),.UNSPECIFIED.);
#21=VERTEX_POINT('vstart',#10);
#22=VERTEX_POINT('vend',#14);
#23=EDGE_CURVE('e',#21,#22,#20,.T.);
#30=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#31=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#32=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#33=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#30,
  'distance_accuracy_value','default_tolerance');
#40=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#33))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#30,#31,#32))
  REPRESENTATION_CONTEXT('ctx','3D'));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tb008','Tb008','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9020=GEOMETRIC_CURVE_SET('cs',(#23));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#40);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
