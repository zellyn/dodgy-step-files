ISO-10303-21;
/* N139 - ShapeAnalysis_ShapeTolerance.OuterWire.tolerance_layer_recursion
 * Defect: Tolerance validation on nested wire structures doesn't track recursion depth,
 * allowing infinite loops or stack exhaustion when tolerance scaling is applied
 * to circular wire references. Missing depth counter and cycle detection in
 * tolerance propagation chain.
 */
HEADER;
FILE_DESCRIPTION(('N139 ShapeAnalysis_ShapeTolerance.OuterWire.tolerance_layer_recursion'),'2;1');
FILE_NAME('N139.stp','2026-06-16T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Origin and axes */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
/* Nested edges to create potentially recursive tolerance scaling */
#20=CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#30=VERTEX_POINT('v1',#20);
#21=CARTESIAN_POINT('p2',(1.0,0.0,0.0));
#31=VERTEX_POINT('v2',#21);
#40=DIRECTION('edge_dir',(1.0,0.0,0.0));
#41=VECTOR('edge_vec',#40,1.0);
#42=LINE('edge1',#20,#41);
#43=EDGE_CURVE('ec1',#30,#31,#42,.T.);
/* Second edge for potential nesting */
#50=CARTESIAN_POINT('p3',(1.0,0.0,0.0));
#60=VERTEX_POINT('v3',#50);
#51=CARTESIAN_POINT('p4',(2.0,0.0,0.0));
#61=VERTEX_POINT('v4',#51);
#70=DIRECTION('edge2_dir',(1.0,0.0,0.0));
#71=VECTOR('edge2_vec',#70,1.0);
#72=LINE('edge2',#50,#71);
#73=EDGE_CURVE('ec2',#60,#61,#72,.T.);
/* Wire loop 1 */
#80=ORIENTED_EDGE('oe1',*,*,#43,.T.);
#81=ORIENTED_EDGE('oe2',*,*,#73,.T.);
#82=EDGE_LOOP('wire1',(#80,#81));
/* Face with recursion-prone tolerance nesting */
#90=PLANE('face_plane',#13,1.0);
#91=FACE_OUTER_BOUND('face_bound',#82,.T.);
#92=ADVANCED_FACE('',(#91),#90,.T.);
/* Shell */
#100=CLOSED_SHELL('shell',(#92));
/* Units and context */
#110=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#111=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#112=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#113=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#110,
  'distance_accuracy_value','nominal_tolerance');
#114=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#113))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#110,#111,#112))
  REPRESENTATION_CONTEXT('recursion_ctx','3D'));
/* Tolerance scaling multipliers that could recurse infinitely */
#115=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#110,
  'distance_accuracy_value','scaled_tolerance_layer1');
#116=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-5),#110,
  'distance_accuracy_value','scaled_tolerance_layer2');
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N139','N139','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#100));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
