/* N065 - ShapeFix_ShapeTolerance.LimitTolerance partial-tree application
 * Defect: LimitTolerance called on a compound containing both a shell and
 * a solid. The recursion stops at the shell boundary without descending into
 * the solid's interior topological elements, leaving inner faces/edges/vertices
 * un-limited. This violates the contract that all geometry receives bounded
 * tolerances.
 * Reproducer: Create compound with (1) independent shell and (2) embedded solid.
 * LimitTolerance(compound) limits shell but not solid interior.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N065 ShapeFix_ShapeTolerance LimitTolerance partial-tree'),'2;1');
FILE_NAME('N065.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* SHELL 1: Simple triangular face */
#10=CARTESIAN_POINT('sh1_p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('sh1_p1',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('sh1_p2',(0.5,1.0,0.0));
#20=VERTEX_POINT('sh1_v0',#10);
#21=VERTEX_POINT('sh1_v1',#11);
#22=VERTEX_POINT('sh1_v2',#12);
#30=LINE('',#10,#(VECTOR('',#(DIRECTION('',(1.0,0.0,0.0))),1.0)));
#31=LINE('',#11,#(VECTOR('',#(DIRECTION('',(-0.5,1.0,0.0))),1.118)));
#32=LINE('',#12,#(VECTOR('',#(DIRECTION('',(-0.5,-1.0,0.0))),1.118)));
#40=EDGE_CURVE('sh1_e0',#20,#21,#30,.T.);
#41=EDGE_CURVE('sh1_e1',#21,#22,#31,.T.);
#42=EDGE_CURVE('sh1_e2',#22,#20,#32,.T.);
#50=EDGE_LOOP('',#(#40,#41,#42));
#60=CARTESIAN_POINT('origin1',(0.0,0.0,0.0));
#61=DIRECTION('z1',(0.0,0.0,1.0));
#62=DIRECTION('x1',(1.0,0.0,0.0));
#63=AXIS2_PLACEMENT_3D('',#60,#61,#62);
#64=PLANE('',#63);
#65=FACE_OUTER_BOUND('',#50,.T.);
#66=ADVANCED_FACE('',(#65),#64,.T.);
/* SHELL 2: Cube embedded inside compound (represents solid interior) */
#70=CARTESIAN_POINT('sol_p0',(5.0,5.0,5.0));
#71=CARTESIAN_POINT('sol_p1',(6.0,5.0,5.0));
#72=CARTESIAN_POINT('sol_p2',(6.0,6.0,5.0));
#73=CARTESIAN_POINT('sol_p3',(5.0,6.0,5.0));
#74=CARTESIAN_POINT('sol_p4',(5.0,5.0,6.0));
#75=CARTESIAN_POINT('sol_p5',(6.0,5.0,6.0));
#76=CARTESIAN_POINT('sol_p6',(6.0,6.0,6.0));
#77=CARTESIAN_POINT('sol_p7',(5.0,6.0,6.0));
#80=VERTEX_POINT('sol_v0',#70);
#81=VERTEX_POINT('sol_v1',#71);
#82=VERTEX_POINT('sol_v2',#72);
#83=VERTEX_POINT('sol_v3',#73);
#84=VERTEX_POINT('sol_v4',#74);
#85=VERTEX_POINT('sol_v5',#75);
#86=VERTEX_POINT('sol_v6',#76);
#87=VERTEX_POINT('sol_v7',#77);
/* Bottom face of cube (partially represented) */
#90=LINE('',#70,#(VECTOR('',#(DIRECTION('',(1.0,0.0,0.0))),1.0)));
#91=LINE('',#71,#(VECTOR('',#(DIRECTION('',(0.0,1.0,0.0))),1.0)));
#92=LINE('',#72,#(VECTOR('',#(DIRECTION('',(-1.0,0.0,0.0))),1.0)));
#93=LINE('',#73,#(VECTOR('',#(DIRECTION('',(0.0,-1.0,0.0))),1.0)));
#100=EDGE_CURVE('sol_e0',#80,#81,#90,.T.);
#101=EDGE_CURVE('sol_e1',#81,#82,#91,.T.);
#102=EDGE_CURVE('sol_e2',#82,#83,#92,.T.);
#103=EDGE_CURVE('sol_e3',#83,#80,#93,.T.);
#104=EDGE_LOOP('',#(#100,#101,#102,#103));
#105=CARTESIAN_POINT('origin2',(5.0,5.0,5.0));
#106=DIRECTION('z2',(0.0,0.0,1.0));
#107=DIRECTION('x2',(1.0,0.0,0.0));
#108=AXIS2_PLACEMENT_3D('',#105,#106,#107);
#109=PLANE('',#108);
#110=FACE_OUTER_BOUND('',#104,.T.);
#111=ADVANCED_FACE('',(#110),#109,.T.);
/* Units and tolerances */
#200=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#201=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#202=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* High tolerance (before LimitTolerance) */
#203=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-1),#200,
  'distance_accuracy_value','');
#204=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#203))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#200,#201,#202))
  REPRESENTATION_CONTEXT('','3D'));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N065','N065','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#66,#111));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#204);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
