ISO-10303-21;
/* N144 - ShapeUpgrade_UnifySameDomain.UnionPCurves vertex_tolerance_mismatch
 * Defect: Vertex tolerance tracking fails across multi-edge chains.
 * When concatenating PCurves from edges with different vertex tolerances,
 * max_tolerance_tracking produces inconsistent results.
 * Reproducer: Two edges with vertices V1(tol=1e-3), V2(tol=1e-2) at shared vertex.
 */
HEADER;
FILE_DESCRIPTION(('N144 UnionPCurves vertex_tolerance_mismatch tracking'),'2;1');
FILE_NAME('N144.stp','2026-06-16T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Origin and axes */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
/* Shared vertex with tight tolerance */
#20=CARTESIAN_POINT('shared_vert',(5.0,0.0,0.0));
#30=VERTEX_POINT('V_shared_tight',#20);
/* Edge 1: from origin to shared vertex (V1 tight) */
#40=CARTESIAN_POINT('e1start',(0.0,0.0,0.0));
#50=VERTEX_POINT('V1_tight',#40);
#60=DIRECTION('e1dir',(1.0,0.0,0.0));
#61=VECTOR('e1vec',#60,5.0);
#62=LINE('e1line',#40,#61);
#63=EDGE_CURVE('e1',#50,#30,#62,.T.);
/* Edge 2: from shared vertex to end (V2 loose) */
#70=CARTESIAN_POINT('e2end',(10.0,0.0,0.0));
#80=VERTEX_POINT('V2_loose',#70);
#90=DIRECTION('e2dir',(1.0,0.0,0.0));
#91=VECTOR('e2vec',#90,5.0);
#92=LINE('e2line',#20,#91);
#93=EDGE_CURVE('e2',#30,#80,#92,.T.);
/* Chain concatenation: e1 -> e2
   Bug: max_tolerance_tracking at e1-e2 junction fails when
   V_shared_tight (1e-3) from e1 meets tolerance context of e2.
   Result: Concatenated PCurve has inconsistent tolerance. */
/* Units and context */
#100=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#101=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#102=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#103=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#100,
  'distance_accuracy_value','nominal_tolerance');
#104=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#103))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#100,#101,#102))
  REPRESENTATION_CONTEXT('vertex_tol_ctx','3D'));
/* Tolerance declarations */
#105=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-3),#100,
  'distance_accuracy_value','V1_tight_tolerance');
#106=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-2),#100,
  'distance_accuracy_value','V2_loose_tolerance');
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N144','N144','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#100));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
