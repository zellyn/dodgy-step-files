ISO-10303-21;
/* N141 - ShapeFix_IntersectionTool.FixIntEdges tolerance_selection
 * Defect: Vertex tolerance initialized from V1 without considering V2.
 * When V2 has higher tolerance, using V1's tolerance is insufficient.
 * Reproducer: V1 tol=0.001, V2 tol=0.01, intersection near V2.
 * Result: Intersection tolerance based on V1 (0.001) masks V2 geometry.
 */
HEADER;
FILE_DESCRIPTION(('N141 FixIntEdges tolerance_selection V1-V2 asymmetry'),'2;1');
FILE_NAME('N141.stp','2026-06-16T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Origin and axes */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
/* Edge 1 endpoints: V1 (ultra-tight tolerance=0.001) */
#20=CARTESIAN_POINT('v1a',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('v1b',(10.0,0.0,0.0));
#30=VERTEX_POINT('V1_tight',#20);
#31=VERTEX_POINT('V1b',#21);
#40=DIRECTION('e1_dir',(1.0,0.0,0.0));
#41=VECTOR('e1_vec',#40,10.0);
#42=LINE('e1_line',#20,#41);
#43=EDGE_CURVE('e1',#30,#31,#42,.T.);
/* Edge 2 endpoints: V2 (loose tolerance=0.01) */
#50=CARTESIAN_POINT('v2a',(0.0,0.001,0.0));
#51=CARTESIAN_POINT('v2b',(10.0,0.001,0.0));
#60=VERTEX_POINT('V2_loose',#50);
#61=VERTEX_POINT('V2b',#51);
#70=DIRECTION('e2_dir',(1.0,0.0,0.0));
#71=VECTOR('e2_vec',#70,10.0);
#72=LINE('e2_line',#50,#71);
#73=EDGE_CURVE('e2',#60,#61,#72,.T.);
/* Intersecting edges create intersection point near V2
   Bug: FixIntEdges uses Tolerance(V1)=0.001 for intersection result,
   but V2 tolerance=0.01 suggests the geometry may be imprecise.
   Result: Intersection tolerance insufficient for V2 context. */
/* Units and context */
#80=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#81=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#82=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#83=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#80,
  'distance_accuracy_value','nominal_tolerance');
#84=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#83))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#80,#81,#82))
  REPRESENTATION_CONTEXT('tolerance_sel_ctx','3D'));
/* Precision declarations matching defect axis
   V1 gets 0.001, V2 gets 0.01; mismatch triggers bug */
#85=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-3),#80,
  'distance_accuracy_value','V1_tight_tolerance');
#86=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-2),#80,
  'distance_accuracy_value','V2_loose_tolerance');
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N141','N141','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#80));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
