ISO-10303-21;
/* N158 - BRepBuilderAPI_Sewing.SameParameterEdge location_transform bypass
 * Defect: Omitting location transform in tolerance evaluation computes distance
 * to untransformed surface, yielding false tolerance. Surface placed with
 * translation +100mm, rotation 45° but tolerance computation ignores placement.
 */
HEADER;
FILE_DESCRIPTION(('N158 location_transform_in_tolerance_eval bypass'),'2;1');
FILE_NAME('N158.stp','2026-06-16T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc_identity',#10,#11,#12);
#20=CARTESIAN_POINT('origin_shifted',(100.0,0.0,0.0));
#21=DIRECTION('z_rot',(0.0,0.0,1.0));
#22=DIRECTION('x_rot',(0.7071,0.7071,0.0));
#23=AXIS2_PLACEMENT_3D('plc_rotated',#20,#21,#22);
#30=CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#31=CARTESIAN_POINT('p2',(1.0,0.0,0.0));
#40=VERTEX_POINT('v1',#30);
#41=VERTEX_POINT('v2',#31);
#50=DIRECTION('dir',(1.0,0.0,0.0));
#51=VECTOR('vec',#50,1.0);
#52=LINE('lin',#30,#51);
#53=EDGE_CURVE('edge_untransformed',#40,#41,#52,.T.);
#60=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#61=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#62=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#63=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#60,
  'distance_accuracy_value','nominal_tolerance');
#64=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#63))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#60,#61,#62))
  REPRESENTATION_CONTEXT('location_ctx','3D'));
#65=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.01),#60,
  'distance_accuracy_value','true_tolerance');
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N158','N158','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#60));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
