/* N125 — ShapeAnalysis_ShapeTolerance.AddTolerance concurrent-modification
 * Defect: AddTolerance iterates and modifies the shape's tolerance map;
 * if called on active iterator or in compound with external references,
 * concurrent modification corrupts topology or produces inconsistent state.
 * Geometry: compound with shared face references; tolerance map mutation.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N125 AddTolerance concurrent modification corruption'),'2;1');
FILE_NAME('N125.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#6=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#7=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#8=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Shared vertices for multi-face geometry */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('x1',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('y1',(0.0,1.0,0.0));
#13=CARTESIAN_POINT('z1',(0.0,0.0,1.0));
#14=CARTESIAN_POINT('xy1',(1.0,1.0,0.0));
#15=CARTESIAN_POINT('xz1',(1.0,0.0,1.0));
#16=CARTESIAN_POINT('yz1',(0.0,1.0,1.0));
#17=CARTESIAN_POINT('xyz1',(1.0,1.0,1.0));
#20=VERTEX_POINT('v0',#10);
#21=VERTEX_POINT('v1',#11);
#22=VERTEX_POINT('v2',#12);
#23=VERTEX_POINT('v3',#13);
#24=VERTEX_POINT('v4',#14);
#25=VERTEX_POINT('v5',#15);
#26=VERTEX_POINT('v6',#16);
#27=VERTEX_POINT('v7',#17);
/* Shared edge curves */
#30=DIRECTION('x',(1.0,0.0,0.0));
#31=DIRECTION('y',(0.0,1.0,0.0));
#32=DIRECTION('z',(0.0,0.0,1.0));
#40=VECTOR('vx',#30,1.0);
#41=VECTOR('vy',#31,1.0);
#42=VECTOR('vz',#32,1.0);
#50=LINE('lx',#10,#40);
#51=LINE('ly',#10,#41);
#52=LINE('lz',#10,#42);
#60=EDGE_CURVE('ex',#20,#21,#50,.T.);
#61=EDGE_CURVE('ey',#20,#22,#51,.T.);
#62=EDGE_CURVE('ez',#20,#23,#52,.T.);
/* Three planes for three faces (all share edges) */
#70=CARTESIAN_POINT('px0',(0.0,0.0,0.0));
#71=DIRECTION('pz',(0.0,0.0,1.0));
#72=DIRECTION('px',(1.0,0.0,0.0));
#73=AXIS2_PLACEMENT_3D('pax',#70,#71,#72);
#74=PLANE('plane_z',#73);
#75=CARTESIAN_POINT('py0',(0.0,0.0,0.0));
#76=DIRECTION('pz2',(0.0,1.0,0.0));
#77=DIRECTION('px2',(1.0,0.0,0.0));
#78=AXIS2_PLACEMENT_3D('pay',#75,#76,#77);
#79=PLANE('plane_y',#78);
#80=CARTESIAN_POINT('pz0',(0.0,0.0,0.0));
#81=DIRECTION('py3',(0.0,1.0,0.0));
#82=DIRECTION('pz3',(0.0,0.0,1.0));
#83=AXIS2_PLACEMENT_3D('paz',#80,#81,#82);
#84=PLANE('plane_x',#83);
/* Face 1: XY plane */
#100=ORIENTED_EDGE('oe1',*,*,#60,.T.);
#101=ORIENTED_EDGE('oe2',*,*,#61,.T.);
#102=EDGE_LOOP('loop1',(#100,#101));
#103=FACE_OUTER_BOUND('',#102,.T.);
#104=ADVANCED_FACE('face1',(#103),#74,.T.);
/* Face 2: XZ plane (shares edge #60 and #62) */
#110=ORIENTED_EDGE('oe3',*,*,#60,.T.);
#111=ORIENTED_EDGE('oe4',*,*,#62,.T.);
#112=EDGE_LOOP('loop2',(#110,#111));
#113=FACE_OUTER_BOUND('',#112,.T.);
#114=ADVANCED_FACE('face2',(#113),#79,.T.);
/* Face 3: YZ plane (shares edge #61 and #62) */
#120=ORIENTED_EDGE('oe5',*,*,#61,.F.);
#121=ORIENTED_EDGE('oe6',*,*,#62,.F.);
#122=EDGE_LOOP('loop3',(#120,#121));
#123=FACE_OUTER_BOUND('',#122,.T.);
#124=ADVANCED_FACE('face3',(#123),#84,.T.);
/* Shell with shared geometry */
#130=SHELL_BASED_SURFACE_MODEL('shared_shell',(#104,#114,#124));
/* Tolerance context with multiple assigned uncertainties */
#200=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#6,
  'distance_accuracy_value','vertex_tol');
#201=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-5),#6,
  'distance_accuracy_value','edge_tol');
#202=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-4),#6,
  'distance_accuracy_value','face_tol');
#210=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#200,#201,#202))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#6,#7,#8))
  REPRESENTATION_CONTEXT('shared_faces','3D'));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N125','N125','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#104,#114,#124));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
