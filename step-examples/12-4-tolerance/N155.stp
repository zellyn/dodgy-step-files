ISO-10303-21;
/* N155 - ShapeAnalysis_CheckSmallFace.CheckPin.tolerance-fallback
 * Defect: Falls back to default tolerance if precision is negative.
 * Reproducer: CheckPin with myPrecision = -1 (invalid). Without fallback, IsoStat uses invalid.
 * Expected: toler = 1.0e-4 fallback used for valid comparisons. Without: spurious results.
 * Test: precision fallback guards against negative precision in sharpness tests.
 */
HEADER;
FILE_DESCRIPTION(('N155 tolerance-fallback'),'2;1');
FILE_NAME('N155.stp','2026-06-16T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Origin and axes */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
/* Small face point cloud */
#20=CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('p2',(0.001,0.0,0.0));
#22=CARTESIAN_POINT('p3',(0.0,0.001,0.0));
#23=CARTESIAN_POINT('p4',(0.001,0.001,0.0));
/* Vertices for small face */
#30=VERTEX_POINT('v1',#20);
#31=VERTEX_POINT('v2',#21);
#32=VERTEX_POINT('v3',#22);
#33=VERTEX_POINT('v4',#23);
/* Edges (1mm square) */
#40=DIRECTION('dir_x',(1.0,0.0,0.0));
#41=VECTOR('vec_x',#40,0.001);
#42=LINE('line_x',#20,#41);
#43=EDGE_CURVE('edge_x',#30,#31,#42,.T.);
#50=DIRECTION('dir_y',(0.0,1.0,0.0));
#51=VECTOR('vec_y',#50,0.001);
#52=LINE('line_y',#21,#51);
#53=EDGE_CURVE('edge_y',#31,#33,#52,.T.);
#60=DIRECTION('dir_x_neg',(-1.0,0.0,0.0));
#61=VECTOR('vec_x_neg',#60,0.001);
#62=LINE('line_x_neg',#33,#61);
#63=EDGE_CURVE('edge_x_neg',#33,#32,#62,.T.);
#70=DIRECTION('dir_y_neg',(0.0,-1.0,0.0));
#71=VECTOR('vec_y_neg',#70,0.001);
#72=LINE('line_y_neg',#32,#71);
#73=EDGE_CURVE('edge_y_neg',#32,#30,#72,.T.);
/* Tolerance markers */
#80=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#81=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#82=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#83=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#80,
  'distance_accuracy_value','nominal_tolerance');
#84=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(-1.0),#80,
  'distance_accuracy_value','invalid_negative_precision');
#85=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-4),#80,
  'distance_accuracy_value','fallback_tolerance_default');
#86=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#83))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#80,#81,#82))
  REPRESENTATION_CONTEXT('fallback_ctx','3D'));
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N155','N155','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#80));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
