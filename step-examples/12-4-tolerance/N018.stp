ISO-10303-21;
/* N018 - representation_context null/wrong type -> fall back to read.precision
 * Defect: When a STEP file lacks a recognizable
 * geometric_representation_context_with_uncertainty (or attaches the wrong
 * type), OCCT falls back to the read.precision.val parameter without warning.
 * Models from such files all share whatever precision the user happened to
 * configure, regardless of source.
 * Reproducer: file uses bare GEOMETRIC_REPRESENTATION_CONTEXT (no
 * GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT), so receivers must invent a tolerance.
 */
HEADER;
FILE_DESCRIPTION(('N018 representation_context lacks uncertainty fallback'),'2;1');
FILE_NAME('N018.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(15.0,0.0,0.0));
#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
#30=DIRECTION('+x',(1.0,0.0,0.0));
#31=VECTOR('',#30,15.0);
#32=LINE('',#10,#31);
#40=EDGE_CURVE('no_uncertainty_edge',#20,#21,#32,.T.);
#50=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#51=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#52=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Defect site: bare GEOMETRIC_REPRESENTATION_CONTEXT without
 * GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT subtype -- the producer never declared
 * its working precision; receivers fall back silently to read.precision.val. */
#60=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52))
  REPRESENTATION_CONTEXT('ctx_no_uncertainty','3D'));
ENDSEC;
END-ISO-10303-21;
