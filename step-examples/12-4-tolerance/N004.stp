/* N004 - Edge SameParameter flag inconsistent with 3D-vs-pcurve deviation
 * Defect: An edge marked SameParameter=.T. claims its 3D curve and 2D pcurve
 * agree at every parameter, but ShapeAnalysis_Edge::CheckSameParameter would
 * report max deviation exceeding edge tolerance. Flag was set without
 * re-validation after geometry edits.
 * Reproducer: EDGE_CURVE on a planar surface with both 3D BSpline and pcurve;
 * pcurve was reprojected at different sampling so it disagrees with 3D curve
 * at parametric midpoint by ~5e-3 mm, yet same_sense=.T. is asserted.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N004 SameParameter flag inconsistent with deviation'),'2;1');
FILE_NAME('N004.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('o',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plane_plc',#10,#11,#12);
#14=PLANE('host_plane',#13);
#20=CARTESIAN_POINT('v0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('v1',(10.0,0.0,0.0));
#22=VERTEX_POINT('',#20);
#23=VERTEX_POINT('',#21);
/* 3D curve: straight line along x */
#30=DIRECTION('+x',(1.0,0.0,0.0));
#31=VECTOR('',#30,10.0);
#32=LINE('3d_line',#20,#31);
/* 2D pcurve: line in (u,v) but offset; 3D-vs-pcurve max deviation ~5e-3 */
#40=CARTESIAN_POINT('uv0',(0.0,0.005));
#41=DIRECTION('uv_dir',(1.0,0.0));
#42=VECTOR('',#41,10.0);
#43=LINE('pcurve_offset',#40,#42);
#44=DEFINITIONAL_REPRESENTATION('',(#43),#13);
#45=PCURVE('pc',#14,#44);
/* Defect site: same_sense=.T. asserted despite measurable deviation */
#50=SURFACE_CURVE('sc',#32,(#45),.PCURVE_S1.);
#51=EDGE_CURVE('SameParameter_lie',#22,#23,#50,.T.);
#60=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#61=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#62=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#63=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#60,
  'distance_accuracy_value','declared_edge_tolerance');
#64=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#63))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#60,#61,#62))
  REPRESENTATION_CONTEXT('ctx','3D'));
ENDSEC;
END-ISO-10303-21;
