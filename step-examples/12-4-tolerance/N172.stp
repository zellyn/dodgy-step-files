ISO-10303-21;
/* N172: seq-set-tolerance 'outside acceptable band' clamp subvariant, on a live face */
/* DEFECT: bottom-left vertex displaced 0.05mm from its edge's authored LINE -- reader */
/* tolerance-inflation bumps that vertex to ~0.05mm, far outside any realistic settol band */
HEADER;
FILE_DESCRIPTION(('N172: seq-set-tolerance outside-band clamp subvariant, live face'),'2;1');
FILE_NAME('N172.stp','2026-07-12T00:00:00',(''),(''),'cad-research-suite','','');
