ISO-10303-21;
/* N146 - BRepBuilderAPI_Sewing.EvaluateDistances.zero_angle_count_guard
 * Defect: Recording average angular deviation with zero valid angles
 * produces NaN or division-by-zero; avg = cumulateAngular / 0.
 * Without if(nbComputedAngle) guard, degenerate surface (zero D1 partial
 * derivatives) triggers division by zero at line 1266, yielding undefined result.
 * Reproducer: Create surface with zero-magnitude normal (plane/point-like),
 * call EvaluateAngulars with edges on this surface. Expected: tabAng remains -1.
 * Actual (defect): tabAng(i) becomes NaN or infinity.
 */
HEADER;
FILE_DESCRIPTION(('N146 zero_angle_count_guard'),'2;1');
FILE_NAME('N146.stp','2026-06-16T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Origin and axes */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
/* Degenerate plane (zero D1 partial derivatives in one direction)
   represents surface with singular normal computation */
#20=CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('p2',(1.0,0.0,0.0));
#22=DIRECTION('dir1',(1.0,0.0,0.0));
#23=VECTOR('vec1',#22,1.0);
#24=LINE('line_seg1',#20,#23);
#30=VERTEX_POINT('v1',#20);
#31=VERTEX_POINT('v2',#21);
/* Edge on degenerate surface: triggers nbComputedAngle=0 path */
#40=EDGE_CURVE('edge_degen',#30,#31,#24,.T.);
/* Second edge for angular evaluation (also degenerate context) */
#50=CARTESIAN_POINT('p3',(0.0,1.0,0.0));
#51=CARTESIAN_POINT('p4',(1.0,1.0,0.0));
#52=DIRECTION('dir2',(1.0,0.0,0.0));
#53=VECTOR('vec2',#52,1.0);
#54=LINE('line_seg2',#50,#53);
#60=VERTEX_POINT('v3',#50);
#61=VERTEX_POINT('v4',#51);
#62=EDGE_CURVE('edge_degen2',#60,#61,#54,.T.);
/* Units and tolerance */
#80=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#81=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#82=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#83=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#80,
  'distance_accuracy_value','nominal_tolerance');
#84=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#83))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#80,#81,#82))
  REPRESENTATION_CONTEXT('degen_ctx','3D'));
/* Precision marker: nbComputedAngle=0 condition */
#85=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.0),#80,
  'distance_accuracy_value','zero_normal_magnitude');
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N146','N146','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#80));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
