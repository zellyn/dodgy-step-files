ISO-10303-21;
/* N026 - Cross-kernel topology rejection: source-valid, target-invalid by tolerance bookkeeping
 * Defect: Production kernels (Parasolid, ACIS, CGM) define validity
 * differently. ACIS may export a body with a tolerant edge of tolerance 5.0e-4;
 * Parasolid demands geometric intersection within 1.0e-6 and rejects the edge.
 * Reproducer: ACIS-style file declares per-edge tolerance 5.0e-4 mm while
 * the global file uncertainty is 1.0e-6 mm; receiving Parasolid pipeline
 * cannot accommodate the loose edge tolerance.
 */
HEADER;
FILE_DESCRIPTION(('N026 cross-kernel mixed precision ACIS->Parasolid rejection'),'2;1');
FILE_NAME('N026.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(10.0,0.0,0.0));
#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
#30=DIRECTION('+x',(1.0,0.0,0.0));
#31=VECTOR('',#30,10.0);
#32=LINE('',#10,#31);
/* ACIS-style "tolerant edge" tolerance attached to the edge */
#40=EDGE_CURVE('acis_tolerant_edge_5e-4',#20,#21,#32,.T.);
#50=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#51=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#52=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Mixed working precisions: file global 1.0e-6 (Parasolid-friendly),
 * but per-entity 5.0e-4 (ACIS-style tolerant edge). Target Parasolid kernel
 * would reject the looser per-edge tolerance. */
#60=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#50,
  'distance_accuracy_value','file_global_parasolid_friendly');
#61=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(5.0E-4),#50,
  'distance_accuracy_value','acis_tolerant_edge_per_entity');
#70=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#60,#61))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52))
  REPRESENTATION_CONTEXT('ctx','3D'));
ENDSEC;
END-ISO-10303-21;
