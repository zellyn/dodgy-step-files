ISO-10303-21;
/* N020: KiCad BOARD_OFFSET: 3×AXIS2_PLACEMENT_3D; board at z=0, component placement at z=0, hard-coded offset at z=0.05; wireframe-only; GEOMETRIC_CURVE_SET — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('N020'),'2;1');
FILE_NAME('N020.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('board_ref_origin',(0.0,0.0,0.0));
#2=DIRECTION('',(0.0,0.0,1.0));
#3=DIRECTION('',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('board_ref',#1,#2,#3);
#5=CARTESIAN_POINT('comp_nominal_origin',(5.0,3.0,0.0));
#6=DIRECTION('',(0.0,0.0,1.0));
#7=DIRECTION('',(1.0,0.0,0.0));
#8=AXIS2_PLACEMENT_3D('comp_nominal',#5,#6,#7);
