FILE_DESCRIPTION(('N163'),'2;1');
FILE_NAME('N163.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('p_start',(0.0,0.0,0.0));
#2=CARTESIAN_POINT('p_end_1mm',(1.0,0.0,0.0));
#3=VERTEX_POINT('v_start',#1);
#4=VERTEX_POINT('v_end',#2);
#5=DIRECTION('',(1.0,0.0,0.0));
#6=VECTOR('',#5,1.0);
#7=LINE('',#1,#6);
