ISO-10303-21;
/* N163: precision_tolerance mixed-unit-scale: 1mm edge; tol declared 1e-7 (as metres = 1e-4 mm); 10000x discrepancy against mm coords; GEOMETRIC_CURVE_SET — OCC yields empty */
