ISO-10303-21;
/* N062 — ShapeAnalysis_ShapeTolerance.GlobalTolerance min/max dispatch
 * Defect: GlobalTolerance with mode=-1 (minimum) returns inconsistent results when
 * the input shape contains both VERTEX and EDGE with identical tolerance values.
 * The tie-breaking logic is order-dependent and affected by topological traversal
 * order.
 * Expected behavior: GlobalTolerance(mode=-1) should consistently return 1.0e-3;
 * actual behavior depends on traversal order.
 */
HEADER;
FILE_DESCRIPTION(('N062 ShapeAnalysis_ShapeTolerance min/max dispatch bug'),'2;1');
FILE_NAME('N062.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* 4-vertex square face (1x1) with edges and vertices all declaring 1.0e-3 tolerance */
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('p2',(1.0,1.0,0.0));
#13=CARTESIAN_POINT('p3',(0.0,1.0,0.0));
#20=VERTEX_POINT('v0',#10);
#21=VERTEX_POINT('v1',#11);
#22=VERTEX_POINT('v2',#12);
#23=VERTEX_POINT('v3',#13);
/* 4 edges of square */
#30=DIRECTION('d_e0',(1.0,0.0,0.0));
#31=VECTOR('vec_e0',#30,1.0);
#32=LINE('line_e0',#10,#31);
#33=EDGE_CURVE('e0',#20,#21,#32,.T.);
#34=DIRECTION('d_e1',(0.0,1.0,0.0));
#35=VECTOR('vec_e1',#34,1.0);
#36=LINE('line_e1',#11,#35);
#37=EDGE_CURVE('e1',#21,#22,#36,.T.);
#38=DIRECTION('d_e2',(-1.0,0.0,0.0));
#39=VECTOR('vec_e2',#38,1.0);
#40=LINE('line_e2',#12,#39);
#41=EDGE_CURVE('e2',#22,#23,#40,.T.);
#42=DIRECTION('d_e3',(0.0,-1.0,0.0));
#43=VECTOR('vec_e3',#42,1.0);
#44=LINE('line_e3',#13,#43);
#45=EDGE_CURVE('e3',#23,#20,#44,.T.);
/* Wire: loop of 4 oriented edges */
#46=ORIENTED_EDGE('',*,*,#33,.T.);
#47=ORIENTED_EDGE('',*,*,#37,.T.);
#48=ORIENTED_EDGE('',*,*,#41,.T.);
#49=ORIENTED_EDGE('',*,*,#45,.T.);
#50=EDGE_LOOP('',(#46,#47,#48,#49));
/* Plane surface */
#60=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#61=DIRECTION('z',(0.0,0.0,1.0));
#62=DIRECTION('x',(1.0,0.0,0.0));
#63=AXIS2_PLACEMENT_3D('',#60,#61,#62);
#64=PLANE('',#63);
/* Face on plane */
#65=FACE_OUTER_BOUND('',#50,.T.);
#66=ADVANCED_FACE('',(#65),#64,.T.);
#67=CLOSED_SHELL('shell',(#66));
/* Units and TWO tolerance declarations with same value (1.0e-3) */
#100=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#101=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#102=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Vertex tolerance: 1.0e-3 */
#103=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-3),#100,
  'distance_accuracy_value','vertex_tolerance');
/* Edge tolerance: 1.0e-3 (tie condition) */
#104=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-3),#100,
  'distance_accuracy_value','edge_tolerance');
#105=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#103,#104))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#100,#101,#102))
  REPRESENTATION_CONTEXT('','3D'));
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N062','N062','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#67));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
