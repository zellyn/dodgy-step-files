ISO-10303-21;
/* Tb006 - Edge length sub-tolerance squared in 2D pcurve domain
 * Defect: Pcurve U-domain length is exactly 1e-4 on a face whose declared
 * uncertainty is 1e-3. A kernel comparing pcurve domain to sqrt(tol)
 * (~3.16e-2) keeps the edge alive. A kernel comparing to tol*tol = 1e-6
 * declares it degenerate and drops the pcurve. The two policies disagree
 * on whether the edge has a usable parametric representation.
 */
HEADER;
FILE_DESCRIPTION(('Tb006 pcurve domain at sqrt-tolerance threshold'),'2;1');
FILE_NAME('Tb006.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Face on PLANE. */
#10=CARTESIAN_POINT('o',(0.0,0.0,0.0));
#11=DIRECTION('+z',(0.0,0.0,1.0));
#12=DIRECTION('+x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
#14=PLANE('s',#13);
/* Edge with 3D length 1e-4 and pcurve U-range 1e-4. */
#20=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('p1',(1.0E-4,0.0,0.0));
#30=VERTEX_POINT('',#20);
#31=VERTEX_POINT('',#21);
#40=DIRECTION('+x_3d',(1.0,0.0,0.0));
#41=VECTOR('vx_short',#40,1.0E-4);
#42=LINE('line3d',#20,#41);
/* Pcurve: 2D line in UV with same parameter range 0..1e-4 */
#43=CARTESIAN_POINT('uv0',(0.0,0.0));
#44=DIRECTION('+u',(1.0,0.0));
#45=VECTOR('vu_short',#44,1.0E-4);
#46=LINE('pcurve_line',#43,#45);
#47=DEFINITIONAL_REPRESENTATION('pcurve_def',(#46),#80);
#48=PCURVE('pc',#14,#47);
#49=SURFACE_CURVE('sc',#42,(#48),.PCURVE_S1.);
#50=EDGE_CURVE('e_subtolsq',#30,#31,#49,.T.);
/* Trim the surface to the tiny edge region. */
#60=RECTANGULAR_TRIMMED_SURFACE('trim',#14,0.0,1.0E-4,0.0,1.0E-4,.T.,.T.);
/* Defect-class threshold: declared 1e-3 -> tol*tol = 1e-6 (drop) vs
 * sqrt(tol) ~ 3.16e-2 (keep). Edge length 1e-4 sits between. */
#70=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#71=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#72=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#73=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-3),#70,
  'distance_accuracy_value','tolerance_at_pcurve_sqrt_threshold');
#80=(GEOMETRIC_REPRESENTATION_CONTEXT(2)
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#70,#71,#72))
  REPRESENTATION_CONTEXT('uv_ctx','2D'));
#90=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#73))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#70,#71,#72))
  REPRESENTATION_CONTEXT('ctx_3d','3D'));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tb006','Tb006','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9020=GEOMETRIC_CURVE_SET('curveset',(#50,#60));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#90);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
