ISO-10303-21;
/* N057 - ShapeAnalysis_ShapeTolerance.GlobalTolerance weight dispatch inversion
 * Defect: GlobalTolerance(shape, type, 0=avg) returns weighted average; weight
 * assignment by shape-type membership inverts when shapes are nested (shell's
 * faces counted twice). When a compound contains a shell, and the shell contains
 * faces, the weight calculation counts faces twice: once directly from the shell
 * iteration and again as subshapes of the shell. This causes the average
 * tolerance to be skewed toward face tolerances, violating the semantic that
 * GlobalTolerance should give unbiased average across all geometry. */
HEADER;
FILE_DESCRIPTION(('N057 - GlobalTolerance nested-weight inversion'),'2;1');
FILE_NAME('N057.stp','2026-06-15T00:00:00',('auto-generated'),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Two faces with different tolerances */
/* Face 1: tolerance ~0.001 */
#10=CARTESIAN_POINT('p1_1',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1_2',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('p1_3',(1.0,1.0,0.0));
#13=CARTESIAN_POINT('p1_4',(0.0,1.0,0.0));
#20=VERTEX_POINT('v1_1',#10);
#21=VERTEX_POINT('v1_2',#11);
#22=VERTEX_POINT('v1_3',#12);
#23=VERTEX_POINT('v1_4',#13);
#30=LINE('',(#10,#21));
#31=EDGE_CURVE('e1_1',#20,#21,#30,.T.);
#40=LINE('',(#11,#22));
#41=EDGE_CURVE('e1_2',#21,#22,#40,.T.);
#50=LINE('',(#12,#23));
#51=EDGE_CURVE('e1_3',#22,#23,#50,.T.);
#60=LINE('',(#13,#10));
#61=EDGE_CURVE('e1_4',#23,#20,#60,.T.);
#70=ORIENTED_EDGE('',*,*,#31,.T.);
#71=ORIENTED_EDGE('',*,*,#41,.T.);
#72=ORIENTED_EDGE('',*,*,#51,.T.);
#73=ORIENTED_EDGE('',*,*,#61,.T.);
#74=EDGE_LOOP('',(#70,#71,#72,#73));
#75=FACE_OUTER_BOUND('',#74,.T.);
#80=DIRECTION('',(0.0,0.0,1.0));
#81=DIRECTION('',(1.0,0.0,0.0));
#82=AXIS2_PLACEMENT_3D('ax3_f1',#10,#80,#81);
#83=PLANE('plane_f1',#82);
#84=ADVANCED_FACE('face_1',(#75),#83,.T.);
/* Face 2: tolerance ~0.008 (higher) */
#100=CARTESIAN_POINT('p2_1',(0.0,0.0,1.0));
#101=CARTESIAN_POINT('p2_2',(1.0,0.0,1.0));
#102=CARTESIAN_POINT('p2_3',(1.0,1.0,1.0));
#103=CARTESIAN_POINT('p2_4',(0.0,1.0,1.0));
#110=VERTEX_POINT('v2_1',#100);
#111=VERTEX_POINT('v2_2',#101);
#112=VERTEX_POINT('v2_3',#102);
#113=VERTEX_POINT('v2_4',#103);
#120=LINE('',(#100,#111));
#121=EDGE_CURVE('e2_1',#110,#111,#120,.T.);
#130=LINE('',(#101,#112));
#131=EDGE_CURVE('e2_2',#111,#112,#130,.T.);
#140=LINE('',(#102,#113));
#141=EDGE_CURVE('e2_3',#112,#113,#140,.T.);
#150=LINE('',(#103,#100));
#151=EDGE_CURVE('e2_4',#113,#110,#150,.T.);
#160=ORIENTED_EDGE('',*,*,#121,.T.);
#161=ORIENTED_EDGE('',*,*,#131,.T.);
#162=ORIENTED_EDGE('',*,*,#141,.T.);
#163=ORIENTED_EDGE('',*,*,#151,.T.);
#164=EDGE_LOOP('',(#160,#161,#162,#163));
#165=FACE_OUTER_BOUND('',#164,.T.);
#170=DIRECTION('',(0.0,0.0,1.0));
#171=DIRECTION('',(1.0,0.0,0.0));
#172=AXIS2_PLACEMENT_3D('ax3_f2',#100,#170,#171);
#173=PLANE('plane_f2',#172);
#174=ADVANCED_FACE('face_2',(#165),#173,.T.);
/* Shell containing both faces: when GlobalTolerance(shell) is called,
   iteration counts face_1 and face_2. But if the shape is a compound containing
   the shell, nested iteration may double-count. Average should be (0.001 + 0.008)/2
   = 0.0045, but weight inversion causes face contributions to be overweighted. */
#180=CLOSED_SHELL('',(#84,#174));
/* PRODUCT chain with tolerance context */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N057','N057','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#180));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
