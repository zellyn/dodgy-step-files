ISO-10303-21;
/* Tb022 - Tolerance declared in different units than coordinates
 * Defect: GEOMETRIC_REPRESENTATION_CONTEXT length unit is .MILLI..METRE.
 * (mm). UNCERTAINTY_MEASURE_WITH_UNIT uses a separate inline LENGTH_UNIT
 * of .METRE. (m) with value 1.0E-6. Receiver applying the uncertainty in
 * context units (mm): tolerance = 1e-6 mm = 1 nm (hyper-precise).
 * Receiver applying the uncertainty's own unit binding (m): tolerance =
 * 1e-6 m = 1 um = 1e-3 mm (1000x looser). Same file, 1000x difference
 * in working tolerance.
 */
HEADER;
FILE_DESCRIPTION(('Tb022 tolerance unit binding mismatch mm vs m'),'2;1');
FILE_NAME('Tb022.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(10.0,0.0,0.0));
#20=VERTEX_POINT('v0',#10);
#21=VERTEX_POINT('v1',#11);
#30=DIRECTION('+x',(1.0,0.0,0.0));
#31=VECTOR('vx',#30,10.0);
#32=LINE('l',#10,#31);
#40=EDGE_CURVE('e',#20,#21,#32,.T.);
/* Context units: mm. */
#50=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#51=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#52=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Uncertainty's own unit: separate LENGTH_UNIT in .METRE. (m, not mm). */
#53=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT($,.METRE.));
#60=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#53,
  'distance_accuracy_value','tolerance_in_metres_not_context_mm');
#70=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#60))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52))
  REPRESENTATION_CONTEXT('ctx_mm_with_metre_uncertainty','3D'));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tb022','Tb022','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9020=GEOMETRIC_CURVE_SET('cs',(#40));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#70);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
