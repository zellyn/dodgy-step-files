ISO-10303-21;
/* N037 - Curve gaps between adjacent segments after format conversion (LOTAR exchange defect)
 * Defect: After format conversion the endpoints of adjacent 3D curve segments
 * along a wire no longer meet within geometric tolerance -- a class introduced
 * *by translation*, not present in the native model. Source seam tolerance
 * 1e-3 through a kernel that demands 1e-5 leaves position, cross-tangent,
 * and cross-curvature gaps.
 * Reproducer: two consecutive B_SPLINE_CURVE_WITH_KNOTS segments where end
 * control points of segment N do not equal start control points of segment
 * N+1 within the file's geometric_representation_context tolerance.
 */
HEADER;
FILE_DESCRIPTION(('N037 curve segment gap after format conversion LOTAR'),'2;1');
FILE_NAME('N037.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Segment 1 control points end at (5.0, 0.0, 0.0). */
#10=CARTESIAN_POINT('s1_cp0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('s1_cp1',(2.5,1.0,0.0));
#12=CARTESIAN_POINT('s1_cp2',(5.0,0.0,0.0));
/* Segment 2 control points START at (5.0001, 0.0, 0.0)  -- 1e-4 gap from s1 end */
#13=CARTESIAN_POINT('s2_cp0_GAP',(5.0001,0.0,0.0));
#14=CARTESIAN_POINT('s2_cp1',(7.5,-1.0,0.0));
#15=CARTESIAN_POINT('s2_cp2',(10.0,0.0,0.0));
#20=B_SPLINE_CURVE_WITH_KNOTS('seg1',2,(#10,#11,#12),
  .UNSPECIFIED.,.F.,.F.,(3,3),(0.0,1.0),.UNSPECIFIED.);
/* Defect site: control point at start of seg2 != end of seg1 within tol */
#21=B_SPLINE_CURVE_WITH_KNOTS('seg2',2,(#13,#14,#15),
  .UNSPECIFIED.,.F.,.F.,(3,3),(0.0,1.0),.UNSPECIFIED.);
#30=VERTEX_POINT('s1_start',#10);
#31=VERTEX_POINT('s1_end',#12);
#32=VERTEX_POINT('s2_start_off',#13);
#33=VERTEX_POINT('s2_end',#15);
#40=EDGE_CURVE('seg1_edge',#30,#31,#20,.T.);
#41=EDGE_CURVE('seg2_edge_with_gap',#32,#33,#21,.T.);
#50=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#51=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#52=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Receiver kernel demands 1e-5 -- 1e-4 gap fails its tolerance budget */
#60=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-5),#50,
  'distance_accuracy_value','target_kernel_tighter_than_source_seam');
#70=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#60))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52))
  REPRESENTATION_CONTEXT('ctx','3D'));
ENDSEC;
END-ISO-10303-21;
