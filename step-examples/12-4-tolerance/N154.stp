ISO-10303-21;
/* N154 - ShapeUpgrade_UnifySameDomain.MergeSubSeq.circle_spatial_closure_tolerance
 * Defect: Fallback closure detection using spatial distance and per-vertex tolerance.
 * Reproducer: Circle arc V0,...,V1 where V0.IsSame(V1)=false but Pnt distance ~1.0e-8.
 * Expected: isClosed=true (spatially closed within tolerance). Without: open chain.
 * Test: tolerance-aware spatial check ensures closure at precision limit.
 */
HEADER;
FILE_DESCRIPTION(('N154 circle_spatial_closure_tolerance'),'2;1');
FILE_NAME('N154.stp','2026-06-16T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Origin and axes */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
/* Circle start point (topologically distinct from end) */
#20=CARTESIAN_POINT('circle_start',(1.0,0.0,0.0));
#21=VERTEX_POINT('v_circle_start',#20);
/* Circle mid point */
#30=CARTESIAN_POINT('circle_mid',(0.0,1.0,0.0));
#31=VERTEX_POINT('v_circle_mid',#30);
/* Circle end point (spatially ~1.0e-8 away from start, topologically distinct) */
#40=CARTESIAN_POINT('circle_end',(1.0E-8,1.0E-8,0.0));
#41=VERTEX_POINT('v_circle_end',#40);
/* Arc 1: start to mid */
#50=DIRECTION('arc1_dir',(0.0,1.0,0.0));
#51=VECTOR('arc1_vec',#50,1.0);
#52=LINE('arc1_line',#20,#51);
#53=EDGE_CURVE('arc1',#21,#31,#52,.T.);
/* Arc 2: mid to end (creates closure gap) */
#60=DIRECTION('arc2_dir',(0.0,-1.0,0.0));
#61=VECTOR('arc2_vec',#60,1.0);
#62=LINE('arc2_line',#30,#61);
#63=EDGE_CURVE('arc2',#31,#41,#62,.T.);
/* Tolerance markers */
#80=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#81=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#82=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#83=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#80,
  'distance_accuracy_value','nominal_tolerance');
#84=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-8),#80,
  'distance_accuracy_value','point_distance_gap');
#85=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#80,
  'distance_accuracy_value','closure_tolerance');
#86=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#83))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#80,#81,#82))
  REPRESENTATION_CONTEXT('closure_tolerance_ctx','3D'));
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N154','N154','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#80));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
