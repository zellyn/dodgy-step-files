/* N123 — BRepLib.UpdateEdgeTol with-edge-on-degenerate-surface
 * Defect: edge on a surface with zero-area parametric domain; UpdateEdgeTol's
 * sampling produces division-by-zero or numeric singularity when normalizing
 * parametric delta or computing surface derivatives on degenerate patches.
 * Geometry: cone apex (degenerate parametric region).
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N123 UpdateEdgeTol degenerate surface division-by-zero'),'2;1');
FILE_NAME('N123.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#6=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#7=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#8=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Cone apex vertices (degenerate point) */
#10=CARTESIAN_POINT('apex',(0.0,0.0,10.0));
#11=CARTESIAN_POINT('base1',(5.0,0.0,0.0));
#12=CARTESIAN_POINT('base2',(0.0,5.0,0.0));
#13=CARTESIAN_POINT('base3',(-5.0,0.0,0.0));
#20=VERTEX_POINT('v_apex',#10);
#21=VERTEX_POINT('v_b1',#11);
#22=VERTEX_POINT('v_b2',#12);
#23=VERTEX_POINT('v_b3',#13);
/* Lines from apex to base */
#30=DIRECTION('apex_to_b1',(5.0,-0.0,-10.0));
#31=DIRECTION('apex_to_b2',(-0.0,5.0,-10.0));
#32=DIRECTION('apex_to_b3',(-5.0,-0.0,-10.0));
#40=LINE('l_ab1',#10,#30);
#41=LINE('l_ab2',#10,#31);
#42=LINE('l_ab3',#10,#32);
/* Edges on generator lines (degenerate at apex) */
#50=EDGE_CURVE('e_ab1',#20,#21,#40,.T.);
#51=EDGE_CURVE('e_ab2',#20,#22,#41,.T.);
#52=EDGE_CURVE('e_ab3',#20,#23,#42,.T.);
/* Conical surface (parametric U=0 maps to apex, singular) */
#60=CARTESIAN_POINT('cone_axis',(0.0,0.0,0.0));
#61=DIRECTION('cone_dir',(0.0,0.0,1.0));
#62=DIRECTION('cone_ref',(1.0,0.0,0.0));
#63=AXIS2_PLACEMENT_3D('cone_placement',#60,#61,#62);
#64=CONE('degenerate_cone',#63,5.0,0.5236);
/* Edge loop and face on cone (edge lies on generator with u=constant at apex) */
#70=ORIENTED_EDGE('oe_ab1',*,*,#50,.T.);
#71=ORIENTED_EDGE('oe_ab2',*,*,#51,.T.);
#72=ORIENTED_EDGE('oe_ab3',*,*,#52,.T.);
#73=EDGE_LOOP('gen_loop',(#70,#71,#72));
#74=FACE_OUTER_BOUND('',#73,.T.);
#75=ADVANCED_FACE('cone_face',(#74),#64,.T.);
/* Tolerance context */
#100=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-5),#6,
  'distance_accuracy_value','edge_tol');
#110=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#100))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#6,#7,#8))
  REPRESENTATION_CONTEXT('cone_degenerate','3D'));
#200=CLOSED_SHELL('cone_shell',(#75));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N123','N123','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#200));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
