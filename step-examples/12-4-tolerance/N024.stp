ISO-10303-21;
/* N024 - Edge geometry inconsistent with adjacent faces' actual intersection
 * Defect: After local edits (face translation, blend suppression, partial
 * defeaturing), an edge's stored 3D curve no longer matches the geometric
 * intersection of its two host faces. The edge survives as topology but
 * its curve is stale, leading to large tolerances or visible cracks.
 * Reproducer: edge curve stored as line at z=0, but adjacent host plane was
 * later translated to z=0.01 -- true intersection is at z=0.01, not z=0.
 */
HEADER;
FILE_DESCRIPTION(('N024 stale edge geometry vs adjacent face intersection'),'2;1');
FILE_NAME('N024.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Plane A: stays at z=0. Plane B: was translated up to z=0.01 after the edge
 * was stored. Edge curve was NOT rebuilt. */
#10=CARTESIAN_POINT('o_A',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('o_B_translated_up',(0.0,0.0,0.01));
#12=DIRECTION('+y',(0.0,1.0,0.0));
#13=DIRECTION('+x',(1.0,0.0,0.0));
#14=AXIS2_PLACEMENT_3D('plc_A',#10,#12,#13);
#15=AXIS2_PLACEMENT_3D('plc_B_post_edit',#11,#12,#13);
#16=PLANE('A_xz',#14);
#17=PLANE('B_translated',#15);
/* Edge stored at z=0 (stale -- matches old A∩B before B was moved) */
#20=CARTESIAN_POINT('p_stale0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('p_stale1',(10.0,0.0,0.0));
#22=VERTEX_POINT('',#20);
#23=VERTEX_POINT('',#21);
#30=DIRECTION('+x',(1.0,0.0,0.0));
#31=VECTOR('',#30,10.0);
#32=LINE('stale_curve_at_z0',#20,#31);
/* Defect site: stored curve does not match current A∩B (which is at z=0.01) */
#40=EDGE_CURVE('stale_intersection_edge',#22,#23,#32,.T.);
#50=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#51=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#52=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#60=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-5),#50,
  'distance_accuracy_value','tol_below_observed_geom_drift');
#70=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#60))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52))
  REPRESENTATION_CONTEXT('ctx','3D'));
ENDSEC;
END-ISO-10303-21;
