ISO-10303-21;
/* N152 - BRepBuilderAPI_Sewing.SameParameterEdge.location-transform-in-tolerance-eval
 * Defect: Transform surface by location before D0 evaluation in tolerance computation.
 * Reproducer: Surface at origin, apply placement (translate +100mm, rotate 45°).
 * Expected: tolerance computed on transformed surface. Without: false tolerance from untransformed.
 * Test: surface location identity check ensures D0 evaluation on correct surface.
 */
HEADER;
FILE_DESCRIPTION(('N152 location-transform-in-tolerance-eval'),'2;1');
FILE_NAME('N152.stp','2026-06-16T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Origin and axes */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc_identity',#10,#11,#12);
/* Surface at origin (identity location) */
#20=CARTESIAN_POINT('surf_origin',(0.0,0.0,0.0));
#21=DIRECTION('surf_z',(0.0,0.0,1.0));
#22=DIRECTION('surf_x',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('surf_plc_identity',#20,#21,#22);
/* Translated placement (+100mm in Y) */
#30=CARTESIAN_POINT('translated_origin',(0.0,100.0,0.0));
#31=DIRECTION('trans_z',(0.0,0.0,1.0));
#32=DIRECTION('trans_x',(1.0,0.0,0.0));
#33=AXIS2_PLACEMENT_3D('plc_translated',#30,#31,#32);
/* Edge 1: at identity location */
#40=CARTESIAN_POINT('p1_id',(0.0,0.0,0.0));
#41=CARTESIAN_POINT('p2_id',(2.0,0.0,0.0));
#50=VERTEX_POINT('v1_id',#40);
#51=VERTEX_POINT('v2_id',#41);
#60=DIRECTION('e1_dir',(1.0,0.0,0.0));
#61=VECTOR('e1_vec',#60,2.0);
#62=LINE('line1_id',#40,#61);
#63=EDGE_CURVE('edge1_id',#50,#51,#62,.T.);
/* Edge 2: at translated location */
#70=CARTESIAN_POINT('p1_trans',(0.0,0.0,0.0));
#71=CARTESIAN_POINT('p2_trans',(2.0,0.0,0.0));
#80=VERTEX_POINT('v1_trans',#70);
#81=VERTEX_POINT('v2_trans',#71);
#90=DIRECTION('e2_dir',(1.0,0.0,0.0));
#91=VECTOR('e2_vec',#90,2.0);
#92=LINE('line2_trans',#70,#91);
#93=EDGE_CURVE('edge2_trans',#80,#81,#92,.T.);
/* Location markers */
#100=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#101=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#102=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#103=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#100,
  'distance_accuracy_value','nominal_tolerance');
#104=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#100,
  'distance_accuracy_value','identity_location_tolerance');
#105=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(100.0),#100,
  'distance_accuracy_value','translation_offset');
#106=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#103))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#100,#101,#102))
  REPRESENTATION_CONTEXT('location_eval_ctx','3D'));
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N152','N152','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#100));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
