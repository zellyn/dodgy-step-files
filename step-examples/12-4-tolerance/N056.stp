ISO-10303-21;
/* N056 — ShapeFix_ShapeTolerance.SetTolerance bulk-rewrite
 * Defect: SetTolerance(shape, t, type) overwrites tolerances on all sub-elements
 * even when they already exceed the new tolerance value, causing silent precision
 * loss. When tolerance is reduced globally, higher-precision edges/vertices should
 * be preserved or warned; instead they are silently clamped downward.
 */
HEADER;
FILE_DESCRIPTION(('N056 SetTolerance silent precision loss on bulk rewrite'),'2;1');
FILE_NAME('N056.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Shape with three edges: two high-tolerance, one low-tolerance.
   SetTolerance(shape, 0.002) should detect edges #31 and #51 already have
   tolerance 0.005 and 0.004 (>0.002) but silently overwrites them all. */
#10=CARTESIAN_POINT('p_origin',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('p2',(2.0,0.0,0.0));
#13=CARTESIAN_POINT('p3',(3.0,0.0,0.0));
#20=VERTEX_POINT('v_origin',#10);
#21=VERTEX_POINT('v1',#11);
#22=VERTEX_POINT('v2',#12);
#23=VERTEX_POINT('v3',#13);
/* Edge 1: from origin to p1, high tolerance 0.005 */
#30=DIRECTION('d1',(1.0,0.0,0.0));
#31=VECTOR('vec1',#30,1.0);
#32=LINE('line1',#10,#31);
#33=EDGE_CURVE('edge1_high_tol',#20,#21,#32,.T.);
/* Edge 2: from p1 to p2, low tolerance 0.001 */
#40=DIRECTION('d2',(1.0,0.0,0.0));
#41=VECTOR('vec2',#40,1.0);
#42=LINE('line2',#11,#41);
#43=EDGE_CURVE('edge2_low_tol',#21,#22,#42,.T.);
/* Edge 3: from p2 to p3, high tolerance 0.004 */
#50=DIRECTION('d3',(1.0,0.0,0.0));
#51=VECTOR('vec3',#50,1.0);
#52=LINE('line3',#12,#51);
#53=EDGE_CURVE('edge3_high_tol',#22,#23,#52,.T.);
/* Closed wire via face on XY plane */
#60=DIRECTION('d_close',(-1.0,0.0,0.0));
#61=VECTOR('vec_close',#60,3.0);
#62=LINE('line_close',#13,#61);
#63=EDGE_CURVE('edge_close',#23,#20,#62,.T.);
#70=ORIENTED_EDGE('',*,*,#33,.T.);
#71=ORIENTED_EDGE('',*,*,#43,.T.);
#72=ORIENTED_EDGE('',*,*,#53,.T.);
#73=ORIENTED_EDGE('',*,*,#63,.T.);
#74=EDGE_LOOP('',(#70,#71,#72,#73));
#75=FACE_OUTER_BOUND('',#74,.T.);
#76=DIRECTION('zdir',(0.0,0.0,1.0));
#77=DIRECTION('xdir',(1.0,0.0,0.0));
#78=AXIS2_PLACEMENT_3D('ax3',#10,#76,#77);
#79=PLANE('plane_xy',#78);
#80=ADVANCED_FACE('face1',(#75),#79,.T.);
#81=OPEN_SHELL('shell1',(#80));
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N056','N056','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#81));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
