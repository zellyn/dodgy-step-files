ISO-10303-21;
/* N042: planar face outer wire has two near-tangent B_SPLINE_CURVE segments that cross at ~5e-4 mm inside the face; default bbox sampler with N=4 points misses the crossing — self-intersection undetected */
HEADER;
FILE_DESCRIPTION(('N042'),'2;1');
FILE_NAME('N042.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#9000=APPLICATION_CONTEXT('mechanical design');
#1=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#2=DIRECTION('z',(0.0,0.0,1.0));
#3=DIRECTION('x',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('plane_plc',#1,#2,#3);
#5=PLANE('host_plane',#4);
#6=CARTESIAN_POINT('a_p0',(0.0,5.0,0.0));
#7=CARTESIAN_POINT('a_p1',(5.0,5.0005,0.0));
#8=CARTESIAN_POINT('a_p2',(10.0,5.0,0.0));
#9=CARTESIAN_POINT('b_p0',(0.0,5.0005,0.0));
#10=CARTESIAN_POINT('b_p1',(5.0,5.0,0.0));
#11=CARTESIAN_POINT('b_p2',(10.0,5.0005,0.0));
#12=B_SPLINE_CURVE_WITH_KNOTS('curveA',2,(#6,#7,#8),.UNSPECIFIED.,.F.,.F.,(3,3),(0.0,1.0),.UNSPECIFIED.);
#13=B_SPLINE_CURVE_WITH_KNOTS('curveB',2,(#9,#10,#11),.UNSPECIFIED.,.F.,.F.,(3,3),(0.0,1.0),.UNSPECIFIED.);
#14=VERTEX_POINT('a_start',#6);
#15=VERTEX_POINT('a_end',#8);
#16=VERTEX_POINT('b_start',#9);
#17=VERTEX_POINT('b_end',#11);
#18=EDGE_CURVE('eA_near_tangent_xs',#14,#15,#12,.T.);
#19=EDGE_CURVE('eB_near_tangent_xs',#16,#17,#13,.T.);
#20=ORIENTED_EDGE('',$,$,#18,.T.);
#21=ORIENTED_EDGE('',$,$,#19,.T.);
#22=EDGE_LOOP('self_xs_loop_undetected_by_bbox',(#20,#21));
#23=FACE_OUTER_BOUND('',#22,.T.);
#24=ADVANCED_FACE('coarse_bbox_self_xs_face',(#23),#5,.T.);
#25=OPEN_SHELL('',(#24));
#26=SHELL_BASED_SURFACE_MODEL('',(#25));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('N042','N042','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
#9055=PRODUCT_DEFINITION_SHAPE('','','',#9054);
#9056=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9057=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9058=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9059=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.000000E-06),#9056,'distance_accuracy_value','');
#9060=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9059))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9056,#9057,#9058))REPRESENTATION_CONTEXT('','3D'));
#9061=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#26),#9060);
#9062=SHAPE_DEFINITION_REPRESENTATION(#9055,#9061);
ENDSEC;
