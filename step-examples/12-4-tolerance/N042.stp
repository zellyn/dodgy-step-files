/* N042 - Self-intersecting wire from coarse-discretization bbox check
 *        (sample-count too small)
 * Defect: When OCCT computed a curve's bounding box for self-intersection
 * detection, it used too few sampling points; near-tangent intersections
 * were missed. step-g hits the inverse: sampling p-curves with <2 points
 * produces degenerate trims. Two near-tangent edges on a planar face
 * actually cross, but a fixed-sample bbox check declares them disjoint.
 * Reproducer: planar face whose outer wire contains two B_SPLINE_CURVE
 * segments whose interiors cross at a tangency-like angle; default OCCT
 * bbox sampler misses the crossing.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N042 self-intersecting wire missed by coarse bbox sampling'),'2;1');
FILE_NAME('N042.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plane_plc',#10,#11,#12);
#14=PLANE('host_plane',#13);
/* Two near-tangent B-spline curves that actually cross at ~0.0005 inside
 * a 10x10 face. Bbox sampler with default ~4 samples sees their bounding
 * boxes overlap but misses the crossing point. */
#20=CARTESIAN_POINT('a_p0',(0.0,5.0,0.0));
#21=CARTESIAN_POINT('a_p1',(5.0,5.0005,0.0));
#22=CARTESIAN_POINT('a_p2',(10.0,5.0,0.0));
#23=CARTESIAN_POINT('b_p0',(0.0,5.0005,0.0));
#24=CARTESIAN_POINT('b_p1',(5.0,5.0,0.0));
#25=CARTESIAN_POINT('b_p2',(10.0,5.0005,0.0));
#30=B_SPLINE_CURVE_WITH_KNOTS('curveA',2,(#20,#21,#22),.UNSPECIFIED.,
  .F.,.F.,(3,3),(0.0,1.0),.UNSPECIFIED.);
#31=B_SPLINE_CURVE_WITH_KNOTS('curveB',2,(#23,#24,#25),.UNSPECIFIED.,
  .F.,.F.,(3,3),(0.0,1.0),.UNSPECIFIED.);
#40=VERTEX_POINT('a_start',#20);
#41=VERTEX_POINT('a_end',#22);
#42=VERTEX_POINT('b_start',#23);
#43=VERTEX_POINT('b_end',#25);
#50=EDGE_CURVE('eA_near_tangent_xs',#40,#41,#30,.T.);
#51=EDGE_CURVE('eB_near_tangent_xs',#42,#43,#31,.T.);
#52=ORIENTED_EDGE('',*,*,#50,.T.);
#53=ORIENTED_EDGE('',*,*,#51,.T.);
/* Defect site: wire is self-intersecting (eA crosses eB) but a fixed-N
 * bbox sampler with N=4 misses the crossing -- check passes erroneously. */
#60=EDGE_LOOP('self_xs_loop_undetected_by_bbox',(#52,#53));
#61=FACE_OUTER_BOUND('',#60,.T.);
#62=ADVANCED_FACE('coarse_bbox_self_xs_face',(#61),#14,.T.);
#70=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#71=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#72=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#80=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#70,
  'distance_accuracy_value','declared_precision_well_below_xs_offset_5e-4');
#90=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#80))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#70,#71,#72))
  REPRESENTATION_CONTEXT('ctx_coarse_bbox_sampling','3D'));
/* Minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9010=PRODUCT_CONTEXT('',#1,'mechanical');
#9011=PRODUCT('N042','N042','',(#9010));
#9012=PRODUCT_DEFINITION_FORMATION('','',#9011);
#9013=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9014=PRODUCT_DEFINITION('','',#9012,#9013);
#9015=PRODUCT_DEFINITION_SHAPE('','',#9014);
#9030=OPEN_SHELL('wrap_shell',(#62));
#9031=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9030));
#9050=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9031),#90);
#9051=SHAPE_DEFINITION_REPRESENTATION(#9015,#9050);
ENDSEC;
END-ISO-10303-21;
