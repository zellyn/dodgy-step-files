ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N075 ShapeFix_ShapeTolerance SetTolerance vertex-skip'),'2;1');
FILE_NAME('N075.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Two adjacent faces sharing an edge (no isolated VERTEX entities) */
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('p2',(1.0,1.0,0.0));
#13=CARTESIAN_POINT('p3',(0.0,1.0,0.0));
#14=CARTESIAN_POINT('p4',(1.0,2.0,0.0));
#20=VERTEX_POINT('v0',#10);
#21=VERTEX_POINT('v1',#11);
#22=VERTEX_POINT('v2',#12);
#23=VERTEX_POINT('v3',#13);
#24=VERTEX_POINT('v4',#14);
/* First face: 0-1-2-3 quad */
#30=DIRECTION('dir0',(1.0,0.0,0.0));
#31=VECTOR('vec0',#30,1.0);
#32=LINE('l0',#10,#31);
#33=DIRECTION('dir1',(0.0,1.0,0.0));
#34=VECTOR('vec1',#33,1.0);
#35=LINE('l1',#11,#34);
#36=DIRECTION('dir2',(-1.0,0.0,0.0));
#37=VECTOR('vec2',#36,1.0);
#38=LINE('l2',#12,#37);
#39=DIRECTION('dir3',(0.0,-1.0,0.0));
#40=VECTOR('vec3',#39,1.0);
#41=LINE('l3',#13,#40);
#42=EDGE_CURVE('e0',#20,#21,#32,.T.);
#43=EDGE_CURVE('e1',#21,#22,#35,.T.);
#44=EDGE_CURVE('e2',#22,#23,#38,.T.);
#45=EDGE_CURVE('e3',#23,#20,#41,.T.);
#50=ORIENTED_EDGE('oe0',*,*,#42,.T.);
#51=ORIENTED_EDGE('oe1',*,*,#43,.T.);
#52=ORIENTED_EDGE('oe2',*,*,#44,.T.);
#53=ORIENTED_EDGE('oe3',*,*,#45,.T.);
#54=EDGE_LOOP('el1',(#50,#51,#52,#53));
#60=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#61=DIRECTION('z',(0.0,0.0,1.0));
#62=DIRECTION('x',(1.0,0.0,0.0));
#63=AXIS2_PLACEMENT_3D('plc',#60,#61,#62);
#64=PLANE('xy_plane',#63);
#65=FACE_OUTER_BOUND('outer',#54,.T.);
#66=ADVANCED_FACE('face1',(#65),#64,.T.);
/* Second face: 1-2-4 triangle sharing edge 1-2 */
#70=DIRECTION('dir4',(0.0,1.0,0.0));
#71=VECTOR('vec4',#70,1.0);
#72=LINE('l4',#11,#71);
#73=DIRECTION('dir5',(-0.5,1.0,0.0));
#74=VECTOR('vec5',#73,1.118);
#75=LINE('l5',#12,#74);
#76=DIRECTION('dir6',(-0.5,-1.0,0.0));
#77=VECTOR('vec6',#76,1.118);
#78=LINE('l6',#14,#77);
#79=EDGE_CURVE('e4',#21,#22,#72,.T.);
#80=EDGE_CURVE('e5',#22,#24,#75,.T.);
#81=EDGE_CURVE('e6',#24,#21,#78,.T.);
#82=ORIENTED_EDGE('oe4',*,*,#79,.T.);
#83=ORIENTED_EDGE('oe5',*,*,#80,.T.);
#84=ORIENTED_EDGE('oe6',*,*,#81,.T.);
#85=EDGE_LOOP('el2',(#82,#83,#84));
#86=FACE_OUTER_BOUND('outer2',#85,.T.);
#87=ADVANCED_FACE('face2',(#86),#64,.T.);
/* Units and tolerance */
#200=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#201=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#202=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#203=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-3),#200,
  'distance_accuracy_value','');
#204=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#203))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#200,#201,#202))
  REPRESENTATION_CONTEXT('','3D'));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N075','N075','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#66,#87));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
