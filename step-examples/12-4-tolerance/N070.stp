ISO-10303-21;
/* N070 — ShapeFix_ShapeTolerance.LimitTolerance zero lower-bound as no-op marker
 * Defect: LimitTolerance(shape, 0, 0.01) treats lower=0 as "skip lower check"
 * AND skips upper check entirely; shape with 0.5mm tolerance receives no
 * enforcement of 0.01mm upper limit. Root cause: conditional uses single
 * if(lower>0) gate for entire tolerance-clamping logic.
 * Fixture: triangle face with 0.5mm tolerance; LimitTolerance(..., 0, 0.01)
 * leaves tolerance at 0.5mm instead of clamping to 0.01mm.
 */
HEADER;
FILE_DESCRIPTION(('N070 ShapeFix_ShapeTolerance LimitTolerance 0-as-no-cap'),'2;1');
FILE_NAME('N070.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Simple triangle face with loose tolerance (0.5 mm, well above desired 0.01) */
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('p2',(0.5,1.0,0.0));
#20=VERTEX_POINT('v0',#10);
#21=VERTEX_POINT('v1',#11);
#22=VERTEX_POINT('v2',#12);
#30=DIRECTION('d0',(1.0,0.0,0.0));
#31=VECTOR('vec0',#30,1.0);
#32=LINE('line0',#10,#31);
#33=EDGE_CURVE('e0',#20,#21,#32,.T.);
#34=DIRECTION('d1',(-0.5,1.0,0.0));
#35=VECTOR('vec1',#34,1.118);
#36=LINE('line1',#11,#35);
#37=EDGE_CURVE('e1',#21,#22,#36,.T.);
#38=DIRECTION('d2',(-0.5,-1.0,0.0));
#39=VECTOR('vec2',#38,1.118);
#40=LINE('line2',#12,#39);
#41=EDGE_CURVE('e2',#22,#20,#40,.T.);
#42=ORIENTED_EDGE('',*,*,#33,.T.);
#43=ORIENTED_EDGE('',*,*,#37,.T.);
#44=ORIENTED_EDGE('',*,*,#41,.T.);
#45=EDGE_LOOP('',(#42,#43,#44));
#46=FACE_OUTER_BOUND('',#45,.T.);
#47=DIRECTION('zdir',(0.0,0.0,1.0));
#48=DIRECTION('xdir',(1.0,0.0,0.0));
#49=AXIS2_PLACEMENT_3D('ax3',#10,#47,#48);
#50=PLANE('plane',#49);
#51=ADVANCED_FACE('face',(#46),#50,.T.);
#52=CLOSED_SHELL('shell',(#51));
/* Units and loose tolerance (0.5 mm) */
#200=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#201=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#202=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#203=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(5.0E-1),#200,
  'distance_accuracy_value','');
#204=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#203))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#200,#201,#202))
  REPRESENTATION_CONTEXT('','3D'));
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N070','N070','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#52));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
