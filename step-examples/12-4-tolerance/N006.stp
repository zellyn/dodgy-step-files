ISO-10303-21;
/* N006 - Pcurve out of sync with 3D curve parameterization (sameparameter, geometric)
 * Defect: After reproject of a pcurve at non-uniform sampling without
 * rebasing parameter, parameter-by-parameter evaluation between 3D curve
 * and pcurve drifts. OCCT compensates by inflating edge tolerance, hiding
 * a real gap. check-toler highlights the resulting "hot" edges.
 * Reproducer: BSpline pcurve on a planar face with non-uniform knot vector
 * applied while the underlying 3D BSpline keeps a uniform knot vector --
 * parameter mismatch within the same edge.
 */
HEADER;
FILE_DESCRIPTION(('N006 Pcurve out of sync with 3D curve parameterization'),'2;1');
FILE_NAME('N006.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('o',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
#14=PLANE('host',#13);
#20=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('p1',(3.33,0.0,0.0));
#22=CARTESIAN_POINT('p2',(6.66,0.0,0.0));
#23=CARTESIAN_POINT('p3',(10.0,0.0,0.0));
#24=VERTEX_POINT('',#20);
#25=VERTEX_POINT('',#23);
/* 3D BSpline curve with UNIFORM knot vector */
#30=B_SPLINE_CURVE_WITH_KNOTS('3d_uniform',3,(#20,#21,#22,#23),
  .UNSPECIFIED.,.F.,.F.,(4,4),(0.0,1.0),.UNSPECIFIED.);
/* Pcurve in (u,v): NON-UNIFORM knot vector chosen via reproject without rebase */
#40=CARTESIAN_POINT('uv0',(0.0,0.0));
#41=CARTESIAN_POINT('uv1',(2.0,0.0));
#42=CARTESIAN_POINT('uv2',(8.0,0.0));
#43=CARTESIAN_POINT('uv3',(10.0,0.0));
#44=B_SPLINE_CURVE_WITH_KNOTS('pcurve_nonuniform',3,(#40,#41,#42,#43),
  .UNSPECIFIED.,.F.,.F.,(4,4),(0.0,1.0),.UNSPECIFIED.);
#45=DEFINITIONAL_REPRESENTATION('',(#44),#13);
#46=PCURVE('pc',#14,#45);
/* Defect site: param-mismatch hidden by inflated edge tolerance */
#50=SURFACE_CURVE('hot_edge_curve',#30,(#46),.PCURVE_S1.);
#51=EDGE_CURVE('hot_edge',#24,#25,#50,.T.);
#60=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#61=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#62=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#63=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-3),#60,
  'distance_accuracy_value','inflated_edge_tol_to_hide_param_drift');
#64=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#63))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#60,#61,#62))
  REPRESENTATION_CONTEXT('ctx','3D'));
ENDSEC;
END-ISO-10303-21;
