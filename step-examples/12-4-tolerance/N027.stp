/* N027 - gmsh.OCCTargetUnit silently ignored on importShapesNativePointer path
 * Defect: gmsh user sets Geometry.OCCTargetUnit = "M", but a STEP cylinder
 * of r=1 h=10 (mm) gets imported as r=1000 h=10000 (the x1000 scaling is
 * applied unexpectedly). The setting is honored when the file enters via
 * importShapes but skipped when via importShapesNativePointer.
 * Reproducer: STEP with LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.);
 * a cylinder dimensioned in mm that needs explicit unit mapping at the
 * OCC->consumer boundary.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N027 gmsh OCCTargetUnit ignored on native pointer import'),'2;1');
FILE_NAME('N027.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Cylinder r=1 mm h=10 mm -- correct under MILLI scaling, scaled x1000
 * if the receiver applies an unexpected MILLI->target conversion. */
#10=CARTESIAN_POINT('axis_o',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('cyl_axis',#10,#11,#12);
#14=CYLINDRICAL_SURFACE('r1_cyl',#13,1.0);
/* Top and bottom rim points */
#20=CARTESIAN_POINT('rim_bot',(1.0,0.0,0.0));
#21=CARTESIAN_POINT('rim_top',(1.0,0.0,10.0));
#22=VERTEX_POINT('',#20);
#23=VERTEX_POINT('',#21);
#30=DIRECTION('+z',(0.0,0.0,1.0));
#31=VECTOR('',#30,10.0);
#32=LINE('seam',#20,#31);
#40=EDGE_CURVE('cyl_seam',#22,#23,#32,.T.);
/* LENGTH_UNIT in MILLI -- typical input where a target=M consumer needs
 * scale factor 1e-3 applied. */
#50=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#51=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#52=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#60=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#50,
  'distance_accuracy_value','mm_precision');
#70=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#60))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52))
  REPRESENTATION_CONTEXT('ctx_mm','3D'));
ENDSEC;
END-ISO-10303-21;
