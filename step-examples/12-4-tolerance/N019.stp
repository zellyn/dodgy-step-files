#13=LINE('line_on_offset',#7,#12);
#14=EDGE_CURVE('edge_at_offset',#9,#10,#13,.T.);
#15=GEOMETRIC_CURVE_SET('offset_set',(#14,#6));
#16=APPLICATION_CONTEXT('automotive_design');
