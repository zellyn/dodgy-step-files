ISO-10303-21;
/* N019: OFFSET_SURFACE on PLANE with offset 5.0E-5 mm; file tol 1.0E-6; hard-coded 1.0E-3 importer tolerance crushes offset back to base; GEOMETRIC_CURVE_SET — OCC yields empty */
HEADER;
