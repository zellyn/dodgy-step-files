/* N031 - Surface discontinuities introduced by translation (G0/G1/G2 break at shared edges)
 * Defect: G0/G1/G2 discontinuities introduced when neighbouring faces are
 * re-parametrized into different surface types during translation. Tangent-
 * plane jumps appear at shared edges that were smooth in the source.
 * Reproducer: two adjacent BSpline patches sharing an edge whose tangent
 * planes differ by more than the resolution tolerance -- G1 break introduced
 * by translation independently re-fitting each patch.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N031 G0/G1/G2 surface discontinuities at shared edge'),'2;1');
FILE_NAME('N031.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Patch 1 control rows (along shared edge x=0..10, y=0): top at y=10
 * heading +z. Tangent at shared edge points in +y, slope dz/dy = 0. */
#10=CARTESIAN_POINT('a00',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('a01',(0.0,10.0,0.0));
#12=CARTESIAN_POINT('a10',(10.0,0.0,0.0));
#13=CARTESIAN_POINT('a11',(10.0,10.0,0.0));
#14=B_SPLINE_SURFACE_WITH_KNOTS('patch_A',1,1,
  ((#10,#11),(#12,#13)),.UNSPECIFIED.,.F.,.F.,.F.,
  (2,2),(2,2),(0.0,1.0),(0.0,1.0),.UNSPECIFIED.);
/* Patch 2: shared edge identical (a00,a10) but heading -y with tangent
 * not aligned with patch A -- tangent jump at shared edge. */
#20=CARTESIAN_POINT('b00',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('b01',(0.0,-10.0,0.5));
#22=CARTESIAN_POINT('b10',(10.0,0.0,0.0));
#23=CARTESIAN_POINT('b11',(10.0,-10.0,0.5));
#24=B_SPLINE_SURFACE_WITH_KNOTS('patch_B_tangent_jump',1,1,
  ((#20,#21),(#22,#23)),.UNSPECIFIED.,.F.,.F.,.F.,
  (2,2),(2,2),(0.0,1.0),(0.0,1.0),.UNSPECIFIED.);
/* Shared edge between A and B */
#30=VERTEX_POINT('shared0',#10);
#31=VERTEX_POINT('shared1',#12);
#40=DIRECTION('+x',(1.0,0.0,0.0));
#41=VECTOR('',#40,10.0);
#42=LINE('shared_3d',#10,#41);
/* Defect site: edge marks G0 join; tangent planes differ -- G1 break */
#50=EDGE_CURVE('G1_break_at_shared_edge',#30,#31,#42,.T.);
#60=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#61=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#62=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#63=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-5),#60,
  'distance_accuracy_value','translation_tangent_jump_below_resolution');
#70=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#63))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#60,#61,#62))
  REPRESENTATION_CONTEXT('ctx','3D'));
ENDSEC;
END-ISO-10303-21;
