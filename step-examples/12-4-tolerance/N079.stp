ISO-10303-21;
/* N079: CheckPointsAreOnEdges sphere-pole: edge from north pole (0,0,10) to (0.1,0,9.99); singular U at pole causes false-negative on-edge check; GEOMETRIC_CURVE_SET — OCC yields empty */
HEADER;
FILE_DESCRIPTION(('N079'),'2;1');
FILE_NAME('N079.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('sph_orig',(0.0,0.0,0.0));
#2=DIRECTION('',(0.0,0.0,1.0));
#3=DIRECTION('',(1.0,0.0,0.0));
#4=AXIS2_PLACEMENT_3D('',#1,#2,#3);
#5=SPHERICAL_SURFACE('sphere',#4,10.0);
#6=CARTESIAN_POINT('p_north_pole',(0.0,0.0,10.0));
#7=CARTESIAN_POINT('p_near_pole',(0.1,0.0,9.99));
#8=VERTEX_POINT('v_north_pole',#6);
#9=VERTEX_POINT('v_near',#7);
#10=DIRECTION('',(1.0,0.0,-0.1));
#11=VECTOR('',#10,0.1005);
#12=LINE('pole_edge_approx',#6,#11);
#13=EDGE_CURVE('pole_edge',#8,#9,#12,.T.);
#14=GEOMETRIC_CURVE_SET('sphere_pole',(#5,#13));
#15=APPLICATION_CONTEXT('automotive_design');
#16=PRODUCT_CONTEXT('',#15,'mechanical');
#17=PRODUCT('N079','N079','',(#16));
#18=PRODUCT_DEFINITION_FORMATION('','',#17);
#19=PRODUCT_DEFINITION_CONTEXT('part definition',#15,'design');
#20=PRODUCT_DEFINITION('','',#18,#19);
#21=PRODUCT_DEFINITION_SHAPE('','',#20);
#22=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#23=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#24=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#25=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#22,'distance_accuracy_value','model_precision');
#26=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#25))GLOBAL_UNIT_ASSIGNED_CONTEXT((#22,#23,#24))REPRESENTATION_CONTEXT('ctx','3D'));
