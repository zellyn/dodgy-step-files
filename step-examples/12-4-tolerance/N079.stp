/* N079 - ShapeAnalysis_Edge.CheckPointsAreOnEdges sphere-pole
 * Defect: Edge endpoint at a spherical pole (north or south); the on-edge
 * check uses parameter-space and a pole has indeterminate U coordinate.
 * At a sphere's pole, the U parameter is singular (any U value corresponds
 * to the same physical location). CheckPointsAreOnEdges attempts to verify
 * an endpoint lies on the edge by comparing parameter values, but the check
 * fails because the pole's indeterminate U doesn't match the computed
 * parameter. Result: vertex at pole incorrectly marked as NOT on edge,
 * triggering false repairs.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N079 CheckPointsAreOnEdges sphere-pole singularity'),'2;1');
FILE_NAME('N079.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Spherical surface with edge endpoint at pole */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('sphere_axis',#10,#11,#12);
/* Sphere surface definition: radius 10.0 mm */
#20=SPHERE('sphere_surf',#13,10.0);
/* Edge at sphere pole: north pole is at (0,0,10) */
#30=CARTESIAN_POINT('pole_north',(0.0,0.0,10.0));
#31=CARTESIAN_POINT('near_pole',(0.1,0.0,9.99));
#40=VERTEX_POINT('v_at_pole',#30);
#41=VERTEX_POINT('v_near_pole',#31);
/* Edge connecting pole to nearby point on sphere surface
   This edge has one endpoint exactly at the north pole where U is singular */
#50=DIRECTION('pole_edge_dir',(0.1,0.0,-0.01));
#51=VECTOR('pole_edge_vec',#50,0.1);
#52=LINE('pole_edge_3d',#30,#51);
#53=EDGE_CURVE('edge_pole',#40,#41,#52,.T.);
/* Additional edges away from pole for comparison */
#60=CARTESIAN_POINT('equator_p1',(10.0,0.0,0.0));
#61=CARTESIAN_POINT('equator_p2',(0.0,10.0,0.0));
#70=VERTEX_POINT('v_eq1',#60);
#71=VERTEX_POINT('v_eq2',#61);
#80=DIRECTION('equator_dir',(-10.0,10.0,0.0));
#81=VECTOR('equator_vec',#80,14.14);
#82=LINE('equator_edge_3d',#60,#81);
#83=EDGE_CURVE('edge_equator',#70,#71,#82,.T.);
/* Context with tolerance for on-edge checking */
#90=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#91=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#92=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#93=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#90,
  'distance_accuracy_value','pole_check_tolerance');
#94=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#93))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#90,#91,#92))
  REPRESENTATION_CONTEXT('pole_ctx','3D'));
ENDSEC;
END-ISO-10303-21;
