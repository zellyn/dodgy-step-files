/* Tb017 - Two parallel coincident faces separated by exactly declared tolerance
 * Defect: Two ADVANCED_FACEs on parallel PLANEs, offset 1.0e-6 mm,
 * declared tolerance 1.0e-6 mm. Strict-< receiver: keeps as separate
 * (thin slab). Lax-<= receiver: merges into one face (slab disappears).
 * The "thin slab" is alive or dead at the equality boundary.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Tb017 coincident faces at exact declared tolerance separation'),'2;1');
FILE_NAME('Tb017.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Plane 1 at z=0. */
#10=CARTESIAN_POINT('o1',(0.0,0.0,0.0));
#11=DIRECTION('+z',(0.0,0.0,1.0));
#12=DIRECTION('+x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc1',#10,#11,#12);
#14=PLANE('p1',#13);
/* Plane 2 at z=1e-6. */
#15=CARTESIAN_POINT('o2',(0.0,0.0,1.0E-6));
#16=AXIS2_PLACEMENT_3D('plc2',#15,#11,#12);
#17=PLANE('p2_offset_exact_tol',#16);
/* Each plane: 1mm x 1mm quad outer bound. */
#20=CARTESIAN_POINT('p1_a',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('p1_b',(1.0,0.0,0.0));
#22=CARTESIAN_POINT('p1_c',(1.0,1.0,0.0));
#23=CARTESIAN_POINT('p1_d',(0.0,1.0,0.0));
#24=CARTESIAN_POINT('p2_a',(0.0,0.0,1.0E-6));
#25=CARTESIAN_POINT('p2_b',(1.0,0.0,1.0E-6));
#26=CARTESIAN_POINT('p2_c',(1.0,1.0,1.0E-6));
#27=CARTESIAN_POINT('p2_d',(0.0,1.0,1.0E-6));
#30=VERTEX_POINT('',#20); #31=VERTEX_POINT('',#21);
#32=VERTEX_POINT('',#22); #33=VERTEX_POINT('',#23);
#34=VERTEX_POINT('',#24); #35=VERTEX_POINT('',#25);
#36=VERTEX_POINT('',#26); #37=VERTEX_POINT('',#27);
#40=DIRECTION('+x',(1.0,0.0,0.0));
#41=DIRECTION('+y',(0.0,1.0,0.0));
#42=DIRECTION('-x',(-1.0,0.0,0.0));
#43=DIRECTION('-y',(0.0,-1.0,0.0));
#44=VECTOR('vx',#40,1.0); #45=VECTOR('vy',#41,1.0);
#46=VECTOR('vmx',#42,1.0); #47=VECTOR('vmy',#43,1.0);
#50=LINE('',#20,#44); #51=LINE('',#21,#45);
#52=LINE('',#22,#46); #53=LINE('',#23,#47);
#54=LINE('',#24,#44); #55=LINE('',#25,#45);
#56=LINE('',#26,#46); #57=LINE('',#27,#47);
#60=EDGE_CURVE('',#30,#31,#50,.T.); #61=EDGE_CURVE('',#31,#32,#51,.T.);
#62=EDGE_CURVE('',#32,#33,#52,.T.); #63=EDGE_CURVE('',#33,#30,#53,.T.);
#64=EDGE_CURVE('',#34,#35,#54,.T.); #65=EDGE_CURVE('',#35,#36,#55,.T.);
#66=EDGE_CURVE('',#36,#37,#56,.T.); #67=EDGE_CURVE('',#37,#34,#57,.T.);
#70=ORIENTED_EDGE('',*,*,#60,.T.); #71=ORIENTED_EDGE('',*,*,#61,.T.);
#72=ORIENTED_EDGE('',*,*,#62,.T.); #73=ORIENTED_EDGE('',*,*,#63,.T.);
#74=ORIENTED_EDGE('',*,*,#64,.T.); #75=ORIENTED_EDGE('',*,*,#65,.T.);
#76=ORIENTED_EDGE('',*,*,#66,.T.); #77=ORIENTED_EDGE('',*,*,#67,.T.);
#80=EDGE_LOOP('',(#70,#71,#72,#73));
#81=EDGE_LOOP('',(#74,#75,#76,#77));
#82=RECTANGULAR_TRIMMED_SURFACE('t1',#14,0.0,1.0,0.0,1.0,.T.,.T.);
#83=RECTANGULAR_TRIMMED_SURFACE('t2',#17,0.0,1.0,0.0,1.0,.T.,.T.);
#90=FACE_OUTER_BOUND('',#80,.T.);
#91=FACE_OUTER_BOUND('',#81,.T.);
#100=ADVANCED_FACE('face1',(#90),#82,.T.);
#101=ADVANCED_FACE('face2_offset_1e-6',(#91),#83,.T.);
#110=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#111=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#112=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#120=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#110,
  'distance_accuracy_value','tol_equals_face_offset_exactly');
#130=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#120))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#110,#111,#112))
  REPRESENTATION_CONTEXT('ctx','3D'));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tb017','Tb017','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9020=OPEN_SHELL('shell',(#100,#101));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#130);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
