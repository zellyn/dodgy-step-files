ISO-10303-21;
/* N044 - Persistent IDs lost across editing/translation breaks PMI
 *        tolerance attachment
 * Defect: Stable identifiers assigned to entities (faces, edges) for change
 * tracking and PMI binding are regenerated by intermediate tools, breaking
 * PMI references -- a tolerance frame referencing face #47 in a source file
 * no longer resolves after round-trip because the receiver renumbered
 * topology. APPLIED_IDENTIFICATION_ASSIGNMENT records the source UUID, but
 * the topology entity it points at has been recreated with a different
 * STEP_id on the receiving side.
 * Reproducer: A face annotated with a CAx-IF persistent UUID via
 * APPLIED_IDENTIFICATION_ASSIGNMENT survives a round-trip topologically but
 * the PMI tolerance frame (DIMENSIONAL_LOCATION) dangles -- it still
 * references the old STEP_id which has been reassigned to a different face.
 */
HEADER;
FILE_DESCRIPTION(('N044 persistent IDs lost; PMI tolerance frame dangles after round-trip'),'2;1');
FILE_NAME('N044.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Two faces with stable CAx-IF UUIDs intended to survive round-trips. */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plane_plc',#10,#11,#12);
#14=PLANE('faceA_surface',#13);
#15=CARTESIAN_POINT('upper_origin',(0.0,0.0,5.0));
#16=AXIS2_PLACEMENT_3D('plane_plc_upper',#15,#11,#12);
#17=PLANE('faceB_surface',#16);
#20=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('p1',(10.0,0.0,0.0));
#22=CARTESIAN_POINT('p2',(10.0,10.0,0.0));
#23=CARTESIAN_POINT('p3',(0.0,10.0,0.0));
#30=VERTEX_POINT('',#20);
#31=VERTEX_POINT('',#21);
#32=VERTEX_POINT('',#22);
#33=VERTEX_POINT('',#23);
#40=DIRECTION('+x',(1.0,0.0,0.0));
#41=DIRECTION('+y',(0.0,1.0,0.0));
#42=DIRECTION('-x',(-1.0,0.0,0.0));
#43=DIRECTION('-y',(0.0,-1.0,0.0));
#44=VECTOR('',#40,10.0);
#45=VECTOR('',#41,10.0);
#46=VECTOR('',#42,10.0);
#47=VECTOR('',#43,10.0);
#50=LINE('',#20,#44);
#51=LINE('',#21,#45);
#52=LINE('',#22,#46);
#53=LINE('',#23,#47);
#60=EDGE_CURVE('',#30,#31,#50,.T.);
#61=EDGE_CURVE('',#31,#32,#51,.T.);
#62=EDGE_CURVE('',#32,#33,#52,.T.);
#63=EDGE_CURVE('',#33,#30,#53,.T.);
#70=ORIENTED_EDGE('',*,*,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#61,.T.);
#72=ORIENTED_EDGE('',*,*,#62,.T.);
#73=ORIENTED_EDGE('',*,*,#63,.T.);
#80=EDGE_LOOP('',(#70,#71,#72,#73));
#81=FACE_OUTER_BOUND('',#80,.T.);
#90=ADVANCED_FACE('faceA_was_id47_pre_roundtrip',(#81),#14,.T.);
#91=ADVANCED_FACE('faceB_now_at_id47_post_roundtrip',(#81),#17,.T.);
/* Persistent CAx-IF UUID assigned to faceA via APPLIED_IDENTIFICATION_ASSIGNMENT.
 * Source file's tolerance frame referenced "face whose STEP_id is #47";
 * after round-trip, #47 was reassigned to faceB while faceA -- still
 * carrying its UUID -- moved to a different STEP_id. Receivers that
 * resolve PMI by raw STEP_id now bind the tolerance to the wrong face. */
#100=IDENTIFICATION_ROLE('persistent_uuid','CAx-IF persistent ID');
#101=IDENTIFICATION_ASSIGNMENT('uuid:5f3c7b8a-1d2e-4a6b-9f0c-7e8d2c1b4a35',
  #100,'faceA persistent identity');
#102=APPLIED_IDENTIFICATION_ASSIGNMENT(
  'uuid:5f3c7b8a-1d2e-4a6b-9f0c-7e8d2c1b4a35',#100,
  'faceA persistent identity post-roundtrip',#90);
/* Dangling PMI frame: the source DIMENSIONAL_LOCATION-style tolerance was
 * resolved by raw integer STEP_id (#47 in the source). Now #47 is the
 * unrelated faceB. The UUID-bound copy at #102 points at faceA, but a
 * receiver that did not honour the UUID layer ends up binding the
 * tolerance frame to the wrong face. */
#110=PROPERTY_DEFINITION('flatness_tolerance_value_0p05',
  'PMI tolerance frame ORPHANED -- raw STEP_id #47 reassigned to faceB',#91);
#120=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#121=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#122=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#130=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#120,
  'distance_accuracy_value','model_precision');
#140=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#130))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#120,#121,#122))
  REPRESENTATION_CONTEXT('ctx_persistent_id_break','3D'));
ENDSEC;
END-ISO-10303-21;
