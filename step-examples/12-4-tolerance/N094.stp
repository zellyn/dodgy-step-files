ISO-10303-21;
/* N094 - ShapeFix_Edge.FixVertexTolerance precision-floor
 * Defect: shared vertex used by multiple edges with tolerances 1.0e-10 and 1.0e-3;
 * FixVertexTolerance computes harmonic mean which underflows to 0, violating
 * the invariant that vertex tolerance >= max(edge tolerances).
 * Reproducer: vertex shared by two edges with extreme tolerance mismatch.
 */
HEADER;
FILE_DESCRIPTION(('N094 - FixVertexTolerance underflow'),'2;1');
FILE_NAME('N094.stp','2026-06-15T00:00:00',('auto-generated'),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
/* Shared vertex at junction - tolerance should be >= max(1.0e-10, 1.0e-3) = 1.0e-3 */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=VERTEX_POINT('shared_vertex',#20);
/* Edge 1: ultra-high precision, tolerance 1.0e-10 */
#30=CARTESIAN_POINT('',(-1.0,0.0,0.0));
#31=VERTEX_POINT('v_precision',#30);
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#30,#41);
#43=EDGE_CURVE('edge_precision',#31,#21,#42,.T.);
/* Edge 2: low precision, tolerance 1.0e-3 */
#50=CARTESIAN_POINT('',(1.0,0.0,0.0));
#51=VERTEX_POINT('v_coarse',#50);
#60=DIRECTION('',(-1.0,0.0,0.0));
#61=VECTOR('',#60,1.0);
#62=LINE('',#50,#61);
#63=EDGE_CURVE('edge_coarse',#21,#51,#62,.T.);
/* Edge 3: from high-precision vertex */
#70=CARTESIAN_POINT('',(0.0,1.0,0.0));
#71=VERTEX_POINT('v_third',#70);
#80=DIRECTION('',(0.0,1.0,0.0));
#81=VECTOR('',#80,1.0);
#82=LINE('',#20,#81);
#83=EDGE_CURVE('edge_closure',#21,#71,#82,.T.);
/* Wire closing the loop */
#90=ORIENTED_EDGE('',*,*,#43,.T.);
#91=ORIENTED_EDGE('',*,*,#63,.T.);
#92=ORIENTED_EDGE('',*,*,#83,.T.);
#93=EDGE_LOOP('wire_mixed_tol',(#90,#91,#92));
/* Face */
#100=FACE_OUTER_BOUND('',#93,.T.);
#101=ADVANCED_FACE('face_mixed_tol',(#100),#14,.T.);
#102=OPEN_SHELL('shell_mixed_tol',(#101));
/* Product chain with defect site context */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N094','N094','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#102));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
