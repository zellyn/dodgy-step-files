ISO-10303-21;
/* N118 — BRepLib.UpdateEdgeTol with-pcurve-discontinuity
 * Defect: edge whose pcurve has a C0 discontinuity in the middle; UpdateEdgeTol
 * samples uniformly and the discontinuity contaminates one sample's tolerance
 * calculation, inflating the entire edge tolerance to hide the discontinuity
 * instead of reporting the failure to heal it.
 */
HEADER;
FILE_DESCRIPTION(('N118 UpdateEdgeTol pcurve C0 discontinuity'),'2;1');
FILE_NAME('N118.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#6=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#7=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#8=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Edge vertices spanning 0 to 10 in X. */
#10=CARTESIAN_POINT('v_start',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('v_end',(10.0,0.0,0.0));
#12=VERTEX_POINT('vs',#10);
#13=VERTEX_POINT('ve',#11);
/* 3D curve: smooth line from 0 to 10 in X. */
#20=DIRECTION('x_dir',(1.0,0.0,0.0));
#21=VECTOR('x_vec',#20,10.0);
#22=LINE('edge_3d',#10,#21);
/* Host surface: a plane z=0. */
#30=CARTESIAN_POINT('plane_origin',(0.0,0.0,0.0));
#31=DIRECTION('plane_z',(0.0,0.0,1.0));
#32=DIRECTION('plane_x',(1.0,0.0,0.0));
#33=AXIS2_PLACEMENT_3D('plane_plc',#30,#31,#32);
#34=PLANE('host_surface',#33);
/* PCurve segment A (u=0 to u=5): quadratic spline, u increases linearly */
#40=CARTESIAN_POINT('pca_0',(0.0,0.0));
#41=CARTESIAN_POINT('pca_1',(2.5,0.1));
#42=CARTESIAN_POINT('pca_2',(5.0,0.0));
#43=B_SPLINE_CURVE_WITH_KNOTS('pcurve_a',2,(#40,#41,#42),.UNSPECIFIED.,
  .F.,.F.,(3,3),(0.0,1.0),.UNSPECIFIED.);
/* PCurve segment B (u=5 to u=10): different control points with C0 jump
 * at u=5 (the endpoint of this spline is at (5.0, 0.5) rather than (5.0, 0.0)). */
#50=CARTESIAN_POINT('pcb_0',(5.0,0.5));
#51=CARTESIAN_POINT('pcb_1',(7.5,0.6));
#52=CARTESIAN_POINT('pcb_2',(10.0,0.5));
#53=B_SPLINE_CURVE_WITH_KNOTS('pcurve_b',2,(#50,#51,#52),.UNSPECIFIED.,
  .F.,.F.,(3,3),(0.0,1.0),.UNSPECIFIED.);
/* Compose the discontinuous pcurve from segments A and B.
 * At parameter u=0.5 (the middle of the normalized range [0,1]),
 * there is a C0 discontinuity from (5.0, 0.0) to (5.0, 0.5). */
#60=EDGE_CURVE('edge_with_c0_pcurve_jump',#12,#13,#22,.T.);
#100=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#6,
  'distance_accuracy_value','nominal_tolerance');
#101=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.5),#6,
  'distance_accuracy_value','pcurve_discontinuity_gap');
#110=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#100,#101))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#6,#7,#8))
  REPRESENTATION_CONTEXT('pcurve_c0_disc','3D'));
#200=ORIENTED_EDGE('',*,*,#60,.T.);
#201=EDGE_LOOP('single_edge_loop',(#200));
#202=FACE_OUTER_BOUND('',#201,.T.);
#203=ADVANCED_FACE('single_face',(#202),#34,.T.);
#210=CLOSED_SHELL('shell_with_c0_pcurve',(#203));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N118','N118','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#210));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
