ISO-10303-21;
/* N121 — ShapeFix_Edge.FixVertexTolerance with-tessellation-only-context
 * Defect: vertex tolerance computed from face tessellation; if tessellation is
 * null/missing, FixVertexTolerance silently uses default 1e-7 instead of raising
 * an error or computing from alternate geometry representation.
 * Geometry: edge on face with no triangulation data; tolerance resolver falls back.
 */
HEADER;
FILE_DESCRIPTION(('N121 FixVertexTolerance tessellation-only context'),'2;1');
FILE_NAME('N121.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#6=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#7=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#8=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Surface with no tessellation; tolerance computation will fail */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(5.0,0.0,0.0));
#12=CARTESIAN_POINT('p2',(10.0,0.0,0.0));
#13=CARTESIAN_POINT('p3',(10.0,5.0,0.0));
#14=CARTESIAN_POINT('p4',(5.0,5.0,0.0));
#15=CARTESIAN_POINT('p5',(0.0,5.0,0.0));
#20=VERTEX_POINT('v0',#10);
#21=VERTEX_POINT('v1',#11);
#22=VERTEX_POINT('v2',#12);
#23=VERTEX_POINT('v3',#13);
#24=VERTEX_POINT('v4',#14);
#25=VERTEX_POINT('v5',#15);
/* Line curves for edges */
#30=DIRECTION('x',(1.0,0.0,0.0));
#31=DIRECTION('y',(0.0,1.0,0.0));
#40=VECTOR('vx5',#30,5.0);
#41=VECTOR('vy5',#31,5.0);
#50=LINE('l01',#10,#40);
#51=LINE('l12',#12,#41);
#52=LINE('l54',#24,#40);
#53=LINE('l50',#15,#31);
/* Edge curves */
#60=EDGE_CURVE('e01',#20,#21,#50,.T.);
#61=EDGE_CURVE('e12',#22,#23,#51,.T.);
#62=EDGE_CURVE('e54',#24,#25,#52,.F.);
#63=EDGE_CURVE('e50',#25,#20,#53,.F.);
/* Host plane surface with no tessellation */
#70=CARTESIAN_POINT('plane_orig',(0.0,0.0,0.0));
#71=DIRECTION('nz',(0.0,0.0,1.0));
#72=DIRECTION('nx',(1.0,0.0,0.0));
#73=AXIS2_PLACEMENT_3D('plane_ax',#70,#71,#72);
#74=PLANE('untessellated_plane',#73);
/* Edge loop and face */
#80=ORIENTED_EDGE('oe01',*,*,#60,.T.);
#81=ORIENTED_EDGE('oe61',*,*,#61,.T.);
#82=ORIENTED_EDGE('oe62',*,*,#62,.T.);
#83=ORIENTED_EDGE('oe63',*,*,#63,.T.);
#84=EDGE_LOOP('boundary',(#80,#81,#82,#83));
#85=FACE_OUTER_BOUND('',#84,.T.);
#86=ADVANCED_FACE('rect_face',(#85),#74,.T.);
/* Tolerance context with high vertex tolerance that requires tessellation */
#100=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-2),#6,
  'distance_accuracy_value','vertex_tolerance_high');
#110=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#100))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#6,#7,#8))
  REPRESENTATION_CONTEXT('no_tessellation','3D'));
#200=CLOSED_SHELL('rect_shell',(#86));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N121','N121','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#200));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
