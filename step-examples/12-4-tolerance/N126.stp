ISO-10303-21;
/* N126 - ShapeAnalysis_ShapeTolerance.InTolerance vertex-filtering-inverted
 * Defect: VERTEX case uses tol >= valmax (inverted) vs FACE/EDGE use tol <= valmax.
 * Shape with two vertices: V1 tolerance 0.0015 (should match range 0.001-0.002),
 * V2 tolerance 0.005 (should NOT match). Inverted comparison returns only V2.
 * Reproducer: InTolerance(shape, 0.001, 0.002, TopAbs_VERTEX) returns V2 (0.005)
 * instead of V1 (0.0015), breaking API contract vs FACE/EDGE behavior.
 */
HEADER;
FILE_DESCRIPTION(('N126 InTolerance vertex-filtering-inverted'),'2;1');
FILE_NAME('N126.stp','2026-06-16T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Two vertices with inverted comparison semantics */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
/* Vertex 1: in-range tolerance 0.0015 (within [0.001, 0.002]) */
#20=CARTESIAN_POINT('v1_pt',(0.0,0.0,0.0));
#30=VERTEX_POINT('v1',#20);
/* Vertex 2: out-of-range tolerance 0.005 (exceeds [0.001, 0.002]) */
#40=CARTESIAN_POINT('v2_pt',(1.0,0.0,0.0));
#50=VERTEX_POINT('v2',#40);
/* Construct a minimal edge from V1 to V2 */
#60=DIRECTION('line_dir',(1.0,0.0,0.0));
#61=VECTOR('line_vec',#60,1.0);
#62=LINE('edge_line',#20,#61);
#70=EDGE_CURVE('edge',#30,#50,#62,.T.);
/* Wire from single edge */
#80=EDGE_LOOP('wire_loop',(#70));
/* Units and context */
#100=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#101=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#102=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#103=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#100,
  'distance_accuracy_value','nominal_tolerance');
#104=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#103))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#100,#101,#102))
  REPRESENTATION_CONTEXT('vertex_ctx','3D'));
/* Tolerance declarations for vertices */
#105=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.0015),#100,
  'distance_accuracy_value','v1_tol_inrange');
#106=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.005),#100,
  'distance_accuracy_value','v2_tol_outrange');
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N126','N126','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#100));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
