/* N016 - Edge tolerance 2-3 orders of magnitude > file tolerance (CATIA per-edge precision)
 * Defect: CATIA writes per-edge tolerance values that are 2-3 orders of
 * magnitude larger than the file's default tolerance. Receivers reading only
 * the global tolerance find gaps between adjacent faces and treat the body
 * as an open shell.
 * Reproducer: file declares global uncertainty 1e-4 mm but emits multiple
 * GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT entries with per-edge precisions of
 * 1e-2 / 5e-3 mm (CATIA-style per-entity tolerance metadata).
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N016 CATIA per-edge tolerance 2-3 orders > file tolerance'),'2;1');
FILE_NAME('N016.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(20.0,0.0,0.0));
#12=CARTESIAN_POINT('p2',(20.0,20.0,0.0));
#20=VERTEX_POINT('',#10);
#21=VERTEX_POINT('',#11);
#22=VERTEX_POINT('',#12);
#30=DIRECTION('+x',(1.0,0.0,0.0));
#31=DIRECTION('+y',(0.0,1.0,0.0));
#32=VECTOR('',#30,20.0);
#33=VECTOR('',#31,20.0);
#34=LINE('e1',#10,#32);
#35=LINE('e2',#11,#33);
#40=EDGE_CURVE('edge_tight',#20,#21,#34,.T.);
#41=EDGE_CURVE('edge_loose',#21,#22,#35,.T.);
#50=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#51=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#52=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Global file tolerance */
#60=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-4),#50,
  'distance_accuracy_value','file_default');
/* Per-edge tolerances 2-3 orders of magnitude larger than file default */
#61=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-2),#50,
  'distance_accuracy_value','edge_tight_per_entity_tolerance');
#62=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(5.0E-3),#50,
  'distance_accuracy_value','edge_loose_per_entity_tolerance');
#70=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#60,#61,#62))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52))
  REPRESENTATION_CONTEXT('ctx','3D'));
ENDSEC;
END-ISO-10303-21;
