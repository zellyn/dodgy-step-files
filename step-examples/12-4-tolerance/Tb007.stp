ISO-10303-21;
/* Tb007 - NURBS knot-difference quantum below tolerance: collapses or doesn't
 * Defect: B-spline curve has knot vector (0.0, 1.0e-8, 1.0) with multiplicities
 * (4, 1, 4) for cubic. A receiver collapsing near-equal knots within 1.0e-9
 * (Precision::PConfusion) preserves the inner knot. A receiver collapsing
 * within 1.0e-7 (Precision::Confusion) folds the inner knot into the leading
 * one, raising leading multiplicity from 4 to 5 (degree+2) and degenerating
 * the curve start. The same input produces different curves under different
 * knot-equality policies.
 */
HEADER;
FILE_DESCRIPTION(('Tb007 NURBS knot 1.0e-8 between Confusion and PConfusion'),'2;1');
FILE_NAME('Tb007.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Five control points for a cubic with knot vector of inner-knot 1.0e-8. */
#10=CARTESIAN_POINT('cp0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('cp1',(1.0,1.0,0.0));
#12=CARTESIAN_POINT('cp2',(2.0,0.5,0.0));
#13=CARTESIAN_POINT('cp3',(3.0,1.0,0.0));
#14=CARTESIAN_POINT('cp4',(4.0,0.0,0.0));
/* Cubic, 5 cps, 9 knots required (cps + degree + 1 = 5 + 3 + 1 = 9 = sum mults).
 * mults (4,1,4) sum to 9 -- valid. Inner knot at 1.0E-8 is the time-bomb. */
#20=B_SPLINE_CURVE_WITH_KNOTS('knot_quantum_1e-8',3,
  (#10,#11,#12,#13,#14),.UNSPECIFIED.,.F.,.F.,
  (4,1,4),(0.0,1.0E-8,1.0),.UNSPECIFIED.);
#21=VERTEX_POINT('vstart',#10);
#22=VERTEX_POINT('vend',#14);
#23=EDGE_CURVE('e',#21,#22,#20,.T.);
#30=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#31=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#32=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#33=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#30,
  'distance_accuracy_value','tolerance_at_knot_quantum_boundary');
#40=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#33))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#30,#31,#32))
  REPRESENTATION_CONTEXT('ctx','3D'));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tb007','Tb007','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9020=GEOMETRIC_CURVE_SET('cs',(#23));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#40);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
