ISO-10303-21;
/* N051 - InTolerance vertex-vs-face polarity inversion
 * VERTEX iteration uses inverted tolerance comparison (tol >= valmax)
 * instead of (tol <= valmax), causing vertices outside tolerance range
 * to be incorrectly selected while in-range vertices are rejected. */
HEADER;
FILE_DESCRIPTION(('N051 - InTolerance vertex polarity inversion'),'2;1');
FILE_NAME('N051.stp','2026-06-16T00:00:00',('auto-generated'),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* --- Single PLANE face with two vertices at boundary tolerance extremes --- */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
/* Vertex A at tol=0.0015 (within [0.001, 0.002] range) */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=VERTEX_POINT('v_in_range',#20);
/* Vertex B at tol=0.005 (outside [0.001, 0.002] range) */
#25=CARTESIAN_POINT('',(5.0,0.0,0.0));
#26=VERTEX_POINT('v_out_range',#25);
/* Vertex C to complete triangle */
#30=CARTESIAN_POINT('',(2.5,4.33,0.0));
#31=VERTEX_POINT('v_third',#30);
/* Edges forming boundary loop */
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#20,#41);
#43=EDGE_CURVE('e1',#21,#26,#42,.T.);
#44=DIRECTION('',(-0.5,0.866,0.0));
#45=VECTOR('',#44,1.0);
#46=LINE('',#25,#45);
#47=EDGE_CURVE('e2',#26,#31,#46,.T.);
#48=DIRECTION('',(-0.5,-0.866,0.0));
#49=VECTOR('',#48,1.0);
#50=LINE('',#30,#49);
#51=EDGE_CURVE('e3',#31,#21,#50,.T.);
/* Defect: InTolerance inverted comparison will select v_out_range
   (tol=0.005 >= 0.002 is true) while rejecting v_in_range
   (tol=0.0015 should pass <= 0.002 comparison) */
#60=ORIENTED_EDGE('',*,*,#43,.T.);
#61=ORIENTED_EDGE('',*,*,#47,.T.);
#62=ORIENTED_EDGE('',*,*,#51,.T.);
#63=EDGE_LOOP('',(#60,#61,#62));
#64=FACE_OUTER_BOUND('',#63,.T.);
#65=ADVANCED_FACE('face_with_polarity_bug',(#64),#14,.T.);
#70=OPEN_SHELL('',(#65));
/* PRODUCT chain wrapping geometry so OCCT TransferRoots produces shape */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N051','N051','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#70));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
