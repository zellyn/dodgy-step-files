ISO-10303-21;
/* N159 - BRepBuilderAPI_Sewing.SameParameterEdge raw-tolerance-write bypass
 * Defect: Line 1168 performs raw write to BRep_TEdge::Tolerance() bypassing
 * SetMaxTolerance API validation. User-specified cap ignored. Set MaxTolerance=0.01
 * but computed tolerance=0.05 exceeds cap via direct write.
 */
HEADER;
FILE_DESCRIPTION(('N159 direct_BRep_TEdge_tolerance_write bypass'),'2;1');
FILE_NAME('N159.stp','2026-06-16T00:00:00',(''),(''),
  'cad-research-suite','','');
