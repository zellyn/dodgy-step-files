ISO-10303-21;
/* Tb010 - Self-intersection that vanishes after float32 round-trip
 * Defect: Quad face whose diagonals cross at sub-ULP separation in
 * double precision. Vertices at (0,0,0), (1.0000003,0,0), (2.0000007,0,0),
 * (0.9999997, 0.0000003, 0). The four-edge boundary (assumed in this
 * fixture as a degenerate self-crossing wire) self-intersects when read
 * by an exact (or double-precision) kernel. After float32 round-trip the
 * coordinates collapse to (0,0,0), (1,0,0), (2,0,0), (1,0,0), eliminating
 * the crossing because two vertices become coincident. Producer uses
 * float32; receiver uses double; the geometry observed differs.
 */
HEADER;
FILE_DESCRIPTION(('Tb010 self-intersection vanishes after float32 round-trip'),'2;1');
FILE_NAME('Tb010.stp','2026-04-30T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Quad with self-crossing diagonal pattern in double precision. */
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1_dbl_offset',(1.0000003,0.0,0.0));
#12=CARTESIAN_POINT('p2',(2.0000007,0.0,0.0));
#13=CARTESIAN_POINT('p3_almost_p1',(0.9999997,0.0000003,0.0));
#20=VERTEX_POINT('v0',#10);
#21=VERTEX_POINT('v1',#11);
#22=VERTEX_POINT('v2',#12);
#23=VERTEX_POINT('v3_collapses_to_v1_under_float32',#13);
#30=DIRECTION('d01',(1.0,0.0,0.0));
#31=VECTOR('vec01',#30,1.0000003);
#32=LINE('l01',#10,#31);
#33=CARTESIAN_POINT('mid12',(1.5000005,0.0,0.0));
#34=DIRECTION('d12',(1.0,0.0,0.0));
#35=VECTOR('vec12',#34,1.0000004);
#36=LINE('l12',#11,#35);
#37=CARTESIAN_POINT('p2to3',(2.0000007,0.0,0.0));
#38=DIRECTION('d23',(-1.0,3.0E-7,0.0));
#39=VECTOR('vec23',#38,2.000001);
#40=LINE('l23',#12,#39);
#41=DIRECTION('d30',(-1.0,0.0,0.0));
#42=VECTOR('vec30',#41,0.9999997);
#43=LINE('l30',#13,#42);
#50=EDGE_CURVE('e01',#20,#21,#32,.T.);
#51=EDGE_CURVE('e12',#21,#22,#36,.T.);
#52=EDGE_CURVE('e23_crosses_diagonal',#22,#23,#40,.T.);
#53=EDGE_CURVE('e30',#23,#20,#43,.T.);
#60=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#61=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#62=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#63=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#60,
  'distance_accuracy_value','double_precision_tolerance');
#70=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#63))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#60,#61,#62))
  REPRESENTATION_CONTEXT('ctx','3D'));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Tb010','Tb010','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9020=GEOMETRIC_CURVE_SET('cs',(#50,#51,#52,#53));
#9021=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('',(#9020),#70);
#9022=SHAPE_DEFINITION_REPRESENTATION(#9005,#9021);
ENDSEC;
END-ISO-10303-21;
