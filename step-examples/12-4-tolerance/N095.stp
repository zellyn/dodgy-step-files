ISO-10303-21;
/* N095 - ShapeAnalysis_Edge.CheckPoints tolerance-aware-distance
 * Defect: CheckPoints uses min(preci1, preci2) as single threshold, but
 * preci1 and preci2 represent directional precision bounds; should apply
 * asymmetric directional thresholds, not a symmetric min.
 * Reproducer: edge with two vertices having different precision contexts.
 */
HEADER;
FILE_DESCRIPTION(('N095 - CheckPoints asymmetric threshold'),'2;1');
FILE_NAME('N095.stp','2026-06-15T00:00:00',('auto-generated'),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
/* Vertex A: high precision context (1e-9) */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=VERTEX_POINT('v_highprec',#20);
/* Vertex B: low precision context (1e-3) */
#30=CARTESIAN_POINT('',(1.0,0.0,0.0));
#31=VERTEX_POINT('v_lowprec',#30);
/* Edge connecting high-prec and low-prec endpoints
   CheckPoints will use min(1e-9, 1e-3) = 1e-9 as threshold,
   but should use directional asymmetric bounds instead */
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#20,#41);
#43=EDGE_CURVE('edge_asymmetric',#21,#31,#42,.T.);
/* Second edge for shell completeness */
#50=CARTESIAN_POINT('',(1.0,0.0,0.0));
#51=CARTESIAN_POINT('',(0.5,0.866,0.0));
#52=VERTEX_POINT('v_third',#50);
#53=VERTEX_POINT('v_fourth',#51);
#60=DIRECTION('',(-0.5,0.866,0.0));
#61=VECTOR('',#60,1.0);
#62=LINE('',#50,#61);
#63=EDGE_CURVE('edge_closure',#52,#53,#62,.T.);
/* Third edge */
#70=CARTESIAN_POINT('',(0.5,0.866,0.0));
#71=CARTESIAN_POINT('',(0.0,0.0,0.0));
#72=VERTEX_POINT('v_fifth',#70);
#73=VERTEX_POINT('v_return',#71);
#80=DIRECTION('',(-0.5,-0.866,0.0));
#81=VECTOR('',#80,1.0);
#82=LINE('',#70,#81);
#83=EDGE_CURVE('edge_return',#72,#73,#82,.T.);
/* Wire from three edges forming triangle */
#90=ORIENTED_EDGE('',*,*,#43,.T.);
#91=ORIENTED_EDGE('',*,*,#63,.T.);
#92=ORIENTED_EDGE('',*,*,#83,.T.);
#93=EDGE_LOOP('wire_asymmetric',(#90,#91,#92));
/* Face */
#100=FACE_OUTER_BOUND('',#93,.T.);
#101=ADVANCED_FACE('face_asymmetric',(#100),#14,.T.);
#102=OPEN_SHELL('shell_asymmetric',(#101));
/* Product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N095','N095','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#102));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
