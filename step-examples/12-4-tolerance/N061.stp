/* N061 - BRepLib.BoundingVertex bounding-sphere computation under-estimates radius
 * Defect: When 4+ vertices are co-located at nearly identical coordinates,
 * BRepLib's bounding sphere computation uses center-of-mass + max-distance heuristic,
 * which fails to produce a valid sphere containing all points. Results in invalid
 * bounding box calculations downstream.
 * Reproducer: Create 5 vertices clustered within 1e-8 of (1,1,1); bounding sphere
 * radius should be ~1e-8 but heuristic computes ~0.0 (machine epsilon).
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N061 BRepLib.BoundingVertex bounding-sphere under-estimate'),'2;1');
FILE_NAME('N061.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* 5 co-located vertices within 1e-8 cluster at (1.0, 1.0, 1.0) */
#10=CARTESIAN_POINT('v1',(1.0,1.0,1.0));
#11=CARTESIAN_POINT('v2',(1.0000000001,1.0,1.0));
#12=CARTESIAN_POINT('v3',(1.0,1.0000000001,1.0));
#13=CARTESIAN_POINT('v4',(1.0,1.0,1.0000000001));
#14=CARTESIAN_POINT('v5',(1.0000000001,1.0000000001,1.0000000001));
#20=VERTEX_POINT('v1',#10);
#21=VERTEX_POINT('v2',#11);
#22=VERTEX_POINT('v3',#12);
#23=VERTEX_POINT('v4',#13);
#24=VERTEX_POINT('v5',#14);
/* Connect vertices into a line to form a valid edge */
#30=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#31=CARTESIAN_POINT('p1',(2.0,2.0,2.0));
#40=DIRECTION('',(0.57735,0.57735,0.57735));
#41=VECTOR('',#40,3.464);
#42=LINE('',#30,#41);
/* Edge connecting p0 to p1, incident with all 5 clustered vertices */
#50=EDGE_CURVE('multi_vertex',#20,#21,#42,.T.);
#51=EDGE_CURVE('',#21,#22,#42,.T.);
#52=EDGE_CURVE('',#22,#23,#42,.T.);
#53=EDGE_CURVE('',#23,#24,#42,.T.);
/* Units and context with high precision (1e-7) */
#100=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#101=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#102=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#103=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#100,
  'distance_accuracy_value','');
#104=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#103))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#100,#101,#102))
  REPRESENTATION_CONTEXT('','3D'));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N061','N061','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#50));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#104);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
