ISO-10303-21;
/* N133 - ShapeFix_ShapeTolerance.SetTolerance.no_validation
 * Defect: No check that precision is positive before casting to Tolerance.
 * Negative or zero precision values silently accepted, producing invalid
 * tolerances that break downstream operations. Example: SetTolerance with -0.5
 * creates TVertex::Tolerance(-0.5), corrupting tolerance semantics.
 */
HEADER;
FILE_DESCRIPTION(('N133 ShapeFix_ShapeTolerance.SetTolerance.no_validation'),'2;1');
FILE_NAME('N133.stp','2026-06-16T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Origin and axes */
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
/* Vertex that could receive invalid negative tolerance */
#20=CARTESIAN_POINT('p1',(0.0,0.0,0.0));
#30=VERTEX_POINT('v_neg_tol_candidate',#20);
#21=CARTESIAN_POINT('p2',(1.0,0.0,0.0));
#31=VERTEX_POINT('v2',#21);
/* Edge */
#40=DIRECTION('edge_dir',(1.0,0.0,0.0));
#41=VECTOR('edge_vec',#40,1.0);
#42=LINE('edge1',#20,#41);
#43=EDGE_CURVE('ec1',#30,#31,#42,.T.);
/* Edge loop */
#50=ORIENTED_EDGE('oe1',*,*,#43,.T.);
#51=EDGE_LOOP('loop1',(#50));
/* Face */
#60=PLANE('face_plane',#13,1.0);
#61=FACE_OUTER_BOUND('face_bound',#51,.T.);
#62=ADVANCED_FACE('',(#61),#60,.T.);
/* Shell */
#70=CLOSED_SHELL('shell',(#62));
/* Units and context */
#80=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#81=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#82=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#83=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#80,
  'distance_accuracy_value','nominal_tolerance');
#84=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#83))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#80,#81,#82))
  REPRESENTATION_CONTEXT('negative_tol_ctx','3D'));
/* PRODUCT CHAIN */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N133','N133','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#70));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
