#13=DIRECTION('',(1.0,0.0,0.0));
#14=VECTOR('',#13,5.0E-05);
#15=LINE('',#2,#14);
#16=EDGE_CURVE('eBridge_5e-5',#6,#7,#15,.T.);
#17=DIRECTION('',(1.0,0.0,0.0));
#18=VECTOR('',#17,10.0);
#19=LINE('',#3,#18);
#20=EDGE_CURVE('eB',#7,#8,#19,.T.);
#21=GEOMETRIC_CURVE_SET('wire_set',(#12,#16,#20));
#22=APPLICATION_CONTEXT('automotive_design');
#23=PRODUCT_CONTEXT('',#22,'mechanical');
