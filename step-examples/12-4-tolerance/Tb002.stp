ISO-10303-21;
/* Tb002: two VERTEX_POINTs 5e-5 mm apart; declared uncertainty 1.0E-7 (strict) means they are distinct; lax receiver merging at 1e-3 corrupts topology; three EDGE_CURVEs including 5e-5 mm bridge; OCC yields empty */
HEADER;
FILE_DESCRIPTION(('Tb002'),'2;1');
FILE_NAME('Tb002.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
