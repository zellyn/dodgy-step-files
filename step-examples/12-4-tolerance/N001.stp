/* N001 - Tolerance hierarchy violation (vertex tol > edge tol > face tol)
 * Defect: After ShapeFix_Shape runs, vertex tolerance can exceed the tolerance
 * of its containing edge, and edge tolerance can exceed the tolerance of its
 * containing face -- violating the canonical OCCT invariant
 * tol(vertex) <= tol(edge) <= tol(face). Downstream Boolean and meshing
 * algorithms rely on the hierarchy and produce incorrect results when violated.
 * Reproducer: face declares uncertainty 1e-7, edges/vertices in the same
 * representation context have implied healing tolerances 1e-3 / 1e-2.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N001 tolerance hierarchy violation vertex>edge>face'),'2;1');
FILE_NAME('N001.stp','2026-04-26T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#11=DIRECTION('z',(0.0,0.0,1.0));
#12=DIRECTION('x',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('plc',#10,#11,#12);
#20=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('p1',(10.0,0.0,0.0));
#30=VERTEX_POINT('',#20);
#31=VERTEX_POINT('',#21);
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,10.0);
#42=LINE('',#20,#41);
#50=EDGE_CURVE('',#30,#31,#42,.T.);
/* Face-level uncertainty declared at 1e-7 */
#60=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#61=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#62=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#63=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#60,
  'distance_accuracy_value','face_tolerance');
#64=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#63))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#60,#61,#62))
  REPRESENTATION_CONTEXT('face_ctx','3D'));
/* Defect site: vertex tolerance (1e-2) exceeds edge tolerance (1e-3)
 * which itself exceeds the face tolerance carried by the context (1e-7).
 * Receivers walking topology see V-tol=1e-2 dominating E-tol=1e-3
 * dominating F-tol=1e-7 -- inverted hierarchy.
 */
#70=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-3),#60,
  'distance_accuracy_value','edge_tolerance');
#71=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-2),#60,
  'distance_accuracy_value','vertex_tolerance');
ENDSEC;
END-ISO-10303-21;
