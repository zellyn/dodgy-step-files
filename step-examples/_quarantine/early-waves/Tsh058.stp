ISO-10303-21;
/* Tsh058 - Adjacent same-surface face merge ignores edge-preservation request
 * Two coplanar quads sharing edge V_S0 -> V_S1 along x=1. The shared edge is
 * tagged via PROPERTY_DEFINITION/PROPERTY_DEFINITION_REPRESENTATION with the
 * descriptor "keep" so a downstream merge invoked with edge-preservation
 * has both the topology and the request to honor.
 * STEP has no canonical "modification preserve" entity for an edge; the
 * keep-flag is a property association as the closest representable form. */
HEADER;
FILE_DESCRIPTION(('Tsh058 test case','Two coplanar quads sharing an edge tagged via property as `keep`'),'2;1');
FILE_NAME('Tsh058.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
/* 6 perimeter vertices */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));#21=VERTEX_POINT('V_A0',#20);
#22=CARTESIAN_POINT('',(1.0,0.0,0.0));#23=VERTEX_POINT('V_S0',#22);
#24=CARTESIAN_POINT('',(2.0,0.0,0.0));#25=VERTEX_POINT('V_B0',#24);
#26=CARTESIAN_POINT('',(2.0,1.0,0.0));#27=VERTEX_POINT('V_B1',#26);
#28=CARTESIAN_POINT('',(1.0,1.0,0.0));#29=VERTEX_POINT('V_S1',#28);
#30=CARTESIAN_POINT('',(0.0,1.0,0.0));#31=VERTEX_POINT('V_A1',#30);
/* Edges */
#40=DIRECTION('',(1.0,0.0,0.0));#41=VECTOR('',#40,1.0);#42=LINE('',#20,#41);#43=EDGE_CURVE('A_bottom',#21,#23,#42,.T.);
/* SHARED edge V_S0 -> V_S1 along x=1 -- this is the "keep" edge */
#44=DIRECTION('',(0.0,1.0,0.0));#45=VECTOR('',#44,1.0);#46=LINE('',#22,#45);
#47=EDGE_CURVE('shared_keep_edge',#23,#29,#46,.T.);
#48=DIRECTION('',(-1.0,0.0,0.0));#49=VECTOR('',#48,1.0);#50=LINE('',#28,#49);#51=EDGE_CURVE('A_top',#29,#31,#50,.T.);
#52=DIRECTION('',(0.0,-1.0,0.0));#53=VECTOR('',#52,1.0);#54=LINE('',#30,#53);#55=EDGE_CURVE('A_left',#31,#21,#54,.T.);
#56=DIRECTION('',(1.0,0.0,0.0));#57=VECTOR('',#56,1.0);#58=LINE('',#22,#57);#59=EDGE_CURVE('B_bottom',#23,#25,#58,.T.);
#60=DIRECTION('',(0.0,1.0,0.0));#61=VECTOR('',#60,1.0);#62=LINE('',#24,#61);#63=EDGE_CURVE('B_right',#25,#27,#62,.T.);
#64=DIRECTION('',(-1.0,0.0,0.0));#65=VECTOR('',#64,1.0);#66=LINE('',#26,#65);#67=EDGE_CURVE('B_top',#27,#29,#66,.T.);
#70=ORIENTED_EDGE('',*,*,#43,.T.);#71=ORIENTED_EDGE('',*,*,#47,.T.);
#72=ORIENTED_EDGE('',*,*,#51,.T.);#73=ORIENTED_EDGE('',*,*,#55,.T.);
#74=EDGE_LOOP('',(#70,#71,#72,#73));#75=FACE_OUTER_BOUND('',#74,.T.);
#76=ADVANCED_FACE('faceA',(#75),#14,.T.);
#80=ORIENTED_EDGE('',*,*,#59,.T.);#81=ORIENTED_EDGE('',*,*,#63,.T.);
#82=ORIENTED_EDGE('',*,*,#67,.T.);#83=ORIENTED_EDGE('',*,*,#47,.F.);
#84=EDGE_LOOP('',(#80,#81,#82,#83));#85=FACE_OUTER_BOUND('',#84,.T.);
#86=ADVANCED_FACE('faceB',(#85),#14,.T.);
#90=OPEN_SHELL('two_coplanar_with_keep_edge',(#76,#86));
/* Property association marking the shared edge as preserve/keep */
#100=PROPERTY_DEFINITION('keep_edge_marker','do not remove on unify',#47);
#101=DESCRIPTIVE_REPRESENTATION_ITEM('keep','keep');
#102=REPRESENTATION('keep_repr',(#101),#13);
#103=PROPERTY_DEFINITION_REPRESENTATION(#100,#102);
ENDSEC;
END-ISO-10303-21;
