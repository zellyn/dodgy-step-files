/* N062 - ShapeAnalysis_ShapeTolerance.GlobalTolerance min/max mode dispatch
 * Defect: GlobalTolerance with mode=-1 (min) returns wrong value when input
 * contains both VERTEX and EDGE with identical tolerance. The tie-breaking
 * logic is order-dependent and affected by traversal order, producing
 * inconsistent results.
 * Reproducer: Create shell with edges and vertices all declaring 1e-3 tolerance.
 * GlobalTolerance(mode=-1) should return 1e-3 but may return wrong value
 * depending on iteration order.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N062 ShapeAnalysis_ShapeTolerance min/max dispatch bug'),'2;1');
FILE_NAME('N062.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* 4-vertex square face */
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('p2',(1.0,1.0,0.0));
#13=CARTESIAN_POINT('p3',(0.0,1.0,0.0));
#20=VERTEX_POINT('v0',#10);
#21=VERTEX_POINT('v1',#11);
#22=VERTEX_POINT('v2',#12);
#23=VERTEX_POINT('v3',#13);
/* 4 edges of square */
#30=LINE('',#10,#(VECTOR('',#(DIRECTION('',(1.0,0.0,0.0))),1.0)));
#31=LINE('',#11,#(VECTOR('',#(DIRECTION('',(0.0,1.0,0.0))),1.0)));
#32=LINE('',#12,#(VECTOR('',#(DIRECTION('',(-1.0,0.0,0.0))),1.0)));
#33=LINE('',#13,#(VECTOR('',#(DIRECTION('',(0.0,-1.0,0.0))),1.0)));
#40=EDGE_CURVE('e0',#20,#21,#30,.T.);
#41=EDGE_CURVE('e1',#21,#22,#31,.T.);
#42=EDGE_CURVE('e2',#22,#23,#32,.T.);
#43=EDGE_CURVE('e3',#23,#20,#33,.T.);
/* Wire: loop of 4 edges */
#50=EDGE_LOOP('',#(#40,#41,#42,#43));
/* Plane surface */
#60=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#61=DIRECTION('z',(0.0,0.0,1.0));
#62=DIRECTION('x',(1.0,0.0,0.0));
#63=AXIS2_PLACEMENT_3D('',#60,#61,#62);
#64=PLANE('',#63);
/* Face on plane */
#65=FACE_OUTER_BOUND('',#50,.T.);
#66=ADVANCED_FACE('',(#65),#64,.T.);
/* Units and TWO tolerance declarations with same value (1e-3) */
#100=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#101=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#102=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Vertex tolerance: 1e-3 */
#103=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-3),#100,
  'distance_accuracy_value','vertex_tolerance');
/* Edge tolerance: 1e-3 (tie condition) */
#104=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-3),#100,
  'distance_accuracy_value','edge_tolerance');
#105=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#103,#104))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#100,#101,#102))
  REPRESENTATION_CONTEXT('','3D'));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N062','N062','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#66));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#105);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
