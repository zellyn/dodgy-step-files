/* N075 - ShapeFix_ShapeTolerance.SetTolerance vertex-not-in-shape
 * Defect: SetTolerance(shape, TopAbs_VERTEX, tol_value) is called on a
 * shape that contains only ADVANCED_FACE entities (no explicit VERTEX
 * entities in the topology). The routine matches shape.ShapeType against
 * the requested TopAbs type; if they don't match, nothing is updated.
 * No diagnostic is raised, silently returning without modifying tolerance.
 * Reproducer: Create a shape of faces only, call
 * SetTolerance(shape, TopAbs_VERTEX, 0.5); the function checks
 * shape.ShapeType() == TopAbs_VERTEX, finds false, and returns.
 * Expected: either apply vertex tolerance to incident vertices of all
 * faces, or raise an error.
 * Bug: silent no-op; user believes vertices were updated.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N075 ShapeFix_ShapeTolerance SetTolerance vertex-skip','2;1');
FILE_NAME('N075.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Two adjacent faces sharing an edge (no isolated VERTEX entities) */
#10=CARTESIAN_POINT('p0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p1',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('p2',(1.0,1.0,0.0));
#13=CARTESIAN_POINT('p3',(0.0,1.0,0.0));
#14=CARTESIAN_POINT('p4',(1.0,2.0,0.0));
#20=VERTEX_POINT('v0',#10);
#21=VERTEX_POINT('v1',#11);
#22=VERTEX_POINT('v2',#12);
#23=VERTEX_POINT('v3',#13);
#24=VERTEX_POINT('v4',#14);
/* First face: 0-1-2-3 quad */
#30=LINE('',#10,#(VECTOR('',#(DIRECTION('',(1.0,0.0,0.0))),1.0)));
#31=LINE('',#11,#(VECTOR('',#(DIRECTION('',(0.0,1.0,0.0))),1.0)));
#32=LINE('',#12,#(VECTOR('',#(DIRECTION('',(-1.0,0.0,0.0))),1.0)));
#33=LINE('',#13,#(VECTOR('',#(DIRECTION('',(0.0,-1.0,0.0))),1.0)));
#40=EDGE_CURVE('e0',#20,#21,#30,.T.);
#41=EDGE_CURVE('e1',#21,#22,#31,.T.);
#42=EDGE_CURVE('e2',#22,#23,#32,.T.);
#43=EDGE_CURVE('e3',#23,#20,#33,.T.);
#50=EDGE_LOOP('el1',#(#40,#41,#42,#43));
#60=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#61=DIRECTION('z',(0.0,0.0,1.0));
#62=DIRECTION('x',(1.0,0.0,0.0));
#63=AXIS2_PLACEMENT_3D('',#60,#61,#62);
#64=PLANE('xy_plane',#63);
#65=FACE_OUTER_BOUND('',#50,.T.);
#66=ADVANCED_FACE('',(#65),#64,.T.);
/* Second face: 1-2-4 triangle sharing edge 1-2 */
#70=LINE('',#11,#(VECTOR('',#(DIRECTION('',(0.0,1.0,0.0))),1.0)));
#71=LINE('',#12,#(VECTOR('',#(DIRECTION('',(-0.5,1.0,0.0))),1.118)));
#72=LINE('',#14,#(VECTOR('',#(DIRECTION('',(-0.5,-1.0,0.0))),1.118)));
#73=EDGE_CURVE('e4',#21,#22,#70,.T.);
#74=EDGE_CURVE('e5',#22,#24,#71,.T.);
#75=EDGE_CURVE('e6',#24,#21,#72,.T.);
#80=EDGE_LOOP('el2',#(#73,#74,#75));
#81=FACE_OUTER_BOUND('',#80,.T.);
#82=ADVANCED_FACE('',(#81),#64,.T.);
/* Units and tolerance; SetTolerance(shape, TopAbs_VERTEX, ...) will fail
   to update because shape-root is a compound of faces, not a vertex */
#200=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#201=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#202=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#203=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-3),#200,
  'distance_accuracy_value','');
#204=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#203))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#200,#201,#202))
  REPRESENTATION_CONTEXT('','3D'));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N075','N075','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#66,#82));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#204);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
