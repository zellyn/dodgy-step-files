ISO-10303-21;
/* Tsh066 - Same CLOSED_SHELL referenced from two MANIFOLD_SOLID_BREP entities
 * Defect: a single CLOSED_SHELL #100 is referenced as the outer shell of
 * both #200 and #201. Receivers that build in-memory topology by walking
 * each solid's outer shell either alias the shell (mutating one mutates
 * the other) or copy-on-read and lose the producer's intent. */
HEADER;
FILE_DESCRIPTION(('Tsh066 - shared CLOSED_SHELL aliased between two MANIFOLD_SOLID_BREPs'),'2;1');
FILE_NAME('Tsh066.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
/* Six identical placeholder faces - empty-bound style for compactness.
   Real fixtures would have full bounds; the defect is structural. */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
#20=ADVANCED_FACE('f1',(),#14,.T.);
#21=ADVANCED_FACE('f2',(),#14,.T.);
#22=ADVANCED_FACE('f3',(),#14,.T.);
#23=ADVANCED_FACE('f4',(),#14,.T.);
#24=ADVANCED_FACE('f5',(),#14,.T.);
#25=ADVANCED_FACE('f6',(),#14,.T.);
/* Single shell shared by both solids. */
#100=CLOSED_SHELL('shared_shell',(#20,#21,#22,#23,#24,#25));
/* Defect: both solids point at the same shell. */
#200=MANIFOLD_SOLID_BREP('body_a',#100);
#201=MANIFOLD_SOLID_BREP('body_b',#100);
#210=SHAPE_REPRESENTATION('two_solids',(#200,#201,#13),#14);
ENDSEC;
END-ISO-10303-21;
