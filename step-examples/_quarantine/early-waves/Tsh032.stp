ISO-10303-21;
/* Tsh032 - Inconsistent face orientation in mesh-derived BREP (Thingi10K cluster)
 * Defect: Adjacent faces with opposite outward normals -- flipping one
 * would heal, but the file ships inconsistent. The classic mesh-derived
 * BREP signature: one or more faces in an otherwise closed shell have
 * the wrong same_sense, breaking inside/outside classification along
 * shared edges. ~3% of Thingi10K (D013); aggregates to non-PWN/non-solid
 * ~50% (D016).
 *
 * This file: cube where the +y (BACK) face has its same_sense flipped.
 * The five other faces share consistent outward normals; the back face
 * normal points inward. orient_to_bound_a_volume / FixFaceOrientation
 * would propagate orientation from a known-correct seed and flip the
 * back face. Sources: D013, D016, H024, H025. */
HEADER;
FILE_DESCRIPTION(('Tsh032 test case','One mis-oriented face in otherwise closed shell'),'2;1');
FILE_NAME('Tsh032.stp','2026-04-26T00:00:00',(''),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
