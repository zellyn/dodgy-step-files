/* N072 - ShapeFix_Edge.FixSameParameter precision-loss via TempSameRange
 * Defect: TempSameRange clamps parameter range [0, 10] -> [0.5, 9.5] on
 * a B-spline edge. The original curve has geometric tolerance 1.0E-5 mm.
 * When range is clamped, the re-parameterized curve occupies only [0.5, 9.5],
 * which shrinks the effective resolution: geometric tolerance relative to
 * the range becomes tighter (100x smaller domain for same curve).
 * Precision-loss: if caller relied on tolerance (1.0E-5), they now get
 * tolerance in a narrower param space, causing silent precision degradation.
 * Reproducer: B-spline edge with param [0, 10], tol 1.0E-5; apply
 * TempSameRange clamping [0.5, 9.5]; re-evaluate at original tolerance.
 * Expected: tolerance adjusted after param clamping.
 * Bug: tolerance not updated; effective precision worsens silently.
 */
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('N072 ShapeFix_Edge FixSameParameter TempSameRange','2;1');
FILE_NAME('N072.stp','2026-06-15T00:00:00',(''),(''),
  'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2009,#1);
/* Vertex endpoints */
#10=CARTESIAN_POINT('p_start',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('p_end',(10.0,0.0,0.0));
#20=VERTEX_POINT('v_start',#10);
#21=VERTEX_POINT('v_end',#11);
/* B-spline curve with parameter range [0, 10] and high precision tolerance */
#30=B_SPLINE_CURVE_WITH_KNOTS('bspline_edge',3,
  (#(0.0,0.0,0.0,0.0),(5.0,5.0),(10.0,10.0,10.0,10.0)),
  (#(0.0,1.0),(5.0,2.0),(10.0,1.0)),
  .F.,.F.,(4,4));
/* Edge from this B-spline curve, high internal tolerance */
#40=EDGE_CURVE('e_bspline',#20,#21,#30,.T.);
/* Simple shell containing the edge */
#50=EDGE_LOOP('',#(#40));
#60=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#61=DIRECTION('z',(0.0,0.0,1.0));
#62=DIRECTION('x',(1.0,0.0,0.0));
#63=AXIS2_PLACEMENT_3D('',#60,#61,#62);
#64=PLANE('',#63);
#65=FACE_OUTER_BOUND('',#50,.T.);
#66=ADVANCED_FACE('',(#65),#64,.T.);
/* Units and tight tolerance (1.0E-5 mm) */
#200=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#201=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#202=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
/* Tight geometric tolerance: 1.0E-5 mm, but will be clamped internally */
#203=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-5),#200,
  'distance_accuracy_value','');
#204=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#203))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#200,#201,#202))
  REPRESENTATION_CONTEXT('','3D'));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('N072','N072','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#66));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#204);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
