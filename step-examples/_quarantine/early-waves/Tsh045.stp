ISO-10303-21;
/* Tsh045 - MANIFOLD_SOLID_BREP whose outer shell loses the closed flag after face unification
 * Six-face unit cube wrapped as CLOSED_SHELL of seven faces -- the top face
 * is split into two coplanar half-faces sharing an artificial internal
 * edge across y=0.5. After a face-unification pass the two halves merge
 * into one and the shell is structurally closed; the test exposes whether
 * the kernel correctly propagates the "closed" flag post-merge. */
HEADER;
FILE_DESCRIPTION(('Tsh045 test case','7-face cube (top split into 2 coplanar halves) -- closed shell w/ artificial split'),'2;1');
FILE_NAME('Tsh045.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* 8 cube vertices + 2 mid-edge vertices on the top face (y=0.5 split) */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));#11=VERTEX_POINT('V0',#10);
#12=CARTESIAN_POINT('',(1.0,0.0,0.0));#13=VERTEX_POINT('V1',#12);
#14=CARTESIAN_POINT('',(1.0,1.0,0.0));#15=VERTEX_POINT('V2',#14);
#16=CARTESIAN_POINT('',(0.0,1.0,0.0));#17=VERTEX_POINT('V3',#16);
#18=CARTESIAN_POINT('',(0.0,0.0,1.0));#19=VERTEX_POINT('V4',#18);
#20=CARTESIAN_POINT('',(1.0,0.0,1.0));#21=VERTEX_POINT('V5',#20);
#22=CARTESIAN_POINT('',(1.0,1.0,1.0));#23=VERTEX_POINT('V6',#22);
#24=CARTESIAN_POINT('',(0.0,1.0,1.0));#25=VERTEX_POINT('V7',#24);
/* Mid-edge vertices for top split: M5 on V5-V6, M7 on V4-V7 */
#26=CARTESIAN_POINT('',(1.0,0.5,1.0));#27=VERTEX_POINT('M5',#26);
#28=CARTESIAN_POINT('',(0.0,0.5,1.0));#29=VERTEX_POINT('M7',#28);
/* 12 cube edges + the right edge V5-V6 split into V5-M5-V6, left edge V4-V7 split into V4-M7-V7,
 * plus the artificial top split edge M5-M7 across y=0.5. */
#30=DIRECTION('',(1.0,0.0,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#10,#31);#33=EDGE_CURVE('e_V0_V1',#11,#13,#32,.T.);
#34=DIRECTION('',(0.0,1.0,0.0));#35=VECTOR('',#34,1.0);#36=LINE('',#12,#35);#37=EDGE_CURVE('e_V1_V2',#13,#15,#36,.T.);
#38=DIRECTION('',(-1.0,0.0,0.0));#39=VECTOR('',#38,1.0);#40=LINE('',#14,#39);#41=EDGE_CURVE('e_V2_V3',#15,#17,#40,.T.);
#42=DIRECTION('',(0.0,-1.0,0.0));#43=VECTOR('',#42,1.0);#44=LINE('',#16,#43);#45=EDGE_CURVE('e_V3_V0',#17,#11,#44,.T.);
#46=DIRECTION('',(0.0,0.0,1.0));#47=VECTOR('',#46,1.0);#48=LINE('',#10,#47);#49=EDGE_CURVE('e_V0_V4',#11,#19,#48,.T.);
#50=DIRECTION('',(0.0,0.0,1.0));#51=VECTOR('',#50,1.0);#52=LINE('',#12,#51);#53=EDGE_CURVE('e_V1_V5',#13,#21,#52,.T.);
#54=DIRECTION('',(0.0,0.0,1.0));#55=VECTOR('',#54,1.0);#56=LINE('',#14,#55);#57=EDGE_CURVE('e_V2_V6',#15,#23,#56,.T.);
#58=DIRECTION('',(0.0,0.0,1.0));#59=VECTOR('',#58,1.0);#60=LINE('',#16,#59);#61=EDGE_CURVE('e_V3_V7',#17,#25,#60,.T.);
#62=DIRECTION('',(1.0,0.0,0.0));#63=VECTOR('',#62,1.0);#64=LINE('',#18,#63);#65=EDGE_CURVE('e_V4_V5',#19,#21,#64,.T.);
/* RIGHT edge split: V5 -> M5 -> V6 */
#66=DIRECTION('',(0.0,1.0,0.0));#67=VECTOR('',#66,0.5);#68=LINE('',#20,#67);#69=EDGE_CURVE('e_V5_M5',#21,#27,#68,.T.);
#70=DIRECTION('',(0.0,1.0,0.0));#71=VECTOR('',#70,0.5);#72=LINE('',#26,#71);#73=EDGE_CURVE('e_M5_V6',#27,#23,#72,.T.);
#74=DIRECTION('',(-1.0,0.0,0.0));#75=VECTOR('',#74,1.0);#76=LINE('',#22,#75);#77=EDGE_CURVE('e_V6_V7',#23,#25,#76,.T.);
/* LEFT edge split: V7 -> M7 -> V4 */
#78=DIRECTION('',(0.0,-1.0,0.0));#79=VECTOR('',#78,0.5);#80=LINE('',#24,#79);#81=EDGE_CURVE('e_V7_M7',#25,#29,#80,.T.);
#82=DIRECTION('',(0.0,-1.0,0.0));#83=VECTOR('',#82,0.5);#84=LINE('',#28,#83);#85=EDGE_CURVE('e_M7_V4',#29,#19,#84,.T.);
/* Artificial top split edge M5 -> M7 (across y=0.5 at z=1) */
#86=DIRECTION('',(-1.0,0.0,0.0));#87=VECTOR('',#86,1.0);#88=LINE('',#26,#87);
#89=EDGE_CURVE('e_M5_M7_artificial_split',#27,#29,#88,.T.);
/* 6 face planes */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));#101=DIRECTION('',(0.0,0.0,-1.0));#102=DIRECTION('',(1.0,0.0,0.0));
#103=AXIS2_PLACEMENT_3D('',#100,#101,#102);#104=PLANE('bottom',#103);
#110=CARTESIAN_POINT('',(0.0,0.0,0.0));#111=DIRECTION('',(0.0,-1.0,0.0));#112=DIRECTION('',(1.0,0.0,0.0));
#113=AXIS2_PLACEMENT_3D('',#110,#111,#112);#114=PLANE('front',#113);
#120=CARTESIAN_POINT('',(1.0,0.0,0.0));#121=DIRECTION('',(1.0,0.0,0.0));#122=DIRECTION('',(0.0,1.0,0.0));
#123=AXIS2_PLACEMENT_3D('',#120,#121,#122);#124=PLANE('right',#123);
#130=CARTESIAN_POINT('',(0.0,1.0,0.0));#131=DIRECTION('',(0.0,1.0,0.0));#132=DIRECTION('',(-1.0,0.0,0.0));
#133=AXIS2_PLACEMENT_3D('',#130,#131,#132);#134=PLANE('back',#133);
#140=CARTESIAN_POINT('',(0.0,0.0,0.0));#141=DIRECTION('',(-1.0,0.0,0.0));#142=DIRECTION('',(0.0,0.0,1.0));
#143=AXIS2_PLACEMENT_3D('',#140,#141,#142);#144=PLANE('left',#143);
#150=CARTESIAN_POINT('',(0.0,0.0,1.0));#151=DIRECTION('',(0.0,0.0,1.0));#152=DIRECTION('',(1.0,0.0,0.0));
#153=AXIS2_PLACEMENT_3D('',#150,#151,#152);#154=PLANE('top',#153);
/* Five plain side+bottom faces */
#200=ORIENTED_EDGE('',*,*,#33,.F.);#201=ORIENTED_EDGE('',*,*,#45,.F.);
#202=ORIENTED_EDGE('',*,*,#41,.F.);#203=ORIENTED_EDGE('',*,*,#37,.F.);
#204=EDGE_LOOP('',(#200,#201,#202,#203));#205=FACE_OUTER_BOUND('',#204,.T.);
#206=ADVANCED_FACE('bottom_face',(#205),#104,.T.);
#210=ORIENTED_EDGE('',*,*,#33,.T.);#211=ORIENTED_EDGE('',*,*,#53,.T.);
#212=ORIENTED_EDGE('',*,*,#65,.F.);#213=ORIENTED_EDGE('',*,*,#49,.F.);
#214=EDGE_LOOP('',(#210,#211,#212,#213));#215=FACE_OUTER_BOUND('',#214,.T.);
#216=ADVANCED_FACE('front_face',(#215),#114,.T.);
/* RIGHT face uses split V5-M5 + M5-V6 */
#220=ORIENTED_EDGE('',*,*,#37,.T.);#221=ORIENTED_EDGE('',*,*,#57,.T.);
#222=ORIENTED_EDGE('',*,*,#73,.F.);#223=ORIENTED_EDGE('',*,*,#69,.F.);
#224=ORIENTED_EDGE('',*,*,#53,.F.);
#225=EDGE_LOOP('',(#220,#221,#222,#223,#224));#226=FACE_OUTER_BOUND('',#225,.T.);
#227=ADVANCED_FACE('right_face',(#226),#124,.T.);
#230=ORIENTED_EDGE('',*,*,#41,.T.);#231=ORIENTED_EDGE('',*,*,#61,.T.);
#232=ORIENTED_EDGE('',*,*,#77,.F.);#233=ORIENTED_EDGE('',*,*,#57,.F.);
#234=EDGE_LOOP('',(#230,#231,#232,#233));#235=FACE_OUTER_BOUND('',#234,.T.);
#236=ADVANCED_FACE('back_face',(#235),#134,.T.);
/* LEFT face uses V7-M7 + M7-V4 */
#240=ORIENTED_EDGE('',*,*,#45,.T.);#241=ORIENTED_EDGE('',*,*,#49,.T.);
#242=ORIENTED_EDGE('',*,*,#85,.F.);#243=ORIENTED_EDGE('',*,*,#81,.F.);
#244=ORIENTED_EDGE('',*,*,#61,.F.);
#245=EDGE_LOOP('',(#240,#241,#242,#243,#244));#246=FACE_OUTER_BOUND('',#245,.T.);
#247=ADVANCED_FACE('left_face',(#246),#144,.T.);
/* TOP -- split into TWO coplanar faces sharing the artificial M5-M7 edge */
/* Top half A (y in [0, 0.5]): V4 -> V5 -> M5 -> M7 -> V4 */
#250=ORIENTED_EDGE('',*,*,#65,.T.);#251=ORIENTED_EDGE('',*,*,#69,.T.);
#252=ORIENTED_EDGE('',*,*,#89,.T.);#253=ORIENTED_EDGE('',*,*,#85,.T.);
#254=EDGE_LOOP('top_half_lower_y',(#250,#251,#252,#253));#255=FACE_OUTER_BOUND('',#254,.T.);
#256=ADVANCED_FACE('top_half_A_coplanar',(#255),#154,.T.);
/* Top half B (y in [0.5, 1]): M5 -> V6 -> V7 -> M7 -> M5 */
#260=ORIENTED_EDGE('',*,*,#73,.T.);#261=ORIENTED_EDGE('',*,*,#77,.T.);
#262=ORIENTED_EDGE('',*,*,#81,.T.);#263=ORIENTED_EDGE('',*,*,#89,.F.);
#264=EDGE_LOOP('top_half_upper_y',(#260,#261,#262,#263));#265=FACE_OUTER_BOUND('',#264,.T.);
#266=ADVANCED_FACE('top_half_B_coplanar',(#265),#154,.T.);
/* CLOSED_SHELL of 7 faces (5 sides + bottom + 2 coplanar top halves). */
#270=CLOSED_SHELL('cube_with_split_top_coplanar',(#206,#216,#227,#236,#247,#256,#266));
#271=MANIFOLD_SOLID_BREP('solid_pre_unify',#270);
ENDSEC;
END-ISO-10303-21;
