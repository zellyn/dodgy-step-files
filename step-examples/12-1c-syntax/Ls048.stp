/* Ls048 - Complex entity record: ancestor leaf NAMED_UNIT omitted
   ----------------------------------------------------------------------
   Catalog section : §12.1c complex entity instances
   Sources         : T025, Q046, G088, N032
   See also        : Ls010, Ls047
   ----------------------------------------------------------------------
   Defect
     The external mapping of a multiple-inheritance entity must list ALL
     ancestor leaves. A writer that elides an ancestor produces a record
     that resolves ambiguously on dispatch.
     The missing ancestor is NAMED_UNIT (the star-arg leaf between
     CONVERSION_BASED_UNIT and PLANE_ANGLE_UNIT).
     This defective form omits that intermediate ancestor leaf.
   Expected behavior
     Reject the record (or accept-with-warning and synthesise the missing
     ancestor); never silently bind to an arbitrary subset of the type lattice.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls048 - complex entity ancestor leaf omitted'),'2;1');
FILE_NAME('Ls048.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* #9 is a plain SI radian unit used as the conversion factor reference */
#9=( SI_UNIT(.MILLI.,.RADIAN.) );
/* Defect: the NAMED_UNIT ancestor leaf is missing from the complex unit record */
/* The intermediate ancestor (star-arg) between CONVERSION_BASED_UNIT and */
/* PLANE_ANGLE_UNIT must be included per ISO 10303-21 external mapping rules */
#10=( CONVERSION_BASED_UNIT('DEG',#9) PLANE_ANGLE_UNIT() );
ENDSEC;
END-ISO-10303-21;
