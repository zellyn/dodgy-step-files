ISO-10303-21;
/* In012 - Dependency cycle in entity references (transfer dead-loop).
 * Defect: MAPPED_ITEM mapping_source resolves through a chain that
 * re-references the original. */
HEADER;
FILE_DESCRIPTION(('In012 - circular reference','Pass C gap-fill'),'2;1');
FILE_NAME('In012.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Two REPRESENTATION_MAPs in a self-referential chain */
#20=REPRESENTATION_MAP(#13,#21);
#21=SHAPE_REPRESENTATION('selfref',(#22),#23);
#22=MAPPED_ITEM('cycle','',#20,#13);
#23=GEOMETRIC_REPRESENTATION_CONTEXT('',$,3);
ENDSEC;
END-ISO-10303-21;
