/* Ls023 - Missing or malformed opening magic line "ISO-10303-21;"
   ----------------------------------------------------------------------
   Catalog section : §12.1c structural / framing
   Sources         : T001, A028, N001
   Originally also catalogued as: Lh001
   See also        : Le001
   ----------------------------------------------------------------------
   Defect
     The first non-whitespace token must be "ISO-10303-21;" - case-
     sensitive, hyphens, no leading whitespace, no BOM. Real files
     prepend UTF-8 BOM (EF BB BF), use lower case, miss the trailing
     semicolon, double the hyphens ("ISO--10303-21"), or wrap in an
     XML envelope.
     This file uses lower case AND omits the trailing ';'.
   Expected behavior
     Strict reject. Lenient mode strip UTF-8 BOM, uppercase-compare the
     keyword, warn and continue. Reject UTF-16 / UTF-32 BOMs with a
     clear "encoding not supported" error rather than truncating.
   ----------------------------------------------------------------------
*/
iso-10303-21
HEADER;
FILE_DESCRIPTION(('Ls023 - malformed opening magic line'),'2;1');
FILE_NAME('Ls023.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#20=DIRECTION('x',(1.0,0.0,0.0));
#30=AXIS2_PLACEMENT_3D('placement',#10,#20,$);
ENDSEC;
END-ISO-10303-21;
