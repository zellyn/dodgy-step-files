/* Ls051 - Instance ID with 22 digits (overflows uint64_t accumulator)
   ----------------------------------------------------------------------
   Catalog section : §12.1c instance-namespace
   Sources         : T016, T017, A022
   See also        : Ls038, Ls052
   ----------------------------------------------------------------------
   Defect
     A 22-digit instance ID overflows a uint64_t accumulator during
     digit-by-digit parsing. stepcode historically skips an entire
     section when an ID width exceeds its allocator's digits10 + 1.
     UINT64_MAX has 20 digits; #9999999999999999999999 has 22.
   Expected behavior
     Detect overflow during digit accumulation and reject with
     E_INSTANCE_ID_RANGE; emit a per-instance diagnostic and continue.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls051 - 22-digit instance ID overflows uint64_t'),'2;1');
FILE_NAME('Ls051.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('anchor',(0.,0.,0.));
/* Defect: 22-digit ID overflows uint64_t accumulator */
/* A compliant reader must reject this or emit a per-instance diagnostic */
#9999999999999999999999=CARTESIAN_POINT('huge',(0.,0.,0.));
ENDSEC;
END-ISO-10303-21;
