ISO-10303-21;
/* In003 - B-spline knot count off-by-one, auto-fixed by reader.
 * Defect: a Fail-class diagnostic (knot count wrong) is downgraded
 * to a Warning by the reader's Mend pass. */
HEADER;
FILE_DESCRIPTION(('In003 - mend demotes fail to warning','Pass C gap-fill'),'2;1');
FILE_NAME('In003.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(1.0,1.0,0.0));
#12=CARTESIAN_POINT('',(2.0,0.0,0.0));
/* Defect: B-spline degree 2 needs n+degree+1 = 3+2+1 = 6 knots; here 7. */
#20=B_SPLINE_CURVE_WITH_KNOTS('extra_knot',2,(#10,#11,#12),.UNSPECIFIED.,
   .F.,.F.,(3,1,3),(0.0,0.5,1.0),.UNSPECIFIED.);
ENDSEC;
END-ISO-10303-21;
