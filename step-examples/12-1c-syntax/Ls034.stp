/* Ls034 - Enumeration value missing dotted delimiters or with bad casing
   ----------------------------------------------------------------------
   Catalog section : §12.1c enumeration token form
   Sources         : T035, N021
   See also        : Ls035
   ----------------------------------------------------------------------
   Defect
     ISO 10303-21 enum literals are .IDENT. (uppercase, no quotes).
     Defect 1: .true. -- lowercase body
     Defect 2: TRUE   -- bare identifier without dotted delimiters
     Defect 3: .LENGTHUNIT, -- missing closing dot (comma closes slot)
     Defect 4: ."LEFT". -- quoted body inside the dots
   Expected behavior
     Strict reject; lenient mode may case-fold but dots are non-negotiable.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls034 - malformed enumeration literals'),'2;1');
FILE_NAME('Ls034.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Defect 1: lowercase enum body -- .true. instead of .T. */
#1=DIRECTION_FLAG('flag-lc',.true.);
/* Defect 2: bare unquoted identifier without dots -- TRUE */
#2=DIRECTION_FLAG('flag-bare',TRUE);
/* Defect 3: SIUNIT with missing closing dot after LENGTHUNIT */
/* .LENGTHUNIT, has comma immediately after identifier — no closing dot */
#3=NAMED_UNIT(*,.LENGTHUNIT,$);
/* Defect 4: quoted body inside dots -- ."LEFT". */
#4=CARTESIAN_POINT('pt',(1.,0.,0.));
#5=DIRECTION('dir-quoted',(0.,1.,0.));
#6=PLACEMENT_FLAG('pf',#4,#5,."LEFT".);
ENDSEC;
END-ISO-10303-21;
