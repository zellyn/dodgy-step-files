/* Ls034 - Enumeration value missing dotted delimiters or with bad casing
   ----------------------------------------------------------------------
   Catalog section : §12.1c enumeration token form
   Sources         : T035, N021
   See also        : Ls035
   ----------------------------------------------------------------------
   Defect
     ISO 10303-21 enum literals are .IDENT. where IDENT is an EXPRESS-
     conformant identifier (uppercase letters and digits only).
     Defects: missing closing dot, lower-case body, digit-leading body,
     quoted body (."LEFT".), missing leading dot. Generators that emit
     enum values via plain Python str() routinely lose the dots.
   Expected behavior
     Strict reject; lenient mode may case-fold the identifier but the
     dots themselves are non-negotiable - rejecting the dotless form is
     mandatory because it is ambiguous with a bare keyword.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls034 - enum missing dots / bad casing'),'2;1');
FILE_NAME('Ls034.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Defect: missing closing dot after LENGTHUNIT */
#10=IFCSIUNIT(*,.LENGTHUNIT,$,.METRE.);
/* Defect: lower-case enum body (should be .TRUE. style identifier) */
#20=DIRECTION_FLAG(.true.);
/* Defect: bare keyword without dots (TRUE instead of .T.) */
#30=DIRECTION_FLAG(TRUE);
/* Defect: quoted enum body */
#40=DIRECTION_FLAG(."LEFT".);
/* Defect: missing leading dot */
#50=DIRECTION_FLAG(LEFT.);
ENDSEC;
END-ISO-10303-21;
