/* Ls027 - Legacy SCOPE/ENDSCOPE blocks (Edition 1) and EXPORT lists
   ----------------------------------------------------------------------
   Catalog section : §12.1c legacy structure
   Sources         : Q073, N043 (Implementors Issues 001/002)
   ----------------------------------------------------------------------
   Defect
     Edition 1 had inline SCOPE/ENDSCOPE delimiters; Editions 2/3 removed
     them but legacy translators still emit them. EXPORT lists also appeared
     inside ENDSCOPE in Ed.1. Implementors Issues 001/002 record the
     disagreement on whether modern processors must parse SCOPE blocks.
   Expected behavior
     Strict Ed.2/Ed.3 reject; lenient skip-to-matching-ENDSCOPE without
     aborting; emit a single informational warning per file.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls027 - legacy SCOPE/ENDSCOPE blocks'),'2;1');
FILE_NAME('Ls027.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
/* Defect: Edition-1 SCOPE block wrapping an inner entity */
SCOPE
#2=DIRECTION('x',(1.,0.,0.));
ENDSCOPE;
#3=CARTESIAN_POINT('p1',(1.,0.,0.));
/* Defect: second SCOPE block with EXPORT list (Edition-1 syntax) */
SCOPE
#4=DIRECTION('z',(0.,0.,1.));
ENDSCOPE
EXPORT(#4);
ENDSEC;
END-ISO-10303-21;
