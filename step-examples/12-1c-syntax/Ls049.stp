/* Ls049 - Boolean attribute given bare TRUE (no dots)
   ----------------------------------------------------------------------
   Catalog section : §12.1c enumeration token form
   Sources         : Q053, G028
   See also        : Ls034, Ls035, Ls050
   ----------------------------------------------------------------------
   Defect
     EDGE_CURVE.same_sense is a BOOLEAN (.T./.F. only). A writer that
     emits the bare keyword TRUE (no dots) drops the enum-token framing
     required by ISO 10303-21. Distinct from Ls034 in that the BOOLEAN
     slot of EDGE_CURVE is the canonical same_sense kernel surface.
   Expected behavior
     Strict reject; lenient mode may default to .T. with a warning.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls049 - EDGE_CURVE same_sense given bare TRUE without dots'),'2;1');
FILE_NAME('Ls049.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('p1',(0.,0.,0.));
#2=CARTESIAN_POINT('p2',(1.,0.,0.));
#3=DIRECTION('dir',(1.,0.,0.));
#4=VECTOR('v',#3,1.);
#5=LINE('l',#1,#4);
#6=VERTEX_POINT('v1',#1);
#7=VERTEX_POINT('v2',#2);
/* Defect: bare TRUE (no dots) at the same_sense BOOLEAN slot */
/* Correct form would be: #8=EDGE_CURVE('',#6,#7,#5,.T.); */
#8=EDGE_CURVE('',#6,#7,#5,TRUE);
ENDSEC;
END-ISO-10303-21;
