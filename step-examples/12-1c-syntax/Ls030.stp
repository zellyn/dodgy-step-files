/* Ls030 - Apostrophe inside comment misread as string delimiter
   ----------------------------------------------------------------------
   Catalog section : §12.1c comments
   Sources         : T002
   Fixture kind    : conformance-probe
   ----------------------------------------------------------------------
   Defect
     A comment containing an apostrophe is rejected because the comment-skip
     routine and a separate string-literal recognizer share a regex/scanner
     that mis-pairs the in-comment apostrophe with the next apostrophe in
     the file.
   Expected behavior
     Heal and accept: comments scanned to next */ independent of any string
     state; apostrophe inside comment is opaque.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls030 - apostrophe in comment misread as string delimiter'),'2;1');
FILE_NAME('Ls030.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
/* Defect: apostrophe inside this comment -- scanner must NOT treat it as a string open */
/* plane angle is 'degree' as non-SI unit; the apostrophes here are inside the comment */
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=DIRECTION('x',(1.,0.,0.));
/* another comment with apostrophe: it's fine inside here */
ENDSEC;
END-ISO-10303-21;
