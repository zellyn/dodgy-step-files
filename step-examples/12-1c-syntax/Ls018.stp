/* Ls018 - Two consecutive semicolons (;;) after instance
   ----------------------------------------------------------------------
   Catalog section : §12.1c punctuation
   Sources         : T019, A018
   Originally also catalogued as: Ad018
   ----------------------------------------------------------------------
   Defect
     A trailing extra ';' confuses parsers expecting another '#' definition
     or an 'ENDSEC' keyword. The second ';' may be tokenized as the start
     of an empty entity, leading to a NULL entity-class lookup and later
     null-deref or garbage type-id dispatch.
   Expected behavior
     Strict mode: reject with "unexpected ';' at top level".
     Lenient mode: silently drop empty statements with W_EMPTY_STATEMENT
     diagnostic; never construct an empty / NULL entity.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls018 - double semicolon after instance'),'2;1');
FILE_NAME('Ls018.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#10=CARTESIAN_POINT('p',(0.0,0.0,0.0));
#11=DIRECTION('x',(1.0,0.0,0.0));
/* Defect: two consecutive semicolons after the instance terminator */
#20=IFCPROJECT('xyz',#5,'',$,$,$,$,(#11),#10);;
/* Defect: triple semicolon */
#21=DIRECTION('y',(0.0,1.0,0.0));;;
#30=AXIS2_PLACEMENT_3D('placement',#10,#11,$);
ENDSEC;
END-ISO-10303-21;
