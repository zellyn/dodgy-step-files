/* Ls035 - Boolean attribute given .U. (LOGICAL UNKNOWN at BOOLEAN slot)
   ----------------------------------------------------------------------
   Catalog section : §12.1c enumeration token form
   Sources         : Q053, G028
   See also        : Ad044, Ls034, Ls049, Ls050
   ----------------------------------------------------------------------
   Defect
     EDGE_CURVE.same_sense is BOOLEAN (.T./.F. only). Passing .U.
     (LOGICAL UNKNOWN) conflates LOGICAL with BOOLEAN. Some readers
     default to true, leaving an uninitialised bool; non-deterministic
     edge direction results. OCCT 0029944 (gcc 4.9 regression).
   Expected behavior
     Reject .U. at a BOOLEAN slot; or default to .T. with explicit warning;
     never leave the BOOLEAN uninitialised.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls035 - .U. LOGICAL UNKNOWN in BOOLEAN same_sense slot'),'2;1');
FILE_NAME('Ls035.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('p1',(0.,0.,0.));
#2=CARTESIAN_POINT('p2',(1.,0.,0.));
#3=DIRECTION('dir',(1.,0.,0.));
#4=VECTOR('v',#3,1.);
#5=LINE('l',#1,#4);
#6=VERTEX_POINT('v1',#1);
#7=VERTEX_POINT('v2',#2);
/* Defect: .U. in the same_sense BOOLEAN slot of EDGE_CURVE */
#8=EDGE_CURVE('',#6,#7,#5,.U.);
ENDSEC;
END-ISO-10303-21;
