/* Ls035 - Boolean attribute given .U. (LOGICAL UNKNOWN)
   ----------------------------------------------------------------------
   Catalog section : §12.1c enumeration token form
   Sources         : Q053, G028
   See also        : Ad044, Ls034, Ls049, Ls050
   ----------------------------------------------------------------------
   Defect
     EDGE_CURVE.same_sense is a BOOLEAN (.T. / .F.). Passing .U. (the
     LOGICAL UNKNOWN value) at this slot conflates LOGICAL with BOOLEAN.
     Some readers default to true, leaving an uninitialised bool that
     produces non-deterministic edge direction. A regression on gcc 4.9
     was noted in OCCT 0029944 from exactly this pattern.
   Expected behavior
     Reject the value (or default to .T. with an explicit warning);
     never leave the BOOLEAN uninitialised.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls035 - BOOLEAN given .U. (LOGICAL)'),'2;1');
FILE_NAME('Ls035.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#10=CARTESIAN_POINT('a',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('b',(1.0,0.0,0.0));
#12=VERTEX_POINT('',#10);
#13=VERTEX_POINT('',#11);
#14=LINE('',#10,$);
/* Defect: same_sense is .U. (LOGICAL UNKNOWN) where BOOLEAN is required */
#20=EDGE_CURVE('',#12,#13,#14,.U.);
ENDSEC;
END-ISO-10303-21;
