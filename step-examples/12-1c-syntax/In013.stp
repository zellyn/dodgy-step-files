/* Transfer status stays Void with no diagnostic emitted. */
#1=HYPOTHETICAL_AP242_ED2_FUTURE_ENTITY('future_001',42,'schema_version_9999',(1.0,2.0,3.0),.UNKNOWN_ENUM_VALUE.);
/* A second unknown entity to confirm the per-file summary lists both. */
#2=HYPOTHETICAL_AP242_ED2_FUTURE_ENTITY('future_002',99,'schema_version_9999',(4.0,5.0,6.0),.ANOTHER_UNKNOWN_VALUE.);
ENDSEC;
END-ISO-10303-21;
