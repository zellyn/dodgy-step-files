/* Ls005 - Explicit positive sign on numeric literal (+1.0)
   ----------------------------------------------------------------------
   Catalog section : §12.1c numeric-literal grammar
   Sources         : T044
   See also        : Ls001
   ----------------------------------------------------------------------
   Defect
     Some generators write +1.0 for positive REAL values. The Part-21
     BNF arguably disallows leading + for INTEGER but admits it for REAL;
     uniform handling is preferred. Below, every numeric carries an
     explicit '+' sign.
   Expected behavior
     Accept signed reals and integers uniformly; never silently strip
     the sign. Strict-mode tools may warn about non-canonical sign on
     INTEGER.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls005 - leading plus sign on numeric literal'),'2;1');
FILE_NAME('Ls005.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#10=CARTESIAN_POINT('origin',(+0.0,+0.0,+0.0));
/* Defect: explicit '+' sign on REAL literals */
#20=DIRECTION('x',(+1.0,+0.0,+0.0));
#30=DIRECTION('z',(+0.0,+0.0,+1.0));
/* Defect: explicit '+' sign on an INTEGER literal slot */
#31=POSITIVE_INTEGER_VALUE(+42);
#40=AXIS2_PLACEMENT_3D('placement',#10,#20,#30);
ENDSEC;
END-ISO-10303-21;
