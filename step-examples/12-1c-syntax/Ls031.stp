/* Ls031 - Forward-slash inside comment treated as nested-comment open
   ----------------------------------------------------------------------
   Catalog section : §12.1c comments
   Sources         : T003, N029
   ----------------------------------------------------------------------
   Defect
     ISO 10303-21 comments do not nest. A naive scanner that re-fires on
     inner /* desynchronizes when comments contain Windows paths or URLs.
   Expected behavior
     Heal and accept: only */ ends a comment; /* within a comment is literal
     text. After the first */ everything else is code.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls031 - nested comment open from slash in comment'),'2;1');
FILE_NAME('Ls031.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
/* Defect 1: Windows path inside comment -- the C: is NOT a nested comment open */
/* source file: C:/models/step/export.stp revision 3 */
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
/* Defect 2: nested /* marker inside comment -- outer /* inner */ still comment */
#2=DIRECTION('x',(1.,0.,0.));
/* outer /* inner comment here */ this text must still be inside outer */
#3=CARTESIAN_POINT('p',(1.,1.,0.));
ENDSEC;
END-ISO-10303-21;
