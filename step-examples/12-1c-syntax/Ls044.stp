/* Ls044 - String concatenation across consecutive literals (not allowed)
   ----------------------------------------------------------------------
   Catalog section : §12.1c string-quoting (impacts grammar shape)
   Sources         : N055
   ----------------------------------------------------------------------
   Defect
     Unlike C, Part 21 does not concatenate adjacent string literals.
     'foo' 'bar' is two strings, not one. Generators that line-wrap long
     strings by writing two consecutive literals corrupt the data when the
     position expects exactly one STRING.
   Expected behavior
     Reject adjacent literals in a single-STRING slot.
     When position is LIST OF STRING, accept as two elements but warn.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
/* Defect 1: FILE_DESCRIPTION list has two adjacent literals in one slot */
FILE_DESCRIPTION(('first part' ' second part'),'2;1');
FILE_NAME('Ls044.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=DIRECTION('x',(1.,0.,0.));
#3=VECTOR('v',#2,1.);
/* Defect 2: PRODUCT description split across two adjacent string literals */
#4=PRODUCT('part-001','a very long product ' 'description that was line-wrapped','',());
ENDSEC;
END-ISO-10303-21;
