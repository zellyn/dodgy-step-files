/* Ls020 - Trailing semicolon after ENDSEC missing
   ----------------------------------------------------------------------
   Catalog section : §12.1c structural / framing
   Sources         : N049
   Originally also catalogued as: Ad066
   ----------------------------------------------------------------------
   Defect
     Each ENDSEC must be followed by a semicolon. Files sometimes carry
     ENDSEC followed directly by a newline and the next section keyword,
     usually because a hand-edited file dropped the terminator or a
     generator concatenated sections without inserting it.
   Expected behavior
     Strict reject ("expected ';' after ENDSEC"); lenient may accept and
     warn once per section.
   ----------------------------------------------------------------------
   Reproducer
     HEADER;
     ...
     ENDSEC               <- missing ';'
     DATA;
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls020 - ENDSEC without trailing semicolon'),'2;1');
FILE_NAME('Ls020.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC
DATA;
#10=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#20=DIRECTION('x',(1.0,0.0,0.0));
#30=AXIS2_PLACEMENT_3D('placement',#10,#20,$);
ENDSEC;
END-ISO-10303-21;
