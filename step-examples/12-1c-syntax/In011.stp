ISO-10303-21;
/* In011 - Entity transfer raises exception; binding yields null.
 * Defect: B-spline whose control-point coordinates have extreme magnitudes
 * close to the 64-bit float upper edge. NaN is not lexically representable
 * in Part-21, so we use 1.0E+308 (max-binade) values plus dependent geometry
 * that multiplies them, so naive transfer-time arithmetic overflows to Inf.
 * The exception path is exercised; the binding is left null. */
HEADER;
FILE_DESCRIPTION(('In011 - exception bound to null','Pass C gap-fill'),'2;1');
FILE_NAME('In011.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Control points with extreme-magnitude coordinates near the 64-bit float
   ceiling. Any pairwise multiplication during length / norm evaluation
   overflows to +Inf, and the resulting non-finite triggers the
   transfer exception. */
#10=CARTESIAN_POINT('cp_extreme_a',(1.0E+308,0.0,0.0));
#11=CARTESIAN_POINT('cp_extreme_b',(1.0E+308,1.0E+308,0.0));
#12=CARTESIAN_POINT('cp_extreme_c',(1.0E+308,1.0E+308,1.0E+308));
/* Subnormal value (smallest positive double, ~5e-324) for a separate
   precision-loss path on dependent geometry */
#13=CARTESIAN_POINT('cp_subnormal',(5.0E-324,0.0,0.0));
#20=B_SPLINE_CURVE_WITH_KNOTS('exception_trigger',2,(#10,#11,#12),
   .UNSPECIFIED.,.F.,.F.,(3,3),(0.0,1.0),.UNSPECIFIED.);
/* Dependent VECTOR/LINE that, when normalised, multiplies cp_extreme
   coordinates and drives the result to +Inf */
#30=DIRECTION('overflow_dir',(1.0E+308,1.0E+308,0.0));
#31=VECTOR('overflow_vec',#30,1.0E+154);
#32=LINE('overflow_line',#10,#31);
ENDSEC;
END-ISO-10303-21;
