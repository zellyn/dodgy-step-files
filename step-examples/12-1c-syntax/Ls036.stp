/* Ls036 - Binary literal malformed (bit-count nibble or hex case)
   ----------------------------------------------------------------------
   Catalog section : §12.1c binary-literal grammar
   Sources         : T036, A024, N020
   ----------------------------------------------------------------------
   Defect
     ISO 10303-21 BINARY syntax: "<n><HEX>*" where n in {0,1,2,3}.
     Defect 1: "0dead" -- lowercase hex digits (must be uppercase)
     Defect 2: "4DEAD" -- leading nibble 4 is out of range {0,1,2,3}
     Defect 3: "FF"   -- missing leading nibble entirely
     Defect 4: "3DAD" -- odd hex-digit count after nibble (must be even)
   Expected behavior
     Strict reject all four forms; lenient may accept lowercase with warning.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls036 - malformed BINARY literals'),'2;1');
FILE_NAME('Ls036.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Defect 1: lowercase hex digits in binary literal -- "0dead" */
#1=BINARY_ATTR('lc-hex',"0dead");
/* Defect 2: leading nibble out of range -- "4DEAD" (nibble must be 0-3) */
#2=BINARY_ATTR('bad-nibble',"4DEAD");
/* Defect 3: missing leading nibble entirely -- "FF" */
#3=BINARY_ATTR('no-nibble',"FF");
/* Defect 4: odd hex-digit count after nibble -- "3DAD" (3 hex digits, not even) */
#4=BINARY_ATTR('odd-count',"3DAD");
ENDSEC;
END-ISO-10303-21;
