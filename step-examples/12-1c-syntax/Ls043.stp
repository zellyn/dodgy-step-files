/* Ls043 - Excessively long entity name / hyphen in identifier
   ----------------------------------------------------------------------
   Catalog section : §12.1c lexical / identifier limits
   Sources         : A021, S002
   ----------------------------------------------------------------------
   Defect
     Parser copies entity name into a fixed-size identifier buffer;
     classic strcpy overflow. ISO conformance class permits long names
     but not unbounded.
     Defect 1: entity name is 80 uppercase A's — overflows a 32/64-char buffer.
     Defect 2: BS7752-1 — hyphen is not a valid identifier character.
   Expected behavior
     Reject overflow before allocation (max ~256 chars per ISO);
     reject hyphen in identifier; lenient mode may map hyphen to underscore.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls043 - excessively long entity name and hyphen in identifier'),'2;1');
FILE_NAME('Ls043.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Defect 1: entity name is 80 uppercase A characters — fixed-buffer overflow */
#1=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA('overflow-test',(0.,0.,0.));
/* Defect 2: embedded hyphen in entity name (BS7752-1) */
/* ISO 10303-21 §4.2: identifiers use letters, digits, underscore only */
#2=BS7752-1('hyphen-name',(1.,0.,0.));
ENDSEC;
END-ISO-10303-21;
