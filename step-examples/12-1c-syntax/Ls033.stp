/* Ls033 - Whitespace handling: tab/CR/LF/FF as token separators
   ----------------------------------------------------------------------
   Catalog section : §12.1c whitespace
   Sources         : T031, T032, T037, N030, N031
   See also        : Le028
   ----------------------------------------------------------------------
   Defect
     ISO 10303-21 §5.2: LF, CR, TAB, FF are ignored characters.
     §5.6: only SPACE, comments, and print directives separate tokens.
     Critical defect: embedded whitespace inside #NNN reference
     (between # and digits) — this changes what the tokenizer reads.
     Defect 1: space between # and instance number: # 1=...
     Defect 2: TAB characters used as token separators.
   Expected behavior
     Reject embedded whitespace inside #N (between # and digits);
     treat any ASCII whitespace as separator elsewhere.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls033 - whitespace inside instance-ID and TAB separators'),'2;1');
FILE_NAME('Ls033.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Defect 1: space between # and instance number -- # 1 is NOT #1 per §5.6 */
# 1=CARTESIAN_POINT('origin',(0.,0.,0.));
/* Defect 2: TAB characters used as token separators throughout */
#2	=	CARTESIAN_POINT('p1',(1.,0.,0.));
#3	=	DIRECTION('x',(1.,0.,0.));
/* Defect 3: space inside back-reference -- # 1 as argument */
#4=VECTOR('v',# 3,1.);
ENDSEC;
END-ISO-10303-21;
