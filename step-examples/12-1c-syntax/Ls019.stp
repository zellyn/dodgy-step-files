/* Ls019 - Missing closing ) of an aggregate (paren imbalance)
   ----------------------------------------------------------------------
   Catalog section : §12.1c punctuation
   Sources         : T043, N050
   ----------------------------------------------------------------------
   Defect
     A truncated coordinate list like ((1.,2.,3.),(4.,5.,6.) (one ) short)
     causes scanners to walk past the ; of the next instance. Common when
     nested aggregates contain empty inner lists (()) vs ().
   Expected behavior
     Track paren depth per instance; on ; at depth>0, reject with
     'unbalanced parentheses' naming the unmatched open paren.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls019 - missing closing paren in aggregate'),'2;1');
FILE_NAME('Ls019.stp','2026-06-20T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('p1',(0.,0.,0.));
#2=CARTESIAN_POINT('p2',(1.,0.,0.));
#3=CARTESIAN_POINT('p3',(1.,1.,0.));
/* Defect: outer aggregate opened but never closed before semicolon (depth=1 at ;) */
#4=IFCPOLYLINE((#1,#2,#3);
#5=DIRECTION('x',(1.,0.,0.));
ENDSEC;
END-ISO-10303-21;
