/* Ls019 - Missing closing ')' of an aggregate (paren imbalance)
   ----------------------------------------------------------------------
   Catalog section : §12.1c punctuation
   Sources         : T043, N050
   Originally also catalogued as: Ad039
   ----------------------------------------------------------------------
   Defect
     A truncated coordinate or reference list (e.g. ((1.,2.,3.),(4.,5.,6.)
     - one ')' short - causes scanners to walk past the ';' of the next
     instance. The defect is particularly common when nested aggregates
     contain empty inner lists (e.g. (()) versus ()).
   Expected behavior
     Track paren depth per instance; on ';' at depth>0, reject with
     "unbalanced parentheses" naming the unmatched open paren by its
     line/column. Never resynchronize on the next ';' - report at end
     of input or at first valid recovery boundary.
   ----------------------------------------------------------------------
*/
ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Ls019 - missing closing paren in aggregate'),'2;1');
FILE_NAME('Ls019.stp','2026-04-26T00:00:00',('auto-generated'),(''),
  'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#10=CARTESIAN_POINT('a',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('b',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('c',(1.0,1.0,0.0));
/* Defect: aggregate is missing its closing ')'; the next ';' belongs to #20 */
#15=IFCPOLYLINE((#10,#11,#12);
#20=DIRECTION('x',(1.0,0.0,0.0));
ENDSEC;
END-ISO-10303-21;
