ISO-10303-21;
/* U033: Explicit INCH unit in file conflicts with reader default MM setting */
/* xstep.cascade.unit = MM but file declares CONVERSION_BASED_UNIT('INCH',25.4) */
/* DEFECT: reader may silently apply default MM, apply file INCH, or double-convert */
/* Kernel must: use file-declared unit; warn when file and config disagree */
HEADER;
FILE_DESCRIPTION(('U033: INCH file unit vs MM reader default — silent override defect'),'2;1');
FILE_NAME('U033.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: 2x2x1 inch part; values are in inches */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(2.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,2.0,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,1.0));
#5=CARTESIAN_POINT('corner-xyz',(2.0,2.0,1.0));
/* SI mm basis for conversion reference */
#8=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
/* INCH conversion: 25.4 mm per inch (correct factor) */
#9=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#8);
/* File declares INCH as the active length unit */
#10=(CONVERSION_BASED_UNIT('INCH',#9) LENGTH_UNIT() NAMED_UNIT(*));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.000393701),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
/* DEFECT: reader configured with MM default; file declares INCH */
/* Some readers apply default (ignoring file), some double-convert, some warn */
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#20=GEOMETRIC_CURVE_SET('inch-vs-mm-default',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
