ISO-10303-21;
/* U036 - BinXCAF does not preserve length unit
 * Defect: document with LENGTH_UNIT INCH and one cube of side 1.0; XBF reload defaults to mm */
HEADER;
FILE_DESCRIPTION(('U036 test case','BinXCAF does not preserve length unit'),'2;1');
FILE_NAME('U036.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#100=(LENGTH_UNIT() NAMED_UNIT(*) CONVERSION_BASED_UNIT('INCH',#101));
#101=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#102);
#102=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
ENDSEC;
END-ISO-10303-21;
