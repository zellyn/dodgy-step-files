ISO-10303-21;
/* U014: OCCT 7.8 regression — write.units ignored */
/* LENGTH_UNIT declared as bare SI_UNIT($,.METRE.) but coordinates are mm-sized */
/* OCCT STEPControl_Writer with write.step.unit M still emits mm coordinates */
/* Literal interpretation: 100.0 metres x 50.0 metres — 1000x too large */
HEADER;
FILE_DESCRIPTION(('U014: SI_UNIT(METRE) with mm-scale coordinates (OCCT 7.8 regression)'),'2;1');
FILE_NAME('U014.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: 100x50x25.4 mm part; coordinates remain mm despite METRE unit declaration */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(100.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,50.0,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,25.4));
#5=CARTESIAN_POINT('corner-xyz',(100.0,50.0,25.4));
#6=DIRECTION('xdir',(1.,0.,0.));
#7=DIRECTION('zdir',(0.,0.,1.));
/* DEFECT: SI_UNIT($,.METRE.) — bare METRE, no .MILLI. prefix */
/* OCCT 7.8 regression: write.step.unit M was requested but coordinates are mm-scale */
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-07),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#20=GEOMETRIC_CURVE_SET('occt-78-metre-with-mm-coords',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
