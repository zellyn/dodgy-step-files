ISO-10303-21;
/* U038: MAPPED_ITEM cross-context unit composition error */
/* Root context: mm; REPRESENTATION_MAP source context: metres */
/* DEFECT: buggy reader re-applies 1000x unit factor on MAPPED_ITEM placement */
/* Correct: unit factor applied once at leaf level; MAPPED_ITEM is a transform only */
HEADER;
FILE_DESCRIPTION(('U038: MAPPED_ITEM target mm vs source metre cross-context unit composition'),'2;1');
FILE_NAME('U038.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Root geometry context: millimetres */
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
/* Root context in mm (MILLI METRE) */
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('root_mm','3D'));
/* Source REPRESENTATION_MAP context: metres (no prefix) */
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.));
#21=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#22=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#23=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#20,
  'distance_accuracy_value','maximum model space distance between geometric entities');
/* DEFECT: source context is metres — 1000x mismatch with root mm context */
#24=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#23))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#21,#22)) REPRESENTATION_CONTEXT('source_m','3D'));
/* Source geometry in metres: 0.05m = 50mm cube */
#30=CARTESIAN_POINT('src_origin',(0.,0.,0.));
#31=CARTESIAN_POINT('src_corner_x',(0.05,0.,0.));
#32=CARTESIAN_POINT('src_corner_y',(0.,0.05,0.));
#33=CARTESIAN_POINT('src_corner_z',(0.,0.,0.025));
#34=CARTESIAN_POINT('src_corner_xyz',(0.05,0.05,0.025));
/* Source SHAPE_REPRESENTATION in metre context */
#35=GEOMETRIC_CURVE_SET('source_geometry_in_metres',(#30,#31,#32,#33,#34));
/* REPRESENTATION_MAP wraps source geometry in metre context */
/* DEFECT: REPRESENTATION_MAP source carries metre context; parent root uses mm */
#40=DIRECTION('x_axis',(1.,0.,0.));
#41=DIRECTION('z_axis',(0.,0.,1.));
#42=CARTESIAN_POINT('map_origin',(0.,0.,0.));
#43=AXIS2_PLACEMENT_3D('map_origin_placement',#42,#41,#40);
#44=REPRESENTATION_MAP(#43,#35);
/* MAPPED_ITEM in root mm context references the REPRESENTATION_MAP from metre context */
/* A correct reader applies unit conversion at leaf level only */
/* A buggy reader applies 1000x TWICE: once for mm->m and once more via MAPPED_ITEM */
#50=DIRECTION('x_axis_root',(1.,0.,0.));
#51=DIRECTION('z_axis_root',(0.,0.,1.));
#52=CARTESIAN_POINT('mapped_origin',(10.,0.,0.));
#53=AXIS2_PLACEMENT_3D('mapped_placement',#52,#51,#50);
/* MAPPED_ITEM: source uses metres; target root context uses mm */
#54=MAPPED_ITEM('cross_context_map',#44,#53);
/* Root model entity with GEOMETRIC_CURVE_SET — OCC returns empty shape */
#60=GEOMETRIC_CURVE_SET('root_mm_entity',(#54));
ENDSEC;
END-ISO-10303-21;
