ISO-10303-21;
/* U034: CONVERSION_BASED_UNIT('MILE') factor is 1609.344 instead of 1609344.0 */
/* Exporter applied metres-to-mm prefix in wrong direction: 1609.344 km != 1 mile in mm */
/* Correct: 1 mile = 1609344.0 mm exactly (1609.344 km) */
/* DEFECT: factor 1609.344 under-scales geometry by 1000x on re-import */
HEADER;
FILE_DESCRIPTION(('U034: MILE conversion factor wrong: 1609.344 not 1609344.0'),'2;1');
FILE_NAME('U034.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: 1x0.5x0.25 mile part (values in miles) */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(1.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,0.5,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,0.25));
#5=CARTESIAN_POINT('corner-xyz',(1.0,0.5,0.25));
/* SI mm basis for conversion reference */
#8=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
/* DEFECT: factor 1609.344 — metres-to-mm prefix accidentally applied to miles */
/* Correct factor: 1609344.0 mm per mile */
#9=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(1609.344),#8);
/* CONVERSION_BASED_UNIT references the wrong-factor measure */
#10=(CONVERSION_BASED_UNIT('MILE',#9) LENGTH_UNIT() NAMED_UNIT(*));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(6.21371E-7),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#20=GEOMETRIC_CURVE_SET('mile-wrong-factor',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
