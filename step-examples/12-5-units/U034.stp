ISO-10303-21;
/* U034 - Mile-to-mm conversion factor wrong by 1000x
 * Defect: exporter emits CONVERSION_BASED_UNIT for MILE with factor 1609.344 instead of 1609344.0 */
HEADER;
FILE_DESCRIPTION(('U034 test case','Mile-to-mm conversion factor wrong by 1000x'),'2;1');
FILE_NAME('U034.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#100=(LENGTH_UNIT() NAMED_UNIT(*) CONVERSION_BASED_UNIT('MILE',#101));
#101=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(1609.344),#102);
#102=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
ENDSEC;
END-ISO-10303-21;
