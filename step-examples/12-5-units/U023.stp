ISO-10303-21;
/* U023: INCH conversion factor expressed as 2.54E1 (cm-based notation) */
/* Correct factor for INCH-to-mm is 25.4; using 2.54E1 signals wrong basis */
/* Kernel must verify inch conversion against known SI: 1 inch = 25.4 mm exactly */
HEADER;
FILE_DESCRIPTION(('U023: INCH conversion factor wrong: 2.54E1 not 25.4'),'2;1');
FILE_NAME('U023.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: part with mm-valued coordinates */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(50.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,50.0,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,25.0));
#5=CARTESIAN_POINT('corner-xyz',(50.0,50.0,25.0));
/* SI mm basis */
#8=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
/* DEFECT: factor is 2.54E1 — cm-based notation rather than 25.4 */
/* Correct would be: LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#8) */
#9=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(2.54E1),#8);
/* CONVERSION_BASED_UNIT references the wrong-factor measure */
#10=(CONVERSION_BASED_UNIT('INCH',#9) LENGTH_UNIT() NAMED_UNIT(*));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.0254),#8,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#20=GEOMETRIC_CURVE_SET('inch-wrong-factor',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
