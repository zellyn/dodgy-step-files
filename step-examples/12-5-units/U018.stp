ISO-10303-21;
/* U018: Tessellated annotation coords with no global_unit_assigned_context */
/* TESSELLATED_SHAPE_REPRESENTATION placed under bare REPRESENTATION_CONTEXT */
/* coordinates_list uses bare REAL values with no resolvable unit */
/* PMI tessellation appears 25.4x wrong size due to missing unit anchor */
HEADER;
FILE_DESCRIPTION(('U018: Tessellated PMI with no global_unit_assigned_context'),'2;1');
FILE_NAME('U018.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Main geometry context — properly unit-assigned */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(50.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,50.0,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,25.0));
#5=CARTESIAN_POINT('corner-xyz',(50.0,50.0,25.0));
/* Proper unit context for main geometry */
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('main-ctx','3D'));
/* Main model entity */
#20=GEOMETRIC_CURVE_SET('main-geometry',(#1,#2,#3,#4,#5));
/* DEFECT: tessellated PMI placed under bare REPRESENTATION_CONTEXT */
/* No GLOBAL_UNIT_ASSIGNED_CONTEXT => coordinates have no resolvable unit */
#50=COORDINATES_LIST('annot-pts',3,(
  (0.0,0.0,0.0),(50.0,0.0,0.0),(50.0,50.0,0.0),(0.0,50.0,0.0),
  (0.0,0.0,0.0)));
#51=TESSELLATED_GEOMETRIC_SET('tess-outline',(#50));
#52=TESSELLATED_ANNOTATION_OCCURRENCE('dim-label',(),(#51));
/* DEFECT: bare REPRESENTATION_CONTEXT — no GLOBAL_UNIT_ASSIGNED_CONTEXT */
#60=REPRESENTATION_CONTEXT('tess-pmi-ctx','3D');
#61=TESSELLATED_SHAPE_REPRESENTATION('tess-pmi-rep',(#52),#60);
ENDSEC;
END-ISO-10303-21;
