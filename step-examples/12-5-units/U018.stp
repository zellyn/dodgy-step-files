ISO-10303-21;
/*
 * U018 — Tessellated annotation coords with no global unit context
 * Defect: tessellated_shape_representation under a plain
 *         REPRESENTATION_CONTEXT (NOT a global_unit_assigned_context).
 *         Bare REAL coordinates have no resolvable unit; common
 *         breakage: tessellated PMI extracted out of context appears 25.4x.
 */
HEADER;
FILE_DESCRIPTION(('U018 tess annotation no-unit ctx'),'2;1');
FILE_NAME('U018.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('automotive design');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2001,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('U018','U018','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
/* Proper unit context for the part shape */
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#21 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#22 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#23 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#24 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#23))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#21,#22))
  REPRESENTATION_CONTEXT('part_ctx','3D') );
/* DEFECT: tessellated context lacks global_unit_assigned_context. */
#25 = REPRESENTATION_CONTEXT('tess_no_unit','3D');
#30 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#31 = DIRECTION('',(0.0,0.0,1.0));
#32 = DIRECTION('',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('',#30,#31,#32);
#34 = SHAPE_REPRESENTATION('part',(#33),#24);
/* Tessellated annotation positioned by bare REALs — magnitudes
   would be inch-valued in producer's mind, mm-valued by receiver. */
#40 = COORDINATES_LIST('',2,((0.0,0.0,0.0),(1.0,0.5,0.0)));
#41 = TESSELLATED_GEOMETRIC_SET('annot',(#40));
#42 = TESSELLATED_ANNOTATION_OCCURRENCE('annot_occ',(#41),#41);
#43 = TESSELLATED_SHAPE_REPRESENTATION('tess_rep',(#42),#25);
#50 = SHAPE_DEFINITION_REPRESENTATION(#17,#34);
ENDSEC;
END-ISO-10303-21;
