ISO-10303-21;
/* U049: two conflicting length units (MILLI + CENTI metre) assigned to one
   GLOBAL_UNIT_ASSIGNED_CONTEXT. OCC silently binds the first and ignores the
   second, so occt/gmsh shape-counts are identical to a clean single-unit model
   (oracle-invisible). The structural linter flags UNITS_INCONSISTENT. */
HEADER;
FILE_DESCRIPTION(('U049'),'2;1');
