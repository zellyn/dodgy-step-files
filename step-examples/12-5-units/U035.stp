ISO-10303-21;
/* U035: ELLIPSE semi-axes in mm but file declares INCH — 25.4x scale error on re-import */
/* Exporter emits internal mm values without converting to declared file unit (INCH) */
/* a=50.8 mm, b=25.4 mm are the mm representations of a=2.0, b=1.0 inch */
/* DEFECT: file unit is INCH, but ellipse params are in mm — re-import scales by 25.4x */
HEADER;
FILE_DESCRIPTION(('U035: Ellipse semi-axes in mm but file declares INCH unit'),'2;1');
FILE_NAME('U035.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* SI mm basis for conversion reference */
#8=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
/* INCH unit: 25.4 mm per inch */
#9=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#8);
/* File declares INCH as active length unit */
#10=(CONVERSION_BASED_UNIT('INCH',#9) LENGTH_UNIT() NAMED_UNIT(*));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(3.937E-5),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Ellipse placement: centred at origin in XY plane */
#20=CARTESIAN_POINT('ellipse-centre',(0.,0.,0.));
#21=DIRECTION('zdir',(0.,0.,1.));
#22=DIRECTION('xdir',(1.,0.,0.));
#23=AXIS2_PLACEMENT_3D('ellipse-placement',#20,#21,#22);
/* DEFECT: semi-axes 50.8 and 25.4 are mm values (= 2.0 and 1.0 inch) */
/* File unit is INCH so reader multiplies by 25.4 again -> 1289.32 x 645.16 */
/* Correct: semi-axes should be 2.0 and 1.0 when file unit is INCH */
#24=ELLIPSE('defect-ellipse',#23,50.8,25.4);
/* Geometry set containing the mis-scaled ellipse */
#25=CARTESIAN_POINT('origin',(0.,0.,0.));
#26=CARTESIAN_POINT('ref-point',(2.0,1.0,0.));
#30=GEOMETRIC_CURVE_SET('ellipse-wrong-unit',(#24,#25,#26));
ENDSEC;
END-ISO-10303-21;
