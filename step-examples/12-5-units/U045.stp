ISO-10303-21;
/* U045: CARTESIAN_TRANSFORMATION_OPERATOR_3D scale=25.4 (inch->mm conversion) */
/* DEFECT (BRL-CAD step-g): LoadONBrep stub silently drops the scale attribute */
/* Producer intent: place 1-unit inch prototype scaled by 25.4 to get 25.4 mm part */
/* Buggy receiver (step-g): stub ignores scale; subassembly arrives at 1 mm (unit scale) */
/* Correct receiver: build uniform-scale xform from parsed scale=25.4 */
HEADER;
FILE_DESCRIPTION(('U045: CARTESIAN_TRANSFORMATION_OPERATOR_3D scale=25.4 ignored by step-g'),'2;1');
FILE_NAME('U045.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Standard mm context for assembly */
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Prototype geometry: 1-unit (inch) coordinates — should become 25.4 mm after scaling */
#1=CARTESIAN_POINT('proto_origin',(0.,0.,0.));
#2=CARTESIAN_POINT('proto_corner_a',(1.,0.,0.));
#3=CARTESIAN_POINT('proto_corner_b',(0.,1.,0.));
#4=CARTESIAN_POINT('proto_corner_c',(1.,1.,1.));
/* Prototype representation (inch-space) */
#20=GEOMETRIC_CURVE_SET('inch_prototype',(#1,#2,#3,#4));
#21=SHAPE_REPRESENTATION('inch_proto_rep',(#20),#14);
/* Assembly-space axes for the CARTESIAN_TRANSFORMATION_OPERATOR_3D */
#30=CARTESIAN_POINT('xform_origin',(0.,0.,0.));
#31=DIRECTION('xform_axis1',(0.,0.,1.));
#32=DIRECTION('xform_axis2',(1.,0.,0.));
#33=CARTESIAN_POINT('xform_local_origin',(0.,0.,0.));
#34=DIRECTION('xform_local_axis1',(0.,0.,1.));
#35=DIRECTION('xform_local_axis2',(1.,0.,0.));
/* CARTESIAN_TRANSFORMATION_OPERATOR_3D: inch->mm scale factor = 25.4 */
/* BRL-CAD step-g Load() reads scale=25.4 into member variable */
/* BRL-CAD step-g LoadONBrep() is a stub: scale is NEVER applied */
#100=CARTESIAN_TRANSFORMATION_OPERATOR_3D('inch_to_mm',#30,#31,#32,25.4,#33,#34,#35);
/* Assembly representation referencing the transformation */
#110=SHAPE_REPRESENTATION('assembly_rep',(#20),#14);
/* REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION links the two representations */
#120=REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(
  'inch_to_mm_placement','scale 25.4 inch to mm',#21,#110,#100);
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#200=GEOMETRIC_CURVE_SET('cartesian-transform-scale-dropped',(#1,#2,#3,#4));
ENDSEC;
END-ISO-10303-21;
