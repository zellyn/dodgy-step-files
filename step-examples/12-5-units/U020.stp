ISO-10303-21;
/* U020: Validation properties (area/volume) with units mismatched to geometry GRC */
/* Geometry context is mm; validation properties use metre-based measures */
/* Also: one MEASURE_REPRESENTATION_ITEM has no unit_component reference */
HEADER;
FILE_DESCRIPTION(('U020: Validation property units mismatched to GRC'),'2;1');
FILE_NAME('U020.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: 50x50x10 mm block */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(50.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,50.0,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,10.0));
#5=CARTESIAN_POINT('corner-xyz',(50.0,50.0,10.0));
/* Geometry context: mm */
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Main model entity */
#20=GEOMETRIC_CURVE_SET('geometry',(#1,#2,#3,#4,#5));
/* DEFECT: Validation-property context uses METRE (not MILLI METRE) */
/* Area: 50x50 mm = 2500 mm^2, but emitted as 0.0025 m^2 in a metre context */
#30=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.));
/* DEFECT: AREA_MEASURE uses metre-squared unit — mismatched to mm GRC */
#31=(AREA_UNIT() NAMED_UNIT(*) SI_UNIT($,.SQUARE_METRE.));
/* DEFECT: VOLUME_MEASURE uses metre-cubed unit — mismatched to mm GRC */
#32=(NAMED_UNIT(*) SI_UNIT($,.CUBIC_METRE.) VOLUME_UNIT());
/* Validation property: surface area in m^2 (should be mm^2 to match GRC) */
#40=MEASURE_WITH_UNIT(AREA_MEASURE(2.5E-3),#31);
#41=MEASURE_REPRESENTATION_ITEM('surface_area',AREA_MEASURE(2.5E-3),#31);
/* Validation property: volume in m^3 (should be mm^3 to match GRC) */
#42=MEASURE_WITH_UNIT(VOLUME_MEASURE(2.5E-5),#32);
#43=MEASURE_REPRESENTATION_ITEM('volume',VOLUME_MEASURE(2.5E-5),#32);
/* DEFECT: centroid item with no unit_component reference -- dimensionless value */
#44=MEASURE_REPRESENTATION_ITEM('centroid_x',LENGTH_MEASURE(25.0),$);
ENDSEC;
END-ISO-10303-21;
