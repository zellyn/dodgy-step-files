ISO-10303-21;
/* U002: Onshape always emits METRE; NX treats metric STEP as mm (1000x too small) */
/* Onshape writes SI_UNIT($,.METRE.) with no prefix regardless of workspace display unit */
/* Coordinates are in metres: a 100x50 mm part appears as 0.1 x 0.05 m */
/* NX silently reads metre values as mm => body is 1000x too small */
HEADER;
FILE_DESCRIPTION(('U002: SI_UNIT(METRE) from Onshape misread as mm by NX'),'2;1');
FILE_NAME('U002.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: 100x50 mm part authored in Onshape, exported in metre coordinates */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(0.1,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,0.05,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,0.025));
#5=CARTESIAN_POINT('corner-xyz',(0.1,0.05,0.025));
#6=DIRECTION('xdir',(1.,0.,0.));
#7=DIRECTION('zdir',(0.,0.,1.));
/* DEFECT: SI_UNIT($,.METRE.) — no MILLI prefix — Onshape always writes base metre */
/* NX configured for mm silently treats 0.1 m as 0.1 mm => 1000x too small */
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#20=GEOMETRIC_CURVE_SET('onshape-metre-part',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
