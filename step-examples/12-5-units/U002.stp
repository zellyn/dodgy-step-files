ISO-10303-21;
/*
 * U002 — Onshape always emits METRE; NX rescales as if mm (1000x too small)
 * Defect: SI_UNIT($,.METRE.) — no prefix — coordinates in metres.
 *         Receivers that only support inch/mm treat magnitudes as mm.
 */
HEADER;
FILE_DESCRIPTION(('U002 metre-declared coords read as mm'),'2;1');
FILE_NAME('U002.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('automotive design');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2001,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('U002','U002','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
/* Producer-fixed unit: METRE with no prefix.
   A 100-mm widget is encoded as 0.1 here. */
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.) );
#22 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#23 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#24 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#20,
  'distance_accuracy_value','');
#25 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#24))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#22,#23))
  REPRESENTATION_CONTEXT('','3D') );
/* Magnitudes are metres: 0.1 m = 100 mm.
   NX-style reader assumes mm and shows a 0.1-mm widget — 1000x too small. */
#30 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#31 = CARTESIAN_POINT('',(0.1,0.0,0.0));
#32 = CARTESIAN_POINT('',(0.1,0.05,0.0));
#33 = DIRECTION('',(0.0,0.0,1.0));
#34 = DIRECTION('',(1.0,0.0,0.0));
#35 = AXIS2_PLACEMENT_3D('',#30,#33,#34);
#50 = SHAPE_REPRESENTATION('',(#35),#25);
#51 = SHAPE_DEFINITION_REPRESENTATION(#17,#50);
ENDSEC;
END-ISO-10303-21;
