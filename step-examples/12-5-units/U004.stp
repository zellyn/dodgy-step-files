ISO-10303-21;
/* U004: Inventor STEP export switches angle unit from DEGREE to RADIAN */
/* Autodesk Inventor 2018+ changed STEP angle unit to .RADIAN. for cross-vendor compat */
/* Document set to degrees display; STEP export switches to RADIAN silently */
/* On re-import the session angle preference is overwritten to radians */
HEADER;
FILE_DESCRIPTION(('U004: Inventor switches plane_angle_unit to RADIAN on export'),'2;1');
FILE_NAME('U004.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: a simple 50x50 mm part with a 45-degree chamfer */
/* Chamfer angle stored as radian value (PI/4 = 0.7854) in RADIAN unit context */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(50.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,50.0,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,20.0));
#5=CARTESIAN_POINT('corner-xyz',(50.0,50.0,20.0));
#6=DIRECTION('xdir',(1.,0.,0.));
#7=DIRECTION('zdir',(0.,0.,1.));
/* DEFECT: PLANE_ANGLE_UNIT is SI_UNIT($,.RADIAN.) — document preference was DEGREE */
/* Inventor emits RADIAN for cross-vendor consistency, overwriting doc preference */
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Angle value: 45 degrees = 0.7854 radians; doc preference was DEGREE not RADIAN */
#15=PLANE_ANGLE_MEASURE_WITH_UNIT(PLANE_ANGLE_MEASURE(0.7853981634),#11);
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#20=GEOMETRIC_CURVE_SET('inventor-radian-angle-part',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
