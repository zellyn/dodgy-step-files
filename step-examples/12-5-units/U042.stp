ISO-10303-21;
/* U042: Specific heat capacity J/(kg*K) as DERIVED_UNIT m^2*s^-2*K^-1 (kg-cancelled form) */
/* DEFECT: receivers that miss THERMODYNAMIC_TEMPERATURE_UNIT drop K^-1 factor */
/* DEFECT: receivers pattern-matching named J/kg/K unit miss the kg-cancelled form */
/* Kernel must detect m^2*s^-2*K^-1 dimensional signature and bind to J/(kg.K) */
HEADER;
FILE_DESCRIPTION(('U042: J/(kg*K) DERIVED_UNIT chain m^2*s^-2*K^-1 with THERMODYNAMIC_TEMPERATURE_UNIT'),'2;1');
FILE_NAME('U042.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: part with mm coordinates */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(50.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,50.0,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,25.0));
#5=CARTESIAN_POINT('corner-xyz',(50.0,50.0,25.0));
/* Standard mm geometry context */
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Base SI units for specific heat capacity DERIVED_UNIT chain */
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.));
#21=(NAMED_UNIT(*) SI_UNIT($,.SECOND.) TIME_UNIT());
/* THERMODYNAMIC_TEMPERATURE_UNIT for kelvin — required by specific heat chain */
/* DEFECT target: receivers that do not handle THERMODYNAMIC_TEMPERATURE_UNIT in */
/*   a DERIVED_UNIT chain silently drop the K^-1 factor */
#22=(NAMED_UNIT(*) SI_UNIT($,.KELVIN.) THERMODYNAMIC_TEMPERATURE_UNIT());
/* DERIVED_UNIT for specific heat J/(kg*K) in kg-cancelled form: m^2*s^-2*K^-1 */
#30=DERIVED_UNIT_ELEMENT(#20,2.);
#31=DERIVED_UNIT_ELEMENT(#21,-2.);
#32=DERIVED_UNIT_ELEMENT(#22,-1.);
#33=DERIVED_UNIT((#30,#31,#32));
/* Specific heat measure: 4182 J/(kg*K) (water) */
/* Receiver that drops temperature factor reads m^2*s^-2 = J/kg — wrong unit */
#40=MEASURE_REPRESENTATION_ITEM('specific_heat_capacity',LENGTH_MEASURE(4182.),#33);
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#50=GEOMETRIC_CURVE_SET('specific-heat-unit-derived-chain',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
