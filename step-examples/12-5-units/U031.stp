ISO-10303-21;
/*
 * U031 — CONVERSION_BASED_UNIT('DEG',...) DEG vs RADIAN encoding via complex
 * Defect: complex entity carries 'DEG' name but the conversion factor
 *         is 1.0 (rather than pi/180), so degrees are mathematically
 *         identical to radians. Members are also in non-alphabetical
 *         order (kernels that demand alphabetical reject the file).
 */
HEADER;
FILE_DESCRIPTION(('U031 DEG factor wrong / non-alpha members'),'2;1');
FILE_NAME('U031.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('automotive design');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2001,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('U031','U031','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
/* Length: mm (correct) */
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
/* Reference radian for angle conversion */
#21 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
/* DEFECT: factor is 1.0, should be ~0.0174533 (pi/180). */
#22 = PLANE_ANGLE_MEASURE_WITH_UNIT(PLANE_ANGLE_MEASURE(1.0),#21);
/* Complex entity with members in non-alphabetical order:
   CONVERSION_BASED_UNIT before NAMED_UNIT is fine, but
   PLANE_ANGLE_UNIT placed first violates the alphabetical
   convention readers may rely on. */
#23 = ( PLANE_ANGLE_UNIT() CONVERSION_BASED_UNIT('DEG',#22) NAMED_UNIT(*) );
#24 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#25 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#26 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#25))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#23,#24))
  REPRESENTATION_CONTEXT('','3D') );
/* "30 deg" stored as 30.0 — but factor 1.0 makes it 30 rad */
#27 = PLANE_ANGLE_MEASURE_WITH_UNIT(PLANE_ANGLE_MEASURE(30.0),#23);
#30 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#31 = DIRECTION('',(0.0,0.0,1.0));
#32 = DIRECTION('',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('',#30,#31,#32);
#50 = SHAPE_REPRESENTATION('',(#33),#26);
#51 = SHAPE_DEFINITION_REPRESENTATION(#17,#50);
ENDSEC;
END-ISO-10303-21;
