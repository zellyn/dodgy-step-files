ISO-10303-21;
/* U031: CONVERSION_BASED_UNIT('DEG') factor is 1.0 instead of pi/180 */
/* Complex plane-angle entity: ( CONVERSION_BASED_UNIT('DEG',#9) NAMED_UNIT(*) PLANE_ANGLE_UNIT() ) */
/* DEFECT: PLANE_ANGLE_MEASURE(1.0) — treats degrees as radians (57.3x error) */
/* Correct factor: PLANE_ANGLE_MEASURE(0.01745329251994329) = pi/180 */
HEADER;
FILE_DESCRIPTION(('U031: DEG complex entity with wrong conversion factor 1.0'),'2;1');
FILE_NAME('U031.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: part with coordinates in mm */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(50.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,50.0,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,25.0));
#5=CARTESIAN_POINT('corner-xyz',(50.0,50.0,25.0));
/* Radian SI base for angle */
#8=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
/* DEFECT: factor is 1.0 — kernel will interpret degree-values as radians */
/* Correct: PLANE_ANGLE_MEASURE(0.01745329251994329) */
#9=PLANE_ANGLE_MEASURE_WITH_UNIT(PLANE_ANGLE_MEASURE(1.0),#8);
/* Complex plane-angle entity with wrong factor reference */
#10=( CONVERSION_BASED_UNIT('DEG',#9) NAMED_UNIT(*) PLANE_ANGLE_UNIT() );
#11=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#11,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#11,#10,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#20=GEOMETRIC_CURVE_SET('deg-wrong-factor',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
