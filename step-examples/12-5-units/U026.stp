ISO-10303-21;
/* U026: DERIVED_UNIT entities (Newton, density) cause identity-scale fallthrough */
/* BRL-CAD step-g silently treats unresolved DERIVED_UNIT as scale=1 */
/* Kernel must walk DERIVED_UNIT_ELEMENT list and compute SI scale factor */
HEADER;
FILE_DESCRIPTION(('U026: DERIVED_UNIT treated as identity scale in BRL-CAD step-g'),'2;1');
FILE_NAME('U026.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: simple part with mm coordinates */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(50.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,50.0,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,25.0));
#5=CARTESIAN_POINT('corner-xyz',(50.0,50.0,25.0));
/* Standard SI units for geometry context */
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Base SI units needed for DERIVED_UNIT elements */
#20=(MASS_UNIT() NAMED_UNIT(*) SI_UNIT(.KILO.,.GRAM.));
#21=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.));
#22=(NAMED_UNIT(*) SI_UNIT($,.SECOND.) TIME_UNIT());
/* DEFECT: DERIVED_UNIT for Newton (kg*m*s^-2) */
/* BRL-CAD step-g does not resolve this; falls through to identity scale */
#30=DERIVED_UNIT_ELEMENT(#20,1.);
#31=DERIVED_UNIT_ELEMENT(#21,1.);
#32=DERIVED_UNIT_ELEMENT(#22,-2.);
#33=(FORCE_UNIT() NAMED_UNIT(*) DERIVED_UNIT((#30,#31,#32)));
/* DEFECT: DERIVED_UNIT for density (kg*m^-3) */
#40=DERIVED_UNIT_ELEMENT(#20,1.);
#41=DERIVED_UNIT_ELEMENT(#21,-3.);
#42=DERIVED_UNIT((#40,#41));
/* Force measure using the DERIVED_UNIT Newton */
#50=MEASURE_REPRESENTATION_ITEM('applied_force',LENGTH_MEASURE(9.81),#33);
/* Density measure using the DERIVED_UNIT density */
#51=MEASURE_REPRESENTATION_ITEM('material_density',LENGTH_MEASURE(7850.),#42);
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#60=GEOMETRIC_CURVE_SET('derived-unit-identity-fallthrough',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
