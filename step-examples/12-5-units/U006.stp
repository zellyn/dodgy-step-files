ISO-10303-21;
/* U006: PrePoMax double-applies inch->mm scaling on SolidWorks inch STEP */
/* File declares CONVERSION_BASED_UNIT('INCH',...) with 25.4 mm factor */
/* Coordinates are in mm (25.4 = 1 inch, 50.8 = 2 inches) */
/* PrePoMax sees INCH unit and multiplies by 25.4 again => 25.4x too large */
HEADER;
FILE_DESCRIPTION(('U006: SolidWorks inch STEP; PrePoMax double-applies 25.4x factor'),'2;1');
FILE_NAME('U006.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: 1x2x1 inch part; coordinates in mm (25.4 mm = 1 in, 50.8 mm = 2 in) */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(25.4,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,50.8,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,25.4));
#5=CARTESIAN_POINT('corner-xyz',(25.4,50.8,25.4));
#6=DIRECTION('xdir',(1.,0.,0.));
#7=DIRECTION('zdir',(0.,0.,1.));
/* DEFECT: CONVERSION_BASED_UNIT declares INCH; coordinates are already in mm */
/* PrePoMax applies the 25.4 inch->mm factor a second time => 25.4x too large */
/* SI mm basis for the inch conversion factor */
#8=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
/* 1 inch = 25.4 mm — this is the conversion factor */
#9=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#8);
/* DEFECT: CONVERSION_BASED_UNIT('INCH') triggers double-scaling in PrePoMax */
#10=(CONVERSION_BASED_UNIT('INCH',#9) LENGTH_UNIT() NAMED_UNIT(*));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.0254),#8,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#20=GEOMETRIC_CURVE_SET('solidworks-inch-mm-coords',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
