ISO-10303-21;
/* U005: Plant 3D STEP LENGTH_UNIT context disagrees with authored drawing units */
/* AutoCAD Plant 3D serializes LENGTH_UNIT as mm but model drawing units are inches */
/* Coordinates 1.0 and 2.5 are raw inch values; a mm context implies 25.4 and 63.5 */
/* Receivers see mismatched scale — a sub-mm part or an unscaled inch fragment */
HEADER;
FILE_DESCRIPTION(('U005: Plant 3D LENGTH_UNIT mm context with inch-scale coordinates'),'2;1');
FILE_NAME('U005.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: coordinates 1.0 and 2.5 are raw inch values sitting in an mm context */
/* If mm, these are sub-millimetre fragments; authored intent was 1 in and 2.5 in */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(1.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,2.5,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,1.0));
#5=CARTESIAN_POINT('corner-xyz',(1.0,2.5,1.0));
#6=DIRECTION('xdir',(1.,0.,0.));
#7=DIRECTION('zdir',(0.,0.,1.));
/* DEFECT: SI_UNIT(.MILLI.,.METRE.) declared but coordinates 1.0/2.5 are inch values */
/* Plant 3D serializer changed unit context without rescaling the coordinate values */
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#20=GEOMETRIC_CURVE_SET('plant3d-mm-context-inch-coords',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
