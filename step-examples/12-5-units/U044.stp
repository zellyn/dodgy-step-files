ISO-10303-21;
/* U044: MAPPED_ITEM with left-handed mapping_target AXIS2_PLACEMENT_3D */
/* DEFECT: gp_Trsf::SetDisplacement produces wrong transform for left-handed frame */
/* mapping_origin: right-handed (z = x cross y = +Z) */
/* mapping_target: left-handed (x=(1,0,0), y=(0,-1,0) => x cross y = (0,0,-1) != z=(0,0,1)) */
/* Correct receiver: detects handedness mismatch, emits W_LEFT_HANDED_PLACEMENT */
/* Buggy receiver: silently computes wrong transform, instance in wrong half-space */
HEADER;
FILE_DESCRIPTION(('U044: Left-handed AXIS2_PLACEMENT_3D in MAPPED_ITEM placement'),'2;1');
FILE_NAME('U044.stp','2026-06-21T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Standard mm context */
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Prototype geometry: a simple point set */
#1=CARTESIAN_POINT('proto_origin',(0.,0.,0.));
#2=CARTESIAN_POINT('proto_pt_a',(10.,0.,0.));
#3=CARTESIAN_POINT('proto_pt_b',(0.,10.,0.));
#4=CARTESIAN_POINT('proto_pt_c',(0.,0.,10.));
/* mapping_origin: right-handed placement (Z axis = x cross y = +Z) */
#20=CARTESIAN_POINT('map_origin_loc',(0.,0.,0.));
#21=DIRECTION('map_origin_z',(0.,0.,1.));
#22=DIRECTION('map_origin_x',(1.,0.,0.));
#23=AXIS2_PLACEMENT_3D('mapping_origin_rh',#20,#21,#22);
/* mapping_target: left-handed placement */
/* x=(1,0,0), y_ref=(0,-1,0) => x cross y_ref = (0,0,-1) which is -Z, not +Z */
/* This is the left-handed frame that causes gp_Trsf::SetDisplacement to err */
#30=CARTESIAN_POINT('map_target_loc',(50.,0.,0.));
#31=DIRECTION('map_target_z',(0.,0.,1.));
#32=DIRECTION('map_target_x_lh',(1.,0.,0.));
/* Note: ref_direction (0,-1,0) makes the frame left-handed: x cross y_ref = -Z */
/* The z-axis parameter still says +Z but the frame is geometrically left-handed */
#33=AXIS2_PLACEMENT_3D('mapping_target_lh',#30,#31,#32);
/* REPRESENTATION_MAP wraps the prototype with its mapping_origin */
#40=GEOMETRIC_CURVE_SET('proto_shape',(#1,#2,#3,#4));
#41=SHAPE_REPRESENTATION('proto_rep',(#23,#40),#14);
#42=REPRESENTATION_MAP(#23,#41);
/* MAPPED_ITEM: places the prototype using mapping_target */
/* The transform = mapping_target / mapping_origin; left-handed target causes error */
#50=MAPPED_ITEM('placed_instance',#42,#33);
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#60=GEOMETRIC_CURVE_SET('left-handed-placement-wrong-transform',(#50));
ENDSEC;
END-ISO-10303-21;
