ISO-10303-21;
/* U044 - gp_Trsf::SetDisplacement between two AXIS2_PLACEMENT_3D produces wrong transform
 * Defect: MAPPED_ITEM uses two AXIS2_PLACEMENT_3D records as mapping_origin/target;
 * one is left-handed (cross(x,y) does NOT equal z). gp_Trsf composition gives
 * a transform that flips orientation but leaves geometry in the wrong half-space. */
HEADER;
FILE_DESCRIPTION(('U044 - left-handed AXIS2_PLACEMENT_3D in MAPPED_ITEM source'),'2;1');
FILE_NAME('U044.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('Z',(0.0,0.0,1.0));
#12=DIRECTION('X',(1.0,0.0,0.0));
/* Right-handed: cross(X,Y) = Z. */
#13=AXIS2_PLACEMENT_3D('rh_origin',#10,#11,#12);
#20=CARTESIAN_POINT('',(10.0,0.0,0.0));
#21=DIRECTION('Z',(0.0,0.0,1.0));
/* X axis pointing in +Y direction yields a left-handed frame: cross(X=+Y, Y=...) ≠ Z. */
#22=DIRECTION('X_pointing_Y',(0.0,1.0,0.0));
#23=AXIS2_PLACEMENT_3D('lh_target',#20,#21,#22);
#30=SHAPE_REPRESENTATION('mapped_source',(#13),#40);
#40=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#13)) REPRESENTATION_CONTEXT('','3D'));
#50=REPRESENTATION_MAP(#13,#30);
#60=MAPPED_ITEM('lh_mapping',#50,#23);
ENDSEC;
END-ISO-10303-21;
