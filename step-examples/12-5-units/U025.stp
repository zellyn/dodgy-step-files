ISO-10303-21;
/* U025: Multiple LENGTH_UNIT() records cause reader API to report wrong primary unit */
/* Primary context uses mm; secondary context has an extra LENGTH_UNIT() for metres */
/* stepfileunits API returns the wrong (secondary) unit instead of mm */
HEADER;
FILE_DESCRIPTION(('U025: Multi-context file with wrong primary length unit from API'),'2;1');
FILE_NAME('U025.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: 50x50x25 mm part */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(50.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,50.0,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,25.0));
#5=CARTESIAN_POINT('corner-xyz',(50.0,50.0,25.0));
/* Primary context: mm (the unit actually applied to coordinates) */
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('3D Dimensions','3D'));
/* DEFECT: secondary context with extra LENGTH_UNIT() in metres */
/* Reader API may pick this up and report metre as the primary unit */
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.));
#21=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#22=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#23=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#20,
  'distance_accuracy_value','maximum model space distance between geometric entities');
/* Second GEOMETRIC_REPRESENTATION_CONTEXT with metre LENGTH_UNIT */
#24=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#23))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#21,#22)) REPRESENTATION_CONTEXT('CGR','3D'));
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#30=GEOMETRIC_CURVE_SET('multi-context-wrong-api-unit',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
