ISO-10303-21;
/* U001: Solid Edge mm STEP read as metres by Inventor (1000x too big) */
/* Solid Edge emits LENGTH_UNIT with SI_UNIT(.MILLI.,.METRE.) and mm coordinates */
/* Inventor legacy importer strips .MILLI. prefix and reads values as base metres */
/* Result: a 100x50 mm part loads at 100x50 m — 1000x too large */
HEADER;
FILE_DESCRIPTION(('U001: SI_UNIT(.MILLI.,.METRE.) prefix ignored on STEP import'),'2;1');
FILE_NAME('U001.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: a 100x50x25 mm box expressed in millimetre coordinates */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(100.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,50.0,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,25.0));
#5=CARTESIAN_POINT('corner-xyz',(100.0,50.0,25.0));
#6=DIRECTION('xdir',(1.,0.,0.));
#7=DIRECTION('zdir',(0.,0.,1.));
/* DEFECT: SI_UNIT with .MILLI. prefix — Inventor treats numeric values as metres */
/* not millimetres; a coordinate of 100.0 should be 0.1 m after unit application */
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
/* UNCERTAINTY_MEASURE_WITH_UNIT at 0.001 mm (typical Solid Edge signature) */
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#20=GEOMETRIC_CURVE_SET('solid-edge-mm-part',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
