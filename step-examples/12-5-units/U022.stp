ISO-10303-21;
/* U022: INCH name misspelled as 'inches', 'inch', 'IN' on CONVERSION_BASED_UNIT */
/* Canonical name is 'INCH' (uppercase); these variants break case-sensitive lookup */
/* Kernel must normalize case-insensitively or resolve via dimensional_exponents */
HEADER;
FILE_DESCRIPTION(('U022: INCH spelled as inch/IN/inches in CONVERSION_BASED_UNIT'),'2;1');
FILE_NAME('U022.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: simple part with 1-inch coordinates (values in mm = 25.4) */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(25.4,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,25.4,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,12.7));
#5=CARTESIAN_POINT('corner-xyz',(25.4,25.4,12.7));
/* SI mm basis */
#8=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
/* Three misspelled inch CONVERSION_BASED_UNIT instances */
#9=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#8);
/* DEFECT: 'inches' — wrong name, should be 'INCH' */
#10=(CONVERSION_BASED_UNIT('inches',#9) LENGTH_UNIT() NAMED_UNIT(*));
#30=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#8);
/* DEFECT: 'inch' — lowercase, should be 'INCH' */
#31=(CONVERSION_BASED_UNIT('inch',#30) LENGTH_UNIT() NAMED_UNIT(*));
#32=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#8);
/* DEFECT: 'IN' — abbreviated, should be 'INCH' */
#33=(CONVERSION_BASED_UNIT('IN',#32) LENGTH_UNIT() NAMED_UNIT(*));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.0254),#8,
  'distance_accuracy_value','maximum model space distance between geometric entities');
/* GRC uses 'inches' (the first misspelled unit) */
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#20=GEOMETRIC_CURVE_SET('inch-unit-name-misspelled',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
