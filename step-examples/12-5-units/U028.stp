ISO-10303-21;
/*
 * U028 — Mixed LENGTH_UNIT records vs. mixed contexts
 * Defect: part shape uses mm GRC; supplemental geometry CGR uses metre
 *         GRC; PMI references the metre CGR. Sub-representations of one
 *         product disagree on units.
 */
HEADER;
FILE_DESCRIPTION(('U028 multiple GRCs different units'),'2;1');
FILE_NAME('U028.stp','2026-04-26T00:00:00',('catalog'),('cad'),
  'manual','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#10 = APPLICATION_CONTEXT('automotive design');
#11 = APPLICATION_PROTOCOL_DEFINITION('international standard',
  'automotive_design',2001,#10);
#12 = PRODUCT_CONTEXT('',#10,'mechanical');
#13 = PRODUCT('U028','U028','',(#12));
#14 = PRODUCT_DEFINITION_FORMATION('','',#13);
#15 = PRODUCT_DEFINITION_CONTEXT('',#10,'design');
#16 = PRODUCT_DEFINITION('','',#14,#15);
#17 = PRODUCT_DEFINITION_SHAPE('','',#16);
/* GRC A: mm — used by the BREP shape */
#20 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#21 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#22 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#23 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,
  'distance_accuracy_value','');
#24 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#23))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#21,#22))
  REPRESENTATION_CONTEXT('mm_brep','3D') );
/* GRC B: metre — used by supplemental geometry / PMI */
#25 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.) );
#26 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#25,
  'distance_accuracy_value','');
#27 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#26))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#25,#21,#22))
  REPRESENTATION_CONTEXT('m_pmi','3D') );
/* Part BREP-side coordinates (mm) */
#40 = CARTESIAN_POINT('brep_origin',(0.0,0.0,0.0));
#41 = DIRECTION('',(0.0,0.0,1.0));
#42 = DIRECTION('',(1.0,0.0,0.0));
#43 = AXIS2_PLACEMENT_3D('',#40,#41,#42);
#44 = SHAPE_REPRESENTATION('part_brep',(#43),#24);
/* Supplemental geometry CGR (metre) */
#50 = CARTESIAN_POINT('cgr_origin',(0.0,0.0,0.0));
#51 = AXIS2_PLACEMENT_3D('',#50,#41,#42);
#52 = CONSTRUCTIVE_GEOMETRY_REPRESENTATION('cgr',(#51),#27);
/* Both share the same product, but the GRC trees are unrelated. */
#60 = SHAPE_DEFINITION_REPRESENTATION(#17,#44);
ENDSEC;
END-ISO-10303-21;
