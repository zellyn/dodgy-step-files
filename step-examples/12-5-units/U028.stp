ISO-10303-21;
/* U028: Two GEOMETRIC_REPRESENTATION_CONTEXT with different LENGTH_UNIT */
/* BRep uses mm context; CGR/PMI uses metre context */
/* PMI v4.1 §9.4.2: all sub-representations must share the same GRC */
/* OCCT defaults to mm and silently mis-scales the metre-based CGR coordinates */
HEADER;
FILE_DESCRIPTION(('U028: mm BRep vs metre PMI/CGR in separate GRC contexts'),'2;1');
FILE_NAME('U028.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* BRep geometry: 50x50x25 mm cube (values in mm) */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(50.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,50.0,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,25.0));
#5=CARTESIAN_POINT('corner-xyz',(50.0,50.0,25.0));
/* BRep context: mm (MILLI METRE) */
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
/* DEFECT: BRep GRC in mm */
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('mm_brep','3D'));
/* CGR/PMI geometry: same cube but expressed in METRES (values: 0.05, 0.025) */
#51=CARTESIAN_POINT('pmi-origin',(0.,0.,0.));
#52=CARTESIAN_POINT('pmi-corner-x',(0.05,0.,0.));
#53=CARTESIAN_POINT('pmi-corner-y',(0.,0.05,0.));
#54=CARTESIAN_POINT('pmi-corner-z',(0.,0.,0.025));
#55=CARTESIAN_POINT('pmi-corner-xyz',(0.05,0.05,0.025));
/* DEFECT: CGR/PMI context in metres (no prefix: SI_UNIT($,.METRE.)) */
#60=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.));
#61=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#62=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#63=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#60,
  'distance_accuracy_value','maximum model space distance between geometric entities');
/* DEFECT: Second GRC in metres — conflicts with BRep GRC in mm */
#64=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#63))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#60,#61,#62)) REPRESENTATION_CONTEXT('m_pmi','3D'));
/* BRep model entity uses mm GRC */
#70=GEOMETRIC_CURVE_SET('brep-mm-context',(#1,#2,#3,#4,#5));
/* CGR model entity uses metre GRC — same physical shape but mis-scaled when read */
#71=GEOMETRIC_CURVE_SET('cgr-metre-context',(#51,#52,#53,#54,#55));
ENDSEC;
END-ISO-10303-21;
