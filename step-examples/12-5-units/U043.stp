ISO-10303-21;
/* U043 - Slicer-side unit-context inversion: STEP says inch, slicer
 * reads as mm.
 * Defect: a producer correctly emits an inch-unit context with inch-
 * scale coordinates. A receiver that hard-codes "mm" assumes the
 * numbers are mm and produces a 25.4x too-small model. Mirror image
 * of Wr044. */
HEADER;
FILE_DESCRIPTION(('U043 - INCH unit context with inch-scale coordinates'),'2;1');
FILE_NAME('U043.stp','2026-05-02T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2001,#1);
#3=PRODUCT_CONTEXT('part',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('U043_inchcube','inch context, inch values','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
/* Inch unit context, declared via CONVERSION_BASED_UNIT. */
#10=( LENGTH_UNIT() NAMED_UNIT(*) CONVERSION_BASED_UNIT('INCH',#11) );
#11=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#12);
#12=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#13=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#14=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#15=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-6),#10,'tol','');
#16=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#15)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#13,#14)) REPRESENTATION_CONTEXT('','3D') );
/* Inch-scale corner coordinates -- a unit cube measured in inches. */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(1.0,0.0,0.0));
#22=CARTESIAN_POINT('',(1.0,1.0,0.0));
#23=CARTESIAN_POINT('',(0.0,1.0,0.0));
#24=CARTESIAN_POINT('',(0.0,0.0,1.0));
#25=CARTESIAN_POINT('',(1.0,0.0,1.0));
#26=CARTESIAN_POINT('',(1.0,1.0,1.0));
#27=CARTESIAN_POINT('',(0.0,1.0,1.0));
#30=DIRECTION('',(0.0,0.0,1.0));
#31=DIRECTION('',(1.0,0.0,0.0));
#32=AXIS2_PLACEMENT_3D('',#20,#30,#31);
#33=SHAPE_REPRESENTATION('U043_inchcube',(#32),#16);
#34=SHAPE_DEFINITION_REPRESENTATION(#8,#33);
ENDSEC;
END-ISO-10303-21;
