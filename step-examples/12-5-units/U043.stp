ISO-10303-21;
/* U043: Well-formed STEP with INCH unit; 1x1x1 inch cube */
/* DEFECT (receiver side): slicer ignores CONVERSION_BASED_UNIT('INCH') declaration */
/* Correct receiver: loads 25.4 mm cube */
/* Buggy receiver (hard-codes mm): loads 1.0 mm cube (25.4x too small) */
HEADER;
FILE_DESCRIPTION(('U043: INCH unit declared; receiver must honour, not hard-code mm'),'2;1');
FILE_NAME('U043.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* SI mm base — required as the conversion reference for INCH */
#8=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
/* INCH conversion: exactly 25.4 mm per inch */
#9=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#8);
/* File declares INCH as active length unit */
#10=(CONVERSION_BASED_UNIT('INCH',#9) LENGTH_UNIT() NAMED_UNIT(*));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(3.937E-5),#10,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Geometry: 1x1x1 inch cube (corner coords at 1.0 — one inch per side) */
/* Correct receiver: normalises to 25.4 mm per side */
/* Buggy receiver (hard-codes mm): reads as 1.0 mm per side (25.4x too small) */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(1.0,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,1.0,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,1.0));
#5=CARTESIAN_POINT('corner-xyz',(1.0,1.0,1.0));
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#30=GEOMETRIC_CURVE_SET('inch-unit-receiver-ignores-declaration',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
