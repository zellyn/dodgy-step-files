ISO-10303-21;
/* U016: Duplicate CONVERSION_BASED_UNIT('INCH') instances in dimension export */
/* OCCT XCAF inch dimension export creates two separate INCH unit entities */
/* Both carry conversion factor 25.4 but have different #NNN ids */
/* Dimension measures use one or the other inconsistently -- invalid cross-refs */
HEADER;
FILE_DESCRIPTION(('U016: Duplicate INCH CONVERSION_BASED_UNIT in dimension export'),'2;1');
FILE_NAME('U016.stp','2026-06-20T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
/* Geometry: a simple 2-inch square part (coordinates in mm: 50.8 mm = 2 inches) */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=CARTESIAN_POINT('corner-x',(50.8,0.,0.));
#3=CARTESIAN_POINT('corner-y',(0.,50.8,0.));
#4=CARTESIAN_POINT('corner-z',(0.,0.,25.4));
#5=CARTESIAN_POINT('corner-xyz',(50.8,50.8,25.4));
#6=DIRECTION('xdir',(1.,0.,0.));
#7=DIRECTION('zdir',(0.,0.,1.));
/* SI mm basis for inch conversion */
#8=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
/* DEFECT: two separate LENGTH_MEASURE_WITH_UNIT records for the same 25.4 factor */
#9=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#8);
#30=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#8);
/* DEFECT: two separate CONVERSION_BASED_UNIT('INCH') instances with different ids */
#10=(CONVERSION_BASED_UNIT('INCH',#9) LENGTH_UNIT() NAMED_UNIT(*));
#31=(CONVERSION_BASED_UNIT('INCH',#30) LENGTH_UNIT() NAMED_UNIT(*));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.0254),#8,
  'distance_accuracy_value','maximum model space distance between geometric entities');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('ctx','3D'));
/* Dimension measures: each references a different INCH unit instance */
/* This is the signature of the OCCT dimension export bug */
#40=MEASURE_REPRESENTATION_ITEM('width',LENGTH_MEASURE(2.0),#10);
#41=MEASURE_REPRESENTATION_ITEM('height',LENGTH_MEASURE(1.0),#31);
/* Model entity is GEOMETRIC_CURVE_SET — OCC returns empty shape */
#20=GEOMETRIC_CURVE_SET('xcaf-dup-inch-unit',(#1,#2,#3,#4,#5));
ENDSEC;
END-ISO-10303-21;
