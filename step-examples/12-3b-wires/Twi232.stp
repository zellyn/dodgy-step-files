ISO-10303-21;
/* Twi232: GEOMETRIC_CURVE_SET containing EDGE_LOOP with two B-spline edges; cross_e0: degree-3 B-spline from (-6,0,0) to (6,0,0) arching upward IS first edge; cross_e1: degree-3 B-spline from (0,-6,0) to (0,6,0) arching rightward IS second edge; two edges cross at approximately (-2,2,0) AND (2,-2,0) IS two intersection points; FixSelfIntersection single-intersection-per-pair logic finds first crossing only; second intersection at (2,-2,0) remains undetected IS the defect mechanism; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty; all EDGE_CURVEs ARE wired into EDGE_LOOP; never orphaned */
HEADER;
FILE_DESCRIPTION(('Twi232'),'2;1');
