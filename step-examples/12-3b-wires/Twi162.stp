ISO-10303-21;
/* Twi162 - ShapeFix_Wire.FixIntersectingEdges 3-edge-mutual-intersection
 * Wire with 3 edges that mutually intersect at a single point (like a star).
 * FixIntersectingEdges splits pairwise and produces inconsistent topology.
 * All three edges pass through (5,5,0) but are not collinear.
 */
HEADER;
FILE_DESCRIPTION(('Twi162 test case','3 edges mutually intersecting at point'),'2;1');
FILE_NAME('Twi162.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Vertices at star endpoints */
#10=CARTESIAN_POINT('v0',(0.0,5.0,0.0));
#11=VERTEX_POINT('',#10);
#12=CARTESIAN_POINT('v1',(10.0,5.0,0.0));
#13=VERTEX_POINT('',#12);
#14=CARTESIAN_POINT('v2',(5.0,0.0,0.0));
#15=VERTEX_POINT('',#14);
#16=CARTESIAN_POINT('v3',(5.0,10.0,0.0));
#17=VERTEX_POINT('',#16);
/* Central intersection point (shared by all edges parametrically) */
#20=CARTESIAN_POINT('center',(5.0,5.0,0.0));
/* Edge 0: horizontal through center, from v0 to v1 */
#30=DIRECTION('',(1.0,0.0,0.0));
#31=VECTOR('',#30,1.0);
#32=LINE('',#10,#31);
#33=EDGE_CURVE('edge0',#11,#13,#32,.T.);
/* Edge 1: vertical through center, from v2 to v3 */
#40=DIRECTION('',(0.0,1.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#14,#41);
#43=EDGE_CURVE('edge1',#15,#17,#42,.T.);
/* Edge 2: diagonal through center, from upper-left to lower-right */
#50=DIRECTION('',(0.7071067811865475,-0.7071067811865475,0.0));
#51=VECTOR('',#50,1.0);
#52=LINE('',#16,#51);
#53=EDGE_CURVE('edge2',#17,#11,#52,.T.);
/* Wire: close the cycle with all 3 edges */
#60=ORIENTED_EDGE('oe0',*,*,#33,.T.);
#61=ORIENTED_EDGE('oe1',*,*,#43,.T.);
#62=ORIENTED_EDGE('oe2',*,*,#53,.T.);
#70=EDGE_LOOP('star_loop',(#60,#61,#62));
/* Plane for face representation */
#80=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#81=DIRECTION('',(0.0,0.0,1.0));
#82=DIRECTION('',(1.0,0.0,0.0));
#83=AXIS2_PLACEMENT_3D('',#80,#81,#82);
#84=PLANE('',#83);
/* Face with the wire */
#90=FACE_OUTER_BOUND('',#70,.T.);
#91=ADVANCED_FACE('star_face',(#90),#84,.T.);
#100=OPEN_SHELL('',(#91));
/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi162','Twi162','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#100));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
