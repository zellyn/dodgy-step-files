ISO-10303-21;
/* Twi141 - ShapeFix_Wire.FixSelfIntersectingEdge close-loop iteration
 * Defect: ShapeFix_Wire.FixSelfIntersectingEdge close-loop iteration
 */
HEADER;
FILE_DESCRIPTION(('Twi141 test case','ShapeFix_Wire.FixSelfIntersectingEdge close-loop iteration'),'2;1');
FILE_NAME('Twi141.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);

#20=PLANE('',#13);
/* Wire forming near-closed loop with tiny self-intersecting tail */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=VERTEX_POINT('',#100);
#102=CARTESIAN_POINT('',(10.0,0.0,0.0));
#103=VERTEX_POINT('',#102);
#104=CARTESIAN_POINT('',(10.0,10.0,0.0));
#105=VERTEX_POINT('',#104);
#106=CARTESIAN_POINT('',(0.0,10.0,0.0));
#107=VERTEX_POINT('',#106);

/* Edge 0: (0,0) -> (10,0) */
#110=LINE('',#100,#12);
#111=EDGE_CURVE('',#101,#103,#110,.T.);

/* Edge 1: (10,0) -> (10,10) */
#115=DIRECTION('',(0.0,1.0,0.0));
#116=LINE('',#102,#115);
#117=EDGE_CURVE('',#103,#105,#116,.T.);

/* Edge 2: (10,10) -> (0,10) */
#120=DIRECTION('',(0.0,-1.0,0.0));
#121=LINE('',#104,#120);
#122=EDGE_CURVE('',#105,#107,#121,.T.);

/* Edge 3: (0,10) -> (0,0) - but with a tiny loop-back self-intersection tail near the endpoint */
#130=DIRECTION('',(0.0,-1.0,0.0));
#131=LINE('',#106,#130);
#132=EDGE_CURVE('',#107,#101,#131,.T.);

/* Edge 4: tiny self-intersecting edge causing near-closure problem */
#140=CARTESIAN_POINT('',(0.05,0.0,0.0));
#141=VERTEX_POINT('',#140);
#142=DIRECTION('',(1.0,0.5,0.0));
#143=LINE('',#100,#142);
#144=EDGE_CURVE('',#101,#141,#143,.T.);

#150=ORIENTED_EDGE('',*,*,#111,.T.);
#151=ORIENTED_EDGE('',*,*,#117,.T.);
#152=ORIENTED_EDGE('',*,*,#122,.T.);
#153=ORIENTED_EDGE('',*,*,#132,.T.);
#154=ORIENTED_EDGE('',*,*,#144,.T.);
#155=EDGE_LOOP('',(#150,#151,#152,#153,#154));
#156=FACE_OUTER_BOUND('',#155,.T.);
#157=ADVANCED_FACE('',(#156),#20,.T.);
#8000=OPEN_SHELL('',(#157));

/* PRODUCT CHAIN - Mandatory */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi141','Twi141','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#8000));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
