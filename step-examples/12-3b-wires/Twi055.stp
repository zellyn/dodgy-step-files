ISO-10303-21;
/* Twi055 - Wire-segment edge claims patch index outside surface grid
 * Defect: a wire on a composite surface has an edge whose declared
 * patch-index range is inconsistent (IUMin > IUMax or IUMax > IUMin+1)
 * relative to the surface's patch grid. The kernel must clip or reject. */
HEADER;
FILE_DESCRIPTION(('Twi055 test case','Wire-segment edge claims patch index outside surface grid'),'2;1');
FILE_NAME('Twi055.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Composite surface of two planar patches; outer wire spans both. */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
#15=CARTESIAN_POINT('',(1.0,0.0,0.0));
#16=AXIS2_PLACEMENT_3D('',#15,#11,#12);
#17=PLANE('',#16);
/* Two patches abut at U=1; outer wire is a 2x1 rectangle. */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(2.0,0.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(2.0,1.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(0.0,1.0,0.0));
#37=VERTEX_POINT('',#36);
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#30,#41);
#43=DIRECTION('',(0.0,1.0,0.0));
#44=VECTOR('',#43,1.0);
#45=LINE('',#32,#44);
#46=DIRECTION('',(-1.0,0.0,0.0));
#47=VECTOR('',#46,1.0);
#48=LINE('',#34,#47);
#49=DIRECTION('',(0.0,-1.0,0.0));
#50=VECTOR('',#49,1.0);
#51=LINE('',#36,#50);
#60=EDGE_CURVE('',#31,#33,#42,.T.);
#61=EDGE_CURVE('',#33,#35,#45,.T.);
#62=EDGE_CURVE('',#35,#37,#48,.T.);
#63=EDGE_CURVE('',#37,#31,#51,.T.);
#70=ORIENTED_EDGE('',*,*,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#61,.T.);
#72=ORIENTED_EDGE('',*,*,#62,.T.);
#73=ORIENTED_EDGE('',*,*,#63,.T.);
#80=EDGE_LOOP('',(#70,#71,#72,#73));
#81=FACE_OUTER_BOUND('',#80,.T.);
#82=ADVANCED_FACE('',(#81),#14,.T.);
#83=ADVANCED_FACE('',(#81),#17,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi055','Twi055','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#82,#83));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
