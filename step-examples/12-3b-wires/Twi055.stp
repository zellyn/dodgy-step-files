ISO-10303-21;
/* Twi055: Two ADVANCED_FACEs on two distinct PLANEs (Z=0 and Z=5); both faces reference the SAME FACE_OUTER_BOUND entity (same #ID); the shared FACE_OUTER_BOUND wraps an EDGE_LOOP whose vertices sit in Z=0; face1 uses the shared wire on PLANE at Z=5, making vertex coordinates inconsistent with the host surface — aliased wire IS the mechanism; a second independent FACE_OUTER_BOUND is added to each to satisfy tier-3 edge/vertex counts (each face has its own loop2); all entities ARE wired into ADVANCED_FACEs in a CLOSED_SHELL — never orphaned; kernel cannot localize the aliased wire to a unique host for pcurve evaluation */
HEADER;
FILE_DESCRIPTION(('Twi055'),'2;1');
