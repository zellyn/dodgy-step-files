ISO-10303-21;
/* Twi193 - CheckOrder index-mode-clash
 * Defect: ShapeAnalysis_Wire.CheckOrder picks 3D or 2D mode but fails to
 * detect when edge[0]'s natural parametric order (forward on edge) differs
 * from edge[0]'s pcurve order on a periodic surface seam. Wire wraps around
 * cylinder seam; edge[0] goes forward in 3D but backward in 2D parameter
 * space due to seam topology. CheckOrder with mode=3D gets the order wrong. */
HEADER;
FILE_DESCRIPTION(('Twi193 test case','CheckOrder index-mode-clash on seam'),'2;1');
FILE_NAME('Twi193.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Cylindrical surface: axis along Z, radius 5.0 */
#20=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#21=ELEMENTARY_SURFACE('cyl',#20);
#22=CYLINDRICAL_SURFACE('',#20,5.0);
/* Edge 1: near seam, starts before seam (param 6.2), ends after seam (param 0.1)
   in 2D angular parameter. In 3D, naturally forward. On periodic seam, 2D order reversed. */
#31=CARTESIAN_POINT('',(4.95,0.6,0.0));
#32=VERTEX_POINT('',#31);
#33=CARTESIAN_POINT('',(4.96,0.0,0.0));
#34=VERTEX_POINT('',#33);
#35=CARTESIAN_POINT('',(4.97,-0.6,0.0));
#36=VERTEX_POINT('',#35);
/* Arc approximation via line for simplicity */
#37=DIRECTION('',(0.1,0.0,0.0));
#38=VECTOR('',#37,1.0);
#39=LINE('',#31,#38);
#40=EDGE_CURVE('E1',#32,#34,#39,.T.);
#41=ORIENTED_EDGE('',*,*,#40,.T.);
/* Edge 2: continues from seam crossing, 3D naturally forward */
#42=DIRECTION('',(0.1,0.0,0.0));
#43=VECTOR('',#42,1.0);
#44=LINE('',#33,#43);
#45=EDGE_CURVE('E2',#34,#36,#44,.T.);
#46=ORIENTED_EDGE('',*,*,#45,.T.);
/* Wire on cylinder that wraps seam */
#50=EDGE_LOOP('',(#41,#46));
#51=FACE_OUTER_BOUND('',#50,.T.);
#52=ADVANCED_FACE('',(#51),#22,.T.);
/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi193','Twi193','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9020=CLOSED_SHELL('shell',(#52));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
