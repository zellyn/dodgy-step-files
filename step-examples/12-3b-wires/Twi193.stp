ISO-10303-21;
/* Twi193: Single ADVANCED_FACE on CYLINDRICAL_SURFACE (radius 1, height 4) in CLOSED_SHELL; outer EDGE_LOOP has 4 edges; E0 is the seam lateral at u=2pi: traverses z=4→0 (forward in 3D) but pcurve has u=2pi (seam copy) v going 4→0 (backward relative to canonical u=0 sense) IS the defect; CheckOrder uses theMode3D=true, sees E0 is 'forward' in 3D but misses the reversed pcurve order on the periodic seam — index-mode-clash IS the mechanism; EDGE_LOOP IS wired into FACE_OUTER_BOUND -> ADVANCED_FACE in CLOSED_SHELL — never orphaned */
HEADER;
FILE_DESCRIPTION(('Twi193'),'2;1');
FILE_NAME('Twi193.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
