ISO-10303-21;
/* Twi163 - ShapeAnalysis_Wire.CheckIntersectingEdges trimmed-edges-overlap-base-curve
 * Two edges sharing same base curve with overlapping trim ranges.
 * Both edges are B-spline sub-curves of the same underlying curve.
 */
HEADER;
FILE_DESCRIPTION(('Twi163 test case','Two edges with overlapping trim ranges on same base curve'),'2;1');
FILE_NAME('Twi163.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Base B-spline curve: degree 3, 5 control points */
#10=CARTESIAN_POINT('cp0',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('cp1',(5.0,2.0,0.0));
#12=CARTESIAN_POINT('cp2',(10.0,5.0,0.0));
#13=CARTESIAN_POINT('cp3',(15.0,2.0,0.0));
#14=CARTESIAN_POINT('cp4',(20.0,0.0,0.0));
#15=CARTESIAN_POINT('cp5',(25.0,-2.0,0.0));
#20=(B_SPLINE_CURVE_WITH_KNOTS()B_SPLINE_CURVE(5,(#10,#11,#12,#13,#14,#15),.UNSPECIFIED.,.F.,.F.)CURVE()GEOMETRIC_REPRESENTATION_ITEM()REPRESENTATION_ITEM('base_bspl'));
#21=CARTESIAN_POINT('start1',(0.0,0.0,0.0));
#22=VERTEX_POINT('',#21);
#23=CARTESIAN_POINT('end1',(12.5,3.5,0.0));
#24=VERTEX_POINT('',#23);
/* First edge: trim of base curve from parameter 0.0 to 0.6 */
#30=EDGE_CURVE('edge1_trim0to6',#22,#24,#20,.T.);
#31=CARTESIAN_POINT('start2',(7.5,1.5,0.0));
#32=VERTEX_POINT('',#31);
#33=CARTESIAN_POINT('end2',(20.0,0.0,0.0));
#34=VERTEX_POINT('',#33);
/* Second edge: trim of SAME base curve from parameter 0.4 to 0.9 (overlaps first) */
#40=EDGE_CURVE('edge2_trim4to9',#32,#34,#20,.T.);
/* Wire with both overlapping-trim edges */
#50=ORIENTED_EDGE('oe1',*,*,#30,.T.);
#51=ORIENTED_EDGE('oe2',*,*,#40,.T.);
#52=EDGE_LOOP('overlap_loop',(#50,#51));
/* Plane for face */
#60=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#61=DIRECTION('',(0.0,0.0,1.0));
#62=DIRECTION('',(1.0,0.0,0.0));
#63=AXIS2_PLACEMENT_3D('',#60,#61,#62);
#64=PLANE('',#63);
#70=FACE_OUTER_BOUND('',#52,.T.);
#71=ADVANCED_FACE('overlap_face',(#70),#64,.T.);
#80=OPEN_SHELL('',(#71));
/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi163','Twi163','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#80));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
