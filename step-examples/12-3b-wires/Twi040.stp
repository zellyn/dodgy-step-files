#9=VERTEX_POINT('',#8);
#10=CARTESIAN_POINT('',(10.0000001,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=VECTOR('',#11,5.0);
#13=LINE('',#10,#12);
#14=EDGE_CURVE('',#7,#9,#13,.T.);
#15=ORIENTED_EDGE('',$,$,#14,.T.);
#16=EDGE_LOOP('',(#15));
#17=FACE_OUTER_BOUND('',#16,.T.);
#18=ADVANCED_FACE('',(#17),#5,.T.);
#19=CLOSED_SHELL('',(#18));
#20=SHELL_BASED_SURFACE_MODEL('',(#19));
