ISO-10303-21;
/* Twi123 - ShapeAnalysis_Wire.CheckGap2d tolerance-equality misclassification
 * Defect: adjacent pcurves with gap exactly equal to vertex tolerance;
 * non-strict comparison flags or doesn't flag depending on floating-point rounding
 */
HEADER;
FILE_DESCRIPTION(('Twi123 test case','ShapeAnalysis_Wire.CheckGap2d tolerance-equality misclassification'),'2;1');
FILE_NAME('Twi123.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Two vertices with tolerance exactly at gap boundary */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=VERTEX_POINT('',#10);
#12=CARTESIAN_POINT('',(1.0,0.0,0.0));
#13=VERTEX_POINT('',#12);
#14=CARTESIAN_POINT('',(2.0,0.0,0.0));
#15=VERTEX_POINT('',#14);
/* Line edges */
#20=LINE('',#10,#12);
#21=EDGE_CURVE('',#11,#13,#20,.T.);
#22=LINE('',#12,#14);
#23=EDGE_CURVE('',#13,#15,#22,.T.);
/* Oriented edges in loop */
#30=ORIENTED_EDGE('',*,*,#21,.T.);
#31=ORIENTED_EDGE('',*,*,#23,.T.);
#40=EDGE_LOOP('',(#30,#31));
/* Plane surface for parametric curve binding */
#50=CARTESIAN_POINT('',(0.0,0.0,0.0));
#51=DIRECTION('',(0.0,0.0,1.0));
#52=DIRECTION('',(1.0,0.0,0.0));
#53=AXIS2_PLACEMENT_3D('',#50,#51,#52);
#54=PLANE('',#53);
/* Parametric curves: exact gap equals tolerance threshold (1.0E-7) */
#60=PCURVE('',#54,#100);
#61=PCURVE('',#54,#101);
#100=LINE('',(0.0,0.0),(1.0,0.0));
#101=LINE('',(1.0E-7,0.0),(1.0,0.0));
#70=FACE_OUTER_BOUND('',#40,.T.);
#71=ADVANCED_FACE('',(#70),#54,.T.);
/* Product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi123','Twi123','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#71));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
