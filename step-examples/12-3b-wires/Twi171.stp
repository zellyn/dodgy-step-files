ISO-10303-21;
/* Twi171 - ShapeFix_Wire.FixReorder reverse-then-forward
 * Defect: Wire with mixed orientations whose reordering requires both
 * forward and reverse traversal. FixReorder's single-direction sweep misses mixed case. */
HEADER;
FILE_DESCRIPTION(('Twi171 test case','FixReorder reverse-then-forward'),'2;1');
FILE_NAME('Twi171.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Five vertices forming a path that requires mixed-direction reordering. */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(1.0,0.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(2.0,0.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(2.0,1.0,0.0));
#37=VERTEX_POINT('',#36);
#38=CARTESIAN_POINT('',(1.0,1.0,0.0));
#39=VERTEX_POINT('',#38);
/* Line segments. */
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#30,#41);
#43=DIRECTION('',(1.0,0.0,0.0));
#44=VECTOR('',#43,1.0);
#45=LINE('',#32,#43);
#46=DIRECTION('',(0.0,1.0,0.0));
#47=VECTOR('',#46,1.0);
#48=LINE('',#34,#46);
#49=DIRECTION('',(-1.0,0.0,0.0));
#50=VECTOR('',#49,1.0);
#51=LINE('',#36,#49);
#52=DIRECTION('',(0.0,-1.0,0.0));
#53=VECTOR('',#52,1.0);
#54=LINE('',#39,#52);
/* Five edges with mixed orientations. */
#60=EDGE_CURVE('',#31,#33,#42,.T.);
#61=EDGE_CURVE('',#33,#35,#45,.T.);
#62=EDGE_CURVE('',#35,#37,#48,.T.);
#63=EDGE_CURVE('',#37,#39,#51,.T.);
#64=EDGE_CURVE('',#39,#31,#54,.T.);
/* Mixed orientation edges: forward, forward, forward, forward, reverse. */
#70=ORIENTED_EDGE('',*,*,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#61,.T.);
#72=ORIENTED_EDGE('',*,*,#62,.T.);
#73=ORIENTED_EDGE('',*,*,#63,.T.);
#74=ORIENTED_EDGE('',*,*,#64,.F.);
/* Defect: Wire edges with mixed forward/reverse orientations requiring
 * complex reordering that a single-direction sweep cannot resolve. */
#80=EDGE_LOOP('',(#70,#71,#72,#73,#74));
#81=FACE_OUTER_BOUND('',#80,.T.);
#82=ADVANCED_FACE('',(#81),#20,.T.);
/* Mandatory PRODUCT chain. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi171','Twi171','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#82));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
