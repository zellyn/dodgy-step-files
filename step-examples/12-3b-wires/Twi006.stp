#7=DIRECTION('',(0.0,0.0,1.0));
#8=DIRECTION('',(1.0,0.0,0.0));
#9=AXIS2_PLACEMENT_3D('',#6,#7,#8);
#10=CIRCLE('',#9,1.0);
#11=CARTESIAN_POINT('',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('',(-1.0,0.0,0.0));
#13=VERTEX_POINT('',#11);
#14=VERTEX_POINT('',#12);
#15=EDGE_CURVE('',#13,#14,#10,.T.);
#16=ORIENTED_EDGE('',*,*,$,.T.);
#17=ORIENTED_EDGE('',*,*,#15,.T.);
#18=EDGE_LOOP('',(#16,#17));
#19=FACE_OUTER_BOUND('',#18,.T.);
#20=ADVANCED_FACE('',(#19),#5,.T.);
#21=OPEN_SHELL('',(#20));
#22=SHELL_BASED_SURFACE_MODEL('',(#21));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Twi006','Twi006','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
