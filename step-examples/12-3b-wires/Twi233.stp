ISO-10303-21;
/* Twi233 - ShapeAnalysis_Wire.CheckOuterBound winding-number-zero
 * Defect: Wire forms a figure-8 pattern (two loops meeting at a pinch point).
 * The 3D winding number around a test point is zero; CheckOuterBound's
 * enclosing test returns inconclusive, failing to classify the wire correctly.
 * (ShapeAnalysis_Wire::CheckOuterBound, winding-number algorithm)
 */
HEADER;
FILE_DESCRIPTION(('Twi233 test case','ShapeAnalysis_Wire.CheckOuterBound winding-number-zero'),'2;1');
FILE_NAME('Twi233.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
