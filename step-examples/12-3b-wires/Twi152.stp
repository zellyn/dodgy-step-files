ISO-10303-21;
/* Twi152 - ShapeFix_Wire.FixIntersectingEdges line-segment-vs-circle-arc
 * Defect: Wire contains a LINE edge that intersects a CIRCLE arc edge.
 * FixIntersectingEdges' split logic assumes parameter linearity and produces
 * wrong split point when intersecting with circular arc. Linear parameter
 * interpolation fails for arc parametrization, causing incorrect edge split.
 * (ShapeFix_Wire.cxx:3020-3038; param extraction assumes Geom2dInt_GInter
 * on line segment vs circle arc; linear split assumes 1D arc param space) */
HEADER;
FILE_DESCRIPTION(('Twi152 test case','Line-segment-vs-circle-arc intersection split'),'2;1');
FILE_NAME('Twi152.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Vertices: circle arc from (1,0,0) to (0,1,0), intersected by line from (0.5,-0.5,0) */
#30=CARTESIAN_POINT('',(1.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(0.0,1.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(0.5,-0.5,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(0.5,0.5,0.0));
#37=VERTEX_POINT('',#36);
/* 3D Curves: circle (radius 1, center at origin) and line */
#40=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#41=CIRCLE('',#40,1.0);
#42=DIRECTION('',(1.0,0.0,0.0));
#43=VECTOR('',#42,1.0);
#44=LINE('',#34,#43);
/* Edges: arc goes quarter circle (0 to pi/2), line intersects at param ~0.5 on arc */
#50=EDGE_CURVE('',#31,#33,#41,.T.);
#51=EDGE_CURVE('',#35,#37,#44,.T.);
#60=ORIENTED_EDGE('',*,*,#50,.T.);
#61=ORIENTED_EDGE('',*,*,#51,.T.);
#62=EDGE_LOOP('',(#60,#61));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#20,.T.);
/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi152','Twi152','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9020=CLOSED_SHELL('shell',(#64));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
