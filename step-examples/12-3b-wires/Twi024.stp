ISO-10303-21;
/* Twi024 - Wires forming inner loops outside outer loop (mis-classified hole)
 * Defect: An inner ("hole") wire is oriented as if it were the outer wire
 * (wrong winding) or actually lies geometrically outside the outer wire. Here
 * the inner wire's edges are listed in the same CCW winding as the outer wire,
 * not CW as expected for a hole. Heal by ShapeFix_Face::FixOrientation -
 * propagate orientation from face normal and 2D area sign; reject if loop is
 * geometrically inconsistent. */
HEADER;
FILE_DESCRIPTION(('Twi024 test case','Inner wire mis-oriented (FixOrientation)'),'2;1');
FILE_NAME('Twi024.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Outer wire: 10x10 square CCW */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(10.0,0.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(10.0,10.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(0.0,10.0,0.0));
#37=VERTEX_POINT('',#36);
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#30,#41);
#43=DIRECTION('',(0.0,1.0,0.0));
#44=VECTOR('',#43,1.0);
#45=LINE('',#32,#44);
#46=DIRECTION('',(-1.0,0.0,0.0));
#47=VECTOR('',#46,1.0);
#48=LINE('',#34,#47);
#49=DIRECTION('',(0.0,-1.0,0.0));
#50=VECTOR('',#49,1.0);
#51=LINE('',#36,#50);
#60=EDGE_CURVE('',#31,#33,#42,.T.);
#61=EDGE_CURVE('',#33,#35,#45,.T.);
#62=EDGE_CURVE('',#35,#37,#48,.T.);
#63=EDGE_CURVE('',#37,#31,#51,.T.);
#70=ORIENTED_EDGE('',*,*,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#61,.T.);
#72=ORIENTED_EDGE('',*,*,#62,.T.);
#73=ORIENTED_EDGE('',*,*,#63,.T.);
#80=EDGE_LOOP('',(#70,#71,#72,#73));
#81=FACE_OUTER_BOUND('',#80,.T.);
/* Inner hole: 2x2 square inside, but listed in the SAME CCW winding as the
 * outer wire (defect: a hole should be CW under the same face normal). */
#90=CARTESIAN_POINT('',(3.0,3.0,0.0));
#91=VERTEX_POINT('',#90);
#92=CARTESIAN_POINT('',(7.0,3.0,0.0));
#93=VERTEX_POINT('',#92);
#94=CARTESIAN_POINT('',(7.0,7.0,0.0));
#95=VERTEX_POINT('',#94);
#96=CARTESIAN_POINT('',(3.0,7.0,0.0));
#97=VERTEX_POINT('',#96);
#100=LINE('',#90,#41);
#101=LINE('',#92,#44);
#102=LINE('',#94,#47);
#103=LINE('',#96,#50);
#110=EDGE_CURVE('',#91,#93,#100,.T.);
#111=EDGE_CURVE('',#93,#95,#101,.T.);
#112=EDGE_CURVE('',#95,#97,#102,.T.);
#113=EDGE_CURVE('',#97,#91,#103,.T.);
#120=ORIENTED_EDGE('',*,*,#110,.T.);
#121=ORIENTED_EDGE('',*,*,#111,.T.);
#122=ORIENTED_EDGE('',*,*,#112,.T.);
#123=ORIENTED_EDGE('',*,*,#113,.T.);
/* Defect: inner wire goes CCW (#91 -> #93 -> #95 -> #97 -> #91) - same
 * winding as outer; expected CW for a true hole. */
#130=EDGE_LOOP('',(#120,#121,#122,#123));
#131=FACE_BOUND('',#130,.T.);
#140=ADVANCED_FACE('',(#81,#131),#20,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi024','Twi024','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#140));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
