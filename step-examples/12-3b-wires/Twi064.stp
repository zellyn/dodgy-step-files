ISO-10303-21;
/* Twi064: ADVANCED_FACE on a PLANE with TWO wires: outer FACE_OUTER_BOUND is a correct 10x10 square (4 edges, 4 vertices); inner FACE_BOUND is a degenerate triangle with near-coincident VERTEX_POINTs: v0=(5,5,0), v1=(5+1e-7,5,0), v2=(5,5+1e-7,0) — sub-tolerance side lengths 1e-7; ORIENTED_EDGEs in the inner EDGE_LOOP are listed out of head-to-tail order (CheckOrder fails) — edge for v2→v0 appears before edge for v1→v2; sub-tolerance edge lengths (CheckSmall fails); multiple distinct sub-checks fail on the inner wire simultaneously; a pipeline that short-circuits after first failure misses remaining checks; all entities ARE wired into ADVANCED_FACE in CLOSED_SHELL — never orphaned */
HEADER;
FILE_DESCRIPTION(('Twi064'),'2;1');
FILE_NAME('Twi064.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
