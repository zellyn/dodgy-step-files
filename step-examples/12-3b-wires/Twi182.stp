ISO-10303-21;
/* Twi182 - ShapeFix_Wire.FixTails very-small-tail
 * Defect: Wire with last edge length = 1e-15; FixTails removes it but the resulting
 * wire endpoint is the previous edge's start, which may not be the intended wire close.
 * The tail removal breaks closure semantics when the tiny edge was intended to close
 * the wire loop. */
HEADER;
FILE_DESCRIPTION(('Twi182 test case','Very small tail edge removal breaks wire closure'),'2;1');
FILE_NAME('Twi182.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Three vertices: V1 (origin), V2 (1,0,0), V3 (1,1,0) */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(1.0,0.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(1.0,1.0,0.0));
#35=VERTEX_POINT('',#34);
/* Normal edges: V1->V2, V2->V3 */
#40=LINE('',#30,#(1.0,0.0,0.0));
#41=EDGE_CURVE('',#31,#33,#40,.T.);
#42=LINE('',#32,#(0.0,1.0,0.0));
#43=EDGE_CURVE('',#33,#35,#42,.T.);
/* Defect: Very small tail edge V3->V1 with length ~1e-15; too small to affect closure
 * but large enough to exist. When removed, V3 becomes loose end instead of closing to V1 */
#44=LINE('',#34,#(-1.0,-1.0,0.0));
#45=EDGE_CURVE('',#35,#31,#44,.T.);
#70=ORIENTED_EDGE('',*,*,#41,.T.);
#71=ORIENTED_EDGE('',*,*,#43,.T.);
#72=ORIENTED_EDGE('',*,*,#45,.T.);
#80=EDGE_LOOP('',(#70,#71,#72));
#81=FACE_OUTER_BOUND('',#80,.T.);
#82=ADVANCED_FACE('',(#81),#20,.T.);
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi182','Twi182','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9020=OPEN_SHELL('wrap_shell',(#82));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
