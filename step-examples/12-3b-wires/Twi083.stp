ISO-10303-21;
/* Twi083 - Edge declared degenerate but has positive-length curve.
 * Defect: an EDGE_CURVE references a LINE with two distinct endpoints
 * but is included in a wire as a degenerate edge (a logical pole). */
HEADER;
FILE_DESCRIPTION(('Twi083 - EDGE_CURVE flagged degenerate but its 3D LINE has positive length (non-zero distance between distinct VERTEX_POINTs)','Pass C gap-fill'),'2;1');
FILE_NAME('Twi083.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(1.0,0.0,0.0));
#12=VERTEX_POINT('',#10);
#13=VERTEX_POINT('',#11);
#20=DIRECTION('',(1.0,0.0,0.0));
#21=VECTOR('',#20,1.0);
#22=LINE('positive_length_line',#10,#21);
/* The edge's underlying line has length 1, but downstream uses
   treat this edge as a degenerate pole-edge. */
#30=EDGE_CURVE('degenerate_flag_lying',#12,#13,#22,.T.);
ENDSEC;
END-ISO-10303-21;
