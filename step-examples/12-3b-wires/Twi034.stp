ISO-10303-21;
/* Twi034: OPEN_SHELL with one ADVANCED_FACE on a PLANE (z=0, 2x2 square); FACE_OUTER_BOUND references an EDGE_LOOP containing only three ORIENTED_EDGEs: bottom edge (v00→v10), right edge (v10→v11), top edge (v11→v01); the closing left edge (v01→v00) is absent — wire ends at v01 but started at v00, never returns to start; three-edge open EDGE_LOOP on a rectangular face IS the mechanism; EDGE_LOOP IS wired into FACE_OUTER_BOUND, ADVANCED_FACE, OPEN_SHELL; healer with ClosedWireMode must insert the missing closing edge */
HEADER;
FILE_DESCRIPTION(('Twi034'),'2;1');
