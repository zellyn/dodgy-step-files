ISO-10303-21;
/* Twi213 — ShapeAnalysis_Wire.CheckGap3d using-pcurve-distance
 * Defect: Adjacent edges have valid 3D positional continuity but invalid pcurve
 * geometry (gap in parametric space); CheckGap3d defaults to 3D distance check
 * and misses the pcurve discontinuity entirely. */
HEADER;
FILE_DESCRIPTION(('Twi213 test case','CheckGap3d using-pcurve-distance'),'2;1');
FILE_NAME('Twi213.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Surface: plane in XY */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
/* Edge 1: curve from (0,0) to (5,0) with pcurve (u,v)=(0,0) to (5,0) */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=VERTEX_POINT('',#20);
#22=CARTESIAN_POINT('',(5.0,0.0,0.0));
#23=VERTEX_POINT('',#22);
#30=DIRECTION('',(1.0,0.0,0.0));
#31=VECTOR('',#30,1.0);
#32=LINE('',#20,#31);
#40=TRIMMED_CURVE('',#32,.T.,#20,.T.,.T.,#22);
#41=EDGE_CURVE('',#21,#23,#40,.T.);
/* pcurve for Edge 1: u from 0 to 5 */
#33=DIRECTION('',(1.0,0.0));
#34=VECTOR('',#33,1.0);
#35=LINE('',#10,#34);
#36=TRIMMED_CURVE('',#35,.T.,#10,.T.,.T.,#22);
/* Attach pcurve */
#42=PCURVE('',#14,#36);
/* Edge 2: curve from (5,0) to (10,0) with 3D continuity but pcurve gap
   3D endpoint of Edge1 = (5,0) matches 3D startpoint of Edge2 = (5,0)
   BUT: pcurve for Edge 2 goes from (7,0) to (10,0) - GAP IN PARAMETRIC SPACE! */
#24=CARTESIAN_POINT('',(5.0,0.0,0.0));
#25=VERTEX_POINT('',#24);
#26=CARTESIAN_POINT('',(10.0,0.0,0.0));
#27=VERTEX_POINT('',#26);
#37=LINE('',#25,#31);
#43=TRIMMED_CURVE('',#37,.T.,#25,.T.,.T.,#26);
#44=EDGE_CURVE('',#25,#27,#43,.T.);
/* pcurve for Edge 2: starts at (7,0) instead of (5,0) - discontinuity! */
#38=CARTESIAN_POINT('',(7.0,0.0,0.0));
#39=LINE('',#38,#33);
#45=TRIMMED_CURVE('',#39,.T.,#38,.T.,.T.,#26);
#46=PCURVE('',#14,#45);
/* Wire: two edges with 3D continuity but parametric gap */
#50=ORIENTED_EDGE('',*,*,#41,.T.);
#51=ORIENTED_EDGE('',*,*,#44,.T.);
#60=EDGE_LOOP('',(#50,#51));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi213','Twi213','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#60));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
