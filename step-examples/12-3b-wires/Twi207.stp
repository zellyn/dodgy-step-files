ISO-10303-21;
/* Twi207 - ShapeFix_Wire.FixGaps2d gap-at-knot-discontinuity
 * Wire on a B-spline surface where pcurves leave gaps exactly at knot lines.
 * Two consecutive edges have pcurves that meet at a knot value (parameter discontinuity).
 * Edge1 pcurve ends at knot u=1.5 with endpoint (1.5, 5.0).
 * Edge2 pcurve starts at u=1.5 but at parameter v=5.01 due to B-spline knot singularity.
 * FixGaps2d's bridging logic doesn't handle knot-aware splice; it tries to create
 * a straight-line bridge across the knot boundary, which is invalid for B-spline surface. */
HEADER;
FILE_DESCRIPTION(('Twi207 test case','ShapeFix_Wire.FixGaps2d gap-at-knot-discontinuity'),'2;1');
FILE_NAME('Twi207.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* B-spline surface with knot at u=1.5 */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Create 4 control points for a degree-2 B-spline in U and degree-1 in V */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=CARTESIAN_POINT('',(1.0,0.0,1.0));
#22=CARTESIAN_POINT('',(2.0,0.0,1.5));
#23=CARTESIAN_POINT('',(3.0,0.0,0.5));
#24=CARTESIAN_POINT('',(0.0,10.0,0.0));
#25=CARTESIAN_POINT('',(1.0,10.0,1.0));
#26=CARTESIAN_POINT('',(2.0,10.0,1.5));
#27=CARTESIAN_POINT('',(3.0,10.0,0.5));
/* B-spline surface: degree 2 in U, degree 1 in V */
#30=B_SPLINE_SURFACE_WITH_KNOTS('bspl_surf',2,1,
((#20,#21,#22,#23),(#24,#25,#26,#27)),.UNSPECIFIED.,
.F.,.F.,(3,2,3),(2),(0.0,0.75,1.5,2.25),(0.0,10.0),.UNSPECIFIED.);
/* Knot at u=1.5 is discontinuity in B-spline basis */
/* Vertices for the wire */
#40=CARTESIAN_POINT('',(0.5,5.0,0.2));
#41=VERTEX_POINT('',#40);
#42=CARTESIAN_POINT('',(1.5,5.0,1.1));
#43=VERTEX_POINT('',#42);
#44=CARTESIAN_POINT('',(2.5,5.0,1.3));
#45=VERTEX_POINT('',#44);
/* Edge1: 3D line from v1 to v2 (spanning toward knot) */
#50=DIRECTION('',(1.0,0.0,0.9));
#51=VECTOR('',#50,1.0);
#52=LINE('',#40,#51);
#53=EDGE_CURVE('edge1_to_knot',#41,#43,#52,.T.);
/* Edge1 pcurve: u in [0.5, 1.5], v in [5.0, 5.0] (constant v) */
#54=CARTESIAN_POINT('',(0.5,5.0));
#55=DIRECTION('',(1.0,0.0));
#56=VECTOR('',#55,1.0);
#57=LINE('',#54,#56);
#58=DEFINITIONAL_REPRESENTATION('',(#57),#13);
#59=PCURVE('edge1_pcurve',#30,#58);
#60=SURFACE_CURVE('edge1_sc',#52,(#59),.PCURVE_S1.);
#61=EDGE_CURVE('edge1_final',#41,#43,#60,.T.);
/* Edge2: 3D line from v2 to v3 (crossing knot) */
#62=DIRECTION('',(1.0,0.0,0.2));
#63=VECTOR('',#62,1.0);
#64=LINE('',#42,#63);
#65=EDGE_CURVE('edge2_postknot',#43,#45,#64,.T.);
/* Edge2 pcurve: u in [1.5, 2.5], v in [5.01, 5.0] -- GAP at knot crossing
 * Starting at v=5.01 instead of v=5.0 due to B-spline knot singularity */
#66=CARTESIAN_POINT('',(1.5,5.01));
#67=DIRECTION('',(1.0,-0.01));
#68=VECTOR('',#67,1.0);
#69=LINE('',#66,#68);
#70=DEFINITIONAL_REPRESENTATION('',(#69),#13);
#71=PCURVE('edge2_pcurve_gapped',#30,#70);
#72=SURFACE_CURVE('edge2_sc',#64,(#71),.PCURVE_S1.);
#73=EDGE_CURVE('edge2_final',#43,#45,#72,.T.);
/* Edge3: closing edge back to v1 */
#74=DIRECTION('',(-2.0,0.0,-1.1));
#75=VECTOR('',#74,1.0);
#76=LINE('',#44,#75);
#77=EDGE_CURVE('edge3_close',#45,#41,#76,.T.);
#78=CARTESIAN_POINT('',(2.5,5.0));
#79=DIRECTION('',(-1.0,0.0));
#80=VECTOR('',#79,1.0);
#81=LINE('',#78,#80);
#82=DEFINITIONAL_REPRESENTATION('',(#81),#13);
#83=PCURVE('edge3_pcurve',#30,#82);
#84=SURFACE_CURVE('edge3_sc',#76,(#83),.PCURVE_S1.);
#85=EDGE_CURVE('edge3_final',#45,#41,#84,.T.);
/* Wire closing loop */
#90=ORIENTED_EDGE('',*,*,#61,.T.);
#91=ORIENTED_EDGE('',*,*,#73,.T.);
#92=ORIENTED_EDGE('',*,*,#85,.T.);
#93=EDGE_LOOP('',(#90,#91,#92));
#94=FACE_OUTER_BOUND('',#93,.T.);
#95=ADVANCED_FACE('face_on_bspl',(#94),#30,.T.);
/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi207','Twi207','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#95));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
