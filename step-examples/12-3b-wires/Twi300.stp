ISO-10303-21;
/* Twi300: OPEN_SHELL with one ADVANCED_FACE on a PLANE (z=0, normal +Z); FACE_OUTER_BOUND references a 3-edge triangular EDGE_LOOP: e_far (v0(0,0,0) -> far_along_unbounded_line_vertex(1e8,0,0), a LINE along +X through the origin -- unbounded by STEP's own LINE semantics, trimmed by a vertex 1e8 units out, effectively an infinite curve parameter relative to the face's normal ~1-unit scale), e_diag (far_along_unbounded_line_vertex -> v2(0,1,0)), e_close (v2 -> v0); the enormous trim distance on e_far IS the mechanism (DecodeMakeEdgeError / MakeFromCurve3D fallback force-build, infinite-parameter classification); EDGE_LOOP IS wired into FACE_OUTER_BOUND, ADVANCED_FACE, OPEN_SHELL; never orphaned */
HEADER;
FILE_DESCRIPTION(('Twi300'),'2;1');
FILE_NAME('Twi300.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
