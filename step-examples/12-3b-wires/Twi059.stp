ISO-10303-21;
/* Twi059: ADVANCED_FACE on a PLANE (10x10 square); EDGE_LOOP contains four EDGE_CURVEs; the top-right VERTEX_POINT is declared at (10.005,10.0,0.0) — offset 0.005 from where the right-edge's 3D LINE curve evaluates at its endpoint (10.0,10.0,0.0); vertex declared tolerance 1e-6 (UNCERTAINTY_MEASURE_WITH_UNIT) cannot absorb the gap; CheckVerticesWithCurve3d reports vertex/curve-evaluation disagreement for this vertex; the vertex 3D point and the 3D curve evaluation disagree beyond tolerance IS the mechanism; all VERTEX_POINTs and EDGE_CURVEs ARE wired into EDGE_LOOP → FACE_OUTER_BOUND → ADVANCED_FACE in CLOSED_SHELL — never orphaned */
HEADER;
FILE_DESCRIPTION(('Twi059'),'2;1');
FILE_NAME('Twi059.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
