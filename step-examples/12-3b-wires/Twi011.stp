ISO-10303-21;
/* Twi011 - Wire tail / hair (thin spike beyond max-angle/width threshold)
 * Defect: Wire emits a thin spike (collinear go-and-return) past a max-angle/
 * max-width threshold; produces zero-area extrusion artifacts. The wire here
 * traces A -> B -> C (=B') -> D where the segment B->C goes back over A->B
 * with a near-collinear backtrack. Heal by ShapeFix_Wire::FixTails; iterate
 * notch removal until convergence (configurable MaxTailAngle, MaxTailWidth).
 * Subsumes Twi012 (notched edges) and Twi016 (tail spikes). */
HEADER;
FILE_DESCRIPTION(('Twi011 test case','Wire tail / hair / notched edge (FixTails)'),'2;1');
FILE_NAME('Twi011.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Vertices: A=(0,0), B=(5,0), C=(3,0) [tail tip], D=(10,0), E=(10,10), F=(0,10) */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(5.0,0.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(3.0,0.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(10.0,0.0,0.0));
#37=VERTEX_POINT('',#36);
#38=CARTESIAN_POINT('',(10.0,10.0,0.0));
#39=VERTEX_POINT('',#38);
#40=CARTESIAN_POINT('',(0.0,10.0,0.0));
#41=VERTEX_POINT('',#40);
/* Curves */
#50=DIRECTION('',(1.0,0.0,0.0));
#51=VECTOR('',#50,1.0);
#52=LINE('',#30,#51);
#53=DIRECTION('',(-1.0,0.0,0.0));
#54=VECTOR('',#53,1.0);
#55=LINE('',#32,#54);
#56=DIRECTION('',(1.0,0.0,0.0));
#57=VECTOR('',#56,1.0);
#58=LINE('',#34,#57);
#59=DIRECTION('',(0.0,1.0,0.0));
#60=VECTOR('',#59,1.0);
#61=LINE('',#36,#60);
#62=DIRECTION('',(-1.0,0.0,0.0));
#63=VECTOR('',#62,1.0);
#64=LINE('',#38,#63);
#65=DIRECTION('',(0.0,-1.0,0.0));
#66=VECTOR('',#65,1.0);
#67=LINE('',#40,#66);
#70=EDGE_CURVE('',#31,#33,#52,.T.);
#71=EDGE_CURVE('',#33,#35,#55,.T.);
#72=EDGE_CURVE('',#35,#37,#58,.T.);
#73=EDGE_CURVE('',#37,#39,#61,.T.);
#74=EDGE_CURVE('',#39,#41,#64,.T.);
#75=EDGE_CURVE('',#41,#31,#67,.T.);
/* Defect: wire goes A->B (e1, len 5) then B->C (e2, len 2 backtrack) then
 * C->D (e3, len 7 forward). Tail is the 5..3..10 spike on Y=0. */
#80=ORIENTED_EDGE('',*,*,#70,.T.);
#81=ORIENTED_EDGE('',*,*,#71,.T.);
#82=ORIENTED_EDGE('',*,*,#72,.T.);
#83=ORIENTED_EDGE('',*,*,#73,.T.);
#84=ORIENTED_EDGE('',*,*,#74,.T.);
#85=ORIENTED_EDGE('',*,*,#75,.T.);
#90=EDGE_LOOP('',(#80,#81,#82,#83,#84,#85));
#91=FACE_OUTER_BOUND('',#90,.T.);
#92=ADVANCED_FACE('',(#91),#20,.T.);
/* Minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi011','Twi011','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#92));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
