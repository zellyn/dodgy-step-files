ISO-10303-21;
/* Twi110: Single ADVANCED_FACE on a CYLINDRICAL_SURFACE (radius 1, height 4, axis +Z); outer EDGE_LOOP has 4 edges: E0 bottom arc, E1 lateral, E2 top arc (all correct); E3 lateral: 3D LINE from v3=(1,0,4) to v0=(1,0,0) is geometrically correct; but pcurve v-start is set to -5.0 instead of 4.0 — pcurve evaluates to 3D point (1,0,-5) at parameter start; mid-curve sampling mismatch: 3D midpoint=(1,0,2), pcurve midpoint=(1,0,-2.5); ShapeAnalysis_Wire.CheckEdgeCurves detects 3D-vs-pcurve incoherence IS mechanism; EDGE_LOOP IS wired into FACE_OUTER_BOUND -> ADVANCED_FACE in CLOSED_SHELL; never orphaned */
HEADER;
FILE_DESCRIPTION(('Twi110'),'2;1');
FILE_NAME('Twi110.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
