ISO-10303-21;
/* Twi161: Single ADVANCED_FACE on PLANE in CLOSED_SHELL; outer EDGE_LOOP has 2 B-spline edges forming a closed lens shape; E0 degree-3 B-spline (0,0,0)→(10,0,0) arcing up through (3,5,0),(7,5,0); E1 degree-3 B-spline (10,0,0)→(0,0,0) arcing down through (7,-5,0),(3,-5,0); in a pcurve context CheckGap2d evaluates at knot endpoints; start/end pole position mismatch between E0 end pole and E1 start pole IS the mechanism — gap in 2D parameter space even when 3D vertices match; EDGE_LOOP IS wired into FACE_OUTER_BOUND → ADVANCED_FACE in CLOSED_SHELL — never orphaned */
HEADER;
FILE_DESCRIPTION(('Twi161'),'2;1');
FILE_NAME('Twi161.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
