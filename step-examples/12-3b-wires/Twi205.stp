ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Twi205'),'2;1');
FILE_NAME('Twi205.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Base plane */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* First B-spline: curves from bottom-left to tangent point at (5,5) */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(5.0,5.0,0.0));
#33=VERTEX_POINT('',#32);
#40=CARTESIAN_POINT('',(0.0,0.0,0.0));
#41=CARTESIAN_POINT('',(2.5,1.25,0.0));
#42=CARTESIAN_POINT('',(5.0,5.0,0.0));
#50=(BOUNDED_CURVE()B_SPLINE_CURVE(3,.T.,.F.,.T.,(#40,#41,#42),(UNSPECIFIED),.UNSPECIFIED.));
#60=EDGE_CURVE('',#31,#33,#50,.T.);
/* Second B-spline: curves from tangent point to top-right */
#70=CARTESIAN_POINT('',(10.0,10.0,0.0));
#71=VERTEX_POINT('',#70);
#80=CARTESIAN_POINT('',(5.0,5.0,0.0));
#81=CARTESIAN_POINT('',(7.5,8.75,0.0));
#82=CARTESIAN_POINT('',(10.0,10.0,0.0));
#90=(BOUNDED_CURVE()B_SPLINE_CURVE(3,.T.,.F.,.T.,(#80,#81,#82),(UNSPECIFIED),.UNSPECIFIED.));
#100=EDGE_CURVE('',#33,#71,#90,.T.);
/* Return path via line */
#110=DIRECTION('',(-1.0,-1.0,0.0));
#111=VECTOR('',#110,1.0);
#112=LINE('',#70,#111);
#120=EDGE_CURVE('',#71,#31,#112,.T.);
/* Wire with tangential B-spline pair */
#130=ORIENTED_EDGE('',*,*,#60,.T.);
#131=ORIENTED_EDGE('',*,*,#100,.T.);
#132=ORIENTED_EDGE('',*,*,#120,.T.);
#140=EDGE_LOOP('',(#130,#131,#132));
#141=FACE_OUTER_BOUND('',#140,.T.);
#150=ADVANCED_FACE('',(#141),#20,.T.);
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi205','Twi205','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9020=OPEN_SHELL('wrap_shell',(#150));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
