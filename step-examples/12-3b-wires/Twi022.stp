ISO-10303-21;
/* Twi022 - Seam edge with swapped pcurves (FixSeam)
 * Defect: A seam edge on a periodic face has its two pcurves swapped between
 * U=0 and U=2pi sides (or both pcurves identical). Result: wire fails to close
 * in UV after seam insertion. Heal by ShapeFix_Wire::FixSeam - detect and shift
 * the second pcurve by period. Here we model the simplified case where the
 * SURFACE_CURVE associated_geometry references the SAME pcurve twice. */
HEADER;
FILE_DESCRIPTION(('Twi022 test case','Seam edge with swapped/identical pcurves'),'2;1');
FILE_NAME('Twi022.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=CYLINDRICAL_SURFACE('',#13,10.0);
/* Vertices for the seam edge (top and bottom of cylinder generator at U=0) */
#30=CARTESIAN_POINT('',(10.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(10.0,0.0,5.0));
#33=VERTEX_POINT('',#32);
/* 3D seam line */
#34=DIRECTION('',(0.0,0.0,1.0));
#35=VECTOR('',#34,1.0);
#36=LINE('',#30,#35);
/* PCurve 1: at U=0 (the line v: 0 -> 5 along u=0) */
#40=CARTESIAN_POINT('',(0.0,0.0));
#41=DIRECTION('',(0.0,1.0));
#42=VECTOR('',#41,1.0);
#43=LINE('',#40,#42);
#44=DEFINITIONAL_REPRESENTATION('',(#43),#45);
#45=( GEOMETRIC_REPRESENTATION_CONTEXT(2)
      PARAMETRIC_REPRESENTATION_CONTEXT()
      REPRESENTATION_CONTEXT('parametric','2D') );
#46=PCURVE('',#20,#44);
/* Defect: SURFACE_CURVE associated_geometry references pcurve #46 twice
 * - both U=0 and U=2pi sides use the SAME pcurve. After seam insertion the
 * wire does not close in UV. */
#50=SURFACE_CURVE('',#36,(#46,#46),.PCURVE_S1.);
#60=EDGE_CURVE('',#31,#33,#50,.T.);
#61=ORIENTED_EDGE('',*,*,#60,.T.);
#62=ORIENTED_EDGE('',*,*,#60,.F.);
#70=EDGE_LOOP('',(#61,#62));
#71=FACE_OUTER_BOUND('',#70,.T.);
#72=ADVANCED_FACE('',(#71),#20,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi022','Twi022','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#72));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
