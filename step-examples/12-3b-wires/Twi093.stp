ISO-10303-21;
/* Twi093 - Synthesised seam edge is inserted through existing wire path on cylinder
 * CYLINDRICAL_SURFACE face whose single closed wire is a HELIX_SHAPED edge
 * that goes from (1,0,0) (U=0, V=0) to (1,0,h) (U=2*PI, V=h) -- one full
 * wrap of the cylinder. The wire crosses the seam at U=0 but does NOT
 * include the seam edge. A naive seam-fix insertion would intersect the
 * helix wire path, producing a figure-eight in UV. */
HEADER;
FILE_DESCRIPTION(('Twi093 test case','Cylindrical wire crosses seam without including it -- helix from (U=0,V=0) to (U=2pi,V=h)'),'2;1');
FILE_NAME('Twi093.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=CYLINDRICAL_SURFACE('host_cyl',#13,1.0);
/* Helix sample-control points -- 5 control points sweeping U=0..2*PI, V=0..2.0 */
#20=CARTESIAN_POINT('p0_U0_V0',(1.0,0.0,0.0));
#21=CARTESIAN_POINT('p1_Upi/2_V0p5',(0.0,1.0,0.5));
#22=CARTESIAN_POINT('p2_Upi_V1p0',(-1.0,0.0,1.0));
#23=CARTESIAN_POINT('p3_U3pi/2_V1p5',(0.0,-1.0,1.5));
#24=CARTESIAN_POINT('p4_U2pi_V2p0',(1.0,0.0,2.0));
/* B-spline 3D curve approximating the helix (one full wrap) */
#25=B_SPLINE_CURVE_WITH_KNOTS('helix_3d',3,(#20,#21,#22,#23,#24),.UNSPECIFIED.,.F.,.F.,(4,1,4),(0.0,0.5,1.0),.UNSPECIFIED.);
#26=VERTEX_POINT('V_at_seam',#20);
/* Seam-crossing closed wire: helix endpoints both reference V_at_seam (1,0,0)
 * but the curve sweeps U=0 to U=2*PI -- so the wire crosses the seam mid-curve. */
#27=EDGE_CURVE('helix_full_wrap_no_seam',#26,#26,#25,.T.);
/* pcurve goes (0,0)->(2*PI, 2.0) directly -- crosses seam without seam-edge */
#28=CARTESIAN_POINT('uv_start',(0.0,0.0));
#29=CARTESIAN_POINT('uv_end_full_period',(6.2831853,2.0));
#30=B_SPLINE_CURVE_WITH_KNOTS('pcurve_full_wrap',1,(#28,#29),.UNSPECIFIED.,.F.,.F.,(2,2),(0.0,1.0),.UNSPECIFIED.);
#31=DEFINITIONAL_REPRESENTATION('',(#30),#13);
#32=PCURVE('pcurve_crosses_seam_at_U2pi',#14,#31);
/* Wire references the helix as its only edge */
#40=ORIENTED_EDGE('',*,*,#27,.T.);
#41=EDGE_LOOP('seam_crossing_no_seam_edge',(#40));
#42=FACE_OUTER_BOUND('',#41,.T.);
#43=ADVANCED_FACE('cyl_face_seam_crossing_wire',(#42),#14,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi093','Twi093','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#43));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
