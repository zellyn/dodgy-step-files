ISO-10303-21;
/* Twi119 - ShapeFix_Wire.FixSmall threshold-on-tolerance
 * Defect: wire with "small" edge exactly at user-configured threshold.
 * FixSmall uses non-strict comparison (<=) at one point and strict (<) at another,
 * causing inconsistent behavior: edge 0.00001 at threshold 0.00001 may flag or not flag.
 * Edge length is exactly 1e-5, threshold is 1e-5, floating-point equality test fails.
 */
HEADER;
FILE_DESCRIPTION(('Twi119 test case','ShapeFix_Wire.FixSmall threshold-on-tolerance'),'2;1');
FILE_NAME('Twi119.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Vertices: small edge at exactly threshold length */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(0.00001,0.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(1.0,0.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(1.0,1.0,0.0));
#37=VERTEX_POINT('',#36);
/* Curve 1: small edge of exactly 1e-5 length */
#50=DIRECTION('',(1.0,0.0,0.0));
#51=VECTOR('',#50,0.00001);
#52=LINE('',#30,#51);
/* Curve 2: normal edge from (1e-5, 0) to (1, 0) */
#53=DIRECTION('',(1.0,0.0,0.0));
#54=VECTOR('',#53,0.99999);
#55=LINE('',#32,#54);
/* Curve 3: vertical edge from (1,0) to (1,1) */
#56=DIRECTION('',(0.0,1.0,0.0));
#57=VECTOR('',#56,1.0);
#58=LINE('',#34,#57);
/* Curve 4: closing edge from (1,1) back to (0,0) */
#59=DIRECTION('',(-1.0,-1.0,0.0));
#60=VECTOR('',#59,1.41421);
#61=LINE('',#36,#60);
/* Edges */
#70=EDGE_CURVE('',#31,#33,#52,.T.);
#71=EDGE_CURVE('',#33,#35,#55,.T.);
#72=EDGE_CURVE('',#35,#37,#58,.T.);
#73=EDGE_CURVE('',#37,#31,#61,.T.);
/* Oriented edges */
#80=ORIENTED_EDGE('',*,*,#70,.T.);
#81=ORIENTED_EDGE('',*,*,#71,.T.);
#82=ORIENTED_EDGE('',*,*,#72,.T.);
#83=ORIENTED_EDGE('',*,*,#73,.T.);
#90=EDGE_LOOP('',(#80,#81,#82,#83));
#91=FACE_OUTER_BOUND('',#90,.T.);
#92=ADVANCED_FACE('',(#91),#20,.T.);
/* Product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi119','Twi119','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#92));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
