ISO-10303-21;
/* Twi194 - FixIntersectingEdges shared-vertex-misclassification
 * Defect: ShapeFix_Wire.FixIntersectingEdges incorrectly treats two edges
 * sharing a common endpoint vertex as "intersecting" because their 2D
 * parameter spaces overlap near the shared vertex. FixIntersectingEdges
 * should distinguish true shared-vertex connectivity from parameter overlap. */
HEADER;
FILE_DESCRIPTION(('Twi194 test case','FixIntersectingEdges shared-vertex-misclassification'),'2;1');
FILE_NAME('Twi194.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Three vertices: A, B, C on a line */
#31=CARTESIAN_POINT('',(0.0,0.0,0.0));
#32=VERTEX_POINT('V1',#31);
#33=CARTESIAN_POINT('',(10.0,0.0,0.0));
#34=VERTEX_POINT('V2',#33);
#35=CARTESIAN_POINT('',(20.0,0.0,0.0));
#36=VERTEX_POINT('V3',#35);
/* Edge AB: (0,0) to (10,0) */
#37=DIRECTION('',(1.0,0.0,0.0));
#38=VECTOR('',#37,10.0);
#39=LINE('',#31,#38);
#40=EDGE_CURVE('E1',#32,#34,#39,.T.);
#41=ORIENTED_EDGE('',*,*,#40,.T.);
/* Edge BC: (10,0) to (20,0), sharing vertex #34 */
#42=DIRECTION('',(1.0,0.0,0.0));
#43=VECTOR('',#42,10.0);
#44=LINE('',#33,#43);
#45=EDGE_CURVE('E2',#34,#36,#44,.T.);
#46=ORIENTED_EDGE('',*,*,#45,.T.);
/* Edge CA (closing): (20,0) back to (0,0), wrapping around
   Its parameter space (u=0 to u=20) overlaps with E1 (u=0 to u=10)
   despite only sharing vertex V1. */
#47=DIRECTION('',(-1.0,0.0,0.0));
#48=VECTOR('',#47,20.0);
#49=LINE('',#35,#48);
#50=EDGE_CURVE('E3',#36,#32,#49,.T.);
#51=ORIENTED_EDGE('',*,*,#50,.T.);
/* Wire: three edges, E1-E2-E3 closed */
#60=EDGE_LOOP('',(#41,#46,#51));
#61=FACE_OUTER_BOUND('',#60,.T.);
#62=ADVANCED_FACE('',(#61),#20,.T.);
/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi194','Twi194','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9020=CLOSED_SHELL('shell',(#62));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
