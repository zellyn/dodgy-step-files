ISO-10303-21;
/* Twi204 - ShapeFix_Wire.FixIntersectingEdges 3-edges-at-vertex
 * Defect: Three edges meeting at single point (star configuration).
 * FixIntersectingEdges pairwise comparison reports 3 intersections at same point
 * but they're a vertex contact, not geometric crossings. */
HEADER;
FILE_DESCRIPTION(('Twi204 test case','ShapeFix_Wire.FixIntersectingEdges 3-edges-at-vertex — three edges meeting at single point (star); FixIntersectingEdges pairwise reports 3 intersections at same point but they are vertex contact'),'2;1');
FILE_NAME('Twi204.stp','2026-06-16T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Base plane */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Star center vertex */
#30=CARTESIAN_POINT('',(5.0,5.0,0.0));
#31=VERTEX_POINT('',#30);
/* Three outer vertices (120° apart) */
#32=CARTESIAN_POINT('',(10.0,5.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(2.5,10.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(2.5,0.0,0.0));
#37=VERTEX_POINT('',#36);
/* Edge 1: star center to point 1 (0°) */
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#30,#41);
#50=EDGE_CURVE('',#31,#33,#42,.T.);
/* Edge 2: star center to point 2 (120°) */
#60=DIRECTION('',(-0.5,0.866,0.0));
#61=VECTOR('',#60,1.0);
#62=LINE('',#30,#61);
#70=EDGE_CURVE('',#31,#35,#62,.T.);
/* Edge 3: star center to point 3 (240°) */
#80=DIRECTION('',(-0.5,-0.866,0.0));
#81=VECTOR('',#80,1.0);
#82=LINE('',#30,#81);
#90=EDGE_CURVE('',#31,#37,#82,.T.);
/* Edges connecting outer triangle (edges 4, 5, 6) */
#100=DIRECTION('',(-0.866,0.5,0.0));
#101=VECTOR('',#100,1.0);
#102=LINE('',#32,#101);
#110=EDGE_CURVE('',#33,#35,#102,.T.);
#120=DIRECTION('',(-1.0,0.0,0.0));
#121=VECTOR('',#120,1.0);
#122=LINE('',#34,#121);
#130=EDGE_CURVE('',#35,#37,#122,.T.);
#140=DIRECTION('',(0.866,-0.5,0.0));
#141=VECTOR('',#140,1.0);
#142=LINE('',#36,#141);
#150=EDGE_CURVE('',#37,#33,#142,.T.);
/* Wire: star edges (3) plus triangle closing (3) = 6 edges
   This creates a non-manifold wire with degree-4 vertex at center */
#160=ORIENTED_EDGE('',*,*,#50,.T.);
#161=ORIENTED_EDGE('',*,*,#110,.T.);
#162=ORIENTED_EDGE('',*,*,#70,.T.);
#163=ORIENTED_EDGE('',*,*,#130,.T.);
#164=ORIENTED_EDGE('',*,*,#90,.T.);
#165=ORIENTED_EDGE('',*,*,#150,.T.);
#170=EDGE_LOOP('',(#160,#161,#162,#163,#164,#165));
#171=FACE_OUTER_BOUND('',#170,.T.);
#180=ADVANCED_FACE('',(#171),#20,.T.);
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi204','Twi204','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9020=OPEN_SHELL('wrap_shell',(#180));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
