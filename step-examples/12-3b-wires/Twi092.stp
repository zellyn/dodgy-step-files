ISO-10303-21;
/* Twi092 - Wire with degenerated edge dropped silently on export
 * Truncated cone wedge: the wire that should have FOUR edges (lateral edge
 * up-the-side, top arc at the apex, lateral edge down, base arc) was
 * exported with only THREE -- the degenerate apex edge (zero-length seam
 * at the cone tip between two coincident apex VERTEX_POINTs) was dropped. */
HEADER;
FILE_DESCRIPTION(('Twi092 test case','Cone-wedge wire missing the degenerate apex edge -- 3 edges instead of 4'),'2;1');
FILE_NAME('Twi092.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('cone_origin',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('cone_axis',#10,#11,#12);
#14=CONICAL_SURFACE('host_cone',#13,1.0,0.7853981633974483);
/* Apex at (0,0,0); base at z=-1, radius 1. The wire would visit (in 4-edge form):
 *   V_base_a -> V_base_b (base arc), V_base_b -> V_apex_b (lateral),
 *   V_apex_b -> V_apex_a (degenerate apex edge), V_apex_a -> V_base_a (lateral).
 * Exporter dropped the V_apex_b -> V_apex_a degenerate edge. */
#20=CARTESIAN_POINT('apex_a',(0.0,0.0,0.0));#21=VERTEX_POINT('V_apex_a',#20);
#22=CARTESIAN_POINT('apex_b',(0.0,0.0,0.0));#23=VERTEX_POINT('V_apex_b',#22);
#24=CARTESIAN_POINT('base_a',(1.0,0.0,-1.0));#25=VERTEX_POINT('V_base_a',#24);
#26=CARTESIAN_POINT('base_b',(0.0,1.0,-1.0));#27=VERTEX_POINT('V_base_b',#26);
/* base arc V_base_a -> V_base_b (quarter circle on z=-1 plane) */
#30=CARTESIAN_POINT('arc_centre',(0.0,0.0,-1.0));
#31=DIRECTION('',(0.0,0.0,1.0));#32=DIRECTION('',(1.0,0.0,0.0));
#33=AXIS2_PLACEMENT_3D('',#30,#31,#32);
#34=CIRCLE('base_arc',#33,1.0);
#35=EDGE_CURVE('base_arc_edge',#25,#27,#34,.T.);
/* lateral V_base_b -> V_apex_b (line up the cone slant) */
#40=DIRECTION('',(0.0,-0.7071067811865475,0.7071067811865475));#41=VECTOR('',#40,1.4142);
#42=LINE('lateral_up',#26,#41);
#43=EDGE_CURVE('lateral_up_edge',#27,#23,#42,.T.);
/* lateral V_apex_a -> V_base_a (line back down the slant) */
#50=DIRECTION('',(0.7071067811865475,0.0,-0.7071067811865475));#51=VECTOR('',#50,1.4142);
#52=LINE('lateral_down',#20,#51);
#53=EDGE_CURVE('lateral_down_edge',#21,#25,#52,.T.);
/* DEFECT: the missing degenerate apex edge V_apex_b -> V_apex_a is NOT in the loop */
#60=ORIENTED_EDGE('',*,*,#35,.T.);
#61=ORIENTED_EDGE('',*,*,#43,.T.);
#62=ORIENTED_EDGE('',*,*,#53,.T.);
/* Three edges only -- apex degenerate edge dropped */
#63=EDGE_LOOP('cone_wedge_missing_apex_edge',(#60,#61,#62));
#64=FACE_OUTER_BOUND('',#63,.T.);
#65=ADVANCED_FACE('cone_wedge_face',(#64),#14,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi092','Twi092','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#65));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
