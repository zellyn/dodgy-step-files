ISO-10303-21;
/* Twi039 - 'Wire self-interference check failed' on mirrored arc footprints
 * Defect: A custom pad with an arc segment, mirrored to the bottom layer with
 * non-zero rotation, produces a wire OCC considers self-intersecting at
 * floating-point ULP level (BRepCheck_Wire::Closed2d returns
 * BRepCheck_NotClosed). Heal: invert arc parametrization symmetrically with
 * reflection rather than just negating Y; tighten parametric closure tolerance
 * check. Source: KiCad #21589 (pcbnew custom pad arc + mirror + rotation). */
HEADER;
FILE_DESCRIPTION(('Twi039 test case','Wire self-interference on mirrored arc'),'2;1');
FILE_NAME('Twi039.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Pad: arc (180 deg) from #31=(1,0,0) to #33=(-1,0,0) plus connecting line
 * back. After mirror (negate Y) and rotation by 1 degree, the line endpoint
 * misses the arc start by ~ULP - wire fails Closed2d check. */
#30=CARTESIAN_POINT('',(1.0,1.74533E-2,0.0));
#31=VERTEX_POINT('',#30);
/* Defect: vertex 2 was MEANT to be (-1,0,0) but mirror+rotation introduces
 * a tiny offset (~1.74e-2) that exceeds default closure tolerance after the
 * symmetric reparametrization. */
#32=CARTESIAN_POINT('',(-1.0,1.74534E-2,0.0));
#33=VERTEX_POINT('',#32);
#34=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#35=CIRCLE('',#34,1.0);
#36=EDGE_CURVE('',#31,#33,#35,.T.);
#37=DIRECTION('',(1.0,0.0,0.0));
#38=VECTOR('',#37,1.0);
#39=LINE('',#32,#38);
#40=EDGE_CURVE('',#33,#31,#39,.T.);
#50=ORIENTED_EDGE('',*,*,#36,.T.);
#51=ORIENTED_EDGE('',*,*,#40,.T.);
#60=EDGE_LOOP('',(#50,#51));
#61=FACE_OUTER_BOUND('',#60,.T.);
#62=ADVANCED_FACE('',(#61),#20,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi039','Twi039','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#62));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
