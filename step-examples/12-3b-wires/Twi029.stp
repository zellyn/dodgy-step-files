ISO-10303-21;
/* Twi029 - STEP writer drops entire wire if it contains a degenerate edge
 * Defect: When an OCCT shape contains a wire with one or more degenerate
 * edges (apex-bridge, seam) the writer historically omitted the entire wire
 * on STEP export - producing a file like this one where a cone face has its
 * apex degenerate edge missing. Round-tripping a cone solid showed this bug
 * (bug25843_step). Reader must accept emitted degenerate edges; writer must
 * emit them. */
HEADER;
FILE_DESCRIPTION(('Twi029 test case','STEP writer drops wire with degenerate edge'),'2;1');
FILE_NAME('Twi029.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Cone with apex */
#20=CONICAL_SURFACE('',#13,5.0,0.5235988);
#21=CARTESIAN_POINT('',(0.0,0.0,8.660254));
#22=VERTEX_POINT('',#21);
/* Base rim */
#30=CARTESIAN_POINT('',(5.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#33=CIRCLE('',#32,5.0);
#34=EDGE_CURVE('',#31,#31,#33,.T.);
/* Two meridians */
#40=DIRECTION('',(-0.5,0.0,0.8660254));
#41=VECTOR('',#40,1.0);
#42=LINE('',#30,#41);
#43=EDGE_CURVE('',#31,#22,#42,.T.);
/* Defect: writer-side bug - this file should have included a degenerate edge
 * at the apex (zero 3D length, finite UV length connecting U=0 to U=2pi at
 * the apex). The wire here has only base + meridians and is incomplete. */
#50=ORIENTED_EDGE('',*,*,#34,.T.);
#51=ORIENTED_EDGE('',*,*,#43,.T.);
#52=ORIENTED_EDGE('',*,*,#43,.F.);
#60=EDGE_LOOP('',(#50,#51,#52));
#61=FACE_OUTER_BOUND('',#60,.T.);
#62=ADVANCED_FACE('',(#61),#20,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi029','Twi029','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#62));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
