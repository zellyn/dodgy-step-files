ISO-10303-21;
/* Twi126 - ShapeFix_Wire.FixClosed linear submethod cascade
 * Defect: FixClosed runs FixConnected → FixDegenerated → FixLacking sequentially;
 * first sub-fix's state change makes second incorrectly skip work
 */
HEADER;
FILE_DESCRIPTION(('Twi126 test case','ShapeFix_Wire.FixClosed linear submethod cascade'),'2;1');
FILE_NAME('Twi126.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Wire with: gap (triggers FixConnected), degenerate edge (triggers FixDegenerated),
 * and missing closing edge (triggers FixLacking). After FixConnected fixes the gap,
 * FixDegenerated may skip due to state flag, leaving degenerate undetected.
 */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=VERTEX_POINT('',#10);
#12=CARTESIAN_POINT('',(1.0,0.0,0.0));
#13=VERTEX_POINT('',#12);
#14=CARTESIAN_POINT('',(1.0001,0.0,0.0));
#15=VERTEX_POINT('',#14);
#16=CARTESIAN_POINT('',(2.0,0.0,0.0));
#17=VERTEX_POINT('',#16);
#18=CARTESIAN_POINT('',(2.0,2.0,0.0));
#19=VERTEX_POINT('',#18);
/* Edge 1: normal line from (0,0) to (1,0) */
#20=LINE('',#10,#12);
#21=EDGE_CURVE('',#11,#13,#20,.T.);
/* Edge 2: tiny edge (1,0) to (1.0001,0) - degenerate candidate */
#30=LINE('',#12,#14);
#31=EDGE_CURVE('',#13,#15,#30,.T.);
/* Edge 3: gap edge from (1.0001,0) to (2,0) - triggers FixConnected */
#40=LINE('',#14,#16);
#41=EDGE_CURVE('',#15,#17,#40,.T.);
/* Edge 4: normal edge from (2,0) to (2,2) */
#50=LINE('',#16,#18);
#51=EDGE_CURVE('',#17,#19,#50,.T.);
/* Edge 5: edge from (2,2) that should close but doesn't reach (0,0) */
#60=LINE('',#18,#12);
#61=EDGE_CURVE('',#19,#13,#60,.T.);
/* Wire edges: cascade of fixes needed but state prevents proper cascade */
#70=ORIENTED_EDGE('',*,*,#21,.T.);
#71=ORIENTED_EDGE('',*,*,#31,.T.);
#72=ORIENTED_EDGE('',*,*,#41,.T.);
#73=ORIENTED_EDGE('',*,*,#51,.T.);
#74=ORIENTED_EDGE('',*,*,#61,.T.);
#80=EDGE_LOOP('',(#70,#71,#72,#73,#74));
/* Plane surface */
#90=CARTESIAN_POINT('',(0.0,0.0,0.0));
#91=DIRECTION('',(0.0,0.0,1.0));
#92=DIRECTION('',(1.0,0.0,0.0));
#93=AXIS2_PLACEMENT_3D('',#90,#91,#92);
#94=PLANE('',#93);
#100=FACE_OUTER_BOUND('',#80,.T.);
#101=ADVANCED_FACE('',(#100),#94,.T.);
/* Product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi126','Twi126','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#101));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
