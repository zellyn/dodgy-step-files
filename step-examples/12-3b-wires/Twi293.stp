ISO-10303-21;
/* Twi293: OPEN_SHELL with one ADVANCED_FACE on a PLANE; FACE_OUTER_BOUND references an EDGE_LOOP whose sole EDGE_CURVE 'wrapped_closed_edge' has start vertex == end vertex (full-period, Twi019's core pattern) but its curve slot references a TRIMMED_CURVE(trim_1=PARAMETER_VALUE(0.0), trim_2=PARAMETER_VALUE(2*pi), .T., .PARAMETER.) wrapping a plain full-period CIRCLE basis_curve — NOT the CIRCLE directly (Twi019's pattern); the closed-curve split/periodic-knot-correction logic must look past the TRIMMED_CURVE wrapper (which carries no independent knot structure of its own) to the true basis CIRCLE underneath to compute the seam split point; defect edge IS wired into EDGE_LOOP, FACE_OUTER_BOUND, ADVANCED_FACE, OPEN_SHELL; never orphaned */
HEADER;
FILE_DESCRIPTION(('Twi293'),'2;1');
