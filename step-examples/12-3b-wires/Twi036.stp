ISO-10303-21;
/* Twi036 - Lacking edge: UV gap not closable by vertex tolerance
 * Defect: Two adjacent edges meet in 3D within tolerance but their pcurve
 * endpoints in UV are separated by a parametric gap that no vertex tolerance
 * can bridge. Need to insert a synthetic edge. Heal by ShapeFix_Wire::FixLacking
 * - synthesize a degenerate or short pcurve segment to bridge the UV gap.
 * Source: CATIA01 #1727. */
HEADER;
FILE_DESCRIPTION(('Twi036 test case','Lacking edge - UV gap not closable (FixLacking)'),'2;1');
FILE_NAME('Twi036.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=CYLINDRICAL_SURFACE('',#13,10.0);
/* Two edges sharing a 3D vertex but their pcurves jump in UV by ~0.1 in u */
#30=CARTESIAN_POINT('',(10.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(0.0,10.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(10.0,0.0,5.0));
#35=VERTEX_POINT('',#34);
/* 3D curve segment 1: from #31 to #33 along arc */
#40=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#41=CIRCLE('',#40,10.0);
#42=EDGE_CURVE('',#31,#33,#41,.T.);
/* 3D curve segment 2: from #33 back to #35 along generator */
#43=DIRECTION('',(-0.8944271909999159,0.0,0.4472135954999579));
#44=VECTOR('',#43,1.0);
#45=LINE('',#32,#44);
#46=EDGE_CURVE('',#33,#35,#45,.T.);
/* Defect: in UV, e1's pcurve ends at u=pi/2, but e2's pcurve starts at u=pi/2
 * + 0.1 (a UV-only mismatch). The 3D vertex is shared but the UV gap is too
 * large for vertex-tolerance to bridge. FixLacking would synthesize a short
 * pcurve segment from (pi/2, ...) to (pi/2 + 0.1, ...). */
#50=ORIENTED_EDGE('',*,*,#42,.T.);
#51=ORIENTED_EDGE('',*,*,#46,.T.);
#60=EDGE_LOOP('',(#50,#51));
#61=FACE_OUTER_BOUND('',#60,.T.);
#62=ADVANCED_FACE('',(#61),#20,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi036','Twi036','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#62));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
