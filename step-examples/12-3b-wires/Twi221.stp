ISO-10303-21;
/* Twi221 - ShapeFix_Wire.FixDummySeam non-canonical-seam-position
 * Defect: Cylinder or other surface with seam at u=π/4 (45 degrees), which is
 * not the standard canonical seam position (u=0 or u=2π). FixDummySeam's heuristic
 * assumes seam edges are only at u=0 or u=2π and applies transformations that
 * fail or produce incorrect results when seam is at non-canonical positions.
 * The fixer cannot detect or repair non-standard seam placement.
 * Reproduces: ShapeFix_Wire.FixDummySeam branches 1-3. */
HEADER;
FILE_DESCRIPTION(('Twi221 test case','Non-canonical seam position at u=π/4'),'2;1');
FILE_NAME('Twi221.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Cylinder with seam intentionally offset to u=π/4 (non-canonical) */
#14=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#15=CYLINDER('',#14,5.0);
/* Seam edge at u=π/4 (cos(π/4), sin(π/4)) = (√2/2*5, √2/2*5) ≈ (3.536, 3.536) */
#20=CARTESIAN_POINT('',(3.535533905932738,3.535533905932738,0.0));
#21=CARTESIAN_POINT('',(3.535533905932738,3.535533905932738,10.0));
#22=CARTESIAN_POINT('',(3.535533905932738,3.535533905932738,0.0));
#23=CARTESIAN_POINT('',(3.535533905932738,3.535533905932738,10.0));
#24=LINE('',#22,(DIRECTION('',(0.0,0.0,1.0)),1.0));
/* Vertices at seam endpoints */
#30=VERTEX_POINT('',#20);
#31=VERTEX_POINT('',#21);
/* Seam edge with non-canonical parameter position */
#40=EDGE_CURVE('',#30,#31,#24,.T.);
/* PCurve: u=π/4 (0.7854) parametrized from v=0 to v=10 */
#50=CARTESIAN_POINT('',(0.7854,0.0));
#51=DIRECTION('',(0.0,1.0));
#52=VECTOR('',#51,1.0);
#53=LINE('',#50,#52);
#60=PCURVE('',#15,#53);
#61=ORIENTED_EDGE('',*,*,#40,.T.);
#62=EDGE_LOOP('',(#61));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#15,.T.);
/* Product chain (v3.2 schema) */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi221','Twi221','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('shell',(#64));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
