ISO-10303-21;
/* Twi221: Single ADVANCED_FACE on CYLINDRICAL_SURFACE (radius 1, height 2) in CLOSED_SHELL; cylinder X-reference rotated by pi/4 about +Z places seam at global angle pi/4 — non-canonical seam position IS the defect; full closed band EDGE_LOOP (seam-lateral + full-top-circle + seam-lateral-reversed + full-bottom-circle); FixDummySeam heuristic only looks for seam at u=0 or u=2pi — fails on non-standard pi/4 placement IS the mechanism; EDGE_LOOP IS wired into FACE_OUTER_BOUND -> ADVANCED_FACE in CLOSED_SHELL — never orphaned */
HEADER;
FILE_DESCRIPTION(('Twi221'),'2;1');
