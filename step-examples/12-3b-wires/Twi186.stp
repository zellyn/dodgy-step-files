ISO-10303-21;
/* Twi186 - ShapeFix_Wire.FixIntersectingEdges parametric-overlap
 * Defect: Wire with two edges whose 3D paths don't intersect but their parametric
 * ranges on shared host surface do; FixIntersectingEdges uses 2D and produces a
 * false split at non-existent 3D intersection. */
HEADER;
FILE_DESCRIPTION(('Twi186 test case','Parametric overlap without 3D intersection causes false split'),'2;1');
FILE_NAME('Twi186.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Toroidal surface: major radius 2.0, minor radius 1.0 */
/* This surface maps U,V parametrically in ways that create 2D overlaps
 * without 3D intersection */
#20=TOROIDAL_SURFACE('',#13,2.0,1.0);
/* Four vertices on the torus surface at different (U,V) parameter locations */
#30=CARTESIAN_POINT('',(3.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(2.0,1.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(1.0,0.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(2.0,-1.0,0.0));
#37=VERTEX_POINT('',#36);
/* Edge 1: Along U=0 line from V=0 to V=pi (outer equator) */
#40=LINE('',#30,#(-1.0,0.0,0.0));
#41=EDGE_CURVE('',#31,#33,#40,.T.);
/* Edge 2: Along V=0 line from U=0 to U=pi (inner meridian);
 * In 2D parameter space, this overlaps with Edge 1's path,
 * but in 3D they don't intersect (one wraps outer surface, one inner) */
#42=LINE('',#32,#(-1.0,-1.0,0.0));
#43=EDGE_CURVE('',#33,#35,#42,.T.);
/* Edge 3: Return path from V=pi meridian back to starting point */
#44=LINE('',#34,#(1.0,-1.0,0.0));
#45=EDGE_CURVE('',#35,#37,#44,.T.);
/* Edge 4: Close from opposite end */
#46=LINE('',#36,#(1.0,1.0,0.0));
#47=EDGE_CURVE('',#37,#31,#46,.T.);
#70=ORIENTED_EDGE('',*,*,#41,.T.);
#71=ORIENTED_EDGE('',*,*,#43,.T.);
#72=ORIENTED_EDGE('',*,*,#45,.T.);
#73=ORIENTED_EDGE('',*,*,#47,.T.);
/* Defect: In 2D parameter space, edges #41 and #43 overlap parametrically
 * (both cover ranges that cross in (U,V) domain), but in 3D their 3D curves
 * don't actually touch. FixIntersectingEdges using 2D analysis will attempt
 * a split at false 3D intersection point */
#80=EDGE_LOOP('',(#70,#71,#72,#73));
#81=FACE_OUTER_BOUND('',#80,.T.);
#82=ADVANCED_FACE('',(#81),#20,.T.);
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi186','Twi186','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#82));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
