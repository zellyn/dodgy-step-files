#6=CARTESIAN_POINT('',(0.0,0.0,0.0));
#7=AXIS2_PLACEMENT_3D('',#6,#2,#3);
#8=CIRCLE('',#7,1.0);
#9=CARTESIAN_POINT('',(0.0,0.0,0.0));
#10=VERTEX_POINT('off_curve_center_vertex',#9);
#11=EDGE_CURVE('',#10,#10,#8,.T.);
#12=ORIENTED_EDGE('',*,*,#11,.T.);
#13=EDGE_LOOP('',(#12));
#14=FACE_OUTER_BOUND('',#13,.T.);
#15=ADVANCED_FACE('',(#14),#5,.T.);
#16=OPEN_SHELL('',(#15));
#17=SHELL_BASED_SURFACE_MODEL('',(#16));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Twi299','Twi299','',(#9050));
