ISO-10303-21;
/* Twi079 - Internal hole wire whose enclosed area is below threshold
 * Square outer face 10x10 on a PLANE; inner FACE_INNER_BOUND is a tiny
 * triangle near the centre with vertices (5.0, 5.0), (5.001, 5.0),
 * (5.0, 5.001) -- enclosed area ~= 5.0e-7 mm^2, well below any feature
 * threshold. RemoveInternalWires must classify and drop it. */
HEADER;
FILE_DESCRIPTION(('Twi079 test case','Square face with sub-threshold inner triangle hole'),'2;1');
FILE_NAME('Twi079.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
/* outer 10x10 square */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));#21=VERTEX_POINT('',#20);
#22=CARTESIAN_POINT('',(10.0,0.0,0.0));#23=VERTEX_POINT('',#22);
#24=CARTESIAN_POINT('',(10.0,10.0,0.0));#25=VERTEX_POINT('',#24);
#26=CARTESIAN_POINT('',(0.0,10.0,0.0));#27=VERTEX_POINT('',#26);
#30=DIRECTION('',(1.0,0.0,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#20,#31);
#33=EDGE_CURVE('',#21,#23,#32,.T.);
#34=DIRECTION('',(0.0,1.0,0.0));#35=VECTOR('',#34,1.0);#36=LINE('',#22,#35);
#37=EDGE_CURVE('',#23,#25,#36,.T.);
#38=DIRECTION('',(-1.0,0.0,0.0));#39=VECTOR('',#38,1.0);#40=LINE('',#24,#39);
#41=EDGE_CURVE('',#25,#27,#40,.T.);
#42=DIRECTION('',(0.0,-1.0,0.0));#43=VECTOR('',#42,1.0);#44=LINE('',#26,#43);
#45=EDGE_CURVE('',#27,#21,#44,.T.);
#50=ORIENTED_EDGE('',*,*,#33,.T.);
#51=ORIENTED_EDGE('',*,*,#37,.T.);
#52=ORIENTED_EDGE('',*,*,#41,.T.);
#53=ORIENTED_EDGE('',*,*,#45,.T.);
#54=EDGE_LOOP('outer_10x10',(#50,#51,#52,#53));
#55=FACE_OUTER_BOUND('outer',#54,.T.);
/* tiny inner triangle, area ~= 5.0e-7 mm^2 */
#60=CARTESIAN_POINT('',(5.0,5.0,0.0));#61=VERTEX_POINT('Ia',#60);
#62=CARTESIAN_POINT('',(5.001,5.0,0.0));#63=VERTEX_POINT('Ib',#62);
#64=CARTESIAN_POINT('',(5.0,5.001,0.0));#65=VERTEX_POINT('Ic',#64);
#66=DIRECTION('',(1.0,0.0,0.0));#67=VECTOR('',#66,1.0);#68=LINE('',#60,#67);
#69=EDGE_CURVE('',#61,#63,#68,.T.);
#70=DIRECTION('',(-0.7071067811865475,0.7071067811865475,0.0));#71=VECTOR('',#70,1.4142);#72=LINE('',#62,#71);
#73=EDGE_CURVE('',#63,#65,#72,.T.);
#74=DIRECTION('',(0.0,-1.0,0.0));#75=VECTOR('',#74,1.0);#76=LINE('',#64,#75);
#77=EDGE_CURVE('',#65,#61,#76,.T.);
#80=ORIENTED_EDGE('',*,*,#69,.T.);
#81=ORIENTED_EDGE('',*,*,#73,.T.);
#82=ORIENTED_EDGE('',*,*,#77,.T.);
#83=EDGE_LOOP('inner_subthreshold_tri',(#80,#81,#82));
#84=FACE_INNER_BOUND('inner_area_5e-7',#83,.T.);
#90=ADVANCED_FACE('square_with_tiny_hole',(#55,#84),#14,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
