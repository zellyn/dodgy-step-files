ISO-10303-21;
/* Twi217: Single ADVANCED_FACE on CYLINDRICAL_SURFACE (radius 1, height 2) in CLOSED_SHELL; 4-edge EDGE_LOOP forming patch from u=0 to u=pi; seam edge E0 has 3D LINE going upward (z: 0->2, same_sense=T) but PCURVE 2D direction going downward in UV (v: H->0) — u-orientation of pcurve antiparallel to 3D curve IS the defect; FixSeam corrects pcurve but old 3D geometry becomes orphaned — orphaned 3D curve IS the secondary mechanism; EDGE_LOOP IS wired into FACE_OUTER_BOUND -> ADVANCED_FACE in CLOSED_SHELL — never orphaned */
HEADER;
FILE_DESCRIPTION(('Twi217'),'2;1');
FILE_NAME('Twi217.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
