ISO-10303-21;
/* Twi217 - ShapeFix_Wire.FixSeam pcurve-direction-not-matching-3d
 * Defect: Seam edge where parametric curve direction (PCurve u-orientation)
 * differs from 3D curve direction. FixSeam corrects PCurve to match 3D, but
 * the original 3D curve becomes orphaned/unreferenced in STEP model. This is
 * a defect in the pre-heal STEP instance: mismatch between curve orientations
 * on a seam edge that forces a repair where one orientation must be sacrificed.
 * Reproduces: ShapeFix_Wire.FixSeam branch at line ~1616. */
HEADER;
FILE_DESCRIPTION(('Twi217 test case','Seam edge pcurve direction mismatching 3D curve'),'2;1');
FILE_NAME('Twi217.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Cylindrical surface seam at u=0/2π */
#14=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#15=CYLINDER('',#14,5.0);
/* 3D curve: line along u=0 (seam position) from v=0 to v=10 */
#20=CARTESIAN_POINT('',(5.0,0.0,0.0));
#21=CARTESIAN_POINT('',(5.0,0.0,10.0));
#22=CARTESIAN_POINT('',(5.0,0.0,0.0));
#23=CARTESIAN_POINT('',(5.0,0.0,10.0));
#24=LINE('',#20,(DIRECTION('',(0.0,0.0,1.0)),1.0));
/* Vertices at seam endpoints */
#30=VERTEX_POINT('',#22);
#31=VERTEX_POINT('',#23);
/* Seam edge with 3D line */
#40=EDGE_CURVE('',#30,#31,#24,.T.);
/* PCurve on cylinder: parametric direction (u-direction) pointing
 * opposite to 3D curve orientation. This creates the mismatch. */
#50=CARTESIAN_POINT('',(0.0,0.0));
#51=DIRECTION('',(1.0,0.0));
#52=VECTOR('',#51,1.0);
#53=CARTESIAN_POINT('',(0.0,10.0));
#54=DIRECTION('',(0.0,1.0));
#55=VECTOR('',#54,1.0);
#56=LINE('',#50,#55);
/* PCurve: opposite direction means seam correction must flip orientation */
#60=PCURVE('',#15,#56);
#61=ORIENTED_EDGE('',*,*,#40,.F.);
#62=EDGE_LOOP('',(#61));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#15,.T.);
/* Product chain (v3.2 schema) */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi217','Twi217','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('shell',(#64));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
