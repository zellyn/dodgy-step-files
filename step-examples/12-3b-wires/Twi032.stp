ISO-10303-21;
/* Twi032 - Closed face needs splitting at seam (ShapeUpgrade_ShapeDivideClosed)
 * Defect: A periodic face (full cylinder here) wrapping U from 0 to 2pi as a
 * single face must be split at the seam into multiple faces - for downstream
 * meshing, parametric trimming, or BSpline conversion. Closed-edge splitting
 * is a sub-step. Heal by ShapeUpgrade_ShapeDivideClosed - split into two faces
 * at U=0 (and optionally U=pi) introducing seam edges and matching pcurves. */
HEADER;
FILE_DESCRIPTION(('Twi032 test case','Closed face needs splitting at seam'),'2;1');
FILE_NAME('Twi032.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=CYLINDRICAL_SURFACE('',#13,10.0);
/* Bottom rim circle (closed full 2pi single edge) */
#30=CARTESIAN_POINT('',(10.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#33=CIRCLE('',#32,10.0);
#34=EDGE_CURVE('',#31,#31,#33,.T.);
/* Top rim */
#40=CARTESIAN_POINT('',(0.0,0.0,5.0));
#41=AXIS2_PLACEMENT_3D('',#40,#11,#12);
#42=CIRCLE('',#41,10.0);
#43=CARTESIAN_POINT('',(10.0,0.0,5.0));
#44=VERTEX_POINT('',#43);
#45=EDGE_CURVE('',#44,#44,#42,.T.);
/* Defect: a single ADVANCED_FACE wraps the full cylinder 0..2pi without any
 * seam split. Downstream tools (mesher, exporter) need the face split at U=0
 * (and possibly U=pi) into matching half-faces. */
#50=ORIENTED_EDGE('',*,*,#34,.T.);
#51=ORIENTED_EDGE('',*,*,#45,.F.);
#60=EDGE_LOOP('',(#50));
#61=FACE_OUTER_BOUND('',#60,.T.);
#62=EDGE_LOOP('',(#51));
#63=FACE_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#61,#63),#20,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi032','Twi032','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#64));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
