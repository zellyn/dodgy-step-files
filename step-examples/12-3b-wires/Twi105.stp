ISO-10303-21;
/* Twi105 - ShapeAnalysis_Wire.CheckIntersectingEdges seam-gap tolerance miss
 * Closed 4-edge wire on a CYLINDRICAL_SURFACE where non-adjacent edges E1 and E3
 * intersect in 3D space at a point falling in the seam-gap region. Vertex tolerance
 * of 0.1 and spatial gap of 0.05 cause CheckIntersectingEdges at line 1645 to miss. */
HEADER;
FILE_DESCRIPTION(('Twi105 - CheckIntersectingEdges misses seam-gap intersection'),'2;1');
FILE_NAME('Twi105.stp','2026-06-16T00:00:00',('cad-research-suite'),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Cylindrical surface (seam-bearing) for geometry */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=CYLINDRICAL_SURFACE('',#23,5.0);
/* Four vertices forming a closed wire with intersecting non-adjacent edges */
#30=CARTESIAN_POINT('P0',(5.0,0.0,0.0));
#31=CARTESIAN_POINT('P1',(5.0,0.0,5.0));
#32=CARTESIAN_POINT('P2',(3.5,3.5,5.0));
#33=CARTESIAN_POINT('P3',(3.5,3.5,0.0));
#40=VERTEX_POINT('',#30);
#41=VERTEX_POINT('',#31);
#42=VERTEX_POINT('',#32);
#43=VERTEX_POINT('',#33);
/* Edge 1: P0 -> P1 (vertical on seam) */
#50=DIRECTION('',(0.0,0.0,1.0));
#51=VECTOR('',#50,1.0);
#52=LINE('',#30,#51);
#53=EDGE_CURVE('E1',#40,#41,#52,.T.);
/* Edge 2: P1 -> P2 (diagonal on surface) */
#60=DIRECTION('',(-0.7071067811865475,0.7071067811865475,0.0));
#61=VECTOR('',#60,1.0);
#62=LINE('',#31,#61);
#63=EDGE_CURVE('E2',#41,#42,#62,.T.);
/* Edge 3: P2 -> P3 (vertical, intersects E1 in seam-gap region)
   Defect: This edge runs nearly parallel to E1 but offset by ~0.05 in space.
   Their intersection point falls in the seam-gap where tolerance filtering
   at line 1645 (OK1, OK2 tests) fails to detect the crossing. */
#70=DIRECTION('',(0.0,0.0,-1.0));
#71=VECTOR('',#70,1.0);
#72=LINE('',#32,#71);
#73=EDGE_CURVE('E3',#42,#43,#72,.T.);
/* Edge 4: P3 -> P0 (diagonal closing the loop) */
#80=DIRECTION('',(0.7071067811865475,-0.7071067811865475,0.0));
#81=VECTOR('',#80,1.0);
#82=LINE('',#33,#81);
#83=EDGE_CURVE('E4',#43,#40,#82,.T.);
/* Closed wire loop: P0->P1->P2->P3->P0 */
#90=ORIENTED_EDGE('',*,*,#53,.T.);
#91=ORIENTED_EDGE('',*,*,#63,.T.);
#92=ORIENTED_EDGE('',*,*,#73,.T.);
#93=ORIENTED_EDGE('',*,*,#83,.T.);
#94=EDGE_LOOP('',(#90,#91,#92,#93));
#95=FACE_OUTER_BOUND('',#94,.T.);
#96=ADVANCED_FACE('',(#95),#24,.T.);
#100=CLOSED_SHELL('',(#96));
/* PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi105','Twi105','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#100));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
