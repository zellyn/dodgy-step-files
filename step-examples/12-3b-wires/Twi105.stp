ISO-10303-21;
/* Twi105 - ShapeAnalysis_Wire.CheckIntersectingEdges vertex tolerance filtering
   Defect: CheckIntersectingEdges at line 1563 detects non-adjacent edge
   intersections. The implementation uses vertex tolerance to classify whether
   an intersection point is "close enough" to a vertex. When intersection point
   lies in spatial gap created by seam-edge mapping, tolerance filtering
   (comparing against vertexTolers) misses the intersection entirely.
   Non-adjacent edges with small spatial gap fail intersection detection. */
HEADER;
FILE_DESCRIPTION(('Twi105 - CheckIntersectingEdges misses seam-gap intersection'),'2;1');
FILE_NAME('Twi105.stp','2026-06-15T00:00:00',('auto-generated'),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
