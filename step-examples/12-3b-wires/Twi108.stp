ISO-10303-21;
/* Twi108 - ShapeFix_Wire.FixGaps3d 3D-gap repair
 * Defect: Wire with adjacent edges that don't meet exactly (vertex-tolerance
 * ball-overlap but distance > Confusion threshold). FixGaps3d must bridge these
 * via vertex repositioning or edge parameter adjustment at the connection points. */
HEADER;
FILE_DESCRIPTION(('Twi108 - FixGaps3d 3D gap repair across vertices'),'2;1');
FILE_NAME('Twi108.stp','2026-06-15T00:00:00',('cad-research-suite'),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Plane for geometry */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=PLANE('',#23);
/* Four vertices with deliberate gaps between adjacent edges */
#30=CARTESIAN_POINT('P0',(0.0,0.0,0.0));
#31=CARTESIAN_POINT('P1',(10.0,0.0,0.0));
#32=CARTESIAN_POINT('P2',(10.0,10.0,0.05));
#33=CARTESIAN_POINT('P3',(0.0,10.0,0.0));
#40=VERTEX_POINT('',#30);
#41=VERTEX_POINT('',#31);
#42=VERTEX_POINT('',#32);
#43=VERTEX_POINT('',#33);
/* Edge 1: P0 -> P1 */
#50=DIRECTION('',(1.0,0.0,0.0));
#51=VECTOR('',#50,1.0);
#52=LINE('',#30,#51);
#53=EDGE_CURVE('E1',#40,#41,#52,.T.);
/* Edge 2: P1 -> P2
   Defect: P1 end of E2 curve at (10,0,0) but vertices connected at
   P1=(10,0,0.0) and P2=(10,10,0.05) with 0.05 unit gap in Z.
   This exceeds Confusion but within vertex tolerance balls. */
#60=DIRECTION('',(0.0,1.0,0.0));
#61=VECTOR('',#60,1.0);
#62=LINE('',#31,#61);
#63=EDGE_CURVE('E2',#41,#42,#62,.T.);
/* Edge 3: P2 -> P3
   Defect: Gap between end of E2 (nominal at P2) and start of E3.
   Z coordinate jumps from 0.05 to 0.0 */
#70=DIRECTION('',(-1.0,0.0,0.0));
#71=VECTOR('',#70,1.0);
#72=LINE('',#32,#71);
#73=EDGE_CURVE('E3',#42,#43,#72,.T.);
/* Edge 4: P3 -> P0 */
#80=DIRECTION('',(0.0,-1.0,0.0));
#81=VECTOR('',#80,1.0);
#82=LINE('',#33,#81);
#83=EDGE_CURVE('E4',#43,#40,#82,.T.);
/* Closed wire loop with 3D gaps */
#90=ORIENTED_EDGE('',*,*,#53,.T.);
#91=ORIENTED_EDGE('',*,*,#63,.T.);
#92=ORIENTED_EDGE('',*,*,#73,.T.);
#93=ORIENTED_EDGE('',*,*,#83,.T.);
#94=EDGE_LOOP('',(#90,#91,#92,#93));
#95=FACE_OUTER_BOUND('',#94,.T.);
#96=ADVANCED_FACE('',(#95),#24,.T.);
#100=OPEN_SHELL('',(#96));
/* PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi108','Twi108','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#100));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
