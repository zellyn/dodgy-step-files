ISO-10303-21;
/* Twi160: Single ADVANCED_FACE on PLANE in CLOSED_SHELL; outer EDGE_LOOP has 3 LINE edges forming near-closed triangle; V1=(10,0,0) and V2'=(10,0,5e-8) are 5e-8 apart — below Confusion; E0 LINE (0,0,0)→(10,0,0), E1 LINE (10,0,0)→(5,10,0), E2 LINE (5,10,0)→(10,0,5e-8) — ends at near-coincident V2'; micro-gap of 5e-8 between V2' and V1 IS the defect; FixLacking inserts degenerate edge but wrong direction; dist(V1,V2') < Confusion IS the mechanism; EDGE_LOOP IS wired into FACE_OUTER_BOUND → ADVANCED_FACE in CLOSED_SHELL — never orphaned */
HEADER;
FILE_DESCRIPTION(('Twi160'),'2;1');
