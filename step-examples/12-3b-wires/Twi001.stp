ISO-10303-21;
/* Twi001 - Empty edge_list in EDGE_LOOP
 * Defect: EDGE_LOOP declared with an empty edge aggregate (#62=EDGE_LOOP('',()))
 * referenced from FACE_OUTER_BOUND of an ADVANCED_FACE. Translator must reject
 * the loop with a diagnostic and not propagate a null wire to the parent face;
 * bare reader crashed before guards were added (StepToTopoDS_TranslateEdgeLoop
 * .cxx:251-256; RWStepShape_RWEdgeLoop.cxx:114). */
HEADER;
FILE_DESCRIPTION(('Twi001 test case','Empty edge_list in EDGE_LOOP'),'2;1');
FILE_NAME('Twi001.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Defect: EDGE_LOOP with empty edge aggregate - no ORIENTED_EDGEs at all */
#62=EDGE_LOOP('',());
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#20,.T.);
ENDSEC;
END-ISO-10303-21;
