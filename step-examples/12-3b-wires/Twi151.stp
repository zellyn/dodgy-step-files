ISO-10303-21;
/* Twi151 - ShapeFix_Wire.FixSelfIntersectingEdge cusp-cusp
 * Defect: single edge with a cusp (zero-derivative point) coincidence;
 * FixSelfIntersectingEdge tries to split at cusp but the parameter is undefined
 * due to the degenerate nature of the singularity.
 */
HEADER;
FILE_DESCRIPTION(('Twi151 test case','ShapeFix_Wire.FixSelfIntersectingEdge cusp-cusp'),'2;1');
FILE_NAME('Twi151.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);

/* Plane containing the wire */
#20=PLANE('',#13);

/* Wire with a self-intersecting edge that has a cusp.
   A parabolic curve y=x^2 from x=-2 to x=2 forms a cusp at x=0 when traced
   back and forth, or equivalently, a curve with zero derivative at its apex. */

#100=CARTESIAN_POINT('',(-2.0,4.0,0.0));
#101=VERTEX_POINT('',#100);

#102=CARTESIAN_POINT('',(0.0,0.0,0.0));
#103=VERTEX_POINT('',#102);

#104=CARTESIAN_POINT('',(2.0,4.0,0.0));
#105=VERTEX_POINT('',#104);

#106=CARTESIAN_POINT('',(1.0,5.0,0.0));
#107=VERTEX_POINT('',#106);

/* Edge 1: B-spline curve with cusp at parameter t where derivative is zero.
   Approximated as a circle/parabolic arc from (-2,4) through (0,0) to (2,4) */
#120=CARTESIAN_POINT('',(-2.0,4.0,0.0));
#121=CARTESIAN_POINT('',(-1.0,0.5,0.0));
#122=CARTESIAN_POINT('',(0.0,-0.5,0.0));
#123=CARTESIAN_POINT('',(1.0,0.5,0.0));
#124=CARTESIAN_POINT('',(2.0,4.0,0.0));
#125=VECTOR('',(1.0,0.0,0.0));
#126=VECTOR('',(1.0,0.0,0.0));
#130=B_SPLINE_CURVE_WITH_KNOTS('',3,(#120,#121,#122,#123,#124),.UNSPECIFIED.,.F.,.F.,(4,1,4),(0.0,0.5,1.0),.UNSPECIFIED.);
#131=EDGE_CURVE('',#101,#105,#130,.T.);

/* Edge 2: from (2,4) to (1,5) */
#132=DIRECTION('',(-0.707106781186547,0.707106781186547,0.0));
#133=LINE('',#104,#132);
#134=EDGE_CURVE('',#105,#107,#133,.T.);

/* Edge 3: from (1,5) back to (-2,4) */
#135=DIRECTION('',(-1.0,-0.333333333333333,0.0));
#136=LINE('',#106,#135);
#137=EDGE_CURVE('',#107,#101,#136,.T.);

/* Edge loop with self-intersecting cusp edge */
#140=ORIENTED_EDGE('',*,*,#131,.T.);
#141=ORIENTED_EDGE('',*,*,#134,.T.);
#142=ORIENTED_EDGE('',*,*,#137,.T.);
#143=EDGE_LOOP('',(#140,#141,#142));
#144=FACE_OUTER_BOUND('',#143,.T.);
#145=ADVANCED_FACE('',(#144),#20,.T.);
#8000=OPEN_SHELL('',(#145));

/* PRODUCT CHAIN - Mandatory */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi151','Twi151','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#8000));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
