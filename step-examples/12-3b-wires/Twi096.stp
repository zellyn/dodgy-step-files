ISO-10303-21;
/* Twi096 - Figure-eight wire collapsed on read
 * Defect: 8-edge wire visiting one vertex twice (figure-eight); reader collapses to a 6-edge simple cycle */
HEADER;
FILE_DESCRIPTION(('Twi096 - Wire with internal cross-loop translates incorrectly','Figure-eight wire collapsed on read'),'2;1');
FILE_NAME('Twi096.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('A',(0.0,0.0,0.0));#11=VERTEX_POINT('',#10);
#12=CARTESIAN_POINT('B',(1.0,0.0,0.0));#13=VERTEX_POINT('shared',#12);
#14=CARTESIAN_POINT('C',(2.0,1.0,0.0));#15=VERTEX_POINT('',#14);
#16=CARTESIAN_POINT('D',(1.0,2.0,0.0));#17=VERTEX_POINT('',#16);
#18=CARTESIAN_POINT('E',(0.0,2.0,0.0));#19=VERTEX_POINT('',#18);
#20=CARTESIAN_POINT('F',(-1.0,1.0,0.0));#21=VERTEX_POINT('',#20);
/* Edges visiting B twice -- forming a figure-eight at B */
#30=DIRECTION('',(1.0,0.0,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#10,#31);
#33=EDGE_CURVE('A_to_B',#11,#13,#32,.T.);
#34=DIRECTION('',(0.7071067811865475,0.7071067811865475,0.0));#35=VECTOR('',#34,1.41);#36=LINE('',#12,#35);
#37=EDGE_CURVE('B_to_C',#13,#15,#36,.T.);
#38=DIRECTION('',(-0.7071067811865475,0.7071067811865475,0.0));#39=VECTOR('',#38,1.41);#40=LINE('',#14,#39);
#41=EDGE_CURVE('C_to_D',#15,#17,#40,.T.);
#42=DIRECTION('',(0.0,-1.0,0.0));#43=VECTOR('',#42,2.0);#44=LINE('',#16,#43);
#45=EDGE_CURVE('D_to_B_again',#17,#13,#44,.T.);
#46=DIRECTION('',(-0.7071067811865475,0.7071067811865475,0.0));#47=VECTOR('',#46,1.41);#48=LINE('',#12,#47);
#49=EDGE_CURVE('B_to_E',#13,#19,#48,.T.);
ENDSEC;
END-ISO-10303-21;
