ISO-10303-21;
/* Twi216 — ShapeFix_Wire.FixDegenerated removal-cascade
 * Defect: Wire with multiple degenerate edges. FixDegenerated removes them
 * sequentially but removal changes wire's vertex map, invalidating subsequent
 * removals and producing inconsistent topology. */
HEADER;
FILE_DESCRIPTION(('Twi216 test case','FixDegenerated removal-cascade'),'2;1');
FILE_NAME('Twi216.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Surface: plane */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
/* Normal edge 1: (0,0) → (5,0) */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=VERTEX_POINT('',#20);
#22=CARTESIAN_POINT('',(5.0,0.0,0.0));
#23=VERTEX_POINT('',#22);
/* Degenerate edge 1: (5,0) → (5,0) [zero-length] */
#24=CARTESIAN_POINT('',(5.0,0.0,0.0));
#25=VERTEX_POINT('',#24);
#26=CARTESIAN_POINT('',(5.0,0.0,0.0));
#27=VERTEX_POINT('',#26);
/* Normal edge 2: (5,0) → (10,0) */
#28=CARTESIAN_POINT('',(10.0,0.0,0.0));
#29=VERTEX_POINT('',#28);
/* Degenerate edge 2: (10,0) → (10,0) [zero-length] */
#30=CARTESIAN_POINT('',(10.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(10.0,0.0,0.0));
#33=VERTEX_POINT('',#32);
/* Normal edge 3: (10,0) → (15,0) */
#34=CARTESIAN_POINT('',(15.0,0.0,0.0));
#35=VERTEX_POINT('',#34);
/* Curves */
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#20,#41);
#43=TRIMMED_CURVE('',#42,.T.,#20,.T.,.T.,#22);
#44=EDGE_CURVE('',#21,#23,#43,.T.);
/* Degenerate curve 1: point (5,0) with null parametrization */
#45=CARTESIAN_POINT('',(5.0,0.0,0.0));
#46=POINT('',#45);
#47=EDGE_CURVE('',#25,#27,#46,.T.);
/* Normal curve 2 */
#48=LINE('',#24,#41);
#49=TRIMMED_CURVE('',#48,.T.,#24,.T.,.T.,#28);
#50=EDGE_CURVE('',#25,#29,#49,.T.);
/* Degenerate curve 2: point (10,0) with null parametrization */
#51=CARTESIAN_POINT('',(10.0,0.0,0.0));
#52=POINT('',#51);
#53=EDGE_CURVE('',#31,#33,#52,.T.);
/* Normal curve 3 */
#54=LINE('',#30,#41);
#55=TRIMMED_CURVE('',#54,.T.,#30,.T.,.T.,#34);
#56=EDGE_CURVE('',#31,#35,#55,.T.);
/* Wire: alternating normal→degenerate→normal→degenerate→normal
   Edge sequence: normal(#44) → degen(#47) → normal(#50) → degen(#53) → normal(#56) */
#60=ORIENTED_EDGE('',*,*,#44,.T.);
#61=ORIENTED_EDGE('',*,*,#47,.T.);
#62=ORIENTED_EDGE('',*,*,#50,.T.);
#63=ORIENTED_EDGE('',*,*,#53,.T.);
#64=ORIENTED_EDGE('',*,*,#56,.T.);
#70=EDGE_LOOP('',(#60,#61,#62,#63,#64));
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi216','Twi216','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#70));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
