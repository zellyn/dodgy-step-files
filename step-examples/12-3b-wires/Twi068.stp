ISO-10303-21;
/* Twi068 - Wire 3D-gap analysis must enumerate all gaps, not just the first
 * Four-edge open polyline wire. Junction (1,2): edge1 ends at (1.0,0,0), edge2
 * starts at (1.05,0,0) -- gap 0.05. Junction (2,3): edge2 ends at (2.0,0.0,0),
 * edge3 starts at (2.07,0.0,0) -- gap 0.07. Junction (3,4): edge3 ends at
 * (2.0,1.0,0), edge4 starts at (2.0,1.06,0) -- gap 0.06. All gaps are above
 * a typical 1.0e-2 tolerance and each must be reported. */
HEADER;
FILE_DESCRIPTION(('Twi068 test case','Wire with multiple 3D gaps -- analyzer must enumerate every gap'),'2;1');
FILE_NAME('Twi068.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Eight distinct vertex points -- 4 edges, each with its own start/end vertex,
 * so the head-tail mismatches at junctions become 3D gaps. */
#10=CARTESIAN_POINT('e1_start',(0.0,0.0,0.0));#11=VERTEX_POINT('',#10);
#12=CARTESIAN_POINT('e1_end',(1.0,0.0,0.0));#13=VERTEX_POINT('',#12);
#14=CARTESIAN_POINT('e2_start_gap_005',(1.05,0.0,0.0));#15=VERTEX_POINT('',#14);
#16=CARTESIAN_POINT('e2_end',(2.0,0.0,0.0));#17=VERTEX_POINT('',#16);
#18=CARTESIAN_POINT('e3_start_gap_007',(2.07,0.0,0.0));#19=VERTEX_POINT('',#18);
#20=CARTESIAN_POINT('e3_end',(2.0,1.0,0.0));#21=VERTEX_POINT('',#20);
#22=CARTESIAN_POINT('e4_start_gap_006',(2.0,1.06,0.0));#23=VERTEX_POINT('',#22);
#24=CARTESIAN_POINT('e4_end',(2.0,2.0,0.0));#25=VERTEX_POINT('',#24);
#30=DIRECTION('',(1.0,0.0,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#10,#31);
#33=EDGE_CURVE('edge1',#11,#13,#32,.T.);
#34=DIRECTION('',(1.0,0.0,0.0));#35=VECTOR('',#34,1.0);#36=LINE('',#14,#35);
#37=EDGE_CURVE('edge2',#15,#17,#36,.T.);
#38=DIRECTION('',(0.0,1.0,0.0));#39=VECTOR('',#38,1.0);#40=LINE('',#18,#39);
#41=EDGE_CURVE('edge3',#19,#21,#40,.T.);
#42=DIRECTION('',(0.0,1.0,0.0));#43=VECTOR('',#42,1.0);#44=LINE('',#22,#43);
#45=EDGE_CURVE('edge4',#23,#25,#44,.T.);
#50=ORIENTED_EDGE('',*,*,#33,.T.);
#51=ORIENTED_EDGE('',*,*,#37,.T.);
#52=ORIENTED_EDGE('',*,*,#41,.T.);
#53=ORIENTED_EDGE('',*,*,#45,.T.);
#54=EDGE_LOOP('multi_gap_wire',(#50,#51,#52,#53));
ENDSEC;
END-ISO-10303-21;
