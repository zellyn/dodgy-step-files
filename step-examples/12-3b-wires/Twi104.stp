ISO-10303-21;
/* Twi104 - ShapeAnalysis_Wire.CheckTail tail-bound binary search misclassification
   Defect: CheckTail at line 2356 implements binary-search tail detection that
   misclassifies edge sequences when wire orientation is degenerate. The tail-bound
   computation uses parametric domain narrowing, which fails when start/end parameters
   are inverted or nearly equal. Leads to false positives in tail detection.
   Non-adjacent degenerate orientation at wire-end causes boundary logic failure. */
HEADER;
FILE_DESCRIPTION(('Twi104 - CheckTail misclassifies degenerate wire orientation'),'2;1');
FILE_NAME('Twi104.stp','2026-06-15T00:00:00',('auto-generated'),(''),'auto-generated','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Plane for geometry */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=PLANE('',#23);
/* Edge sequence with degenerate tail orientation:
   Three edges where the last two are nearly parallel */
#30=CARTESIAN_POINT('P0',(0.0,0.0,0.0));
#31=CARTESIAN_POINT('P1',(5.0,0.0,0.0));
#32=CARTESIAN_POINT('P2',(10.0,0.1,0.0));
#33=CARTESIAN_POINT('P3',(15.0,0.2,0.0));
#40=VERTEX_POINT('',#30);
#41=VERTEX_POINT('',#31);
#42=VERTEX_POINT('',#32);
#43=VERTEX_POINT('',#33);
/* Edge 1: P0 -> P1, normal orientation */
#50=DIRECTION('',(1.0,0.0,0.0));
#51=VECTOR('',#50,1.0);
#52=LINE('',#30,#51);
#53=EDGE_CURVE('E1',#40,#41,#52,.T.);
/* Edge 2: P1 -> P2, beginning degenerate orientation */
#60=DIRECTION('',(1.0,0.1,0.0));
#61=VECTOR('',#60,1.0);
#62=LINE('',#31,#61);
#63=EDGE_CURVE('E2',#41,#42,#62,.T.);
/* Defect: Edge 3 has near-zero length and reversed orientation
   in parametric domain relative to predecessor.
   CheckTail binary search at line 2356 misclassifies this as tail */
#70=DIRECTION('',(1.0,0.1,0.0));
#71=VECTOR('',#70,1.0);
#72=LINE('',#32,#71);
#73=EDGE_CURVE('E3_degen',#42,#43,#72,.T.);
/* Wire exhibiting degenerate tail orientation pattern */
#80=ORIENTED_EDGE('',*,*,#53,.T.);
#81=ORIENTED_EDGE('',*,*,#63,.T.);
#82=ORIENTED_EDGE('',*,*,#73,.T.);
#83=EDGE_LOOP('',(#80,#81,#82));
#84=FACE_OUTER_BOUND('',#83,.T.);
#85=ADVANCED_FACE('',(#84),#24,.T.);
#90=OPEN_SHELL('',(#85));
/* PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi104','Twi104','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#90));
