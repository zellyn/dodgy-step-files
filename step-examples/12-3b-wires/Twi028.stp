ISO-10303-21;
/* Twi028 - Disordered edges on torus - wire-reorder triggers no replacement
 * Defect: A face whose wire was reordered during shape-healing was not
 * replaced in the resulting shape, so the fix was lost - outer/inner trees
 * still pointed to the unreordered wire. The on-disk STEP file looks fine,
 * but downstream the un-fixed face survives. Reader / shape-healer must
 * always replace face after wire reordering, even if no other fix occurred
 * (Mantis 0021317; G080/G104). */
HEADER;
FILE_DESCRIPTION(('Twi028 test case','Disordered edges on torus - reorder no replacement'),'2;1');
FILE_NAME('Twi028.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=TOROIDAL_SURFACE('',#13,10.0,2.0);
/* Vertices on the torus */
#30=CARTESIAN_POINT('',(12.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(0.0,12.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(-12.0,0.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(0.0,-12.0,0.0));
#37=VERTEX_POINT('',#36);
/* 3D arcs */
#40=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#41=CIRCLE('',#40,10.0);
#42=EDGE_CURVE('',#31,#33,#41,.T.);
#43=EDGE_CURVE('',#33,#35,#41,.T.);
#44=EDGE_CURVE('',#35,#37,#41,.T.);
#45=EDGE_CURVE('',#37,#31,#41,.T.);
#50=ORIENTED_EDGE('',*,*,#42,.T.);
#51=ORIENTED_EDGE('',*,*,#43,.T.);
#52=ORIENTED_EDGE('',*,*,#44,.T.);
#53=ORIENTED_EDGE('',*,*,#45,.T.);
/* Defect: edges listed out of order: e1, e3, e2, e4. After FixReorder runs
 * the wire is reordered correctly but historically the parent FACE was not
 * REPLACED in the parent shell - so the fix did not stick. */
#60=EDGE_LOOP('',(#50,#52,#51,#53));
#61=FACE_OUTER_BOUND('',#60,.T.);
#62=ADVANCED_FACE('',(#61),#20,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi028','Twi028','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#62));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
