ISO-10303-21;
/* Twi054 - Notched wire: short edge forms a triangular notch
 * Defect: a wire contains a sequence of three edges where the middle
 * edge is short and forms a sharp triangular notch with its neighbors.
 * The notch is not a feature; it should be flattened or removed. */
HEADER;
FILE_DESCRIPTION(('Twi054 test case','Notched wire: short edge forms a triangular notch'),'2;1');
FILE_NAME('Twi054.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Wire with a triangular notch: edges 50,51 pass close to each other */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=VERTEX_POINT('',#20);
#22=CARTESIAN_POINT('',(5.0,0.0,0.0));
