ISO-10303-21;
/* Twi226 - ShapeFix_Wire.FixIntersectingEdges with-edge-on-surface-boundary
 * Defect: Edge that ends exactly on the surface trim boundary. When
 * FixIntersectingEdges processes edges that touch the trim boundary, its
 * algorithm for identifying and removing intersection points fails because
 * the intersection detection treats boundary points as interior intersections.
 * The repair logic produces inconsistent topology: either missing edges or
 * spurious vertex insertions at the boundary.
 */
HEADER;
FILE_DESCRIPTION(('Twi226 test case','FixIntersectingEdges with-edge-on-surface-boundary — trim boundary intersection'),'2;1');
FILE_NAME('Twi226.stp','2026-06-15T00:00:00',('zellyn@gmail.com'),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi226','Twi226','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=DIRECTION('',(0.0,0.0,1.0));
#102=DIRECTION('',(1.0,0.0,0.0));
#103=AXIS2_PLACEMENT_3D('',#100,#101,#102);
#104=PLANE('',#103);
/* Wire on trimmed surface where one edge terminates at the surface boundary
   Surface domain: u ∈ [0, 10], v ∈ [0, 10]
   Wire: E1 normal, E2 touches boundary at u=10, E3 crosses boundary intersection
   FixIntersectingEdges will see E2's endpoint on the boundary and may
   misclassify it as an intersection needing repair, producing inconsistent topology.
*/
#110=CARTESIAN_POINT('',(0.0,0.0,0.0));
#111=CARTESIAN_POINT('',(5.0,0.0,0.0));
#112=CARTESIAN_POINT('',(10.0,5.0,0.0));
#113=CARTESIAN_POINT('',(9.9,5.1,0.0));
#114=CARTESIAN_POINT('',(0.0,0.0,0.0));
/* Create vertices */
#120=VERTEX_POINT('',#110);
#121=VERTEX_POINT('',#111);
#122=VERTEX_POINT('',#112);
#123=VERTEX_POINT('',#113);
/* Edge1: normal interior edge from (0,0) to (5,0) */
#130=LINE('',#110,#102);
#131=EDGE_CURVE('',#120,#121,#130,.T.);
/* Edge2: edge approaching boundary, from (5,0) to (10,5)
   This edge's endpoint is exactly on the surface trim at u=10 */
#132=DIRECTION('',(1.0,1.0,0.0));
#133=LINE('',#111,#132);
#134=EDGE_CURVE('',#121,#122,#133,.T.);
/* Edge3: edge touching boundary then exiting, from (10,5) to (9.9,5.1)
   This creates an intersection detection problem: E3 starts exactly where
   E2 ends (on boundary) and appears to cross the boundary intersection */
#135=DIRECTION('',(-0.1,0.1,0.0));
#136=LINE('',#112,#135);
#137=EDGE_CURVE('',#122,#123,#136,.T.);
/* Edge4: close wire back to start from (9.9,5.1) to (0,0) */
#138=DIRECTION('',(-1.0,-0.5,0.0));
#139=LINE('',#113,#138);
#140=EDGE_CURVE('',#123,#120,#139,.T.);
/* Oriented edges */
#200=ORIENTED_EDGE('',*,*,#131,.T.);
#201=ORIENTED_EDGE('',*,*,#134,.T.);
#202=ORIENTED_EDGE('',*,*,#137,.T.);
#203=ORIENTED_EDGE('',*,*,#140,.T.);
/* Edge loop with boundary-touching edges */
#210=EDGE_LOOP('',(#200,#201,#202,#203));
/* Face outer bound on trimmed plane */
#220=FACE_OUTER_BOUND('',#210,.T.);
#221=ADVANCED_FACE('',(#220),#104,.T.);
/* Shell and manifold representation */
#250=CLOSED_SHELL('',(#221));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#250));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
