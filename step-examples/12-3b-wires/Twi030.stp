ISO-10303-21;
/* Twi030 - Degenerate edge re-encountered for multiple faces
 * Defect: A degenerate edge bridges a singular row that is shared by adjacent
 * faces; translator processes it once per face, building it again with
 * potentially divergent vertex tolerance. Here two SPHERICAL_SURFACE faces
 * touching the north pole each declare their own copy of an apex-bridge
 * degenerate edge - reader should cache and reuse the translated degenerate
 * edge across faces (StepToTopoDS_TranslateEdge.cxx:212-215). */
HEADER;
FILE_DESCRIPTION(('Twi030 test case','Degenerate edge re-encountered across faces'),'2;1');
FILE_NAME('Twi030.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=SPHERICAL_SURFACE('',#13,10.0);
/* North pole vertex (common between adjacent faces) */
#21=CARTESIAN_POINT('',(0.0,0.0,10.0));
#22=VERTEX_POINT('',#21);
/* Equator vertices */
#30=CARTESIAN_POINT('',(10.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(-10.0,0.0,0.0));
#33=VERTEX_POINT('',#32);
/* Two meridians */
#40=DIRECTION('',(-0.7071067811865475,0.0,0.7071067811865475));
#41=VECTOR('',#40,1.0);
#42=LINE('',#30,#41);
#43=EDGE_CURVE('',#31,#22,#42,.T.);
#44=DIRECTION('',(0.7071067811865475,0.0,0.7071067811865475));
#45=VECTOR('',#44,1.0);
#46=LINE('',#32,#45);
#47=EDGE_CURVE('',#33,#22,#46,.T.);
/* Defect: TWO separate degenerate edges at the SAME pole (both zero-length,
 * both at #22) - the second face should reuse the first instance. */
#50=DIRECTION('',(1.0,0.0,0.0));
#51=VECTOR('',#50,1.0E-12);
#52=LINE('',#21,#51);
#53=EDGE_CURVE('',#22,#22,#52,.T.);
#54=EDGE_CURVE('',#22,#22,#52,.T.);
#60=ORIENTED_EDGE('',*,*,#43,.T.);
#61=ORIENTED_EDGE('',*,*,#53,.T.);
#62=ORIENTED_EDGE('',*,*,#43,.F.);
#63=EDGE_LOOP('',(#60,#61,#62));
#64=FACE_OUTER_BOUND('',#63,.T.);
#65=ADVANCED_FACE('',(#64),#20,.T.);
#70=ORIENTED_EDGE('',*,*,#47,.T.);
#71=ORIENTED_EDGE('',*,*,#54,.T.);
#72=ORIENTED_EDGE('',*,*,#47,.F.);
#73=EDGE_LOOP('',(#70,#71,#72));
#74=FACE_OUTER_BOUND('',#73,.T.);
#75=ADVANCED_FACE('',(#74),#20,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi030','Twi030','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#65,#75));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
