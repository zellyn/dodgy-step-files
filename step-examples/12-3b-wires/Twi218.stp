ISO-10303-21;
/* Twi218 - ShapeAnalysis_Wire.CheckShapeConnect with-degenerate-vertex
 * Defect: Wire's start or end vertex is degenerate (zero-radius circle or
 * point-like geometry). CheckShapeConnect compares vertices using coordinates
 * from BRep_Tool::Pnt(vertex), but for degenerate vertices, this coordinate
 * may not meaningfully represent topology. The checker uses coordinate-based
 * logic rather than topological identity, causing false positives or misses
 * when degenerate endpoints are involved.
 * Reproduces: ShapeAnalysis_Wire.CheckShapeConnect_at2117 branches. */
HEADER;
FILE_DESCRIPTION(('Twi218 test case','Degenerate vertex shape connectivity check'),'2;1');
FILE_NAME('Twi218.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* First edge: normal line from (0,0,0) to (5,0,0) */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=CARTESIAN_POINT('',(5.0,0.0,0.0));
#32=CARTESIAN_POINT('',(0.0,0.0,0.0));
#33=CARTESIAN_POINT('',(5.0,0.0,0.0));
#34=LINE('',#32,(DIRECTION('',(1.0,0.0,0.0)),1.0));
#40=VERTEX_POINT('',#30);
#41=VERTEX_POINT('',#31);
#50=EDGE_CURVE('',#40,#41,#34,.T.);
#51=ORIENTED_EDGE('',*,*,#50,.T.);
/* Second edge: degenerate circle at (5,0,0) (zero radius = point)
 * This creates a degenerate vertex at the seam. */
#60=AXIS2_PLACEMENT_3D('',(5.0,0.0,0.0),#11,#12);
#61=CIRCLE('',#60,0.0);
#70=VERTEX_POINT('',#33);
#71=VERTEX_POINT('',#33);
#80=EDGE_CURVE('',#41,#70,#61,.T.);
#81=ORIENTED_EDGE('',*,*,#80,.T.);
/* Wire with degenerate endpoint */
#90=EDGE_LOOP('',(#51,#81));
#91=FACE_OUTER_BOUND('',#90,.T.);
#92=ADVANCED_FACE('',(#91),#20,.T.);
/* Product chain (v3.2 schema) */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi218','Twi218','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('shell',(#92));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
