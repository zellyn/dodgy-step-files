ISO-10303-21;
/* Twi107 - ShapeFix_Wire.FixReorder mode-cascade
 * Defect: Wire with edges in wrong order; FixReorder fails (ReorderOK=false)
 * and the failure cascades to suppress subsequent FixSelfIntersection/FixSmall/
 * FixConnected fixes (SF_Perform_002, SF_Perform_003, SF_Perform_004 at lines
 * 320, 331, 355 suppress downstream fixes when ReorderOK==false). */
HEADER;
FILE_DESCRIPTION(('Twi107 - FixReorder mode-cascade suppresses downstream fixes'),'2;1');
FILE_NAME('Twi107.stp','2026-06-15T00:00:00',('cad-research-suite'),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Plane for geometry */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=DIRECTION('',(0.0,0.0,1.0));
#22=DIRECTION('',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=PLANE('',#23);
/* Five vertices in out-of-order wire configuration */
#30=CARTESIAN_POINT('P0',(0.0,0.0,0.0));
#31=CARTESIAN_POINT('P1',(10.0,0.0,0.0));
#32=CARTESIAN_POINT('P2',(10.0,10.0,0.0));
#33=CARTESIAN_POINT('P3',(5.0,15.0,0.0));
#34=CARTESIAN_POINT('P4',(0.0,10.0,0.0));
#40=VERTEX_POINT('',#30);
#41=VERTEX_POINT('',#31);
#42=VERTEX_POINT('',#32);
#43=VERTEX_POINT('',#33);
#44=VERTEX_POINT('',#34);
/* Defect: edges will be added in wrong order to EDGE_LOOP
   Intended: P0->P1->P2->P3->P4->P0
   Actual order in loop: P0->P2->P1->P3->P4->P0 (P1,P2 swapped)
   This will break FixReorder which cannot reorder to valid sequence */
/* Edge 0: P0 -> P1 */
#50=DIRECTION('',(1.0,0.0,0.0));
#51=VECTOR('',#50,1.0);
#52=LINE('',#30,#51);
#53=EDGE_CURVE('E0',#40,#41,#52,.T.);
/* Edge 1: P1 -> P2 */
#60=DIRECTION('',(0.0,1.0,0.0));
#61=VECTOR('',#60,1.0);
#62=LINE('',#31,#61);
#63=EDGE_CURVE('E1',#41,#42,#62,.T.);
/* Edge 2: P2 -> P3 */
#70=DIRECTION('',(-0.7071067811865475,0.7071067811865475,0.0));
#71=VECTOR('',#70,1.0);
#72=LINE('',#32,#71);
#73=EDGE_CURVE('E2',#42,#43,#72,.T.);
/* Edge 3: P3 -> P4 */
#80=DIRECTION('',(-0.7071067811865475,-0.7071067811865475,0.0));
#81=VECTOR('',#80,1.0);
#82=LINE('',#33,#81);
#83=EDGE_CURVE('E3',#43,#44,#82,.T.);
/* Edge 4: P4 -> P0 */
#90=DIRECTION('',(0.0,-1.0,0.0));
#91=VECTOR('',#90,1.0);
#92=LINE('',#44,#91);
#93=EDGE_CURVE('E4',#44,#40,#92,.T.);
/* Wire with edges in wrong order: E0 correct, E2 (should follow E1), E1 (out of place), E3, E4
   This deliberately reordered sequence will cause FixReorder to fail at ReorderOK=false
   and cascade-suppress downstream FixSmall, FixConnected, FixSelfIntersection */
#100=ORIENTED_EDGE('',*,*,#53,.T.);
#101=ORIENTED_EDGE('',*,*,#73,.T.);
#102=ORIENTED_EDGE('',*,*,#63,.T.);
#103=ORIENTED_EDGE('',*,*,#83,.T.);
#104=ORIENTED_EDGE('',*,*,#93,.T.);
#105=EDGE_LOOP('',(#100,#101,#102,#103,#104));
#106=FACE_OUTER_BOUND('',#105,.T.);
#107=ADVANCED_FACE('',(#106),#24,.T.);
#110=OPEN_SHELL('',(#107));
/* PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi107','Twi107','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#110));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
