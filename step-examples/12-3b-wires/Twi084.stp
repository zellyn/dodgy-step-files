ISO-10303-21;
/* Twi084 - Closed-curve edge has different start and end vertices.
 * Defect: EDGE_CURVE references a CIRCLE (closed curve) with
 * edge_start at (1,0,0) and edge_end at (1.5,0,0) - distinct points
 * even though the underlying curve is closed. */
HEADER;
FILE_DESCRIPTION(('Twi084 - Closed-curve edge has different start and end vertex points','Pass C gap-fill'),'2;1');
FILE_NAME('Twi084.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('center',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('start',(1.0,0.0,0.0));
#12=CARTESIAN_POINT('end_NOT_equal_to_start',(1.5,0.0,0.0));
#13=VERTEX_POINT('',#11);
#14=VERTEX_POINT('',#12);
#20=DIRECTION('',(0.0,0.0,1.0));
#21=DIRECTION('',(1.0,0.0,0.0));
#22=AXIS2_PLACEMENT_3D('',#10,#20,#21);
#23=CIRCLE('closed_circle',#22,1.0);
/* Defect: vertices differ but underlying CIRCLE is closed */
#30=EDGE_CURVE('open_circle_edge',#13,#14,#23,.T.);
ENDSEC;
END-ISO-10303-21;
