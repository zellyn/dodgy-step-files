ISO-10303-21;
/* Twi080 - Wire splitting must propagate from underlying edge/curve splits
 * Square face whose right edge has been C0-split mid-span: two sub-edges
 * (V2 -> Vmid) and (Vmid -> V3). The wire therefore contains 5 ORIENTED_EDGEs
 * instead of 4. Vmid is the shared vertex created by the split. */
HEADER;
FILE_DESCRIPTION(('Twi080 test case','Square wire whose right edge is split mid-span; 5 sub-edges instead of 4'),'2;1');
FILE_NAME('Twi080.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
/* Corners + mid-span split vertex on right edge */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));#21=VERTEX_POINT('V1',#20);
#22=CARTESIAN_POINT('',(1.0,0.0,0.0));#23=VERTEX_POINT('V2',#22);
#24=CARTESIAN_POINT('mid_split',(1.0,0.5,0.0));#25=VERTEX_POINT('Vmid_C0_split',#24);
#26=CARTESIAN_POINT('',(1.0,1.0,0.0));#27=VERTEX_POINT('V3',#26);
#28=CARTESIAN_POINT('',(0.0,1.0,0.0));#29=VERTEX_POINT('V4',#28);
/* edge bottom V1->V2 */
#30=DIRECTION('',(1.0,0.0,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#20,#31);
#33=EDGE_CURVE('bottom',#21,#23,#32,.T.);
/* TWO sub-edges along right side: V2->Vmid and Vmid->V3 */
#34=DIRECTION('',(0.0,1.0,0.0));#35=VECTOR('',#34,1.0);#36=LINE('right_lower',#22,#35);
#37=EDGE_CURVE('right_lower_subedge',#23,#25,#36,.T.);
#38=DIRECTION('',(0.0,1.0,0.0));#39=VECTOR('',#38,1.0);#40=LINE('right_upper',#24,#39);
#41=EDGE_CURVE('right_upper_subedge',#25,#27,#40,.T.);
/* edge top V3->V4 */
#42=DIRECTION('',(-1.0,0.0,0.0));#43=VECTOR('',#42,1.0);#44=LINE('',#26,#43);
#45=EDGE_CURVE('top',#27,#29,#44,.T.);
/* edge left V4->V1 */
#46=DIRECTION('',(0.0,-1.0,0.0));#47=VECTOR('',#46,1.0);#48=LINE('',#28,#47);
#49=EDGE_CURVE('left',#29,#21,#48,.T.);
#50=ORIENTED_EDGE('',*,*,#33,.T.);
#51=ORIENTED_EDGE('',*,*,#37,.T.);
#52=ORIENTED_EDGE('',*,*,#41,.T.);
#53=ORIENTED_EDGE('',*,*,#45,.T.);
#54=ORIENTED_EDGE('',*,*,#49,.T.);
#55=EDGE_LOOP('5_sub_edges_post_split',(#50,#51,#52,#53,#54));
#56=FACE_OUTER_BOUND('',#55,.T.);
#57=ADVANCED_FACE('square_with_split_right_edge',(#56),#14,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi080','Twi080','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#57));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
