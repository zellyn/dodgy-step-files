ISO-10303-21;
/* Twi139 - ShapeFix_Wire.FixReorder seed-edge choice
 * Defect: ShapeFix_Wire.FixReorder seed-edge choice
 */
HEADER;
FILE_DESCRIPTION(('Twi139 test case','ShapeFix_Wire.FixReorder seed-edge choice'),'2;1');
FILE_NAME('Twi139.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);

#20=PLANE('',#13);
/* Wire with 5 edges where reorder algorithm picks wrong seed */
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#101=VERTEX_POINT('',#100);
#102=CARTESIAN_POINT('',(1.0,0.0,0.0));
#103=VERTEX_POINT('',#102);
#104=CARTESIAN_POINT('',(1.0,1.0,0.0));
#105=VERTEX_POINT('',#104);
#106=CARTESIAN_POINT('',(0.0,1.0,0.0));
#107=VERTEX_POINT('',#106);
#108=CARTESIAN_POINT('',(0.5,0.5,0.0));
#109=VERTEX_POINT('',#108);

/* Edge 0: (0,0) -> (1,0) */
#110=LINE('',#100,#12);
#111=EDGE_CURVE('',#101,#103,#110,.T.);

/* Edge 1: (1,0) -> (1,1) */
#115=DIRECTION('',(0.0,1.0,0.0));
#116=LINE('',#102,#115);
#117=EDGE_CURVE('',#103,#105,#116,.T.);

/* Edge 2: (1,1) -> (0.5,0.5) - reversed orientation */
#120=CARTESIAN_POINT('',(0.5,0.5,0.0));
#121=DIRECTION('',(0.5,-0.5,0.0));
#122=LINE('',#104,#121);
#123=EDGE_CURVE('',#105,#109,#122,.F.);

/* Edge 3: (0.5,0.5) -> (0,1) */
#125=CARTESIAN_POINT('',(0.0,1.0,0.0));
#126=DIRECTION('',(0.5,0.5,0.0));
#127=LINE('',#108,#126);
#128=EDGE_CURVE('',#109,#107,#127,.F.);

/* Edge 4: (0,1) -> (0,0) */
#130=DIRECTION('',(0.0,-1.0,0.0));
#131=LINE('',#106,#130);
#132=EDGE_CURVE('',#107,#101,#131,.T.);

#140=ORIENTED_EDGE('',*,*,#111,.T.);
#141=ORIENTED_EDGE('',*,*,#117,.T.);
#142=ORIENTED_EDGE('',*,*,#123,.T.);
#143=ORIENTED_EDGE('',*,*,#128,.T.);
#144=ORIENTED_EDGE('',*,*,#132,.T.);
#145=EDGE_LOOP('',(#140,#141,#142,#143,#144));
#146=FACE_OUTER_BOUND('',#145,.T.);
#147=ADVANCED_FACE('',(#146),#20,.T.);
#8000=OPEN_SHELL('',(#147));

/* PRODUCT CHAIN - Mandatory */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi139','Twi139','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#8000));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
