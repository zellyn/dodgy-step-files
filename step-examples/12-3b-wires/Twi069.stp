ISO-10303-21;
/* Twi069 - Wire 2D-gap analysis must enumerate all pcurve gaps
 * Wire of 4 edges on a CYLINDRICAL_SURFACE. Junction 1: edge1 pcurve ends
 * at U=1.0, edge2 pcurve starts at U=1.5 (UV gap 0.5). Junction 3: edge3
 * pcurve ends at U=3.0, edge4 pcurve starts at U=3.4 (UV gap 0.4). Junction
 * 2 has zero pcurve gap. The analyzer must surface gaps at junctions 1 AND 3. */
HEADER;
FILE_DESCRIPTION(('Twi069 test case','Wire with multiple pcurve U-gaps -- analyzer must enumerate every gap'),'2;1');
FILE_NAME('Twi069.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=CYLINDRICAL_SURFACE('',#13,1.0);
/* Five vertex points (3D coincident at junctions, but pcurves disagree) */
#20=CARTESIAN_POINT('',(1.0,0.0,0.0));#21=VERTEX_POINT('V0',#20);
#22=CARTESIAN_POINT('',(0.54,0.84,0.0));#23=VERTEX_POINT('V1',#22);
#24=CARTESIAN_POINT('',(-0.42,0.91,0.0));#25=VERTEX_POINT('V2',#24);
#26=CARTESIAN_POINT('',(-0.99,0.14,0.0));#27=VERTEX_POINT('V3',#26);
#28=CARTESIAN_POINT('',(-0.65,-0.76,0.0));#29=VERTEX_POINT('V4',#28);
/* edge1: pcurve runs U=0.0 -> U=1.0 */
#30=DIRECTION('',(-0.4803146228655844,0.8770962678415017,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#20,#31);
#33=CARTESIAN_POINT('',(0.0,0.0));#34=DIRECTION('',(1.0,0.0));#35=VECTOR('',#34,1.0);
#36=LINE('e1_pc_0_to_1',#33,#35);
#37=DEFINITIONAL_REPRESENTATION('',(#36),#13);
#38=PCURVE('',#14,#37);
#39=SURFACE_CURVE('',#32,(#38),.PCURVE_S1.);
#40=EDGE_CURVE('edge1',#21,#23,#39,.T.);
/* edge2: pcurve runs U=1.5 -> U=2.0 -- 0.5 gap at junction 1 */
#45=DIRECTION('',(-0.9973521339060821,0.0727235930973185,0.0));#46=VECTOR('',#45,1.0);#47=LINE('',#22,#46);
#48=CARTESIAN_POINT('e2_pc_starts_1p5',(1.5,0.0));
#49=DIRECTION('',(1.0,0.0));#50=VECTOR('',#49,0.5);#51=LINE('',#48,#50);
#52=DEFINITIONAL_REPRESENTATION('',(#51),#13);
#53=PCURVE('e2_uv_1p5_to_2p0',#14,#52);
#54=SURFACE_CURVE('',#47,(#53),.PCURVE_S1.);
#55=EDGE_CURVE('edge2',#23,#25,#54,.T.);
/* edge3: pcurve runs U=2.0 -> U=3.0 -- contiguous with edge2 (no gap at junction 2) */
#60=DIRECTION('',(-0.594977892467951,-0.8037420652637233,0.0));#61=VECTOR('',#60,1.0);#62=LINE('',#24,#61);
#63=CARTESIAN_POINT('',(2.0,0.0));#64=DIRECTION('',(1.0,0.0));#65=VECTOR('',#64,1.0);
#66=LINE('e3_pc_2_to_3',#63,#65);
#67=DEFINITIONAL_REPRESENTATION('',(#66),#13);
#68=PCURVE('',#14,#67);
#69=SURFACE_CURVE('',#62,(#68),.PCURVE_S1.);
#70=EDGE_CURVE('edge3',#25,#27,#69,.T.);
/* edge4: pcurve runs U=3.4 -> U=4.4 -- 0.4 gap at junction 3 */
#75=DIRECTION('',(0.353400568718577,-0.9354720936668215,0.0));#76=VECTOR('',#75,1.0);#77=LINE('',#26,#76);
#78=CARTESIAN_POINT('e4_pc_starts_3p4',(3.4,0.0));
#79=DIRECTION('',(1.0,0.0));#80=VECTOR('',#79,1.0);#81=LINE('',#78,#80);
#82=DEFINITIONAL_REPRESENTATION('',(#81),#13);
#83=PCURVE('e4_uv_3p4_to_4p4',#14,#82);
#84=SURFACE_CURVE('',#77,(#83),.PCURVE_S1.);
#85=EDGE_CURVE('edge4',#27,#29,#84,.T.);
#90=ORIENTED_EDGE('',*,*,#40,.T.);
#91=ORIENTED_EDGE('',*,*,#55,.T.);
#92=ORIENTED_EDGE('',*,*,#70,.T.);
#93=ORIENTED_EDGE('',*,*,#85,.T.);
#94=EDGE_LOOP('multi_2d_gap_wire',(#90,#91,#92,#93));
ENDSEC;
END-ISO-10303-21;
