ISO-10303-21;
/* Twi124 - ShapeFix_Wire.FixIntersectingEdges 2.0000001 magic-constant
 * Defect: tolerance scaling uses literal 2.0000001 to allow hairline margin;
 * on a wire with values just above 2.0, scaling can collapse
 */
HEADER;
FILE_DESCRIPTION(('Twi124 test case','ShapeFix_Wire.FixIntersectingEdges 2.0000001 magic-constant'),'2;1');
FILE_NAME('Twi124.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Two edges that intersect at scaled boundary near 2.0 tolerance */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=VERTEX_POINT('',#10);
#12=CARTESIAN_POINT('',(2.0000005,0.0,0.0));
#13=VERTEX_POINT('',#12);
#14=CARTESIAN_POINT('',(0.0,2.0000005,0.0));
#15=VERTEX_POINT('',#14);
#16=CARTESIAN_POINT('',(2.0000005,2.0000005,0.0));
#17=VERTEX_POINT('',#16);
/* First edge: diagonal from origin (0,0) to (2.0000005,2.0000005) */
#20=LINE('',#10,#16);
#21=EDGE_CURVE('',#11,#17,#20,.T.);
/* Second edge: diagonal from (2.0000005,0,0) to (0,2.0000005,0) - crosses first */
#30=LINE('',#12,#14);
#31=EDGE_CURVE('',#13,#15,#30,.T.);
/* Return edges to close wire */
#40=LINE('',#14,#10);
#41=EDGE_CURVE('',#15,#11,#40,.T.);
#50=LINE('',#16,#12);
#51=EDGE_CURVE('',#17,#13,#50,.T.);
/* Wire with crossing edges near 2.0 scaling boundary */
#60=ORIENTED_EDGE('',*,*,#21,.T.);
#61=ORIENTED_EDGE('',*,*,#31,.T.);
#62=ORIENTED_EDGE('',*,*,#41,.T.);
#63=ORIENTED_EDGE('',*,*,#51,.T.);
#70=EDGE_LOOP('',(#60,#61,#62,#63));
/* Plane surface */
#80=CARTESIAN_POINT('',(0.0,0.0,0.0));
#81=DIRECTION('',(0.0,0.0,1.0));
#82=DIRECTION('',(1.0,0.0,0.0));
#83=AXIS2_PLACEMENT_3D('',#80,#81,#82);
#84=PLANE('',#83);
#90=FACE_OUTER_BOUND('',#70,.T.);
#91=ADVANCED_FACE('',(#90),#84,.T.);
/* Product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi124','Twi124','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#91));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
