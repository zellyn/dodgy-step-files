ISO-10303-21;
/* Twi124: GEOMETRIC_CURVE_SET containing EDGE_LOOP with 2 crossing LINE edges; e1: horizontal (0,0,0)→(4,0,0); e2: vertical (2,2,0)→(2,-2,0) — 3D curves cross at (2,0,0); vertex chain broken: e1 end v2=(4,0,0), e2 start v3=(2,2,0); FixIntersectingEdges uses magic-constant tolerance multiplier 2.0000001; when edge-tolerance is just above 2.0mm the scaled margin collapses, causing false-negative intersection detection; GEOMETRIC_CURVE_SET IS model entity — OCC yields empty; all EDGE_CURVEs ARE wired into EDGE_LOOP; never orphaned */
HEADER;
FILE_DESCRIPTION(('Twi124'),'2;1');
