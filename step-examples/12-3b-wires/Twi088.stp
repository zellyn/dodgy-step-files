ISO-10303-21;
/* Twi088 - Edge with no 3D curve, only pcurves.
 * Defect: EDGE_CURVE.edge_geometry is null. Adjacent faces' PCURVE
 * representations describe the edge in UV but no 3D curve exists. */
HEADER;
FILE_DESCRIPTION(('Twi088 - Edge in topology has no 3D curve attached','Pass C gap-fill'),'2;1');
FILE_NAME('Twi088.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(1.0,0.0,0.0));
#12=VERTEX_POINT('',#10);
#13=VERTEX_POINT('',#11);
/* Defect: edge_geometry = $ (null) */
#30=EDGE_CURVE('pcurve_only_edge',#12,#13,$,.T.);
ENDSEC;
END-ISO-10303-21;
