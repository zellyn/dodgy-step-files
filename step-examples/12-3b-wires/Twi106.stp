ISO-10303-21;
/* Twi106 - ShapeFix_Wire.FixIntersectingEdges accumulation cascade
   Defect: FixIntersectingEdges at line 2967 repairs detected wire
   self-intersections by splitting and re-ordering edges. Multiple
   intersection points in a wire without upper-bound tolerance enforcement
   cause an accumulation cascade: each repaired split generates additional
   vertices, which may create new intersections when re-inserted, leading
   to unbounded iteration or silent acceptance of partially-repaired wires.
   Wire with 3+ intersections at different edge pairs exhibits cascade. */
HEADER;
FILE_DESCRIPTION(('Twi106 - FixIntersectingEdges accumulation cascade multiple intersections'),'2;1');
