ISO-10303-21;
/* Twi043 - Disjoined / Same-Close wire vertices needing resolution (FixWireVertex)
 * Defect: Wire-level vertex resolution: same-coordinate vertices that should be
 * merged but are still disjoint, or close-coordinate vertices that should merge
 * under a wire-specific tolerance budget rather than the global one. Heal by
 * ShapeFix_WireVertex - merge or split as appropriate. The two vertices
 * below are at (0,0,0) and (1e-7,0,0) - global tolerance treats them as
 * separate but they should be merged. */
HEADER;
FILE_DESCRIPTION(('Twi043 test case','FixWireVertex - close coordinate vertices'),'2;1');
FILE_NAME('Twi043.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Defect: V1 and V1' are at near-identical coordinates (delta 1e-7 m on a
 * 1 m part) - global tolerance treats them as distinct but they should
 * merge under wire-specific tolerance. */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(1.0E-7,0.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(1.0,0.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(0.0,1.0,0.0));
#37=VERTEX_POINT('',#36);
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#32,#41);
#43=DIRECTION('',(-0.7071067811865475,0.7071067811865475,0.0));
#44=VECTOR('',#43,1.0);
#45=LINE('',#34,#44);
#46=DIRECTION('',(0.0,-1.0,0.0));
#47=VECTOR('',#46,1.0);
#48=LINE('',#36,#47);
#50=EDGE_CURVE('',#33,#35,#42,.T.);
#51=EDGE_CURVE('',#35,#37,#45,.T.);
#52=EDGE_CURVE('',#37,#31,#48,.T.);
#60=ORIENTED_EDGE('',*,*,#50,.T.);
#61=ORIENTED_EDGE('',*,*,#51,.T.);
#62=ORIENTED_EDGE('',*,*,#52,.T.);
/* Wire ends at #31 but the next edge start was #33 (1e-7 away) - disjoined */
#70=EDGE_LOOP('',(#60,#61,#62));
#71=FACE_OUTER_BOUND('',#70,.T.);
#72=ADVANCED_FACE('',(#71),#20,.T.);
/* Minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi043','Twi043','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#72));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
