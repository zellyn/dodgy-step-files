ISO-10303-21;
/* Twi156 - ShapeFix_Wire.FixReorder duplicate-edge
 * Defect: Wire contains the same edge twice with forward and reverse orientations.
 * FixReorder treats each ORIENTED_EDGE independently, seeing them as two distinct
 * entities even though they reference the same underlying EDGE_CURVE. When attempting
 * to reorder edges to form a continuous wire, duplicate edges are treated as if they
 * are different and remain out of sequence. (ShapeFix_Wire reorder logic; no check
 * for duplicate edge references with opposite orientations in the EDGE_LOOP) */
HEADER;
FILE_DESCRIPTION(('Twi156 test case','Wire with duplicate edge (forward and reverse)'),'2;1');
FILE_NAME('Twi156.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Vertices: 4 corners of a unit square */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(1.0,0.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(1.0,1.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(0.0,1.0,0.0));
#37=VERTEX_POINT('',#36);
/* Four line curves: bottom, right, top, left */
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#30,#41);
#50=DIRECTION('',(0.0,1.0,0.0));
#51=VECTOR('',#50,1.0);
#52=LINE('',#32,#51);
#60=DIRECTION('',(-1.0,0.0,0.0));
#61=VECTOR('',#60,1.0);
#62=LINE('',#34,#61);
#70=DIRECTION('',(0.0,-1.0,0.0));
#71=VECTOR('',#70,1.0);
#72=LINE('',#36,#70);
/* Four edges */
#100=EDGE_CURVE('',#31,#33,#42,.T.);
#101=EDGE_CURVE('',#33,#35,#52,.T.);
#102=EDGE_CURVE('',#35,#37,#62,.T.);
#103=EDGE_CURVE('',#37,#31,#72,.T.);
/* EDGE_LOOP with duplicate: edge #100 appears twice (forward and reverse) */
/* This creates topological inconsistency: [e1, e2, e3, e4, e1_rev] */
#110=ORIENTED_EDGE('',*,*,#100,.T.);
#111=ORIENTED_EDGE('',*,*,#101,.T.);
#112=ORIENTED_EDGE('',*,*,#102,.T.);
#113=ORIENTED_EDGE('',*,*,#103,.T.);
/* Duplicate edge with reverse orientation - same edge curve #100 */
#114=ORIENTED_EDGE('',*,*,#100,.F.);
#120=EDGE_LOOP('',(#110,#111,#112,#113,#114));
#121=FACE_OUTER_BOUND('',#120,.T.);
#122=ADVANCED_FACE('',(#121),#20,.T.);
/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi156','Twi156','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9020=CLOSED_SHELL('shell',(#122));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
