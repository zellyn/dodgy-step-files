ISO-10303-21;
/* Twi045 - FixSmallAreaWire on reversed face wrongly orients wires
 * Defect: When a face is reversed (.F. orientation flag), FixSmallAreaWire
 * produced a face with wrong-oriented wires; or when the face has a non-
 * identity location, the helper face built via MakeFace lost its pcurves.
 * Heal: orient wires consistent with face orientation; build helper face via
 * EmptyCopy to preserve pcurves (Mantis 0029717, 0027781; G076, G092).
 * The face below is .F. (reversed) and contains a small inner wire. */
HEADER;
FILE_DESCRIPTION(('Twi045 test case','FixSmallAreaWire on reversed face'),'2;1');
FILE_NAME('Twi045.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Outer 10x10 square */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(10.0,0.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(10.0,10.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(0.0,10.0,0.0));
#37=VERTEX_POINT('',#36);
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#30,#41);
#43=DIRECTION('',(0.0,1.0,0.0));
#44=VECTOR('',#43,1.0);
#45=LINE('',#32,#44);
#46=DIRECTION('',(-1.0,0.0,0.0));
#47=VECTOR('',#46,1.0);
#48=LINE('',#34,#47);
#49=DIRECTION('',(0.0,-1.0,0.0));
#50=VECTOR('',#49,1.0);
#51=LINE('',#36,#50);
#60=EDGE_CURVE('',#31,#33,#42,.T.);
#61=EDGE_CURVE('',#33,#35,#45,.T.);
#62=EDGE_CURVE('',#35,#37,#48,.T.);
#63=EDGE_CURVE('',#37,#31,#51,.T.);
#70=ORIENTED_EDGE('',*,*,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#61,.T.);
#72=ORIENTED_EDGE('',*,*,#62,.T.);
#73=ORIENTED_EDGE('',*,*,#63,.T.);
#80=EDGE_LOOP('',(#70,#71,#72,#73));
#81=FACE_OUTER_BOUND('',#80,.T.);
/* Sub-tolerance hole wire (area ~5e-7) */
#90=CARTESIAN_POINT('',(5.0,5.0,0.0));
#91=VERTEX_POINT('',#90);
#92=CARTESIAN_POINT('',(5.001,5.0,0.0));
#93=VERTEX_POINT('',#92);
#94=CARTESIAN_POINT('',(5.0,5.001,0.0));
#95=VERTEX_POINT('',#94);
#96=LINE('',#90,#40);
#97=DIRECTION('',(-0.7071067811865475,0.7071067811865475,0.0));
#98=VECTOR('',#97,1.0);
#99=LINE('',#92,#98);
#100=DIRECTION('',(0.0,-1.0,0.0));
#101=VECTOR('',#100,1.0);
#102=LINE('',#94,#101);
#103=EDGE_CURVE('',#91,#93,#96,.T.);
#104=EDGE_CURVE('',#93,#95,#99,.T.);
#105=EDGE_CURVE('',#95,#91,#102,.T.);
#106=ORIENTED_EDGE('',*,*,#103,.F.);
#107=ORIENTED_EDGE('',*,*,#105,.F.);
#108=ORIENTED_EDGE('',*,*,#104,.F.);
#109=EDGE_LOOP('',(#106,#107,#108));
#110=FACE_BOUND('',#109,.T.);
/* Defect: face orientation flag is .F. (reversed) - FixSmallAreaWire on a
 * reversed face produced wrong-oriented wires. */
#111=ADVANCED_FACE('',(#81,#110),#20,.F.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi045','Twi045','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#111));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
