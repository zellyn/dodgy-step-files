ISO-10303-21;
/* Twi045: ADVANCED_FACE on a PLANE (10x10 outer square) with same_sense=.F. (reversed face); inner FACE_BOUND hole-wire is a triangle at (5,5,0)→(5.001,5,0)→(5,5.001,0) enclosing ~5e-7 mm²; FixSmallAreaWire rebuilds face from scratch without preserving orientation context — output wires mis-oriented relative to reversed face; OCC crashes (signal 11); compliant kernels must heal, never crash; the .F. same_sense flag IS the orientation-flip mechanism */
HEADER;
FILE_DESCRIPTION(('Twi045'),'2;1');
