ISO-10303-21;
/* Twi047 - Edge has only a pcurve, no 3D curve
 * Defect: EDGE_CURVE built from a SURFACE_CURVE whose representations list
 * contains only a 2D pcurve and lacks the 3D space curve.
 * Many downstream operations (length, sampling, sewing across faces)
 * require the 3D curve; the kernel must synthesize one or refuse. */
HEADER;
FILE_DESCRIPTION(('Twi047 test case','Edge has only a pcurve, no 3D curve'),'2;1');
FILE_NAME('Twi047.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('',#13);
#15=CARTESIAN_POINT('',(0.0,0.0,0.0));
#16=VERTEX_POINT('',#15);
#17=CARTESIAN_POINT('',(10.0,0.0,0.0));
#18=VERTEX_POINT('',#17);
#19=CARTESIAN_POINT('',(10.0,10.0,0.0));
#20=VERTEX_POINT('',#19);
#21=CARTESIAN_POINT('',(0.0,10.0,0.0));
#22=VERTEX_POINT('',#21);
#23=DIRECTION('',(1.0,0.0,0.0));
#24=VECTOR('',#23,1.0);
#25=LINE('',#15,#24);
#26=EDGE_CURVE('',#16,#18,#25,.T.);
#27=ORIENTED_EDGE('',*,*,#26,.T.);
#28=DIRECTION('',(0.0,1.0,0.0));
#29=VECTOR('',#28,1.0);
#30=LINE('',#17,#29);
#31=EDGE_CURVE('',#18,#20,#30,.T.);
#32=ORIENTED_EDGE('',*,*,#31,.T.);
#33=DIRECTION('',(-1.0,0.0,0.0));
#34=VECTOR('',#33,1.0);
#35=LINE('',#19,#34);
#36=EDGE_CURVE('',#20,#22,#35,.T.);
#37=ORIENTED_EDGE('',*,*,#36,.T.);
#38=DIRECTION('',(0.0,-1.0,0.0));
#39=VECTOR('',#38,1.0);
#40=LINE('',#21,#39);
#41=EDGE_CURVE('',#22,#16,#40,.T.);
#42=ORIENTED_EDGE('',*,*,#41,.T.);
#43=EDGE_LOOP('',(#27,#32,#37,#42));
#44=FACE_OUTER_BOUND('',#43,.T.);
#45=ADVANCED_FACE('',(#44),#14,.T.);
/* Defect: extra SURFACE_CURVE that lists only a pcurve, no 3d */
#200=CARTESIAN_POINT('',(0.0,0.0,0.0));
#201=VERTEX_POINT('',#200);
#202=CARTESIAN_POINT('',(1.0,1.0,0.0));
#203=VERTEX_POINT('',#202);
#204=DIRECTION('',(0.7071067811865475,0.7071067811865475,0.0));
#205=VECTOR('',#204,1.4142136);
#206=LINE('',#200,#205);
/* No 3D component; intentionally malformed orphan curve. */
#207=EDGE_CURVE('',#201,#203,#206,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi047','Twi047','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#45));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
