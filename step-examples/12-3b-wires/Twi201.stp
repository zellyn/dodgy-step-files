ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Twi201 — ShapeFix_Wire.FixSeam mismatched-pcurve-direction — seam edge whose pcurves on the two sides point in opposite directions; FixSeam takes one side''s direction as correct'),'2;1');
FILE_NAME('Twi201.stp',2000-01-01T00:00:00,(''),(''),
'Copyright Zellyn',2000-01-01T00:00:00,'');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=PERSON_AND_ORGANIZATION_WITH_ADDRESS('Zellyn','',$,$,$);
#10=CYLINDER('',#20,1.0,2.0);
#11=CIRCLE('pcurve1',#30,1.0);
#12=CIRCLE('pcurve2',#30,1.0);
#20=AXIS2_PLACEMENT_3D('',#100,#40,#41);
#30=AXIS2_PLACEMENT_2D('',#200,#50,#51);
#40=DIRECTION('',(0.0,0.0,1.0));
#41=DIRECTION('',(1.0,0.0,0.0));
#50=DIRECTION('',(1.0,0.0));
#51=DIRECTION('',(0.0,1.0));
#100=CARTESIAN_POINT('',(0.0,0.0,0.0));
#200=CARTESIAN_POINT('',(0.0,0.0));
#101=CARTESIAN_POINT('',(1.0,0.0,0.0));
#102=CARTESIAN_POINT('',(1.0,0.0,2.0));
#103=CARTESIAN_POINT('',(1.0,0.0,1.0));
#13=VERTEX_POINT('',#101);
#14=VERTEX_POINT('',#102);
#15=VERTEX_POINT('',#103);
#60=EDGE_CURVE('seam_edge',#13,#14,#10,.T.);
#201=FACE('',#10);
#70=PCURVE('',#201,#11);
#71=PCURVE('',#201,#12);
#200_EDGE_LOOP=EDGE_LOOP('loop',(#60));
#300=WIRE('wire',(#200_EDGE_LOOP));
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi201','Twi201','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#300));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
