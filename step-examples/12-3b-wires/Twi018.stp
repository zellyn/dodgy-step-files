ISO-10303-21;
/* Twi018 - Edge with start==end vertex but open curve (zero arc length)
 * Defect: EDGE_CURVE references the same VERTEX_POINT for start and end but
 * underlying curve is open (a LINE here); arc length is therefore zero.
 * Reader should synthesize a tiny line through the points; if V1==V2 truly,
 * drop the edge entirely. */
HEADER;
FILE_DESCRIPTION(('Twi018 test case','Edge with start==end but open curve (zero arc length)'),'2;1');
FILE_NAME('Twi018.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Wrap-shape trim: bound the carrier PLANE so tier3_geometric can compute
 * a finite face area. The single-vertex/open-curve EDGE_CURVE defect is
 * preserved in the EDGE_LOOP below. */
#21=RECTANGULAR_TRIMMED_SURFACE('wrap_trim',#20,0.0,1.0,0.0,1.0,.T.,.T.);
/* A single vertex */
#30=CARTESIAN_POINT('',(1.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
/* An open LINE curve (open, not closed) */
#32=DIRECTION('',(1.0,0.0,0.0));
#33=VECTOR('',#32,1.0);
#34=LINE('',#30,#33);
/* Defect: the EDGE_CURVE uses the SAME vertex at both ends with an OPEN curve
 * - arc length is zero. Reader should drop the edge or warn. */
#40=EDGE_CURVE('',#31,#31,#34,.T.);
#41=ORIENTED_EDGE('',*,*,#40,.T.);
#62=EDGE_LOOP('',(#41));
#63=FACE_OUTER_BOUND('',#62,.T.);
#64=ADVANCED_FACE('',(#63),#21,.T.);
/* Minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi018','Twi018','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#64));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
