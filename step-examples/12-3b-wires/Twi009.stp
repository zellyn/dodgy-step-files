ISO-10303-21;
/* Twi009 - Common vertex shared between two distinct wires (STEP-invalid)
 * Defect: Each wire of a face must own its own vertices in STEP; legal in OCCT
 * BRep but not in STEP. Here a FACE_OUTER_BOUND and a FACE_BOUND reference the
 * same VERTEX_POINT instance #31. Heal by ShapeFix_SplitCommonVertex - duplicate
 * the shared vertex so each wire has its own. */
HEADER;
FILE_DESCRIPTION(('Twi009 test case','Common vertex shared between two distinct wires'),'2;1');
FILE_NAME('Twi009.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Outer wire: square (0,0)-(10,0)-(10,10)-(0,10), one corner is a closed loop */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(10.0,0.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(10.0,10.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(0.0,10.0,0.0));
#37=VERTEX_POINT('',#36);
#40=DIRECTION('',(1.0,0.0,0.0));
#41=VECTOR('',#40,10.0);
#42=LINE('',#30,#41);
#43=EDGE_CURVE('',#31,#33,#42,.T.);
#44=DIRECTION('',(0.0,1.0,0.0));
#45=VECTOR('',#44,10.0);
#46=LINE('',#32,#45);
#47=EDGE_CURVE('',#33,#35,#46,.T.);
#48=DIRECTION('',(-1.0,0.0,0.0));
#49=VECTOR('',#48,10.0);
#50=LINE('',#34,#49);
#51=EDGE_CURVE('',#35,#37,#50,.T.);
#52=DIRECTION('',(0.0,-1.0,0.0));
#53=VECTOR('',#52,10.0);
#54=LINE('',#36,#53);
#55=EDGE_CURVE('',#37,#31,#54,.T.);
#60=ORIENTED_EDGE('',*,*,#43,.T.);
#61=ORIENTED_EDGE('',*,*,#47,.T.);
#62=ORIENTED_EDGE('',*,*,#51,.T.);
#63=ORIENTED_EDGE('',*,*,#55,.T.);
#70=EDGE_LOOP('',(#60,#61,#62,#63));
#71=FACE_OUTER_BOUND('',#70,.T.);
/* Defect: inner triangular hole touches the outer wire by sharing VERTEX #31
 * - illegal per STEP (inner / outer wires must not share vertices). */
#80=CARTESIAN_POINT('',(2.0,2.0,0.0));
#81=VERTEX_POINT('',#80);
#82=CARTESIAN_POINT('',(4.0,2.0,0.0));
#83=VERTEX_POINT('',#82);
#84=DIRECTION('',(0.7071067811865475,0.7071067811865475,0.0));
#85=VECTOR('',#84,1.0);
#86=LINE('',#30,#85);
/* Edge starts at the SHARED outer-wire vertex #31 */
#87=EDGE_CURVE('',#31,#81,#86,.T.);
#88=DIRECTION('',(1.0,0.0,0.0));
#89=VECTOR('',#88,2.0);
#90=LINE('',#80,#89);
#91=EDGE_CURVE('',#81,#83,#90,.T.);
#92=DIRECTION('',(-0.8944271909999159,-0.4472135954999579,0.0));
#93=VECTOR('',#92,1.0);
#94=LINE('',#82,#93);
/* Edge ends at the SHARED outer-wire vertex #31 - same instance */
#95=EDGE_CURVE('',#83,#31,#94,.T.);
#100=ORIENTED_EDGE('',*,*,#87,.T.);
#101=ORIENTED_EDGE('',*,*,#91,.T.);
#102=ORIENTED_EDGE('',*,*,#95,.T.);
#103=EDGE_LOOP('',(#100,#101,#102));
#104=FACE_BOUND('',#103,.T.);
#110=ADVANCED_FACE('',(#71,#104),#20,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi009','Twi009','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#110));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
