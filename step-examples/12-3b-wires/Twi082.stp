ISO-10303-21;
/* Twi082 - same_range flag claims agreement that doesn't hold.
 * Defect: edge's 3D curve runs t in [0,10]; pcurve runs u in [0,5].
 * Different parameterizations - the kernel-internal same_range flag
 * is asserted true. */
HEADER;
FILE_DESCRIPTION(('Twi082 - Edge `same_range` flag claims parametric agreement that does not hold','Pass C gap-fill'),'2;1');
FILE_NAME('Twi082.stp','2026-04-30T00:00:00',(''),(''),'gap-fill C','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* 3D line of length 10. */
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=CARTESIAN_POINT('',(10.0,0.0,0.0));
#12=VERTEX_POINT('',#10);
#13=VERTEX_POINT('',#11);
#20=DIRECTION('',(1.0,0.0,0.0));
#21=VECTOR('',#20,1.0);
#22=LINE('len_10',#10,#21);
#30=EDGE_CURVE('mismatched_param',#12,#13,#22,.T.);
/* Surface with pcurve of "length 5" - different parameterization. */
#40=DIRECTION('',(0.0,0.0,1.0));
#41=AXIS2_PLACEMENT_3D('',#10,#40,#20);
#42=PLANE('',#41);
#50=DIRECTION_2D('',(2.0,0.0)); /* ratio differs */
#51=VECTOR_2D('',#50,1.0);
#52=LINE_2D('',#50,#51);
ENDSEC;
END-ISO-10303-21;
