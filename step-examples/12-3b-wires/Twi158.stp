ISO-10303-21;
/* Twi158 - ShapeFix_Wire.FixGaps2d 2D-gap on periodic surface
 * Defect: wire on cylindrical surface where 2D pcurves leave a gap exactly at
 * u=0 (the seam). FixGaps2d's gap-bridging doesn't handle seam-crossing. */
HEADER;
FILE_DESCRIPTION(('Twi158 test case','FixGaps2d 2D-gap on periodic surface'),'2;1');
FILE_NAME('Twi158.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Cylindrical surface: axis along Z, radius 1.0 */
#21=CIRCLE('',#13,1.0);
#22=SURFACE_OF_REVOLUTION('',#21,#13);
/* Vertices on cylinder at u near 0 and 2*pi (wrapping) */
#30=CARTESIAN_POINT('',(1.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(0.99999,0.00628,0.5));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(0.99999,-0.00628,1.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(1.0,0.0,1.5));
#37=VERTEX_POINT('',#36);
/* Edge curves with pcurves that span seam */
#40=DIRECTION('',(0.0,0.0,1.0));
#41=VECTOR('',#40,1.5);
#42=LINE('',#30,#41);
#50=EDGE_CURVE('',#31,#37,#42,.T.);
#60=ORIENTED_EDGE('',*,*,#50,.T.);
/* Defect: the pcurve leaves a gap at u=0 (seam) where parameter space
   wraps from 2*pi to 0, but the gap-fixing routine doesn't bridge it */
#70=EDGE_LOOP('',(#60));
#71=FACE_OUTER_BOUND('',#70,.T.);
#72=ADVANCED_FACE('',(#71),#22,.T.);
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi158','Twi158','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('shell',(#72));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
