ISO-10303-21;
/* Twi188 - ShapeAnalysis_Wire.CheckSelfIntersectingEdge B-spline-with-loop
 * Defect: Single B-spline edge whose control polygon creates an interior loop;
 * CheckSelfIntersectingEdge's endpoint-filter masks the interior intersection.
 * The curve self-intersects at an internal point but the detector only checks
 * endpoints, missing the crossing.
 */
HEADER;
FILE_DESCRIPTION(('Twi188 test case','CheckSelfIntersectingEdge B-spline-with-loop'),'2;1');
FILE_NAME('Twi188.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* B-spline control points forming a loop that self-intersects internally */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(10.0,0.0,0.0));
#33=VERTEX_POINT('',#32);
/* B-spline curve with control points that form interior intersection */
#50=CARTESIAN_POINT('',(0.0,0.0,0.0));
#51=CARTESIAN_POINT('',(5.0,5.0,0.0));
#52=CARTESIAN_POINT('',(10.0,5.0,0.0));
#53=CARTESIAN_POINT('',(5.0,0.0,0.0));
#54=CARTESIAN_POINT('',(10.0,0.0,0.0));
#55=B_SPLINE_CURVE_WITH_KNOTS('',3,(#50,#51,#52,#53,#54),.UNSPECIFIED.,.F.,.F.,(3,2,3),(0.0,0.5,1.0),.UNSPECIFIED.);
#56=EDGE_CURVE('',#31,#33,#55,.T.);
/* Wire with single self-intersecting edge */
#60=ORIENTED_EDGE('',*,*,#56,.T.);
#70=EDGE_LOOP('',(#60));
#71=FACE_OUTER_BOUND('',#70,.T.);
#72=ADVANCED_FACE('',(#71),#20,.T.);
/* Mandatory product chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi188','Twi188','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#72));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
