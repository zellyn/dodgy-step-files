ISO-10303-21;
/* Twi165 - ShapeAnalysis_Wire.CheckTail B-spline subdivided
 * Last edge is a B-spline that has been subdivided into multiple sub-curves.
 * CheckTail's tangent-discontinuity test fires on every sub-curve boundary.
 */
HEADER;
FILE_DESCRIPTION(('Twi165 test case','B-spline subdivided into edges with tangent discontinuities'),'2;1');
FILE_NAME('Twi165.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* First edge: simple line segment */
#10=CARTESIAN_POINT('start',(0.0,0.0,0.0));
#11=VERTEX_POINT('',#10);
#12=CARTESIAN_POINT('mid',(10.0,0.0,0.0));
#13=VERTEX_POINT('',#12);
#20=DIRECTION('',(1.0,0.0,0.0));
#21=VECTOR('',#20,1.0);
#22=LINE('',#10,#21);
#23=EDGE_CURVE('first_line',#11,#13,#22,.T.);
/* Subdivided B-spline edges: each represents a sub-curve with knot discontinuity */
/* Sub-curve 1: [0.0, 0.333] with C1 discontinuity at end */
#30=CARTESIAN_POINT('bcp0',(10.0,0.0,0.0));
#31=CARTESIAN_POINT('bcp1',(12.0,2.0,0.0));
#32=CARTESIAN_POINT('bcp2',(14.0,2.0,0.0));
#33=CARTESIAN_POINT('bcp3',(16.0,1.0,0.0));
#40=(B_SPLINE_CURVE_WITH_KNOTS()B_SPLINE_CURVE(3,(#30,#31,#32,#33),.UNSPECIFIED.,.F.,.F.)CURVE()GEOMETRIC_REPRESENTATION_ITEM()REPRESENTATION_ITEM('bspl_sub1'));
#41=CARTESIAN_POINT('p1_end',(15.5,2.0,0.0));
#42=VERTEX_POINT('',#41);
#43=EDGE_CURVE('bspl_sub1',#13,#42,#40,.T.);
/* Sub-curve 2: [0.333, 0.667] with C1 discontinuity at start and end */
#50=CARTESIAN_POINT('bcp4',(15.5,2.0,0.0));
#51=CARTESIAN_POINT('bcp5',(17.0,1.5,0.0));
#52=CARTESIAN_POINT('bcp6',(18.5,1.5,0.0));
#53=CARTESIAN_POINT('bcp7',(19.5,0.5,0.0));
#60=(B_SPLINE_CURVE_WITH_KNOTS()B_SPLINE_CURVE(3,(#50,#51,#52,#53),.UNSPECIFIED.,.F.,.F.)CURVE()GEOMETRIC_REPRESENTATION_ITEM()REPRESENTATION_ITEM('bspl_sub2'));
#61=CARTESIAN_POINT('p2_end',(19.0,1.0,0.0));
#62=VERTEX_POINT('',#61);
#63=EDGE_CURVE('bspl_sub2',#42,#62,#60,.T.);
/* Sub-curve 3: [0.667, 1.0] */
#70=CARTESIAN_POINT('bcp8',(19.0,1.0,0.0));
#71=CARTESIAN_POINT('bcp9',(20.5,0.0,0.0));
#72=CARTESIAN_POINT('bcp10',(22.0,-0.5,0.0));
#73=CARTESIAN_POINT('bcp11',(23.0,-1.0,0.0));
#80=(B_SPLINE_CURVE_WITH_KNOTS()B_SPLINE_CURVE(3,(#70,#71,#72,#73),.UNSPECIFIED.,.F.,.F.)CURVE()GEOMETRIC_REPRESENTATION_ITEM()REPRESENTATION_ITEM('bspl_sub3'));
#81=CARTESIAN_POINT('p3_end',(23.0,-1.0,0.0));
#82=VERTEX_POINT('',#81);
#83=EDGE_CURVE('bspl_sub3',#62,#82,#80,.T.);
/* Wire: straight edge followed by 3 B-spline sub-curves */
#100=ORIENTED_EDGE('oe0',*,*,#23,.T.);
#101=ORIENTED_EDGE('oe1',*,*,#43,.T.);
#102=ORIENTED_EDGE('oe2',*,*,#63,.T.);
#103=ORIENTED_EDGE('oe3',*,*,#83,.T.);
#110=EDGE_LOOP('subdivided_loop',(#100,#101,#102,#103));
/* Plane for face */
#120=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#121=DIRECTION('',(0.0,0.0,1.0));
#122=DIRECTION('',(1.0,0.0,0.0));
#123=AXIS2_PLACEMENT_3D('',#120,#121,#122);
#124=PLANE('',#123);
#130=FACE_OUTER_BOUND('',#110,.T.);
#131=ADVANCED_FACE('subdivided_face',(#130),#124,.T.);
#140=OPEN_SHELL('',(#131));
/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi165','Twi165','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#140));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
