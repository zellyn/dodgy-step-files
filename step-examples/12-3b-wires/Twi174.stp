ISO-10303-21;
/* Twi174 - ShapeFix_Wire.FixDummySeam non-cylindrical
 * Defect: Wire on cone (not cylinder); FixDummySeam's heuristic for "seam detection" matches the cone's apex edge incorrectly */
HEADER;
FILE_DESCRIPTION(('Twi174 test case','FixDummySeam non-cylindrical'),'2;1');
FILE_NAME('Twi174.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* Conical surface with apex at origin, axis along Z, opening angle 45 degrees. */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));
#21=AXIS2_PLACEMENT_3D('',#20,#11,#12);
#22=CONICAL_SURFACE('',#21,1.0,0.7854);
/* Wire vertices on the cone at different angular positions. */
#30=CARTESIAN_POINT('',(1.0,0.0,1.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(0.707,0.707,1.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(-1.0,0.0,1.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(0.707,-0.707,1.0));
#37=VERTEX_POINT('',#36);
/* Curve segments on cone surface. */
#40=LINE('',#30,#41);
#41=VECTOR('',(#12),1.414);
#42=LINE('',#32,#43);
#43=VECTOR('',((-1.0,0.0,0.0)),1.414);
#44=LINE('',#34,#45);
#45=VECTOR('',((-0.707,-0.707,0.0)),1.414);
#46=LINE('',#36,#47);
#47=VECTOR('',(1.0,0.0,0.0));
/* Edges on cone: four edges forming a closed loop approximating a circle at height z=1. */
#60=EDGE_CURVE('',#31,#33,#40,.T.);
#61=EDGE_CURVE('',#33,#35,#42,.T.);
#62=EDGE_CURVE('',#35,#37,#44,.T.);
#63=EDGE_CURVE('',#37,#31,#46,.T.);
/* ORIENTED_EDGES. */
#70=ORIENTED_EDGE('',*,*,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#61,.T.);
#72=ORIENTED_EDGE('',*,*,#62,.T.);
#73=ORIENTED_EDGE('',*,*,#63,.T.);
/* Wire on cone; FixDummySeam may incorrectly match apex edge heuristic. */
#80=EDGE_LOOP('',(#70,#71,#72,#73));
#81=FACE_OUTER_BOUND('',#80,.T.);
#82=ADVANCED_FACE('',(#81),#22,.T.);
/* Mandatory PRODUCT chain. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi174','Twi174','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#82));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
