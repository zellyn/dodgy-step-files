ISO-10303-21;
/* Twi184 - ShapeFix_Wire.FixConnected zero-length-edge-between
 * Defect: Wire with 2 normal edges and a zero-length edge between them;
 * FixConnected sees them as connected and skips needed fixes. The zero-length
 * edge masks discontinuity that should trigger connection repair. */
HEADER;
FILE_DESCRIPTION(('Twi184 test case','Zero-length edge masks disconnection in FixConnected'),'2;1');
FILE_NAME('Twi184.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Four vertices: V1 at origin, V2 at (1,0), V3 at (1,0) (coincident with V2),
 * V4 at (2,0) */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(1.0,0.0,0.0));
#33=VERTEX_POINT('',#32);
#34=CARTESIAN_POINT('',(1.0,0.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(2.0,0.0,0.0));
#37=VERTEX_POINT('',#36);
/* First normal edge: V1 -> V2 */
#40=LINE('',#30,#(1.0,0.0,0.0));
#41=EDGE_CURVE('',#31,#33,#40,.T.);
/* Defect: Zero-length edge V2 -> V3 (V2 and V3 coincident);
 * this masks the real discontinuity after V3 */
#42=LINE('',#32,#(0.0,0.0,0.0));
#43=EDGE_CURVE('',#33,#35,#42,.T.);
/* Second normal edge: V3 -> V4, but should connect to V1 to close */
#44=LINE('',#34,#(1.0,0.0,0.0));
#45=EDGE_CURVE('',#35,#37,#44,.T.);
/* Closing edge: V4 -> V1 */
#46=LINE('',#36,#(-2.0,0.0,0.0));
#47=EDGE_CURVE('',#37,#31,#46,.T.);
#70=ORIENTED_EDGE('',*,*,#41,.T.);
#71=ORIENTED_EDGE('',*,*,#43,.T.);
#72=ORIENTED_EDGE('',*,*,#45,.T.);
#73=ORIENTED_EDGE('',*,*,#47,.T.);
/* Defect: Zero-length edge (#43) between two normal edges means FixConnected
 * fails to detect that the normal edges don't actually connect properly */
#80=EDGE_LOOP('',(#70,#71,#72,#73));
#81=FACE_OUTER_BOUND('',#80,.T.);
#82=ADVANCED_FACE('',(#81),#20,.T.);
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi184','Twi184','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#82));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
