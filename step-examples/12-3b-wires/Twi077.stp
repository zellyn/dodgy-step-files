ISO-10303-21;
/* Twi077 - Wire tail: two adjacent edges form a sharp fold over sub-tolerance width
 * Two long edges share a start vertex. Edge A goes (0,0,0) -> (10,0,0).
 * Edge B starts at the same (0,0,0) but goes nearly back along edge A's path
 * within 1e-6 -- direction (-1, 1e-6, 0) so it diverges from A by only 1e-6
 * laterally. The pair forms a tail (fold-back) below tolerance. */
HEADER;
FILE_DESCRIPTION(('Twi077 test case','Two long edges meeting at sharp angle, second edge retraces within 1e-6'),'2;1');
FILE_NAME('Twi077.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Vertices: shared apex (0,0,0); A's far end at (10,0,0); B's far end at
 * (-10, 1e-5, 0) -- nearly mirroring A. */
#10=CARTESIAN_POINT('apex_shared',(0.0,0.0,0.0));#11=VERTEX_POINT('Vapex',#10);
#12=CARTESIAN_POINT('A_far_end',(10.0,0.0,0.0));#13=VERTEX_POINT('VA',#12);
#14=CARTESIAN_POINT('B_far_end_retrace',(-10.0,0.00001,0.0));#15=VERTEX_POINT('VB',#14);
/* Edge A: long edge (10mm) along +X */
#20=DIRECTION('',(1.0,0.0,0.0));
#21=VECTOR('',#20,1.0);
#22=LINE('A_3d',#10,#21);
#23=EDGE_CURVE('edgeA',#11,#13,#22,.T.);
/* Edge B: starts at apex; direction (-1, +1e-6, 0) -- the second edge
 * folds back, diverging from A by only 1e-6 laterally. */
#30=DIRECTION('B_dir_retrace_with_1e6_offset',(-0.999999999995,0.000001,0.0));
#31=VECTOR('',#30,1.0);
#32=LINE('B_3d_retrace',#10,#31);
#33=EDGE_CURVE('edgeB_tail',#11,#15,#32,.T.);
/* Wire: A then B, sharing the apex */
#40=ORIENTED_EDGE('',*,*,#23,.F.);
#41=ORIENTED_EDGE('',*,*,#33,.T.);
#42=EDGE_LOOP('tail_pair',(#40,#41));
ENDSEC;
END-ISO-10303-21;
