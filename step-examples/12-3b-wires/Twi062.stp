ISO-10303-21;
/* Twi062 - 3D curve and pcurve traverse the same edge in opposite parameter senses
 * Square face on a PLANE. Right-hand edge: 3D LINE goes from (10,10,0)->(10,0,0)
 * (i.e., +Y endpoint to -Y endpoint), but its pcurve goes UV (10,0)->(10,10).
 * Lifting the pcurve through the plane produces 3D start (10,0,0) but the
 * 3D curve says start is (10,10,0). Direction senses disagree. */
HEADER;
FILE_DESCRIPTION(('Twi062 test case','3D and pcurve traverse same edge in opposite parameter senses'),'2;1');
FILE_NAME('Twi062.stp','2026-04-30T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#14=PLANE('host_plane',#13);
/* Square corners */
#20=CARTESIAN_POINT('',(0.0,0.0,0.0));#21=VERTEX_POINT('',#20);
#22=CARTESIAN_POINT('',(10.0,0.0,0.0));#23=VERTEX_POINT('',#22);
#24=CARTESIAN_POINT('',(10.0,10.0,0.0));#25=VERTEX_POINT('',#24);
#26=CARTESIAN_POINT('',(0.0,10.0,0.0));#27=VERTEX_POINT('',#26);
/* edge along bottom: V1->V2, normal */
#30=DIRECTION('',(1.0,0.0,0.0));#31=VECTOR('',#30,1.0);#32=LINE('',#20,#31);
#33=EDGE_CURVE('bottom',#21,#23,#32,.T.);
/* RIGHT edge: 3D direction REVERSED relative to pcurve.
 * pcurve UV runs (10,0)->(10,10) (forward); edge endpoints V2 (=(10,0)) -> V3 (=(10,10)).
 * 3D curve LINE starts at (10,10,0) with direction (0,-1,0), so 3D curve at t=0
 * is V3, at t=1 is V2 -- opposite to pcurve sense. */
#40=DIRECTION('',(0.0,-1.0,0.0));#41=VECTOR('',#40,1.0);
#42=LINE('right_3d_reversed',#24,#41);
#43=CARTESIAN_POINT('',(10.0,0.0));
#44=DIRECTION('',(0.0,1.0));
#45=VECTOR('',#44,1.0);
#46=LINE('right_pcurve_forward',#43,#45);
#47=DEFINITIONAL_REPRESENTATION('',(#46),#13);
#48=PCURVE('right_pcurve',#14,#47);
#49=SURFACE_CURVE('right_surface',#42,(#48),.PCURVE_S1.);
#50=EDGE_CURVE('right_opposite_sense',#23,#25,#49,.T.);
/* edge along top: V3->V4 */
#55=DIRECTION('',(-1.0,0.0,0.0));#56=VECTOR('',#55,1.0);#57=LINE('',#24,#56);
#58=EDGE_CURVE('top',#25,#27,#57,.T.);
/* edge left: V4->V1 */
#60=DIRECTION('',(0.0,-1.0,0.0));#61=VECTOR('',#60,1.0);#62=LINE('',#26,#61);
#63=EDGE_CURVE('left',#27,#21,#62,.T.);
#70=ORIENTED_EDGE('',*,*,#33,.T.);
#71=ORIENTED_EDGE('',*,*,#50,.T.);
#72=ORIENTED_EDGE('',*,*,#58,.T.);
#73=ORIENTED_EDGE('',*,*,#63,.T.);
#74=EDGE_LOOP('',(#70,#71,#72,#73));
#75=FACE_OUTER_BOUND('',#74,.T.);
#76=ADVANCED_FACE('square_pcurve_sense_mismatch',(#75),#14,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi062','Twi062','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#76));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
