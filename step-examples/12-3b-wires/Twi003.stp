ISO-10303-21;
/* Twi003 - EDGE_LOOP edges not head-to-tail (disconnected adjacent edges)
 * Defect: Edge n's end vertex is not edge n+1's start vertex within preci.
 * Here the four edges of a square loop have a small (~5.0e-5) gap between edge 1
 * end vertex and edge 2 start vertex - vertices are nearly coincident but
 * exceed default Confusion. Heal by ShapeFix_Wire::FixConnected / vertex merge
 * within tolerance; reject if gap exceeds budget
 * (StepToTopoDS_TranslateEdgeLoop.cxx:412-453; ShapeFix_EdgeConnect). */
HEADER;
FILE_DESCRIPTION(('Twi003 test case','EDGE_LOOP edges not head-to-tail'),'2;1');
FILE_NAME('Twi003.stp','2026-04-26T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Four corners of a unit square - corner C1 and C1' nearly coincide */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(1.0,0.0,0.0));
#33=VERTEX_POINT('',#32);
/* Defect: corner at (1,0,0) is duplicated as a slightly-off (1.00005,0,0) */
#34=CARTESIAN_POINT('',(1.00005,0.0,0.0));
#35=VERTEX_POINT('',#34);
#36=CARTESIAN_POINT('',(1.0,1.0,0.0));
#37=VERTEX_POINT('',#36);
#38=CARTESIAN_POINT('',(0.0,1.0,0.0));
#39=VERTEX_POINT('',#38);
/* Curves */
#50=DIRECTION('',(1.0,0.0,0.0));
#51=VECTOR('',#50,1.0);
#52=LINE('',#30,#51);
#53=DIRECTION('',(0.0,1.0,0.0));
#54=VECTOR('',#53,1.0);
#55=LINE('',#32,#54);
#56=DIRECTION('',(-1.0,0.0,0.0));
#57=VECTOR('',#56,1.0);
#58=LINE('',#36,#57);
#59=DIRECTION('',(0.0,-1.0,0.0));
#60=VECTOR('',#59,1.0);
#61=LINE('',#38,#60);
/* Edges: e1 ends at #33 (1,0,0), but e2 starts at #35 (1.00005,0,0) - gap */
#70=EDGE_CURVE('',#31,#33,#52,.T.);
#71=EDGE_CURVE('',#35,#37,#55,.T.);
#72=EDGE_CURVE('',#37,#39,#58,.T.);
#73=EDGE_CURVE('',#39,#31,#61,.T.);
#80=ORIENTED_EDGE('',*,*,#70,.T.);
#81=ORIENTED_EDGE('',*,*,#71,.T.);
#82=ORIENTED_EDGE('',*,*,#72,.T.);
#83=ORIENTED_EDGE('',*,*,#73,.T.);
#90=EDGE_LOOP('',(#80,#81,#82,#83));
#91=FACE_OUTER_BOUND('',#90,.T.);
#92=ADVANCED_FACE('',(#91),#20,.T.);
/* Wrap: minimal PRODUCT chain so OCCT TransferRoots produces a shape. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi003','Twi003','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9020=OPEN_SHELL('wrap_shell',(#92));
#9021=SHELL_BASED_SURFACE_MODEL('wrap_sbsm',(#9020));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
