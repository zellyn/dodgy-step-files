ISO-10303-21;
/* Twi172 - ShapeFix_Wire.FixSelfIntersectingEdge cusp-edge
 * Defect: Single edge with a cusp (∂C/∂t = 0 at parameter t=0.5); FixSelfIntersectingEdge attempts to compute tangent at cusp and fails */
HEADER;
FILE_DESCRIPTION(('Twi172 test case','FixSelfIntersectingEdge cusp-edge'),'2;1');
FILE_NAME('Twi172.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#10=CARTESIAN_POINT('',(0.0,0.0,0.0));
#11=DIRECTION('',(0.0,0.0,1.0));
#12=DIRECTION('',(1.0,0.0,0.0));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
#20=PLANE('',#13);
/* Two vertices forming a cusp-bearing edge. */
#30=CARTESIAN_POINT('',(0.0,0.0,0.0));
#31=VERTEX_POINT('',#30);
#32=CARTESIAN_POINT('',(2.0,0.0,0.0));
#33=VERTEX_POINT('',#32);
/* B-spline curve with a cusp: tangent vector becomes zero at parameter 0.5 */
#40=CARTESIAN_POINT('',(0.0,0.0,0.0));
#41=CARTESIAN_POINT('',(0.5,1.0,0.0));
#42=CARTESIAN_POINT('',(1.0,0.0,0.0));
#43=CARTESIAN_POINT('',(1.5,1.0,0.0));
#44=CARTESIAN_POINT('',(2.0,0.0,0.0));
#50=B_SPLINE_CURVE_WITH_KNOTS('',3,
  (#40,#41,#42,#43,#44),
  .UNSPECIFIED.,
  .F.,
  .F.,
  (4,2,4),
  (0.0,0.5,1.0),
  .UNSPECIFIED.);
/* Single edge with cusp in the curve. */
#60=EDGE_CURVE('',#31,#33,#50,.T.);
/* ORIENTED_EDGE wrapping the cusp edge. */
#70=ORIENTED_EDGE('',*,*,#60,.T.);
/* Wire containing single edge with cusp. */
#80=EDGE_LOOP('',(#70));
#81=FACE_OUTER_BOUND('',#80,.T.);
#82=ADVANCED_FACE('',(#81),#20,.T.);
/* Mandatory PRODUCT chain. */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi172','Twi172','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#82));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
