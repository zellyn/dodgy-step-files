#6=CARTESIAN_POINT('',(0.0,0.0,0.0));
#7=CARTESIAN_POINT('',(5.0,10.0,0.0));
#8=CARTESIAN_POINT('',(5.0,10.0,0.0));
#9=CARTESIAN_POINT('',(10.0,0.0,0.0));
#10=B_SPLINE_CURVE_WITH_KNOTS('cusp_zero_derivative_midpoint',3,(#6,#7,#8,#9),.UNSPECIFIED.,.F.,.F.,(4,4),(0.0,1.0),.UNSPECIFIED.);
#11=CARTESIAN_POINT('',(0.0,0.0,0.0));
#12=VERTEX_POINT('',#11);
#13=CARTESIAN_POINT('',(10.0,0.0,0.0));
#14=VERTEX_POINT('',#13);
#15=EDGE_CURVE('cusp_zero_derivative_midpoint',#12,#14,#10,.T.);
#16=ORIENTED_EDGE('',*,*,#15,.T.);
#17=EDGE_LOOP('',(#16));
#18=GEOMETRIC_CURVE_SET('',(#17));
#9050=PRODUCT_CONTEXT('',#9000,'mechanical');
#9051=PRODUCT('Twi172','Twi172','',(#9050));
#9052=PRODUCT_DEFINITION_FORMATION('','',#9051);
#9053=PRODUCT_DEFINITION_CONTEXT('part definition',#9000,'design');
#9054=PRODUCT_DEFINITION('','','',#9052,#9053);
