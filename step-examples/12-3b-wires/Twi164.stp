ISO-10303-21;
/* Twi164 - ShapeFix_Wire.FixReorder algorithm-cycle
 * Wire where reorder algorithm reaches a cycle: edge X must come before Y
 * but Y also requires X-first. Algorithm doesn't detect cycle and loops.
 */
HEADER;
FILE_DESCRIPTION(('Twi164 test case','Wire with reorder cycle in edge sequencing'),'2;1');
FILE_NAME('Twi164.stp','2026-06-15T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('automotive_design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
/* Create 4 vertices forming a diamond with non-planar arrangement */
#10=CARTESIAN_POINT('v0',(0.0,0.0,0.0));
#11=VERTEX_POINT('',#10);
#12=CARTESIAN_POINT('v1',(5.0,5.0,0.0));
#13=VERTEX_POINT('',#12);
#14=CARTESIAN_POINT('v2',(10.0,0.0,0.0));
#15=VERTEX_POINT('',#14);
#16=CARTESIAN_POINT('v3',(5.0,-5.0,0.0));
#17=VERTEX_POINT('',#16);
/* Four edges, but with connectivity that creates reorder cycle */
/* Edge 0: v0 -> v1 */
#20=DIRECTION('',(1.0,1.0,0.0));
#21=VECTOR('',#20,1.0);
#22=LINE('',#10,#21);
#23=EDGE_CURVE('e0',#11,#13,#22,.T.);
/* Edge 1: v1 -> v2, partially overlaps with edge 0's endpoint region */
#30=DIRECTION('',(1.0,-1.0,0.0));
#31=VECTOR('',#30,1.0);
#32=LINE('',#12,#31);
#33=EDGE_CURVE('e1',#13,#15,#32,.T.);
/* Edge 2: v2 -> v3 */
#40=DIRECTION('',(-1.0,-1.0,0.0));
#41=VECTOR('',#40,1.0);
#42=LINE('',#14,#41);
#43=EDGE_CURVE('e2',#15,#17,#42,.T.);
/* Edge 3: v3 -> v0, but with near-tangent junction at v0 */
#50=DIRECTION('',(-1.0,1.0,0.0));
#51=VECTOR('',#50,1.0);
#52=LINE('',#16,#51);
#53=EDGE_CURVE('e3',#17,#11,#52,.T.);
/* Wire: edges in reorder-problematic sequence */
#60=ORIENTED_EDGE('oe0',*,*,#23,.T.);
#61=ORIENTED_EDGE('oe1',*,*,#33,.T.);
#62=ORIENTED_EDGE('oe2',*,*,#43,.T.);
#63=ORIENTED_EDGE('oe3',*,*,#53,.T.);
#70=EDGE_LOOP('cycle_loop',(#60,#61,#62,#63));
/* Plane for face */
#80=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#81=DIRECTION('',(0.0,0.0,1.0));
#82=DIRECTION('',(1.0,0.0,0.0));
#83=AXIS2_PLACEMENT_3D('',#80,#81,#82);
#84=PLANE('',#83);
#90=FACE_OUTER_BOUND('',#70,.T.);
#91=ADVANCED_FACE('cycle_face',(#90),#84,.T.);
#100=OPEN_SHELL('',(#91));
/* Mandatory PRODUCT chain */
#9000=PRODUCT_CONTEXT('',#1,'mechanical');
#9001=PRODUCT('Twi164','Twi164','',(#9000));
#9002=PRODUCT_DEFINITION_FORMATION('','',#9001);
#9003=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#9004=PRODUCT_DEFINITION('','',#9002,#9003);
#9005=PRODUCT_DEFINITION_SHAPE('','',#9004);
#9006=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#9007=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#9008=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#9009=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#9006,'distance_accuracy_value','');
#9010=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#9009))GLOBAL_UNIT_ASSIGNED_CONTEXT((#9006,#9007,#9008))REPRESENTATION_CONTEXT('','3D'));
#9021=SHELL_BASED_SURFACE_MODEL('sbsm',(#100));
#9022=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#9021),#9010);
#9023=SHAPE_DEFINITION_REPRESENTATION(#9005,#9022);
ENDSEC;
END-ISO-10303-21;
