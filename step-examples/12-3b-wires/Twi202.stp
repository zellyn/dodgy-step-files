ISO-10303-21;
/* Twi202: Single ADVANCED_FACE on PLANE in CLOSED_SHELL; outer EDGE_LOOP has 3 LINE edges; E0 and E1 both go from V0=(0,0,0) to V2=(10,0,0) — parallel paths sharing both endpoints IS the defect; E2 returns V2→V0; V0 has in-degree 2 and out-degree 2 — FixReorder's linear-chain model cannot resolve theta-graph by simple reordering — duplicate-vertex-causes-cycle IS the mechanism; EDGE_LOOP IS wired into FACE_OUTER_BOUND -> ADVANCED_FACE in CLOSED_SHELL — never orphaned */
HEADER;
FILE_DESCRIPTION(('Twi202'),'2;1');
FILE_NAME('Twi202.stp','2026-06-17T00:00:00',(''),(''),'cad-research-suite','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
